<%#
==========================================================================
  FILE    : views/arcade/game.ejs
  PURPOSE : Chemistry Arcade — Single Player Game Interface
  ROUTER  : GET /arcade/game/:token

  EJS VARIABLES INJECTED BY ROUTER:
    questions          : processed question array
    user               : { user_id, first_name, last_name, profile_pic,
                           current_level, total_exp }
    assessment         : { assessment_id, assessment_name, assessment_type,
                           timer_type, duration_minutes, total_items,
                           sound_bg, sound_correct, sound_wrong,
                           sound_result_pass, sound_result_fail,
                           speech_enabled }
    token              : QR token string
    assessmentId       : integer
    totalPossibleScore : integer
    buttonMappings     : array
    resumeIndex        : integer (0-based index to resume from)

  LAYOUT (matches wireframe PDF):
    ┌──────────────────────────────────────────────────────┐
    │  LEFT PANEL (fixed 280px)   │  RIGHT MAIN AREA       │
    │  ─────────────────────────  │  ──────────────────    │
    │  [INSTRUCTION]              │  [TOP HUD BAR]         │
    │  ─────────────────────────  │  Assessment info+User  │
    │  [Q1] ✓ Ans | Correct       │  ─────────────────     │
    │  [Q2] ✗ Ans | Correct       │  [BG IMAGE]            │
    │  [Q3] ...                   │  Question Text         │
    │  (scrollable history)       │  Media File            │
    │  ─────────────────────────  │  Answer Input Area     │
    │  [SCORE]    [EXP]           │  [TIMER - bottom right]│
    │  ─────────────────────────  │  ─────────────────     │
    │                             │  [BOTTOM TOOLBAR]      │
    └──────────────────────────────────────────────────────┘

  EJS-SAFETY RULE:
    ALL JS template literals/backticks are inside <script> tags only.
    No backtick strings inside EJS tag delimiters.
    JSON.stringify used for data injection.
==========================================================================
%>
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Chemistry Arcade — <%= assessment.assessment_name || 'Game' %></title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@400;600;700;900&family=Exo+2:wght@300;400;500;600;700;800&family=Share+Tech+Mono&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/howler/2.2.3/howler.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
<style>
/* ═══════════════════════════════════════════════════════════════
   THEME CSS VARIABLES — All visuals read from these
═══════════════════════════════════════════════════════════════ */
:root {
  --tc:        #14b8a6;
  --tc2:       #06b6d4;
  --tc3:       #0e7490;
  --tc-dim:    rgba(20,184,166,0.12);
  --tc-mid:    rgba(20,184,166,0.30);
  --tc-glow:   rgba(20,184,166,0.55);
  --bg-core:   #020c10;
  --panel-bg:  rgba(2,18,22,0.88);
  --panel-b:   rgba(20,184,166,0.28);
  --panel-b2:  rgba(20,184,166,0.15);
  --glow-sm:   0 0 16px rgba(20,184,166,0.50);
  --glow-md:   0 0 40px rgba(20,184,166,0.38);
  --glow-xl:   0 0 80px rgba(20,184,166,0.22), 0 0 40px rgba(20,184,166,0.30);
  --correct:   #22c55e;
  --wrong:     #ef4444;
  --warn:      #f59e0b;
  --font-hud:  'Orbitron', monospace;
  --font-body: 'Exo 2', sans-serif;
  --font-mono: 'Share Tech Mono', monospace;
}

/* ── THEME: default_lab ── */
body.theme-default_lab {
  --tc:#14b8a6; --tc2:#06b6d4; --tc3:#0e7490;
  --tc-dim:rgba(20,184,166,0.12); --tc-mid:rgba(20,184,166,0.30); --tc-glow:rgba(20,184,166,0.55);
  --bg-core:#020c10; --panel-bg:rgba(2,18,22,0.90); --panel-b:rgba(20,184,166,0.28);
  --glow-sm:0 0 16px rgba(20,184,166,0.50); --glow-md:0 0 40px rgba(20,184,166,0.38);
  --glow-xl:0 0 80px rgba(20,184,166,0.22),0 0 40px rgba(20,184,166,0.30);
}
/* ── THEME: space_lab ── */
body.theme-space_lab {
  --tc:#818cf8; --tc2:#c084fc; --tc3:#6366f1;
  --tc-dim:rgba(129,140,248,0.12); --tc-mid:rgba(129,140,248,0.28); --tc-glow:rgba(129,140,248,0.55);
  --bg-core:#02000f; --panel-bg:rgba(4,0,20,0.90); --panel-b:rgba(129,140,248,0.28);
  --glow-sm:0 0 16px rgba(192,132,252,0.55); --glow-md:0 0 40px rgba(129,140,248,0.38);
  --glow-xl:0 0 80px rgba(129,140,248,0.22),0 0 40px rgba(192,132,252,0.28);
}
/* ── THEME: jungle_lab ── */
body.theme-jungle_lab {
  --tc:#4ade80; --tc2:#86efac; --tc3:#16a34a;
  --tc-dim:rgba(74,222,128,0.12); --tc-mid:rgba(74,222,128,0.28); --tc-glow:rgba(74,222,128,0.55);
  --bg-core:#011a07; --panel-bg:rgba(1,20,8,0.90); --panel-b:rgba(74,222,128,0.28);
  --glow-sm:0 0 16px rgba(74,222,128,0.50); --glow-md:0 0 40px rgba(74,222,128,0.38);
  --glow-xl:0 0 80px rgba(74,222,128,0.22),0 0 40px rgba(74,222,128,0.28);
}
/* ── THEME: ocean_lab ── */
body.theme-ocean_lab {
  --tc:#38bdf8; --tc2:#7dd3fc; --tc3:#0284c7;
  --tc-dim:rgba(56,189,248,0.12); --tc-mid:rgba(56,189,248,0.28); --tc-glow:rgba(56,189,248,0.55);
  --bg-core:#000c18; --panel-bg:rgba(0,10,25,0.90); --panel-b:rgba(56,189,248,0.28);
  --glow-sm:0 0 16px rgba(56,189,248,0.50); --glow-md:0 0 40px rgba(56,189,248,0.38);
  --glow-xl:0 0 80px rgba(56,189,248,0.22),0 0 40px rgba(56,189,248,0.28);
}
/* ── THEME: volcano_lab ── */
body.theme-volcano_lab {
  --tc:#f97316; --tc2:#fbbf24; --tc3:#ea580c;
  --tc-dim:rgba(249,115,22,0.12); --tc-mid:rgba(249,115,22,0.28); --tc-glow:rgba(249,115,22,0.55);
  --bg-core:#0c0400; --panel-bg:rgba(18,6,0,0.90); --panel-b:rgba(249,115,22,0.28);
  --glow-sm:0 0 16px rgba(249,115,22,0.50); --glow-md:0 0 40px rgba(249,115,22,0.38);
  --glow-xl:0 0 80px rgba(249,115,22,0.22),0 0 40px rgba(251,191,36,0.28);
}

/* ═══════════════════════════════════════════════════════════════
   RESET & BASE
═══════════════════════════════════════════════════════════════ */
*, *::before, *::after { box-sizing:border-box; margin:0; padding:0; }
html, body {
  height:100%; width:100%; overflow:hidden;
  font-family: var(--font-body);
  background-color: var(--bg-core);
  color: #e2e8f0;
  user-select: none;
}

/* CRT Scanlines */
body::before {
  content:''; position:fixed; inset:0; z-index:999; pointer-events:none;
  background: repeating-linear-gradient(
    0deg, rgba(0,0,0,0) 0px, rgba(0,0,0,0) 2px,
    rgba(0,0,0,0.04) 2px, rgba(0,0,0,0.04) 4px
  );
}

/* ═══════════════════════════════════════════════════════════════
   BACKGROUND LAYER
═══════════════════════════════════════════════════════════════ */
#bg-layer {
  position:fixed; inset:0; z-index:0;
  background-size:cover; background-position:center; background-repeat:no-repeat;
  transition:background-image 0.6s ease;
}
#bg-layer::after {
  content:''; position:absolute; inset:0;
  background: linear-gradient(135deg,
    rgba(0,0,0,0.72) 0%,
    rgba(0,0,0,0.48) 50%,
    rgba(0,0,0,0.65) 100%
  );
}

/* Ambient particles */
#ambient-layer { position:fixed; inset:0; z-index:1; pointer-events:none; overflow:hidden; }
.theme-default_lab .amb-p { position:absolute; border-radius:50%; border:1px solid rgba(20,184,166,0.25); animation:bubbleRise linear infinite; opacity:0; }
.theme-space_lab  .amb-p  { position:absolute; border-radius:50%; background:var(--tc); animation:starDrift linear infinite; opacity:0; }
.theme-jungle_lab .amb-p  { position:absolute; border-radius:50%; background:radial-gradient(circle,rgba(74,222,128,0.15) 0%,transparent 70%); animation:gasSwirl ease-in-out infinite; opacity:0; filter:blur(22px); }
.theme-ocean_lab  .amb-p  { position:absolute; border-radius:50%; border:1px solid rgba(56,189,248,0.22); animation:bubbleRise linear infinite; opacity:0; }
.theme-volcano_lab .amb-p { position:absolute; width:2px; border-radius:2px; background:linear-gradient(to top,transparent,var(--tc)); animation:sparkRise linear infinite; opacity:0; }

@keyframes bubbleRise { 0%{transform:translateY(100vh) scale(0.4);opacity:0;} 10%{opacity:0.5;} 90%{opacity:0.2;} 100%{transform:translateY(-80px) scale(1.1);opacity:0;} }
@keyframes starDrift  { 0%{transform:translate(0,0) scale(0);opacity:0;} 30%{opacity:0.7;} 100%{transform:translate(var(--dx,40px),var(--dy,-60px)) scale(0);opacity:0;} }
@keyframes gasSwirl   { 0%{transform:scale(0.5) rotate(0deg);opacity:0;} 30%{opacity:0.5;} 70%{opacity:0.3;} 100%{transform:scale(1.8) rotate(120deg);opacity:0;} }
@keyframes sparkRise  { 0%{transform:translateY(0) scaleY(1);opacity:0;} 20%{opacity:0.8;} 80%{opacity:0.4;} 100%{transform:translateY(-100vh) scaleY(3);opacity:0;} }

/* ═══════════════════════════════════════════════════════════════
   MAIN LAYOUT — Left Panel + Right Area
═══════════════════════════════════════════════════════════════ */
#game-root {
  position:relative; z-index:10;
  display:flex; height:100vh; width:100%;
  overflow:hidden;
}

/* ═══════════════════════════════════════════════════════════════
   LEFT PANEL
═══════════════════════════════════════════════════════════════ */
#left-panel {
  width:280px; min-width:280px;
  display:flex; flex-direction:column;
  background: var(--panel-bg);
  border-right:1px solid var(--panel-b);
  backdrop-filter:blur(32px) saturate(180%);
  -webkit-backdrop-filter:blur(32px) saturate(180%);
  position:relative; z-index:20;
  box-shadow: 4px 0 24px rgba(0,0,0,0.45);
}

/* Left panel top border glow line */
#left-panel::before {
  content:''; position:absolute; top:0; left:0; right:0; height:2px;
  background:linear-gradient(90deg, transparent, var(--tc), transparent);
  opacity:0.7;
}

/* ── INSTRUCTION SECTION ── */
#instruction-section {
  padding:14px 16px 12px;
  border-bottom:1px solid var(--panel-b2);
  flex-shrink:0;
}
#instruction-label {
  font-family:var(--font-hud); font-size:8px; letter-spacing:0.22em;
  color:var(--tc); text-transform:uppercase; opacity:0.8; margin-bottom:8px;
  display:flex; align-items:center; gap:6px;
}
#instruction-label::before {
  content:''; width:6px; height:6px; border-radius:50%;
  background:var(--tc); animation:pulseDot 1.4s ease infinite;
}
@keyframes pulseDot { 0%,100%{transform:scale(1);opacity:1;} 50%{transform:scale(1.9);opacity:0.3;} }

#instruction-label.active { color:#ef4444; }
#instruction-label.active::before { background:#ef4444; }

#instruction-content {
  font-size:0.82rem; font-weight:400; line-height:1.5;
  color:rgba(255,255,255,0.75);
  min-height:40px; max-height:90px; overflow-y:auto;
  scrollbar-width:thin; scrollbar-color:var(--tc-mid) transparent;
}
#instruction-content::-webkit-scrollbar { width:3px; }
#instruction-content::-webkit-scrollbar-track { background:transparent; }
#instruction-content::-webkit-scrollbar-thumb { background:var(--tc-mid); border-radius:2px; }

/* ── HISTORY SECTION ── */
#history-section {
  flex:1; overflow-y:auto; padding:10px 12px;
  scrollbar-width:thin; scrollbar-color:var(--tc-mid) transparent;
}
#history-section::-webkit-scrollbar { width:3px; }
#history-section::-webkit-scrollbar-track { background:transparent; }
#history-section::-webkit-scrollbar-thumb { background:var(--tc-mid); border-radius:2px; }

.history-item {
  background:rgba(255,255,255,0.03);
  border:1px solid var(--panel-b2);
  border-radius:10px; padding:9px 11px; margin-bottom:8px;
  transition:border-color 0.3s ease;
  animation:historySlideIn 0.35s cubic-bezier(0.34,1.56,0.64,1) both;
}
@keyframes historySlideIn { from{opacity:0;transform:translateX(-20px);} to{opacity:1;transform:translateX(0);} }

.history-item.h-correct { border-color:rgba(34,197,94,0.35); background:rgba(34,197,94,0.05); }
.history-item.h-wrong   { border-color:rgba(239,68,68,0.35);  background:rgba(239,68,68,0.05); }

.history-q-row {
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:5px;
}
.history-q-num {
  font-family:var(--font-hud); font-size:9px; letter-spacing:0.15em;
  color:var(--tc); opacity:0.8;
}
.history-badge {
  font-family:var(--font-hud); font-size:7px; letter-spacing:0.15em;
  padding:2px 8px; border-radius:99px; font-weight:700;
}
.badge-correct { background:rgba(34,197,94,0.20); color:#22c55e; border:1px solid rgba(34,197,94,0.35); }
.badge-wrong   { background:rgba(239,68,68,0.20);  color:#ef4444; border:1px solid rgba(239,68,68,0.35); }

.history-answers {
  display:grid; grid-template-columns:1fr 1fr; gap:4px; margin-top:3px;
}
.history-ans-box {
  padding:3px 6px; border-radius:6px; font-size:0.7rem;
  font-weight:500; line-height:1.3;
}
.h-student-ans { background:rgba(255,255,255,0.05); color:rgba(255,255,255,0.65); }
.h-correct-ans { background:rgba(34,197,94,0.10); color:#86efac; }
.history-ans-label {
  font-size:0.6rem; opacity:0.5; display:block; margin-bottom:1px;
  font-family:var(--font-hud); letter-spacing:0.1em;
}

/* ── SCORE / EXP SECTION ── */
#score-exp-section {
  padding:12px 16px 14px;
  border-top:1px solid var(--panel-b2);
  display:grid; grid-template-columns:1fr 1fr; gap:10px;
  flex-shrink:0;
}
.stat-card {
  background:rgba(255,255,255,0.04);
  border:1px solid var(--panel-b2);
  border-radius:10px; padding:10px 12px;
  text-align:center; position:relative; overflow:hidden;
  transition:border-color 0.4s ease, box-shadow 0.4s ease;
}
.stat-card.pulse-anim {
  animation:statPulse 0.5s ease;
}
@keyframes statPulse {
  0%,100%{transform:scale(1);}
  50%{transform:scale(1.06); border-color:var(--tc); box-shadow:var(--glow-sm);}
}
.stat-card-label {
  font-family:var(--font-hud); font-size:7px; letter-spacing:0.2em;
  color:var(--tc); text-transform:uppercase; opacity:0.75; margin-bottom:4px;
}
.stat-card-val {
  font-family:var(--font-hud); font-size:1.35rem; font-weight:900;
  color:#fff; line-height:1;
  transition:color 0.3s ease;
}
#score-fraction {
  font-size:0.55rem; color:rgba(255,255,255,0.35);
  display:block; margin-top:2px; font-family:var(--font-mono);
}

/* ═══════════════════════════════════════════════════════════════
   RIGHT AREA
═══════════════════════════════════════════════════════════════ */
#right-area {
  flex:1; display:flex; flex-direction:column; overflow:hidden;
  position:relative;
}

/* ── TOP HUD BAR ── */
#top-hud {
  display:flex; align-items:center; gap:0;
  background:var(--panel-bg);
  border-bottom:1px solid var(--panel-b);
  backdrop-filter:blur(24px) saturate(160%);
  -webkit-backdrop-filter:blur(24px) saturate(160%);
  flex-shrink:0; z-index:15; position:relative;
}
#top-hud::after {
  content:''; position:absolute; bottom:-1px; left:0; right:0; height:1px;
  background:linear-gradient(90deg, transparent, var(--tc), transparent);
  opacity:0.5;
}

.hud-cell {
  padding:10px 18px;
  border-right:1px solid var(--panel-b2);
  display:flex; flex-direction:column; justify-content:center;
}
.hud-cell:last-child { border-right:none; }
.hud-cell-label {
  font-family:var(--font-hud); font-size:7px; letter-spacing:0.22em;
  color:var(--tc); text-transform:uppercase; opacity:0.7; line-height:1;
}
.hud-cell-val {
  font-family:var(--font-hud); font-size:0.78rem; font-weight:700;
  color:#fff; line-height:1.3; margin-top:2px;
  white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:180px;
}
.hud-cell-val.accent { color:var(--tc); }
#hud-input-mode {
  font-family:var(--font-hud); font-size:0.65rem; font-weight:600;
  padding:2px 10px; border-radius:99px;
  background:var(--tc-dim); color:var(--tc);
  border:1px solid var(--panel-b); margin-top:3px; display:inline-block;
  letter-spacing:0.1em; text-transform:uppercase;
}

/* Student info cell */
#hud-student-cell {
  margin-left:auto; border-right:none; border-left:1px solid var(--panel-b2);
  flex-direction:row; align-items:center; gap:10px; padding:8px 14px;
}
#hud-avatar {
  width:36px; height:36px; border-radius:50%;
  border:2px solid var(--tc); object-fit:cover;
  box-shadow:var(--glow-sm); flex-shrink:0;
}
.hud-student-info { display:flex; flex-direction:column; }
.hud-student-name {
  font-family:var(--font-hud); font-size:0.72rem; font-weight:700;
  color:#fff; line-height:1.2;
}
.hud-student-level {
  font-family:var(--font-hud); font-size:0.58rem; color:var(--tc);
  letter-spacing:0.15em; opacity:0.85;
}

/* ── MAIN GAME AREA ── */
#main-game-area {
  flex:1; position:relative; overflow:hidden;
  display:flex; flex-direction:column;
}

/* Question + answer area scroll container */
#game-scroll {
  flex:1; overflow-y:auto; padding:20px 32px 12px;
  scrollbar-width:thin; scrollbar-color:var(--tc-mid) transparent;
  position:relative; z-index:5;
}
#game-scroll::-webkit-scrollbar { width:4px; }
#game-scroll::-webkit-scrollbar-track { background:transparent; }
#game-scroll::-webkit-scrollbar-thumb { background:var(--tc-mid); border-radius:2px; }

/* Difficulty + Question number row */
#q-meta-row {
  display:flex; align-items:center; justify-content:space-between;
  margin-bottom:14px;
}
#difficulty-badge {
  font-family:var(--font-hud); font-size:8px; letter-spacing:0.3em;
  padding:4px 16px; border-radius:99px; text-transform:uppercase; font-weight:900;
  transition:background 0.4s ease, color 0.4s ease;
}
.diff-easy     { background:rgba(34,197,94,0.18);  color:#22c55e; border:1px solid rgba(34,197,94,0.35);  }
.diff-average  { background:rgba(245,158,11,0.18); color:#f59e0b; border:1px solid rgba(245,158,11,0.35); }
.diff-difficult{ background:rgba(239,68,68,0.18);  color:#ef4444; border:1px solid rgba(239,68,68,0.35);  }

#q-progress-text {
  font-family:var(--font-hud); font-size:11px; font-weight:700;
  color:rgba(255,255,255,0.50); letter-spacing:0.1em;
}
#q-progress-text span { color:var(--tc); }

/* Progress bar */
#progress-bar-wrap {
  width:100%; height:3px;
  background:rgba(255,255,255,0.06);
  border-radius:2px; margin-bottom:16px; overflow:hidden;
}
#progress-bar {
  height:100%; background:linear-gradient(90deg, var(--tc), var(--tc2));
  border-radius:2px; transition:width 0.6s cubic-bezier(0.4,0,0.2,1);
  box-shadow:0 0 8px var(--tc-glow);
}

/* Question text */
#question-text {
  font-family:var(--font-body); font-size:1.45rem; font-weight:700;
  line-height:1.5; color:#f1f5f9; margin-bottom:14px;
  text-shadow:0 2px 8px rgba(0,0,0,0.55);
  animation:fadeUp 0.45s cubic-bezier(0.34,1.56,0.64,1) both;
}
@keyframes fadeUp { from{opacity:0;transform:translateY(14px);} to{opacity:1;transform:translateY(0);} }

/* Media file */
#media-wrap {
  border-radius:14px; overflow:hidden;
  background:rgba(0,0,0,0.40);
  border:1px solid var(--panel-b2);
  margin-bottom:16px; display:none; position:relative;
  max-height:220px;
}
#media-wrap.has-media { display:block; }
#media-img { width:100%; height:220px; object-fit:contain; display:block; cursor:pointer; }
#media-video { width:100%; max-height:220px; display:block; cursor:pointer; }
#media-zoom-hint {
  position:absolute; bottom:8px; right:10px;
  font-family:var(--font-hud); font-size:7px; letter-spacing:0.2em;
  color:var(--tc); opacity:0.7; pointer-events:none;
}

/* ═══════════════════════════════════════════════════════════════
   ANSWER INPUT AREAS
═══════════════════════════════════════════════════════════════ */
#answer-area { margin-bottom:8px; }

/* ── STANDARD MCQ ── */
#mcq-wrap { display:none; }
#mcq-wrap.active { display:grid; grid-template-columns:1fr 1fr; gap:12px; }

.choice-btn {
  cursor:pointer; padding:14px 16px;
  background:rgba(255,255,255,0.03);
  border:1.5px solid rgba(255,255,255,0.10);
  border-radius:14px;
  display:flex; align-items:flex-start; gap:12px;
  transition:all 0.22s cubic-bezier(0.34,1.56,0.64,1);
  position:relative; overflow:hidden;
  animation:choiceIn 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
}
.choice-btn:nth-child(1){animation-delay:0.05s;}
.choice-btn:nth-child(2){animation-delay:0.10s;}
.choice-btn:nth-child(3){animation-delay:0.15s;}
.choice-btn:nth-child(4){animation-delay:0.20s;}
@keyframes choiceIn { from{opacity:0;transform:scale(0.92) translateY(10px);} to{opacity:1;transform:scale(1) translateY(0);} }

.choice-btn::before {
  content:''; position:absolute; inset:0; border-radius:14px;
  background:var(--tc-dim); opacity:0; transition:opacity 0.2s ease;
}
.choice-btn:hover { border-color:var(--tc); transform:translateY(-2px); box-shadow:var(--glow-sm); }
.choice-btn:hover::before { opacity:1; }
.choice-btn:active { transform:scale(0.97); }

/* Checkbox for multi-answer */
.choice-checkbox {
  width:18px; height:18px; border-radius:5px; border:2px solid rgba(255,255,255,0.25);
  flex-shrink:0; margin-top:2px; transition:all 0.2s ease;
  display:flex; align-items:center; justify-content:center;
}
.choice-btn.checked .choice-checkbox {
  background:var(--tc); border-color:var(--tc);
}
.choice-btn.checked .choice-checkbox::after {
  content:'✓'; font-size:10px; color:#000; font-weight:900;
}
.choice-checkbox.hidden { display:none; }

.choice-letter-badge {
  width:36px; height:36px; border-radius:10px; flex-shrink:0;
  background:var(--tc); color:#000;
  font-family:var(--font-hud); font-size:0.9rem; font-weight:900;
  display:flex; align-items:center; justify-content:center;
  box-shadow:var(--glow-sm);
  transition:transform 0.2s cubic-bezier(0.34,1.56,0.64,1);
}
.choice-btn:hover .choice-letter-badge { transform:scale(1.1) rotate(-4deg); }

.choice-content { flex:1; display:flex; flex-direction:column; gap:6px; }
.choice-text-val {
  font-size:0.95rem; font-weight:600; color:#e2e8f0; line-height:1.35;
}
.choice-img-wrap {
  width:100%; border-radius:8px; overflow:hidden;
  background:rgba(0,0,0,0.3); display:none;
}
.choice-img-wrap.has-img { display:block; }
.choice-img {
  width:100%; max-height:100px; object-fit:contain; display:block;
}

/* Selection states */
.choice-btn.selected   { border-color:var(--tc); background:var(--tc-dim); }
.choice-btn.correct-c  { border-color:var(--correct)!important; background:rgba(34,197,94,0.10)!important; }
.choice-btn.wrong-c    { border-color:var(--wrong)!important;   background:rgba(239,68,68,0.09)!important; }
.choice-btn.correct-c .choice-letter-badge { background:var(--correct); }
.choice-btn.wrong-c   .choice-letter-badge { background:var(--wrong); color:#fff; }
.choice-btn.correct-c .choice-checkbox,
.choice-btn.wrong-c   .choice-checkbox     { border-color:transparent; }

/* Flash animation on press */
.choice-btn.flash { animation:btnFlash 0.28s ease; }
@keyframes btnFlash { 0%{filter:brightness(1);} 40%{filter:brightness(2.2) saturate(1.5);} 100%{filter:brightness(1);} }

/* ── PERIODIC SEQUENCE ── */
#periodic-seq-wrap { display:none; }
#periodic-seq-wrap.active { display:block; }

#formula-display-bar {
  background:rgba(0,0,0,0.45);
  border:1px solid var(--panel-b);
  border-radius:12px; padding:14px 18px; margin-bottom:14px;
  font-family:var(--font-hud); font-size:1.5rem; font-weight:700;
  color:#fff; text-align:center; letter-spacing:0.05em;
  min-height:54px; display:flex; align-items:center; justify-content:center;
  box-shadow:inset 0 0 20px rgba(0,0,0,0.3);
}
.formula-sym { color:#fff; }
.formula-sub-num { font-size:0.6em; vertical-align:sub; color:var(--tc); }

#formula-slots-row {
  display:flex; gap:8px; flex-wrap:wrap;
  justify-content:center; margin-bottom:12px;
}
.f-slot {
  width:64px; height:76px;
  border:2px dashed rgba(255,255,255,0.18);
  border-radius:12px;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  font-family:var(--font-hud);
  color:rgba(255,255,255,0.20);
  transition:all 0.28s cubic-bezier(0.34,1.56,0.64,1);
  position:relative;
}
.f-slot.active-slot {
  border-color:var(--tc); box-shadow:var(--glow-sm);
  background:var(--tc-dim);
}
.f-slot.filled-slot {
  border-color:var(--tc); background:var(--tc-dim);
  animation:slotPop 0.35s cubic-bezier(0.34,1.56,0.64,1);
}
@keyframes slotPop { 0%{transform:scale(0.6);} 70%{transform:scale(1.15);} 100%{transform:scale(1);} }
.f-slot-sym { font-size:1.35rem; font-weight:900; color:#fff; line-height:1; }
.f-slot-sub { font-size:0.65rem; color:var(--tc); margin-top:2px; }
.f-slot-active-indicator {
  position:absolute; bottom:-6px; left:50%; transform:translateX(-50%);
  width:6px; height:6px; border-radius:50%; background:var(--tc);
  animation:pulseDot 0.8s ease infinite; display:none;
}
.f-slot.active-slot .f-slot-active-indicator { display:block; }

#periodic-controls-hint {
  font-family:var(--font-hud); font-size:7px; letter-spacing:0.2em;
  color:rgba(255,255,255,0.35); text-align:center; text-transform:uppercase;
  line-height:1.8;
}

/* ── PERIODIC SINGLE ── */
#periodic-single-wrap { display:none; }
#periodic-single-wrap.active {
  display:flex; flex-direction:column; align-items:center; gap:16px;
}
#single-element-card {
  width:130px; height:155px;
  background:linear-gradient(145deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
  border:2px solid var(--panel-b);
  border-radius:18px;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  gap:4px; position:relative; overflow:hidden;
  box-shadow:var(--glow-md), 0 8px 32px rgba(0,0,0,0.5);
  transition:all 0.3s cubic-bezier(0.34,1.56,0.64,1);
}
#single-element-card.has-answer {
  border-color:var(--tc); box-shadow:var(--glow-xl);
  animation:slotPop 0.4s cubic-bezier(0.34,1.56,0.64,1);
}
#single-elem-sym {
  font-family:var(--font-hud); font-size:3.2rem; font-weight:900;
  color:#fff; line-height:1; text-shadow:var(--glow-sm);
}
#single-elem-name {
  font-size:0.65rem; color:rgba(255,255,255,0.45); letter-spacing:0.1em;
}
#single-elem-placeholder {
  font-family:var(--font-hud); font-size:1rem; color:rgba(255,255,255,0.15);
  letter-spacing:0.2em;
}

/* ── NUMERIC INPUT ── */
#numeric-wrap { display:none; }
#numeric-wrap.active {
  display:flex; flex-direction:column; align-items:center; gap:12px;
}

.numeric-field-group { display:flex; flex-direction:column; align-items:center; gap:4px; width:100%; max-width:320px; }
.numeric-field-label {
  font-family:var(--font-hud); font-size:7px; letter-spacing:0.22em;
  color:var(--tc); text-transform:uppercase; opacity:0.75; align-self:flex-start;
}
.numeric-display {
  width:100%; padding:14px 20px;
  background:rgba(0,0,0,0.45); border:2px solid var(--panel-b);
  border-radius:12px; text-align:center;
  font-family:var(--font-hud); font-size:1.8rem; font-weight:900;
  color:#fff; letter-spacing:0.05em;
  transition:border-color 0.3s ease, box-shadow 0.3s ease;
  min-height:58px; display:flex; align-items:center; justify-content:center;
}
.numeric-display.active-field {
  border-color:var(--tc); box-shadow:var(--glow-sm);
}
#numeric-range-display {
  font-family:var(--font-mono); font-size:0.8rem;
  color:rgba(255,255,255,0.45); text-align:center;
  padding:6px 16px; background:rgba(255,255,255,0.04);
  border-radius:8px; border:1px solid var(--panel-b2);
  width:100%; max-width:320px;
}
#numeric-controls-hint {
  font-family:var(--font-hud); font-size:7px; letter-spacing:0.2em;
  color:rgba(255,255,255,0.30); text-align:center; text-transform:uppercase; line-height:1.8;
}

/* ═══════════════════════════════════════════════════════════════
   TIMER — Bottom right of main area
═══════════════════════════════════════════════════════════════ */
#timer-wrap {
  position:absolute; bottom:56px; right:24px; z-index:20;
  display:flex; flex-direction:column; align-items:center;
}
#timer-svg { width:84px; height:84px; transform:rotate(-90deg); }
#timer-track { stroke:rgba(255,255,255,0.07); }
#timer-bar {
  stroke:var(--tc); stroke-linecap:round;
  transition:stroke-dashoffset 0.95s linear, stroke 0.4s ease;
}
#timer-num {
  position:absolute; top:50%; left:50%; transform:translate(-50%,-50%);
  font-family:var(--font-hud); font-size:1.55rem; font-weight:900;
  color:#fff; text-shadow:var(--glow-sm); z-index:2;
}
#timer-label {
  font-family:var(--font-hud); font-size:6px; letter-spacing:0.22em;
  color:var(--tc); text-transform:uppercase; opacity:0.7; margin-top:2px;
}
.timer-critical #timer-num { color:#ef4444; animation:blinkNum 0.5s ease infinite; }
.timer-critical #timer-bar { stroke:#ef4444 !important; }
.timer-warning  #timer-num { color:#f59e0b; }
.timer-warning  #timer-bar { stroke:#f59e0b !important; }
@keyframes blinkNum { 0%,100%{opacity:1;} 50%{opacity:0.2;} }

/* Global timer bar (for Global timer_type) */
#global-timer-bar-wrap {
  position:absolute; bottom:50px; left:0; right:0; height:3px;
  background:rgba(255,255,255,0.06); z-index:10; display:none;
}
#global-timer-bar-inner {
  height:100%; background:linear-gradient(90deg, var(--tc), var(--tc2));
  transition:width 1s linear;
  box-shadow:0 0 6px var(--tc-glow);
}

/* ═══════════════════════════════════════════════════════════════
   BOTTOM TOOLBAR
═══════════════════════════════════════════════════════════════ */
#bottom-toolbar {
  height:50px; flex-shrink:0;
  display:flex; align-items:center;
  background:var(--panel-bg);
  border-top:1px solid var(--panel-b);
  backdrop-filter:blur(24px);
  -webkit-backdrop-filter:blur(24px);
  padding:0 16px; gap:8px; z-index:15; position:relative;
}
#bottom-toolbar::before {
  content:''; position:absolute; top:0; left:0; right:0; height:1px;
  background:linear-gradient(90deg, transparent, var(--tc), transparent);
  opacity:0.4;
}

.toolbar-btn {
  display:flex; align-items:center; gap:7px;
  padding:6px 14px; border-radius:8px;
  background:rgba(255,255,255,0.04);
  border:1px solid var(--panel-b2);
  color:rgba(255,255,255,0.65); cursor:pointer;
  font-family:var(--font-hud); font-size:8px; letter-spacing:0.18em; text-transform:uppercase;
  transition:all 0.2s ease;
  flex-shrink:0;
}
.toolbar-btn:hover { border-color:var(--tc); color:var(--tc); background:var(--tc-dim); box-shadow:var(--glow-sm); }
.toolbar-btn i { font-size:12px; }
.toolbar-btn.active { border-color:var(--tc); color:var(--tc); background:var(--tc-dim); }
.toolbar-btn.danger-active { border-color:#ef4444; color:#ef4444; background:rgba(239,68,68,0.10); }
.toolbar-btn.muted { border-color:rgba(239,68,68,0.3); color:rgba(239,68,68,0.7); }

#toolbar-spacer { flex:1; }

/* Enter button highlight */
#btn-enter {
  background:var(--tc-dim); border-color:var(--tc); color:var(--tc);
  font-weight:900; padding:6px 20px;
}
#btn-enter.hidden-el { display:none; }
#btn-enter:hover { background:var(--tc); color:#000; box-shadow:var(--glow-md); }
#btn-enter.required-pulse {
  animation:enterPulse 1.2s ease infinite;
}
@keyframes enterPulse {
  0%,100%{box-shadow:var(--glow-sm);}
  50%{box-shadow:var(--glow-xl);}
}

/* ═══════════════════════════════════════════════════════════════
   FEEDBACK OVERLAY (fullscreen over right area)
═══════════════════════════════════════════════════════════════ */
#feedback-overlay {
  position:absolute; inset:0; z-index:100;
  display:flex; flex-direction:column; align-items:center; justify-content:center;
  background:rgba(0,0,0,0.88); backdrop-filter:blur(12px);
  opacity:0; pointer-events:none;
  transition:opacity 0.25s ease;
}
#feedback-overlay.show { opacity:1; pointer-events:all; }

#fb-icon {
  font-size:5rem; line-height:1; margin-bottom:12px;
  animation:fbIconIn 0.35s cubic-bezier(0.34,1.56,0.64,1) both;
}
@keyframes fbIconIn { from{transform:scale(0.3) rotate(-30deg);opacity:0;} to{transform:scale(1) rotate(0deg);opacity:1;} }
#fb-title {
  font-family:var(--font-hud); font-size:2.2rem; font-weight:900;
  letter-spacing:0.12em; margin-bottom:8px;
  animation:fadeUp 0.3s ease 0.1s both;
}
#fb-sub {
  font-size:1rem; color:rgba(255,255,255,0.70); margin-bottom:10px;
  animation:fadeUp 0.3s ease 0.18s both;
}
#fb-correct-answer {
  font-family:var(--font-hud); font-size:1.1rem; font-weight:700;
  padding:8px 24px; border-radius:10px;
  background:rgba(34,197,94,0.15); color:#22c55e;
  border:1px solid rgba(34,197,94,0.35);
  animation:fadeUp 0.3s ease 0.25s both;
  display:none;
}
#fb-correct-answer.show { display:block; }

/* Card shake */
#right-area.card-shake { animation:shakeX 0.45s ease; }
@keyframes shakeX { 0%,100%{transform:translateX(0);} 20%{transform:translateX(-10px);} 40%{transform:translateX(10px);} 60%{transform:translateX(-6px);} 80%{transform:translateX(6px);} }
#right-area.correct-flash { animation:correctFlash 0.5s ease; }
@keyframes correctFlash { 0%,100%{box-shadow:none;} 50%{box-shadow:inset 0 0 60px rgba(34,197,94,0.25);} }

/* ═══════════════════════════════════════════════════════════════
   ZOOM OVERLAY
═══════════════════════════════════════════════════════════════ */
#zoom-overlay {
  position:fixed; inset:0; z-index:500;
  background:rgba(0,0,0,0.95); backdrop-filter:blur(20px);
  display:none; flex-direction:column; align-items:center; justify-content:center;
  gap:16px; padding:24px;
}
#zoom-overlay.show { display:flex; animation:zoomIn 0.3s cubic-bezier(0.34,1.56,0.64,1); }
@keyframes zoomIn { from{opacity:0;transform:scale(0.85);} to{opacity:1;transform:scale(1);} }

#zoom-media-wrap { flex:1; display:flex; align-items:center; justify-content:center; width:100%; }
#zoom-img { max-width:100%; max-height:70vh; object-fit:contain; border-radius:12px; }
#zoom-video { max-width:100%; max-height:70vh; border-radius:12px; }
#zoom-label {
  font-family:var(--font-hud); font-size:0.85rem; letter-spacing:0.18em;
  color:var(--tc); text-transform:uppercase;
}
#zoom-nav-hint {
  font-family:var(--font-hud); font-size:7px; letter-spacing:0.2em;
  color:rgba(255,255,255,0.35); text-transform:uppercase;
}

/* ═══════════════════════════════════════════════════════════════
   HOME CONFIRMATION DIALOG
═══════════════════════════════════════════════════════════════ */
#home-dialog {
  position:fixed; inset:0; z-index:600;
  background:rgba(0,0,0,0.90); backdrop-filter:blur(16px);
  display:none; align-items:center; justify-content:center;
}
#home-dialog.show { display:flex; animation:zoomIn 0.3s cubic-bezier(0.34,1.56,0.64,1); }
#home-dialog-card {
  background:var(--panel-bg); border:1px solid var(--panel-b);
  border-radius:20px; padding:36px 40px; text-align:center;
  max-width:420px; width:90%;
  box-shadow:var(--glow-xl), 0 24px 60px rgba(0,0,0,0.8);
}
#home-dialog-icon { font-size:2.8rem; margin-bottom:12px; }
#home-dialog-title {
  font-family:var(--font-hud); font-size:1.1rem; font-weight:900;
  letter-spacing:0.1em; color:#fff; margin-bottom:8px;
}
#home-dialog-sub {
  font-size:0.88rem; color:rgba(255,255,255,0.55); line-height:1.5; margin-bottom:24px;
}
.dialog-btn-row { display:flex; gap:12px; justify-content:center; }
.dialog-btn {
  padding:10px 28px; border-radius:10px; cursor:pointer;
  font-family:var(--font-hud); font-size:0.72rem; font-weight:700;
  letter-spacing:0.14em; text-transform:uppercase;
  transition:all 0.2s ease; border:none;
}
#dialog-yes-btn { background:var(--tc); color:#000; }
#dialog-yes-btn:hover { transform:scale(1.05); box-shadow:var(--glow-md); }
#dialog-no-btn  { background:rgba(255,255,255,0.06); color:rgba(255,255,255,0.65); border:1px solid rgba(255,255,255,0.15); }
#dialog-no-btn:hover  { border-color:var(--wrong); color:var(--wrong); }
#dialog-enter-hint {
  margin-top:14px; font-family:var(--font-hud); font-size:7px;
  letter-spacing:0.2em; color:rgba(255,255,255,0.30); text-transform:uppercase;
}

/* ═══════════════════════════════════════════════════════════════
   UTILITY
═══════════════════════════════════════════════════════════════ */
.hidden-el { display:none !important; }
.light-mode {
  --bg-core:#f0f4f8; --panel-bg:rgba(255,255,255,0.90);
  --panel-b:rgba(0,0,0,0.12); --panel-b2:rgba(0,0,0,0.08);
}
.light-mode #question-text { color:#1e293b; }
.light-mode .stat-card-val,
.light-mode .hud-cell-val,
.light-mode .hud-student-name { color:#1e293b; }
.light-mode .choice-btn { background:rgba(0,0,0,0.03); border-color:rgba(0,0,0,0.12); }
.light-mode .choice-text-val { color:#334155; }

/* Combo tag */
#combo-tag {
  position:fixed; top:45%; left:50%; transform:translate(-50%,-50%);
  z-index:400; pointer-events:none; opacity:0;
  transition:opacity 0.2s ease; text-align:center;
}
#combo-tag.show { opacity:1; animation:comboIn 0.5s cubic-bezier(0.34,1.56,0.64,1); }
@keyframes comboIn { from{transform:translate(-50%,-50%) scale(0.4);} to{transform:translate(-50%,-50%) scale(1);} }
#combo-inner {
  font-family:var(--font-hud); font-size:3rem; font-weight:900;
  color:#fbbf24; text-shadow:0 0 30px rgba(251,191,36,0.8);
  letter-spacing:0.05em;
}
</style>
</head>

<%
  var initTheme = '';
  if (questions && questions.length > 0 && questions[0].theme_id) {
    initTheme = questions[0].theme_id;
  } else {
    initTheme = 'default_lab';
  }
%>
<body class="theme-<%= initTheme %>">

<!-- AMBIENT BACKGROUND -->
<div id="bg-layer"></div>
<div id="ambient-layer"></div>

<!-- COMBO TAG -->
<div id="combo-tag">
  <div id="combo-inner"><span id="combo-val">3</span>x COMBO!</div>
</div>

<!-- ZOOM OVERLAY -->
<div id="zoom-overlay">
  <div id="zoom-label">QUESTION MEDIA</div>
  <div id="zoom-media-wrap">
    <img id="zoom-img" src="" alt="Zoomed media" style="display:none;">
    <video id="zoom-video" controls style="display:none;"></video>
  </div>
  <div id="zoom-nav-hint">[ A ] PREV IMAGE &nbsp;·&nbsp; [ C ] NEXT IMAGE &nbsp;·&nbsp; [ ZOOM ] EXIT</div>
</div>

<!-- HOME DIALOG -->
<div id="home-dialog">
  <div id="home-dialog-card">
    <div id="home-dialog-icon">🏠</div>
    <div id="home-dialog-title">EXIT ASSESSMENT?</div>
    <div id="home-dialog-sub">
      Your progress will be saved. You can continue from where you left off.<br>
      Press <strong>ENTER</strong> to confirm exit, or press <strong>HOME</strong> again to cancel.
    </div>
    <div class="dialog-btn-row">
      <button class="dialog-btn" id="dialog-yes-btn" onclick="confirmHome()">Yes, Exit</button>
      <button class="dialog-btn" id="dialog-no-btn"  onclick="cancelHome()">Stay</button>
    </div>
    <div id="dialog-enter-hint">ENTER = CONFIRM EXIT &nbsp;·&nbsp; HOME = CANCEL</div>
  </div>
</div>

<!-- MAIN GAME ROOT -->
<div id="game-root">

  <!-- ════════════════════════════════════════════
       LEFT PANEL
  ════════════════════════════════════════════ -->
  <div id="left-panel">

    <!-- Instruction -->
    <div id="instruction-section">
      <div id="instruction-label">
        <i class="fas fa-flask" style="font-size:9px;"></i>
        Instruction
      </div>
      <div id="instruction-content">—</div>
    </div>

    <!-- Question History -->
    <div id="history-section" id="history-list">
      <!-- Dynamically populated -->
    </div>

    <!-- Score / EXP -->
    <div id="score-exp-section">
      <div class="stat-card" id="score-card">
        <div class="stat-card-label">Score</div>
        <div class="stat-card-val" id="score-display">0</div>
        <span id="score-fraction">/ 0 pts</span>
      </div>
      <div class="stat-card" id="exp-card">
        <div class="stat-card-label">EXP</div>
        <div class="stat-card-val" id="exp-display">0</div>
      </div>
    </div>

  </div>
  <!-- /left-panel -->

  <!-- ════════════════════════════════════════════
       RIGHT AREA
  ════════════════════════════════════════════ -->
  <div id="right-area">

    <!-- Feedback Overlay -->
    <div id="feedback-overlay">
      <div id="fb-icon">✓</div>
      <div id="fb-title">SUCCESS</div>
      <div id="fb-sub">+100 EXP</div>
      <div id="fb-correct-answer"></div>
    </div>

    <!-- Top HUD Bar -->
    <div id="top-hud">
      <div class="hud-cell">
        <div class="hud-cell-label">Assessment</div>
        <div class="hud-cell-val"><%= assessment.assessment_name || 'Assessment' %></div>
      </div>
      <div class="hud-cell">
        <div class="hud-cell-label">Type</div>
        <div class="hud-cell-val accent"><%= assessment.assessment_type || '—' %></div>
      </div>
      <div class="hud-cell">
        <div class="hud-cell-label">Mode</div>
        <div class="hud-cell-val">
          <span id="hud-input-mode">Standard</span>
        </div>
      </div>
      <!-- Student info -->
      <div class="hud-cell" id="hud-student-cell">
        <img id="hud-avatar"
             src="/uploads/profiles/<%= user.profile_pic || 'default_avatar.png' %>"
             alt="<%= user.first_name %>"
             onerror="this.src='/uploads/profiles/default_avatar.png'">
        <div class="hud-student-info">
          <div class="hud-student-name"><%= user.first_name %> <%= user.last_name || '' %></div>
          <div class="hud-student-level">LVL <%= user.current_level || 1 %></div>
        </div>
      </div>
    </div>

    <!-- Main Game Area -->
    <div id="main-game-area">

      <!-- Timer (PerItem) -->
      <div id="timer-wrap">
        <svg id="timer-svg" viewBox="0 0 100 100">
          <circle id="timer-track" cx="50" cy="50" r="42" stroke-width="5" fill="transparent"/>
          <circle id="timer-bar"   cx="50" cy="50" r="42" stroke-width="6" fill="transparent"
                  stroke-dasharray="263.89" stroke-dashoffset="0"/>
        </svg>
        <div id="timer-num">—</div>
        <div id="timer-label">TIME</div>
      </div>

      <!-- Global timer bar -->
      <div id="global-timer-bar-wrap">
        <div id="global-timer-bar-inner" style="width:100%;"></div>
      </div>

      <!-- Scrollable question + answer content -->
      <div id="game-scroll">

        <!-- Q Meta -->
        <div id="q-meta-row">
          <div id="difficulty-badge" class="diff-easy">Easy</div>
          <div id="q-progress-text">Q<span id="q-num">1</span> / <span id="q-total"><%= questions ? questions.length : 0 %></span></div>
        </div>

        <!-- Progress bar -->
        <div id="progress-bar-wrap">
          <div id="progress-bar" style="width:0%;"></div>
        </div>

        <!-- Question Text -->
        <p id="question-text">Loading question...</p>

        <!-- Media -->
        <div id="media-wrap">
          <img id="media-img" src="" alt="Question media" onclick="openZoom()">
          <video id="media-video" playsinline onclick="openZoom()"></video>
          <div id="media-zoom-hint"><i class="fas fa-search-plus"></i> ZOOM</div>
        </div>

        <!-- ── ANSWER AREA ── -->
        <div id="answer-area">

          <!-- Standard MCQ -->
          <div id="mcq-wrap">
            <div class="choice-btn" id="choice-a" data-key="A" onclick="onChoiceClick('A')">
              <div class="choice-checkbox" id="cb-a"></div>
              <div class="choice-letter-badge">A</div>
              <div class="choice-content">
                <div class="choice-text-val" id="opt-a-text"></div>
                <div class="choice-img-wrap" id="opt-a-img-wrap">
                  <img class="choice-img" id="opt-a-img" src="" alt="Choice A">
                </div>
              </div>
            </div>
            <div class="choice-btn" id="choice-b" data-key="B" onclick="onChoiceClick('B')">
              <div class="choice-checkbox" id="cb-b"></div>
              <div class="choice-letter-badge">B</div>
              <div class="choice-content">
                <div class="choice-text-val" id="opt-b-text"></div>
                <div class="choice-img-wrap" id="opt-b-img-wrap">
                  <img class="choice-img" id="opt-b-img" src="" alt="Choice B">
                </div>
              </div>
            </div>
            <div class="choice-btn" id="choice-c" data-key="C" onclick="onChoiceClick('C')">
              <div class="choice-checkbox" id="cb-c"></div>
              <div class="choice-letter-badge">C</div>
              <div class="choice-content">
                <div class="choice-text-val" id="opt-c-text"></div>
                <div class="choice-img-wrap" id="opt-c-img-wrap">
                  <img class="choice-img" id="opt-c-img" src="" alt="Choice C">
                </div>
              </div>
            </div>
            <div class="choice-btn" id="choice-d" data-key="D" onclick="onChoiceClick('D')">
              <div class="choice-checkbox" id="cb-d"></div>
              <div class="choice-letter-badge">D</div>
              <div class="choice-content">
                <div class="choice-text-val" id="opt-d-text"></div>
                <div class="choice-img-wrap" id="opt-d-img-wrap">
                  <img class="choice-img" id="opt-d-img" src="" alt="Choice D">
                </div>
              </div>
            </div>
          </div>
          <!-- /mcq-wrap -->

          <!-- Periodic Sequence -->
          <div id="periodic-seq-wrap">
            <div id="formula-display-bar">—</div>
            <div id="formula-slots-row"></div>
            <div id="periodic-controls-hint">
              ELEMENT BUTTONS = ADD ELEMENT &nbsp;·&nbsp; D(−) / B(+) = SUBSCRIPT<br>
              A(←) / C(→) = NAVIGATE SLOTS &nbsp;·&nbsp; ENTER = CONFIRM
            </div>
          </div>

          <!-- Periodic Single -->
          <div id="periodic-single-wrap">
            <div id="single-element-card">
              <div id="single-elem-sym">?</div>
              <div id="single-elem-name" class="hidden-el"></div>
              <div id="single-elem-placeholder">PRESS ELEMENT</div>
            </div>
          </div>

          <!-- Numeric -->
          <div id="numeric-wrap">
            <div class="numeric-field-group">
              <div class="numeric-field-label">Your Answer</div>
              <div class="numeric-display active-field" id="numeric-val-display">0</div>
            </div>
            <div class="numeric-field-group">
              <div class="numeric-field-label">Tolerance (±)</div>
              <div class="numeric-display" id="numeric-tol-display">—</div>
            </div>
            <div id="numeric-range-display">Range: — </div>
            <div id="numeric-controls-hint">
              A(−) / C(+) = CHANGE VALUE &nbsp;·&nbsp; B = CYCLE STEP &nbsp;·&nbsp; D = TOGGLE SIGN &nbsp;·&nbsp; ENTER = CONFIRM
            </div>
          </div>

        </div>
        <!-- /answer-area -->

      </div>
      <!-- /game-scroll -->

    </div>
    <!-- /main-game-area -->

    <!-- Bottom Toolbar -->
    <div id="bottom-toolbar">
      <button class="toolbar-btn" id="btn-repeat" onclick="onRepeat()" title="Repeat Speech">
        <i class="fas fa-redo"></i> Repeat
      </button>
      <button class="toolbar-btn" id="btn-instruction" onclick="onInstruction()" title="Read Instruction">
        <i class="fas fa-book-open"></i> Instruction
      </button>
      <button class="toolbar-btn" id="btn-zoom" onclick="openZoom()" title="Zoom Media">
        <i class="fas fa-search-plus"></i> Zoom
      </button>
      <button class="toolbar-btn" id="btn-bgm" onclick="toggleBGM()" title="Background Music">
        <i class="fas fa-music" id="bgm-icon"></i> BGM
      </button>

      <div id="toolbar-spacer"></div>

      <button class="toolbar-btn" id="btn-enter" onclick="onEnterPress()" title="Confirm Answer">
        <i class="fas fa-check"></i> ENTER
      </button>
      <button class="toolbar-btn" id="btn-home" onclick="onHome()" title="Exit to Standby">
        <i class="fas fa-home"></i> Home
      </button>
    </div>

  </div>
  <!-- /right-area -->

</div>
<!-- /game-root -->
