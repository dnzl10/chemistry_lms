<%#
  ============================================================
  FILE: views/arcade/game.ejs
  PURPOSE: Chemistry Arcade — Single Player Game Interface
  EJS VARIABLES FROM ROUTER:
    questions    : array of processed question objects (Approved only)
    user         : { user_id, first_name, last_name, profile_pic,
                     current_level, total_exp }
    token        : QR token string
    assessmentId : integer
    assessment   : { assessment_id, assessment_name, assessment_type,
                     timer_type, duration_minutes, total_items,
                     sound_bg, sound_correct, sound_wrong,
                     sound_result_pass, sound_result_fail, speech_enabled }
    totalPossibleScore : integer
    buttonMappings : array of { button_pin, element_symbol, player_side }
    resumeIndex    : integer (0 if fresh, N if resuming)
  ============================================================
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chemistry Arcade — Mission Active</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/howler/2.2.3/howler.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/canvas-confetti@1.6.0/dist/confetti.browser.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Orbitron:wght@400;500;700;900&family=Rajdhani:wght@400;500;600;700&family=Share+Tech+Mono&display=swap');

        /* ═══════════════════════════════════════════════
           THEME SYSTEM — CSS CUSTOM PROPERTIES
        ═══════════════════════════════════════════════ */
        :root {
            --tc:        #14b8a6;
            --tc2:       #06b6d4;
            --tc3:       #0e7490;
            --tc-dim:    rgba(20,184,166,0.14);
            --tc-mid:    rgba(20,184,166,0.35);
            --bg-core:   #020c10;
            --panel-bg:  rgba(2,20,22,0.92);
            --panel-b:   rgba(20,184,166,0.28);
            --glow:      0 0 40px rgba(20,184,166,0.38);
            --glow-sm:   0 0 16px rgba(20,184,166,0.52);
            --glow-xl:   0 0 90px rgba(20,184,166,0.22), 0 0 45px rgba(20,184,166,0.32);
            --feedback-correct-bg: rgba(0,20,10,0.95);
            --feedback-wrong-bg:   rgba(20,0,0,0.95);
        }
        body.theme-default_lab {
            --tc:#14b8a6; --tc2:#06b6d4; --tc3:#0e7490;
            --tc-dim:rgba(20,184,166,0.14); --tc-mid:rgba(20,184,166,0.35);
            --bg-core:#020c10; --panel-bg:rgba(2,20,22,0.92); --panel-b:rgba(20,184,166,0.30);
            --glow:0 0 50px rgba(20,184,166,0.40); --glow-sm:0 0 18px rgba(20,184,166,0.58);
            --glow-xl:0 0 100px rgba(20,184,166,0.25), 0 0 50px rgba(20,184,166,0.35);
        }
        body.theme-space_lab {
            --tc:#f97316; --tc2:#fbbf24; --tc3:#ea580c;
            --tc-dim:rgba(249,115,22,0.14); --tc-mid:rgba(249,115,22,0.35);
            --bg-core:#0c0500; --panel-bg:rgba(20,8,0,0.92); --panel-b:rgba(249,115,22,0.32);
            --glow:0 0 55px rgba(249,115,22,0.45); --glow-sm:0 0 18px rgba(249,115,22,0.60);
            --glow-xl:0 0 110px rgba(249,115,22,0.28), 0 0 55px rgba(251,191,36,0.22);
        }
        body.theme-jungle_lab {
            --tc:#818cf8; --tc2:#c084fc; --tc3:#6366f1;
            --tc-dim:rgba(129,140,248,0.14); --tc-mid:rgba(129,140,248,0.35);
            --bg-core:#02000f; --panel-bg:rgba(4,0,20,0.92); --panel-b:rgba(129,140,248,0.32);
            --glow:0 0 55px rgba(129,140,248,0.45); --glow-sm:0 0 18px rgba(192,132,252,0.60);
            --glow-xl:0 0 110px rgba(129,140,248,0.28), 0 0 55px rgba(192,132,252,0.22);
        }
        body.theme-ocean_lab {
            --tc:#84cc16; --tc2:#a3e635; --tc3:#65a30d;
            --tc-dim:rgba(132,204,22,0.14); --tc-mid:rgba(132,204,22,0.35);
            --bg-core:#020800; --panel-bg:rgba(4,10,0,0.92); --panel-b:rgba(132,204,22,0.32);
            --glow:0 0 55px rgba(132,204,22,0.45); --glow-sm:0 0 18px rgba(163,230,53,0.60);
            --glow-xl:0 0 110px rgba(132,204,22,0.28), 0 0 55px rgba(163,230,53,0.22);
        }
        body.theme-volcano_lab {
            --tc:#38bdf8; --tc2:#e879f9; --tc3:#0ea5e9;
            --tc-dim:rgba(56,189,248,0.14); --tc-mid:rgba(56,189,248,0.35);
            --bg-core:#000810; --panel-bg:rgba(0,8,22,0.92); --panel-b:rgba(56,189,248,0.32);
            --glow:0 0 55px rgba(56,189,248,0.45); --glow-sm:0 0 18px rgba(232,121,249,0.60);
            --glow-xl:0 0 110px rgba(56,189,248,0.28), 0 0 55px rgba(232,121,249,0.22);
        }

        /* ═══════════════════════════════════════════════
           BASE RESET
        ═══════════════════════════════════════════════ */
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        html, body {
            height: 100%; overflow: hidden;
            font-family: 'Rajdhani', sans-serif;
        }
        body {
            background-color: var(--bg-core);
            background-image:
                radial-gradient(ellipse at 20% 20%, rgba(20,184,166,0.07) 0%, transparent 55%),
                radial-gradient(ellipse at 80% 80%, rgba(6,182,212,0.05) 0%, transparent 55%);
            color: #e2e8f0;
            transition: background-color 1.2s ease;
        }

        /* CRT scanlines */
        body::before {
            content: ''; position: fixed; inset: 0; z-index: 200; pointer-events: none;
            background:
                linear-gradient(rgba(0,0,0,0) 50%, rgba(0,0,0,0.04) 50%),
                linear-gradient(90deg, rgba(255,0,0,0.015), rgba(0,255,0,0.008), rgba(0,0,255,0.015));
            background-size: 100% 2px, 3px 100%;
            animation: scanMove 12s linear infinite;
        }
        @keyframes scanMove { 0%{background-position:0 0;} 100%{background-position:0 100%;} }

        /* ═══════════════════════════════════════════════
           AMBIENT LAYER
        ═══════════════════════════════════════════════ */
        #ambient-layer { position: fixed; inset: 0; z-index: 1; pointer-events: none; overflow: hidden; }
        .amb-particle { position: absolute; border-radius: 50%; pointer-events: none; }

        /* ═══════════════════════════════════════════════
           MAIN LAYOUT — PDF WIREFRAME FAITHFUL
           LEFT PANEL (280px fixed) + RIGHT MAIN AREA
        ═══════════════════════════════════════════════ */
        #game-root {
            position: relative; height: 100vh; width: 100%;
            display: flex; z-index: 10; overflow: hidden;
        }

        /* ── LEFT PANEL ── */
        #left-panel {
            width: 280px; min-width: 280px;
            display: flex; flex-direction: column;
            background: rgba(0,0,0,0.55);
            border-right: 1.5px solid var(--panel-b);
            backdrop-filter: blur(24px);
            z-index: 20; overflow: hidden;
            transition: border-color 0.6s ease;
        }

        /* Instruction box (top of left panel) */
        #instruction-box {
            padding: 14px 16px;
            border-bottom: 1px solid rgba(255,255,255,0.06);
            min-height: 80px; max-height: 160px;
            overflow-y: auto;
            background: rgba(255,255,255,0.02);
            flex-shrink: 0;
        }
        #instruction-label {
            font-family: 'Orbitron', sans-serif;
            font-size: 8px; font-weight: 700;
            letter-spacing: 0.2em; text-transform: uppercase;
            color: var(--tc); opacity: 0.7; margin-bottom: 6px;
            display: flex; align-items: center; gap: 6px;
        }
        #instruction-label::before {
            content: ''; width: 14px; height: 1.5px;
            background: var(--tc); display: inline-block;
        }
        #instruction-text-display {
            font-size: 12px; color: rgba(255,255,255,0.65);
            line-height: 1.5; font-style: italic;
            font-family: 'Rajdhani', sans-serif;
        }
        #instruction-text-display.empty {
            color: rgba(255,255,255,0.18);
            font-style: italic;
        }

        /* Question history scroll area */
        #history-scroll {
            flex: 1; overflow-y: auto; padding: 10px 12px;
            display: flex; flex-direction: column; gap: 6px;
        }
        #history-scroll::-webkit-scrollbar { width: 3px; }
        #history-scroll::-webkit-scrollbar-thumb { background: var(--tc); border-radius: 2px; }

        .history-label {
            font-family: 'Orbitron', sans-serif;
            font-size: 8px; font-weight: 700;
            letter-spacing: 0.18em; text-transform: uppercase;
            color: rgba(255,255,255,0.28); padding: 4px 2px 6px;
        }

        /* Individual history entry */
        .q-history-item {
            background: rgba(255,255,255,0.03);
            border: 1px solid rgba(255,255,255,0.06);
            border-radius: 10px; padding: 8px 10px;
            animation: histSlideIn 0.3s cubic-bezier(0.34,1.56,0.64,1) both;
        }
        @keyframes histSlideIn {
            from { opacity: 0; transform: translateX(-18px); }
            to   { opacity: 1; transform: translateX(0); }
        }
        .q-history-item.correct { border-color: rgba(34,197,94,0.35); background: rgba(34,197,94,0.05); }
        .q-history-item.wrong   { border-color: rgba(239,68,68,0.35);  background: rgba(239,68,68,0.05); }
        .q-history-item.resumed { border-color: rgba(100,116,139,0.35); background: rgba(100,116,139,0.04); }

        .q-hist-header {
            display: flex; align-items: center; justify-content: space-between;
            margin-bottom: 4px;
        }
        .q-hist-num {
            font-family: 'Orbitron', sans-serif;
            font-size: 9px; font-weight: 700;
            color: rgba(255,255,255,0.40);
        }
        .q-hist-badge {
            font-size: 9px; font-weight: 800; padding: 1px 7px;
            border-radius: 99px; text-transform: uppercase; letter-spacing: 0.06em;
        }
        .q-hist-badge.correct { background: rgba(34,197,94,0.18); color: #4ade80; }
        .q-hist-badge.wrong   { background: rgba(239,68,68,0.18);  color: #f87171; }
        .q-hist-badge.timeout { background: rgba(251,191,36,0.18); color: #fbbf24; }
        .q-hist-badge.resumed { background: rgba(100,116,139,0.18); color: #94a3b8; }

        .q-hist-answers {
            display: flex; gap: 6px; flex-wrap: wrap;
        }
        .q-hist-ans {
            font-size: 10px; padding: 2px 8px; border-radius: 6px;
            font-family: 'Share Tech Mono', monospace;
        }
        .q-hist-ans.student { background: rgba(255,255,255,0.08); color: #cbd5e1; }
        .q-hist-ans.correct-ans { background: rgba(34,197,94,0.15); color: #4ade80; }

        /* Score / EXP bottom of left panel */
        #left-bottom {
            border-top: 1px solid rgba(255,255,255,0.06);
            display: grid; grid-template-columns: 1fr 1fr;
            padding: 0; flex-shrink: 0;
        }
        .stat-box-left {
            padding: 14px 16px; text-align: center;
            border-right: 1px solid rgba(255,255,255,0.06);
        }
        .stat-box-left:last-child { border-right: none; }
        .stat-box-left .stat-lbl {
            font-family: 'Orbitron', sans-serif;
            font-size: 7px; font-weight: 700;
            letter-spacing: 0.2em; text-transform: uppercase;
            color: rgba(255,255,255,0.30); margin-bottom: 4px;
        }
        .stat-box-left .stat-val {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem; font-weight: 900;
            color: #fff; line-height: 1;
            transition: color 0.3s ease;
        }
        #live-exp-val { color: var(--tc); text-shadow: var(--glow-sm); }

        /* ── RIGHT MAIN AREA ── */
        #right-area {
            flex: 1; display: flex; flex-direction: column;
            overflow: hidden; position: relative;
        }

        /* BACKGROUND LAYER (per question) */
        #bg-layer {
            position: absolute; inset: 0; z-index: 0;
            background-size: cover; background-position: center;
            transition: opacity 0.5s ease;
        }
        #bg-layer::after {
            content: ''; position: absolute; inset: 0;
            background: linear-gradient(
                to bottom,
                rgba(0,0,0,0.60) 0%,
                rgba(0,0,0,0.40) 40%,
                rgba(0,0,0,0.70) 100%
            );
        }

        /* TOP HEADER BAR */
        #top-header {
            position: relative; z-index: 10;
            display: flex; align-items: center;
            gap: 0; height: 56px; flex-shrink: 0;
            background: rgba(0,0,0,0.65);
            border-bottom: 1px solid rgba(255,255,255,0.07);
            backdrop-filter: blur(20px);
        }
        .header-cell {
            padding: 0 18px; height: 100%;
            display: flex; align-items: center; justify-content: center;
            border-right: 1px solid rgba(255,255,255,0.06);
            font-family: 'Rajdhani', sans-serif;
        }
        .header-cell:last-child { border-right: none; }
        .header-cell.grow { flex: 1; justify-content: flex-start; }

        .hc-label {
            font-size: 8px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.16em; color: rgba(255,255,255,0.30);
            margin-bottom: 1px;
        }
        .hc-val {
            font-size: 13px; font-weight: 700; color: #fff;
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
        }
        .hc-badge {
            font-size: 9px; font-weight: 800; padding: 2px 10px;
            border-radius: 99px; text-transform: uppercase; letter-spacing: 0.08em;
            background: var(--tc-dim); color: var(--tc);
            border: 1px solid var(--tc-mid);
        }

        /* Student cell */
        #student-cell {
            display: flex; align-items: center; gap: 10px; padding: 0 16px;
            border-left: 1px solid rgba(255,255,255,0.06);
            flex-shrink: 0;
        }
        #student-avatar {
            width: 34px; height: 34px; border-radius: 10px;
            object-fit: cover;
            border: 2px solid var(--tc-mid);
        }
        #student-name {
            font-family: 'Orbitron', sans-serif;
            font-size: 11px; font-weight: 700; color: #fff;
            max-width: 130px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        }

        /* MAIN CONTENT ZONE (question + answer area) */
        #content-zone {
            flex: 1; position: relative; z-index: 10;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            padding: 20px 28px; overflow: hidden;
        }

        /* Question text */
        #question-text {
            font-family: 'Rajdhani', sans-serif;
            font-size: 1.55rem; font-weight: 700;
            line-height: 1.45; text-align: center; color: #f1f5f9;
            text-shadow: 0 2px 14px rgba(0,0,0,0.7);
            margin-bottom: 14px; max-width: 820px;
            width: 100%;
            animation: fadeSlideUp 0.4s cubic-bezier(0.34,1.56,0.64,1) both;
        }
        @keyframes fadeSlideUp {
            from { opacity: 0; transform: translateY(16px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Media zone */
        #media-zone {
            width: 100%; max-width: 820px; margin-bottom: 16px;
            border-radius: 16px; overflow: hidden;
            border: 1.5px solid rgba(255,255,255,0.10);
            background: rgba(0,0,0,0.38);
            display: none; /* shown when media_path present */
            max-height: 220px;
            position: relative;
        }
        #media-img {
            width: 100%; max-height: 220px;
            object-fit: contain; display: block;
        }
        #media-video {
            width: 100%; max-height: 220px;
            object-fit: contain; display: block;
        }

        /* ── ANSWER PANELS ── */
        #answer-area { width: 100%; max-width: 820px; }

        /* Standard MCQ */
        #mcq-grid {
            display: grid; grid-template-columns: 1fr 1fr;
            gap: 10px;
        }
        .choice-btn {
            cursor: pointer; position: relative; overflow: hidden;
            border-radius: 14px; padding: 14px 16px;
            background: rgba(255,255,255,0.04);
            border: 1.5px solid rgba(255,255,255,0.09);
            display: flex; align-items: center; gap: 12px;
            transition: all 0.2s cubic-bezier(0.34,1.56,0.64,1);
            -webkit-tap-highlight-color: transparent;
            min-height: 64px;
        }
        .choice-btn:hover:not(.locked) {
            border-color: var(--tc); box-shadow: var(--glow-sm);
            transform: translateY(-2px) scale(1.015);
        }
        .choice-btn.locked { pointer-events: none; }
        .choice-btn.correct-flash { border-color: #22c55e !important; background: rgba(34,197,94,0.14) !important; }
        .choice-btn.wrong-flash   { border-color: #ef4444 !important; background: rgba(239,68,68,0.10) !important; }
        .choice-btn.selected-multi {
            border-color: var(--tc) !important;
            background: var(--tc-dim) !important;
            box-shadow: var(--glow-sm);
        }

        .choice-letter {
            width: 40px; height: 40px; flex-shrink: 0; border-radius: 11px;
            background: var(--tc); color: #000;
            font-family: 'Orbitron', sans-serif; font-size: 0.9rem; font-weight: 900;
            display: flex; align-items: center; justify-content: center;
            box-shadow: var(--glow-sm);
            transition: transform 0.2s cubic-bezier(0.34,1.56,0.64,1), background 0.3s;
        }
        .choice-btn:hover:not(.locked) .choice-letter { transform: scale(1.14) rotate(-4deg); }

        /* Checkbox for multi-answer */
        .choice-checkbox {
            width: 20px; height: 20px; flex-shrink: 0; border-radius: 6px;
            border: 2px solid rgba(255,255,255,0.25);
            display: flex; align-items: center; justify-content: center;
            transition: all 0.15s ease;
        }
        .choice-btn.selected-multi .choice-checkbox {
            border-color: var(--tc); background: var(--tc);
        }
        .choice-checkbox::after {
            content: ''; width: 5px; height: 9px;
            border-right: 2px solid #000; border-bottom: 2px solid #000;
            transform: rotate(45deg) translateY(-1px);
            display: none;
        }
        .choice-btn.selected-multi .choice-checkbox::after { display: block; }

        .choice-content { flex: 1; min-width: 0; }
        .choice-text {
            font-size: 1rem; font-weight: 600; color: #e2e8f0; line-height: 1.3;
        }
        .choice-img {
            width: 100%; max-height: 90px; object-fit: contain;
            border-radius: 8px; margin-top: 6px;
            display: block;
        }

        /* Multi-answer submit button */
        #multi-submit {
            margin-top: 12px; width: 100%;
            padding: 12px; border-radius: 12px;
            background: linear-gradient(135deg, var(--tc), var(--tc2));
            color: #000; font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem; font-weight: 900;
            letter-spacing: 0.2em; text-transform: uppercase;
            border: none; cursor: pointer;
            box-shadow: var(--glow);
            transition: all 0.22s cubic-bezier(0.34,1.56,0.64,1);
            display: none;
        }
        #multi-submit:hover { transform: scale(1.03); box-shadow: var(--glow-xl); }
        #multi-submit:active { transform: scale(0.97); }
        #multi-submit.visible { display: block; }

        /* ── PERIODIC SINGLE ── */
        #periodic-single-container {
            display: none; flex-direction: column;
            align-items: center; gap: 16px;
        }
        #single-element-card {
            width: 140px; height: 160px; border-radius: 20px;
            border: 2.5px dashed rgba(255,255,255,0.2);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            background: rgba(0,0,0,0.35);
            transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
        }
        #single-element-card.filled {
            border-style: solid; border-color: var(--tc);
            background: var(--tc-dim); box-shadow: var(--glow);
            animation: cardPop 0.45s cubic-bezier(0.34,1.56,0.64,1);
        }
        @keyframes cardPop {
            0%  { transform: scale(0.5); }
            70% { transform: scale(1.1); }
            100%{ transform: scale(1); }
        }
        #single-element-symbol {
            font-family: 'Orbitron', sans-serif; font-size: 3.5rem; font-weight: 900;
            color: var(--tc); text-shadow: var(--glow-sm);
            line-height: 1;
        }
        #single-element-waiting {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.8rem; color: rgba(255,255,255,0.25);
            letter-spacing: 0.15em; text-align: center;
        }
        #single-status-line {
            font-size: 10px; font-family: 'Orbitron', sans-serif;
            letter-spacing: 0.22em; color: var(--tc); opacity: 0.65;
            text-transform: uppercase;
            display: flex; align-items: center; gap: 8px;
        }
        .pulse-dot {
            width: 6px; height: 6px; border-radius: 50%; background: var(--tc);
            animation: pulseDot 1.2s ease infinite;
        }
        @keyframes pulseDot {
            0%,100% { transform: scale(1); opacity: 1; }
            50%     { transform: scale(1.9); opacity: 0.3; }
        }

        /* ── PERIODIC SEQUENCE ── */
        #periodic-sequence-container {
            display: none; flex-direction: column;
            align-items: center; gap: 14px;
        }
        #formula-slots {
            display: flex; gap: 10px; flex-wrap: wrap;
            justify-content: center;
            background: rgba(0,0,0,0.35); border-radius: 16px;
            padding: 18px 22px; min-height: 100px;
            border: 1px solid rgba(255,255,255,0.08);
            min-width: 300px;
        }
        .formula-slot {
            width: 64px; height: 78px; border-radius: 13px;
            border: 2px dashed rgba(255,255,255,0.18);
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            background: rgba(255,255,255,0.02);
            transition: all 0.3s cubic-bezier(0.34,1.56,0.64,1);
            position: relative;
        }
        .formula-slot.active-slot {
            border-color: var(--tc);
            box-shadow: 0 0 14px rgba(20,184,166,0.35);
            background: var(--tc-dim);
        }
        .formula-slot.filled-slot {
            border-style: solid; border-color: var(--tc-mid);
            background: var(--tc-dim);
        }
        .slot-symbol {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.5rem; font-weight: 900; color: #fff;
            line-height: 1;
        }
        .slot-subscript {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.75rem; color: var(--tc); margin-top: 2px;
        }
        .slot-placeholder {
            font-size: 1.4rem; color: rgba(255,255,255,0.15);
        }
        #formula-display {
            font-family: 'Share Tech Mono', monospace;
            font-size: 1.6rem; color: var(--tc);
            text-shadow: var(--glow-sm); letter-spacing: 3px;
            background: rgba(0,0,0,0.30);
            border-radius: 10px; padding: 8px 24px;
            border: 1px solid var(--tc-mid);
            min-width: 200px; text-align: center;
            min-height: 50px;
        }
        #seq-confirm-btn {
            padding: 11px 36px; border-radius: 12px;
            background: linear-gradient(135deg, var(--tc), var(--tc2));
            color: #000; font-family: 'Orbitron', sans-serif;
            font-size: 0.72rem; font-weight: 900;
            letter-spacing: 0.2em; text-transform: uppercase;
            border: none; cursor: pointer; box-shadow: var(--glow);
            transition: all 0.22s cubic-bezier(0.34,1.56,0.64,1);
        }
        #seq-confirm-btn:hover { transform: scale(1.06); box-shadow: var(--glow-xl); }

        /* ── NUMERIC ── */
        #numeric-container {
            display: none; flex-direction: column;
            align-items: center; gap: 12px;
        }
        #numeric-input {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.2rem; font-weight: 900;
            background: rgba(0,0,0,0.45); border: 2px solid var(--panel-b);
            border-radius: 16px; color: #fff; padding: 16px 28px;
            width: 100%; max-width: 340px; text-align: center;
            outline: none; transition: border-color 0.25s, box-shadow 0.25s;
            caret-color: var(--tc);
        }
        #numeric-input:focus { border-color: var(--tc); box-shadow: var(--glow-sm); }
        #numeric-range-display {
            font-family: 'Share Tech Mono', monospace;
            font-size: 0.85rem; color: rgba(255,255,255,0.45);
            background: rgba(255,255,255,0.04); border-radius: 10px;
            padding: 8px 20px; border: 1px solid rgba(255,255,255,0.08);
            min-width: 220px; text-align: center;
        }
        #numeric-submit {
            padding: 12px 40px; border-radius: 12px;
            background: linear-gradient(135deg, var(--tc), var(--tc2));
            color: #000; font-family: 'Orbitron', sans-serif;
            font-size: 0.72rem; font-weight: 900;
            letter-spacing: 0.2em; text-transform: uppercase;
            border: none; cursor: pointer; box-shadow: var(--glow);
            transition: all 0.22s cubic-bezier(0.34,1.56,0.64,1);
        }
        #numeric-submit:hover { transform: scale(1.06); box-shadow: var(--glow-xl); }

        /* ── TIMER (bottom-right of content zone) ── */
        #timer-wrapper {
            position: absolute; bottom: 80px; right: 24px;
            z-index: 20;
        }
        #timer-svg { width: 90px; height: 90px; transform: rotate(-90deg); }
        #timer-track { stroke: rgba(255,255,255,0.06); }
        #timer-bar {
            stroke: var(--tc);
            transition: stroke-dashoffset 0.9s linear, stroke 0.4s ease;
            stroke-linecap: round;
        }
        #timer-num {
            position: absolute; top: 50%; left: 50%;
            transform: translate(-50%,-50%);
            font-family: 'Orbitron', sans-serif;
            font-size: 1.6rem; font-weight: 900; color: #fff;
            text-shadow: var(--glow-sm);
            transition: color 0.3s ease; z-index: 2;
            pointer-events: none;
        }
        .timer-critical #timer-num  { color: #ef4444; animation: blinkNum 0.5s ease infinite; }
        .timer-critical #timer-bar  { stroke: #ef4444 !important; }
        @keyframes blinkNum { 0%,100%{opacity:1;} 50%{opacity:0.2;} }

        /* ── BOTTOM TOOLBAR ── */
        #bottom-toolbar {
            position: relative; z-index: 20;
            height: 56px; flex-shrink: 0;
            display: flex; align-items: center;
            background: rgba(0,0,0,0.70);
            border-top: 1px solid rgba(255,255,255,0.07);
            backdrop-filter: blur(20px);
            padding: 0 16px; gap: 8px;
        }
        .toolbar-btn {
            display: flex; align-items: center; gap: 8px;
            padding: 8px 14px; border-radius: 10px;
            background: rgba(255,255,255,0.05);
            border: 1px solid rgba(255,255,255,0.09);
            color: rgba(255,255,255,0.55);
            font-family: 'Orbitron', sans-serif;
            font-size: 9px; font-weight: 700;
            letter-spacing: 0.14em; text-transform: uppercase;
            cursor: pointer; transition: all 0.18s ease;
            user-select: none;
        }
        .toolbar-btn:hover { border-color: var(--tc); color: var(--tc); background: var(--tc-dim); }
        .toolbar-btn.active { border-color: var(--tc); color: var(--tc); background: var(--tc-dim); box-shadow: var(--glow-sm); }
        .toolbar-btn i { font-size: 13px; }
        .toolbar-sep { flex: 1; }

        /* ═══════════════════════════════════════════════
           FEEDBACK OVERLAY (full right area)
        ═══════════════════════════════════════════════ */
        #feedback-overlay {
            position: absolute; inset: 0; z-index: 100;
            display: flex; flex-direction: column;
            align-items: center; justify-content: center;
            backdrop-filter: blur(28px) saturate(180%);
            -webkit-backdrop-filter: blur(28px) saturate(180%);
            opacity: 0; pointer-events: none;
            transition: opacity 0.28s ease;
        }
        #feedback-overlay.show {
            opacity: 1; pointer-events: all;
            animation: fbIn 0.38s cubic-bezier(0.34,1.56,0.64,1) both;
        }
        @keyframes fbIn { from{transform:scale(0.9);} to{transform:scale(1);} }

        .fb-icon { font-size: 5rem; line-height: 1; margin-bottom: 8px; }
        .fb-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.8rem; font-weight: 900;
            letter-spacing: 0.06em; text-transform: uppercase;
        }
        .fb-sub { margin-top: 10px; font-size: 1.1rem; font-weight: 600; color: rgba(255,255,255,0.65); }
        .fb-answer-box {
            margin-top: 14px; padding: 10px 28px;
            background: rgba(255,255,255,0.10); border-radius: 12px;
            font-family: 'Share Tech Mono', monospace;
            font-size: 1.3rem; font-weight: 900; color: #fff;
            border: 1px solid rgba(255,255,255,0.18);
        }
        .fb-exp-gained {
            margin-top: 8px;
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem; font-weight: 900; color: #fbbf24;
            text-shadow: 0 0 24px rgba(251,191,36,0.7);
        }

        /* ═══════════════════════════════════════════════
           COMBO TAG
        ═══════════════════════════════════════════════ */
        #combo-tag {
            position: fixed; top: 50%; left: 290px;
            transform: translateY(-50%); z-index: 300;
            pointer-events: none; opacity: 0;
            transition: opacity 0.25s ease;
        }
        #combo-tag.show { opacity: 1; animation: comboBounce 0.55s cubic-bezier(0.34,1.56,0.64,1) both; }
        @keyframes comboBounce {
            from{ transform:translateY(-50%) translateX(-60px) scale(0.4); }
            to  { transform:translateY(-50%) translateX(0) scale(1); }
        }
        #combo-inner {
            font-family: 'Orbitron', sans-serif; font-size: 3.2rem; font-weight: 900;
            color: #fbbf24; text-shadow: 0 0 30px rgba(251,191,36,0.80);
            white-space: nowrap;
        }

        /* ═══════════════════════════════════════════════
           ZOOM / FULLSCREEN MEDIA OVERLAY
        ═══════════════════════════════════════════════ */
        #zoom-overlay {
            position: fixed; inset: 0; z-index: 500;
            background: rgba(0,0,0,0.94);
            backdrop-filter: blur(10px);
            display: none; align-items: center; justify-content: center;
            flex-direction: column; gap: 16px;
        }
        #zoom-overlay.show { display: flex; animation: fbIn 0.3s ease both; }
        #zoom-media-img {
            max-width: 90vw; max-height: 75vh;
            object-fit: contain; border-radius: 14px;
            border: 2px solid rgba(255,255,255,0.12);
        }
        #zoom-media-video {
            max-width: 90vw; max-height: 75vh;
            border-radius: 14px;
        }
        #zoom-label {
            font-family: 'Orbitron', sans-serif;
            font-size: 10px; font-weight: 700; letter-spacing: 0.2em;
            color: rgba(255,255,255,0.45); text-transform: uppercase;
        }
        #zoom-hint {
            font-size: 11px; color: rgba(255,255,255,0.28);
            font-family: 'Share Tech Mono', monospace;
        }

        /* ═══════════════════════════════════════════════
           HOME CONFIRMATION DIALOG
        ═══════════════════════════════════════════════ */
        #home-dialog {
            position: fixed; inset: 0; z-index: 600;
            background: rgba(0,0,0,0.88); backdrop-filter: blur(16px);
            display: none; align-items: center; justify-content: center;
        }
        #home-dialog.show { display: flex; animation: fbIn 0.3s ease both; }
        #home-dialog-box {
            background: var(--panel-bg); border: 2px solid var(--panel-b);
            border-radius: 24px; padding: 40px 48px;
            text-align: center; max-width: 420px; width: 90%;
            box-shadow: var(--glow-xl);
        }
        #home-dialog-box .dlg-icon { font-size: 3rem; margin-bottom: 14px; color: #fbbf24; }
        #home-dialog-box .dlg-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem; font-weight: 900; color: #fff; margin-bottom: 8px;
        }
        #home-dialog-box .dlg-sub {
            font-size: 0.9rem; color: rgba(255,255,255,0.50); margin-bottom: 24px;
            line-height: 1.5;
        }
        #home-dialog-box .dlg-actions {
            display: flex; gap: 12px; justify-content: center;
        }
        .dlg-btn {
            padding: 10px 26px; border-radius: 12px;
            font-family: 'Orbitron', sans-serif;
            font-size: 9px; font-weight: 900; letter-spacing: 0.18em;
            text-transform: uppercase; cursor: pointer; border: none;
            transition: all 0.2s ease;
        }
        .dlg-btn.confirm { background: #ef4444; color: #fff; }
        .dlg-btn.confirm:hover { background: #dc2626; transform: scale(1.04); }
        .dlg-btn.cancel { background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.60); border: 1px solid rgba(255,255,255,0.12); }
        .dlg-btn.cancel:hover { background: rgba(255,255,255,0.14); }
        #home-hint {
            margin-top: 14px; font-size: 10px; font-family: 'Share Tech Mono', monospace;
            color: rgba(255,255,255,0.22); letter-spacing: 0.12em;
        }

        /* ═══════════════════════════════════════════════
           FINAL RESULTS SCREEN
        ═══════════════════════════════════════════════ */
        #final-screen {
            display: none; position: fixed; inset: 0; z-index: 700;
            background: rgba(0,0,0,0.95); backdrop-filter: blur(28px);
            align-items: center; justify-content: center; padding: 20px;
        }
        #final-screen.show { display: flex; animation: finalIn 0.7s cubic-bezier(0.34,1.56,0.64,1) both; }
        @keyframes finalIn { from{opacity:0;transform:scale(0.80);} to{opacity:1;transform:scale(1);} }

        #final-card {
            max-width: 660px; width: 100%;
            background: var(--panel-bg); border: 2px solid var(--panel-b);
            border-radius: 34px; padding: 48px;
            text-align: center;
            box-shadow: var(--glow-xl), 0 40px 100px rgba(0,0,0,0.95);
            position: relative; overflow: hidden;
            backdrop-filter: blur(40px);
        }
        .final-title {
            font-family: 'Orbitron', sans-serif;
            font-size: 2.2rem; font-weight: 900;
            color: var(--tc); text-shadow: var(--glow-sm);
            letter-spacing: 0.07em; margin-bottom: 4px;
        }
        .final-sub { font-size: 0.85rem; color: rgba(255,255,255,0.32); letter-spacing: 0.16em; text-transform: uppercase; margin-bottom: 28px; }
        #grade-badge {
            display: inline-block; padding: 6px 22px; border-radius: 99px;
            font-family: 'Orbitron', sans-serif; font-size: 0.85rem; font-weight: 900;
            letter-spacing: 0.08em; margin-bottom: 22px;
        }
        #grade-badge.grade-s { background: #fbbf24; color: #000; box-shadow: 0 0 28px rgba(251,191,36,0.55); }
        #grade-badge.grade-a { background: #22c55e; color: #000; box-shadow: 0 0 28px rgba(34,197,94,0.50); }
        #grade-badge.grade-b { background: #06b6d4; color: #000; box-shadow: 0 0 28px rgba(6,182,212,0.50); }
        #grade-badge.grade-c { background: #f97316; color: #000; box-shadow: 0 0 28px rgba(249,115,22,0.50); }
        #grade-badge.grade-d { background: #ef4444; color: #fff; box-shadow: 0 0 28px rgba(239,68,68,0.50); }

        .stat-grid-final {
            display: grid; grid-template-columns: repeat(2,1fr);
            gap: 12px; margin-bottom: 24px;
        }
        .stat-f {
            background: rgba(255,255,255,0.04); border: 1.5px solid rgba(255,255,255,0.08);
            border-radius: 18px; padding: 18px;
            transition: border-color 0.3s;
        }
        .stat-f:hover { border-color: var(--tc); }
        .stat-f .sf-lbl { font-size: 7px; font-family: 'Orbitron', sans-serif; letter-spacing: 0.18em; color: rgba(255,255,255,0.28); text-transform: uppercase; margin-bottom: 6px; }
        .stat-f .sf-val { font-family: 'Orbitron', sans-serif; font-size: 1.9rem; font-weight: 900; color: #fff; }
        .stat-f .sf-val.tc { color: var(--tc); text-shadow: var(--glow-sm); }

        #exit-btn {
            padding: 14px 44px; border-radius: 13px;
            background: linear-gradient(135deg, var(--tc), var(--tc2));
            color: #000; font-family: 'Orbitron', sans-serif;
            font-size: 0.76rem; font-weight: 900;
            letter-spacing: 0.22em; text-transform: uppercase;
            border: none; cursor: pointer; box-shadow: var(--glow);
            transition: all 0.22s cubic-bezier(0.34,1.56,0.64,1);
        }
        #exit-btn:hover { transform: scale(1.07); box-shadow: var(--glow-xl); }

        /* ═══════════════════════════════════════════════
           GLOBAL TIMER BAR (for Global timer type)
        ═══════════════════════════════════════════════ */
        #global-timer-bar-wrap {
            position: absolute; bottom: 56px; left: 0; right: 0; z-index: 15;
            height: 3px; background: rgba(255,255,255,0.06);
        }
        #global-timer-bar {
            height: 100%; background: var(--tc);
            transition: width 1s linear, background 0.5s ease;
            box-shadow: 0 0 10px var(--tc);
        }
        #global-timer-countdown {
            position: absolute; bottom: 62px; right: 28px;
            font-family: 'Orbitron', sans-serif; font-size: 10px;
            font-weight: 700; color: rgba(255,255,255,0.35);
            z-index: 16; letter-spacing: 0.1em;
        }

        /* ═══════════════════════════════════════════════
           UTILITY
        ═══════════════════════════════════════════════ */
        .hidden { display: none !important; }
        .flex-col { display: flex; flex-direction: column; }
        .flex-center { display: flex; align-items: center; justify-content: center; }

        /* Scrollbar */
        ::-webkit-scrollbar { width: 4px; }
        ::-webkit-scrollbar-thumb { background: var(--tc-mid); border-radius: 2px; }
    </style>
</head>

<%#
  EJS: safely read theme from first question or assessment
%>
<% var initTheme = (questions && questions[0] && questions[0].theme_id) ? questions[0].theme_id : 'default_lab'; %>
<% var validThemes = ['default_lab','space_lab','jungle_lab','ocean_lab','volcano_lab']; %>
<% if (validThemes.indexOf(initTheme) === -1) { initTheme = 'default_lab'; } %>
<body class="theme-<%= initTheme %>">

<!-- AMBIENT LAYER -->
<div id="ambient-layer"></div>

<!-- COMBO TAG -->
<div id="combo-tag">
    <div id="combo-inner"><span id="combo-val">3</span>X COMBO!</div>
</div>

<!-- ZOOM OVERLAY -->
<div id="zoom-overlay">
    <div id="zoom-label">ZOOM MODE</div>
    <img id="zoom-media-img" src="" alt="Zoom" style="display:none;">
    <video id="zoom-media-video" style="display:none;" controls></video>
    <div id="zoom-hint"></div>
</div>

<!-- HOME CONFIRMATION DIALOG -->
<div id="home-dialog">
    <div id="home-dialog-box">
        <div class="dlg-icon"><i class="fas fa-door-open"></i></div>
        <div class="dlg-title">Exit Mission?</div>
        <div class="dlg-sub">Your progress will be saved and you'll return to the standby screen.</div>
        <div class="dlg-actions">
            <button class="dlg-btn confirm" id="home-confirm-btn">
                <i class="fas fa-check mr-1"></i> Yes, Exit
            </button>
            <button class="dlg-btn cancel" id="home-cancel-btn">
                <i class="fas fa-times mr-1"></i> Keep Playing
            </button>
        </div>
        <div id="home-hint">Press ENTER to confirm · Press HOME to cancel</div>
    </div>
</div>

<!-- MAIN GAME ROOT -->
<div id="game-root">

    <!-- ══════════════════════════
         LEFT PANEL
    ══════════════════════════ -->
    <div id="left-panel">

        <!-- Instruction Box -->
        <div id="instruction-box">
            <div id="instruction-label">
                <i class="fas fa-info-circle" style="font-size:10px;"></i>
                Instruction
            </div>
            <div id="instruction-text-display" class="empty">No instruction for this question.</div>
        </div>

        <!-- History Scroll -->
        <div id="history-scroll">
            <div class="history-label">
                <i class="fas fa-list-ol" style="font-size:9px;margin-right:4px;"></i>
                Question Log
            </div>
            <div id="history-list"></div>
        </div>

        <!-- Score / EXP -->
        <div id="left-bottom">
            <div class="stat-box-left">
                <div class="stat-lbl">Score</div>
                <div class="stat-val" id="live-score-val">0</div>
            </div>
            <div class="stat-box-left">
                <div class="stat-lbl">EXP</div>
                <div class="stat-val" id="live-exp-val">0</div>
            </div>
        </div>
    </div><!-- /left-panel -->

    <!-- ══════════════════════════
         RIGHT MAIN AREA
    ══════════════════════════ -->
    <div id="right-area">

        <!-- Background Layer -->
        <div id="bg-layer"></div>

        <!-- Top Header -->
        <div id="top-header">
            <div class="header-cell" style="min-width:160px;">
                <div>
                    <div class="hc-label">Assessment</div>
                    <div class="hc-val" id="hc-asm-name"><%= assessment.assessment_name || 'Chemistry Mission' %></div>
                </div>
            </div>
            <div class="header-cell">
                <span class="hc-badge" id="hc-asm-type"><%= assessment.assessment_type || 'Quiz' %></span>
            </div>
            <div class="header-cell">
                <div>
                    <div class="hc-label">Type</div>
                    <div class="hc-val" id="hc-input-mode">—</div>
                </div>
            </div>
            <div class="header-cell grow">
                <!-- progress indicator -->
                <div style="display:flex;align-items:center;gap:10px;">
                    <div style="font-family:'Orbitron',sans-serif;font-size:1.5rem;font-weight:900;color:#fff;line-height:1;">
                        <span id="hc-current">1</span><span style="font-size:0.9rem;color:rgba(255,255,255,0.28);"> / </span><span id="hc-total" style="font-size:0.9rem;color:rgba(255,255,255,0.28);">1</span>
                    </div>
                    <div style="font-size:8px;font-family:'Orbitron',sans-serif;letter-spacing:0.12em;color:rgba(255,255,255,0.28);text-transform:uppercase;" id="hc-difficulty">—</div>
                </div>
            </div>
            <div id="student-cell">
                <img id="student-avatar"
                     src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                     onerror="this.src='/profile_uploads/default_avatar.png'"
                     alt="Avatar">
                <div id="student-name"><%= user.first_name %> <%= user.last_name || '' %></div>
            </div>
        </div><!-- /top-header -->

        <!-- Content Zone -->
        <div id="content-zone">

            <!-- Question Text -->
            <p id="question-text">Loading question...</p>

            <!-- Media Zone -->
            <div id="media-zone">
                <img id="media-img" src="" alt="Question Media" style="display:none;">
                <video id="media-video" style="display:none;" preload="metadata"></video>
            </div>

            <!-- ── ANSWER AREA ── -->
            <div id="answer-area">

                <!-- Standard MCQ -->
                <div id="mcq-container">
                    <div id="mcq-grid">
                        <div class="choice-btn" id="btn-a" data-key="A" onclick="onChoiceClick('A')">
                            <div class="choice-letter">A</div>
                            <div class="choice-content">
                                <div class="choice-text" id="opt-a-text"></div>
                                <img class="choice-img" id="opt-a-img" src="" alt="" style="display:none;">
                            </div>
                        </div>
                        <div class="choice-btn" id="btn-b" data-key="B" onclick="onChoiceClick('B')">
                            <div class="choice-letter">B</div>
                            <div class="choice-content">
                                <div class="choice-text" id="opt-b-text"></div>
                                <img class="choice-img" id="opt-b-img" src="" alt="" style="display:none;">
                            </div>
                        </div>
                        <div class="choice-btn" id="btn-c" data-key="C" onclick="onChoiceClick('C')">
                            <div class="choice-letter">C</div>
                            <div class="choice-content">
                                <div class="choice-text" id="opt-c-text"></div>
                                <img class="choice-img" id="opt-c-img" src="" alt="" style="display:none;">
                            </div>
                        </div>
                        <div class="choice-btn" id="btn-d" data-key="D" onclick="onChoiceClick('D')">
                            <div class="choice-letter">D</div>
                            <div class="choice-content">
                                <div class="choice-text" id="opt-d-text"></div>
                                <img class="choice-img" id="opt-d-img" src="" alt="" style="display:none;">
                            </div>
                        </div>
                    </div>
                    <!-- Multi-answer submit -->
                    <button id="multi-submit" onclick="submitMultiAnswer()">
                        <i class="fas fa-check-circle"></i>&nbsp; Submit Answers (<span id="multi-count">0</span> selected)
                    </button>
                </div><!-- /mcq-container -->

                <!-- Periodic Single -->
                <div id="periodic-single-container" class="flex-col flex-center">
                    <div id="single-element-card">
                        <div id="single-element-symbol" style="display:none;"></div>
                        <div id="single-element-waiting">
                            PRESS ELEMENT<br>BUTTON
                        </div>
                    </div>
                    <div id="single-status-line">
                        <div class="pulse-dot"></div>
                        <span>Awaiting Hardware Input</span>
                    </div>
                </div>

                <!-- Periodic Sequence -->
                <div id="periodic-sequence-container" class="flex-col flex-center">
                    <div id="formula-slots"></div>
                    <div id="formula-display">—</div>
                    <button id="seq-confirm-btn" onclick="submitSequence()">
                        <i class="fas fa-check-circle"></i>&nbsp; Confirm Formula
                    </button>
                </div>

                <!-- Numeric -->
                <div id="numeric-container" class="flex-col flex-center">
                    <input type="number" id="numeric-input"
                           placeholder="Enter value..."
                           autocomplete="off"
                           onkeydown="onNumericKey(event)">
                    <div id="numeric-range-display">Accepted range: —</div>
                    <button id="numeric-submit" onclick="submitNumeric()">
                        <i class="fas fa-check-circle"></i>&nbsp; Confirm Answer
                    </button>
                </div>

            </div><!-- /answer-area -->

            <!-- Feedback Overlay (inside right area) -->
            <div id="feedback-overlay">
                <div class="fb-icon" id="fb-icon"></div>
                <div class="fb-title" id="fb-title"></div>
                <div class="fb-sub"   id="fb-sub"></div>
                <div class="fb-answer-box hidden" id="fb-answer"></div>
                <div class="fb-exp-gained hidden" id="fb-exp"></div>
            </div>

        </div><!-- /content-zone -->

        <!-- Global Timer Bar (only shown when timer_type = Global) -->
        <div id="global-timer-bar-wrap" class="hidden">
            <div id="global-timer-bar" style="width:100%;"></div>
        </div>
        <div id="global-timer-countdown" class="hidden"></div>

        <!-- Per-Item Timer Ring -->
        <div id="timer-wrapper">
            <svg id="timer-svg" viewBox="0 0 100 100">
                <circle id="timer-track" cx="50" cy="50" r="42"
                        stroke="currentColor" stroke-width="5" fill="transparent"/>
                <circle id="timer-bar" cx="50" cy="50" r="42"
                        stroke="currentColor" stroke-width="6" fill="transparent"
                        stroke-dasharray="263.9" stroke-dashoffset="0"
                        stroke-linecap="round"/>
            </svg>
            <div id="timer-num">—</div>
        </div>

        <!-- Bottom Toolbar -->
        <div id="bottom-toolbar">
            <button class="toolbar-btn" id="btn-repeat" onclick="onRepeat()" title="Repeat TTS">
                <i class="fas fa-redo"></i> Repeat
            </button>
            <button class="toolbar-btn" id="btn-instruction" onclick="onInstruction()" title="Read Instruction">
                <i class="fas fa-info-circle"></i> Instruction
            </button>
            <button class="toolbar-btn" id="btn-zoom" onclick="onZoom()" title="Zoom Media">
                <i class="fas fa-expand"></i> Zoom
            </button>
            <button class="toolbar-btn" id="btn-bgm" onclick="onBGM()" title="Toggle Music">
                <i class="fas fa-music"></i> BGM
            </button>
            <div class="toolbar-sep"></div>
            <button class="toolbar-btn" id="btn-home" onclick="onHome()" title="Exit Mission" style="color:rgba(239,68,68,0.65);border-color:rgba(239,68,68,0.2);">
                <i class="fas fa-home"></i> Home
            </button>
        </div>

    </div><!-- /right-area -->

</div><!-- /game-root -->

<!-- FINAL RESULTS SCREEN -->
<div id="final-screen">
    <div id="final-card">
        <div class="final-title">MISSION COMPLETE</div>
        <div class="final-sub">Chemistry Arcade &middot; After-Action Report</div>
        <div id="grade-badge" class="grade-s">S RANK</div>
        <div class="stat-grid-final">
            <div class="stat-f">
                <div class="sf-lbl">Score</div>
                <div class="sf-val" id="final-score">0 / 0</div>
            </div>
            <div class="stat-f">
                <div class="sf-lbl">Total EXP</div>
                <div class="sf-val tc" id="final-exp">0</div>
            </div>
            <div class="stat-f">
                <div class="sf-lbl">Accuracy</div>
                <div class="sf-val tc" id="final-accuracy">0%</div>
            </div>
            <div class="stat-f">
                <div class="sf-lbl">Max Combo</div>
                <div class="sf-val" id="final-combo">0x</div>
            </div>
        </div>
        <div style="font-size:0.95rem;color:rgba(255,255,255,0.42);margin-bottom:24px;font-style:italic;">
            You surpassed <span style="color:var(--tc);font-weight:700;" id="final-surpassed">0</span> agents this mission.
        </div>
        <button id="exit-btn" onclick="window.location.href='/arcade/standby'">
            Confirm &amp; Exit Mission
        </button>
    </div>
</div>

<!-- ════════════════════════════════════════════════
     SOCKET.IO + MAIN GAME SCRIPT
════════════════════════════════════════════════ -->
<script src="/socket.io/socket.io.js"></script>
<script>
// ═══════════════════════════════════════════════════════════════════
// SERVER DATA INJECTION (EJS → JS, no template literals inside tags)
// ═══════════════════════════════════════════════════════════════════
var QUESTIONS      = <%- JSON.stringify(questions) %>;
var USER_DATA      = <%- JSON.stringify({ user_id: user.user_id, first_name: user.first_name, last_name: user.last_name || '', profile_pic: user.profile_pic || 'default_avatar.png', current_level: user.current_level || 1, total_exp: user.total_exp || 0 }) %>;
var ASSESSMENT     = <%- JSON.stringify({ assessment_id: assessment.assessment_id, assessment_name: assessment.assessment_name, assessment_type: assessment.assessment_type, timer_type: assessment.timer_type || 'Global', duration_minutes: assessment.duration_minutes || 30, total_items: assessment.total_items, sound_bg: assessment.sound_bg || '', sound_correct: assessment.sound_correct || '', sound_wrong: assessment.sound_wrong || '', sound_result_pass: assessment.sound_result_pass || '', sound_result_fail: assessment.sound_result_fail || '', speech_enabled: assessment.speech_enabled || 0 }) %>;
var ASSESSMENT_ID  = "<%= assessmentId %>";
var TOKEN          = "<%= token %>";
var RESUME_INDEX   = <%= resumeIndex || 0 %>;
var BTN_MAPPINGS   = <%- JSON.stringify(buttonMappings || []) %>;

// ═══════════════════════════════════════════════════════════════════
// CONSTANTS
// ═══════════════════════════════════════════════════════════════════
var CIRCUMFERENCE   = 2 * Math.PI * 42; // r=42 → 263.89
var VALID_THEMES    = ['default_lab','space_lab','jungle_lab','ocean_lab','volcano_lab'];

// ── THEME BACKGROUND CONFIG ──────────────────────────────────────
// Each theme has 5 background images used in round-robin for questions
// without a selected_bg_key.
var THEME_BACKGROUNDS = {
    default_lab : { bgs: ['lab_bg_1','lab_bg_2','lab_bg_3','lab_bg_4','lab_bg_5'] },
    space_lab   : { bgs: ['neon_bg_1','neon_bg_2','neon_bg_3','neon_bg_4','neon_bg_5'] },
    jungle_lab  : { bgs: ['space_bg_1','space_bg_2','space_bg_3','space_bg_4','space_bg_5'] },
    ocean_lab   : { bgs: ['bio_bg_1','bio_bg_2','bio_bg_3','bio_bg_4','bio_bg_5'] },
    volcano_lab : { bgs: ['crystal_bg_1','crystal_bg_2','crystal_bg_3','crystal_bg_4','crystal_bg_5'] }
};

function bgImageUrl(key) {
    return '/images/backgrounds/' + key + '.jpg';
}

// ── THEME SOUNDS ─────────────────────────────────────────────────
var THEME_SOUNDS = {
    default_lab : {
        correct: ['lab_correct_1','lab_correct_2'],
        wrong  : ['lab_wrong_1','lab_wrong_2']
    },
    space_lab   : {
        correct: ['neon_correct_1','neon_correct_2'],
        wrong  : ['neon_wrong_1','neon_wrong_2']
    },
    jungle_lab  : {
        correct: ['space_correct_1','space_correct_2'],
        wrong  : ['space_wrong_1','space_wrong_2']
    },
    ocean_lab   : {
        correct: ['bio_correct_1','bio_correct_2'],
        wrong  : ['bio_wrong_1','bio_wrong_2']
    },
    volcano_lab : {
        correct: ['crystal_correct_1','crystal_correct_2'],
        wrong  : ['crystal_wrong_1','crystal_wrong_2']
    }
};

function soundUrl(key) { return '/sounds/' + key + '.mp3'; }

var GLOBAL_RESULT_SOUNDS = {
    pass: ['result_pass_1','result_pass_2','result_pass_3'],
    fail: ['result_fail_1','result_fail_2','result_fail_3']
};

// ═══════════════════════════════════════════════════════════════════
// GAME STATE
// ═══════════════════════════════════════════════════════════════════
var currentIndex       = 0;
var currentScore       = 0;
var totalExp           = USER_DATA.total_exp || 0;
var sessionExp         = 0; // EXP gained this session only
var comboCount         = 0;
var maxCombo           = 0;
var isPaused           = false;
var isGameOver         = false;
var isZoomOpen         = false;
var isHomeDialogOpen   = false;
var isBGMOn            = true;
var isSFXOn            = true;

// Timer state
var perItemTimer       = null;
var timeLeft           = 0;
var timeLimitFull      = 0;
var globalTimerInterval= null;
var globalSecondsLeft  = 0;
var globalSecondsTotal = 0;

// Per-question state
var selectedMulti      = []; // for multi-answer (keys: 'A','B','C','D')
var selectedElements   = []; // for Periodic_Sequence { symbol, subscript }
var activeSlotIndex    = 0;  // cursor for Periodic_Sequence navigation
var questionStartTime  = Date.now();
var playerResponses    = [];
var lastAnswer         = '';

// Zoom state
var zoomImageList      = []; // array of { src, label }
var zoomImageIndex     = 0;

// ═══════════════════════════════════════════════════════════════════
// THEME CONFIG
// ═══════════════════════════════════════════════════════════════════
var THEME_CONFIG = {
    'default_lab'  : { particles:'bubble', count:16, feedbackBg:'rgba(0,20,15,0.95)'    },
    'space_lab' : { particles:'spark',  count:28, feedbackBg:'rgba(20,5,0,0.95)'     },
    'jungle_lab'   : { particles:'star',   count:38, feedbackBg:'rgba(2,0,20,0.95)'     },
    'ocean_lab'   : { particles:'gas',    count:10, feedbackBg:'rgba(4,10,0,0.95)'     },
    'volcano_lab' : { particles:'ray',    count:14, feedbackBg:'rgba(0,4,18,0.95)'     }
};

// ═══════════════════════════════════════════════════════════════════
// AUDIO ENGINE
// ═══════════════════════════════════════════════════════════════════
var bgmSound    = null;
var sfxCorrect  = null;
var sfxWrong    = null;
var sfxResultPass = null;
var sfxResultFail = null;
var sfxTimerLow = new Howl({ src:['https://assets.mixkit.co/active_storage/sfx/959/959-preview.mp3'], volume:0.22, loop:true });
var sfxBtn      = new Howl({ src:['https://assets.mixkit.co/active_storage/sfx/2571/2571-preview.mp3'], volume:0.25 });

function initAudio(q) {
    // BGM — from assessment.sound_bg filename (e.g. "lab_ambient_1.mp3" or just "lab_ambient_1")
    var bgKey = (ASSESSMENT.sound_bg || '').trim();
    if (bgKey !== '') {
        var bgSrc = bgKey.indexOf('.') !== -1 ? '/sounds/' + bgKey : soundUrl(bgKey);
        bgmSound = new Howl({ src:[bgSrc], volume:0.12, loop:true, html5:true });
    }

    // SFX Correct — use assessment override, else theme sound pool
    var cKey = (ASSESSMENT.sound_correct || '').trim();
    if (cKey !== '') {
        sfxCorrect = new Howl({ src:[cKey.indexOf('.') !== -1 ? '/sounds/' + cKey : soundUrl(cKey)], volume:0.55 });
    } else {
        var themeCorrect = THEME_SOUNDS[currentTheme] ? THEME_SOUNDS[currentTheme].correct : THEME_SOUNDS['default_lab'].correct;
        var cPick = themeCorrect[Math.floor(Math.random() * themeCorrect.length)];
        sfxCorrect = new Howl({ src:[soundUrl(cPick)], volume:0.55, html5:true });
    }

    // SFX Wrong — use assessment override, else theme sound pool
    var wKey = (ASSESSMENT.sound_wrong || '').trim();
    if (wKey !== '') {
        sfxWrong = new Howl({ src:[wKey.indexOf('.') !== -1 ? '/sounds/' + wKey : soundUrl(wKey)], volume:0.45 });
    } else {
        var themeWrong = THEME_SOUNDS[currentTheme] ? THEME_SOUNDS[currentTheme].wrong : THEME_SOUNDS['default_lab'].wrong;
        var wPick = themeWrong[Math.floor(Math.random() * themeWrong.length)];
        sfxWrong = new Howl({ src:[soundUrl(wPick)], volume:0.45, html5:true });
    }

    // Result sounds (used on final results screen)
    var rpKey = (ASSESSMENT.sound_result_pass || '').trim();
    if (rpKey !== '') {
        sfxResultPass = new Howl({ src:[rpKey.indexOf('.') !== -1 ? '/sounds/' + rpKey : soundUrl(rpKey)], volume:0.60, html5:true });
    } else {
        var passPick = GLOBAL_RESULT_SOUNDS.pass[Math.floor(Math.random() * GLOBAL_RESULT_SOUNDS.pass.length)];
        sfxResultPass = new Howl({ src:[soundUrl(passPick)], volume:0.60, html5:true });
    }

    var rfKey = (ASSESSMENT.sound_result_fail || '').trim();
    if (rfKey !== '') {
        sfxResultFail = new Howl({ src:[rfKey.indexOf('.') !== -1 ? '/sounds/' + rfKey : soundUrl(rfKey)], volume:0.60, html5:true });
    } else {
        var failPick = GLOBAL_RESULT_SOUNDS.fail[Math.floor(Math.random() * GLOBAL_RESULT_SOUNDS.fail.length)];
        sfxResultFail = new Howl({ src:[soundUrl(failPick)], volume:0.60, html5:true });
    }
}

function playBGM() {
    if (bgmSound && isBGMOn && !bgmSound.playing()) {
        bgmSound.play();
    }
}
function stopBGM() {
    if (bgmSound && bgmSound.playing()) { bgmSound.fade(bgmSound.volume(), 0, 1000); setTimeout(function(){ bgmSound.stop(); }, 1100); }
}

// TTS / Web Speech
var speechSynthesis   = window.speechSynthesis;
var ttsEnabled        = ASSESSMENT.speech_enabled === 1;
var currentUtterance  = null;

function speak(text, onEnd) {
    if (!ttsEnabled || !text) { if (onEnd) onEnd(); return; }
    if (currentUtterance) { speechSynthesis.cancel(); }
    currentUtterance = new SpeechSynthesisUtterance(text);
    currentUtterance.lang  = 'en-US';
    currentUtterance.rate  = 0.92;
    currentUtterance.pitch = 1.0;
    if (onEnd) {
        currentUtterance.onend   = onEnd;
        currentUtterance.onerror = onEnd; // fire onEnd even if speech fails
    }
    speechSynthesis.speak(currentUtterance);
}

function speakQuestion(q, onEnd) {
    if (!ttsEnabled) { if (onEnd) onEnd(); return; }
    var text = q.question_text || '';
    if (q.input_mode === 'Standard') {
        var parts = [text];
        if (q.option_a) parts.push('A: ' + q.option_a);
        if (q.option_b) parts.push('B: ' + q.option_b);
        if (q.option_c) parts.push('C: ' + q.option_c);
        if (q.option_d) parts.push('D: ' + q.option_d);
        speak(parts.join('. '), onEnd);
    } else {
        speak(text, onEnd);
    }
}

// ═══════════════════════════════════════════════════════════════════
// THEME
// ═══════════════════════════════════════════════════════════════════
var currentTheme = '';

function applyTheme(themeId) {
    var t = VALID_THEMES.indexOf(themeId) !== -1 ? themeId : 'default_lab';
    if (t === currentTheme) return;
    currentTheme = t;
    document.body.className = document.body.className.replace(/theme-\S+/g,'').trim();
    document.body.classList.add('theme-' + t);
    buildAmbientLayer(t);
}

function buildAmbientLayer(themeId) {
    var layer = document.getElementById('ambient-layer');
    layer.innerHTML = '';
    var cfg   = THEME_CONFIG[themeId] || THEME_CONFIG['default_lab'];
    for (var i = 0; i < cfg.count; i++) {
        var el = document.createElement('div');
        el.className = 'amb-particle';
        var size, dur, delay, x;
        if (cfg.particles === 'bubble') {
            size  = Math.random()*40+10; dur=Math.random()*13+8; delay=Math.random()*8; x=Math.random()*100;
            el.style.cssText = 'width:'+size+'px;height:'+size+'px;left:'+x+'%;bottom:-60px;border:1px solid rgba(20,184,166,0.28);animation:bubbleRise '+dur+'s '+delay+'s linear infinite;';
        } else if (cfg.particles === 'spark') {
            size=Math.random()*65+20; dur=Math.random()*8+4; delay=Math.random()*5; x=Math.random()*100;
            el.style.cssText='width:2px;height:'+size+'px;left:'+x+'%;bottom:0;background:linear-gradient(to top,transparent,var(--tc));border-radius:2px;animation:sparkRise '+dur+'s '+delay+'s linear infinite;';
        } else if (cfg.particles === 'star') {
            size=Math.random()*3+0.8; dur=Math.random()*16+7; delay=Math.random()*10; var dx=(Math.random()*110-55); var dy=-(Math.random()*85+20);
            el.style.cssText='width:'+size+'px;height:'+size+'px;top:'+Math.random()*100+'%;left:'+Math.random()*100+'%;background:var(--tc);--dx:'+dx+'px;--dy:'+dy+'px;animation:starDrift '+dur+'s '+delay+'s linear infinite;';
        } else if (cfg.particles === 'gas') {
            size=Math.random()*200+100; dur=Math.random()*22+14; delay=Math.random()*8;
            el.style.cssText='width:'+size+'px;height:'+size+'px;top:'+Math.random()*100+'%;left:'+Math.random()*100+'%;background:radial-gradient(circle,rgba(132,204,22,0.16) 0%,transparent 70%);filter:blur(26px);animation:gasSwirl '+dur+'s '+delay+'s ease-in-out infinite;';
        } else if (cfg.particles === 'ray') {
            size=Math.random()*220+80; dur=Math.random()*11+5; delay=Math.random()*6; var ra=(Math.random()*32-16);
            el.style.cssText='width:2px;height:'+size+'px;top:0;left:'+Math.random()*100+'%;background:linear-gradient(to bottom,transparent,var(--tc),transparent);transform-origin:top center;--ra:'+ra+'deg;filter:blur(1.5px);animation:rayShine '+dur+'s '+delay+'s linear infinite;';
        }
        layer.appendChild(el);
    }
}

// Inject ambient keyframes dynamically (safe - no EJS backticks)
(function injectKeyframes() {
    var style = document.createElement('style');
    style.textContent = [
        '@keyframes bubbleRise{0%{transform:translateY(100vh) scale(0.5);opacity:0;}10%{opacity:0.55;}90%{opacity:0.25;}100%{transform:translateY(-120px) scale(1.1);opacity:0;}}',
        '@keyframes sparkRise{0%{transform:translateY(0) scaleY(1);opacity:0;}20%{opacity:1;}80%{opacity:0.55;}100%{transform:translateY(-100vh) scaleY(3);opacity:0;}}',
        '@keyframes starDrift{0%{transform:translate(0,0) scale(0);opacity:0;}30%{opacity:0.8;}100%{transform:translate(var(--dx),var(--dy)) scale(0);opacity:0;}}',
        '@keyframes gasSwirl{0%{transform:scale(0.5) rotate(0deg);opacity:0;}30%{opacity:0.65;}70%{opacity:0.45;}100%{transform:scale(1.9) rotate(130deg);opacity:0;}}',
        '@keyframes rayShine{0%,100%{opacity:0;transform:scaleY(0.5) rotate(var(--ra,0deg));}50%{opacity:0.38;transform:scaleY(1.3) rotate(var(--ra,0deg));}}'
    ].join('');
    document.head.appendChild(style);
})();

// ═══════════════════════════════════════════════════════════════════
// BACKGROUND SETTER
// ═══════════════════════════════════════════════════════════════════
function setBackground(q, idx) {
    var bgLayer = document.getElementById('bg-layer');
    var key;
    if (q.selected_bg_key && q.selected_bg_key.trim() !== '') {
        // Question has a specific BG key set in assessment_questions
        key = q.selected_bg_key.trim();
    } else {
        // Fallback: cycle through the theme's 5-bg pool based on question index
        var themeBgs = (THEME_BACKGROUNDS[currentTheme] || THEME_BACKGROUNDS['default_lab']).bgs;
        key = themeBgs[idx % themeBgs.length];
    }
    bgLayer.style.backgroundImage = 'url("' + bgImageUrl(key) + '")';
}
// ═══════════════════════════════════════════════════════════════════
// SOCKET.IO — ESP32 HARDWARE INPUT
// ═══════════════════════════════════════════════════════════════════
var socket = io();
socket.emit('register-player', USER_DATA.user_id);

socket.on('esp32-press', function(data) {
    if (!data || !data.symbol || isPaused || isGameOver) return;
    if (isHomeDialogOpen) {
        // Enter in home dialog = confirm exit
        if (data.symbol === 'ENTER') { doExitMission(); }
        // Home press again = cancel
        if (data.symbol === 'HOME') { closeHomeDialog(); }
        return;
    }
    if (isZoomOpen) {
        var q = QUESTIONS[currentIndex];
        if (q && q.media_type === 'video') {
            if (data.symbol === 'ENTER') { toggleZoomVideo(); }
        } else {
            if (data.symbol === 'A' || data.symbol === 'C') { cycleZoomImage(data.symbol === 'A' ? -1 : 1); }
        }
        if (data.symbol === 'ZOOM') { closeZoom(); }
        return;
    }

    var q = QUESTIONS[currentIndex];
    if (!q) return;
    var sym = String(data.symbol).trim().toUpperCase();

    if (q.input_mode === 'Standard') {
        handleStandardHardware(sym, q);
    } else if (q.input_mode === 'Numeric') {
        handleNumericHardware(sym);
    } else if (q.input_mode === 'Periodic_Single') {
        handlePeriodicSingleInput(sym);
    } else if (q.input_mode === 'Periodic_Sequence') {
        handlePeriodicSequenceHardware(sym);
    }

    // Function buttons
    if (sym === 'REPEAT')      { onRepeat(); }
    if (sym === 'INSTRUCTION') { onInstruction(); }
    if (sym === 'ZOOM')        { onZoom(); }
    if (sym === 'BGM')         { onBGM(); }
    if (sym === 'HOME')        { onHome(); }
});

// ═══════════════════════════════════════════════════════════════════
// INIT QUESTION — MASTER FUNCTION
// ═══════════════════════════════════════════════════════════════════
function initQuestion() {
    if (currentIndex >= QUESTIONS.length) {
        showFinalResults();
        return;
    }

    var q = QUESTIONS[currentIndex];
    isPaused          = false;
    selectedMulti     = [];
    selectedElements  = [];
    activeSlotIndex   = 0;
    lastAnswer        = '';
    questionStartTime = Date.now();

    // Theme
    var themeId = (q.theme_id && VALID_THEMES.indexOf(q.theme_id) !== -1) ? q.theme_id : 'default_lab';
    applyTheme(themeId);

    // Background
    setBackground(q, currentIndex);

    // Header updates
    document.getElementById('hc-current').textContent   = currentIndex + 1;
    document.getElementById('hc-total').textContent     = QUESTIONS.length;
    document.getElementById('hc-input-mode').textContent = (q.input_mode || '').replace(/_/g,' ');
    document.getElementById('hc-difficulty').textContent = (q.difficulty || '').toUpperCase();

    // Instruction box (left panel)
    var instrDisplay = document.getElementById('instruction-text-display');
    if (q.instruction_override && q.instruction_override.trim() !== '') {
        instrDisplay.textContent = q.instruction_override;
        instrDisplay.classList.remove('empty');
    } else {
        instrDisplay.textContent = 'No instruction for this question.';
        instrDisplay.classList.add('empty');
    }

    // Question text
    var qtEl = document.getElementById('question-text');
    qtEl.style.animation = 'none';
    void qtEl.offsetHeight; // force reflow
    qtEl.style.animation = '';
    qtEl.textContent = q.question_text || '';

    // Media
    setupMedia(q);

    // Hide feedback
    hideFeedback();

    // Reset all answer panels, then show correct one
    hideAllAnswerPanels();
    if (q.input_mode === 'Standard') {
        setupStandardUI(q);
    } else if (q.input_mode === 'Numeric') {
        setupNumericUI(q);
    } else if (q.input_mode === 'Periodic_Single') {
        setupPeriodicSingleUI();
    } else if (q.input_mode === 'Periodic_Sequence') {
        setupPeriodicSequenceUI(q);
    }

    // Timer
    if (ASSESSMENT.timer_type === 'PerItem') {
        var limit = parseInt(q.time_limit, 10) || 20;
        if (ttsEnabled) {
            // Show timer ring at full, but PAUSED — don't tick until TTS finishes
            primePerItemTimer(limit);
            speakQuestion(q, function() {
                // TTS finished (or errored) — NOW start the countdown
                startPerItemTimer(limit);
            });
        } else {
            startPerItemTimer(limit);
        }
    } else {
        // Global timer — TTS fires freely, timer is already running independently
        speakQuestion(q);
    }
    // Global timer: already running from game start

    // Update session
    updateSession();
}

// ═══════════════════════════════════════════════════════════════════
// MEDIA SETUP
// ═══════════════════════════════════════════════════════════════════
function setupMedia(q) {
    var mediaZone  = document.getElementById('media-zone');
    var mediaImg   = document.getElementById('media-img');
    var mediaVideo = document.getElementById('media-video');

    mediaImg.style.display   = 'none';
    mediaVideo.style.display = 'none';
    mediaZone.style.display  = 'none';
    mediaVideo.pause();
    mediaVideo.src = '';

    if (q.media_path && q.media_path.trim() !== '') {
        // media_path in DB is already a full relative path e.g. /uploads/question_media/qmedia_xxx.png
        // Use as-is (starts with /) or prefix if it doesn't
        var src = q.media_path.startsWith('/') ? q.media_path : '/' + q.media_path;
        if (q.media_type === 'image') {
            mediaImg.src = src;
            mediaImg.style.display = 'block';
            mediaZone.style.display = 'block';
        } else if (q.media_type === 'video') {
            mediaVideo.src = src;
            mediaVideo.style.display = 'block';
            mediaZone.style.display = 'block';
        }
    }

    // Build zoom image list for this question
    zoomImageList  = [];
    zoomImageIndex = 0;
    if (q.media_path && q.media_path.trim() !== '' && q.media_type === 'image') {
        var mSrc = q.media_path.startsWith('/') ? q.media_path : '/' + q.media_path;
        zoomImageList.push({ src: mSrc, label: 'QUESTION IMAGE' });
    }
    var opts = [
        { key: 'option_a_image', label: 'OPTION A IMAGE' },
        { key: 'option_b_image', label: 'OPTION B IMAGE' },
        { key: 'option_c_image', label: 'OPTION C IMAGE' },
        { key: 'option_d_image', label: 'OPTION D IMAGE' }
    ];
    opts.forEach(function(o) {
        if (q[o.key] && q[o.key].trim() !== '') {
        zoomImageList.push({ src: q[o.key].startsWith('/') ? q[o.key] : '/' + q[o.key], label: o.label });
        }
    });

    // Show zoom button only if there's something to zoom
    var zoomBtn = document.getElementById('btn-zoom');
    if (zoomImageList.length > 0 || (q.media_path && q.media_type === 'video')) {
        zoomBtn.style.display = '';
    } else {
        zoomBtn.style.display = 'none';
    }
}

// ═══════════════════════════════════════════════════════════════════
// PANEL SWITCHER
// ═══════════════════════════════════════════════════════════════════
function hideAllAnswerPanels() {
    document.getElementById('mcq-container').style.display              = 'none';
    document.getElementById('periodic-single-container').style.display  = 'none';
    document.getElementById('periodic-sequence-container').style.display= 'none';
    document.getElementById('numeric-container').style.display          = 'none';
