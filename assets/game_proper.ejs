}

// ═══════════════════════════════════════════════════════════════════
// STANDARD MCQ SETUP
// ═══════════════════════════════════════════════════════════════════
function setupStandardUI(q) {
    document.getElementById('mcq-container').style.display = 'block';

    // Reset button states
    ['A','B','C','D'].forEach(function(k) {
        var btn = document.getElementById('btn-' + k.toLowerCase());
        btn.classList.remove('locked','correct-flash','wrong-flash','selected-multi');
        btn.style.opacity = '1';
        // Checkbox visibility
        var cbEl = btn.querySelector('.choice-checkbox');
        if (cbEl) cbEl.remove();
    });

    // Determine if multiple answer mode
    var isMulti = q.is_multiple_answer === 1 || q.is_multiple_answer === true;

    var opts = [
        { key: 'A', textId: 'opt-a-text', imgId: 'opt-a-img', btnId: 'btn-a', text: q.option_a, img: q.option_a_image },
        { key: 'B', textId: 'opt-b-text', imgId: 'opt-b-img', btnId: 'btn-b', text: q.option_b, img: q.option_b_image },
        { key: 'C', textId: 'opt-c-text', imgId: 'opt-c-img', btnId: 'btn-c', text: q.option_c, img: q.option_c_image },
        { key: 'D', textId: 'opt-d-text', imgId: 'opt-d-img', btnId: 'btn-d', text: q.option_d, img: q.option_d_image }
    ];

    opts.forEach(function(o) {
        var textEl = document.getElementById(o.textId);
        var imgEl  = document.getElementById(o.imgId);
        var btn    = document.getElementById(o.btnId);

        // Text
        textEl.textContent = o.text || '';

        // Image
        if (o.img && o.img.trim() !== '') {
            imgEl.src = o.img.startsWith('/') ? o.img : '/' + o.img;
            imgEl.style.display = 'block';
        } else {
            imgEl.style.display = 'none';
            imgEl.src = '';
        }

        // Checkbox injection for multi-answer
        if (isMulti) {
            var cb = document.createElement('div');
            cb.className = 'choice-checkbox';
            btn.insertBefore(cb, btn.querySelector('.choice-letter').nextSibling);
        }
    });

    // Show multi-submit
    if (isMulti) {
        var ms = document.getElementById('multi-submit');
        ms.classList.add('visible');
        updateMultiCount();
    }
}

// ═══════════════════════════════════════════════════════════════════
// STANDARD MCQ — CLICK / HARDWARE
// ═══════════════════════════════════════════════════════════════════
function onChoiceClick(key) {
    if (isPaused) return;
    var q = QUESTIONS[currentIndex];
    if (!q || q.input_mode !== 'Standard') return;
    sfxBtn.play();

    var isMulti = q.is_multiple_answer === 1 || q.is_multiple_answer === true;
    if (isMulti) {
        toggleMultiChoice(key);
    } else {
        submitSingleChoice(key, q);
    }
}

function handleStandardHardware(sym, q) {
    if (['A','B','C','D'].indexOf(sym) !== -1) {
        onChoiceClick(sym);
    } else if (sym === 'ENTER') {
        var isMulti = q.is_multiple_answer === 1 || q.is_multiple_answer === true;
        if (isMulti) { submitMultiAnswer(); }
    }
}

function submitSingleChoice(key, q) {
    isPaused = true;
    clearPerItemTimer();
    sfxTimerLow.stop();

    // Determine correct
    var correctKey = (q.correct_answer || 'A').toUpperCase();
    var isCorrect  = (key === correctKey);
    lastAnswer     = key;

    // Highlight
    lockChoices();
    var btn = document.getElementById('btn-' + key.toLowerCase());
    if (btn) btn.classList.add(isCorrect ? 'correct-flash' : 'wrong-flash');

    // Also highlight correct if wrong
    if (!isCorrect) {
        var cBtn = document.getElementById('btn-' + correctKey.toLowerCase());
        if (cBtn) cBtn.classList.add('correct-flash');
    }

    recordResponse(q, key, isCorrect);
    validateAnswer(isCorrect, q);
}

function toggleMultiChoice(key) {
    var idx = selectedMulti.indexOf(key);
    if (idx === -1) {
        selectedMulti.push(key);
        var btn = document.getElementById('btn-' + key.toLowerCase());
        if (btn) btn.classList.add('selected-multi');
    } else {
        selectedMulti.splice(idx, 1);
        var btn2 = document.getElementById('btn-' + key.toLowerCase());
        if (btn2) btn2.classList.remove('selected-multi');
    }
    updateMultiCount();
}

function updateMultiCount() {
    document.getElementById('multi-count').textContent = selectedMulti.length;
}

function submitMultiAnswer() {
    if (isPaused) return;
    var q = QUESTIONS[currentIndex];
    if (!q || selectedMulti.length === 0) return;
    isPaused = true;
    clearPerItemTimer();
    sfxTimerLow.stop();

    // correct_answer is comma-separated e.g. "A,C" or could be single "A"
    var correctRaw = (q.correct_answer || '').toUpperCase();
    var correctSet = correctRaw.split(',').map(function(s){ return s.trim(); }).filter(Boolean).sort();
    var userSet    = selectedMulti.slice().sort();
    var isCorrect  = (correctSet.join(',') === userSet.join(','));

    lockChoices();
    correctSet.forEach(function(k) {
        var b = document.getElementById('btn-' + k.toLowerCase());
        if (b) b.classList.add('correct-flash');
    });
    userSet.forEach(function(k) {
        var b = document.getElementById('btn-' + k.toLowerCase());
        if (b && !b.classList.contains('correct-flash')) b.classList.add('wrong-flash');
    });

    lastAnswer = userSet.join(',');
    recordResponse(q, lastAnswer, isCorrect);
    validateAnswer(isCorrect, q);
}

function lockChoices() {
    ['A','B','C','D'].forEach(function(k) {
        var b = document.getElementById('btn-' + k.toLowerCase());
        if (b) b.classList.add('locked');
    });
}

// ═══════════════════════════════════════════════════════════════════
// NUMERIC SETUP & LOGIC
// ═══════════════════════════════════════════════════════════════════
function setupNumericUI(q) {
    document.getElementById('numeric-container').style.display = 'flex';
    var inp = document.getElementById('numeric-input');
    inp.value = '';

    // Show computed range
    var ans   = parseFloat(q.numeric_answer);
    var tol   = parseFloat(q.numeric_tolerance) || 0;
    var rng   = document.getElementById('numeric-range-display');
    if (!isNaN(ans)) {
        var lo = (ans - tol).toFixed(4).replace(/\.?0+$/,'');
        var hi = (ans + tol).toFixed(4).replace(/\.?0+$/,'');
        rng.textContent = 'Accepted range: ' + lo + ' to ' + hi + (tol > 0 ? ' (±' + tol + ')' : '');
    } else {
        rng.textContent = 'Accepted range: —';
    }

    setTimeout(function() { inp.focus(); }, 80);
}

function onNumericKey(e) {
    if (e.key === 'Enter') { e.preventDefault(); submitNumeric(); }
}

function handleNumericHardware(sym) {
    var inp = document.getElementById('numeric-input');
    if (!inp) return;
    // A = clear last char (backspace), C = toggle negative, ENTER = submit
    if (sym === 'ENTER') { submitNumeric(); return; }
    // digits 0-9
    if (/^\d$/.test(sym)) { inp.value += sym; return; }
    if (sym === 'A' && inp.value.length > 0) { inp.value = inp.value.slice(0,-1); }
    if (sym === 'D') { inp.value = inp.value.startsWith('-') ? inp.value.slice(1) : '-' + inp.value; }
    if (sym === '.') { if (inp.value.indexOf('.') === -1) inp.value += '.'; }
}

function submitNumeric() {
    if (isPaused) return;
    var q   = QUESTIONS[currentIndex];
    var val = document.getElementById('numeric-input').value.trim();
    if (val === '') return;
    sfxBtn.play();
    isPaused = true;
    clearPerItemTimer();
    sfxTimerLow.stop();

    var userNum    = parseFloat(val);
    var correctNum = parseFloat(q.numeric_answer);
    var tolerance  = parseFloat(q.numeric_tolerance) || 0;
    var isCorrect  = false;
    if (!isNaN(userNum) && !isNaN(correctNum)) {
        isCorrect = Math.abs(userNum - correctNum) <= tolerance;
    }

    lastAnswer = val;
    recordResponse(q, val, isCorrect);
    validateAnswer(isCorrect, q);
}

// ═══════════════════════════════════════════════════════════════════
// PERIODIC SINGLE SETUP & LOGIC
// ═══════════════════════════════════════════════════════════════════
function setupPeriodicSingleUI() {
    document.getElementById('periodic-single-container').style.display = 'flex';
    document.getElementById('single-element-card').classList.remove('filled');
    document.getElementById('single-element-symbol').style.display = 'none';
    document.getElementById('single-element-symbol').textContent    = '';
    document.getElementById('single-element-waiting').style.display = 'block';
}

function handlePeriodicSingleInput(symbol) {
    if (isPaused) return;
    var q = QUESTIONS[currentIndex];
    if (!q || q.input_mode !== 'Periodic_Single') return;

    // Show element on card
    var card    = document.getElementById('single-element-card');
    var symEl   = document.getElementById('single-element-symbol');
    var waitEl  = document.getElementById('single-element-waiting');
    symEl.textContent    = symbol;
    symEl.style.display  = 'block';
    waitEl.style.display = 'none';
    card.classList.add('filled');

    sfxBtn.play();
    isPaused = true;
    clearPerItemTimer();
    sfxTimerLow.stop();

    // Correct answer from answer_sequences (first row's element_symbol)
    var correctSym = '';
    if (q.answer_sequences && q.answer_sequences.length > 0) {
        correctSym = (q.answer_sequences[0].element_symbol || '').toUpperCase();
    } else {
        correctSym = (q.correct_answer || '').toUpperCase();
    }
    var isCorrect = (symbol.toUpperCase() === correctSym);

    lastAnswer = symbol;
    recordResponse(q, symbol, isCorrect);
    validateAnswer(isCorrect, q);
}

// ═══════════════════════════════════════════════════════════════════
// PERIODIC SEQUENCE SETUP & LOGIC
// ═══════════════════════════════════════════════════════════════════
function setupPeriodicSequenceUI(q) {
    document.getElementById('periodic-sequence-container').style.display = 'flex';

    // Determine slot count from answer_sequences
    var seqLen = (q.answer_sequences && q.answer_sequences.length > 0)
        ? q.answer_sequences.length
        : (q.target_answer ? q.target_answer.split(',').length : 1);

    // Initialize selectedElements array
    selectedElements = [];
    for (var i = 0; i < seqLen; i++) {
        selectedElements.push({ symbol: '', subscript: 1 });
    }
    activeSlotIndex = 0;

    renderSequenceSlots(seqLen);
    updateFormulaDisplay();
}

function renderSequenceSlots(count) {
    var container = document.getElementById('formula-slots');
    container.innerHTML = '';
    for (var i = 0; i < count; i++) {
        var slot = document.createElement('div');
        slot.className = 'formula-slot' + (i === activeSlotIndex ? ' active-slot' : '');
        slot.id        = 'seq-slot-' + i;
        slot.innerHTML = '<div class="slot-placeholder">?</div>';
        container.appendChild(slot);
    }
}

function handlePeriodicSequenceHardware(sym) {
    if (isPaused) return;
    var q = QUESTIONS[currentIndex];
    if (!q || q.input_mode !== 'Periodic_Sequence') return;

    var seqLen = selectedElements.length;

    if (sym === 'A') {
        // Navigate left
        activeSlotIndex = Math.max(0, activeSlotIndex - 1);
        updateSlotHighlight();
    } else if (sym === 'C') {
        // Navigate right
        activeSlotIndex = Math.min(seqLen - 1, activeSlotIndex + 1);
        updateSlotHighlight();
    } else if (sym === 'B') {
        // Increase subscript of current slot
        if (selectedElements[activeSlotIndex].symbol !== '') {
            selectedElements[activeSlotIndex].subscript = Math.min(99, selectedElements[activeSlotIndex].subscript + 1);
            renderSlotContent(activeSlotIndex);
            updateFormulaDisplay();
        }
    } else if (sym === 'D') {
        // Decrease subscript
        if (selectedElements[activeSlotIndex].symbol !== '') {
            selectedElements[activeSlotIndex].subscript = Math.max(1, selectedElements[activeSlotIndex].subscript - 1);
            renderSlotContent(activeSlotIndex);
            updateFormulaDisplay();
        }
    } else if (sym === 'ENTER') {
        submitSequence();
    } else {
        // It's an element symbol — place in active slot
        sfxBtn.play();
        selectedElements[activeSlotIndex].symbol    = sym;
        selectedElements[activeSlotIndex].subscript = 1;
        renderSlotContent(activeSlotIndex);
        updateFormulaDisplay();
        // Auto-advance to next unfilled slot
        var next = findNextEmptySlot();
        if (next !== -1) {
            activeSlotIndex = next;
            updateSlotHighlight();
        }
    }
}

function findNextEmptySlot() {
    for (var i = 0; i < selectedElements.length; i++) {
        if (selectedElements[i].symbol === '') return i;
    }
    return -1;
}

function updateSlotHighlight() {
    selectedElements.forEach(function(_, i) {
        var slot = document.getElementById('seq-slot-' + i);
        if (!slot) return;
        slot.classList.toggle('active-slot', i === activeSlotIndex);
    });
}

function renderSlotContent(i) {
    var slot = document.getElementById('seq-slot-' + i);
    if (!slot) return;
    var el = selectedElements[i];
    if (el.symbol) {
        slot.classList.add('filled-slot');
        slot.innerHTML = '<div class="slot-symbol">' + el.symbol + '</div>' +
                         '<div class="slot-subscript">' + (el.subscript > 1 ? el.subscript : '') + '</div>';
    } else {
        slot.classList.remove('filled-slot');
        slot.innerHTML = '<div class="slot-placeholder">?</div>';
    }
    slot.classList.toggle('active-slot', i === activeSlotIndex);
}

function updateFormulaDisplay() {
    var display = document.getElementById('formula-display');
    var parts = [];
    selectedElements.forEach(function(el) {
        if (el.symbol) {
            parts.push(el.symbol + (el.subscript > 1 ? el.subscript : ''));
        }
    });
    display.textContent = parts.length > 0 ? parts.join('') : '—';
}

function submitSequence() {
    if (isPaused) return;
    var q = QUESTIONS[currentIndex];
    if (!q) return;

    // Check all slots filled
    var allFilled = selectedElements.every(function(el) { return el.symbol !== ''; });
    if (!allFilled) { return; } // silently wait

    sfxBtn.play();
    isPaused = true;
    clearPerItemTimer();
    sfxTimerLow.stop();

    // Compare against answer_sequences
    var correct = true;
    var correctSeq = q.answer_sequences || [];
    if (selectedElements.length !== correctSeq.length) {
        correct = false;
    } else {
        for (var i = 0; i < correctSeq.length; i++) {
            var cs = (correctSeq[i].element_symbol || '').toUpperCase();
            var us = (selectedElements[i].symbol || '').toUpperCase();
            var csub = parseInt(correctSeq[i].subscript, 10) || 1;
            var usub = parseInt(selectedElements[i].subscript, 10) || 1;
            if (cs !== us || csub !== usub) { correct = false; break; }
        }
    }

    lastAnswer = selectedElements.map(function(el){ return el.symbol + (el.subscript > 1 ? el.subscript : ''); }).join(',');
    recordResponse(q, lastAnswer, correct);
    validateAnswer(correct, q);
}

// ═══════════════════════════════════════════════════════════════════
// RECORD RESPONSE
// ═══════════════════════════════════════════════════════════════════
function recordResponse(q, selected, isCorrect) {
    var timeTaken = Date.now() - questionStartTime;
    playerResponses.push({
        questionId : q.question_id,
        selected   : String(selected).substring(0, 255),
        isCorrect  : isCorrect,
        timeTaken  : timeTaken
    });
}

// ═══════════════════════════════════════════════════════════════════
// VALIDATE ANSWER — MASTER OUTCOME
// ═══════════════════════════════════════════════════════════════════
function validateAnswer(isCorrect, q) {
    var card = document.getElementById('right-area');

    if (isCorrect) {
        currentScore++;
        if (sfxCorrect) sfxCorrect.play();

        comboCount++;
        if (comboCount > maxCombo) maxCombo = comboCount;

        var multiplier = comboCount >= 5 ? 2.0 : comboCount >= 3 ? 1.5 : 1.0;
        var gained     = Math.round((q.base_exp || 100) * multiplier + (timeLeft * 8));
        sessionExp    += gained;
        totalExp      += gained;

        animateStatValue('live-score-val', currentScore);
        animateStatValue('live-exp-val', totalExp);

        if (comboCount >= 3) showComboTag(comboCount);

        confetti({ particleCount:90, spread:65, origin:{y:0.65}, colors:['#fbbf24','#ffffff','#4ade80'] });

        showFeedback(true, gained, q);
        addHistoryEntry(currentIndex + 1, lastAnswer, getCorrectAnswerDisplay(q), true, false);

    } else {
        if (sfxWrong) sfxWrong.play();
        comboCount = 0;

        showFeedback(false, 0, q);
        addHistoryEntry(currentIndex + 1, lastAnswer || 'timeout', getCorrectAnswerDisplay(q), false, lastAnswer === '');
    }
}

function getCorrectAnswerDisplay(q) {
    if (q.input_mode === 'Standard') {
        var keyMap = { A: q.option_a, B: q.option_b, C: q.option_c, D: q.option_d };
        var correct = (q.correct_answer || '').toUpperCase();
        // multi answer
        if (correct.indexOf(',') !== -1) {
            return correct;
        }
        return keyMap[correct] ? correct + ' – ' + (keyMap[correct] || '') : correct;
    } else if (q.input_mode === 'Numeric') {
        return String(q.numeric_answer || '?');
    } else if (q.input_mode === 'Periodic_Single') {
        var seq = q.answer_sequences || [];
        return seq.length > 0 ? seq[0].element_symbol : (q.correct_answer || '?');
    } else if (q.input_mode === 'Periodic_Sequence') {
        var seqs = q.answer_sequences || [];
        return seqs.map(function(s){ return s.element_symbol + (s.subscript > 1 ? s.subscript : ''); }).join('');
    }
    return q.correct_answer || '?';
}

// ═══════════════════════════════════════════════════════════════════
// FEEDBACK OVERLAY
// ═══════════════════════════════════════════════════════════════════
function showFeedback(isCorrect, expGained, q) {
    var overlay  = document.getElementById('feedback-overlay');
    var iconEl   = document.getElementById('fb-icon');
    var titleEl  = document.getElementById('fb-title');
    var subEl    = document.getElementById('fb-sub');
    var answerEl = document.getElementById('fb-answer');
    var expEl    = document.getElementById('fb-exp');

    var cfg = THEME_CONFIG[currentTheme] || THEME_CONFIG['default_lab'];
    overlay.style.background = isCorrect ? cfg.feedbackBg.replace(')',',').replace('rgba','rgba') : cfg.feedbackBg;
    overlay.style.background = isCorrect
        ? 'rgba(0,30,15,0.95)'
        : 'rgba(30,0,0,0.95)';

    if (isCorrect) {
        iconEl.textContent      = '✓';
        iconEl.style.color      = '#22c55e';
        iconEl.style.textShadow = '0 0 40px rgba(34,197,94,0.85)';
        titleEl.textContent     = 'CORRECT!';
        titleEl.style.color     = '#22c55e';
        subEl.textContent       = comboCount >= 3 ? comboCount + 'x COMBO!' : 'Well done, Agent!';
        answerEl.classList.add('hidden');
        expEl.textContent       = '+' + expGained + ' EXP' + (comboCount >= 5 ? ' ×2.0' : comboCount >= 3 ? ' ×1.5' : '');
        expEl.classList.remove('hidden');
    } else {
        iconEl.textContent      = '✗';
        iconEl.style.color      = '#ef4444';
        iconEl.style.textShadow = '0 0 40px rgba(239,68,68,0.85)';
        titleEl.textContent     = lastAnswer === '' ? 'TIME OUT!' : 'WRONG!';
        titleEl.style.color     = '#ef4444';
        subEl.textContent       = 'Correct Answer:';
        answerEl.textContent    = getCorrectAnswerDisplay(q);
        answerEl.classList.remove('hidden');
        expEl.classList.add('hidden');
    }

    overlay.classList.add('show');

    // 2-second display then advance
    setTimeout(function() {
        hideFeedback();
        document.getElementById('right-area').classList.remove('card-correct','card-wrong');
        currentIndex++;
        initQuestion();
    }, 2000);
}

function hideFeedback() {
    document.getElementById('feedback-overlay').classList.remove('show');
}

// ═══════════════════════════════════════════════════════════════════
// QUESTION HISTORY (LEFT PANEL)
// ═══════════════════════════════════════════════════════════════════
function addHistoryEntry(num, studentAns, correctAns, isCorrect, isTimeout) {
    var list = document.getElementById('history-list');
    var item = document.createElement('div');
    var status = isCorrect ? 'correct' : 'wrong';
    item.className = 'q-history-item ' + status;

    var badgeLabel = isCorrect ? 'Correct' : (isTimeout ? 'Timeout' : 'Wrong');
    var badgeClass = isCorrect ? 'correct' : (isTimeout ? 'timeout' : 'wrong');

    item.innerHTML =
        '<div class="q-hist-header">' +
            '<span class="q-hist-num">Q' + num + '</span>' +
            '<span class="q-hist-badge ' + badgeClass + '">' + badgeLabel + '</span>' +
        '</div>' +
        '<div class="q-hist-answers">' +
            '<span class="q-hist-ans student">' + truncate(studentAns, 18) + '</span>' +
            '<span class="q-hist-ans correct-ans">' + truncate(correctAns, 18) + '</span>' +
        '</div>';

    list.appendChild(item);
    // Scroll to bottom
    var scroll = document.getElementById('history-scroll');
    scroll.scrollTop = scroll.scrollHeight;
}

function addResumedEntry(num) {
    var list = document.getElementById('history-list');
    var item = document.createElement('div');
    item.className = 'q-history-item resumed';
    item.innerHTML =
        '<div class="q-hist-header">' +
            '<span class="q-hist-num">Q' + num + '</span>' +
            '<span class="q-hist-badge resumed">Resumed</span>' +
        '</div>' +
        '<div class="q-hist-answers">' +
            '<span class="q-hist-ans student" style="color:rgba(255,255,255,0.25);">—</span>' +
        '</div>';
    list.appendChild(item);
}

function truncate(str, max) {
    str = String(str || '');
    return str.length > max ? str.substring(0, max) + '…' : str;
}

// ═══════════════════════════════════════════════════════════════════
// TIMERS
// ═══════════════════════════════════════════════════════════════════

// PER-ITEM TIMER
// primePerItemTimer — shows the ring at full but does NOT start the tick.
// Called when TTS is enabled so the student sees the full ring while TTS reads.
function primePerItemTimer(seconds) {
    clearPerItemTimer();
    timeLeft      = seconds;
    timeLimitFull = seconds;
    var bar   = document.getElementById('timer-bar');
    var numEl = document.getElementById('timer-num');
    var timerW= document.getElementById('timer-wrapper');
    bar.style.strokeDasharray  = CIRCUMFERENCE;
    bar.style.strokeDashoffset = '0';
    numEl.textContent = seconds;
    timerW.classList.remove('timer-critical');
    document.getElementById('timer-wrapper').style.display = '';
    document.getElementById('global-timer-bar-wrap').classList.add('hidden');
    document.getElementById('global-timer-countdown').classList.add('hidden');
    // Timer NOT started — primePerItemTimer only sets visual state
}

function startPerItemTimer(seconds) {
    clearPerItemTimer();
    timeLeft      = seconds;
    timeLimitFull = seconds;

    var bar   = document.getElementById('timer-bar');
    var numEl = document.getElementById('timer-num');
    var timerW= document.getElementById('timer-wrapper');

    bar.style.strokeDasharray  = CIRCUMFERENCE;
    bar.style.strokeDashoffset = '0';
    numEl.textContent = seconds;
    timerW.classList.remove('timer-critical');

    // Show per-item timer, hide global bar
    document.getElementById('timer-wrapper').style.display = '';
    document.getElementById('global-timer-bar-wrap').classList.add('hidden');
    document.getElementById('global-timer-countdown').classList.add('hidden');

    perItemTimer = setInterval(function() {
        if (isPaused) { clearInterval(perItemTimer); return; }
        timeLeft--;
        numEl.textContent = Math.max(0, timeLeft);
        var offset = CIRCUMFERENCE - (timeLeft / timeLimitFull) * CIRCUMFERENCE;
        bar.style.strokeDashoffset = offset;

        if (timeLeft <= 5 && timeLeft > 0) {
            timerW.classList.add('timer-critical');
            if (!sfxTimerLow.playing()) sfxTimerLow.play();
        }
        if (timeLeft <= 0) {
            clearInterval(perItemTimer);
            sfxTimerLow.stop();
            if (!isPaused) {
                isPaused   = true;
                lastAnswer = '';
                var q = QUESTIONS[currentIndex];
                if (q) {
                    recordResponse(q, 'timeout', false);
                    validateAnswer(false, q);
                }
            }
        }
    }, 1000);
}

function clearPerItemTimer() {
    if (perItemTimer) { clearInterval(perItemTimer); perItemTimer = null; }
    timeLeft = 0;
}

// GLOBAL TIMER
function startGlobalTimer(totalSeconds) {
    globalSecondsLeft  = totalSeconds;
    globalSecondsTotal = totalSeconds;

    document.getElementById('timer-wrapper').style.display = 'none';
    document.getElementById('global-timer-bar-wrap').classList.remove('hidden');
    document.getElementById('global-timer-countdown').classList.remove('hidden');

    updateGlobalTimerUI();

    globalTimerInterval = setInterval(function() {
        if (isGameOver) { clearInterval(globalTimerInterval); return; }
        globalSecondsLeft--;
        updateGlobalTimerUI();
        if (globalSecondsLeft <= 0) {
            clearInterval(globalTimerInterval);
            onGlobalTimerExpired();
        }
    }, 1000);
}

function updateGlobalTimerUI() {
    var pct = globalSecondsTotal > 0 ? (globalSecondsLeft / globalSecondsTotal) * 100 : 0;
    var bar = document.getElementById('global-timer-bar');
    bar.style.width = pct + '%';
    if (pct <= 20) { bar.style.background = '#ef4444'; }
    else if (pct <= 50) { bar.style.background = '#fbbf24'; }
    else { bar.style.background = 'var(--tc)'; }

    var mins = Math.floor(globalSecondsLeft / 60);
    var secs = globalSecondsLeft % 60;
    document.getElementById('global-timer-countdown').textContent =
        (mins < 10 ? '0' : '') + mins + ':' + (secs < 10 ? '0' : '') + secs;
}

function onGlobalTimerExpired() {
    if (isGameOver) return;
    isGameOver = true;
    isPaused   = true;
    // Mark all remaining as timeout
    while (currentIndex < QUESTIONS.length) {
        var q = QUESTIONS[currentIndex];
        recordResponse(q, 'timeout', false);
        addHistoryEntry(currentIndex + 1, 'timeout', getCorrectAnswerDisplay(q), false, true);
        currentIndex++;
    }
    showFinalResults();
}

// ═══════════════════════════════════════════════════════════════════
// TOOLBAR BUTTON HANDLERS
// ═══════════════════════════════════════════════════════════════════
function onRepeat() {
    var q = QUESTIONS[currentIndex];
    if (!q) return;
    speakQuestion(q);
}

function onInstruction() {
    var q = QUESTIONS[currentIndex];
    if (!q || !q.instruction_override) return;
    speak(q.instruction_override);
    // Flash instruction box
    var box = document.getElementById('instruction-box');
    box.style.boxShadow = '0 0 18px var(--tc)';
    setTimeout(function(){ box.style.boxShadow = ''; }, 1000);
}

function onZoom() {
    var q = QUESTIONS[currentIndex];
    if (!q) return;
    if (isZoomOpen) { closeZoom(); return; }

    if (q.media_type === 'video' && q.media_path) {
        var vSrc = q.media_path.startsWith('/') ? q.media_path : '/' + q.media_path;
        openZoomVideo(vSrc);
    } else if (zoomImageList.length > 0) {
        openZoomImage(0);
    }
}

function openZoomImage(idx) {
    zoomImageIndex = idx;
    var item = zoomImageList[idx];
    if (!item) return;
    isZoomOpen = true;

    var overlay = document.getElementById('zoom-overlay');
    var img     = document.getElementById('zoom-media-img');
    var vid     = document.getElementById('zoom-media-video');
    var lbl     = document.getElementById('zoom-label');
    var hint    = document.getElementById('zoom-hint');

    img.src = item.src; img.style.display = 'block';
    vid.style.display = 'none'; vid.pause();
    lbl.textContent  = item.label;
    hint.textContent = zoomImageList.length > 1
        ? 'A ← → C  to cycle · ZOOM to exit (' + (idx+1) + '/' + zoomImageList.length + ')'
        : 'ZOOM to exit';
    overlay.classList.add('show');
    document.getElementById('btn-zoom').classList.add('active');
}

function openZoomVideo(src) {
    isZoomOpen = true;
    var overlay = document.getElementById('zoom-overlay');
    var img     = document.getElementById('zoom-media-img');
    var vid     = document.getElementById('zoom-media-video');
    var lbl     = document.getElementById('zoom-label');
    var hint    = document.getElementById('zoom-hint');

    img.style.display = 'none';
    vid.src = src; vid.style.display = 'block';
    lbl.textContent  = 'VIDEO — ZOOM MODE';
    hint.textContent = 'ENTER to play/pause · ZOOM to exit';
    overlay.classList.add('show');
    document.getElementById('btn-zoom').classList.add('active');
}

function closeZoom() {
    isZoomOpen = false;
    var overlay = document.getElementById('zoom-overlay');
    var vid     = document.getElementById('zoom-media-video');
    overlay.classList.remove('show');
    vid.pause();
    document.getElementById('btn-zoom').classList.remove('active');
}

function cycleZoomImage(dir) {
    var newIdx = zoomImageIndex + dir;
    if (newIdx < 0) newIdx = zoomImageList.length - 1;
    if (newIdx >= zoomImageList.length) newIdx = 0;
    openZoomImage(newIdx);
}

function toggleZoomVideo() {
    var vid = document.getElementById('zoom-media-video');
    if (vid.paused) { vid.play(); } else { vid.pause(); }
}

function onBGM() {
    isBGMOn = !isBGMOn;
    var btn = document.getElementById('btn-bgm');
    if (isBGMOn) {
        playBGM();
        btn.classList.add('active');
        btn.querySelector('i').className = 'fas fa-music';
    } else {
        stopBGM();
        btn.classList.remove('active');
        btn.querySelector('i').className = 'fas fa-volume-mute';
    }
}

function onHome() {
    if (isHomeDialogOpen) { closeHomeDialog(); return; }
    isHomeDialogOpen = true;
    isPaused = true;
    document.getElementById('home-dialog').classList.add('show');
}

function closeHomeDialog() {
    isHomeDialogOpen = false;
    if (!isGameOver) isPaused = false;
    document.getElementById('home-dialog').classList.remove('show');
}

async function doExitMission() {
    // Save session then redirect
    await updateSession();
    window.location.href = '/arcade/standby';
}

// Wire home dialog buttons
document.getElementById('home-confirm-btn').onclick = doExitMission;
document.getElementById('home-cancel-btn').onclick  = closeHomeDialog;

// ═══════════════════════════════════════════════════════════════════
// KEYBOARD FALLBACK (for desktop testing)
// ═══════════════════════════════════════════════════════════════════
window.addEventListener('keydown', function(e) {
    if (isGameOver) return;

    // Home dialog priority
    if (isHomeDialogOpen) {
        if (e.key === 'Enter')  { e.preventDefault(); doExitMission(); }
        if (e.key === 'Escape') { closeHomeDialog(); }
        return;
    }

    // Zoom priority
    if (isZoomOpen) {
        if (e.key === 'ArrowLeft')  cycleZoomImage(-1);
        if (e.key === 'ArrowRight') cycleZoomImage(1);
        if (e.key === 'Enter') { toggleZoomVideo(); }
        if (e.key === 'z' || e.key === 'Z' || e.key === 'Escape') closeZoom();
        return;
    }

    if (isPaused) return;
    var q = QUESTIONS[currentIndex];
    if (!q) return;

    if (q.input_mode === 'Standard') {
        var isMulti = q.is_multiple_answer === 1;
        var kmap    = { 'a':'A','b':'B','c':'C','d':'D','1':'A','2':'B','3':'C','4':'D' };
        var k = kmap[e.key.toLowerCase()];
        if (k) { sfxBtn.play(); onChoiceClick(k); }
        if (e.key === 'Enter' && isMulti) { e.preventDefault(); submitMultiAnswer(); }
    }
    if (q.input_mode === 'Periodic_Sequence') {
        if (e.key === 'Enter') { e.preventDefault(); submitSequence(); }
        if (e.key === 'ArrowLeft')  handlePeriodicSequenceHardware('A');
        if (e.key === 'ArrowRight') handlePeriodicSequenceHardware('C');
        if (e.key === 'ArrowUp')    handlePeriodicSequenceHardware('B');
        if (e.key === 'ArrowDown')  handlePeriodicSequenceHardware('D');
    }
    if (q.input_mode === 'Numeric' && e.key === 'Escape') {
        document.getElementById('numeric-input').blur();
    }

    // Toolbar shortcuts
    if (e.key === 'r' || e.key === 'R') onRepeat();
    if (e.key === 'i' || e.key === 'I') onInstruction();
    if (e.key === 'z' || e.key === 'Z') onZoom();
    if (e.key === 'm' || e.key === 'M') onBGM();
    if (e.key === 'Escape') onHome();
});

// ═══════════════════════════════════════════════════════════════════
// EXP / SCORE ANIMATION
// ═══════════════════════════════════════════════════════════════════
function animateStatValue(elemId, endVal) {
    var el    = document.getElementById(elemId);
    var start = parseInt(el.textContent, 10) || 0;
    var diff  = endVal - start;
    var step  = Math.ceil(Math.abs(diff) / 25) || 1;
    var dir   = diff >= 0 ? 1 : -1;
    var iv    = setInterval(function() {
        start += dir * step;
        if ((dir === 1 && start >= endVal) || (dir === -1 && start <= endVal)) {
            start = endVal;
            clearInterval(iv);
        }
        el.textContent = start;
    }, 18);
}

// ═══════════════════════════════════════════════════════════════════
// COMBO TAG
// ═══════════════════════════════════════════════════════════════════
function showComboTag(count) {
    var tag = document.getElementById('combo-tag');
    document.getElementById('combo-val').textContent = count;
    tag.classList.add('show');
    setTimeout(function() { tag.classList.remove('show'); }, 1600);
}

// ═══════════════════════════════════════════════════════════════════
// SESSION UPDATE (after every answer)
// ═══════════════════════════════════════════════════════════════════
async function updateSession() {
    try {
        await fetch('/arcade/game/update-session', {
            method  : 'POST',
            headers : { 'Content-Type': 'application/json' },
            body    : JSON.stringify({
                studentId          : USER_DATA.user_id,
                assessmentId       : ASSESSMENT.assessment_id,
                currentItemIndex   : currentIndex + 1,
                accumulatedScore   : currentScore
            })
        });
    } catch(_) {}
}

// ═══════════════════════════════════════════════════════════════════
// FINAL RESULTS
// ═══════════════════════════════════════════════════════════════════
async function showFinalResults() {
    isGameOver = true;
    clearPerItemTimer();
    if (globalTimerInterval) clearInterval(globalTimerInterval);
    sfxTimerLow.stop();
    stopBGM();

    // Stop TTS
    if (speechSynthesis) speechSynthesis.cancel();

    var resultData = {
        userId             : USER_DATA.user_id,
        assessmentId       : ASSESSMENT.assessment_id,
        subjectId          : ASSESSMENT.subject_id || null,
        scoreObtained      : currentScore,
        totalPossibleScore : QUESTIONS.reduce(function(s,q){ return s + (q.points||1); }, 0),
        totalItems         : QUESTIONS.length,
        expGained          : sessionExp,
        responses          : playerResponses
    };

    try {
        var resp   = await fetch('/arcade/submit-results', {
            method  : 'POST',
            headers : { 'Content-Type': 'application/json' },
            body    : JSON.stringify(resultData)
        });
        var result = await resp.json();

        if (result.success) {
            var totalPts  = QUESTIONS.reduce(function(s,q){ return s + (q.points||1); }, 0);
            var accuracy  = totalPts > 0 ? Math.round((currentScore / totalPts) * 100) : 0;
            var isPassing = accuracy >= 50;

            document.getElementById('final-score').textContent    = currentScore + ' / ' + totalPts;
            document.getElementById('final-exp').textContent      = sessionExp.toLocaleString();
            document.getElementById('final-accuracy').textContent = accuracy + '%';
            document.getElementById('final-combo').textContent    = maxCombo + 'x';
            document.getElementById('final-surpassed').textContent= result.surpassedCount || 0;

            // Play result sound — pass or fail
            if (isPassing && sfxResultPass) {
                setTimeout(function(){ sfxResultPass.play(); }, 400);
            } else if (!isPassing && sfxResultFail) {
                setTimeout(function(){ sfxResultFail.play(); }, 400);
            }

            // Grade badge
            var gb = document.getElementById('grade-badge');
            if      (accuracy >= 95) { gb.textContent = 'S RANK'; gb.className = 'grade-s'; confetti({ particleCount:280, spread:120, origin:{y:0.4}, colors:['#fbbf24','#fff','#a5f3fc'] }); }
            else if (accuracy >= 80) { gb.textContent = 'A RANK'; gb.className = 'grade-a'; confetti({ particleCount:150, spread:90, origin:{y:0.5}, colors:['#4ade80','#fff'] }); }
            else if (accuracy >= 65) { gb.textContent = 'B RANK'; gb.className = 'grade-b'; }
            else if (accuracy >= 50) { gb.textContent = 'C RANK'; gb.className = 'grade-c'; }
            else                      { gb.textContent = 'D RANK'; gb.className = 'grade-d'; }

            document.getElementById('final-screen').classList.add('show');
        } else {
            alert('Failed to sync results: ' + (result.message || 'Unknown error'));
        }
    } catch(err) {
        console.error('[GAME] Submit error:', err);
        alert('Network error syncing results. Please notify your teacher.');
    }
}

// ═══════════════════════════════════════════════════════════════════
// PARALLAX / MOUSE TILT (subtle)
// ═══════════════════════════════════════════════════════════════════
(function() {
    var contentZone = document.getElementById('content-zone');
    document.addEventListener('mousemove', function(e) {
        if (!contentZone || isPaused) return;
        var cx = window.innerWidth  / 2;
        var cy = window.innerHeight / 2;
        var dx = (e.clientX - cx) / cx * 0.8;
        var dy = (e.clientY - cy) / cy * 0.5;
        contentZone.style.transform = 'perspective(1200px) rotateY(' + dx + 'deg) rotateX(' + (-dy) + 'deg)';
    });
    document.addEventListener('mouseleave', function() {
        if (contentZone) contentZone.style.transform = 'none';
    });
})();

// ═══════════════════════════════════════════════════════════════════
// BOOT SEQUENCE
// ═══════════════════════════════════════════════════════════════════
(function boot() {
    if (!QUESTIONS || QUESTIONS.length === 0) {
        document.getElementById('question-text').textContent = 'No questions available. Returning to standby...';
        setTimeout(function() { window.location.href = '/arcade/standby'; }, 2800);
        return;
    }

    // Init audio (requires first user interaction for autoplay)
    initAudio();

    // Start BGM on first interaction
    document.body.addEventListener('click', function startAudio() {
        playBGM();
        document.body.removeEventListener('click', startAudio);
    }, { once: true });

    // Build ambient layer for initial theme
    var initTheme = (QUESTIONS[0] && QUESTIONS[0].theme_id && VALID_THEMES.indexOf(QUESTIONS[0].theme_id) !== -1)
        ? QUESTIONS[0].theme_id : 'default_lab';
    buildAmbientLayer(initTheme);
    currentTheme = initTheme;

    // Handle resume: if RESUME_INDEX > 0, show resumed entries in history
    if (RESUME_INDEX > 0) {
        currentIndex = RESUME_INDEX;
        for (var ri = 0; ri < RESUME_INDEX; ri++) {
            addResumedEntry(ri + 1);
        }
    }

    // Start global timer if applicable
    if (ASSESSMENT.timer_type === 'Global') {
        var totalSecs = (ASSESSMENT.duration_minutes || 30) * 60;
        startGlobalTimer(totalSecs);
    }

    // BGM initial state indicator
    if (isBGMOn) { document.getElementById('btn-bgm').classList.add('active'); }

    // Load first question
    initQuestion();
})();
</script>
