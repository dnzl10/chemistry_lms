                                        <option value="Weekly">Weekly</option>
                                        <option value="Monthly">Monthly</option>
                                    </select>
                                </div>
                
                            </div>
                
                            <div class="modal-footer">
                                <button type="button" onclick="closeCalModal()" class="sort-btn">Cancel</button>
                                <button type="submit" class="sort-btn active"
                                        style="background:#7c3aed;border-color:#6d28d9;color:white">
                                    <i class="fas fa-save text-xs"></i> Save Event
                                </button>
                            </div>
                        </form>
                    </div>
                </div>



