<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= subject.subject_name %> | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }

        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Subject hero card */
        .subject-hero {
            position: relative;
            overflow: hidden;
            border-radius: 1.5rem;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0c4a6e 100%);
        }
        .subject-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 70% 50%, rgba(6,182,212,0.15) 0%, transparent 60%),
                              radial-gradient(circle at 20% 80%, rgba(139,92,246,0.1) 0%, transparent 50%);
            pointer-events: none;
        }
        .subject-hero-img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.50;
            mask-image: linear-gradient(to bottom, rgba(0,0,0,0.6), rgba(0,0,0,0.2));
            -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.6), rgba(0,0,0,0.2));
        }

        /* Stat pill */
        .stat-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 9999px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.15);
            font-size: 12px;
            font-weight: 600;
            color: rgba(255,255,255,0.85);
            backdrop-filter: blur(4px);
        }

        /* Table styles */
        .roster-table { border-collapse: separate; border-spacing: 0; width: 100%; }
        .roster-table thead th {
            background: #f8fafc;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #64748b;
            padding: 10px 16px;
            border-bottom: 1px solid #e2e8f0;
        }
        .roster-table thead th:first-child { border-radius: 12px 0 0 0; }
        .roster-table thead th:last-child  { border-radius: 0 12px 0 0; }
        .roster-table tbody tr {
            transition: background 0.15s;
        }
        .roster-table tbody tr:hover { background: #f0fdfa; }
        .roster-table tbody td {
            padding: 13px 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            font-size: 13px;
            color: #1e293b;
        }
        .roster-table tbody tr:last-child td { border-bottom: none; }

        /* Progress bar */
        .prog-track {
            width: 100%;
            height: 6px;
            background: #e2e8f0;
            border-radius: 9999px;
            overflow: hidden;
        }
        .prog-fill {
            height: 100%;
            border-radius: 9999px;
            transition: width 0.6s ease;
        }

        /* EXP badge */
        .exp-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 9999px;
            background: linear-gradient(90deg, #fef3c7, #fde68a);
            color: #92400e;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.03em;
        }

        /* Search input */
        .search-input {
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 8px 14px 8px 36px;
            font-size: 13px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            background: white;
            width: 240px;
        }
        .search-input:focus {
            border-color: #06b6d4;
            box-shadow: 0 0 0 3px rgba(6,182,212,0.12);
        }

        /* Sort / action button */
        .sort-btn {
            padding: 7px 13px;
            border-radius: 9px;
            border: 1px solid #e2e8f0;
            background: white;
            font-size: 12px;
            font-weight: 600;
            color: #475569;
            cursor: pointer;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: all 0.15s;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .sort-btn:hover { background: #f0fdfa; border-color: #06b6d4; color: #0891b2; }
        .sort-btn.active { background: #ecfeff; border-color: #06b6d4; color: #0e7490; }

        /* Section card */
        .section-card {
            background: white;
            border-radius: 1.25rem;
            border: 1px solid #e2e8f0;
            overflow: hidden;
        }

        .section-header {
            padding: 16px 20px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        /* Scrollable main area */
        #mainScroll { overflow-y: auto; }
        #mainScroll::-webkit-scrollbar { width: 5px; }
        #mainScroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }

        /* Avatar */
        .avatar-ring {
            width: 36px; height: 36px;
            border-radius: 10px;
            object-fit: cover;
            border: 2px solid #e0f2fe;
            flex-shrink: 0;
        }

        .lrn-mono { font-family: monospace; font-size: 12px; color: #94a3b8; letter-spacing: 0.04em; }

        /* Meta chip */
        .meta-chip {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 3px 10px; border-radius: 9999px;
            font-size: 11px; font-weight: 700; letter-spacing: 0.04em;
        }

        /* Fade-in for rows */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-row { animation: fadeUp 0.25s ease forwards; opacity: 0; }
        

        /* ---- Content Management Section ---- */
        .quarter-block {
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            overflow: hidden;
            transition: box-shadow 0.2s;
        }
        .quarter-block:hover { box-shadow: 0 4px 16px rgba(99,102,241,0.07); }

        .quarter-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            background: linear-gradient(90deg, #f8fafc 0%, #f1f5f9 100%);
            cursor: pointer;
            user-select: none;
            gap: 10px;
            flex-wrap: wrap;
        }
        .quarter-header:hover { background: #eef2ff; }

        .quarter-body { background: white; }

        /* Topic row */
        .topic-row {
            border-bottom: 1px solid #f1f5f9;
            transition: background 0.15s;
        }
        .topic-row:last-child { border-bottom: none; }
        .topic-row:hover { background: #f8fafc; }

        .topic-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 18px 12px 32px;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* Sub-items panel (materials, announcements, etc.) */
        .topic-panel {
            display: none;
            background: #fafafa;
            border-top: 1px solid #f1f5f9;
            padding: 16px 18px 16px 44px;
        }
        .topic-panel.open { display: block; }

        /* Tab bar inside topic panel */
        .panel-tabs {
            display: flex;
            gap: 2px;
            background: #f1f5f9;
            border-radius: 10px;
            padding: 3px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }
        .panel-tab {
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            cursor: pointer;
            transition: all 0.15s;
            display: flex;
            align-items: center;
            gap: 5px;
            border: none;
            background: transparent;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .panel-tab:hover { background: white; color: #334155; }
        .panel-tab.active { background: white; color: #4f46e5; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }

        /* Sub-table inside topic panel */
        .sub-table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .sub-table th {
            text-align: left; padding: 7px 10px;
            font-size: 10px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.07em; color: #94a3b8;
            border-bottom: 1px solid #e2e8f0;
            background: #f8fafc;
        }
        .sub-table td {
            padding: 9px 10px;
            border-bottom: 1px solid #f8fafc;
            color: #334155;
            vertical-align: middle;
        }
        .sub-table tr:last-child td { border-bottom: none; }
        .sub-table tr:hover td { background: #f0fdfa; }

        /* Lock toggle button */
        .lock-btn {
            width: 32px; height: 32px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            background: white;
            cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center;
            transition: all 0.15s;
            flex-shrink: 0;
        }
        .lock-btn.locked { background: #fff7ed; border-color: #fed7aa; color: #ea580c; }
        .lock-btn.locked:hover { background: #ffedd5; }
        .lock-btn.unlocked { background: #f0fdf4; border-color: #bbf7d0; color: #16a34a; }
        .lock-btn.unlocked:hover { background: #dcfce7; }

        /* Icon action buttons */
        .icon-btn {
            width: 28px; height: 28px;
            border-radius: 7px;
            border: 1px solid #e2e8f0;
            background: white;
            cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 11px;
            transition: all 0.15s;
            color: #64748b;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .icon-btn:hover { border-color: #06b6d4; color: #0891b2; background: #ecfeff; }
        .icon-btn.danger:hover { border-color: #fca5a5; color: #dc2626; background: #fff1f1; }
        .icon-btn.warn:hover { border-color: #fcd34d; color: #d97706; background: #fffbeb; }
        .icon-btn.success:hover { border-color: #86efac; color: #16a34a; background: #f0fdf4; }

        /* Priority / pin badges */
        .badge-priority { display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 9999px; font-size: 10px; font-weight: 700; background: #fef2f2; color: #b91c1c; }
        .badge-pinned   { display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 9999px; font-size: 10px; font-weight: 700; background: #eff6ff; color: #1d4ed8; }
        .badge-type     { display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 9999px; font-size: 10px; font-weight: 700; }

        /* Add-row button */
        .add-row-btn {
            display: flex; align-items: center; gap: 5px;
            padding: 6px 12px;
            border-radius: 8px;
            border: 1.5px dashed #cbd5e1;
            background: transparent;
            font-size: 12px; font-weight: 600; color: #94a3b8;
            cursor: pointer;
            transition: all 0.15s;
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin-top: 8px;
        }
        .add-row-btn:hover { border-color: #06b6d4; color: #0891b2; background: #ecfeff; }

        /* Modal backdrop + card */
        .modal-backdrop {
            display: none;
            position: fixed; inset: 0; z-index: 200;
            background: rgba(15,23,42,0.55);
            align-items: center; justify-content: center;
            padding: 16px;
        }
        .modal-backdrop.open { display: flex; }
        .modal-card {
            background: white;
            border-radius: 1.25rem;
            width: 100%; max-width: 520px;
            box-shadow: 0 20px 60px rgba(15,23,42,0.18);
            overflow: hidden;
            animation: modalIn 0.2s ease;
        }
        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.96) translateY(8px); }
            to   { opacity: 1; transform: scale(1)    translateY(0); }
        }
        .modal-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 18px 22px;
            border-bottom: 1px solid #f1f5f9;
        }
        .modal-body { padding: 20px 22px; display: flex; flex-direction: column; gap: 14px; }
        .modal-footer {
            padding: 14px 22px;
            border-top: 1px solid #f1f5f9;
            display: flex; justify-content: flex-end; gap: 8px;
        }

        /* Form elements inside modals */
        .form-label { font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 5px; display: block; }
        .form-input, .form-select, .form-textarea {
            width: 100%; padding: 9px 12px;
            border: 1px solid #e2e8f0; border-radius: 9px;
            font-size: 13px; font-family: 'Plus Jakarta Sans', sans-serif;
            color: #1e293b; outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            background: white;
        }
        .form-input:focus, .form-select:focus, .form-textarea:focus {
            border-color: #06b6d4;
            box-shadow: 0 0 0 3px rgba(6,182,212,0.1);
        }
        .form-textarea { resize: vertical; min-height: 80px; }

        /* Confirm delete modal */
        .modal-card.danger .modal-header { background: #fff1f2; }

        /* Content search bar (reuse existing .search-input styles but narrower) */
        .content-search {
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            padding: 6px 12px 6px 30px;
            font-size: 12px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            outline: none;
            background: white;
            width: 180px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .content-search:focus { border-color: #06b6d4; box-shadow: 0 0 0 3px rgba(6,182,212,0.1); }

        /* Chevron rotate on expand */
        .chevron-icon { transition: transform 0.2s; }
        .chevron-icon.open { transform: rotate(90deg); }

        /* Empty state for sub-tables */
        .empty-sub {
            text-align: center; padding: 24px 0;
            color: #cbd5e1; font-size: 12px; font-weight: 600;
        }

        /* Material type badge colors */
        .type-pdf         { background: #fef2f2; color: #b91c1c; }
        .type-word        { background: #eff6ff; color: #1d4ed8; }
        .type-video       { background: #f0fdf4; color: #15803d; }
        .type-link        { background: #faf5ff; color: #7e22ce; }
        .type-img         { background: #fff7ed; color: #c2410c; }
        .type-presentation{ background: #ecfeff; color: #0e7490; }

        /* Assessment type badge */
        .atype-pre    { background: #e0f2fe; color: #0369a1; }
        .atype-post   { background: #dcfce7; color: #15803d; }
        .atype-quiz   { background: #fef9c3; color: #a16207; }
        .atype-comp   { background: #fce7f3; color: #9d174d; }

        /* Locked row dimming */
        .locked-row td { opacity: 0.55; }

        /* Toast notification */
        #cm-toast {
            position: fixed; bottom: 24px; right: 24px; z-index: 999;
            background: #1e293b; color: white;
            padding: 10px 18px; border-radius: 10px;
            font-size: 13px; font-weight: 600;
            box-shadow: 0 8px 24px rgba(15,23,42,0.2);
            transform: translateY(80px); opacity: 0;
            transition: all 0.3s ease;
            pointer-events: none;
            display: flex; align-items: center; gap: 8px;
            max-width: 320px;
        }
        #cm-toast.show { transform: translateY(0); opacity: 1; }
        #cm-toast.success { background: #064e3b; }
        #cm-toast.error   { background: #7f1d1d; }

        /* PASTE THIS inside your <style> tag, anywhere after the existing tab CSS */
        .tab-content { display: block; }
        .tab-content.hidden { display: none !important; }


        /* ── Analytics section ── */
        .analytics-tabs { display:flex; gap:2px; background:#f1f5f9; border-radius:10px; padding:3px; flex-wrap:wrap; margin-bottom:0; }
        .analytics-tab  { padding:7px 16px; border-radius:8px; font-size:12px; font-weight:700; color:#64748b; cursor:pointer; transition:all .15s; display:flex; align-items:center; gap:5px; border:none; background:transparent; font-family:'Plus Jakarta Sans',sans-serif; }
        .analytics-tab:hover  { background:white; color:#334155; }
        .analytics-tab.active { background:white; color:#4f46e5; box-shadow:0 1px 4px rgba(0,0,0,0.08); }
        .analytics-panel { display:none; }
        .analytics-panel.active { display:block; }
        
        /* ── Score summary ── */
        .score-filter-bar { display:flex; flex-wrap:wrap; align-items:center; gap:8px; padding:14px 18px; border-bottom:1px solid #f1f5f9; background:#fafafa; }
        .filter-select { padding:6px 10px; border:1px solid #e2e8f0; border-radius:8px; font-size:12px; font-family:'Plus Jakarta Sans',sans-serif; color:#475569; outline:none; background:white; cursor:pointer; }
        .filter-select:focus { border-color:#06b6d4; }
        
        .score-table { width:100%; border-collapse:collapse; font-size:12px; }
        .score-table th { text-align:left; padding:8px 12px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#94a3b8; border-bottom:1px solid #e2e8f0; background:#f8fafc; white-space:nowrap; }
        .score-table td { padding:10px 12px; border-bottom:1px solid #f8fafc; color:#334155; vertical-align:middle; }
        .score-table tr:last-child td { border-bottom:none; }
        .score-table tr:hover td { background:#f0fdfa; }
        
        .score-bar-wrap { display:flex; align-items:center; gap:6px; min-width:100px; }
        .score-bar-track { flex:1; height:5px; background:#e2e8f0; border-radius:9999px; overflow:hidden; }
        .score-bar-fill  { height:100%; border-radius:9999px; }
        
        /* ── Per-question breakdown ── */
        .breakdown-assessment-select { width:100%; padding:9px 12px; border:1px solid #e2e8f0; border-radius:9px; font-size:13px; font-family:'Plus Jakarta Sans',sans-serif; color:#1e293b; outline:none; background:white; margin-bottom:14px; }
        .breakdown-assessment-select:focus { border-color:#06b6d4; }
        
        .qb-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:10px; }
        .qb-card { background:white; border:1px solid #e2e8f0; border-radius:12px; padding:12px 14px; }
        .qb-card-header { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; margin-bottom:8px; }
        .qb-q-num { font-size:10px; font-weight:800; color:#94a3b8; text-transform:uppercase; letter-spacing:.06em; }
        .qb-difficulty { font-size:10px; font-weight:700; padding:2px 7px; border-radius:9999px; }
        .diff-easy   { background:#dcfce7; color:#15803d; }
        .diff-avg    { background:#fef9c3; color:#a16207; }
        .diff-hard   { background:#fee2e2; color:#b91c1c; }
        .qb-q-text   { font-size:12px; font-weight:600; color:#334155; line-height:1.5; margin-bottom:8px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
        .qb-stats    { display:flex; gap:8px; }
        .qb-stat     { flex:1; text-align:center; background:#f8fafc; border-radius:7px; padding:5px 4px; }
        .qb-stat-val { font-size:13px; font-weight:800; }
        .qb-stat-lbl { font-size:9px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.04em; margin-top:1px; }
        .correct-rate-bar { height:4px; background:#e2e8f0; border-radius:9999px; overflow:hidden; margin-top:7px; }
        .correct-rate-fill { height:100%; border-radius:9999px; background:#10b981; }
        .no-data-state { text-align:center; padding:40px 0; color:#cbd5e1; font-size:13px; font-weight:600; }
        
        /* ── Competitive matches ── */
        .match-row { display:flex; align-items:center; gap:10px; padding:10px 16px; border-bottom:1px solid #f1f5f9; transition:background .15s; }
        .match-row:last-child { border-bottom:none; }
        .match-row:hover { background:#f8fafc; }
        .match-player { flex:1; min-width:0; }
        .match-player-name { font-size:12px; font-weight:700; color:#334155; truncate; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .match-player-score { font-size:11px; color:#64748b; }
        .match-vs { font-size:10px; font-weight:800; color:#cbd5e1; flex-shrink:0; }
        .match-winner-badge { font-size:10px; font-weight:800; padding:2px 8px; border-radius:9999px; background:#fef9c3; color:#a16207; flex-shrink:0; }
        .match-date-chip { font-size:10px; color:#94a3b8; flex-shrink:0; white-space:nowrap; }
        
        /* ── Leaderboard ── */
        .lb-row { display:flex; align-items:center; gap:12px; padding:10px 16px; border-bottom:1px solid #f1f5f9; transition:background .15s; }
        .lb-row:last-child { border-bottom:none; }
        .lb-row:hover { background:#f8fafc; }
        .lb-rank { width:28px; height:28px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; flex-shrink:0; }
        .lb-rank.top1 { background:#fef9c3; color:#a16207; }
        .lb-rank.top2 { background:#f1f5f9; color:#475569; }
        .lb-rank.top3 { background:#fff7ed; color:#c2410c; }
        .lb-rank.other{ background:#f8fafc; color:#94a3b8; }
        .lb-avatar    { width:32px; height:32px; border-radius:9px; object-fit:cover; border:2px solid #e0f2fe; flex-shrink:0; }
        .lb-name      { flex:1; min-width:0; font-size:13px; font-weight:700; color:#334155; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .lb-exp-badge { display:inline-flex; align-items:center; gap:3px; padding:3px 9px; border-radius:9999px; background:linear-gradient(90deg,#fef3c7,#fde68a); color:#92400e; font-size:11px; font-weight:800; flex-shrink:0; }
