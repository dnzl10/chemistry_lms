<!-- ===== SCRIPTS ===== -->
<script>
/* ---- Sidebar toggle ---- */
function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const isOpen  = !sidebar.classList.contains('-translate-x-full');
    sidebar.classList.toggle('-translate-x-full', isOpen);
    overlay.classList.toggle('hidden', isOpen);
}

/* ---- Compute + populate summary stats ---- */
(function() {
    const rows = Array.from(document.querySelectorAll('#rosterBody tr[data-progress]'));
    if (!rows.length) return;

    const progs = rows.map(r => parseFloat(r.dataset.progress) || 0);
    const exps  = rows.map(r => parseFloat(r.dataset.exp)      || 0);

    const avgProg = Math.round(progs.reduce((a,b)=>a+b,0) / progs.length);
    const avgExp  = Math.round(exps.reduce((a,b)=>a+b,0)  / exps.length);
    const done    = progs.filter(p => p >= 100).length;

    document.getElementById('avgProgress').textContent  = avgProg + '%';
    document.getElementById('avgExp').textContent       = avgExp.toLocaleString();
    document.getElementById('completeCount').textContent = done;
})();

/* ---- Search ---- */
document.getElementById('studentSearch').addEventListener('input', filterAndRender);

/* ---- Sort state ---- */
let currentSort = 'name';
let sortDir     = 1;

function sortTable(key) {
    if (currentSort === key) { sortDir *= -1; }
    else { sortDir = (key === 'exp' || key === 'progress') ? -1 : 1; }
    currentSort = key;

    document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
    const idMap = { name: 'sortName', exp: 'sortExp', progress: 'sortProgress' };
    if (idMap[key]) document.getElementById(idMap[key]).classList.add('active');

    filterAndRender();
}

/* ---- Filter + sort + render ---- */
function filterAndRender() {
    const query  = document.getElementById('studentSearch').value.toLowerCase().trim();
    const tbody  = document.getElementById('rosterBody');
    const rows   = Array.from(tbody.querySelectorAll('tr[data-name]'));
    const empty  = document.getElementById('emptyRow');

    let visible = rows.filter(r => r.dataset.name.includes(query));

    visible.sort((a, b) => {
        if (currentSort === 'name')     return sortDir * a.dataset.name.localeCompare(b.dataset.name);
        if (currentSort === 'exp')      return sortDir * (parseFloat(a.dataset.exp)      - parseFloat(b.dataset.exp));
        if (currentSort === 'progress') return sortDir * (parseFloat(a.dataset.progress) - parseFloat(b.dataset.progress));
        return 0;
    });

    rows.forEach(r => r.style.display = 'none');
    visible.forEach((r, i) => {
        r.style.display = '';
        r.querySelector('td:first-child').textContent = i + 1;
    });

    empty.classList.toggle('hidden', visible.length > 0);

    const total = <%= students.length %>;
    document.getElementById('rowCount').innerHTML =
        'Showing <strong>' + visible.length + '</strong>' +
        (visible.length < total ? ' of ' + total : '') + ' students';
}

/* ---- Export to CSV ---- */
function exportCSV() {
    const rows = Array.from(document.querySelectorAll('#rosterBody tr[data-name]'))
                      .filter(r => r.style.display !== 'none');

    const headers = ['#','Name','LRN','Grade','Section','Total EXP','Progress %','Last Accessed'];
    const lines   = [headers.join(',')];

    rows.forEach((row, i) => {
        const tds    = row.querySelectorAll('td');
        const name   = tds[1].querySelector('p').textContent.trim().replace(/,/g,' ');
        const lrn    = tds[2].textContent.trim();
        const spans  = tds[3].querySelectorAll('span');
        const grade  = spans[0] ? spans[0].textContent.trim() : '';
        const sec    = spans[1] ? spans[1].textContent.trim() : '';
        const exp    = tds[4].textContent.replace(/[^\d]/g,'').trim();
        const prog   = row.dataset.progress;
        const last   = tds[6].textContent.trim().replace(/,/g,'');
        lines.push([i+1, name, lrn, grade, sec, exp, prog, last].join(','));
    });

    const blob = new Blob([lines.join('\n')], { type: 'text/csv' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = 'roster_<%= classInfo.class_name.replace(/\s+/g, "_") %>.csv';
    a.click();
    URL.revokeObjectURL(url);
}

/* ================================================================
   CONTENT MANAGEMENT — JAVASCRIPT
   ================================================================ */

/* ---- Toast helper ---- */
function cmToast(msg, type = 'success') {
    const el = document.getElementById('cm-toast');
    const icon = type === 'success' ? '✓' : '✕';
    el.textContent = icon + '  ' + msg;
    el.className   = 'show ' + type;
    clearTimeout(el._t);
    el._t = setTimeout(() => { el.className = ''; }, 3000);
}

/* ---- Quarter accordion ---- */
function toggleQuarter(qid) {
    const body    = document.getElementById('quarter-body-' + qid);
    const chevron = document.getElementById('chevron-q-' + qid);
    const isOpen  = body.style.display !== 'none';
    body.style.display = isOpen ? 'none' : 'block';
    chevron.classList.toggle('open', !isOpen);
}

/* ---- Topic panel expand ---- */
function toggleTopicPanel(tid) {
    const panel   = document.getElementById('panel-' + tid);
    const chevron = document.getElementById('chevron-t-' + tid);
    const isOpen  = panel.classList.contains('open');
    panel.classList.toggle('open', !isOpen);
    chevron.classList.toggle('open', !isOpen);
}

/* ---- Tab switching ---- */
function switchTab(tid, tabName, btn) {
    const panel = document.getElementById('panel-' + tid);
    panel.querySelectorAll('.tab-content').forEach(tc => tc.classList.add('hidden'));
    panel.querySelectorAll('.panel-tab').forEach(tb => tb.classList.remove('active'));
    document.getElementById('tab-' + tid + '-' + tabName).classList.remove('hidden');
    btn.classList.add('active');
}

/* ---- Generic sub-table search filter ---- */
function filterSubTable(query, tableId) {
    const q  = query.toLowerCase().trim();
    const tb = document.getElementById(tableId);
    if (!tb) return;
    tb.querySelectorAll('tbody tr[data-search]').forEach(tr => {
        tr.style.display = tr.dataset.search.includes(q) ? '' : 'none';
    });
}

/* ---- Global topic search (across all quarters) ---- */
function cmSearchTopics(query) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('.topic-row[data-topic-name]').forEach(row => {
        const match = row.dataset.topicName.includes(q);
        row.style.display = match ? '' : 'none';
        if (match && q) {
            /* auto-open parent quarter */
            const qid  = row.dataset.quarter;
            const body = document.getElementById('quarter-body-' + qid);
            if (body) body.style.display = 'block';
            const chevron = document.getElementById('chevron-q-' + qid);
            if (chevron) chevron.classList.add('open');
        }
    });
}
function cmFilterTopics(query, qid) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('.topic-row[data-quarter="' + qid + '"]').forEach(row => {
        row.style.display = row.dataset.topicName.includes(q) ? '' : 'none';
    });
}

/* ---- Modal helpers ---- */
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
/* Close on backdrop click */
document.querySelectorAll('.modal-backdrop').forEach(b => {
    b.addEventListener('click', function(e) {
        if (e.target === this) closeModal(this.id);
    });
});

/* ================================================================
   LOCK TOGGLES — each calls your REST API endpoint via fetch
   ================================================================ */

async function toggleQuarterLock(qid, currentLocked) {
    const newVal = currentLocked ? 0 : 1;
    try {
        const res = await fetch('/teacher/api/quarter/' + qid + '/lock', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_locked: newVal })
        });
        if (!res.ok) throw new Error();

        const btn = document.getElementById('qlock-' + qid);
        btn.className = 'lock-btn ' + (newVal ? 'locked' : 'unlocked');
        btn.querySelector('i').className = 'fas fa-' + (newVal ? 'lock' : 'lock-open') + ' text-xs';
        btn.title = newVal ? 'Unlock quarter' : 'Lock quarter';

        /* If locking — visually dim all topic lock buttons since they cascade */
        if (newVal) {
            document.querySelectorAll('.topic-row[data-quarter="' + qid + '"] .lock-btn').forEach(b => {
                b.classList.add('locked');
                b.classList.remove('unlocked');
                b.querySelector('i').className = 'fas fa-lock text-xs';
                b.disabled = true;
                b.style.opacity = '0.4';
                b.style.cursor  = 'not-allowed';
            });
            cmToast('Quarter locked — all topics locked with it.', 'success');
        } else {
            /* Unlock quarter only — topics stay as they are */
            document.querySelectorAll('.topic-row[data-quarter="' + qid + '"] .lock-btn').forEach(b => {
                b.disabled = false;
                b.style.opacity = '';
                b.style.cursor  = '';
            });
            cmToast('Quarter unlocked. Topics remain individually locked.', 'success');
        }
    } catch(e) {
        cmToast('Failed to update quarter lock.', 'error');
    }
}

async function toggleTopicLock(tid, currentLocked) {
    const newVal = currentLocked ? 0 : 1;
    try {
        const res = await fetch('/teacher/api/topic/' + tid + '/lock', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_locked: newVal })
