                            <i class="fas fa-chart-pie w-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Dashboard</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Academic Management</p>


                    <div class="space-y-1">
                        <a href="/teacher/classes" class="nav-active flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-chalkboard-user w-5 text-emerald-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">My Classes</span>
                        </a>
                    </div>

                    <div class="space-y-1">
                        <a href="/teacher/question-bank" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-database w-5 text-rose-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Question Bank</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Engagement and Communication</p>
                    <div class="space-y-1">
                        <a href="/teacher/forums" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-comments w-5 text-amber-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Forums</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Reports and Analytics</p>
                    <div class="space-y-1">
                        <a href="/teacher/reports" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-file-export w-5 text-fuchsia-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Reports</span>
                        </a>
                    </div>
                </div>
            </nav>

            <div class="p-4 border-t" style="border-color: rgba(99,102,241,0.25);">
                <a href="/logout"
                class="flex items-center gap-3 p-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition group font-bold">
                    <i class="fas fa-right-from-bracket w-5"></i> Log Out
                </a>
            </div>
        </aside>

    <!-- ===== MAIN ===== -->
    <main class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- Top header -->
        <header class="h-20 bg-white/90 backdrop-blur-md border-b border-cyan-100 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-cyan-50 text-cyan-600 md:hidden">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <!-- Breadcrumb -->
                <nav class="hidden sm:flex items-center gap-2 text-sm">
                    <a href="/teacher/classes" class="text-slate-400 hover:text-cyan-600 font-semibold transition">My Classes</a>
                    <i class="fas fa-chevron-right text-slate-300 text-xs"></i>
                    <span class="font-bold text-indigo-900 truncate max-w-[220px]"><%= classInfo.class_name %></span>
                </nav>
            </div>

            <div class="flex items-center gap-3 md:gap-6">
                <div class="relative cursor-pointer p-2 hover:bg-cyan-50 rounded-full transition">
                    <i class="far fa-bell text-xl text-cyan-600"></i>
                    <span class="absolute top-2 right-2 flex h-2.5 w-2.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                    </span>
                </div>
                <div class="flex items-center gap-3 pl-4 border-l border-cyan-100">
                    <div class="text-right hidden lg:block">
                        <p class="text-sm font-bold text-indigo-900"><%= user.first_name %> <%= user.last_name %></p>
                        <p class="text-[10px] uppercase font-black text-cyan-500 tracking-widest">Instructor</p>
                    </div>
                    <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                         class="w-10 h-10 rounded-xl object-cover ring-2 ring-cyan-400 shadow-sm shadow-cyan-200"
                         onerror="this.src='/profile_uploads/default_avatar.png'">
                </div>
            </div>
        </header>

        <!-- ===== SCROLLABLE CONTENT ===== -->
            <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col space-y-6">
    
                <div class="p-4 md:p-8 flex-1">

                <!-- ============================================================
                     SECTION 1 · CLASS / SUBJECT INFO HERO
                ============================================================ -->
                <div class="subject-hero p-7 md:p-10 shadow-2xl shadow-indigo-900/20 mb-6">

                    <!-- Decorative subject image -->
                    <% if (subject.subject_image && subject.subject_image !== 'default_subject.png') { %>
                    <img src="/profile_uploads/<%= subject.subject_image %>" class="subject-hero-img" alt="" onerror="this.src='/profile_uploads/default_subject.png'">
                    <% } %>

                    <div class="relative z-10 flex flex-col gap-5">

                        <!-- Top row: thumbnail + title block side by side -->
                        <div class="flex flex-col gap-4 md:flex-row md:items-start md:gap-6">

                            <!-- Thumbnail with upload overlay -->
                            <div class="flex-shrink-0 relative group" style="width:96px">
                                <div class="w-24 h-24 rounded-2xl overflow-hidden ring-4 ring-white/20 shadow-xl bg-indigo-900/60 flex items-center justify-center" id="subjectThumbWrap">
                                    <% if (subject.subject_image && subject.subject_image !== 'default_subject.png') { %>
                                    <img src="/profile_uploads/<%= subject.subject_image %>" class="w-full h-full object-cover" onerror="this.style.display='none';document.getElementById('thumbIcon').style.display='flex'">
                                    <% } %>
                                    <i class="fas fa-flask text-4xl text-cyan-400 opacity-80" id="thumbIcon" <%= (subject.subject_image && subject.subject_image !== 'default_subject.png') ? 'style="display:none"' : '' %>></i>
                                </div>
                                <!-- Upload overlay -->
                                <button onclick="document.getElementById('subjectImageInput').click()"
                                        title="Change subject image"
                                        class="absolute inset-0 rounded-2xl bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-1 cursor-pointer border-2 border-dashed border-white/40">
                                    <i class="fas fa-camera text-white text-sm"></i>
                                    <span class="text-white text-[10px] font-bold">Change</span>
                                </button>
                                <input type="file" id="subjectImageInput" accept="image/*" class="hidden" onchange="uploadSubjectImage(this)">
                            </div>

                            <!-- Title + meta -->
                            <div class="flex-1 min-w-0">
                                <!-- Meta chips -->
                                <div class="flex flex-wrap items-center gap-2 mb-3">
                                    <span class="meta-chip bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                                        <i class="fas fa-hashtag text-[9px]"></i>
                                        <%= subject.subject_code %>
                                    </span>
                                    <span class="meta-chip bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                                        <i class="fas fa-calendar-days text-[9px]"></i>
                                        Semester <%= subject.semester %>
                                    </span>
                                    <span class="meta-chip bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                                        <i class="fas fa-graduation-cap text-[9px]"></i>
                                        S.Y. <%= schoolYear.sy_range %>
                                    </span>
                                </div>

                                <!-- Names -->
                                <h1 class="text-2xl md:text-3xl font-black text-white leading-tight tracking-tight mb-1">
                                    <%= subject.subject_name %>
                                </h1>
                                <p class="text-indigo-300 font-semibold text-sm">
                                    <i class="fas fa-chalkboard-user mr-1 opacity-60"></i>
                                    <%= classInfo.class_name %>
                                </p>
                            </div>
                        </div>

                        <!-- Description — full width below the top row -->
                        <% if (subject.description) { %>
                        <p class="text-slate-300 text-sm leading-relaxed opacity-90 w-full">
                            <%= subject.description %>
                        </p>
                        <% } %>

                        <!-- Quick stats row -->
                        <div class="flex flex-wrap gap-2 items-center">
                            <span class="stat-pill">
                                <i class="fas fa-users text-cyan-400 text-xs"></i>
                                <%= students.length %> Students
                            </span>

                            <!-- Enrollment code: hidden by default, togglable -->
                            <span class="stat-pill" style="gap:8px">
                                <i class="fas fa-key text-amber-400 text-xs"></i>
                                Enrollment Code:
                                <span id="enrollCodeMask" class="text-white font-bold ml-1 tracking-widest">••••••••</span>
                                <span id="enrollCodeText" class="text-white font-bold ml-1 hidden"><%= subject.enrollment_code || 'N/A' %></span>
                                <button onclick="toggleEnrollCode()" title="Show/hide code"
                                        class="w-5 h-5 flex items-center justify-center rounded hover:bg-white/10 transition" id="enrollToggleBtn">
                                    <i class="fas fa-eye text-white/60 text-[10px]" id="enrollToggleIcon"></i>
                                </button>
                                <button onclick="openShareModal()" title="Share enrollment key"
                                        class="w-5 h-5 flex items-center justify-center rounded hover:bg-white/10 transition text-white/60 hover:text-white">
                                    <i class="fas fa-share-nodes text-[10px]"></i>
                                </button>
                            </span>

                            <span class="stat-pill">
                                <i class="fas fa-user-tie text-purple-400 text-xs"></i>
                                <%= user.first_name %> <%= user.last_name %>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- ======= SHARE ENROLLMENT KEY MODAL ======= -->
                <div class="modal-backdrop" id="shareModal" style="display:none;position:fixed;inset:0;z-index:500;background:rgba(15,23,42,0.6);align-items:center;justify-content:center;padding:16px;">
                    <div class="modal-card" style="max-width:480px">
                        <div class="modal-header">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center">
                                    <i class="fas fa-share-nodes text-amber-600 text-sm"></i>
                                </div>
                                <h3 class="font-bold text-slate-800 text-sm">Share Enrollment Key</h3>
                            </div>
                            <button onclick="closeShareModal()" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-times text-sm"></i>
                            </button>
                        </div>
                        <div class="modal-body" style="padding:20px 24px">
                            <p class="text-slate-500 text-xs mb-3">Send the message below to your students so they can enroll in this class.</p>
                            <div id="shareMessageBox" class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-sm text-slate-700 leading-relaxed whitespace-pre-line font-medium" style="min-height:100px">Please use this enrollment key for your LMS elective course <%= subject.subject_name %> - <%= classInfo.class_name %>
Enrollment Key: <%= subject.enrollment_code || 'N/A' %></div>
                        </div>
                        <div class="modal-footer" style="padding:12px 24px;display:flex;gap:8px;justify-content:flex-end;border-top:1px solid #f1f5f9">
                            <button onclick="closeShareModal()" class="sort-btn">Ok</button>
                            <button onclick="copyShareMessage()" class="sort-btn active" style="background:#0891b2;border-color:#0e7490;color:white" id="copyShareBtn">
                                <i class="fas fa-copy text-xs"></i> Copy
                            </button>
                        </div>
                    </div>
                </div>


                <!-- ============================================================
                     SECTION 2 · ENROLLED STUDENTS ROSTER
                ============================================================ -->
                <div class="section-card mb-6">

                    <!-- Card header -->
                    <div class="section-header">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-400 to-indigo-500 flex items-center justify-center shadow-md shadow-indigo-200 flex-shrink-0">
                                <i class="fas fa-users text-white text-sm"></i>
                            </div>
                            <div>
                                <h2 class="text-sm font-bold text-slate-800">Enrolled Students</h2>
                                <p class="text-xs text-slate-400"><%= students.length %> student<%= students.length !== 1 ? 's' : '' %> in this class</p>
                            </div>
                        </div>

                        <!-- Controls row -->
                        <div class="flex flex-wrap items-center gap-2">
                            <!-- Search -->
                            <div class="relative">
                                <i class="fas fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                <input type="text" id="studentSearch" class="search-input" placeholder="Search students...">
                            </div>

                            <!-- Sort buttons -->
                            <button class="sort-btn active" id="sortName" onclick="sortTable('name')">
                                <i class="fas fa-arrow-down-a-z text-xs"></i> Name
                            </button>
                            <button class="sort-btn" id="sortExp" onclick="sortTable('exp')">
                                <i class="fas fa-star text-xs"></i> EXP
                            </button>
                            <button class="sort-btn" id="sortProgress" onclick="sortTable('progress')">
                                <i class="fas fa-chart-line text-xs"></i> Progress
                            </button>

                            <!-- Export -->
                            <button onclick="exportCSV()" class="sort-btn text-emerald-600 border-emerald-200 hover:bg-emerald-50 hover:border-emerald-400">
                                <i class="fas fa-file-csv text-xs"></i> Export
                            </button>
                        </div>
                    </div>

                    <!-- Summary stat strip -->
                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-slate-100 border-b border-slate-100">
                        <div class="bg-white px-5 py-4 text-center">
                            <p class="text-xl font-black text-indigo-700"><%= students.length %></p>
                            <p class="text-xs text-slate-400 font-semibold mt-0.5">Total Students</p>
                        </div>
                        <div class="bg-white px-5 py-4 text-center">
                            <p class="text-xl font-black text-cyan-600" id="avgProgress">—</p>
                            <p class="text-xs text-slate-400 font-semibold mt-0.5">Avg. Progress</p>
                        </div>
                        <div class="bg-white px-5 py-4 text-center">
                            <p class="text-xl font-black text-amber-500" id="avgExp">—</p>
                            <p class="text-xs text-slate-400 font-semibold mt-0.5">Avg. Total EXP</p>
                        </div>
                        <div class="bg-white px-5 py-4 text-center">
                            <p class="text-xl font-black text-emerald-600" id="completeCount">—</p>
                            <p class="text-xs text-slate-400 font-semibold mt-0.5">100% Complete</p>
                        </div>
                    </div>

                    <!-- Table (horizontal scroll on small screens) -->
                    <div class="overflow-x-auto">
                        <table class="roster-table" id="rosterTable">
                            <thead>
                                <tr>
                                    <th class="text-left pl-5" style="width:40px">#</th>
                                    <th class="text-left" style="min-width:200px">Student</th>
                                    <th class="text-left" style="min-width:130px">LRN</th>
                                    <th class="text-left" style="min-width:130px">Grade / Section</th>
                                    <th class="text-center" style="min-width:110px">Total EXP</th>
                                    <th class="text-left" style="min-width:170px">Progress</th>
                                    <th class="text-left" style="min-width:130px">Last Accessed</th>
                                    <th class="text-center pr-5" style="min-width:90px">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="rosterBody">

                                <% students.forEach(function(student, index) { %>
                                <%
                                    var prog = parseInt(student.progress_percent) || 0;

                                    /* Progress colour thresholds */
                                    var progColor;
                                    if      (prog >= 80) { progColor = '#10b981'; }
                                    else if (prog >= 50) { progColor = '#06b6d4'; }
                                    else if (prog >= 25) { progColor = '#f59e0b'; }
                                    else                 { progColor = '#ef4444'; }

                                    /* Last accessed */
                                    var lastAccessedStr = 'Never';
                                    if (student.last_accessed) {
                                        var d = new Date(student.last_accessed);
                                        lastAccessedStr = d.toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' });
                                    }

                                    /* Total EXP — sum passed from backend query */
                                    var totalExp = parseInt(student.total_exp) || 0;
                                %>
                                <tr class="fade-row"
                                    style="animation-delay: <%= index * 35 %>ms"
                                    data-name="<%= (student.first_name + ' ' + student.last_name).toLowerCase() %>"
                                    data-exp="<%= totalExp %>"
                                    data-progress="<%= prog %>">

                                    <!-- Row number -->
                                    <td class="pl-5 text-slate-400 font-bold text-xs"><%= index + 1 %></td>

                                    <!-- Student name + avatar -->
                                    <td>
                                        <div class="flex items-center gap-3">
                                            <img src="/profile_uploads/<%= student.profile_pic || 'default_avatar.png' %>"
                                                 class="avatar-ring"
                                                 alt="<%= student.first_name %>"
                                                 onerror="this.src='/profile_uploads/default_avatar.png'">
                                            <div>
                                                <p class="font-bold text-slate-800 text-sm leading-tight">
                                                    <%= student.last_name %>, <%= student.first_name %>
                                                    <% if (student.middle_name) { %><%= student.middle_name.charAt(0) %>.<% } %>
                                                </p>
                                                <p class="text-xs text-slate-400 mt-0.5">
                                                    Lvl <span class="font-bold text-indigo-500"><%= student.current_level || 1 %></span>
                                                </p>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- LRN -->
                                    <td><span class="lrn-mono"><%= student.lrn_number || '—' %></span></td>

                                    <!-- Grade / Section -->
                                    <td>
                                        <div class="flex flex-col gap-0.5">
                                            <span class="text-xs font-bold text-slate-700"><%= student.grade_level || '—' %></span>
                                            <span class="text-xs text-slate-400"><%= student.section || '—' %></span>
                                        </div>
                                    </td>

                                    <!-- Total EXP -->
                                    <td class="text-center">
                                        <span class="exp-badge">
                                            <i class="fas fa-star text-amber-500" style="font-size:9px"></i>
                                            <%= totalExp.toLocaleString() %>
                                        </span>
                                    </td>

                                    <!-- Progress bar -->
                                    <td>
                                        <div class="flex items-center gap-2">
                                            <div class="prog-track flex-1">
                                                <div class="prog-fill" style="width:<%= prog %>%; background:<%= progColor %>;"></div>
                                            </div>
                                            <span class="text-xs font-black w-9 text-right flex-shrink-0"
                                                  style="color:<%= progColor %>">
                                                <%= prog %>%
                                            </span>
                                        </div>
                                    </td>

                                    <!-- Last accessed -->
                                    <td>
                                        <% if (student.last_accessed) { %>
                                        <span class="text-xs text-slate-500">
                                            <i class="far fa-clock text-slate-300 mr-1"></i><%= lastAccessedStr %>
                                        </span>
                                        <% } else { %>
                                        <span class="text-xs text-slate-300 italic">Never</span>
                                        <% } %>
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center pr-5">
                                        <div class="flex items-center justify-center gap-1">
                                            <a href="/teacher/student/<%= student.user_id %>/scores?subject=<%= subject.subject_id %>"
                                               title="View scores"
                                               class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:bg-cyan-50 hover:text-cyan-600 transition">
                                                <i class="fas fa-chart-bar text-xs"></i>
                                            </a>
                                            <a href="/teacher/messages/new?to=<%= student.user_id %>"
                                               title="Send message"
                                               class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:bg-indigo-50 hover:text-indigo-600 transition">
                                                <i class="fas fa-envelope text-xs"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>

                                <!-- Empty search state -->
                                <tr id="emptyRow" class="hidden">
                                    <td colspan="8" class="text-center py-16">
                                        <div class="flex flex-col items-center gap-3">
                                            <div class="w-14 h-14 rounded-full bg-slate-100 flex items-center justify-center">
                                                <i class="fas fa-user-slash text-slate-300 text-xl"></i>
                                            </div>
                                            <p class="text-slate-400 font-semibold text-sm">No students match your search.</p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Table footer -->
                    <div class="px-5 py-3 border-t border-slate-100 flex items-center justify-between">
                        <p class="text-xs text-slate-400" id="rowCount">
                            Showing <strong><%= students.length %></strong> students
                        </p>
                        <p class="text-xs text-slate-300">
                            Class: <span class="font-semibold text-slate-400"><%= classInfo.class_name %></span>
                        </p>
                    </div>
                </div>


                <!-- ============================================================
                    SECTION 3 · CONTENT MANAGEMENT
                ============================================================ -->
                <div class="section-card mb-6" id="contentMgmtSection">

                    <!-- Card header -->
                    <div class="section-header">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-violet-400 to-indigo-600 flex items-center justify-center shadow-md shadow-indigo-200 flex-shrink-0">
                                <i class="fas fa-layer-group text-white text-sm"></i>
                            </div>
                            <div>
                                <h2 class="text-sm font-bold text-slate-800">Content Management</h2>
                                <p class="text-xs text-slate-400">Quarters · Topics · Materials · Assessments · Announcements · Forums</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <div class="relative">
                                <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                <input type="text" id="cmSearch" class="content-search" placeholder="Search topics…"
                                    oninput="cmSearchTopics(this.value)">
                            </div>
                            <span class="text-xs text-slate-400 font-semibold">
                                <i class="fas fa-circle-info text-slate-300 mr-1"></i>
                                Locking a quarter locks everything inside it
                            </span>
                        </div>
                    </div>

                    <!-- Quarters accordion -->
                    <div id="quartersContainer" class="divide-y divide-slate-100 p-4 space-y-3">

                        <% quarters.forEach(function(quarter) { %>
                        <%
                            var qLocked = quarter.is_locked == 1;
                        %>

                        <div class="quarter-block" id="quarter-block-<%= quarter.quarter_id %>">

                            <!-- Quarter header row -->
                            <div class="quarter-header" onclick="toggleQuarter(<%= quarter.quarter_id %>)">

                                <div class="flex items-center gap-3 flex-1 min-w-0">
                                    <!-- Chevron -->
                                    <i class="fas fa-chevron-right text-slate-400 text-xs chevron-icon"
                                    id="chevron-q-<%= quarter.quarter_id %>"></i>

                                    <!-- Lock button -->
                                    <button class="lock-btn <%= qLocked ? 'locked' : 'unlocked' %>"
                                            id="qlock-<%= quarter.quarter_id %>"
                                            title="<%= qLocked ? 'Unlock quarter' : 'Lock quarter' %>"
                                            onclick="event.stopPropagation(); toggleQuarterLock(<%= quarter.quarter_id %>, <%= qLocked ? 1 : 0 %>)">
                                        <i class="fas fa-<%= qLocked ? 'lock' : 'lock-open' %> text-xs"></i>
                                    </button>

                                    <!-- Quarter label -->
                                    <div>
                                        <p class="font-bold text-slate-700 text-sm">Quarter <%= quarter.quarter_number %></p>
                                        <p class="text-xs text-slate-400">
                                            <%= quarter.topics ? quarter.topics.length : 0 %> topic<%= (quarter.topics && quarter.topics.length !== 1) ? 's' : '' %>
                                            <% if (qLocked) { %><span class="ml-2 text-orange-500 font-semibold"><i class="fas fa-lock text-[10px]"></i> Locked</span><% } %>
                                        </p>
                                    </div>
                                </div>

                                <!-- Quarter actions -->
                                <div class="flex items-center gap-2" onclick="event.stopPropagation()">
                                    <button class="icon-btn" title="Add topic to this quarter"
                                            onclick="openTopicModal(null, <%= quarter.quarter_id %>)">
                                        <i class="fas fa-plus text-xs"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Quarter body (topics) -->
                            <div class="quarter-body" id="quarter-body-<%= quarter.quarter_id %>" style="display:none">

                                <!-- Topic search inside quarter -->
                                <div class="px-4 pt-3 pb-1">
                                    <div class="relative inline-block">
                                        <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                        <input type="text" placeholder="Search topics…"
                                            class="content-search"
                                            oninput="cmFilterTopics(this.value, <%= quarter.quarter_id %>)">
                                    </div>
                                </div>

                                <% if (quarter.topics && quarter.topics.length > 0) { %>
                                    <% quarter.topics.forEach(function(topic) { %>
                                    <%
                                        var tLocked = qLocked || (topic.is_locked == 1);
                                    %>

                                    <div class="topic-row" id="topic-row-<%= topic.topic_id %>"
                                        data-topic-name="<%= topic.topic_name.toLowerCase() %>"
                                        data-quarter="<%= quarter.quarter_id %>">

                                        <!-- Topic main row -->
                                        <div class="topic-inner">
                                            <div class="flex items-center gap-3 flex-1 min-w-0">

                                                <!-- Expand chevron -->
                                                <button class="icon-btn" onclick="toggleTopicPanel(<%= topic.topic_id %>)">
                                                    <i class="fas fa-chevron-right text-xs chevron-icon" id="chevron-t-<%= topic.topic_id %>"></i>
                                                </button>

                                                <!-- Topic lock -->
                                                <button class="lock-btn <%= tLocked ? 'locked' : 'unlocked' %>"
                                                        id="tlock-<%= topic.topic_id %>"
                                                        title="<%= tLocked ? 'Unlock topic' : 'Lock topic' %>"
                                                        <%= qLocked ? 'disabled style="opacity:0.4;cursor:not-allowed"' : '' %>
                                                        onclick="toggleTopicLock(<%= topic.topic_id %>, <%= (topic.is_locked == 1) ? 1 : 0 %>)">
                                                    <i class="fas fa-<%= tLocked ? 'lock' : 'lock-open' %> text-xs"></i>
                                                </button>

                                                <!-- Topic name -->
                                                <div class="min-w-0">
                                                    <p class="font-semibold text-slate-700 text-sm truncate"><%= topic.topic_name %></p>
                                                    <p class="text-xs text-slate-400">
                                                        Theme: <span class="font-semibold"><%= topic.theme_id || 'default_lab' %></span>
                                                        <% if (tLocked) { %><span class="ml-2 text-orange-500 font-semibold"><i class="fas fa-lock text-[10px]"></i> Locked</span><% } %>
                                                    </p>
                                                </div>
                                            </div>

                                            <!-- Topic actions -->
                                            <div class="flex items-center gap-1 flex-shrink-0">
                                                <button class="icon-btn" title="Edit topic"
                                                        onclick="openTopicModal(<%= topic.topic_id %>, <%= quarter.quarter_id %>, '<%= topic.topic_name.replace(/'/g,"\\'") %>', '<%= topic.theme_id || 'default_lab' %>')">
                                                    <i class="fas fa-pen text-xs"></i>
                                                </button>
                                                <button class="icon-btn danger" title="Delete topic"
                                                        onclick="confirmDelete('topic', <%= topic.topic_id %>, '<%= topic.topic_name.replace(/'/g,"\\'") %>')">
                                                    <i class="fas fa-trash text-xs"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- ---- Topic expandable panel ---- -->
                                        <div class="topic-panel" id="panel-<%= topic.topic_id %>">

                                            <!-- Tab bar -->
                                            <div class="panel-tabs">
                                                <button class="panel-tab active"
                                                        onclick="switchTab(<%= topic.topic_id %>, 'materials', this)">
                                                    <i class="fas fa-folder-open text-[10px]"></i> Materials
                                                </button>
                                                <button class="panel-tab"
                                                        onclick="switchTab(<%= topic.topic_id %>, 'assessments', this)">
                                                    <i class="fas fa-clipboard-list text-[10px]"></i> Assessments
                                                </button>
                                                <button class="panel-tab"
                                                        onclick="switchTab(<%= topic.topic_id %>, 'announcements', this)">
                                                    <i class="fas fa-bullhorn text-[10px]"></i> Announcements
                                                </button>
                                                <button class="panel-tab"
                                                        onclick="switchTab(<%= topic.topic_id %>, 'forums', this)">
                                                    <i class="fas fa-comments text-[10px]"></i> Forums
                                                </button>
                                            </div>

                                            <!-- ====== TAB: MATERIALS ====== -->
                                            <div class="tab-content" id="tab-<%= topic.topic_id %>-materials">
                                                <div class="flex items-center justify-between mb-2">
                                                    <div class="relative">
                                                        <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                                        <input type="text" placeholder="Search materials…" class="content-search"
                                                            oninput="filterSubTable(this.value, 'mat-table-<%= topic.topic_id %>')">
                                                    </div>
                                                    <button class="add-row-btn" onclick="openMaterialModal(null, <%= topic.topic_id %>)">
                                                        <i class="fas fa-plus text-xs"></i> Add Material
                                                    </button>
                                                </div>
                                                <table class="sub-table" id="mat-table-<%= topic.topic_id %>">
                                                    <thead>
                                                        <tr>
                                                            <th style="width:30px">#</th>
                                                            <th>Title</th>
                                                            <th>Type</th>
                                                            <th>Access</th>
                                                            <th style="width:70px">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    <% if (topic.materials && topic.materials.length > 0) { %>
                                                        <% topic.materials.forEach(function(mat, mi) { %>
                                                        <tr data-search="<%= mat.title.toLowerCase() %>">
                                                            <td class="text-slate-400 font-bold"><%= mi + 1 %></td>
                                                            <td>
                                                                <a href="<%= mat.file_path_or_url %>" target="_blank"
                                                                class="font-semibold text-indigo-600 hover:underline truncate block max-w-[200px]">
                                                                    <%= mat.title %>
                                                                </a>
                                                            </td>
                                                            <td>
                                                                <span class="badge-type type-<%= mat.material_type %>">
                                                                    <i class="fas fa-<%= mat.material_type === 'pdf' ? 'file-pdf' : mat.material_type === 'word' ? 'file-word' : mat.material_type === 'video' ? 'video' : mat.material_type === 'link' ? 'link' : mat.material_type === 'img' ? 'image' : 'file-powerpoint' %> text-[9px]"></i>
                                                                    <%= mat.material_type %>
                                                                </span>
                                                            </td>
                                                            <td>
                                                                <button class="lock-btn <%= mat.is_locked ? 'locked' : 'unlocked' %>"
                                                                        style="width:26px;height:26px"
                                                                        onclick="toggleMaterialLock(<%= mat.material_id %>, <%= mat.is_locked ? 1 : 0 %>, this)">
                                                                    <i class="fas fa-<%= mat.is_locked ? 'lock' : 'lock-open' %> text-xs"></i>
                                                                </button>
                                                            </td>
                                                            <td>
                                                                <div class="flex gap-1">
                                                                    <button class="icon-btn" title="Edit"
                                                                            onclick="openMaterialModal(<%= mat.material_id %>, <%= topic.topic_id %>, '<%= mat.title.replace(/'/g,"\\'") %>', '<%= mat.material_type %>', '<%= mat.file_path_or_url.replace(/'/g,"\\'") %>')">
                                                                        <i class="fas fa-pen text-xs"></i>
                                                                    </button>
                                                                    <button class="icon-btn danger" title="Delete"
                                                                            onclick="confirmDelete('material', <%= mat.material_id %>, '<%= mat.title.replace(/'/g,"\\'") %>')">
                                                                        <i class="fas fa-trash text-xs"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <tr><td colspan="5" class="empty-sub">No materials yet. Click + Add Material to upload one.</td></tr>
                                                    <% } %>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <!-- ====== TAB: ASSESSMENTS ====== -->
                                            <div class="tab-content hidden" id="tab-<%= topic.topic_id %>-assessments">
                                                <div class="flex items-center justify-between mb-2">
                                                    <div class="relative">
                                                        <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                                        <input type="text" placeholder="Search assessments…" class="content-search"
                                                            oninput="filterSubTable(this.value, 'asmt-table-<%= topic.topic_id %>')">
                                                    </div>
                                                    <button class="add-row-btn" onclick="goToAssessmentPage(null, <%= topic.topic_id %>, <%= quarter.quarter_id %>)">
                                                        <i class="fas fa-plus text-xs"></i> Add Assessment
                                                    </button>
                                                </div>
                                                <table class="sub-table" id="asmt-table-<%= topic.topic_id %>">
                                                    <thead>
                                                        <tr>
                                                            <th style="width:30px">#</th>
                                                            <th>Name</th>
                                                            <th>Type</th>
                                                            <th>Items</th>
                                                            <th>Due Date</th>
                                                            <th>Unlocked</th>
                                                            <th style="width:70px">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    <% if (topic.assessments && topic.assessments.length > 0) { %>
                                                        <% topic.assessments.forEach(function(asmt, ai) { %>
                                                        <%
                                                            var aTypeClass = asmt.assessment_type === 'Pre-Test' ? 'atype-pre' :
                                                                            asmt.assessment_type === 'Post-Test' ? 'atype-post' :
                                                                            asmt.assessment_type === 'Quiz' ? 'atype-quiz' : 'atype-comp';
                                                            var dueStr = asmt.due_date ? new Date(asmt.due_date).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—';
                                                        %>
                                                        <tr data-search="<%= asmt.assessment_name.toLowerCase() %>">
                                                            <td class="text-slate-400 font-bold"><%= ai + 1 %></td>
                                                            <td class="font-semibold text-slate-700"><%= asmt.assessment_name %></td>
                                                            <td><span class="badge-type <%= aTypeClass %>"><%= asmt.assessment_type %></span></td>
                                                            <td class="text-center"><%= asmt.total_items %></td>
                                                            <td class="text-slate-500"><%= dueStr %></td>
                                                            <td>
                                                                <button class="lock-btn <%= asmt.is_unlocked ? 'unlocked' : 'locked' %>"
                                                                        style="width:26px;height:26px"
                                                                        title="<%= asmt.is_unlocked ? 'Lock assessment' : 'Unlock assessment' %>"
                                                                        onclick="toggleAssessmentLock(<%= asmt.assessment_id %>, <%= asmt.is_unlocked ? 1 : 0 %>, this)">
                                                                    <i class="fas fa-<%= asmt.is_unlocked ? 'lock-open' : 'lock' %> text-xs"></i>
                                                                </button>
                                                            </td>
                                                            <td>
                                                                <div class="flex gap-1">
                                                                    <button class="icon-btn" title="Edit"
                                                                            onclick="goToAssessmentPage(<%= asmt.assessment_id %>, <%= topic.topic_id %>, <%= quarter.quarter_id %>)">
                                                                        <i class="fas fa-pen text-xs"></i>
                                                                    </button>

                                                                    <button class="icon-btn danger" title="Delete"
                                                                            onclick="confirmDelete('assessment', <%= asmt.assessment_id %>, '<%= asmt.assessment_name.replace(/'/g,"\\'") %>')">
                                                                        <i class="fas fa-trash text-xs"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <tr><td colspan="7" class="empty-sub">No assessments yet. Click + Add Assessment to create one.</td></tr>
                                                    <% } %>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <!-- ====== TAB: ANNOUNCEMENTS ====== -->
                                            <div class="tab-content hidden" id="tab-<%= topic.topic_id %>-announcements">
                                                <div class="flex items-center justify-between mb-2">
                                                    <div class="relative">
                                                        <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                                        <input type="text" placeholder="Search announcements…" class="content-search"
                                                            oninput="filterSubTable(this.value, 'ann-table-<%= topic.topic_id %>')">
                                                    </div>
                                                    <button class="add-row-btn" onclick="openAnnouncementModal(null, <%= topic.topic_id %>, <%= classInfo.class_id %>)">
                                                        <i class="fas fa-plus text-xs"></i> Add Announcement
                                                    </button>
                                                </div>
                                                <table class="sub-table" id="ann-table-<%= topic.topic_id %>">
                                                    <thead>
                                                        <tr>
                                                            <th style="width:30px">#</th>
                                                            <th>Title</th>
                                                            <th>Priority</th>
                                                            <th>Posted</th>
                                                            <th style="width:80px">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    <% if (topic.announcements && topic.announcements.length > 0) { %>
                                                        <% topic.announcements.forEach(function(ann, ni) { %>
                                                        <%
                                                            var annDate = ann.created_at ? new Date(ann.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—';
                                                        %>
                                                        <tr data-search="<%= ann.title.toLowerCase() %>">
                                                            <td class="text-slate-400 font-bold"><%= ni + 1 %></td>
                                                            <td class="font-semibold text-slate-700 max-w-[200px] truncate"><%= ann.title %></td>
                                                            <td>
                                                                <button class="icon-btn <%= ann.is_priority ? 'warn' : '' %>"
                                                                        title="<%= ann.is_priority ? 'Remove priority' : 'Set as priority' %>"
                                                                        onclick="toggleAnnouncementPriority(<%= ann.announcement_id %>, <%= ann.is_priority ? 1 : 0 %>)"
                                                                        id="ann-prio-<%= ann.announcement_id %>">
                                                                    <i class="fas fa-flag text-xs <%= ann.is_priority ? 'text-amber-500' : 'text-slate-300' %>"></i>
                                                                </button>
                                                                <% if (ann.is_priority) { %>
                                                                <span class="badge-priority ml-1"><i class="fas fa-flag text-[9px]"></i> Priority</span>
                                                                <% } %>
                                                            </td>
                                                            <td class="text-slate-500 text-xs"><%= annDate %></td>
                                                            <td>
                                                                <div class="flex gap-1">
                                                                    <button class="icon-btn" title="Edit"
                                                                            onclick="openAnnouncementModal(<%= ann.announcement_id %>, <%= topic.topic_id %>, <%= classInfo.class_id %>, '<%= ann.title.replace(/'/g,"\\'") %>', '<%= (ann.content || '').replace(/'/g,"\\'").replace(/\n/g,' ') %>', <%= ann.is_priority ? 1 : 0 %>)">
                                                                        <i class="fas fa-pen text-xs"></i>
                                                                    </button>
                                                                    <button class="icon-btn danger" title="Delete"
                                                                            onclick="confirmDelete('announcement', <%= ann.announcement_id %>, '<%= ann.title.replace(/'/g,"\\'") %>')">
                                                                        <i class="fas fa-trash text-xs"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <tr><td colspan="5" class="empty-sub">No announcements yet. Click + Add Announcement to post one.</td></tr>
                                                    <% } %>
                                                    </tbody>
                                                </table>
                                            </div>

                                            <!-- ====== TAB: FORUMS ====== -->
                                            <div class="tab-content hidden" id="tab-<%= topic.topic_id %>-forums">
                                                <div class="flex items-center justify-between mb-2">
                                                    <div class="relative">
                                                        <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                                        <input type="text" placeholder="Search forums…" class="content-search"
                                                            oninput="filterSubTable(this.value, 'forum-table-<%= topic.topic_id %>')">
                                                    </div>
                                                    <button class="add-row-btn" onclick="openForumModal(null, <%= topic.topic_id %>, <%= subject.subject_id %>)">
                                                        <i class="fas fa-plus text-xs"></i> Add Forum
                                                    </button>
                                                </div>
                                                <table class="sub-table" id="forum-table-<%= topic.topic_id %>">
                                                    <thead>
                                                        <tr>
                                                            <th style="width:30px">#</th>
                                                            <th>Title</th>
                                                            <th>Pinned</th>
                                                            <th>Posted</th>
                                                            <th style="width:80px">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    <% if (topic.forums && topic.forums.length > 0) { %>
                                                        <% topic.forums.forEach(function(forum, fi) { %>
                                                        <%
                                                            var forumDate = forum.created_at ? new Date(forum.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—';
                                                        %>
                                                        <tr data-search="<%= forum.title.toLowerCase() %>">
                                                            <td class="text-slate-400 font-bold"><%= fi + 1 %></td>
                                                            <td class="font-semibold text-slate-700 max-w-[200px] truncate"><%= forum.title %></td>
                                                            <td>
                                                                <button class="icon-btn <%= forum.is_pinned ? '' : '' %>"
                                                                        title="<%= forum.is_pinned ? 'Unpin' : 'Pin' %>"
                                                                        onclick="toggleForumPin(<%= forum.forum_id %>, <%= forum.is_pinned ? 1 : 0 %>)"
                                                                        id="forum-pin-<%= forum.forum_id %>">
                                                                    <i class="fas fa-thumbtack text-xs <%= forum.is_pinned ? 'text-indigo-500' : 'text-slate-300' %>"></i>
                                                                </button>
                                                                <% if (forum.is_pinned) { %>
                                                                <span class="badge-pinned ml-1"><i class="fas fa-thumbtack text-[9px]"></i> Pinned</span>
                                                                <% } %>
                                                            </td>
                                                            <td class="text-slate-500 text-xs"><%= forumDate %></td>
                                                            <td>
                                                                <div class="flex gap-1">
                                                                    <button class="icon-btn" title="Edit"
                                                                            onclick="openForumModal(<%= forum.forum_id %>, <%= topic.topic_id %>, <%= subject.subject_id %>, '<%= forum.title.replace(/'/g,"\\'") %>', '<%= (forum.forum_content || '').replace(/'/g,"\\'").replace(/\n/g,' ') %>')">
                                                                        <i class="fas fa-pen text-xs"></i>
                                                                    </button>
                                                                    <button class="icon-btn danger" title="Delete"
                                                                            onclick="confirmDelete('forum', <%= forum.forum_id %>, '<%= forum.title.replace(/'/g,"\\'") %>')">
                                                                        <i class="fas fa-trash text-xs"></i>
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <tr><td colspan="5" class="empty-sub">No forums yet. Click + Add Forum to create a thread.</td></tr>
                                                    <% } %>
                                                    </tbody>
                                                </table>
                                            </div>

                                        </div>
                                        <!-- /topic-panel -->
                                    </div>
                                    <!-- /topic-row -->
                                    <% }); %>

                                <% } else { %>
                                    <div class="empty-sub py-8">No topics yet. Click <strong>+</strong> on the quarter to add one.</div>
                                <% } %>

                            </div>
                            <!-- /quarter-body -->
                        </div>
                        <!-- /quarter-block -->

                        <% }); %>
                    </div>
                    <!-- /quartersContainer -->
                </div>
                <!-- END SECTION 3 · CONTENT MANAGEMENT -->


                <!-- ============================================================
                    SECTION 4 · SCORES & PERFORMANCE ANALYTICS
                ============================================================ -->
                <div class="section-card mb-6" id="analyticsSection">
                
                    <!-- Card header -->
                    <div class="section-header" onclick="toggleAnalyticsSection()" style="cursor:pointer;user-select:none;">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center shadow-md shadow-indigo-200 flex-shrink-0">
                                <i class="fas fa-chart-bar text-white text-sm"></i>
                            </div>
                            <div>
                                <h2 class="text-sm font-bold text-slate-800">Scores &amp; Performance Analytics</h2>
                                <p class="text-xs text-slate-400">Scores · Breakdown · Matches · Leaderboard · Live Sessions · Flags</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <i class="fas fa-chevron-down text-slate-400 text-xs chevron-icon open" id="chevron-analytics" style="transition:transform 0.2s;"></i>
                            <!-- Tab bar -->
                            <div class="analytics-tabs" id="analyticsTabs" onclick="event.stopPropagation()">
                                <button class="analytics-tab active" onclick="switchAnalyticsTab('scores',this)">
                                    <i class="fas fa-table-list text-[10px]"></i> Scores
                                </button>
                                <button class="analytics-tab" onclick="switchAnalyticsTab('breakdown',this)">
                                    <i class="fas fa-microscope text-[10px]"></i> Question Breakdown
                                </button>
                                <button class="analytics-tab" onclick="switchAnalyticsTab('matches',this)">
                                    <i class="fas fa-swords text-[10px]"></i> Matches
                                </button>
                                <button class="analytics-tab" onclick="switchAnalyticsTab('leaderboard',this)">
                                    <i class="fas fa-trophy text-[10px]"></i> Leaderboard
                                </button>
                                <button class="analytics-tab" onclick="switchAnalyticsTab('live',this)">
                                    <i class="fas fa-signal text-[10px]"></i> Live Sessions
                                </button>
                                <button class="analytics-tab" onclick="switchAnalyticsTab('flags',this)">
                                    <i class="fas fa-flag text-[10px]"></i> Flags
                                    <% var flagCount = students.filter(function(s){ return s.flagged_assessment_id; }).length; %>
                                    <% if (flagCount > 0) { %>
                                    <span style="background:#ef4444;color:white;border-radius:9999px;padding:0 6px;font-size:10px;font-weight:800;margin-left:2px"><%= flagCount %></span>
                                    <% } %>
                                </button>
                            </div>
                        </div>
                    </div>

                    <div id="analytics-body">
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 1 · SCORE SUMMARY TABLE
                    ══════════════════════════════════════════════════════ -->
                    <div class="analytics-panel active" id="apanel-scores">
                
                        <!-- Filter bar -->
                        <div class="score-filter-bar">
                            <div class="flex items-center gap-2">
                                <label class="text-xs font-semibold text-slate-500">Quarter</label>
                                <select class="filter-select" id="scoreFilterQuarter" onchange="filterScoreTable()">
                                    <option value="">All Quarters</option>
                                    <% quarters.forEach(function(q){ %>
                                    <option value="<%= q.quarter_id %>">Quarter <%= q.quarter_number %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-xs font-semibold text-slate-500">Type</label>
                                <select class="filter-select" id="scoreFilterType" onchange="filterScoreTable()">
                                    <option value="">All Types</option>
                                    <option value="Pre-Test">Pre-Test</option>
                                    <option value="Post-Test">Post-Test</option>
                                    <option value="Quiz">Quiz</option>
                                    <option value="Competitive">Competitive</option>
                                </select>
                            </div>
                            <div class="relative ml-auto">
                                <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                <input type="text" id="scoreSearch" class="content-search" placeholder="Search student…" oninput="filterScoreTable()">
                            </div>
                        </div>
                
                        <!-- Score table -->
                        <div class="overflow-x-auto">
                            <table class="score-table" id="scoreTable">
                                <thead>
                                    <tr>
                                        <th style="min-width:160px">Student</th>
                                        <th style="min-width:160px">Assessment</th>
                                        <th>Type</th>
                                        <th>Quarter</th>
                                        <th style="min-width:130px">Score</th>
                                        <th style="min-width:90px">EXP Gained</th>
                                        <th>Date</th>
                                    </tr>
                                </thead>
                                <tbody id="scoreTableBody">
                                <% if (typeof scores !== 'undefined' && scores.length > 0) { %>
                                    <% scores.forEach(function(row) { %>
                                    <%
                                        var pct = Math.round((row.score_obtained / row.total_items) * 100);
                                        var barColor = pct >= 75 ? '#10b981' : pct >= 50 ? '#06b6d4' : pct >= 25 ? '#f59e0b' : '#ef4444';
                                        var typeClass = row.assessment_type === 'Pre-Test' ? 'atype-pre' : row.assessment_type === 'Post-Test' ? 'atype-post' : row.assessment_type === 'Quiz' ? 'atype-quiz' : 'atype-comp';
                                        var dateStr = row.date_recorded ? new Date(row.date_recorded).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—';
                                    %>
                                    <tr data-student="<%= (row.first_name+' '+row.last_name).toLowerCase() %>"
                                        data-type="<%= row.assessment_type %>"
                                        data-quarter="<%= row.quarter_id %>">
                                        <td>
                                            <div class="flex items-center gap-2">
                                                <img src="/profile_uploads/<%= row.profile_pic || 'default_avatar.png' %>"
                                                    style="width:28px;height:28px;border-radius:7px;object-fit:cover;border:1.5px solid #e0f2fe;flex-shrink:0"
                                                    onerror="this.src='/profile_uploads/default_avatar.png'">
                                                <span class="font-semibold text-slate-700 text-xs"><%= row.last_name %>, <%= row.first_name %></span>
                                            </div>
                                        </td>
                                        <td class="font-semibold text-slate-700 text-xs max-w-[160px] truncate"><%= row.assessment_name %></td>
                                        <td><span class="badge-type <%= typeClass %>"><%= row.assessment_type %></span></td>
                                        <td class="text-xs text-slate-500">Q<%= row.quarter_number || '—' %></td>
                                        <td>
                                            <div class="score-bar-wrap">
                                                <div class="score-bar-track">
                                                    <div class="score-bar-fill" style="width:<%= pct %>%;background:<%= barColor %>"></div>
                                                </div>
                                                <span class="text-xs font-bold flex-shrink-0" style="color:<%= barColor %>"><%= row.score_obtained %>/<%= row.total_items %></span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="exp-badge">
                                                <i class="fas fa-star text-amber-500" style="font-size:9px"></i>
                                                +<%= row.exp_gained %>
                                            </span>
                                        </td>
                                        <td class="text-xs text-slate-400"><%= dateStr %></td>
                                    </tr>
                                    <% }); %>
                                <% } else { %>
                                    <tr id="scoreEmptyRow"><td colspan="7" class="no-data-state">No score records yet for this class.</td></tr>
                                <% } %>
                                </tbody>
                            </table>
                        </div>
                        <div class="px-4 py-2 border-t border-slate-50 flex items-center justify-between">
                            <p class="text-xs text-slate-400" id="scoreCount">
                                <% if (typeof scores !== 'undefined') { %>Showing <strong><%= scores.length %></strong> records<% } %>
                            </p>
                        </div>
                    </div>
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 2 · PER-QUESTION RESPONSE BREAKDOWN
                    ══════════════════════════════════════════════════════ -->
                    <div class="analytics-panel" id="apanel-breakdown">
                        <div class="p-5">
                            <label class="form-label">Select Assessment to Analyse</label>
                            <select class="breakdown-assessment-select" id="breakdownSelect" onchange="renderBreakdown(this.value)">
                                <option value="">— Choose an assessment —</option>
                                <% quarters.forEach(function(q){ %>
                                    <% (q.topics || []).forEach(function(t){ %>
                                        <% (t.assessments || []).forEach(function(a){ %>
                                        <option value="<%= a.assessment_id %>" data-name="<%= a.assessment_name %>">
                                            Q<%= q.quarter_number %> · <%= t.topic_name %> · <%= a.assessment_name %>
                                        </option>
                                        <% }); %>
                                    <% }); %>
                                <% }); %>
                            </select>
                
                            <div id="breakdownContainer">
                                <p class="no-data-state">Select an assessment above to view the question-by-question breakdown.</p>
                            </div>
                        </div>
                    </div>
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 3 · COMPETITIVE MATCH HISTORY
                    ══════════════════════════════════════════════════════ -->
                    <div class="analytics-panel" id="apanel-matches">
                        <div class="flex items-center justify-between px-5 pt-4 pb-3 border-b border-slate-50">
                            <p class="text-xs font-semibold text-slate-500">
                                <% var matchCount = (typeof competitiveMatches !== 'undefined') ? competitiveMatches.length : 0; %>
                                <%= matchCount %> match<%= matchCount !== 1 ? 'es' : '' %> recorded
                            </p>
                            <div class="relative">
                                <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                <input type="text" class="content-search" placeholder="Search player…" oninput="filterMatches(this.value)">
                            </div>
                        </div>
                
                        <div id="matchesList">
                        <% if (typeof competitiveMatches !== 'undefined' && competitiveMatches.length > 0) { %>
                            <% competitiveMatches.forEach(function(m) { %>
                            <%
                                var matchDate = m.match_date ? new Date(m.match_date).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—';
                                var p1Win = m.winner_id === m.p1_id;
                                var p2Win = m.winner_id === m.p2_id;
                            %>
                            <div class="match-row" data-players="<%= (m.p1_first+' '+m.p1_last+' '+m.p2_first+' '+m.p2_last).toLowerCase() %>">
                                <!-- P1 -->
                                <div class="match-player" style="text-align:right">
                                    <div class="match-player-name" style="<%= p1Win ? 'color:#059669;' : '' %>">
                                        <% if (p1Win) { %><i class="fas fa-crown text-amber-400 text-xs mr-1"></i><% } %>
                                        <%= m.p1_first %> <%= m.p1_last %>
                                    </div>
                                    <div class="match-player-score"><%= m.p1_score %> pts</div>
                                </div>
                                <div class="match-vs">VS</div>
                                <!-- P2 -->
                                <div class="match-player">
                                    <div class="match-player-name" style="<%= p2Win ? 'color:#059669;' : '' %>">
                                        <% if (p2Win) { %><i class="fas fa-crown text-amber-400 text-xs mr-1"></i><% } %>
                                        <%= m.p2_first %> <%= m.p2_last %>
                                    </div>
                                    <div class="match-player-score"><%= m.p2_score %> pts</div>
                                </div>
                                <!-- Meta -->
                                <div class="flex flex-col items-end gap-1 ml-auto flex-shrink-0">
                                    <span class="text-xs font-semibold text-indigo-500 truncate max-w-[130px]"><%= m.assessment_name || '—' %></span>
                                    <span class="match-date-chip"><i class="far fa-clock mr-1 text-slate-300"></i><%= matchDate %></span>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <p class="no-data-state">No competitive matches recorded yet.</p>
                        <% } %>
                        </div>
                    </div>
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 4 · LEADERBOARD & EXP SNAPSHOT
                    ══════════════════════════════════════════════════════ -->
                    <div class="analytics-panel" id="apanel-leaderboard">
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-0 divide-y md:divide-y-0 md:divide-x divide-slate-100">
                
                            <!-- Current rankings -->
                            <div>
                                <div class="px-5 pt-4 pb-2 border-b border-slate-50 flex items-center justify-between">
                                    <p class="text-xs font-bold text-slate-600"><i class="fas fa-trophy text-amber-400 mr-1"></i> Current EXP Rankings</p>
                                    <p class="text-xs text-slate-400"><%= students.length %> students</p>
                                </div>
                                <div>
                                <% var sorted = students.slice().sort(function(a,b){ return (b.total_exp||0)-(a.total_exp||0); }); %>
                                <% sorted.forEach(function(s, i){ %>
                                <div class="lb-row">
                                    <div class="lb-rank <%= i===0?'top1':i===1?'top2':i===2?'top3':'other' %>">
                                        <% if (i===0){ %><i class="fas fa-crown text-amber-500 text-xs"></i>
                                        <% } else if (i===1){ %><i class="fas fa-medal text-slate-400 text-xs"></i>
                                        <% } else if (i===2){ %><i class="fas fa-medal text-orange-400 text-xs"></i>
                                        <% } else { %><%= i+1 %><% } %>
                                    </div>
                                    <img src="/profile_uploads/<%= s.profile_pic || 'default_avatar.png' %>"
                                        class="lb-avatar" onerror="this.src='/profile_uploads/default_avatar.png'">
                                    <div class="lb-name"><%= s.last_name %>, <%= s.first_name %></div>
                                    <div class="lb-level">Lvl <strong class="text-indigo-500"><%= s.current_level||1 %></strong></div>
                                    <span class="lb-exp-badge">
                                        <i class="fas fa-star text-amber-500" style="font-size:9px"></i>
                                        <%= (s.total_exp||0).toLocaleString() %>
                                    </span>
                                </div>
                                <% }); %>
                                </div>
                            </div>
                
                            <!-- EXP history snapshots -->
                            <div>
                                <div class="px-5 pt-4 pb-2 border-b border-slate-50">
                                    <p class="text-xs font-bold text-slate-600"><i class="fas fa-clock-rotate-left text-indigo-400 mr-1"></i> Past Rank History</p>
                                    <p class="text-xs text-slate-400">Snapshots awarded by the system</p>
                                </div>
                                <div>
                                <% if (typeof leaderboardHistory !== 'undefined' && leaderboardHistory.length > 0) { %>
                                    <% leaderboardHistory.forEach(function(h){ %>
                                    <%
                                        var hDate = h.awarded_date ? new Date(h.awarded_date).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—';
                                    %>
                                    <div class="lb-hist-row">
                                        <div>
                                            <p class="font-semibold text-slate-700 text-xs"><%= h.first_name %> <%= h.last_name %></p>
                                            <p class="text-slate-400 text-xs"><%= hDate %></p>
                                        </div>
                                        <div class="text-right">
                                            <div class="flex items-center gap-2 justify-end">
                                                <span style="background:#e0e7ff;color:#3730a3;border-radius:9999px;padding:2px 8px;font-size:10px;font-weight:800">
                                                    Rank #<%= h.rank_achieved %>
                                                </span>
                                                <span class="lb-exp-badge" style="font-size:10px">
                                                    <i class="fas fa-star text-amber-500" style="font-size:8px"></i>
                                                    <%= (h.total_exp_snapshot||0).toLocaleString() %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                    <% }); %>
                                <% } else { %>
                                    <p class="no-data-state" style="padding:30px 0">No rank history snapshots yet.</p>
                                <% } %>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 5 · LIVE SESSION MONITOR
                    ══════════════════════════════════════════════════════ -->
                    <div class="analytics-panel" id="apanel-live">
                        <div class="flex items-center justify-between px-5 pt-4 pb-3 border-b border-slate-50">
                            <div class="flex items-center gap-2">
                                <div class="live-pulse"></div>
                                <p class="text-xs font-bold text-slate-600">Live Active Sessions</p>
                            </div>
                            <button class="refresh-btn" id="liveRefreshBtn" onclick="refreshLiveSessions()">
                                <i class="fas fa-rotate-right text-xs"></i> Refresh
                            </button>
                        </div>
                
                        <div id="liveSessionsList">
                        <% if (typeof activeSessions !== 'undefined' && activeSessions.length > 0) { %>
                            <% activeSessions.forEach(function(sess){ %>
                            <%
                                var totalItems = sess.total_items || 1;
                                var itemPct = Math.min(Math.round((sess.current_item_index / totalItems) * 100), 100);
                            %>
                            <div class="session-row" id="sess-row-<%= sess.session_id %>">
                                <div class="live-pulse"></div>
                                <img src="/profile_uploads/<%= sess.profile_pic || 'default_avatar.png' %>"
                                    style="width:32px;height:32px;border-radius:9px;object-fit:cover;border:2px solid #e0f2fe;flex-shrink:0"
                                    onerror="this.src='/profile_uploads/default_avatar.png'">
                                <div class="flex-1 min-w-0">
                                    <p class="font-semibold text-slate-700 text-xs"><%= sess.last_name %>, <%= sess.first_name %></p>
                                    <p class="text-slate-400 text-xs truncate"><%= sess.assessment_name || 'Unknown Assessment' %></p>
                                </div>
                                <span class="session-mode <%= sess.player_mode === 'Duel' ? 'mode-duel' : 'mode-single' %>">
                                    <%= sess.player_mode %>
                                </span>
                                <div class="session-progress">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-slate-500">Item <%= sess.current_item_index %>/<%= totalItems %></span>
                                        <span class="text-xs font-bold text-purple-600"><%= itemPct %>%</span>
                                    </div>
                                    <div class="session-item-bar">
                                        <div class="session-item-fill" style="width:<%= itemPct %>%"></div>
                                    </div>
                                </div>
                                <div class="text-right flex-shrink-0">
                                    <p class="text-xs font-black text-indigo-600"><%= sess.accumulated_score %> pts</p>
                                    <p class="text-xs text-slate-400">Score</p>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <div id="liveEmptyState" class="no-data-state py-10">
                                <i class="fas fa-circle-check text-emerald-300 text-2xl mb-2 block"></i>
                                No students are currently in an active session.
                            </div>
                        <% } %>
                        </div>
                    </div>
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 6 · FLAGGED ASSESSMENT ALERTS
                    ══════════════════════════════════════════════════════ -->
                    <div class="analytics-panel" id="apanel-flags">
                        <div class="px-5 pt-4 pb-2 border-b border-slate-50 flex items-center gap-2">
                            <i class="fas fa-triangle-exclamation text-rose-400 text-sm"></i>
                            <p class="text-xs font-bold text-slate-600">Students with Flagged Assessments</p>
                            <span style="background:#fee2e2;color:#b91c1c;border-radius:9999px;padding:1px 8px;font-size:11px;font-weight:800;margin-left:4px">
                                <%= students.filter(function(s){ return s.flagged_assessment_id; }).length %> flagged
                            </span>
                        </div>
                        <p class="text-xs text-slate-400 px-5 py-2 border-b border-slate-50">
                            A non-null <code class="bg-slate-100 px-1 rounded text-indigo-600">flagged assessment</code> may indicate students who have triggered an specific assessment but have not yet accessed via Arcade.
                        </p>
                
                        <% var flaggedStudents = students.filter(function(s){ return s.flagged_assessment_id; }); %>
                        <% if (flaggedStudents.length > 0) { %>
                            <% flaggedStudents.forEach(function(s){ %>
                            <%
                                var flaggedAssmt = null;
                                quarters.forEach(function(q){ (q.topics||[]).forEach(function(t){ (t.assessments||[]).forEach(function(a){ if(a.assessment_id == s.flagged_assessment_id) flaggedAssmt = a; }); }); });
                            %>
                            <div class="flag-row">
                                <img src="/profile_uploads/<%= s.profile_pic || 'default_avatar.png' %>"
                                    style="width:34px;height:34px;border-radius:9px;object-fit:cover;border:2px solid #fee2e2;flex-shrink:0"
                                    onerror="this.src='/profile_uploads/default_avatar.png'">
                                <div class="flex-1 min-w-0">
                                    <p class="font-bold text-slate-700 text-sm"><%= s.last_name %>, <%= s.first_name %></p>
                                    <p class="flag-assessment-name">
                                        Flagged on: <strong class="text-slate-600"><%= flaggedAssmt ? flaggedAssmt.assessment_name : 'Assessment ID #'+s.flagged_assessment_id %></strong>
                                    </p>
                                </div>
                                <span class="flag-badge">
                                    <i class="fas fa-flag text-xs"></i> Flagged
                                </span>
                                <a href="/teacher/student/<%= s.user_id %>/scores?subject=<%= subject.subject_id %>"
                                class="sort-btn text-xs" style="padding:5px 10px">
                                    <i class="fas fa-eye text-xs"></i> Review
                                </a>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <div class="no-data-state py-10">
                                <i class="fas fa-shield-check text-emerald-300 text-2xl mb-2 block"></i>
                                No students have flagged assessments. 
                            </div>
                        <% } %>
                    </div>

                    </div><!-- end analytics-body -->
                
                </div>
                <!-- END SECTION 4 · SCORES & ANALYTICS -->


                <!-- ============================================================
                    SECTION 5 · COMMUNICATION & COMMUNITY
                ============================================================ -->
                <div class="section-card mb-6" id="commSection">
                
                    <!-- Card header -->
                    <div class="section-header">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-400 to-teal-500 flex items-center justify-center shadow-md shadow-teal-200 flex-shrink-0">
                                <i class="fas fa-comments text-white text-sm"></i>
                            </div>
                            <div>
                                <h2 class="text-sm font-bold text-slate-800">Communication &amp; Community</h2>
                                <p class="text-xs text-slate-400">Announcements · Forums · Messaging · Completion Tracking</p>
                            </div>
                        </div>
                        <!-- Tab bar -->
                        <div class="comm-tabs" id="commTabs">
                            <button class="comm-tab active" onclick="switchCommTab('announcements', this)">
                                <i class="fas fa-bullhorn text-[10px]"></i> Announcements
                            </button>
                            <button class="comm-tab" onclick="switchCommTab('forums', this)">
                                <i class="fas fa-comments text-[10px]"></i> Forums
                            </button>
                            <button class="comm-tab" onclick="switchCommTab('messages', this)">
                                <i class="fas fa-envelope text-[10px]"></i> Messages
                            </button>
                            <button class="comm-tab" onclick="switchCommTab('completion', this)">
                                <i class="fas fa-clipboard-check text-[10px]"></i> Completion
                            </button>
                        </div>
                    </div>
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 1 · ANNOUNCEMENT COMPOSER & LIST
                    ══════════════════════════════════════════════════════ -->
                    <div class="comm-panel active" id="cpanel-announcements">
                
                        <!-- Filter + compose bar -->
                        <div class="comm-filter-bar">
                            <div class="relative">
                                <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                <input type="text" class="content-search" placeholder="Search announcements…"
                                    oninput="filterCommList(this.value, 'annList')">
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-xs font-semibold text-slate-500">Topic</label>
                                <select class="filter-select" id="annTopicFilter" onchange="filterCommList('', 'annList')">
                                    <option value="">All Topics</option>
                                    <% quarters.forEach(function(q){ %>
                                        <% (q.topics || []).forEach(function(t){ %>
                                        <option value="<%= t.topic_id %>"><%= t.topic_name %></option>
                                        <% }); %>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="flex items-center gap-2 ml-auto">
                                <label class="text-xs font-semibold text-slate-500">
                                    <input type="checkbox" id="annPrioOnly" class="accent-rose-500 mr-1" onchange="filterCommList('', 'annList')">
                                    Priority only
                                </label>
                                <button class="compose-btn primary" onclick="openCommModal('annModal')">
                                    <i class="fas fa-plus text-xs"></i> New Announcement
                                </button>
                            </div>
                        </div>
                
                        <!-- Announcement list -->
                        <div id="annList">
                        <%
                            /* Flatten all announcements from all topics into one list */
                            var allAnnouncements = [];
                            quarters.forEach(function(q){
                                (q.topics || []).forEach(function(t){
                                    (t.announcements || []).forEach(function(a){
                                        a._topic_name = t.topic_name;
                                        a._topic_id   = t.topic_id;
                                        allAnnouncements.push(a);
                                    });
                                });
                            });
                            /* Sort priority first, then by created_at desc */
                            allAnnouncements.sort(function(a,b){
                                if (b.is_priority !== a.is_priority) return b.is_priority - a.is_priority;
                                return new Date(b.created_at) - new Date(a.created_at);
                            });
                        %>
                
                        <% if (allAnnouncements.length > 0) { %>
                            <% allAnnouncements.forEach(function(ann){ %>
                            <%
                                var annDate = ann.created_at ? new Date(ann.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—';
                            %>
                            <div class="ann-item flex gap-3"
                                data-search="<%= ann.title.toLowerCase() %>"
                                data-topic="<%= ann._topic_id %>"
                                data-prio="<%= ann.is_priority ? '1' : '0' %>">
                
                                <!-- Priority colour strip -->
                                <div class="ann-priority-strip" style="background:<%= ann.is_priority ? '#ef4444' : '#e2e8f0' %>; min-height:40px"></div>
                
                                <!-- Content -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-start justify-between gap-2 flex-wrap">
                                        <div>
                                            <p class="ann-title">
                                                <% if (ann.is_priority) { %><i class="fas fa-flag text-rose-500 text-xs mr-1"></i><% } %>
                                                <%= ann.title %>
                                            </p>
                                            <div class="ann-meta">
                                                <span><i class="far fa-clock text-slate-300 mr-1"></i><%= annDate %></span>
                                                <% if (ann._topic_name) { %>
                                                <span class="ann-topic-chip"><i class="fas fa-tag text-[8px]"></i><%= ann._topic_name %></span>
                                                <% } %>
                                                <% if (ann.is_priority) { %>
                                                <span class="ann-prio-badge"><i class="fas fa-flag text-[8px]"></i> Priority</span>
                                                <% } %>
                                            </div>
                                        </div>
                                        <!-- Actions -->
                                        <div class="flex items-center gap-1 flex-shrink-0">
                                            <button class="icon-btn warn"
                                                    title="<%= ann.is_priority ? 'Remove priority' : 'Set priority' %>"
                                                    onclick="toggleAnnouncementPriority(<%= ann.announcement_id %>, <%= ann.is_priority ? 1 : 0 %>)"
                                                    id="ann-prio-<%= ann.announcement_id %>">
                                                <i class="fas fa-flag text-xs <%= ann.is_priority ? 'text-amber-500' : 'text-slate-300' %>"></i>
                                            </button>
                                            <button class="icon-btn"
                                                    title="Edit"
                                                    onclick="openEditAnnModal(<%= ann.announcement_id %>, '<%= ann.title.replace(/'/g,"\\'") %>', '<%= (ann.content||'').replace(/'/g,"\\'").replace(/\n/g,' ') %>', <%= ann.is_priority ? 1 : 0 %>, <%= ann._topic_id %>, <%= classInfo.class_id %>)">
                                                <i class="fas fa-pen text-xs"></i>
                                            </button>
                                            <button class="icon-btn danger"
                                                    title="Delete"
                                                    onclick="confirmDelete('announcement', <%= ann.announcement_id %>, '<%= ann.title.replace(/'/g,"\\'") %>')">
                                                <i class="fas fa-trash text-xs"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <p class="ann-body"><%= ann.content %></p>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <div class="comm-empty"><i class="fas fa-bullhorn"></i>No announcements yet. Click New Announcement to post one.</div>
                        <% } %>
                        </div>
                    </div>
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 2 · FORUM MANAGER
                    ══════════════════════════════════════════════════════ -->
                    <div class="comm-panel" id="cpanel-forums">
                
                        <div class="comm-filter-bar">
                            <div class="relative">
                                <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                <input type="text" class="content-search" placeholder="Search forums…"
                                    oninput="filterCommList(this.value, 'forumManagerList')">
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-xs font-semibold text-slate-500">Topic</label>
                                <select class="filter-select" id="forumTopicFilter" onchange="filterCommList('', 'forumManagerList')">
                                    <option value="">All Topics</option>
                                    <% quarters.forEach(function(q){ %>
                                        <% (q.topics || []).forEach(function(t){ %>
                                        <option value="<%= t.topic_id %>"><%= t.topic_name %></option>
                                        <% }); %>
                                    <% }); %>
                                </select>
                            </div>
                            <button class="compose-btn primary ml-auto" onclick="openCommModal('forumModal')">
                                <i class="fas fa-plus text-xs"></i> New Forum Thread
                            </button>
                        </div>
                
                        <!-- Forum list -->
                        <div id="forumManagerList">
                        <%
                            var allForums = [];
                            quarters.forEach(function(q){
                                (q.topics || []).forEach(function(t){
                                    (t.forums || []).forEach(function(f){
                                        f._topic_name = t.topic_name;
                                        f._topic_id   = t.topic_id;
                                        allForums.push(f);
                                    });
                                });
                            });
                            allForums.sort(function(a,b){
                                if (b.is_pinned !== a.is_pinned) return b.is_pinned - a.is_pinned;
                                return new Date(b.created_at) - new Date(a.created_at);
                            });
                        %>
                
                        <% if (allForums.length > 0) { %>
                            <% allForums.forEach(function(forum){ %>
                            <%
                                var fDate = forum.created_at ? new Date(forum.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—';
                                var replyCount = typeof forum.reply_count !== 'undefined' ? forum.reply_count : '…';
                            %>
                            <div class="forum-item"
                                data-search="<%= forum.title.toLowerCase() %>"
                                data-topic="<%= forum._topic_id %>">
                
                                <div class="flex items-start justify-between gap-2 flex-wrap">
                                    <div class="flex-1 min-w-0">
                                        <div class="forum-title">
                                            <% if (forum.is_pinned) { %><i class="fas fa-thumbtack text-indigo-500 text-xs flex-shrink-0"></i><% } %>
                                            <%= forum.title %>
                                        </div>
                                        <div class="forum-meta">
                                            <span><i class="far fa-clock text-slate-300 mr-1"></i><%= fDate %></span>
                                            <span class="ann-topic-chip"><i class="fas fa-tag text-[8px]"></i><%= forum._topic_name %></span>
                                            <% if (forum.is_pinned) { %><span class="pinned-badge"><i class="fas fa-thumbtack text-[8px]"></i> Pinned</span><% } %>
                                            <span class="reply-count" id="reply-count-<%= forum.forum_id %>">
                                                <i class="fas fa-reply text-[9px]"></i>
                                                <span id="rc-num-<%= forum.forum_id %>"><%= replyCount %></span> replies
                                            </span>
                                        </div>
                                        <% if (forum.forum_content) { %>
                                        <p class="forum-preview"><%= forum.forum_content %></p>
                                        <% } %>
                                    </div>
                                    <!-- Actions -->
                                    <div class="flex items-center gap-1 flex-shrink-0">
                                        <button class="icon-btn <%= forum.is_pinned ? '' : '' %>"
                                                title="<%= forum.is_pinned ? 'Unpin' : 'Pin' %>"
                                                onclick="toggleForumPin(<%= forum.forum_id %>, <%= forum.is_pinned ? 1 : 0 %>)"
                                                id="forum-pin-<%= forum.forum_id %>">
                                            <i class="fas fa-thumbtack text-xs <%= forum.is_pinned ? 'text-indigo-500' : 'text-slate-300' %>"></i>
                                        </button>
                                        <button class="icon-btn"
                                                title="View replies"
                                                onclick="toggleRepliesDrawer(<%= forum.forum_id %>)">
                                            <i class="fas fa-message text-xs"></i>
                                        </button>
                                        <button class="icon-btn"
                                                title="Edit"
                                                onclick="openEditForumModal(<%= forum.forum_id %>, '<%= forum.title.replace(/'/g,"\\'") %>', '<%= (forum.forum_content||'').replace(/'/g,"\\'").replace(/\n/g,' ') %>', <%= forum._topic_id %>, <%= subject.subject_id %>)">
                                            <i class="fas fa-pen text-xs"></i>
                                        </button>
                                        <button class="icon-btn danger"
                                                title="Delete"
                                                onclick="confirmDelete('forum', <%= forum.forum_id %>, '<%= forum.title.replace(/'/g,"\\'") %>')">
                                            <i class="fas fa-trash text-xs"></i>
                                        </button>
                                    </div>
                                </div>
                
                                <!-- Replies drawer (lazy loaded) -->
                                <div class="replies-drawer" id="replies-drawer-<%= forum.forum_id %>">
                                    <p class="text-xs text-slate-400 mb-2 font-semibold">Replies</p>
                                    <div id="replies-content-<%= forum.forum_id %>">
                                        <p class="text-xs text-slate-300 italic">Click the message icon to load replies.</p>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <div class="comm-empty"><i class="fas fa-comments"></i>No forum threads yet. Create one to start a discussion.</div>
                        <% } %>
                        </div>
                    </div>
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 3 · PRIVATE MESSAGING
                    ══════════════════════════════════════════════════════ -->
                    <div class="comm-panel" id="cpanel-messages">
                        <div class="msg-layout">
                
                            <!-- Contact sidebar -->
                            <div class="msg-sidebar">
                                <div class="px-3 py-2 border-b border-slate-100">
                                    <div class="relative">
                                        <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                        <input type="text" class="content-search" style="width:100%"
                                            placeholder="Search…" oninput="filterMsgContacts(this.value)">
                                    </div>
                                </div>
                                <div id="msgContactList">
                                <% students.forEach(function(s){ %>
                                <div class="msg-contact" id="contact-<%= s.user_id %>"
                                    data-uid="<%= s.user_id %>"
                                    data-name="<%= (s.first_name+' '+s.last_name).toLowerCase() %>"
                                    onclick="openConversation(<%= s.user_id %>, '<%= s.first_name %> <%= s.last_name %>', '<%= s.profile_pic || 'default_avatar.png' %>')">
                                    <img src="/profile_uploads/<%= s.profile_pic || 'default_avatar.png' %>"
                                        style="width:30px;height:30px;border-radius:8px;object-fit:cover;flex-shrink:0"
                                        onerror="this.src='/profile_uploads/default_avatar.png'">
                                    <div style="flex:1;min-width:0">
                                        <p class="msg-contact-name"><%= s.last_name %>, <%= s.first_name %></p>
                                        <p class="msg-contact-preview" id="preview-<%= s.user_id %>">Tap to open</p>
                                    </div>
                                </div>
                                <% }); %>
                                </div>
                            </div>
                
                            <!-- Message thread -->
                            <div class="msg-main">
                                <!-- Header -->
                                <div class="msg-header" id="msgHeader">
                                    <div class="msg-empty" style="padding:0;flex-direction:row;gap:8px;color:#94a3b8;font-size:13px">
                                        <i class="fas fa-arrow-left text-xs"></i> Select a student to start messaging
                                    </div>
                                </div>
                
                                <!-- Thread area -->
                                <div class="msg-thread" id="msgThread">
                                    <div class="msg-empty">
                                        <i class="fas fa-envelope-open-text text-3xl"></i>
                                        <p>No conversation selected</p>
                                    </div>
                                </div>
                
                                <!-- Compose area -->
                                <div class="msg-compose" id="msgCompose" style="display:none">
                                    <textarea id="msgInput" placeholder="Type a message…" rows="1"
                                            onkeydown="if(event.key==='Enter'&&!event.shiftKey){event.preventDefault();sendMessage()}"></textarea>
                                    <button class="msg-send-btn" onclick="sendMessage()" title="Send">
                                        <i class="fas fa-paper-plane text-xs"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 4 · FORUM COMPLETION TRACKER
                    ══════════════════════════════════════════════════════ -->
                    <div class="comm-panel" id="cpanel-completion">
                
                        <div class="comm-filter-bar">
                            <div class="relative">
                                <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-xs pointer-events-none"></i>
                                <input type="text" class="content-search" placeholder="Search forums…"
                                    oninput="filterCompletionForums(this.value)">
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-xs font-semibold text-slate-500">Topic</label>
                                <select class="filter-select" id="completionTopicFilter" onchange="filterCompletionForums('')">
                                    <option value="">All Topics</option>
                                    <% quarters.forEach(function(q){ %>
                                        <% (q.topics || []).forEach(function(t){ %>
                                        <option value="<%= t.topic_id %>"><%= t.topic_name %></option>
                                        <% }); %>
                                    <% }); %>
                                </select>
                            </div>
                            <p class="text-xs text-slate-400 ml-auto">
                                <i class="fas fa-info-circle mr-1"></i>
                                Shows which students completed each forum thread.
                            </p>
                        </div>
                
                        <div class="p-4 space-y-3" id="completionList">
                        <%
                            var allForumsForCompletion = [];
                            quarters.forEach(function(q){
                                (q.topics || []).forEach(function(t){
                                    (t.forums || []).forEach(function(f){
                                        f._topic_name = t.topic_name;
                                        f._topic_id   = t.topic_id;
                                        allForumsForCompletion.push(f);
                                    });
                                });
                            });
                        %>
                
                        <% if (allForumsForCompletion.length > 0) { %>
                            <% allForumsForCompletion.forEach(function(forum){ %>
                            <%
                                /* Match completion data — forumDoneMap passed from backend */
                                var doneStudentIds = (typeof forumDoneMap !== 'undefined' && forumDoneMap[forum.forum_id]) ? forumDoneMap[forum.forum_id] : [];
                                var doneCount   = doneStudentIds.length;
                                var totalCount  = students.length;
                                var donePct     = totalCount > 0 ? Math.round((doneCount / totalCount) * 100) : 0;
                            %>
                            <div class="completion-forum-block"
                                data-forum-title="<%= forum.title.toLowerCase() %>"
                                data-forum-topic="<%= forum._topic_id %>">
                
                                <!-- Forum header (collapsible) -->
                                <div class="completion-forum-header"
                                    onclick="toggleCompletionBlock(this)">
                                    <div class="flex items-center gap-3 flex-1 min-w-0">
                                        <i class="fas fa-chevron-right text-slate-400 text-xs chevron-icon"></i>
                                        <div class="min-w-0">
                                            <p class="font-bold text-slate-700 text-sm truncate"><%= forum.title %></p>
                                            <p class="text-xs text-slate-400"><%= forum._topic_name %></p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-3 flex-shrink-0">
                                        <!-- Mini progress bar -->
                                        <div style="width:80px;height:5px;background:#e2e8f0;border-radius:9999px;overflow:hidden">
                                            <div style="width:<%= donePct %>%;height:100%;background:<%= donePct >= 80 ? '#10b981' : donePct >= 50 ? '#06b6d4' : '#f59e0b' %>;border-radius:9999px"></div>
                                        </div>
                                        <span class="text-xs font-bold" style="color:<%= donePct >= 80 ? '#10b981' : donePct >= 50 ? '#06b6d4' : '#f59e0b' %>">
                                            <%= doneCount %>/<%= totalCount %>
                                        </span>
                                        <span class="completion-pill <%= doneCount === totalCount ? 'cpill-done' : 'cpill-undone' %>">
                                            <%= donePct %>%
                                        </span>
                                    </div>
                                </div>
                
                                <!-- Student completion list -->
                                <div class="completion-forum-body" id="cfbody-<%= forum.forum_id %>">
                                    <% students.forEach(function(s){ %>
                                    <%
                                        var isDone = doneStudentIds.indexOf(s.user_id) !== -1;
                                    %>
                                    <div class="student-done-row">
                                        <img src="/profile_uploads/<%= s.profile_pic || 'default_avatar.png' %>"
                                            style="width:26px;height:26px;border-radius:7px;object-fit:cover;flex-shrink:0"
                                            onerror="this.src='/profile_uploads/default_avatar.png'">
                                        <span class="text-xs font-semibold text-slate-700 flex-1">
                                            <%= s.last_name %>, <%= s.first_name %>
                                        </span>
                                        <% if (isDone) { %>
                                        <span class="completion-pill cpill-done">
                                            <i class="fas fa-check text-[9px]"></i> Done
                                        </span>
                                        <% } else { %>
                                        <span class="completion-pill cpill-undone">
                                            <i class="fas fa-clock text-[9px]"></i> Pending
                                        </span>
                                        <% } %>
                                    </div>
                                    <% }); %>
                                </div>
                            </div>
                            <% }); %>
                        <% } else { %>
                            <div class="comm-empty"><i class="fas fa-clipboard-check"></i>No forum threads to track yet.</div>
                        <% } %>
                        </div>
                    </div>
                
                </div>
                <!-- END SECTION 5 · COMMUNICATION & COMMUNITY -->

                <!-- ============================================================
                    SECTION 6 · SCHEDULING & CALENDAR
                ============================================================ -->
                <div class="section-card" id="calendarSection">
                
                    <!-- Card header -->
                    <div class="section-header">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-violet-400 to-purple-600 flex items-center justify-center shadow-md shadow-purple-200 flex-shrink-0">
                                <i class="fas fa-calendar-days text-white text-sm"></i>
                            </div>
                            <div>
                                <h2 class="text-sm font-bold text-slate-800">Scheduling &amp; Calendar</h2>
                                <p class="text-xs text-slate-400">Calendar Events · Recurring Schedules · Upcoming Deadlines</p>
                            </div>
                        </div>
                        <!-- Tab bar -->
                        <div class="cal-tabs" id="calTabs">
                            <button class="cal-tab active" onclick="switchCalTab('calendar', this)">
                                <i class="fas fa-calendar text-[10px]"></i> Calendar View
                            </button>
                            <button class="cal-tab" onclick="switchCalTab('timeline', this)">
                                <i class="fas fa-list-ul text-[10px]"></i> Upcoming Timeline
                            </button>
                        </div>
                    </div>
                
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 1 · CALENDAR VIEW
                    ══════════════════════════════════════════════════════ -->
                    <div class="cal-panel active" id="cpanel-calendar">
                
                        <!-- Filter bar -->
                        <div class="cal-filter-bar">
                            <div class="flex items-center gap-2">
                                <label class="text-xs font-semibold text-slate-500">Type</label>
                                <select class="filter-select" id="calTypeFilter" onchange="renderCalendar()">
                                    <option value="">All Types</option>
                                    <option value="Material">Material</option>
                                    <option value="Deadline">Deadline</option>
                                    <option value="Exam">Exam</option>
                                    <option value="Holiday">Holiday</option>
                                </select>
                            </div>
                            <button class="compose-btn primary ml-auto" onclick="openCalModal(null)">
                                <i class="fas fa-plus text-xs"></i> New Event
                            </button>
                        </div>
                
                        <!-- Calendar + event list layout -->
                        <div class="cal-layout">
                
                            <!-- Calendar grid -->
                            <div class="cal-grid-wrap">
                                <div class="cal-nav">
                                    <button class="cal-nav-btn" onclick="calNavMonth(-1)">
                                        <i class="fas fa-chevron-left text-xs"></i>
                                    </button>
                                    <span class="cal-month-label" id="calMonthLabel"></span>
                                    <button class="cal-nav-btn" onclick="calNavMonth(1)">
                                        <i class="fas fa-chevron-right text-xs"></i>
                                    </button>
                                </div>
                                <div class="cal-dow-row">
                                    <div class="cal-dow">Sun</div><div class="cal-dow">Mon</div>
                                    <div class="cal-dow">Tue</div><div class="cal-dow">Wed</div>
                                    <div class="cal-dow">Thu</div><div class="cal-dow">Fri</div>
                                    <div class="cal-dow">Sat</div>
                                </div>
                                <div class="cal-day-grid" id="calDayGrid"></div>
                            </div>
                
                            <!-- Event list for selected date -->
                            <div class="cal-event-list-panel">
                                <div class="cal-event-list-header">
                                    <p class="text-xs font-bold text-slate-600" id="calEventListDate">All Events This Month</p>
                                    <span class="text-xs text-slate-400" id="calEventListCount"></span>
                                </div>
                                <div id="calEventList">
                                    <p class="cal-empty"><i class="fas fa-calendar-xmark"></i>No events this month.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 2 · UPCOMING DEADLINES TIMELINE
                    ══════════════════════════════════════════════════════ -->
                    <div class="cal-panel" id="cpanel-timeline">
                
                        <div class="cal-filter-bar">
                            <div class="flex items-center gap-2">
                                <label class="text-xs font-semibold text-slate-500">Show next</label>
                                <select class="filter-select" id="timelineDays" onchange="renderTimeline()">
                                    <option value="7">7 days</option>
                                    <option value="14">14 days</option>
                                    <option value="30" selected>30 days</option>
                                    <option value="60">60 days</option>
                                    <option value="0">All upcoming</option>
                                </select>
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-xs font-semibold text-slate-500">Type</label>
                                <select class="filter-select" id="timelineTypeFilter" onchange="renderTimeline()">
                                    <option value="">All Types</option>
                                    <option value="Material">Material</option>
                                    <option value="Deadline">Deadline</option>
                                    <option value="Exam">Exam</option>
                                    <option value="Holiday">Holiday</option>
                                    <option value="Assessment">Assessment Due</option>
                                </select>
                            </div>
                            <p class="text-xs text-slate-400 ml-auto">
                                <i class="fas fa-circle-info mr-1"></i>
                                Combines calendar events + assessment due dates
                            </p>
                        </div>
                
                        <div class="timeline-wrap" id="timelineContainer">
                            <!-- Rendered by JS -->
                            <p class="cal-empty"><i class="fas fa-hourglass-start"></i>Loading timeline…</p>
                        </div>
                    </div>
                
                </div>
                <!-- END SECTION 6 · SCHEDULING & CALENDAR -->




                <!-- ================================================================
                PART 3 OF 4 · MODALS
                ================================================================ -->

                <!-- Toast -->
                <div id="cm-toast"></div>

                <!-- ======= TOPIC MODAL ======= -->
                <div class="modal-backdrop" id="topicModal">
                    <div class="modal-card">
                        <div class="modal-header">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-violet-100 flex items-center justify-center">
                                    <i class="fas fa-tag text-violet-600 text-sm"></i>
                                </div>
                                <h3 class="font-bold text-slate-800 text-sm" id="topicModalTitle">Add Topic</h3>
                            </div>
                            <button onclick="closeModal('topicModal')" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-times text-sm"></i>
                            </button>
                        </div>
                        <form id="topicForm" onsubmit="submitTopicForm(event)">
                            <input type="hidden" id="topicId" name="topic_id">
                            <input type="hidden" id="topicQuarterId" name="quarter_id">
                            <div class="modal-body">
                                <div>
                                    <label class="form-label">Topic Name <span class="text-rose-500">*</span></label>
                                    <input type="text" id="topicName" name="topic_name" class="form-input" placeholder="e.g. Chemical Bonding" required>
                                </div>
                                <div>
                                    <label class="form-label">Theme</label>
                                    <select id="topicTheme" name="theme_id" class="form-select">
                                        <option value="default_lab">Default Lab</option>
                                        <option value="space_lab">Space Lab</option>
                                        <option value="jungle_lab">Jungle Lab</option>
                                        <option value="ocean_lab">Ocean Lab</option>
                                        <option value="volcano_lab">Volcano Lab</option>
                                    </select>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" onclick="closeModal('topicModal')" class="sort-btn">Cancel</button>
                                <button type="submit" class="sort-btn active" style="background:#4f46e5;border-color:#4338ca;color:white">
                                    <i class="fas fa-save text-xs"></i> Save Topic
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- ======= MATERIAL MODAL ======= -->
                <div class="modal-backdrop" id="materialModal">
                    <div class="modal-card" style="max-width:520px">
                        <div class="modal-header">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-teal-100 flex items-center justify-center">
                                    <i class="fas fa-folder-open text-teal-600 text-sm"></i>
                                </div>
                                <h3 class="font-bold text-slate-800 text-sm" id="materialModalTitle">Add Learning Material</h3>
                            </div>
                            <button onclick="closeModal('materialModal')" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-times text-sm"></i>
                            </button>
                        </div>
                        <form id="materialForm" onsubmit="submitMaterialForm(event)">
                            <input type="hidden" id="materialId" name="material_id">
                            <input type="hidden" id="materialTopicId" name="topic_id">
                            <div class="modal-body">
                                <div>
