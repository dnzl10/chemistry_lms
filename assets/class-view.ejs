/* ── Comm modal open/close ── */
function openCommModal(id) {
    /* reset form first */
    const form = document.querySelector('#' + id + ' form');
    if (form) form.reset();
    const titleEl = document.getElementById(id.replace('Modal','') + 'ModalTitle');
    if (id === 'annModal' && titleEl) titleEl.textContent = 'New Announcement';
    if (id === 'commForumModal') document.getElementById('commForumModalTitle').textContent = 'New Forum Thread';
    document.getElementById(id).classList.add('open');
}
function closeCommModal(id) {
    document.getElementById(id).classList.remove('open');
}
/* Close on backdrop click */
document.querySelectorAll('.comm-modal-backdrop').forEach(b => {
    b.addEventListener('click', function(e) { if (e.target === this) closeCommModal(this.id); });
});
 
/* ── Filter helpers ── */
function filterCommList(query, listId) {
    const q          = query.toLowerCase().trim();
    const topicFilter= listId === 'annList'
        ? (document.getElementById('annTopicFilter')?.value || '')
        : (document.getElementById('forumTopicFilter')?.value || '');
    const prioOnly   = listId === 'annList' && document.getElementById('annPrioOnly')?.checked;
 
    document.querySelectorAll('#' + listId + ' > [data-search]').forEach(el => {
        const matchQ    = !topicFilter || el.dataset.topic === topicFilter;
        const matchName = !q           || el.dataset.search.includes(q);
        const matchPrio = !prioOnly    || el.dataset.prio === '1';
        el.style.display = (matchQ && matchName && matchPrio) ? '' : 'none';
    });
}
 
function filterCompletionForums(query) {
    const q           = query.toLowerCase().trim();
    const topicFilter = document.getElementById('completionTopicFilter')?.value || '';
