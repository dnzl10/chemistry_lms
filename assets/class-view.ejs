/* ================================================================
   DELETE CONFIRM
   ================================================================ */
function confirmDelete(type, id, label) {
    const labels = {
        topic: 'topic',
        material: 'learning material',
        assessment: 'assessment',
        announcement: 'announcement',
        forum: 'forum thread'
    };
    document.getElementById('deleteModalMsg').textContent =
        'Delete ' + (labels[type] || type) + ' "' + label + '"?';

    const btn = document.getElementById('confirmDeleteBtn');
    btn.onclick = () => executeDelete(type, id);
    openModal('deleteModal');
}

async function executeDelete(type, id) {
    const urlMap = {
        topic: '/teacher/api/topic/',
        material: '/teacher/api/material/',
        assessment: '/teacher/api/assessment/',
        announcement: '/teacher/api/announcement/',
        forum: '/teacher/api/forum/'
    };
    try {
        const res = await fetch(urlMap[type] + id, { method: 'DELETE' });
        if (!res.ok) throw new Error();
        closeModal('deleteModal');
        cmToast('Deleted successfully. Reloading…', 'success');
        setTimeout(() => location.reload(), 1000);
    } catch(e) {
        closeModal('deleteModal');
        cmToast('Delete failed. Please try again.', 'error');
    }
}




