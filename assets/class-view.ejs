let activeConvUserId = null;
let msgPollingInterval = null;
 
async function openConversation(userId, name, pic) {
    /* Mark contact active */
    document.querySelectorAll('.msg-contact').forEach(c => c.classList.remove('active'));
    document.getElementById('contact-' + userId)?.classList.add('active');
    activeConvUserId = userId;
 
    /* Update header */
    document.getElementById('msgHeader').innerHTML = `
        <img src="/profile_uploads/${escHtml(pic)}" style="width:30px;height:30px;border-radius:8px;object-fit:cover" onerror="this.src='/profile_uploads/default_avatar.png'">
        <span style="font-size:13px;font-weight:700;color:#334155">${escHtml(name)}</span>`;
 
    /* Show compose */
    document.getElementById('msgCompose').style.display = 'flex';
    document.getElementById('msgInput').focus();
 
    /* Load messages */
    await loadMessages(userId);
 
    /* Poll every 8 seconds */
    clearInterval(msgPollingInterval);
    msgPollingInterval = setInterval(() => {
        if (activeConvUserId === userId) loadMessages(userId);
    }, 8000);
}
 
async function loadMessages(userId) {
    try {
        const res  = await fetch('/teacher/api/messages/' + userId);
        if (!res.ok) throw new Error();
        const data = await res.json();
        const thread = document.getElementById('msgThread');
 
        if (!data.messages || data.messages.length === 0) {
            thread.innerHTML = `<div class="msg-empty"><i class="fas fa-comment-dots text-3xl"></i><p>No messages yet. Say hello!</p></div>`;
        } else {
            thread.innerHTML = data.messages.map(m => {
                const isSent = m.sender_id === <%= user.user_id %>;
                const time   = m.sent_at ? new Date(m.sent_at).toLocaleTimeString('en-PH',{hour:'2-digit',minute:'2-digit'}) : '';
                return `
                <div class="msg-bubble ${isSent ? 'sent' : 'recv'}">
                    ${escHtml(m.message_text)}
                    <div class="msg-bubble-time">${time}</div>
                </div>`;
            }).join('');
            thread.scrollTop = thread.scrollHeight;
        }
 
        /* Update preview */
        if (data.messages.length) {
            const last = data.messages[data.messages.length - 1];
            const prev = document.getElementById('preview-' + userId);
            if (prev) prev.textContent = last.message_text?.slice(0,30) + (last.message_text?.length > 30 ? '…' : '');
        }
    } catch(e) { /* silent */ }
}
 
async function sendMessage() {
    const input = document.getElementById('msgInput');
    const text  = input.value.trim();
    if (!text || !activeConvUserId) return;
    input.value = '';
 
    try {
        const res = await fetch('/teacher/api/messages', {
            method: 'POST',
            headers: {'Content-Type':'application/json'},
            body: JSON.stringify({ receiver_id: activeConvUserId, message_text: text })
        });
        if (!res.ok) throw new Error();
        await loadMessages(activeConvUserId);
    } catch(e) { cmToast('Message failed to send.', 'error'); }
}

