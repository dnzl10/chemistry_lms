/* ================================================================
   TAB 1 — SCORE FILTER
   ================================================================ */
function filterScoreTable() {
    const qFilter   = document.getElementById('scoreFilterQuarter').value;
    const typeFilter= document.getElementById('scoreFilterType').value;
    const query     = document.getElementById('scoreSearch').value.toLowerCase().trim();
    const rows      = document.querySelectorAll('#scoreTableBody tr[data-student]');
    let visible     = 0;
 
    rows.forEach(row => {
        const matchQ    = !qFilter    || row.dataset.quarter  === qFilter;
        const matchType = !typeFilter || row.dataset.type     === typeFilter;
        const matchName = !query      || row.dataset.student.includes(query);
        const show = matchQ && matchType && matchName;
        row.style.display = show ? '' : 'none';
        if (show) visible++;
    });
 
    const countEl = document.getElementById('scoreCount');
    if (countEl) countEl.innerHTML = 'Showing <strong>' + visible + '</strong> records';
}
 
/* ================================================================
   TAB 2 — QUESTION BREAKDOWN (fetched from API)
   ================================================================ */
async function renderBreakdown(assessmentId) {
    const container = document.getElementById('breakdownContainer');
    if (!assessmentId) {
        container.innerHTML = '<p class="no-data-state">Select an assessment above to view the question-by-question breakdown.</p>';
        return;
    }
 
    container.innerHTML = '<p class="no-data-state"><i class="fas fa-spinner fa-spin mr-2"></i>Loading breakdown…</p>';
 
    try {
        const res  = await fetch('/teacher/api/breakdown/' + assessmentId);
        if (!res.ok) throw new Error('Server returned ' + res.status);
        const data = await res.json();
 
        if (!data.questions || data.questions.length === 0) {
            container.innerHTML = '<p class="no-data-state">No response data found for this assessment yet.</p>';
            return;
        }
 
        // Sort: hardest first (lowest correct rate)
        data.questions.sort((a, b) => a.correct_rate - b.correct_rate);
 
        const diffMap = { Easy:'diff-easy', Average:'diff-avg', Difficult:'diff-hard' };
 
        let html = '<div class="qb-grid">';
        data.questions.forEach((q, i) => {
            const rate    = Math.round(q.correct_rate * 100);
            const barColor= rate >= 70 ? '#10b981' : rate >= 40 ? '#f59e0b' : '#ef4444';
            const avgMs   = q.avg_response_ms ? (q.avg_response_ms / 1000).toFixed(1) + 's' : '—';
            const diffCls = diffMap[q.difficulty] || 'diff-avg';
 
            html += `
            <div class="qb-card">
                <div class="qb-card-header">
                    <span class="qb-q-num">Q${i + 1}</span>
                    <span class="qb-difficulty ${diffCls}">${q.difficulty}</span>
                </div>
                <div class="qb-q-text">${escHtml(q.question_text)}</div>
                <div class="qb-stats">
                    <div class="qb-stat">
                        <div class="qb-stat-val" style="color:#10b981">${q.correct_count}</div>
                        <div class="qb-stat-lbl">Correct</div>
                    </div>
                    <div class="qb-stat">
                        <div class="qb-stat-val" style="color:#ef4444">${q.wrong_count}</div>
                        <div class="qb-stat-lbl">Wrong</div>
                    </div>
                    <div class="qb-stat">
                        <div class="qb-stat-val" style="color:#6366f1">${avgMs}</div>
                        <div class="qb-stat-lbl">Avg Time</div>
                    </div>
                    <div class="qb-stat">
                        <div class="qb-stat-val" style="color:${barColor}">${rate}%</div>
                        <div class="qb-stat-lbl">Correct%</div>
                    </div>
                </div>
                <div class="correct-rate-bar">
                    <div class="correct-rate-fill" style="width:${rate}%;background:${barColor}"></div>
                </div>
            </div>`;
        });
        html += '</div>';
 
        // Summary strip
        const avgRate    = Math.round(data.questions.reduce((s,q)=>s+q.correct_rate,0) / data.questions.length * 100);
        const hardest    = data.questions[0];
        const easiest    = data.questions[data.questions.length - 1];
 
        html = `
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px">
            <div style="background:#f8fafc;border-radius:10px;padding:10px 14px;text-align:center">
                <p style="font-size:18px;font-weight:800;color:#4f46e5">${data.questions.length}</p>
                <p style="font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase">Questions</p>
            </div>
            <div style="background:#f8fafc;border-radius:10px;padding:10px 14px;text-align:center">
                <p style="font-size:18px;font-weight:800;color:${avgRate>=70?'#10b981':avgRate>=40?'#f59e0b':'#ef4444'}">${avgRate}%</p>
                <p style="font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase">Avg Correct Rate</p>
            </div>
            <div style="background:#fff7ed;border-radius:10px;padding:10px 14px;text-align:center">
                <p style="font-size:11px;font-weight:700;color:#c2410c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escHtml(hardest.question_text.slice(0,40))}…</p>
                <p style="font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase;margin-top:2px">Hardest Item (${Math.round(hardest.correct_rate*100)}%)</p>
            </div>
        </div>` + html;
 
        container.innerHTML = html;
    } catch(err) {
        container.innerHTML = `<p class="no-data-state" style="color:#ef4444"><i class="fas fa-circle-exclamation mr-1"></i>Failed to load breakdown: ${err.message}</p>`;
    }
}
 
function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
 
