/* ── Replies drawer (lazy fetch) ── */
async function toggleRepliesDrawer(forumId) {
    const drawer  = document.getElementById('replies-drawer-' + forumId);
    const content = document.getElementById('replies-content-' + forumId);
    const isOpen  = drawer.classList.contains('open');
 
    if (!isOpen && content.dataset.loaded !== '1') {
        content.innerHTML = '<p class="text-xs text-slate-400 italic"><i class="fas fa-spinner fa-spin mr-1"></i>Loading replies…</p>';
        try {
            const res  = await fetch('/teacher/api/forum-replies/' + forumId);
            const data = await res.json();
            content.dataset.loaded = '1';
 
            /* Update reply count badge */
            const rcNum = document.getElementById('rc-num-' + forumId);
            if (rcNum) rcNum.textContent = data.replies ? data.replies.filter(r => !r.parent_reply_id).length : 0;
 
            if (!data.replies || data.replies.length === 0) {
                content.innerHTML = '<p class="text-xs text-slate-300 italic">No replies yet.</p>';
            } else {
                /* Build nested reply tree */
                const top    = data.replies.filter(r => !r.parent_reply_id);
                const nested = data.replies.filter(r =>  r.parent_reply_id);
                content.innerHTML = top.map(r => buildReplyBubble(r, nested)).join('');
            }
        } catch(err) {
            content.innerHTML = '<p class="text-xs text-rose-400">Failed to load replies.</p>';
        }
    }
 
    drawer.classList.toggle('open', !isOpen);
}
 
function buildReplyBubble(reply, allNested) {
    const children = allNested.filter(r => r.parent_reply_id === reply.reply_id);
    const time = reply.created_at
        ? new Date(reply.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})
        : '';
    const childHtml = children.length
        ? `<div class="reply-nested">${children.map(c => buildReplyBubble(c, allNested)).join('')}</div>`
        : '';
    return `
    <div class="reply-bubble">
        <div>
            <span class="reply-author">${escHtml(reply.first_name)} ${escHtml(reply.last_name)}</span>
            <span class="reply-time">${time}</span>
        </div>
        <p class="reply-text">${escHtml(reply.reply_content || '')}</p>
        ${childHtml}
    </div>`;
}
 
