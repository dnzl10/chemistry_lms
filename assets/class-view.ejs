                                <div>
                                    <label class="form-label">Event Title <span class="text-rose-500">*</span></label>
                                    <input type="text" id="calEventTitle" name="event_title" class="form-input"
                                        placeholder="e.g. Midterm Exam" required>
                                </div>
                
                                <!-- Row 2: Type + Date -->
                                <div class="grid grid-cols-2 gap-3">
                                    <div>
                                        <label class="form-label">Event Type <span class="text-rose-500">*</span></label>
                                        <select id="calEventType" name="event_type" class="form-select" required>
                                            <option value="Material">Material</option>
                                            <option value="Deadline">Deadline</option>
                                            <option value="Exam">Exam</option>
                                            <option value="Holiday">Holiday</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="form-label">Event Date <span class="text-rose-500">*</span></label>
                                        <input type="date" id="calEventDate" name="event_date" class="form-input" required>
                                    </div>
                                </div>
                
                                <!-- Row 3: Duration type -->
                                <div>
