                                            onchange="toggleDurationFields(this.value)">
                                        <option value="None">None (single day)</option>
                                        <option value="DateRange">Date Range (start → end)</option>
                                        <option value="Minutes">Minutes</option>
                                    </select>
                                </div>
                
                                <!-- Date range fields -->
                                <div class="dur-field" id="durRangeFields">
                                    <div class="grid grid-cols-2 gap-3">
                                        <div>
                                            <label class="form-label">Start Date/Time</label>
                                            <input type="datetime-local" id="calStartDate" name="start_date" class="form-input">
                                        </div>
                                        <div>
                                            <label class="form-label">End Date/Time</label>
                                            <input type="datetime-local" id="calEndDate" name="end_date" class="form-input">
                                        </div>
                                    </div>
                                </div>
                
                                <!-- Minutes field -->
                                <div class="dur-field" id="durMinutesField">
                                    <label class="form-label">Duration (minutes)</label>
                                    <input type="number" id="calDurationMins" name="duration_minutes" class="form-input"
                                        min="1" placeholder="e.g. 90">
                                </div>
                
                                <!-- Row 4: Location + Description -->
                                <div>
                                    <label class="form-label">Location</label>
                                    <input type="text" id="calEventLocation" name="event_location" class="form-input"
                                        placeholder="TBA" value="TBA">
                                </div>
                                <div>
                                    <label class="form-label">Description</label>
                                    <textarea id="calEventDesc" name="event_description" class="form-textarea"
                                            placeholder="Optional details about this event…"></textarea>
                                </div>
                
                                <!-- Row 5: Recurring -->
                                <div class="flex items-center gap-3">
                                    <input type="checkbox" id="calIsRepeatable" name="is_repeatable" value="1"
                                        class="w-4 h-4 accent-violet-600"
                                        onchange="toggleRepeatField(this.checked)">
                                    <label for="calIsRepeatable" class="form-label mb-0">
                                        <i class="fas fa-rotate text-violet-400 mr-1"></i> Recurring event
                                    </label>
                                </div>
                
                                <div class="repeat-field" id="repeatCycleField">
