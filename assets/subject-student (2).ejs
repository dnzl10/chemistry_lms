        const DEFAULT_VISIBLE = 8;
        let showAll = false;

        function buildSimCards(sims) {
            return sims.map(sim => {
                const col = CATEGORY_COLORS[sim.category] || { bg: "bg-slate-100", text: "text-slate-600" };
                return `
                <div class="sim-card bg-white rounded-2xl border border-slate-200 overflow-hidden flex flex-col"
                     data-title="${sim.title.toLowerCase()}"
                     data-category="${sim.category}">
                    <div class="sim-thumbnail-wrapper">
                        <img src="${sim.thumb}"
                             alt="${sim.title}"
                             loading="lazy"
                             onerror="this.onerror=null;this.src='https://phet.colorado.edu/images/phet-logo.png';this.style.objectFit='contain';this.style.padding='16px';this.style.background='#e0f2fe';">
                        <div class="sim-play-overlay"></div>
                    </div>
                    <div class="p-4 flex flex-col flex-1 gap-2">
                        <span class="category-badge ${col.bg} ${col.text} self-start">${sim.category}</span>
                        <h3 class="font-extrabold text-slate-800 text-sm leading-tight">${sim.title}</h3>
                        <p class="text-slate-500 text-xs leading-relaxed flex-1">${sim.description}</p>
                        <a href="${sim.url}" target="_blank" rel="noopener"
                           class="mt-2 flex items-center justify-center gap-2 py-2.5 bg-gradient-to-r from-cyan-500 to-indigo-500 hover:from-cyan-600 hover:to-indigo-600 text-white font-bold rounded-xl text-xs transition-all shadow-sm hover:shadow">
                            <i class="fas fa-play text-[10px]"></i> Run Simulation
                        </a>
                    </div>
                </div>`;
            }).join('');
        }

        function renderSimulations() {
            const grid = document.getElementById('sim-grid');
            grid.innerHTML = buildSimCards(SIMULATIONS);
            applyVisibility();
        }

        function applyVisibility() {
            const search = document.getElementById('sim-search').value.toLowerCase().trim();
            const category = document.getElementById('sim-category-filter').value;
            const cards = document.querySelectorAll('.sim-card');
            let visibleCount = 0;

            cards.forEach((card, idx) => {
                const title = card.dataset.title;
                const cat = card.dataset.category;
                const matchSearch = !search || title.includes(search);
                const matchCat = category === 'all' || cat === category;
                const isFiltering = search || category !== 'all';

                if (matchSearch && matchCat) {
                    const shouldShow = isFiltering || showAll || visibleCount < DEFAULT_VISIBLE;
                    if (shouldShow) {
                        card.classList.remove('sim-hidden');
                        visibleCount++;
                    } else {
                        card.classList.add('sim-hidden');
                    }
                } else {
                    card.classList.add('sim-hidden');
                }
            });

            // Determine total matching
            const totalMatching = [...cards].filter(c => {
                const matchSearch = !search || c.dataset.title.includes(search);
                const matchCat = category === 'all' || c.dataset.category === category;
                return matchSearch && matchCat;
            }).length;

            document.getElementById('sim-no-results').classList.toggle('hidden', totalMatching > 0);

            // Show bottom toggle only when expanded & not filtering
            const isFiltering = search || category !== 'all';
            const bottomToggle = document.getElementById('sim-bottom-toggle');
            bottomToggle.classList.toggle('hidden', !showAll || isFiltering);

            // Update top button
            const btn = document.getElementById('sim-toggle-btn');
            const icon = document.getElementById('sim-toggle-icon');
            const label = document.getElementById('sim-toggle-label');
            if (showAll || isFiltering) {
                icon.classList.replace('fa-chevron-down', 'fa-chevron-up');
                label.textContent = isFiltering ? `${totalMatching} Sim${totalMatching !== 1 ? 's' : ''} Found` : 'Show Less';
                btn.style.background = isFiltering ? 'linear-gradient(to right,#10b981,#6366f1)' : '';
            } else {
                icon.classList.replace('fa-chevron-up', 'fa-chevron-down');
                label.textContent = `Show All ${SIMULATIONS.length} Sims`;
                btn.style.background = '';
            }
        }

        function toggleAllSimulations() {
            showAll = !showAll;
            const bottomIcon = document.getElementById('sim-bottom-icon');
            const bottomLabel = document.getElementById('sim-bottom-label');
            if (showAll) {
                bottomIcon.classList.replace('fa-chevron-up', 'fa-chevron-down');
                bottomLabel.textContent = 'Show Less';
            } else {
                bottomIcon.classList.replace('fa-chevron-down', 'fa-chevron-up');
                bottomLabel.textContent = 'Show Less';
                document.getElementById('simulations-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            applyVisibility();
        }

        function filterSimulations() {
            applyVisibility();
        }

        // Initialize on DOM ready
        document.addEventListener('DOMContentLoaded', renderSimulations);
    </script>
