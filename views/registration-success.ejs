<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Account Setup & Profile Activation - Chemistry Arcade LMS</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Outfit:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet">
    <!-- FontAwesome 6 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Outfit', 'sans-serif'],
                        mono: ['JetBrains Mono', 'monospace'],
                    },
                    colors: {
                        brand: {
                            50: '#eef2ff',
                            100: '#e0e7ff',
                            500: '#6366f1',
                            600: '#4f46e5',
                            700: '#4338ca',
                            900: '#312e81'
                        }
                    }
                }
            }
        }
    </script>
    <style>
        * { box-sizing: border-box; }

        body {
            background-color: #000;
            min-height: 100vh;
            position: relative;
        }

        /* Background Layers matching login.ejs */
        body::before {
            content: '';
            position: fixed;
            inset: 0;
            opacity: 0.50;
            background-image: url('/assets/lab_bg_1.jpg');
            background-size: cover;
            background-position: center;
            z-index: -2;
        }

        body::after {
            content: '';
            position: fixed;
            inset: 0;
            background: linear-gradient(135deg,
                rgba(10, 15, 40, 0.72) 0%,
                rgba(20, 10, 50, 0.60) 50%,
                rgba(10, 20, 50, 0.72) 100%);
            backdrop-filter: blur(2px);
            z-index: -1;
        }

        .step-transition {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .arcade-card-glass {
            background: linear-gradient(135deg, rgba(255,255,255,0.92) 0%, rgba(248,250,252,0.85) 100%);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(226,232,240,0.8);
        }
        .neon-glow {
            box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.25), 0 8px 10px -6px rgba(79, 70, 229, 0.15);
        }
    </style>
</head>
<body class="min-h-screen text-slate-800 font-sans p-3 sm:p-6 md:p-10 flex flex-col justify-between relative">

    <div class="max-w-4xl mx-auto w-full">
        <!-- Header & Branding -->
        <header class="text-center mb-8">
            <div class="flex items-center justify-center gap-2 mb-4">
                <img src="/assets/logo.png" alt="Logo" class="w-12 h-14 object-contain">
                <h1 class="text-xl font-black tracking-tighter text-cyan-400 uppercase italic leading-none">
                    Elem<span class="text-white">enta</span>
                </h1>
            </div>
            <div id="headerStageBadge" class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/20 text-cyan-300 text-xs font-bold uppercase tracking-wider mb-3 shadow-lg">
                <span class="w-2 h-2 rounded-full bg-emerald-400 animate-ping"></span>
                <span id="headerStageBadgeText">Mabini Colleges • Data Privacy Consent</span>
            </div>
            <h1 class="text-2xl sm:text-3xl font-extrabold text-white tracking-tight drop-shadow-sm">
                Welcome to Chemistry Arcade! 🧪
            </h1>
            <p id="headerSubtitleText" class="text-slate-300 mt-2 text-sm sm:text-base max-w-xl mx-auto">
                Please review and accept our Data Privacy Consent Form to proceed with setting up your official account.
            </p>
        </header>

        <% if (locals.errorMessage) { %>
            <div class="mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-3 shadow-sm animate-pulse">
                <i class="fas fa-circle-exclamation text-rose-500 text-lg"></i>
                <div class="flex-1 font-semibold"><%= locals.errorMessage %></div>
            </div>
        <% } %>

        <!-- ========================================== -->
        <!-- DATA PRIVACY CONSENT SECTION               -->
        <!-- ========================================== -->
        <section id="privacyConsentSection" class="bg-white rounded-3xl p-6 sm:p-10 shadow-2xl shadow-black/40 border border-white/20 mb-8 transition-all duration-300">
            <!-- Header of Consent Form -->
            <div class="text-center pb-6 mb-6 border-b border-slate-100">
                <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-indigo-50 border border-indigo-200 text-indigo-700 text-xs font-bold uppercase tracking-wider mb-2">
                    <i class="fas fa-shield-halved text-indigo-600"></i>
                    Republic Act No. 10173 • Data Privacy Act of 2012
                </div>
                <h2 class="text-2xl sm:text-3xl font-black text-slate-900 tracking-tight">Mabini Colleges Inc.</h2>
                <h3 class="text-sm sm:text-base font-extrabold text-indigo-600 uppercase tracking-wide mt-1">
                    Learning Management System (LMS) — Data Privacy Consent Form
                </h3>
            </div>

            <!-- Notice Box -->
            <div class="mb-6 p-4 sm:p-5 rounded-2xl bg-amber-50/90 border border-amber-200 text-amber-900 text-xs sm:text-sm leading-relaxed flex items-start gap-3">
                <i class="fas fa-triangle-exclamation text-amber-600 text-lg flex-shrink-0 mt-0.5"></i>
                <div>
                    <strong class="font-extrabold uppercase tracking-wide text-amber-800">NOTICE:</strong>
                    Please read this document carefully before proceeding to register or use the LMS. By checking the boxes below, you certify that you understand and voluntarily give your consent in accordance with the Data Privacy Act (DPA) of 2012.
                </div>
            </div>

            <!-- Scrollable Policy Content -->
            <div class="space-y-6 text-slate-700 text-xs sm:text-sm leading-relaxed max-h-[460px] overflow-y-auto pr-3 mb-8 border border-slate-200 rounded-2xl p-5 bg-slate-50/60 shadow-inner">
                <!-- 1. Type and Category of Personal Data Collected -->
                <div class="bg-white p-4 sm:p-5 rounded-xl border border-slate-200/80 shadow-sm">
                    <h4 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2 mb-2">
                        <span class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-black">1</span>
                        Type and Category of Personal Data Collected
                    </h4>
                    <p class="text-slate-600 mb-2.5">To provide you with proper academic services, we collect the following information from you:</p>
                    <ul class="list-disc pl-5 space-y-1.5 text-slate-600">
                        <li><strong class="text-slate-800">Personal Identification Information:</strong> Full name (First name, Middle name, Last name), date of birth, gender, and profile picture (if applicable).</li>
                        <li><strong class="text-slate-800">Contact Details:</strong> School or personal email address, mobile/telephone number, and home address.</li>
                        <li><strong class="text-slate-800">Academic Information:</strong> Student ID number, course/program, year level, assigned classes, grades, and submitted activities or projects.</li>
                        <li><strong class="text-slate-800">System Usage / Technical Data:</strong> Login timestamps, IP address, activity within the system, downloaded or viewed materials, and messages or discussions inside LMS forums.</li>
                    </ul>
                </div>

                <!-- 2. Purpose of Processing -->
                <div class="bg-white p-4 sm:p-5 rounded-xl border border-slate-200/80 shadow-sm">
                    <h4 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2 mb-2">
                        <span class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-black">2</span>
                        Purpose of Processing
                    </h4>
                    <p class="text-slate-600 mb-2.5">Your information will be used solely for the following legitimate educational and administrative purposes:</p>
                    <ul class="list-disc pl-5 space-y-1.5 text-slate-600">
                        <li>Creation and management of your official LMS account.</li>
                        <li>Dissemination of announcements from teachers, departments, or the school administration.</li>
                        <li>Facilitating online classes, quizzes, exams, grading, and tracking your academic progress.</li>
                        <li>Ensuring system security, troubleshooting technical problems, and fraud prevention.</li>
                        <li>Generating statistics or reports required by government agencies (such as CHED, DepEd, or TESDA) as mandated by law.</li>
                    </ul>
                </div>

                <!-- 3. Sharing and Disclosure -->
                <div class="bg-white p-4 sm:p-5 rounded-xl border border-slate-200/80 shadow-sm">
                    <h4 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2 mb-2">
                        <span class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-black">3</span>
                        Sharing and Disclosure
                    </h4>
                    <p class="text-slate-600 mb-2.5">Your personal data will be treated as confidential. However, it may be shared with the following individuals or groups for the aforementioned purposes:</p>
                    <ul class="list-disc pl-5 space-y-1.5 text-slate-600">
                        <li><strong class="text-slate-800">Instructors and Professors:</strong> For class management and grading.</li>
                        <li><strong class="text-slate-800">School Administration and IT Support:</strong> For system maintenance and technical support.</li>
                        <li><strong class="text-slate-800">Classmates:</strong> For collaborative tasks, group projects, and system forums (limited strictly to names and profiles).</li>
                    </ul>
                    <div class="mt-3 p-3 rounded-lg bg-indigo-50/70 border border-indigo-100 text-indigo-900 text-xs font-semibold flex items-center gap-2">
                        <i class="fas fa-lock text-indigo-600"></i>
                        <span>Note: We will <strong class="underline">never</strong> sell, lease, or give away your personal data to third parties unrelated to the institution.</span>
                    </div>
                </div>

                <!-- 4. Data Retention -->
                <div class="bg-white p-4 sm:p-5 rounded-xl border border-slate-200/80 shadow-sm">
                    <h4 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2 mb-2">
                        <span class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-black">4</span>
                        Data Retention
                    </h4>
                    <ul class="list-disc pl-5 space-y-1.5 text-slate-600">
                        <li>Your information will be securely stored in our databases or cloud servers with high-level security measures.</li>
                        <li>Your data will be retained throughout the duration of your studies in the institution. After your graduation or separation from the school, your data will be archived or securely disposed of in accordance with the school's data retention policy and government regulations.</li>
                    </ul>
                </div>

                <!-- 5. Rights of the Data Subject -->
                <div class="bg-white p-4 sm:p-5 rounded-xl border border-slate-200/80 shadow-sm">
                    <h4 class="text-sm sm:text-base font-bold text-slate-900 flex items-center gap-2 mb-2">
                        <span class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs font-black">5</span>
                        Rights of the Data Subject
                    </h4>
                    <p class="text-slate-600 mb-2.5">In accordance with the DPA of 2012, you have the right to:</p>
                    <ul class="list-disc pl-5 space-y-1.5 text-slate-600">
                        <li><strong class="text-slate-800">Right to be Informed:</strong> To know how your data is being collected and processed.</li>
                        <li><strong class="text-slate-800">Right to Access:</strong> To request a copy or summary of your personal data in our possession.</li>
                        <li><strong class="text-slate-800">Right to Rectification:</strong> To update or correct any incorrect information in your account.</li>
                        <li><strong class="text-slate-800">Right to Erasure or Blocking:</strong> To have your data deleted or blocked under reasonable conditions.</li>
                        <li><strong class="text-slate-800">Right to Lodge a Complaint:</strong> To file a complaint with the National Privacy Commission if our institution violates your privacy rights.</li>
                    </ul>
                </div>
            </div>

            <!-- Section 6: Declaration and Click-Through Consent -->
            <div class="p-5 sm:p-6 rounded-2xl bg-indigo-50/60 border-2 border-indigo-200/80 space-y-4 mb-6">
                <div class="flex items-center justify-between flex-wrap gap-2 pb-3 border-b border-indigo-200/60">
                    <h4 class="text-sm sm:text-base font-black text-indigo-950 flex items-center gap-2">
                        <i class="fas fa-file-signature text-indigo-600"></i>
                        6. Declaration and Click-Through Consent
                    </h4>
                    <span class="text-xs font-bold text-indigo-600 bg-white px-2.5 py-1 rounded-full border border-indigo-200">
                        Mandatory Review
                    </span>
                </div>
                <p class="text-xs sm:text-sm text-slate-600 italic">
                    Please review and check the required boxes below to proceed with your registration:
                </p>

                <!-- Checkbox 1: General Consent (Required) -->
                <label id="labelConsentGeneral" class="flex items-start gap-3 p-3.5 rounded-xl bg-white border border-slate-200 cursor-pointer hover:border-indigo-400 transition-all select-none">
                    <input type="checkbox" id="consentGeneral" class="mt-1 w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer flex-shrink-0" onchange="clearConsentError()">
                    <div class="text-xs sm:text-sm leading-relaxed text-slate-700">
                        <span class="font-extrabold text-slate-900 block mb-0.5">
                            General Consent <span class="text-rose-600 font-black text-xs uppercase bg-rose-50 px-2 py-0.5 rounded border border-rose-200 ml-1">Required</span>
                        </span>
                        <em>"I have read and understood this Privacy Notice. I voluntarily give my consent to Mabini Colleges Inc. to collect, process, and use my personal data for the purposes stated above."</em>
                    </div>
                </label>

                <!-- Checkbox 2: For Communications (Required) -->
                <label id="labelConsentComms" class="flex items-start gap-3 p-3.5 rounded-xl bg-white border border-slate-200 cursor-pointer hover:border-indigo-400 transition-all select-none">
                    <input type="checkbox" id="consentComms" class="mt-1 w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer flex-shrink-0" onchange="clearConsentError()">
                    <div class="text-xs sm:text-sm leading-relaxed text-slate-700">
                        <span class="font-extrabold text-slate-900 block mb-0.5">
                            For Communications <span class="text-rose-600 font-black text-xs uppercase bg-rose-50 px-2 py-0.5 rounded border border-rose-200 ml-1">Required</span>
                        </span>
                        <em>"I also agree to receive official announcements and notifications via my email and mobile number regarding school activities."</em>
                    </div>
                </label>

                <!-- Checkbox 3: Parent/Guardian Consent (Optional / Under 18) -->
                <label id="labelConsentGuardian" class="flex items-start gap-3 p-3.5 rounded-xl bg-white border border-slate-200 cursor-pointer hover:border-indigo-400 transition-all select-none">
                    <input type="checkbox" id="consentGuardian" class="mt-1 w-5 h-5 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer flex-shrink-0">
                    <div class="text-xs sm:text-sm leading-relaxed text-slate-700">
                        <span class="font-bold text-slate-800 block mb-0.5">
                            Parent/Guardian Consent <span class="text-slate-500 font-normal text-xs bg-slate-100 px-2 py-0.5 rounded border border-slate-200 ml-1">If student is under 18 years old</span>
                        </span>
                        <em>"I am the parent or legal guardian of the registering student, and I authorize the implementation of this data privacy consent for their LMS account."</em>
                    </div>
                </label>
            </div>

            <!-- Error Banner if Unchecked -->
            <div id="consentErrorBanner" class="hidden mb-6 p-4 rounded-2xl bg-rose-50 border border-rose-300 text-rose-800 text-xs sm:text-sm flex items-start gap-3 shadow-sm">
                <i class="fas fa-circle-exclamation text-rose-600 text-base flex-shrink-0 mt-0.5"></i>
                <div class="flex-1 font-semibold leading-relaxed">
                    You cannot proceed to set up your account without consenting to both required items (General Consent and Communications). Please check both required checkboxes to continue, or click "I Do Not Agree" to cancel and exit to login.
                </div>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col-reverse sm:flex-row items-center justify-between gap-4 pt-4 border-t border-slate-100">
                <button type="button" onclick="promptDeclineConsent()" class="w-full sm:w-auto px-6 py-3.5 rounded-2xl bg-slate-100 hover:bg-rose-50 hover:text-rose-700 text-slate-600 font-bold text-xs sm:text-sm transition flex items-center justify-center gap-2">
                    <i class="fas fa-times-circle"></i>
                    <span>I Do Not Agree (Exit)</span>
                </button>

                <button type="button" onclick="submitConsent()" class="w-full sm:w-auto px-8 py-4 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold text-sm shadow-xl shadow-indigo-300 transition transform active:scale-95 flex items-center justify-center gap-2">
                    <span>I Agree & Proceed to Account Setup</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </div>
        </section>

        <!-- LIVE STEP TIMELINE HEADER -->
        <nav id="registrationTimelineNav" aria-label="Registration Timeline" class="hidden bg-white rounded-3xl p-4 sm:p-6 shadow-2xl shadow-black/40 border border-white/20 mb-8">
            <!-- Progress Percentage -->
            <div class="flex items-center justify-between text-xs font-bold uppercase tracking-wider text-slate-400 mb-2">
                <span>Timeline Progress</span>
                <span id="progressPercent" class="text-indigo-600 font-mono text-sm">25% Complete</span>
            </div>
            
            <!-- Progress Bar Track -->
            <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden mb-6">
                <div id="progressBar" class="bg-gradient-to-r from-indigo-500 to-purple-600 h-full rounded-full transition-all duration-500 ease-out" style="width: 25%;"></div>
            </div>

            <!-- Steps Grid -->
            <div class="grid grid-cols-4 gap-2 sm:gap-4 relative">
                <!-- Step 1 Button -->
                <button type="button" onclick="goToStep(1)" id="stepBtn1" class="step-btn text-center group focus:outline-none transition">
                    <div id="stepCircle1" class="w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-bold text-sm sm:text-base shadow-md shadow-indigo-200 transition-all duration-300">
                        <i class="fas fa-user"></i>
                    </div>
                    <p id="stepLabel1" class="text-xs sm:text-sm font-bold text-indigo-600 mt-2 truncate">1. Identity</p>
                    <p class="text-[10px] text-slate-400 hidden sm:block">Full Name</p>
                </button>

                <!-- Step 2 Button -->
                <button type="button" onclick="goToStep(2)" id="stepBtn2" class="step-btn text-center group focus:outline-none transition">
                    <div id="stepCircle2" class="w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-slate-100 text-slate-400 border border-slate-200 flex items-center justify-center font-bold text-sm sm:text-base transition-all duration-300">
                        <i class="fas <%= user.role === 'Student' ? 'fa-graduation-cap' : 'fa-chalkboard-user' %>"></i>
                    </div>
                    <p id="stepLabel2" class="text-xs sm:text-sm font-semibold text-slate-400 mt-2 truncate">2. Academic</p>
                    <p class="text-[10px] text-slate-400 hidden sm:block"><%= user.role === 'Student' ? 'LRN & Strand' : 'Staff Info' %></p>
                </button>

                <!-- Step 3 Button -->
                <button type="button" onclick="goToStep(3)" id="stepBtn3" class="step-btn text-center group focus:outline-none transition">
                    <div id="stepCircle3" class="w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-slate-100 text-slate-400 border border-slate-200 flex items-center justify-center font-bold text-sm sm:text-base transition-all duration-300">
                        <i class="fas fa-address-book"></i>
                    </div>
                    <p id="stepLabel3" class="text-xs sm:text-sm font-semibold text-slate-400 mt-2 truncate">3. Contact</p>
                    <p class="text-[10px] text-slate-400 hidden sm:block">Phone & Bio</p>
                </button>

                <!-- Step 4 Button -->
                <button type="button" onclick="goToStep(4)" id="stepBtn4" class="step-btn text-center group focus:outline-none transition">
                    <div id="stepCircle4" class="w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-slate-100 text-slate-400 border border-slate-200 flex items-center justify-center font-bold text-sm sm:text-base transition-all duration-300">
                        <i class="fas fa-id-badge"></i>
                    </div>
                    <p id="stepLabel4" class="text-xs sm:text-sm font-semibold text-slate-400 mt-2 truncate">4. Arcade Pass</p>
                    <p class="text-[10px] text-slate-400 hidden sm:block">Avatar & QR</p>
                </button>
            </div>
        </nav>

        <!-- MAIN ONBOARDING FORM -->
        <main id="onboardingMain" class="hidden">
            <form id="onboardingForm" action="/finalize-profile" method="POST" enctype="multipart/form-data" novalidate>
                <input type="hidden" name="remove_avatar" id="removeAvatarFlag" value="0">
                <input type="hidden" name="dpa_consent_general" id="inpDpaGeneral" value="0">
                <input type="hidden" name="dpa_consent_comms" id="inpDpaComms" value="0">
                <input type="hidden" name="dpa_consent_guardian" id="inpDpaGuardian" value="0">
                <input type="hidden" name="dpa_consent_timestamp" id="inpDpaTimestamp" value="">

                <!-- ========================================== -->
                <!-- STEP 1: PERSONAL IDENTITY                 -->
                <!-- ========================================== -->
                <section id="stepPanel1" class="step-panel bg-white rounded-3xl p-6 sm:p-8 shadow-2xl shadow-black/40 border border-white/20">
                    <div class="flex items-center gap-3 pb-4 mb-6 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg font-black">
                            1
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-slate-800">Personal Identity</h2>
                            <p class="text-xs text-slate-400">Please provide your official legal name as registered in school records.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <!-- First Name -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpFirstName">
                                First Name <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="first_name" id="inpFirstName" required
                                   value="<%= user.first_name || '' %>"
                                   placeholder="e.g. Juan"
                                   oninput="updatePreviewCard(); clearFieldError(this)"
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800">
                            <p class="field-error hidden text-[11px] text-rose-500 font-semibold mt-1">First name is required.</p>
                        </div>

                        <!-- Middle Name -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpMiddleName">
                                Middle Name <span class="text-slate-400 font-normal lowercase">(optional)</span>
                            </label>
                            <input type="text" name="middle_name" id="inpMiddleName"
                                   value="<%= user.middle_name || '' %>"
                                   placeholder="e.g. Santos"
                                   oninput="updatePreviewCard()"
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800">
                        </div>

                        <!-- Last Name -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpLastName">
                                Last Name <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" name="last_name" id="inpLastName" required
                                   value="<%= user.last_name || '' %>"
                                   placeholder="e.g. Dela Cruz"
                                   oninput="updatePreviewCard(); clearFieldError(this)"
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800">
                            <p class="field-error hidden text-[11px] text-rose-500 font-semibold mt-1">Last name is required.</p>
                        </div>

                        <!-- Suffix -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpSuffix">
                                Suffix <span class="text-slate-400 font-normal lowercase">(optional)</span>
                            </label>
                            <input type="text" name="suffix" id="inpSuffix"
                                   value="<%= user.suffix || '' %>"
                                   placeholder="e.g. Jr., III"
                                   oninput="updatePreviewCard()"
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800">
                        </div>

                        <!-- Sex -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpSex">
                                Sex
                            </label>
                            <select name="sex" id="inpSex"
                                    class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800 bg-white">
                                <option value="" <%= !user.sex ? 'selected' : '' %>>Select Sex</option>
                                <option value="Male" <%= user.sex === 'Male' ? 'selected' : '' %>>Male</option>
                                <option value="Female" <%= user.sex === 'Female' ? 'selected' : '' %>>Female</option>
                                <option value="Other" <%= user.sex === 'Other' ? 'selected' : '' %>>Other</option>
                                <option value="Prefer not to say" <%= user.sex === 'Prefer not to say' ? 'selected' : '' %>>Prefer not to say</option>
                            </select>
                        </div>

                        <!-- Birthdate -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpBirthdate">
                                Birthdate
                            </label>
                            <input type="date" name="birthdate" id="inpBirthdate"
                                   value="<%= user.birthdate ? new Date(user.birthdate).toISOString().split('T')[0] : '' %>"
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800 bg-white">
                        </div>
                    </div>

                    <!-- Collapsible Phonetics -->
                    <div class="mt-6 pt-5 border-t border-slate-100">
                        <button type="button" onclick="toggleDetails('phoneticsSection', this)" class="flex items-center gap-2 text-xs font-bold text-indigo-600 hover:text-indigo-800 transition">
                            <i class="fas fa-volume-high"></i>
                            <span>Phonetic Pronunciation Guide (Help Teachers Pronounce Your Name)</span>
                            <i class="fas fa-chevron-down text-[10px] ml-1 transition-transform"></i>
                        </button>
                        <div id="phoneticsSection" class="hidden grid grid-cols-1 md:grid-cols-3 gap-4 mt-4 bg-slate-50 p-4 rounded-2xl border border-slate-200/60">
                            <div>
                                <label class="text-[10px] font-bold uppercase text-slate-500">First Name Phonetic</label>
                                <input type="text" name="fname_phonetic" value="<%= user.first_name_phonetic || '' %>" placeholder="e.g. Hwan" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 outline-none focus:border-indigo-500">
                            </div>
                            <div>
                                <label class="text-[10px] font-bold uppercase text-slate-500">Middle Name Phonetic</label>
                                <input type="text" name="mname_phonetic" value="<%= user.middle_name_phonetic || '' %>" placeholder="e.g. San-tos" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 outline-none focus:border-indigo-500">
                            </div>
                            <div>
                                <label class="text-[10px] font-bold uppercase text-slate-500">Last Name Phonetic</label>
                                <input type="text" name="lname_phonetic" value="<%= user.last_name_phonetic || '' %>" placeholder="e.g. De-la Kroos" class="w-full px-3 py-2 text-xs rounded-lg border border-slate-200 outline-none focus:border-indigo-500">
                            </div>
                        </div>
                    </div>

                    <!-- Step 1 Nav -->
                    <div class="mt-8 flex justify-end">
                        <button type="button" onclick="validateAndNext(1)" class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-lg shadow-indigo-200 transition active:scale-95 flex items-center justify-center gap-2">
                            <span>Next: Academic Profile</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </section>

                <!-- ========================================== -->
                <!-- STEP 2: ACADEMIC PROFILE                  -->
                <!-- ========================================== -->
                <section id="stepPanel2" class="step-panel hidden bg-white rounded-3xl p-6 sm:p-8 shadow-2xl shadow-black/40 border border-white/20">
                    <div class="flex items-center gap-3 pb-4 mb-6 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg font-black">
                            2
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-slate-800">
                                <%= user.role === 'Student' ? 'Academic Information' : 'Institutional & Department Info' %>
                            </h2>
                            <p class="text-xs text-slate-400">
                                <%= user.role === 'Student' ? 'Enter your Mabini Colleges student enrollment details.' : 'Specify your department and faculty identification.' %>
                            </p>
                        </div>
                    </div>

                    <% if (user.role === 'Student') { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <!-- LRN Number -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpLrn">
                                    Learner Reference Number (LRN) <span class="text-rose-500">*</span>
                                </label>
                                <input type="text" name="lrn_number" id="inpLrn" required maxlength="12"
                                       value="<%= user.lrn_number || '' %>"
                                       placeholder="12-digit student LRN"
                                       oninput="formatLrn(this); updatePreviewCard(); clearFieldError(this)"
                                       class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-mono text-slate-800">
                                <p class="field-error hidden text-[11px] text-rose-500 font-semibold mt-1">LRN must be exactly 12 digits.</p>
                                <p class="text-[11px] text-slate-400 mt-1">Official DepEd LRN (numbers only, exactly 12 digits).</p>
                            </div>

                            <!-- Grade Level -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpGradeLevel">
                                    Grade Level <span class="text-rose-500">*</span>
                                </label>
                                <select name="grade_level" id="inpGradeLevel" required
                                        onchange="updatePreviewCard(); clearFieldError(this)"
                                        class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800 bg-white">
                                    <option value="" <%= !user.grade_level ? 'selected' : '' %>>Select Grade Level</option>
                                    <option value="Grade 11" <%= (user.grade_level === 'Grade 11' || user.grade_level == '11') ? 'selected' : '' %>>Grade 11</option>
                                    <option value="Grade 12" <%= (user.grade_level === 'Grade 12' || user.grade_level == '12') ? 'selected' : '' %>>Grade 12</option>
                                    <option value="Grade 10" <%= (user.grade_level === 'Grade 10' || user.grade_level == '10') ? 'selected' : '' %>>Grade 10</option>
                                    <option value="Grade 9" <%= (user.grade_level === 'Grade 9' || user.grade_level == '9') ? 'selected' : '' %>>Grade 9</option>
                                </select>
                                <p class="field-error hidden text-[11px] text-rose-500 font-semibold mt-1">Please select your grade level.</p>
                            </div>

                            <!-- Track -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpStrand">
                                    Track <span class="text-rose-500">*</span>
                                </label>
                                <input type="text" name="strand" id="inpStrand" required readonly
                                       value="<%= user.strand || 'Academic Track' %>"
                                       class="w-full px-4 py-3 rounded-xl border border-slate-200 bg-slate-50 text-slate-700 font-semibold cursor-not-allowed">
                                <p class="text-[11px] text-slate-400 mt-1">Curriculum: Academic Track</p>
                            </div>

                            <!-- Section -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpSection">
                                    Class Section <span class="text-rose-500">*</span>
                                </label>
                                <input type="text" name="section" id="inpSection" required
                                       value="<%= user.section || '' %>"
                                       placeholder="e.g. Atom, Molecule, Archimedes"
                                       oninput="updatePreviewCard(); clearFieldError(this)"
                                       class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800">
                                <p class="field-error hidden text-[11px] text-rose-500 font-semibold mt-1">Section name is required.</p>
                            </div>

                            <!-- Institution Badge -->
                            <div class="md:col-span-2 p-3.5 bg-indigo-50/60 rounded-2xl border border-indigo-100 flex items-center gap-3">
                                <i class="fas fa-school text-indigo-500 text-lg"></i>
                                <div>
                                    <p class="text-xs font-bold text-slate-700">Official Institution: Mabini Colleges Inc.</p>
                                    <p class="text-[11px] text-slate-500">Your profile is affiliated with the Chemistry Arcade Laboratory network.</p>
                                </div>
                            </div>
                        </div>
                    <% } else { %>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                            <!-- Faculty ID -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpFacultyId">
                                    Faculty / Employee ID <span class="text-rose-500">*</span>
                                </label>
                                <input type="text" name="faculty_id" id="inpFacultyId" required
                                       value="<%= user.faculty_id || '' %>"
                                       placeholder="e.g. FAC-2026-001"
                                       oninput="updatePreviewCard(); clearFieldError(this)"
                                       class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-mono text-slate-800">
                                <p class="field-error hidden text-[11px] text-rose-500 font-semibold mt-1">Faculty ID is required.</p>
                            </div>

                            <!-- Department -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpDepartment">
                                    Department <span class="text-rose-500">*</span>
                                </label>
                                <input type="text" name="department" id="inpDepartment" required
                                       value="<%= user.department || 'Science Department' %>"
                                       placeholder="e.g. Science Dept, SHS STEM"
                                       oninput="updatePreviewCard(); clearFieldError(this)"
                                       class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800">
                                <p class="field-error hidden text-[11px] text-rose-500 font-semibold mt-1">Department is required.</p>
                            </div>
                        </div>
                    <% } %>

                    <!-- Step 2 Nav -->
                    <div class="mt-8 flex items-center justify-between">
                        <button type="button" onclick="goToStep(1)" class="px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition">
                            <i class="fas fa-arrow-left mr-1.5"></i> Back
                        </button>
                        <button type="button" onclick="validateAndNext(2)" class="px-8 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-lg shadow-indigo-200 transition active:scale-95 flex items-center gap-2">
                            <span>Next: Contact Details</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </section>

                <!-- ========================================== -->
                <!-- STEP 3: CONTACT & PREFERENCES             -->
                <!-- ========================================== -->
                <section id="stepPanel3" class="step-panel hidden bg-white rounded-3xl p-6 sm:p-8 shadow-2xl shadow-black/40 border border-white/20">
                    <div class="flex items-center gap-3 pb-4 mb-6 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg font-black">
                            3
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-slate-800">Contact & Preferences</h2>
                            <p class="text-xs text-slate-400">Add your contact info, gamertag for leaderboards, and science interests.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                        <!-- Mobile Number -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpMobile">
                                Mobile Number <span class="text-slate-400 font-normal lowercase">(for urgent notifications)</span>
                            </label>
                            <div class="relative">
                                <span class="absolute inset-y-0 left-0 pl-3.5 flex items-center text-slate-400 text-xs font-mono font-bold">+63</span>
                                <input type="tel" name="mobile" id="inpMobile"
                                       value="<%= user.mobile_number || '' %>"
                                       placeholder="9123456789 or 09123456789"
                                       class="w-full pl-12 pr-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-mono text-slate-800">
                            </div>
                            <p class="text-[11px] text-slate-400 mt-1">PH mobile format (e.g. 09XXXXXXXXX)</p>
                        </div>

                        <!-- City / Municipality -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpCity">
                                City / Municipality
                            </label>
                            <input type="text" name="city_town" id="inpCity"
                                   value="<%= user.city_town || '' %>"
                                   placeholder="e.g. Daet, Camarines Norte"
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800">
                        </div>

                        <!-- Gamertag / Alternative Name -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-indigo-600 mb-1.5 flex items-center gap-1.5" for="inpAltName">
                                <i class="fas fa-gamepad"></i>
                                Gamertag / Nickname
                            </label>
                            <input type="text" name="alt_name" id="inpAltName"
                                   value="<%= user.alternative_name || '' %>"
                                   placeholder="e.g. ChemPro99, Quasar"
                                   oninput="updatePreviewCard()"
                                   class="w-full px-4 py-3 rounded-xl border border-indigo-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-bold text-indigo-900 bg-indigo-50/20">
                            <p class="text-[11px] text-slate-400 mt-1">Displayed on arcade battle scoreboards & leaderboards.</p>
                        </div>

                        <!-- Interests / Tags -->
                        <div>
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpInterests">
                                Interests & Science Topics
                            </label>
                            <input type="text" name="interests" id="inpInterests"
                                   value="<%= user.interests || '' %>"
                                   placeholder="Organic Chem, Gaming, Robotics"
                                   class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800">
                            <p class="text-[11px] text-slate-400 mt-1">Separate keywords with commas.</p>
                        </div>

                        <!-- Full Home Address -->
                        <div class="md:col-span-2">
                            <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpAddress">
                                Home Address
                            </label>
                            <textarea name="address" id="inpAddress" rows="2"
                                      placeholder="Barangay, Street, Municipality, Province"
                                      class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800"><%= user.home_address || '' %></textarea>
                        </div>
                    </div>

                    <!-- Step 3 Nav -->
                    <div class="mt-8 flex items-center justify-between">
                        <button type="button" onclick="goToStep(2)" class="px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition">
                            <i class="fas fa-arrow-left mr-1.5"></i> Back
                        </button>
                        <button type="button" onclick="validateAndNext(3)" class="px-8 py-3.5 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-sm shadow-lg shadow-indigo-200 transition active:scale-95 flex items-center gap-2">
                            <span>Next: Avatar & Arcade Pass</span>
                            <i class="fas fa-arrow-right"></i>
                        </button>
                    </div>
                </section>

                <!-- ========================================== -->
                <!-- STEP 4: AVATAR & ARCADE PASS CONFIRMATION  -->
                <!-- ========================================== -->
                <section id="stepPanel4" class="step-panel hidden bg-white rounded-3xl p-6 sm:p-8 shadow-2xl shadow-black/40 border border-white/20">
                    <div class="flex items-center gap-3 pb-4 mb-6 border-b border-slate-100">
                        <div class="w-10 h-10 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-lg font-black">
                            4
                        </div>
                        <div>
                            <h2 class="text-xl font-bold text-slate-800">Avatar & Chemistry Arcade Pass</h2>
                            <p class="text-xs text-slate-400">Review your Chemistry Arcade Pass and upload your profile picture.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
                        <!-- Left Column: Photo Upload & Bio -->
                        <div class="lg:col-span-6 space-y-5">
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-2">
                                    Profile Picture
                                </label>
                                <div class="flex items-center gap-4">
                                    <div class="relative group">
                                        <div class="w-24 h-24 sm:w-28 sm:h-28 rounded-2xl bg-slate-100 border-2 border-slate-200 overflow-hidden shadow-inner flex items-center justify-center text-slate-300">
                                            <img id="avatarPreview"
                                                 src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                                                 onerror="this.src='/profile_uploads/default_avatar.png'"
                                                 alt="Profile Avatar"
                                                 class="w-full h-full object-cover">
                                        </div>
                                        <label for="profileFileInput" class="absolute -bottom-2 -right-2 bg-indigo-600 hover:bg-indigo-700 text-white p-2.5 rounded-xl shadow-md cursor-pointer transition transform active:scale-95" title="Change photo">
                                            <i class="fas fa-camera text-xs"></i>
                                        </label>
                                        <input type="file" name="profilePic" id="profileFileInput" class="hidden" accept="image/*" onchange="handleAvatarSelected(this)">
                                    </div>

                                    <div class="flex-1 space-y-1">
                                        <p class="text-xs font-bold text-slate-700">Upload high-res badge photo</p>
                                        <p class="text-[11px] text-slate-400">JPG, PNG, GIF or WebP up to 2MB.</p>
                                        <div class="flex items-center gap-3 pt-2">
                                            <label for="profileFileInput" class="text-xs font-bold text-indigo-600 hover:underline cursor-pointer">Choose File</label>
                                            <span class="text-slate-300">|</span>
                                            <button type="button" onclick="removeAvatarImage()" class="text-xs font-bold text-rose-500 hover:underline">Remove</button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Picture Description -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpPicDesc">
                                    Photo Description <span class="text-slate-400 font-normal lowercase">(accessibility alt text)</span>
                                </label>
                                <input type="text" name="pic_description" id="inpPicDesc"
                                       value="<%= user.pic_description || '' %>"
                                       placeholder="e.g. Juan smiling in school uniform"
                                       class="w-full px-4 py-2.5 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none text-xs text-slate-800">
                            </div>

                            <!-- Self Description / Bio -->
                            <div>
                                <label class="block text-xs font-bold uppercase tracking-wider text-slate-600 mb-1.5" for="inpBio">
                                    Self Description / Bio
                                </label>
                                <textarea name="self_description" id="inpBio" rows="3"
                                          placeholder="Share a short bio or motto (e.g. Aspiring Chemical Engineer, ready for the leaderboard!)."
                                          class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:border-indigo-500 focus:ring-4 focus:ring-indigo-100 transition outline-none font-medium text-slate-800 text-sm"><%= user.self_description || '' %></textarea>
                            </div>
                        </div>

                        <!-- Right Column: LIVE CHEMISTRY ARCADE BADGE PREVIEW -->
                        <div class="lg:col-span-6">
                            <label class="block text-xs font-bold uppercase tracking-wider text-indigo-700 mb-2 flex items-center justify-between">
                                <span><i class="fas fa-sparkles text-amber-400 mr-1"></i> Live Arcade Pass Preview</span>
                                <span class="text-[10px] text-slate-400 font-mono">CHEMISTRY-ARCADE-ID</span>
                            </label>

                            <div class="arcade-card-glass rounded-3xl p-6 border-2 border-indigo-100 shadow-xl relative overflow-hidden neon-glow">
                                <!-- Top Accent Banner -->
                                <div class="absolute -top-12 -right-12 w-32 h-32 bg-indigo-500/10 rounded-full blur-xl pointer-events-none"></div>

                                <div class="flex items-start justify-between mb-4 pb-3 border-b border-slate-200/60">
                                    <div class="flex items-center gap-2">
                                        <div class="w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-xs shadow-sm">
                                            ⚗️
                                        </div>
                                        <div>
                                            <p class="text-[10px] font-bold text-indigo-600 uppercase tracking-widest leading-none">Mabini Colleges</p>
                                            <h3 class="text-sm font-black text-slate-900 leading-tight">Chemistry Arcade Pass</h3>
                                        </div>
                                    </div>
                                    <span class="px-2.5 py-0.5 rounded-full text-[10px] font-extrabold uppercase tracking-wider <%= user.role === 'Student' ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-100 text-emerald-700' %>">
                                        <%= user.role %>
                                    </span>
                                </div>

                                <div class="flex gap-4 items-center mb-5">
                                    <div class="w-16 h-16 rounded-2xl bg-white border border-slate-200 shadow-sm overflow-hidden flex-shrink-0">
                                        <img id="badgeAvatarPreview"
                                             src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                                             onerror="this.src='/profile_uploads/default_avatar.png'"
                                             class="w-full h-full object-cover">
                                    </div>
                                    <div class="min-w-0">
                                        <p id="badgeFullName" class="font-extrabold text-slate-900 text-base truncate">
                                            <%= (user.first_name || user.last_name) ? `${user.first_name || ''} ${user.last_name || ''}`.trim() : 'Your Name Here' %>
                                        </p>
                                        <p id="badgeGamertag" class="text-xs font-bold text-indigo-600 font-mono truncate">
                                            @<%= user.alternative_name || 'Gamertag' %>
                                        </p>
                                        <p id="badgeAcademicMeta" class="text-[11px] text-slate-500 font-medium truncate mt-0.5">
                                            <%= user.role === 'Student' ? `${user.grade_level || 'Grade Level'} • ${user.strand || 'Strand'} • ${user.section || 'Section'}` : (user.department || 'Science Dept') %>
                                        </p>
                                    </div>
                                </div>

                                <!-- QR Access Pass Box -->
                                <div class="bg-white p-3.5 rounded-2xl border border-slate-200/80 flex items-center gap-4 shadow-sm">
                                    <div class="w-20 h-20 bg-slate-50 rounded-xl border border-slate-100 p-1 flex items-center justify-center flex-shrink-0">
                                        <% if (locals.qrCodeData) { %>
                                            <img src="<%= locals.qrCodeData %>" alt="Arcade QR Pass" class="w-full h-full object-contain">
                                        <% } else { %>
                                            <i class="fas fa-qrcode text-3xl text-slate-300"></i>
                                        <% } %>
                                    </div>
                                    <div class="flex-1 min-w-0">
                                        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Hardware Station Pass</p>
                                        <p class="text-xs font-mono font-bold text-slate-700 truncate mt-0.5">
                                            <%= user.qr_code_token || 'TOKEN-ACTIVE' %>
                                        </p>
                                        <p class="text-[10px] text-emerald-600 font-semibold mt-1 flex items-center gap-1">
                                            <i class="fas fa-shield-check"></i> Ready for scan-to-login
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 4 Nav & Submit -->
                    <div class="mt-8 pt-6 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-4">
                        <button type="button" onclick="goToStep(3)" class="w-full sm:w-auto px-6 py-3 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition">
                            <i class="fas fa-arrow-left mr-1.5"></i> Back
                        </button>

                        <button type="submit" id="submitBtn" class="w-full sm:w-auto px-10 py-4 rounded-2xl bg-indigo-600 hover:bg-indigo-700 text-white font-black text-sm shadow-xl shadow-indigo-300 transition transform active:scale-95 flex items-center justify-center gap-3">
                            <i class="fas fa-check-circle text-lg"></i>
                            <span id="submitBtnText">Confirm & Finalize Profile</span>
                            <i id="submitSpinner" class="fas fa-circle-notch fa-spin hidden"></i>
                        </button>
                    </div>
                </section>
            </form>
        </main>
    </div>

    <!-- Minimal Footer -->
    <footer class="text-center py-6 text-xs text-slate-400 font-medium">
        &copy; <%= new Date().getFullYear() %> Chemistry Arcade LMS • Mabini Colleges. All rights reserved.
    </footer>

    <!-- INTERACTIVE STEP CONTROLLER SCRIPT -->
    <script>
        let currentStep = 1;
        const totalSteps = 4;
        const userRole = "<%= user.role %>";

        function updateTimelineUI(step) {
            // Update percentage
            const percent = Math.round((step / totalSteps) * 100);
            document.getElementById('progressBar').style.width = percent + '%';
            document.getElementById('progressPercent').innerText = percent + '% Complete';

            for (let i = 1; i <= totalSteps; i++) {
                const circle = document.getElementById('stepCircle' + i);
                const label = document.getElementById('stepLabel' + i);
                const panel = document.getElementById('stepPanel' + i);

                if (i === step) {
                    // Active Step
                    panel.classList.remove('hidden');
                    circle.className = 'w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-bold text-sm sm:text-base shadow-lg shadow-indigo-200 ring-4 ring-indigo-100 transition-all duration-300';
                    circle.innerHTML = `<i class="fas ${getStepIcon(i)}"></i>`;
                    label.className = 'text-xs sm:text-sm font-extrabold text-indigo-600 mt-2 truncate';
                } else if (i < step) {
                    // Completed Step
                    panel.classList.add('hidden');
                    circle.className = 'w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-emerald-500 text-white flex items-center justify-center font-bold text-sm sm:text-base shadow-sm transition-all duration-300';
                    circle.innerHTML = '<i class="fas fa-check"></i>';
                    label.className = 'text-xs sm:text-sm font-semibold text-emerald-600 mt-2 truncate';
                } else {
                    // Upcoming Step
                    panel.classList.add('hidden');
                    circle.className = 'w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-slate-100 text-slate-400 border border-slate-200 flex items-center justify-center font-bold text-sm sm:text-base transition-all duration-300';
                    circle.innerHTML = `<i class="fas ${getStepIcon(i)}"></i>`;
                    label.className = 'text-xs sm:text-sm font-semibold text-slate-400 mt-2 truncate';
                }
            }

            // Scroll to top of panel smoothly
            window.scrollTo({ top: 120, behavior: 'smooth' });
        }

        function getStepIcon(stepNumber) {
            switch(stepNumber) {
                case 1: return 'fa-user';
                case 2: return userRole === 'Student' ? 'fa-graduation-cap' : 'fa-chalkboard-user';
                case 3: return 'fa-address-book';
                case 4: return 'fa-id-badge';
                default: return 'fa-circle';
            }
        }

        function validateStep(step) {
            let isValid = true;

            if (step === 1) {
                const fname = document.getElementById('inpFirstName');
                const lname = document.getElementById('inpLastName');

                if (!fname.value.trim()) {
                    showFieldError(fname);
                    isValid = false;
                } else {
                    clearFieldError(fname);
                }

                if (!lname.value.trim()) {
                    showFieldError(lname);
                    isValid = false;
                } else {
                    clearFieldError(lname);
                }
            } else if (step === 2) {
                if (userRole === 'Student') {
                    const lrn = document.getElementById('inpLrn');
                    const grade = document.getElementById('inpGradeLevel');
                    const strand = document.getElementById('inpStrand');
                    const section = document.getElementById('inpSection');

                    // LRN must be 12 digits
                    if (!lrn.value.trim() || !/^\d{12}$/.test(lrn.value.trim())) {
                        showFieldError(lrn);
                        isValid = false;
                    } else {
                        clearFieldError(lrn);
                    }

                    if (!grade.value) {
                        showFieldError(grade);
                        isValid = false;
                    } else {
                        clearFieldError(grade);
                    }

                    if (!strand.value) {
                        showFieldError(strand);
                        isValid = false;
                    } else {
                        clearFieldError(strand);
                    }

                    if (!section.value.trim()) {
                        showFieldError(section);
                        isValid = false;
                    } else {
                        clearFieldError(section);
                    }
                } else {
                    const fid = document.getElementById('inpFacultyId');
                    const dept = document.getElementById('inpDepartment');

                    if (!fid.value.trim()) {
                        showFieldError(fid);
                        isValid = false;
                    } else {
                        clearFieldError(fid);
                    }

                    if (!dept.value.trim()) {
                        showFieldError(dept);
                        isValid = false;
                    } else {
                        clearFieldError(dept);
                    }
                }
            }

            return isValid;
        }

        function validateAndNext(step) {
            if (validateStep(step)) {
                currentStep = step + 1;
                updateTimelineUI(currentStep);
                updatePreviewCard();
            }
        }

        function goToStep(targetStep) {
            // Can always go back to previous steps
            if (targetStep < currentStep) {
                currentStep = targetStep;
                updateTimelineUI(currentStep);
                return;
            }

            // If advancing forward, validate all intermediate steps
            for (let s = currentStep; s < targetStep; s++) {
                if (!validateStep(s)) {
                    goToStep(s);
                    return;
                }
            }

            currentStep = targetStep;
            updateTimelineUI(currentStep);
            updatePreviewCard();
        }

        function showFieldError(inputElement) {
            inputElement.classList.add('border-rose-400', 'bg-rose-50/30');
            const errP = inputElement.parentElement.querySelector('.field-error');
            if (errP) errP.classList.remove('hidden');
        }

        function clearFieldError(inputElement) {
            inputElement.classList.remove('border-rose-400', 'bg-rose-50/30');
            const errP = inputElement.parentElement.querySelector('.field-error');
            if (errP) errP.classList.add('hidden');
        }

        function formatLrn(input) {
            input.value = input.value.replace(/\D/g, '').slice(0, 12);
        }

        function toggleDetails(elementId, btn) {
            const el = document.getElementById(elementId);
            const icon = btn.querySelector('.fa-chevron-down');
            el.classList.toggle('hidden');
            if (icon) {
                icon.classList.toggle('rotate-180');
            }
        }

        function handleAvatarSelected(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    document.getElementById('avatarPreview').src = e.target.result;
                    document.getElementById('badgeAvatarPreview').src = e.target.result;
                    document.getElementById('removeAvatarFlag').value = '0';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function removeAvatarImage() {
            document.getElementById('profileFileInput').value = '';
            document.getElementById('avatarPreview').src = '/profile_uploads/default_avatar.png';
            document.getElementById('badgeAvatarPreview').src = '/profile_uploads/default_avatar.png';
            document.getElementById('removeAvatarFlag').value = '1';
        }

        function updatePreviewCard() {
            const fname = (document.getElementById('inpFirstName')?.value || '').trim();
            const mname = (document.getElementById('inpMiddleName')?.value || '').trim();
            const lname = (document.getElementById('inpLastName')?.value || '').trim();
            const suffix = (document.getElementById('inpSuffix')?.value || '').trim();

            const fullName = [fname, mname, lname, suffix].filter(Boolean).join(' ') || 'Your Name Here';
            const badgeName = document.getElementById('badgeFullName');
            if (badgeName) badgeName.innerText = fullName;

            const altName = (document.getElementById('inpAltName')?.value || '').trim();
            const badgeGamertag = document.getElementById('badgeGamertag');
            if (badgeGamertag) badgeGamertag.innerText = '@' + (altName || 'Gamertag');

            const badgeAcademic = document.getElementById('badgeAcademicMeta');
            if (badgeAcademic) {
                if (userRole === 'Student') {
                    const grade = document.getElementById('inpGradeLevel')?.value || 'Grade Level';
                    const strand = document.getElementById('inpStrand')?.value || 'Strand';
                    const section = document.getElementById('inpSection')?.value || 'Section';
                    badgeAcademic.innerText = `${grade} • ${strand} • ${section}`;
                } else {
                    const dept = document.getElementById('inpDepartment')?.value || 'Science Dept';
                    const fid = document.getElementById('inpFacultyId')?.value || 'Faculty';
                    badgeAcademic.innerText = `${dept} • ${fid}`;
                }
            }
        }

        // On submit loading feedback
        document.getElementById('onboardingForm').addEventListener('submit', function(e) {
            // Final validation of all required steps
            if (!validateStep(1)) {
                e.preventDefault();
                goToStep(1);
                return;
            }
            if (!validateStep(2)) {
                e.preventDefault();
                goToStep(2);
                return;
            }

            const submitBtn = document.getElementById('submitBtn');
            const submitBtnText = document.getElementById('submitBtnText');
            const submitSpinner = document.getElementById('submitSpinner');

            submitBtn.disabled = true;
            submitBtn.classList.add('opacity-75', 'cursor-not-allowed');
            submitBtnText.innerText = 'Saving Profile...';
            submitSpinner.classList.remove('hidden');
        });

        // Initialize state
        document.addEventListener('DOMContentLoaded', function() {
            updateTimelineUI(1);
            updatePreviewCard();
        });

        // ==========================================
        // DATA PRIVACY ACT CONSENT LOGIC
        // ==========================================
        function clearConsentError() {
            const errorBanner = document.getElementById('consentErrorBanner');
            if (errorBanner) errorBanner.classList.add('hidden');
            const labelGeneral = document.getElementById('labelConsentGeneral');
            const labelComms = document.getElementById('labelConsentComms');
            if (labelGeneral) labelGeneral.classList.remove('ring-2', 'ring-rose-500', 'bg-rose-50/50');
            if (labelComms) labelComms.classList.remove('ring-2', 'ring-rose-500', 'bg-rose-50/50');
        }

        function submitConsent() {
            const general = document.getElementById('consentGeneral').checked;
            const comms   = document.getElementById('consentComms').checked;
            const guardian = document.getElementById('consentGuardian').checked;
            const errorBanner = document.getElementById('consentErrorBanner');
            const labelGeneral = document.getElementById('labelConsentGeneral');
            const labelComms = document.getElementById('labelConsentComms');

            clearConsentError();

            // Both required checkboxes must be checked
            if (!general || !comms) {
                if (!general && labelGeneral) labelGeneral.classList.add('ring-2', 'ring-rose-500', 'bg-rose-50/50');
                if (!comms && labelComms) labelComms.classList.add('ring-2', 'ring-rose-500', 'bg-rose-50/50');

                if (errorBanner) errorBanner.classList.remove('hidden');

                // User prompt requirement: If unchecked or either 1 is unchecked, student will not proceed and system will confirm if student does not agree and will be redirected to login page
                promptDeclineConsent();
                return;
            }

            // Record consent in hidden inputs
            document.getElementById('inpDpaGeneral').value = '1';
            document.getElementById('inpDpaComms').value = '1';
            document.getElementById('inpDpaGuardian').value = guardian ? '1' : '0';
            document.getElementById('inpDpaTimestamp').value = new Date().toISOString();

            // Transition UI: Hide consent section, show timeline & onboarding form
            document.getElementById('privacyConsentSection').classList.add('hidden');
            document.getElementById('registrationTimelineNav').classList.remove('hidden');
            document.getElementById('onboardingMain').classList.remove('hidden');

            const badgeText = document.getElementById('headerStageBadgeText');
            if (badgeText) badgeText.innerText = 'Account Activated • Step 2: Profile Setup';

            const subtitleText = document.getElementById('headerSubtitleText');
            if (subtitleText) subtitleText.innerText = 'Set up your official identity and personal preferences so our teachers, systems, and arcade stations recognize you.';

            // Scroll smoothly to top
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function promptDeclineConsent() {
            const modal = document.getElementById('declineModal');
            if (modal) modal.classList.remove('hidden');
        }

        function closeDeclineModal() {
            const modal = document.getElementById('declineModal');
            if (modal) modal.classList.add('hidden');
        }
    </script>

    <!-- CONFIRMATION MODAL IF DECLINING CONSENT -->
    <div id="declineModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-950/80 backdrop-blur-sm animate-fadeIn">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 sm:p-8 shadow-2xl border border-slate-200 text-center">
            <div class="w-16 h-16 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-2xl mx-auto mb-4">
                <i class="fas fa-shield-halved"></i>
            </div>
            <h3 class="text-xl font-black text-slate-900 mb-2">Do you not agree to the Data Privacy Terms?</h3>
            <p class="text-xs sm:text-sm text-slate-600 mb-6 leading-relaxed">
                In compliance with the <strong>Data Privacy Act (DPA) of 2012</strong>, Mabini Colleges Inc. cannot process your registration or activate your LMS student account without your explicit consent.
                <br><br>
                If you confirm that you do not agree, you will not proceed to set up your account and will be redirected to the <strong>Login page</strong>.
            </p>
            <div class="flex flex-col sm:flex-row gap-3">
                <button type="button" onclick="closeDeclineModal()" class="flex-1 py-3 px-4 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs transition">
                    Back to Consent Form
                </button>
                <a href="/login" class="flex-1 py-3 px-4 rounded-xl bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs shadow-lg shadow-rose-200 transition flex items-center justify-center gap-1.5" style="text-decoration: none;">
                    <span>Confirm & Exit to Login</span>
                </a>
            </div>
        </div>
    </div>
</body>
</html>