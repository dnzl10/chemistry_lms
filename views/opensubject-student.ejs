    <!-- Student Attendance History Modal -->
    <div id="studentAttendanceModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[99990] hidden flex items-center justify-center p-4 cursor-pointer"
         role="dialog" aria-modal="true" aria-labelledby="studentAttendanceTitle" onclick="if(event.target === this) closeStudentAttendanceModal()">
        <div class="bg-white rounded-3xl max-w-xl w-full shadow-2xl overflow-hidden border border-slate-200 animate-in fade-in zoom-in-95 duration-200 flex flex-col max-h-[85vh] cursor-default">
            <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-slate-50">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-700 flex items-center justify-center font-black">
                        <i class="fas fa-clipboard-user"></i>
                    </div>
                    <div>
                        <h3 class="font-extrabold text-slate-800 text-sm" id="studentAttendanceTitle">My Attendance Ledger</h3>
                        <p class="text-[11px] text-slate-400 font-medium">Session records &amp; punctuality history</p>
                    </div>
                </div>
                <button type="button" onclick="closeStudentAttendanceModal()" class="w-8 h-8 rounded-full hover:bg-slate-200 text-slate-400 hover:text-slate-600 flex items-center justify-center text-lg font-bold transition">&times;</button>
            </div>
            
            <div class="p-4 bg-emerald-50/50 border-b border-emerald-100 flex items-center justify-between flex-wrap gap-2 text-xs">
                <div>
                    <span class="text-[10px] font-black uppercase text-emerald-700 tracking-wider">Attendance Rate:</span>
                    <span class="font-black text-sm ml-1 text-emerald-800"><%= (typeof attendanceStats !== 'undefined' && attendanceStats) ? attendanceStats.rate : 100 %>%</span>
                </div>
                <div class="flex items-center gap-1.5 font-bold text-[11px]">
                    <span class="px-2 py-0.5 rounded-lg bg-emerald-100 text-emerald-800">Pres: <%= (typeof attendanceStats !== 'undefined' && attendanceStats) ? attendanceStats.present : 0 %></span>
                    <span class="px-2 py-0.5 rounded-lg bg-amber-100 text-amber-800">Late: <%= (typeof attendanceStats !== 'undefined' && attendanceStats) ? attendanceStats.late : 0 %></span>
                    <span class="px-2 py-0.5 rounded-lg bg-rose-100 text-rose-800">Abs: <%= (typeof attendanceStats !== 'undefined' && attendanceStats) ? attendanceStats.absent : 0 %></span>
                    <span class="px-2 py-0.5 rounded-lg bg-sky-100 text-sky-800">Exc: <%= (typeof attendanceStats !== 'undefined' && attendanceStats) ? attendanceStats.excused : 0 %></span>
                </div>
            </div>

            <div class="p-5 overflow-y-auto flex-1 custom-scrollbar">
                <% if (typeof attendanceStats !== 'undefined' && attendanceStats && attendanceStats.records && attendanceStats.records.length > 0) { %>
                    <div class="overflow-x-auto">
                        <table class="w-full text-left text-xs">
                            <thead>
                                <tr class="border-b border-slate-100 text-[10px] uppercase font-black text-slate-400 tracking-wider">
                                    <th class="pb-2.5">Date</th>
                                    <th class="pb-2.5">Day</th>
                                    <th class="pb-2.5 text-center">Status</th>
                                    <th class="pb-2.5">Time-In</th>
                                    <th class="pb-2.5">Remarks / Reason</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-100 font-medium">
                                <% attendanceStats.records.forEach(r => { %>
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-2.5 font-mono text-slate-700 font-bold"><%= r.session_date %></td>
                                        <td class="py-2.5 text-slate-500"><%= r.day_name %></td>
                                        <td class="py-2.5 text-center">
                                            <% if (r.status === 'Present') { %>
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-700">Present</span>
                                            <% } else if (r.status === 'Late') { %>
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-100 text-amber-700">Late</span>
                                            <% } else if (r.status === 'Absent') { %>
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-100 text-rose-700">Absent</span>
                                            <% } else if (r.status === 'Excused') { %>
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-sky-100 text-sky-700">Excused</span>
                                            <% } else { %>
                                                <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-slate-100 text-slate-600"><%= r.status %></span>
                                            <% } %>
                                        </td>
                                        <td class="py-2.5 text-slate-600 font-mono"><%= r.check_in_time || '—' %></td>
                                        <td class="py-2.5 text-slate-500 italic"><%= r.override_reason || '—' %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } else { %>
                    <div class="p-8 text-center text-slate-400">
                        <i class="fas fa-calendar-check text-slate-300 text-3xl mb-2 block"></i>
                        <p class="font-bold text-sm text-slate-600">No attendance sessions recorded yet</p>
                        <p class="text-xs text-slate-400 mt-1">Attendance records recorded by your instructor will appear here.</p>
                    </div>
                <% } %>
            </div>
