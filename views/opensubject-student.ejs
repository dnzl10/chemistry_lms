    async function runStudentPreDiagnostic(file, reqs) {
        const container = document.getElementById('diagChecklistContainer');
        const resultsEl = document.getElementById('diagChecklistResults');
        container.classList.remove('hidden');
        resultsEl.innerHTML = '<div class="flex items-center gap-2 text-xs text-teal-600 font-bold py-2"><i class="fas fa-spinner fa-spin"></i> Scanning document structure & integrity...</div>';

        const checks = [];

        // 1. File Type Check
        const ext = file.name.split('.').pop().toLowerCase();
        const allowedList = reqs.allowedFormats || ['pdf', 'docx', 'doc'];
        const validExt = allowedList.includes(ext);
        checks.push({
            label: `File Format: .${ext.toUpperCase()}`,
            pass: validExt,
            desc: validExt ? `Permitted format (${allowedList.join(', ')}).` : `Invalid format! Allowed extensions: ${allowedList.join(', ')}`
        });

        // 2. File Size Check
        const maxMb = reqs.maxFileSizeMb || 25;
        const sizeMb = (file.size / (1024 * 1024)).toFixed(2);
        const validSize = file.size <= maxMb * 1024 * 1024 && file.size > 50;
        checks.push({
            label: `File Size: ${sizeMb} MB`,
            pass: validSize,
            desc: validSize ? `Within ${maxMb} MB payload limit.` : `File exceeds limit of ${maxMb} MB.`
        });

        // 3. Document Content Analysis (if PDF)
        if (ext === 'pdf') {
            try {
                const arrayBuffer = await file.arrayBuffer();
                const bytes = new Uint8Array(arrayBuffer);
                const str = new TextDecoder('latin1').decode(bytes.slice(0, Math.min(bytes.length, 500000)));
                
                // Approximate word count
                const wordMatches = str.match(/[a-zA-Z]{2,}/g) || [];
                const wordCountEst = Math.round(wordMatches.length * 0.7);

                if (reqs.minWords > 0) {
                    const passMin = wordCountEst >= reqs.minWords;
                    checks.push({
                        label: `Min Word Count (~${wordCountEst} words detected)`,
                        pass: passMin,
                        desc: passMin ? 'Satisfies minimum length requirement.' : `Requires at least ${reqs.minWords} words.`
                    });
                }

                if (reqs.disallowBlank) {
                    const passBlank = file.size > 2048 && wordMatches.length > 10;
                    checks.push({
                        label: 'Blank Page Diagnostic',
                        pass: passBlank,
                        desc: passBlank ? 'Zero placeholder/blank pages detected.' : 'Warning: Document appears empty or incomplete.'
                    });
                }
            } catch (err) {
                // Fallback graceful
            }
        }

        resultsEl.innerHTML = checks.map(c => `
            <div class="flex items-start gap-2 text-xs p-2 rounded-xl border ${c.pass ? 'bg-emerald-50 border-emerald-200 text-emerald-800' : 'bg-rose-50 border-rose-200 text-rose-800'}">
                <i class="fas ${c.pass ? 'fa-circle-check text-emerald-600' : 'fa-triangle-exclamation text-rose-600'} mt-0.5"></i>
                <div>
                    <div class="font-bold">${c.label}</div>
                    <div class="text-[11px] opacity-80">${c.desc}</div>
                </div>
            </div>
        `).join('');
    }

    async function submitStudentDeliverable(e) {
        e.preventDefault();
        const asgnId = document.getElementById('studentSubAsgnId').value;
        const fileInput = document.getElementById('studentSubFile');
        const errEl = document.getElementById('studentSubErrorMsg');
        const submitBtn = document.getElementById('studentSubSubmitBtn');

        if (!fileInput.files[0]) {
            errEl.textContent = 'Please choose a document file to submit.';
            errEl.classList.remove('hidden');
            return;
        }

        const formData = new FormData();
        formData.append('submission_file', fileInput.files[0]);

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Sanitizing & Signing...';
        errEl.classList.add('hidden');

        try {
            const res = await fetch(`/api/assessment/${asgnId}/submit`, {
                method: 'POST',
                body: formData
            });
            const data = await res.json();
            if (!res.ok || !data.success) {
                throw new Error(data.error || 'Submission failed.');
            }

            closeStudentSubmissionModal();

            // Display Digital Non-Repudiation Receipt Modal
            if (data.receipt) {
                showSubmissionReceipt(data.receipt);
            }

            // Reload page when receipt is dismissed
            window._reloadOnReceiptClose = true;

        } catch (err) {
            errEl.textContent = err.message;
            errEl.classList.remove('hidden');
        } finally {
            submitBtn.disabled = false;
            submitBtn.innerHTML = '<i class="fas fa-cloud-arrow-up mr-1"></i> Confirm &amp; Submit Deliverable';
        }
    }

    function handleOpenRubricModal(btn) {
        if (!btn) return;
        const asgnId = btn.dataset.asgnId;
        const asgnName = btn.dataset.asgnName || 'Scoring Rubric';
        let criteria = [];

        // Parse criteria from json script tag safely
        const scriptTag = document.getElementById('rubric-data-' + asgnId);
        if (scriptTag && scriptTag.textContent) {
            try {
                criteria = JSON.parse(scriptTag.textContent);
            } catch (e) {
                console.error('Failed to parse rubric criteria from script tag:', e);
            }
        }

        openRubricPreviewModal(asgnName, criteria);
    }

    function openRubricPreviewModal(asgnTitle, criteria) {
        const titleEl = document.getElementById('rubricPreviewTitle');
        if (titleEl) {
            titleEl.textContent = asgnTitle || 'Scoring Rubric';
        }

        const body = document.getElementById('rubricPreviewCriteria');
        if (typeof criteria === 'string') {
            try {
                criteria = JSON.parse(criteria);
            } catch (e) {
                criteria = [];
            }
        }

        if (body) {
            if (!Array.isArray(criteria) || criteria.length === 0) {
                body.innerHTML = `
                    <div class="text-center py-8 text-slate-400">
                        <i class="fas fa-clipboard-list text-3xl mb-2 text-slate-300"></i>
                        <p class="text-xs font-semibold">No detailed criteria provided for this rubric.</p>
                    </div>
                `;
            } else {
                body.innerHTML = criteria.map((c, i) => `
                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200 text-xs space-y-1.5 transition-all hover:bg-slate-100/50">
                        <div class="flex items-center justify-between gap-2">
                            <span class="font-black text-slate-800 text-sm truncate">${i + 1}. ${escapeHtml(c.title || c.name || 'Criterion')}</span>
                            <span class="font-extrabold text-teal-700 bg-teal-50 px-2.5 py-0.5 rounded-full border border-teal-200 flex-shrink-0">${c.max_points !== undefined ? c.max_points : (c.points || 0)} pts</span>
                        </div>
                        ${c.description ? `<p class="text-slate-600 leading-relaxed text-[11px] whitespace-pre-line">${escapeHtml(c.description)}</p>` : ''}
                    </div>
                `).join('');
            }
        }

        const modal = document.getElementById('rubricPreviewModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            if (window.ModalManager && typeof ModalManager.open === 'function') {
                ModalManager.open(modal);
            }
        }
    }

    function closeRubricPreviewModal() {
        const modal = document.getElementById('rubricPreviewModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex', 'open');
            if (window.ModalManager && typeof ModalManager.close === 'function') {
                ModalManager.close(modal, true);
            }
        }
    }

    /* ================================================================
       STUDENT ASSIGNMENT FULL DETAILS MODAL CONTROLLER
       ================================================================ */
    let currentModalAsgn = null;

    function openAssignmentDetailsModal(asgnId) {
        const scriptTag = document.getElementById('asgn-full-data-' + asgnId);
        if (!scriptTag || !scriptTag.textContent) {
            console.error('No assignment data found for ID:', asgnId);
            return;
        }

        let asgn;
        try {
            asgn = JSON.parse(scriptTag.textContent);
        } catch (e) {
            console.error('Failed to parse assignment payload:', e);
            return;
        }

        if (asgn && asgn.is_locked) {
            openLockedNoticeModal('This topic or assessment is currently locked by your instructor.', 'Assignment Locked');
            return;
        }

        currentModalAsgn = asgn;

        // Header Population
        document.getElementById('asgnModalTitle').textContent = asgn.assessment_name || 'Assignment Details';
        document.getElementById('asgnModalCategory').innerHTML = `<i class="fas fa-tag mr-1"></i>${escapeHtml(asgn.category || 'Homework')}`;
        document.getElementById('asgnModalPoints').innerHTML = `<i class="fas fa-award mr-1"></i>${asgn.total_items} Max Pts`;

        let dueHtml = '<i class="fas fa-clock mr-1"></i>No Deadline';
        if (asgn.is_in_grace) {
            dueHtml = `<i class="fas fa-stopwatch mr-1"></i>Grace Buffer Active (+${asgn.grace_period_minutes}m)`;
        } else if (asgn.is_overdue && !asgn.is_done) {
            dueHtml = '<i class="fas fa-circle-xmark mr-1"></i>Deadline Expired';
        } else if (asgn.due_date) {
            const d = new Date(asgn.due_date);
            dueHtml = `<i class="fas fa-clock mr-1"></i>Due ${d.toLocaleDateString('en-PH', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}`;
        }
        document.getElementById('asgnModalDue').innerHTML = dueHtml;

        // Tab 1: Overview & Guidelines
        const objCont = document.getElementById('asgnModalObjectivesCont');
        const objEl = document.getElementById('asgnModalObjectives');
        if (asgn.objectives && asgn.objectives.trim()) {
            objEl.textContent = asgn.objectives;
            objCont.classList.remove('hidden');
        } else {
            objCont.classList.add('hidden');
        }

        const descCont = document.getElementById('asgnModalDescCont');
        const descEl = document.getElementById('asgnModalDesc');
        if (asgn.description && asgn.description.trim()) {
            descEl.textContent = asgn.description;
            descCont.classList.remove('hidden');
        } else {
            descCont.classList.add('hidden');
        }

        const instCont = document.getElementById('asgnModalInstructionsCont');
        const instEl = document.getElementById('asgnModalInstructions');
        if (asgn.instructions && asgn.instructions.trim()) {
            instEl.textContent = asgn.instructions;
            instCont.classList.remove('hidden');
        } else {
            instCont.classList.add('hidden');
        }

        const emptyOverview = document.getElementById('asgnModalOverviewEmpty');
        if ((!asgn.objectives || !asgn.objectives.trim()) && (!asgn.description || !asgn.description.trim()) && (!asgn.instructions || !asgn.instructions.trim())) {
            emptyOverview.classList.remove('hidden');
        } else {
            emptyOverview.classList.add('hidden');
        }

        // Tab 2: Resources & Exemplars
        const fmtCont = document.getElementById('asgnModalFormatCont');
        const fmtLink = document.getElementById('asgnModalFormatLink');
        const fmtName = document.getElementById('asgnModalFormatName');
        if (asgn.format_href) {
            fmtLink.href = asgn.format_href;
            fmtLink.setAttribute('download', asgn.format_file_name || 'Format Template');
            fmtName.textContent = asgn.format_file_name || 'Format Template';
            fmtCont.classList.remove('hidden');
        } else {
            fmtCont.classList.add('hidden');
        }

        const smpCont = document.getElementById('asgnModalSampleCont');
        const smpLink = document.getElementById('asgnModalSampleLink');
        const smpName = document.getElementById('asgnModalSampleName');
        if (asgn.sample_href) {
            smpLink.href = asgn.sample_href;
            smpLink.setAttribute('download', asgn.sample_file_name || 'Sample Output');
            smpName.textContent = asgn.sample_file_name || 'Sample Output / Exemplar';
            smpCont.classList.remove('hidden');
        } else {
            smpCont.classList.add('hidden');
        }

        const resEmpty = document.getElementById('asgnModalResourcesEmpty');
        if (!asgn.format_href && !asgn.sample_href) {
            resEmpty.classList.remove('hidden');
        } else {
            resEmpty.classList.add('hidden');
        }

        // Tab 3: Rules & Policy
        document.getElementById('asgnModalRuleTypes').textContent = (asgn.allowed_types || 'PDF, DOCX').replace(/^\./, '').toUpperCase();
        document.getElementById('asgnModalRuleSize').textContent = `${asgn.max_size_mb || 25} MB`;
        
        let wordsText = 'No word limits';
        if (asgn.min_words && asgn.max_words) {
            wordsText = `${asgn.min_words} - ${asgn.max_words} words`;
        } else if (asgn.min_words) {
            wordsText = `Min ${asgn.min_words} words`;
        } else if (asgn.max_words) {
            wordsText = `Max ${asgn.max_words} words`;
        }
        document.getElementById('asgnModalRuleWords').textContent = wordsText;

        document.getElementById('asgnModalRuleAttempts').textContent = asgn.allow_resubmission 
            ? `Attempt ${asgn.attempts_count || 1} of ${asgn.max_attempts || '∞'}`
            : 'Single Attempt (1/1)';

        const blankCont = document.getElementById('asgnModalRuleBlankCont');
        if (asgn.disallow_blank) {
            blankCont.classList.remove('hidden');
        } else {
            blankCont.classList.add('hidden');
        }

        // Group Project Info
        const grpCont = document.getElementById('asgnModalGroupCont');
        if (asgn.is_group) {
            grpCont.classList.remove('hidden');
            document.getElementById('asgnModalGroupName').textContent = asgn.group_name || 'Unassigned (Please check with teacher)';
            document.getElementById('asgnModalGroupPolicyBadge').textContent = (asgn.group_policy === 'shared' || asgn.group_policy === 'one_per_group') 
                ? '1 Submission per team (Shared Grade)' 
                : 'Individual Submissions';
            
            const membersEl = document.getElementById('asgnModalGroupMembers');
            if (asgn.group_members && asgn.group_members.trim()) {
                document.getElementById('asgnModalGroupMembersCont').classList.remove('hidden');
                membersEl.innerHTML = asgn.group_members.split(',').map(m => `
                    <span class="inline-flex items-center px-2 py-0.5 rounded bg-white border border-purple-200 text-purple-900 font-semibold">${escapeHtml(m.trim())}</span>
                `).join('');
            } else {
                document.getElementById('asgnModalGroupMembersCont').classList.add('hidden');
            }
        } else {
            grpCont.classList.add('hidden');
        }

        // Tab 4: My Deliverable & Feedback
        const subActive = document.getElementById('asgnModalSubActive');
        const subEmpty = document.getElementById('asgnModalSubEmpty');
        if (asgn.is_done && asgn.submission) {
            subActive.classList.remove('hidden');
            subEmpty.classList.add('hidden');

            const s = asgn.submission;
            const subDate = new Date(s.submitted_at || s.server_timestamp);
            let subDateLabel = `Submitted on ${subDate.toLocaleDateString('en-PH', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}`;
            if (s.submitted_by_first && s.submitted_by_user_id && s.submitted_by_user_id != CURRENT_STUDENT_ID) {
                subDateLabel += ` (by teammate ${s.submitted_by_first} ${s.submitted_by_last || ''})`;
            }
            document.getElementById('asgnModalSubDate').textContent = subDateLabel;
            
            const graceBadge = document.getElementById('asgnModalSubGraceBadge');
            if (s.is_grace_period) graceBadge.classList.remove('hidden');
            else graceBadge.classList.add('hidden');

            document.getElementById('asgnModalSubFilename').textContent = s.original_filename || 'deliverable.pdf';
            const dlLink = document.getElementById('asgnModalSubDownload');
            if (s.score_id) {
                dlLink.href = `/api/deliverables/download/${s.score_id}`;
                dlLink.classList.remove('hidden');
            } else {
                dlLink.classList.add('hidden');
            }

            // Grade
            const gradeEl = document.getElementById('asgnModalGradeScore');
            if (s.score_obtained !== null && s.score_obtained !== undefined) {
                gradeEl.innerHTML = `<span class="text-emerald-700">${s.score_obtained}</span> <span class="text-xs text-slate-400 font-bold">/ ${asgn.total_items} pts</span>`;
            } else {
                gradeEl.innerHTML = `<span class="text-amber-600 font-bold text-xs"><i class="fas fa-clock mr-1"></i>Pending Teacher Grading</span>`;
            }

            // Feedback
            const fbCont = document.getElementById('asgnModalFeedbackCont');
            const fbText = document.getElementById('asgnModalFeedbackText');
            if (s.feedback && s.feedback.trim()) {
                fbText.textContent = `"${s.feedback}"`;
                fbCont.classList.remove('hidden');
            } else {
                fbCont.classList.add('hidden');
            }

            // Voice
            const vcCont = document.getElementById('asgnModalVoiceCont');
            const vcAudio = document.getElementById('asgnModalVoiceAudio');
            if (s.voice_note_path) {
                vcAudio.src = `/material_uploads/audio_notes/${s.voice_note_path}`;
                vcCont.classList.remove('hidden');
            } else {
                vcAudio.removeAttribute('src');
                vcCont.classList.add('hidden');
            }
        } else {
            subActive.classList.add('hidden');
            subEmpty.classList.remove('hidden');
        }

        // Rubric button in footer
        const rubricBtn = document.getElementById('asgnModalRubricBtn');
        if (asgn.has_rubric && asgn.rubric_criteria && asgn.rubric_criteria.length > 0) {
            rubricBtn.classList.remove('hidden');
        } else {
            rubricBtn.classList.add('hidden');
        }

        // Submit button in footer
        const submitBtn = document.getElementById('asgnModalSubmitBtn');
        const submitText = document.getElementById('asgnModalSubmitText');
        if (!asgn.is_locked && asgn.can_submit) {
            submitBtn.classList.remove('hidden');
            submitText.textContent = asgn.is_done ? 'Resubmit Deliverable' : 'Submit Deliverable';
        } else {
            submitBtn.classList.add('hidden');
        }

        // Default to Overview tab
        switchAssignmentDetailsTab('overview');

        // Open modal
        const modal = document.getElementById('assignmentDetailsModal');
        if (modal) {
            modal.classList.remove('hidden');
            modal.classList.add('flex');
            if (window.ModalManager && typeof ModalManager.open === 'function') {
                ModalManager.open(modal);
            }
        }
    }

    function closeAssignmentDetailsModal() {
        const modal = document.getElementById('assignmentDetailsModal');
        if (modal) {
            modal.classList.add('hidden');
            modal.classList.remove('flex', 'open');
            if (window.ModalManager && typeof ModalManager.close === 'function') {
                ModalManager.close(modal, true);
            }
        }
    }

    function switchAssignmentDetailsTab(tabKey) {
        const tabs = ['overview', 'resources', 'rules', 'feedback'];
        tabs.forEach(t => {
            const btn = document.getElementById('asgnTabBtn-' + t);
            const panel = document.getElementById('asgnTabPanel-' + t);
            if (t === tabKey) {
                if (btn) {
                    btn.classList.add('border-white', 'text-white', 'font-extrabold');
                    btn.classList.remove('border-transparent', 'text-teal-200', 'font-semibold');
                }
                if (panel) panel.classList.remove('hidden');
            } else {
                if (btn) {
                    btn.classList.remove('border-white', 'text-white', 'font-extrabold');
                    btn.classList.add('border-transparent', 'text-teal-200', 'font-semibold');
                }
                if (panel) panel.classList.add('hidden');
            }
        });
    }

    function handleModalRubricClick() {
        if (!currentModalAsgn) return;
        openRubricPreviewModal(currentModalAsgn.assessment_name, currentModalAsgn.rubric_criteria);
    }

    function handleModalSubmitClick() {
        if (!currentModalAsgn) return;
        closeAssignmentDetailsModal();
        openStudentSubmissionModal(
            currentModalAsgn.assessment_id,
            currentModalAsgn.assessment_name,
            currentModalAsgn.min_words || 0,
            currentModalAsgn.max_words || null,
            currentModalAsgn.disallow_blank,
            currentModalAsgn.is_in_grace,
            currentModalAsgn.allowed_types,
            currentModalAsgn.max_size_mb || 25,
            currentModalAsgn.is_group,
            currentModalAsgn.group_policy,
            currentModalAsgn.group_name
        );
    }
    </script>

