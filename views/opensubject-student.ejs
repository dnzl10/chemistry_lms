    // ── Safe HTML Sanitizer Utility (Stored XSS Prevention) ──
    function escapeHtml(str) {
        if (str === null || str === undefined) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;');
    }

    // ── Learning Path Search & Quick Filter Escape Hatch ──
    function applyQuickFilter(filterType) {
        document.querySelectorAll('.quick-filter-pill').forEach(btn => {
            btn.classList.remove('active', 'bg-blue-600', 'text-white', 'shadow-2xs');
            btn.classList.add('bg-slate-100', 'text-slate-600');
        });
        const currentBtn = document.querySelector(`.quick-filter-pill[data-filter="${filterType}"]`);
        if (currentBtn) {
            currentBtn.classList.add('active', 'bg-blue-600', 'text-white', 'shadow-2xs');
            currentBtn.classList.remove('bg-slate-100', 'text-slate-600');
        }

        const searchInput = document.getElementById('learningPathSearch');
        const query = (searchInput ? searchInput.value : '').toLowerCase().trim();
        filterLearningPath(query, filterType);
    }

    function handleLearningSearch(query) {
        const activePill = document.querySelector('.quick-filter-pill.active');
        const filterType = activePill ? (activePill.getAttribute('data-filter') || 'all') : 'all';
        filterLearningPath(query.toLowerCase().trim(), filterType);
    }

    function filterLearningPath(query, filterType) {
        const quarters = document.querySelectorAll('.quarter-card');

        quarters.forEach(quarter => {
            const panel = quarter.querySelector('.quarter-panel');
            const qId = panel ? panel.id.replace('q-', '') : '';
            const topicCards = quarter.querySelectorAll('.topic-card-item');
            let quarterHasMatch = false;

            topicCards.forEach(topic => {
                const topicText = topic.textContent.toLowerCase();
                const tabId = topic.getAttribute('data-tab-id');
                let topicMatchesSearch = !query || topicText.includes(query);
                let topicMatchesFilter = true;

                if (filterType === 'incomplete') {
                    const notDoneBadges = topic.querySelectorAll('.status-badge.not-done');
                    topicMatchesFilter = notDoneBadges.length > 0;
                } else if (filterType === 'assessments' || filterType === 'assignments' || filterType === 'resources' || filterType === 'forums') {
                    if (tabId && typeof switchTab === 'function') {
                        switchTab(tabId, filterType);
                    }
                    const tabSection = document.getElementById(`${tabId}-${filterType}`);
                    const hasEmptyState = tabSection ? tabSection.querySelector('.empty-state') : null;
                    topicMatchesFilter = tabSection && !hasEmptyState;
                }

                if (topicMatchesSearch && topicMatchesFilter) {
                    topic.style.display = '';
                    quarterHasMatch = true;
                } else {
                    topic.style.display = 'none';
                }
            });

            const btn = document.getElementById('qbtn-' + qId);
            if (query || filterType !== 'all') {
                if (quarterHasMatch) {
                    quarter.style.display = '';
                    if (panel && panel.classList.contains('hidden')) {
                        panel.classList.remove('hidden');
                        if (btn) {
                            btn.classList.add('open');
                            btn.style.background = 'linear-gradient(90deg,#ecfeff,#eef2ff)';
                        }
                    }
                } else {
                    quarter.style.display = 'none';
                }
            } else {
                quarter.style.display = '';
                topicCards.forEach(t => t.style.display = '');
            }
        });
    }

    // Contextual Deep-Linking: Lesson Material / Topic / Assessment Navigation (Phase 4)
    function handleTopicDeepLink() {
        const urlParams = new URLSearchParams(window.location.search);
        let topicId = urlParams.get('topic_id') || urlParams.get('topic');
        let targetTab = urlParams.get('tab');
        let assessmentId = urlParams.get('assessment_id') || urlParams.get('assessment');

        if (!assessmentId && window.location.hash) {
            if (window.location.hash.startsWith('#assessment-')) {
                assessmentId = window.location.hash.replace('#assessment-', '').split('?')[0];
                if (!targetTab) targetTab = 'assessments';
            } else if (window.location.hash.startsWith('#asgn-card-')) {
                assessmentId = window.location.hash.replace('#asgn-card-', '').split('?')[0];
                if (!targetTab) targetTab = 'assignments';
            }
        }

        if (!targetTab) targetTab = 'resources';

        if (!topicId && window.location.hash && window.location.hash.startsWith('#topic-')) {
            const rawHash = window.location.hash.replace('#topic-', '');
            topicId = rawHash.split('?')[0];
        }

        let targetAssessmentEl = null;
        if (assessmentId) {
            targetAssessmentEl = document.getElementById('assessment-' + assessmentId) || 
                                 document.querySelector(`.assessment-row[data-assessment-id="${assessmentId}"]`) || 
                                 document.getElementById('asgn-card-' + assessmentId);
            if (targetAssessmentEl && !urlParams.get('tab')) {
                const isAsgn = targetAssessmentEl.id && targetAssessmentEl.id.startsWith('asgn-card-');
                targetTab = isAsgn ? 'assignments' : 'assessments';
            }
        }

        let targetTopic = topicId ? document.getElementById('topic-' + topicId) : null;

        if (!targetTopic && targetAssessmentEl) {
            targetTopic = targetAssessmentEl.closest('.topic-card-item');
        }

        if (!targetTopic && window.location.hash) {
            try {
                const el = document.querySelector(window.location.hash);
                if (el) {
                    targetTopic = el.classList.contains('topic-card-item') ? el : el.closest('.topic-card-item');
                }
            } catch(e) {}
        }

        if (targetTopic) {
            const parentQuarterPanel = targetTopic.closest('.quarter-panel');
            if (parentQuarterPanel && parentQuarterPanel.classList.contains('hidden')) {
                const qId = parentQuarterPanel.id.replace('q-', '');
                toggleQuarter(qId);
            }

            const tabId = targetTopic.getAttribute('data-tab-id');
            if (tabId && typeof switchTab === 'function') {
                switchTab(tabId, targetTab);
            }

            // Reveal assessment element if hidden by the 5-item limit
            if (targetAssessmentEl && targetAssessmentEl.classList.contains('hidden')) {
                targetAssessmentEl.classList.remove('hidden');
            }

            setTimeout(() => {
                const scrollTarget = targetAssessmentEl || targetTopic;
                scrollTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
                scrollTarget.classList.add('ring-4', 'ring-indigo-500', 'ring-offset-2', 'transition-all', 'duration-500');
                setTimeout(() => {
                    scrollTarget.classList.remove('ring-4', 'ring-indigo-500', 'ring-offset-2');
                }, 3500);

                // Auto-trigger dedicated modal (Arcade Assessment Ticket or Assignment Details)
                if (targetAssessmentEl) {
                    setTimeout(() => {
                        targetAssessmentEl.click();
                    }, 400);
                }
            }, 350);
        }
    }

