    function toggleExpandList(tabId, type, btn) {
        if (!btn) return;
        const isExpanded = btn.getAttribute('data-expanded') === 'true';
        let selector = `[data-forum-item="${tabId}"]`;
        let limit = 5;

        if (type === 'announcements') {
            selector = `[data-ann-item="${tabId}"]`;
            limit = 3;
        } else if (type === 'resources') {
            selector = `[data-resource-item="${tabId}"]`;
            limit = 5;
        } else if (type === 'links') {
            selector = `[data-link-item="${tabId}"]`;
            limit = 4;
        } else if (type === 'assessments') {
            selector = `[data-assessment-item="${tabId}"]`;
            limit = 5;
        }

        const items = document.querySelectorAll(selector);
        if (!items || items.length === 0) return;
        const hiddenCount = items.length - limit;

        if (!isExpanded) {
            items.forEach(item => item.classList.remove('hidden'));
            btn.setAttribute('data-expanded', 'true');
            const span = btn.querySelector('span');
            if (span) span.textContent = 'Show Less';
            const icon = btn.querySelector('i');
            if (icon) {
                icon.classList.remove('fa-chevron-down');
                icon.classList.add('fa-chevron-up');
            }
        } else {
            items.forEach((item, idx) => {
                if (idx >= limit) {
                    item.classList.add('hidden');
                }
            });
            btn.setAttribute('data-expanded', 'false');
            let moreText = `Show More Forum Topics (${hiddenCount} more)`;
            if (type === 'announcements') {
                moreText = `View All Announcements (${items.length})`;
            } else if (type === 'resources') {
                moreText = `Show More Resources (${hiddenCount} more)`;
            } else if (type === 'links') {
                moreText = `Show More Links (${hiddenCount} more)`;
            } else if (type === 'assessments') {
                moreText = `Show More Assessments (${hiddenCount} more)`;
            }
            const span = btn.querySelector('span');
            if (span) span.textContent = moreText;
            const icon = btn.querySelector('i');
            if (icon) {
                icon.classList.remove('fa-chevron-up');
                icon.classList.add('fa-chevron-down');
            }
            const panel = btn.closest('.tab-panel');
            if (panel) {
                panel.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }
    }
    window.toggleExpandList = toggleExpandList;

    function toggleQuarter(qId) {
    const panel  = document.getElementById('q-' + qId);
    const btn    = document.getElementById('qbtn-' + qId);
    const isOpen = !panel.classList.contains('hidden');

    if (isOpen) {
        panel.classList.add('hidden');
        btn.classList.remove('open');
        btn.style.background = 'white';
    } else {
        panel.classList.remove('hidden');
        btn.classList.add('open');
        btn.style.background = 'linear-gradient(90deg,#ecfeff,#eef2ff)';
    }
    }

    function toggleClassStream() {
        const content = document.getElementById('classStreamContent');
        const chevron = document.getElementById('classStreamChevron');
        const toggleText = document.getElementById('classStreamToggleText');
        const btn = document.getElementById('classStreamToggleBtn');
        if (!content) return;

        const isCollapsed = content.classList.contains('hidden');
        if (isCollapsed) {
            content.classList.remove('hidden');
            if (chevron) chevron.style.transform = 'rotate(180deg)';
            if (toggleText) toggleText.textContent = 'Collapse';
            if (btn) {
                btn.setAttribute('aria-expanded', 'true');
                btn.classList.add('bg-amber-50/30');
            }
        } else {
            content.classList.add('hidden');
            if (chevron) chevron.style.transform = 'rotate(0deg)';
            if (toggleText) toggleText.textContent = 'Expand';
            if (btn) {
                btn.setAttribute('aria-expanded', 'false');
                btn.classList.remove('bg-amber-50/30');
            }
        }
    }
    window.toggleClassStream = toggleClassStream;

    if (typeof window !== 'undefined' && window.location.hash && (window.location.hash.startsWith('#stream-ann-') || window.location.hash === '#classStreamSection')) {
        document.addEventListener('DOMContentLoaded', () => {
            toggleClassStream();
            const targetEl = document.querySelector(window.location.hash);
            if (targetEl) {
                setTimeout(() => targetEl.scrollIntoView({ behavior: 'smooth', block: 'center' }), 150);
            }
        });
    }

    /* ── Link Thumbnail Loader ── */
    function getYouTubeId(url) {
        try {
            const u = new URL(url);
            if (u.hostname.includes('youtu.be')) return u.pathname.slice(1).split('?')[0];
            if (u.hostname.includes('youtube.com')) return u.searchParams.get('v');
        } catch(e) {}
        return null;
    }

    function loadLinkThumbnails() {
        document.querySelectorAll('.link-thumb-placeholder[data-url]').forEach(el => {
            const url = el.dataset.url;
            if (!url) return; // locked — leave lock icon placeholder

            const ytId = getYouTubeId(url);
            if (ytId) {
                const img = document.createElement('img');
                img.className = 'link-thumb';
                img.alt = 'thumbnail';
                img.onerror = function() {
                    this.src = `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`;
                    this.onerror = null;
                };
                img.src = `https://img.youtube.com/vi/${ytId}/maxresdefault.jpg`;
                el.replaceWith(img);
                return;
            }

            try {
                const domain = new URL(url).hostname;
                el.innerHTML = `
                    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;height:100%;width:100%;background:linear-gradient(135deg,#ecfeff,#eef2ff);">
                        <img src="https://www.google.com/s2/favicons?sz=64&domain=${domain}"
                             style="width:40px;height:40px;border-radius:12px;border:1.5px solid #e2e8f0;background:#fff;object-fit:contain;"
                             onerror="this.style.display='none'">
                        <span style="font-size:12px;font-weight:800;color:#94a3b8;letter-spacing:0.04em;">${domain}</span>
                    </div>`;
            } catch(e) {
                el.innerHTML = `<i class="fas fa-globe" style="font-size:28px;color:#cbd5e1;"></i>`;
            }
        });
    }

    /* ══════════════════════════════════════════════
       ASSESSMENT & TICKET MODAL HANDLERS
    ══════════════════════════════════════════════ */
    let _pendingAssessment = null;
    let _ticketCountdownInterval = null;

    function handleAssessmentClick(assessmentId, assessmentName, isDone, isLocked, isAvailable, topicName, durationMinutes, playMode, timerType, competitiveEnabled) {
        // Enforce strict single-take rule:
        // If student has already completed this assessment, block the ticket modal under all circumstances and open comprehensive results modal
        const rowEl = document.querySelector(`.assessment-row[data-assessment-id="${assessmentId}"]`);
        const rowDoneAttr = rowEl ? (rowEl.getAttribute('data-is-done') === '1' || rowEl.dataset.isDone === '1') : false;
        const isCompleted = isDone === true || isDone === 1 || isDone === '1' || isDone === 'true' || rowDoneAttr;
        if (isCompleted) {
            closeTicketModal();
            openResultModal(assessmentId);
            return;
        }

        if (isLocked) {
            openLockedNoticeModal('This topic or assessment is currently locked by your instructor.', 'Assessment Locked');
            return;
        }
        if (!isAvailable) {
            if (typeof showToast === 'function') {
                showToast('This assessment is not currently available. Please check the start and due date window.', 'warning');
            } else {
                alert('This assessment is not currently available. Please check the start and due date window.');
            }
            return;
        }
        const isDual = (competitiveEnabled == 1 || playMode === 'Competitive' || playMode === 'Versus');
        openTicketConfirmationModal({
            assessmentId,
            assessmentName,
            topicName,
            isDone: false,
            durationMinutes: durationMinutes || 30,
            playMode: isDual ? 'Competitive' : 'Solo',
            competitiveEnabled: isDual ? 1 : 0,
            timerType: timerType || 'Global'
        });
    }

    function openTicketConfirmationModal(data) {
        if (!data) return;
        const rowEl = data.assessmentId ? document.querySelector(`.assessment-row[data-assessment-id="${data.assessmentId}"]`) : null;
        const rowDoneAttr = rowEl ? (rowEl.getAttribute('data-is-done') === '1' || rowEl.dataset.isDone === '1') : false;
        const isCompleted = data.isDone === true || data.isDone === 1 || data.isDone === '1' || data.isDone === 'true' || rowDoneAttr;
        if (isCompleted) {
            openResultModal(data.assessmentId);
            return;
        }
        _pendingAssessment = data;
        if (_ticketCountdownInterval) clearInterval(_ticketCountdownInterval);

        const assEl = document.getElementById('atmAssessmentName');
        if (assEl) assEl.textContent = data.assessmentName;
        const topEl = document.getElementById('atmTopicName');
        if (topEl) topEl.textContent = data.topicName;

        const isDual = (data.competitiveEnabled == 1 || data.playMode === 'Competitive' || data.playMode === 'Versus');
        const modeTextEl = document.getElementById('atmPlayerModeText');
        if (modeTextEl) {
            modeTextEl.innerHTML = isDual 
                ? '<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800 border border-amber-300"><i class="fas fa-users text-amber-600 text-[10px]"></i> 2 Players (Dual / Competitive)</span>'
                : '<span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-cyan-100 text-cyan-800 border border-cyan-300"><i class="fas fa-user text-cyan-600 text-[10px]"></i> Single Player (Individual)</span>';
        }

        const confirmModeBanner = document.getElementById('atmConfirmModeBanner');
        const confirmModeTitle = document.getElementById('atmConfirmModeTitle');
        const confirmModeDesc = document.getElementById('atmConfirmModeDesc');
        const confirmModeIcon = document.getElementById('atmConfirmModeIcon');
        const confirmModeIconWrap = document.getElementById('atmConfirmModeIconWrap');
        if (confirmModeBanner) {
            if (isDual) {
                confirmModeBanner.className = 'p-3.5 rounded-2xl border-2 border-amber-300 bg-amber-50/90 text-xs flex items-start gap-3 text-amber-950 shadow-sm';
                if (confirmModeIconWrap) confirmModeIconWrap.className = 'w-8 h-8 rounded-xl bg-amber-500 flex items-center justify-center flex-shrink-0 text-white shadow-md shadow-amber-500/25';
                if (confirmModeIcon) confirmModeIcon.className = 'fas fa-users text-sm';
                if (confirmModeTitle) confirmModeTitle.textContent = 'Two Players Required (Dual Mode)';
                if (confirmModeDesc) confirmModeDesc.innerHTML = 'This assessment requires two players. Please find a partner before starting the game. Both players must be present at the arcade cabinet.';
            } else {
                confirmModeBanner.className = 'p-3.5 rounded-2xl border-2 border-cyan-300 bg-cyan-50/90 text-xs flex items-start gap-3 text-cyan-950 shadow-sm';
                if (confirmModeIconWrap) confirmModeIconWrap.className = 'w-8 h-8 rounded-xl bg-cyan-600 flex items-center justify-center flex-shrink-0 text-white shadow-md shadow-cyan-600/25';
                if (confirmModeIcon) confirmModeIcon.className = 'fas fa-user text-sm';
                if (confirmModeTitle) confirmModeTitle.textContent = 'Single Player Mode (Individual)';
                if (confirmModeDesc) confirmModeDesc.innerHTML = 'This assessment is for a single player only. Please select individual mode on the arcade machine before starting.';
            }
        }

        const isPerItem = data.timerType === 'PerItem';
        const timerTypeEl = document.getElementById('atmTimerType');
        if (timerTypeEl) {
            timerTypeEl.innerHTML = isPerItem 
                ? '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-amber-100 text-amber-800"><i class="fas fa-hourglass-half text-amber-600 text-[10px]"></i> Per-Item Limit</span>'
                : '<span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-cyan-100 text-cyan-800"><i class="fas fa-stopwatch text-cyan-600 text-[10px]"></i> Global Countdown</span>';
        }

        const durEl = document.getElementById('atmDuration');
        if (durEl) {
            durEl.textContent = isPerItem 
                ? 'Varies per question' 
                : `${data.durationMinutes} Minutes (Session-wide)`;
        }

        const expEl = document.getElementById('atmTimerExplanationText');
        if (expEl) {
            expEl.textContent = isPerItem
                ? 'Each customer question has its own individual patience timer. When time expires on an order, the customer leaves and you move to the next item.'
                : `A single continuous ${data.durationMinutes}-minute global countdown clock runs for the entire game session across all questions.`;
        }

        const prmEl = document.getElementById('atmConfirmPrompt');
        if (prmEl) prmEl.textContent = `Are you ready to start ${data.assessmentName}?`;

        const confirmPhase = document.getElementById('atmConfirmPhase');
        const displayPhase = document.getElementById('atmDisplayPhase');
        if (confirmPhase) confirmPhase.classList.remove('hidden');
        if (displayPhase) displayPhase.classList.add('hidden');

        const modal = document.getElementById('assessmentTicketModal');
        if (modal) {
            modal.classList.remove('hidden');
            if (window.ModalManager) {
                ModalManager.open('assessmentTicketModal');
            }
        }
    }

    function closeTicketModal() {
        if (_ticketCountdownInterval) {
            clearInterval(_ticketCountdownInterval);
            _ticketCountdownInterval = null;
        }
        const modal = document.getElementById('assessmentTicketModal');
        if (modal) {
            if (window.ModalManager) {
                ModalManager.close('assessmentTicketModal');
            } else {
                modal.classList.add('hidden');
            }
        }
    }

    async function confirmGenerateTicket() {
        if (!_pendingAssessment) return;
        const rowEl = _pendingAssessment.assessmentId ? document.querySelector(`.assessment-row[data-assessment-id="${_pendingAssessment.assessmentId}"]`) : null;
        const rowDoneAttr = rowEl ? (rowEl.getAttribute('data-is-done') === '1' || rowEl.dataset.isDone === '1') : false;
        const isCompleted = _pendingAssessment.isDone === true || _pendingAssessment.isDone === 1 || _pendingAssessment.isDone === '1' || _pendingAssessment.isDone === 'true' || rowDoneAttr;
        if (isCompleted) {
            closeTicketModal();
            openResultModal(_pendingAssessment.assessmentId);
            return;
        }
        const btn = document.getElementById('atmGenerateBtn');
        const originalText = btn ? btn.innerHTML : '';
        if (btn) {
            btn.disabled = true;
            btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Generating...`;
        }

        try {
            const resp = await fetch('/student/api/assessment-ticket/generate', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    assessment_id: _pendingAssessment.assessmentId,
                    play_mode: _pendingAssessment.playMode || 'Solo',
                    player_slot: 1
                })
            });

            const data = await resp.json();
            if (!data.success) {
                if (data.is_completed) {
                    closeTicketModal();
                    openResultModal(_pendingAssessment.assessmentId);
                    return;
                }
                alert(data.error || 'Failed to generate assessment ticket.');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = originalText;
                }
                return;
            }

            // Show ticket display phase
            const confirmPhase = document.getElementById('atmConfirmPhase');
            const displayPhase = document.getElementById('atmDisplayPhase');
            if (confirmPhase) confirmPhase.classList.add('hidden');
            if (displayPhase) displayPhase.classList.remove('hidden');

            const qrUrl = data.qr_data_url || data.qrDataUrl || '';
            const tCode = data.ticket_code || data.ticketCode || 'ELM-XXXX-XXXX';
            const expAt = data.expires_at || data.expiresAt;
            const timerType = data.timer_type || (_pendingAssessment && _pendingAssessment.timerType) || 'Global';
            const durationMin = data.duration_minutes || (_pendingAssessment && _pendingAssessment.durationMinutes) || 30;

            const qrImg = document.getElementById('atmQrImage');
            if (qrImg && qrUrl) qrImg.src = qrUrl;
            const codeEl = document.getElementById('atmTicketCodeText');
            if (codeEl) codeEl.textContent = tCode;

            const isDual = (data.competitive_enabled == 1 || data.play_mode === 'Competitive' || data.play_mode === 'Versus' || (_pendingAssessment && _pendingAssessment.competitiveEnabled == 1));

            // Update mode requirement alert banner right inside the modal displaying the code or QR code
            const displayModeBanner = document.getElementById('atmDisplayModeBanner');
            const displayModeIconWrap = document.getElementById('atmDisplayModeIconWrap');
            const displayModeIcon = document.getElementById('atmDisplayModeIcon');
            const displayModeTag = document.getElementById('atmDisplayModeTag');
            const displayModeHeading = document.getElementById('atmDisplayModeHeading');
            const displayModeMessage = document.getElementById('atmDisplayModeMessage');
            const displayModeSubMessage = document.getElementById('atmDisplayModeSubMessage');

            if (displayModeBanner) {
                if (isDual) {
                    displayModeBanner.className = 'p-4 rounded-2xl border-2 border-amber-400 bg-gradient-to-r from-amber-500/15 via-orange-500/15 to-rose-500/15 text-left flex items-start gap-3 shadow-md text-amber-950';
                    if (displayModeIconWrap) displayModeIconWrap.className = 'w-10 h-10 rounded-xl bg-amber-500 flex items-center justify-center flex-shrink-0 text-white shadow-md shadow-amber-500/30';
                    if (displayModeIcon) displayModeIcon.className = 'fas fa-users text-lg';
                    if (displayModeTag) {
                        displayModeTag.className = 'px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-amber-500 text-white shadow-sm';
                        displayModeTag.textContent = '2 PLAYERS REQUIRED';
                    }
                    if (displayModeHeading) {
                        displayModeHeading.className = 'font-bold text-sm text-amber-900';
                        displayModeHeading.textContent = 'Dual / Competitive Mode';
                    }
                    if (displayModeMessage) {
                        displayModeMessage.className = 'font-bold text-xs text-amber-950 leading-relaxed mt-0.5';
                        displayModeMessage.textContent = 'This assessment requires two players. Please find a partner before starting the game.';
                    }
                    if (displayModeSubMessage) {
                        displayModeSubMessage.className = 'text-[11px] text-amber-800/90 mt-1';
                        displayModeSubMessage.innerHTML = 'Switch the arcade machine to <strong>Dual / Competitive Mode</strong>. Both cadets must scan their tickets at the cabinet to begin.';
                    }
                } else {
                    displayModeBanner.className = 'p-4 rounded-2xl border-2 border-cyan-400 bg-gradient-to-r from-cyan-500/15 to-indigo-500/15 text-left flex items-start gap-3 shadow-md text-cyan-950';
                    if (displayModeIconWrap) displayModeIconWrap.className = 'w-10 h-10 rounded-xl bg-cyan-600 flex items-center justify-center flex-shrink-0 text-white shadow-md shadow-cyan-600/30';
                    if (displayModeIcon) displayModeIcon.className = 'fas fa-user text-lg';
                    if (displayModeTag) {
                        displayModeTag.className = 'px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-cyan-600 text-white shadow-sm';
                        displayModeTag.textContent = '1 PLAYER ONLY';
                    }
                    if (displayModeHeading) {
                        displayModeHeading.className = 'font-bold text-sm text-cyan-900';
                        displayModeHeading.textContent = 'Individual Mode Assessment';
                    }
                    if (displayModeMessage) {
                        displayModeMessage.className = 'font-bold text-xs text-cyan-950 leading-relaxed mt-0.5';
                        displayModeMessage.textContent = 'This assessment is for a single player only. Please select individual mode before starting the game.';
                    }
                    if (displayModeSubMessage) {
                        displayModeSubMessage.className = 'text-[11px] text-cyan-800/90 mt-1';
                        displayModeSubMessage.innerHTML = 'Switch the arcade machine to <strong>Individual Mode</strong>. Scanning in dual mode will be blocked.';
                    }
                }
            }

            // Update top mode badge
            const displayModeBadge = document.getElementById('atmDisplayModeBadge');
            const displayModeBadgeIcon = document.getElementById('atmDisplayModeBadgeIcon');
            const displayModeBadgeText = document.getElementById('atmDisplayModeBadgeText');
            if (displayModeBadge && displayModeBadgeText) {
                if (isDual) {
                    displayModeBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold border border-amber-300';
                    if (displayModeBadgeIcon) displayModeBadgeIcon.className = 'fas fa-users text-amber-600';
                    displayModeBadgeText.textContent = '2 Players Required';
                } else {
                    displayModeBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-100 text-cyan-800 text-xs font-bold border border-cyan-300';
                    if (displayModeBadgeIcon) displayModeBadgeIcon.className = 'fas fa-user text-cyan-600';
                    displayModeBadgeText.textContent = 'Single Player';
                }
            }

            // Update instructions list
            const instructionsList = document.getElementById('atmDisplayInstructionsList');
            if (instructionsList) {
                if (isDual) {
                    instructionsList.innerHTML = `
                        <li>Walk to any <strong>Elementa Arcade Kiosk</strong> with your partner.</li>
                        <li>Select <strong>Dual / Competitive Mode</strong> on the console.</li>
                        <li>Player 1 and Player 2 scan their QR codes or type their codes to begin!</li>
                    `;
                } else {
                    instructionsList.innerHTML = `
                        <li>Walk to any <strong>Elementa Arcade Kiosk</strong>.</li>
                        <li>Select <strong>Individual Mode</strong> on the arcade console.</li>
                        <li>Aim this QR code at the <strong>TekLead USB Scanner</strong> or type the code.</li>
                    `;
                }
            }

            // Update timer badge in ticket display phase
            const timerBadge = document.getElementById('atmDisplayTimerBadge');
            const timerBadgeText = document.getElementById('atmDisplayTimerText');
            if (timerBadge && timerBadgeText) {
                if (timerType === 'PerItem') {
                    timerBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-amber-100 text-amber-800 text-xs font-bold';
                    timerBadge.innerHTML = '<i class="fas fa-hourglass-half text-amber-600"></i><span id="atmDisplayTimerText">Per-Item Limit</span>';
                } else {
                    timerBadge.className = 'inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-cyan-100 text-cyan-800 text-xs font-bold';
                    timerBadge.innerHTML = `<i class="fas fa-stopwatch text-cyan-600"></i><span id="atmDisplayTimerText">Global: ${durationMin} mins</span>`;
                }
            }

            // Start countdown timer
            if (expAt) {
                startTicketCountdown(expAt);
            }
        } catch (err) {
            console.error('Ticket generation error:', err);
            alert('Network error while generating ticket. Please try again.');
        } finally {
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = originalText;
            }
        }
    }

    function startTicketCountdown(expiresAt) {
        if (_ticketCountdownInterval) clearInterval(_ticketCountdownInterval);
        const expireTime = new Date(expiresAt).getTime();

        function update() {
            const now = Date.now();
            const diff = expireTime - now;
            const countdownEl = document.getElementById('atmCountdownText');
            if (diff <= 0) {
                if (countdownEl) countdownEl.textContent = 'Ticket Expired';
                clearInterval(_ticketCountdownInterval);
                return;
            }
            const mins = Math.floor(diff / 60000);
            const secs = Math.floor((diff % 60000) / 1000);
            const formatted = `${String(mins).padStart(2, '0')}:${String(secs).padStart(2, '0')}`;
            if (countdownEl) countdownEl.textContent = `Ticket Active · ${formatted} remaining`;
        }

        update();
        _ticketCountdownInterval = setInterval(update, 1000);
    }

    function openTicketClipboardModal(code) {
        const msgEl = document.getElementById('ticketClipboardMessage');
        if (msgEl) {
            msgEl.textContent = 'Ticket code copied: ' + (code || 'ELM-XXXX-XXXX');
        }
        if (window.ModalManager && typeof ModalManager.open === 'function') {
            ModalManager.open('ticketClipboardModal');
        } else {
            const modal = document.getElementById('ticketClipboardModal');
            if (modal) modal.classList.remove('hidden');
        }
    }

    function closeTicketClipboardModal() {
        if (window.ModalManager && typeof ModalManager.close === 'function') {
            ModalManager.close('ticketClipboardModal');
        } else {
            const modal = document.getElementById('ticketClipboardModal');
            if (modal) modal.classList.add('hidden');
        }
    }

    // Escape listener for ticketClipboardModal
    window.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            const modal = document.getElementById('ticketClipboardModal');
            if (modal && !modal.classList.contains('hidden')) {
                closeTicketClipboardModal();
            }
        }
    });

    function copyTicketCode() {
        const codeEl = document.getElementById('atmTicketCodeText');
        const code = codeEl ? codeEl.textContent.trim() : '';
        if (!code) return;

        function notifySuccess() {
            openTicketClipboardModal(code);
        }

        if (navigator.clipboard && navigator.clipboard.writeText) {
            navigator.clipboard.writeText(code).then(() => {
                notifySuccess();
            }).catch(err => {
                console.warn('Clipboard writeText failed, attempting fallback copy:', err);
                fallbackCopy(code);
            });
        } else {
            fallbackCopy(code);
        }

        function fallbackCopy(text) {
            try {
                const textArea = document.createElement('textarea');
                textArea.value = text;
                textArea.style.position = 'fixed';
                textArea.style.left = '-9999px';
                textArea.style.top = '-9999px';
                document.body.appendChild(textArea);
                textArea.focus();
                textArea.select();
                document.execCommand('copy');
                document.body.removeChild(textArea);
                notifySuccess();
            } catch (e) {
                console.error('Fallback clipboard copy failed:', e);
                notifySuccess();
            }
        }
    }

