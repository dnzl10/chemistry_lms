    /* ── Pie Chart ── */
    function drawArmPie(pct) {
        const canvas = document.getElementById('armPieChart');
        const ctx = canvas.getContext('2d');
        const cx = 55, cy = 55, r = 46, lineW = 10;
        const startAngle = -Math.PI / 2;
        const fillAngle = startAngle + (pct / 100) * 2 * Math.PI;

        ctx.clearRect(0, 0, 110, 110);

        // Track
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, 2 * Math.PI);
        ctx.strokeStyle = '#e2e8f0'; ctx.lineWidth = lineW; ctx.stroke();

        // Fill
        const color = pct >= 75 ? '#22c55e' : pct >= 50 ? '#f59e0b' : '#ef4444';
        ctx.beginPath();
        ctx.arc(cx, cy, r, startAngle, fillAngle);
        ctx.strokeStyle = color; ctx.lineWidth = lineW;
        ctx.lineCap = 'round'; ctx.stroke();
    }

    /* ── Element Card HTML ── */
    function elementCardHtml(symbol, subscript, cls) {
        // Get atomic number from a small lookup (common chemistry elements)
        const atomicNums = {H:1,He:2,Li:3,Be:4,B:5,C:6,N:7,O:8,F:9,Ne:10,Na:11,Mg:12,Al:13,Si:14,P:15,S:16,Cl:17,Ar:18,K:19,Ca:20,Sc:21,Ti:22,V:23,Cr:24,Mn:25,Fe:26,Co:27,Ni:28,Cu:29,Zn:30,Ga:31,Ge:32,As:33,Se:34,Br:35,Kr:36,Rb:37,Sr:38,Y:39,Zr:40,Nb:41,Mo:42,Tc:43,Ru:44,Rh:45,Pd:46,Ag:47,Cd:48,In:49,Sn:50,Sb:51,Te:52,I:53,Xe:54,Cs:55,Ba:56,La:57,Ce:58,Pr:59,Nd:60,Pm:61,Sm:62,Eu:63,Gd:64,Tb:65,Dy:66,Ho:67,Er:68,Tm:69,Yb:70,Lu:71,Hf:72,Ta:73,W:74,Re:75,Os:76,Ir:77,Pt:78,Au:79,Hg:80,Tl:81,Pb:82,Bi:83,Po:84,At:85,Rn:86,Fr:87,Ra:88,Ac:89,Th:90,Pa:91,U:92,Np:93,Pu:94};
        const num = atomicNums[symbol] || '';
        const sub = subscript ? `<span class="el-sub">${subscript}</span>` : '';
        return `<div class="element-card ${cls}">
            <span class="el-num">${num}</span>
            <span class="el-sym">${symbol}</span>
            ${sub}
        </div>`;
    }

    /* ── Build Analysis Questions ── */
    function buildAnalysisQuestions(questions, timerType) {
        const container = document.getElementById('armQuestionsList');
        container.innerHTML = '';
        questions.forEach((q, i) => {
            const isCorrect = q.is_correct == 1;
            const badge = isCorrect
                ? `<span style="font-size:12px;font-weight:800;background:#dcfce7;color:#15803d;padding:3px 10px;border-radius:9999px;"><i class="fas fa-check" style="margin-right:3px;"></i>Correct</span>`
                : `<span style="font-size:12px;font-weight:800;background:#fee2e2;color:#dc2626;padding:3px 10px;border-radius:9999px;"><i class="fas fa-times" style="margin-right:3px;"></i>Wrong</span>`;

            const ms = q.response_time_ms;
            const timeBadge = ms != null
                ? `<span style="font-size:12px;font-weight:700;color:#64748b;background:#f1f5f9;padding:3px 8px;border-radius:9999px;"><i class="fas fa-stopwatch" style="font-size:12px;margin-right:3px;"></i>${(ms/1000).toFixed(1)}s</span>`
                : '';

            const perItemTimer = (timerType === 'PerItem' && q.time_limit)
                ? `<span style="font-size:12px;font-weight:700;color:#f97316;background:#fff7ed;padding:3px 8px;border-radius:9999px;"><i class="fas fa-clock" style="font-size:12px;margin-right:3px;"></i>${q.time_limit}s limit</span>`
                : '';

            let answerHtml = '';

            const hasMcqOpts = !!(q.option_a || q.option_b || q.option_c || q.option_d);
            if ((['Standard', 'standard_mcq'].includes(q.input_mode) || !q.input_mode) && hasMcqOpts) {
                // MCQ choices
                const opts = ['a','b','c','d'];
                answerHtml = `<div style="display:flex;flex-direction:column;gap:6px;margin-top:8px;">`;
                opts.forEach(letter => {
                    const txt = q[`option_${letter}`];
                    if (!txt) return;
                    const img = q[`option_${letter}_image`];
                    const isCorrectOpt = q.correct_answer && q.correct_answer.toLowerCase().includes(letter);
                    const isStudentOpt = q.selected_option && q.selected_option.toLowerCase().includes(letter);
                    const isWrongStudent = isStudentOpt && !isCorrectOpt;
                    let cls = 'option-choice';
                    if (isCorrectOpt) cls += ' correct-opt';
                    if (isStudentOpt) cls += ' student-opt';
                    if (isWrongStudent) cls += ' wrong-student';
                    const imgTag = img ? `<img src="/material_uploads/${img}" style="height:40px;border-radius:6px;object-fit:cover;margin-top:4px;">` : '';
                    const letterBadge = `<span style="width:20px;height:20px;border-radius:50%;background:${isCorrectOpt?'#22c55e':isWrongStudent?'#ef4444':'#e2e8f0'};color:${isCorrectOpt||isWrongStudent?'#fff':'#64748b'};font-size:12px;font-weight:900;display:flex;align-items:center;justify-content:center;flex-shrink:0;">${letter.toUpperCase()}</span>`;
                    const icons = `${isCorrectOpt ? '<i class="fas fa-check-circle" style="color:#22c55e;font-size:12px;margin-left:auto;flex-shrink:0;"></i>' : ''}${isStudentOpt && !isCorrectOpt ? '<i class="fas fa-circle" style="color:#f97316;font-size:12px;margin-left:auto;flex-shrink:0;border:2px solid #f97316;border-radius:50%;"></i>' : ''}`;
                    answerHtml += `<div class="${cls}">${letterBadge}<div style="flex:1;">${txt}${imgTag}</div>${icons}</div>`;
                });
                answerHtml += `</div>`;

            } else if (q.input_mode === 'Numeric') {
                // Numeric
                const correctNum = q.numeric_answer;
                const studentNum = q.selected_option || q.student_answer;
                answerHtml = `<div style="display:flex;gap:12px;margin-top:8px;flex-wrap:wrap;">
                    <div style="background:#f0fdf4;border:2px solid #22c55e;border-radius:12px;padding:10px 18px;text-align:center;">
                        <p style="font-size:12px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin-bottom:3px;">Correct</p>
                        <p style="font-size:22px;font-weight:900;color:#15803d;font-family:monospace;">${correctNum}<span style="font-size:12px;color:#94a3b8;">±${q.numeric_tolerance||0}</span></p>
                    </div>
                    <div style="background:${isCorrect?'#f0fdf4':'#fff1f2'};border:2px solid ${isCorrect?'#22c55e':'#f97316'};border-radius:12px;padding:10px 18px;text-align:center;">
                        <p style="font-size:12px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin-bottom:3px;">Your Answer</p>
                        <p style="font-size:22px;font-weight:900;color:${isCorrect?'#15803d':'#ea580c'};font-family:monospace;">${studentNum||'—'}</p>
                    </div>
                </div>`;

            } else if (q.input_mode === 'Periodic_Single') {
                // Single element
                const correctSym = q.correct_answer || '?';
                const studentSym = q.selected_option || q.student_answer || '?';
                answerHtml = `<div style="display:flex;gap:14px;align-items:center;margin-top:8px;flex-wrap:wrap;">
                    <div>
                        <p style="font-size:12px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin-bottom:5px;">Correct Answer</p>
                        ${elementCardHtml(correctSym, '', 'correct-el')}
                    </div>`;
                if (!isCorrect) {
                    answerHtml += `<div>
                        <p style="font-size:12px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin-bottom:5px;">Your Answer</p>
                        ${elementCardHtml(studentSym, '', 'student-el')}
                    </div>`;
                }
                answerHtml += `</div>`;

            } else if (q.input_mode === 'Periodic_Sequence') {
                // Sequence of elements
                const seqHtml = (q.sequences || []).map(s => elementCardHtml(s.element_symbol, s.subscript, 'correct-el')).join('<span style="font-size:16px;color:#94a3b8;align-self:center;">→</span>');
                const studentSeqRaw = q.selected_option || q.student_answer || '';
                let studentSeqHtml = '';
                try {
                    const parsed = JSON.parse(studentSeqRaw);
                    if (Array.isArray(parsed)) {
                        studentSeqHtml = parsed.map(s => elementCardHtml(s.symbol||s.element_symbol, s.subscript||'', isCorrect?'correct-el':'student-el')).join('<span style="font-size:16px;color:#94a3b8;align-self:center;">→</span>');
                    } else { studentSeqHtml = `<span style="color:#94a3b8;">${studentSeqRaw}</span>`; }
                } catch(e) { studentSeqHtml = `<span style="color:#94a3b8;">${studentSeqRaw}</span>`; }

                answerHtml = `<div style="margin-top:10px;">
                    <p style="font-size:12px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin-bottom:6px;">Correct Sequence</p>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">${seqHtml}</div>
                    ${!isCorrect ? `<p style="font-size:12px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin:10px 0 6px;">Your Sequence</p>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">${studentSeqHtml}</div>` : ''}
                </div>`;
            } else if (q.student_answer || q.correct_answer || q.selected_option) {
                // Arcade Machine / Direct Formula / Lab Console Delivered Output
                const correctAns = q.correct_answer || '—';
                const studentAns = q.student_answer || q.selected_option || (q.is_timeout ? 'TIMEOUT' : 'No Output');
                answerHtml = `
                    <div style="display:flex;gap:12px;margin-top:12px;flex-wrap:wrap;">
                        <div style="background:#f0fdf4;border:1.5px solid #22c55e;border-radius:12px;padding:8px 14px;flex:1;min-width:140px;">
                            <p style="font-size:11px;font-weight:800;color:#15803d;text-transform:uppercase;margin-bottom:2px;">Target Formula / Answer</p>
                            <p style="font-size:14px;font-weight:900;color:#15803d;font-family:monospace;">${correctAns}</p>
                        </div>
                        <div style="background:${isCorrect?'#f0fdf4':'#fff1f2'};border:1.5px solid ${isCorrect?'#22c55e':'#f43f5e'};border-radius:12px;padding:8px 14px;flex:1;min-width:140px;">
                            <p style="font-size:11px;font-weight:800;color:${isCorrect?'#15803d':'#be123c'};text-transform:uppercase;margin-bottom:2px;">Delivered / Answer</p>
                            <p style="font-size:14px;font-weight:900;color:${isCorrect?'#15803d':'#e11d48'};font-family:monospace;">${studentAns}</p>
                        </div>
                    </div>`;
            }

            const explanationText = q.advice_text || q.explanation;
            const explanationHtml = explanationText ? `
                <div style="margin-top:12px;padding:12px 14px;background:#f8fafc;border-left:4px solid #0891b2;border-radius:8px;">
                    <span style="font-size:11px;font-weight:800;color:#0e7490;text-transform:uppercase;letter-spacing:0.05em;display:flex;align-items:center;gap:5px;margin-bottom:4px;">
                        <i class="fas fa-lightbulb text-amber-500"></i> Explanation & Discussion
                    </span>
                    <p style="font-size:13px;font-weight:500;color:#334155;line-height:1.5;margin:0;">${explanationText}</p>
                </div>` : '';

            const card = document.createElement('div');
            card.className = 'q-result-card';
            card.innerHTML = `
                <div style="padding:14px 16px;border-bottom:1.5px solid #f1f5f9;">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                        <div style="display:flex;align-items:flex-start;gap:10px;flex:1;">
                            <div style="width:30px;height:30px;border-radius:10px;background:${isCorrect?'#dcfce7':'#fee2e2'};display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:14px;font-weight:900;color:${isCorrect?'#15803d':'#dc2626'};">${i+1}</div>
                            <p style="font-size:14px;font-weight:700;color:#1e293b;line-height:1.5;flex:1;">${q.question_text || q.question}</p>
                        </div>
                        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;">${badge}${timeBadge}${perItemTimer}</div>
                    </div>
                    ${answerHtml}
                    ${explanationHtml}
                </div>
                <div style="padding:8px 16px;background:#f8fafc;display:flex;align-items:center;gap:8px;">
                    <span style="font-size:12px;font-weight:700;color:#94a3b8;">Mechanic:</span>
                    <span style="font-size:12px;font-weight:800;color:#0891b2;background:#ecfeff;padding:2px 8px;border-radius:9999px;">${q.mechanic_type||'Standard'}</span>
                    <span style="font-size:12px;font-weight:700;color:${isCorrect?'#059669':'#94a3b8'};margin-left:auto;">${isCorrect ? `+${q.base_exp||100} EXP` : '+0 EXP'}</span>
                </div>`;
            container.appendChild(card);
        });
    }

    /* ── Build Review Questions ── */
    function buildReviewQuestions(questions) {
        const container = document.getElementById('armReviewList');
        container.innerHTML = '';

        const withRemediation = questions.filter(q => q.remediation_id);
        if (withRemediation.length === 0) {
            container.innerHTML = `
                <div class="p-8 text-center bg-emerald-50 rounded-2xl border border-emerald-200">
                    <div class="w-12 h-12 rounded-full bg-emerald-100 text-emerald-600 flex items-center justify-center mx-auto mb-3 text-xl font-bold">
                        <i class="fas fa-star"></i>
                    </div>
                    <h4 class="font-extrabold text-emerald-900 text-sm">Great Performance!</h4>
                    <p class="text-xs text-emerald-700 mt-1">No remediation materials needed for this assessment.</p>
                </div>`;
            return;
        }

        withRemediation.forEach((q, i) => {
            let preview = null;
            if (q.preview_json) {
                try { preview = typeof q.preview_json === 'string' ? JSON.parse(q.preview_json) : q.preview_json; } catch(e) {}
            }
            const remDate = q.remediation_created_at
                ? new Date(q.remediation_created_at).toLocaleDateString('en-PH', { dateStyle: 'medium' }) : '—';

            let thumbHtml = '';
            if (preview && preview.thumbnail) {
                thumbHtml = `<img src="${preview.thumbnail}" style="width:100%;height:110px;object-fit:cover;display:block;" onerror="this.style.display='none'">`;
            }

            let matHtml = '';
            if (q.material_title) {
                matHtml = `<div style="display:flex;align-items:center;gap:6px;margin-top:8px;padding:7px 10px;background:#ecfeff;border-radius:9px;border:1.5px solid #cffafe;">
                    <i class="fas fa-file-alt" style="font-size:12px;color:#0891b2;"></i>
                    <span style="font-size:12px;font-weight:700;color:#0891b2;">${q.material_title}</span>
                </div>`;
            }

            let linkHtml = '';
            if (q.link_url) {
                const domain = (() => { try { return new URL(q.link_url).hostname.replace('www.',''); } catch(e) { return q.link_url; }})();
                linkHtml = `<a href="${q.link_url}" target="_blank" rel="noopener noreferrer"
                    style="display:flex;gap:10px;border-radius:10px;border:1.5px solid #e0e7ff;overflow:hidden;background:#fff;margin-top:8px;text-decoration:none;transition:box-shadow 0.15s;"
                    onmouseover="this.style.boxShadow='0 4px 16px rgba(8,145,178,0.12)'"
                    onmouseout="this.style.boxShadow='none'">
                    ${thumbHtml ? `<div style="width:100px;flex-shrink:0;overflow:hidden;">${thumbHtml}</div>` : ''}
                    <div style="padding:10px 12px;flex:1;min-width:0;">
                        <p style="font-size:14px;font-weight:800;color:#1e293b;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${(preview&&preview.title)||domain}</p>
                        ${preview&&preview.description ? `<p style="font-size:12px;color:#64748b;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">${preview.description}</p>` : ''}
                        <p style="font-size:12px;font-weight:700;color:#0891b2;margin-top:5px;"><i class="fas fa-external-link-alt" style="font-size:12px;"></i> ${domain}</p>
                    </div>
                </a>`;
            }

            const card = document.createElement('div');
            card.className = 'remediation-card';
            card.innerHTML = `
                <div style="padding:14px 16px;border-bottom:1.5px solid #e0e7ff;">
                    <div style="display:flex;align-items:flex-start;gap:10px;">
                        <div style="width:28px;height:28px;border-radius:9px;background:#e0e7ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:900;color:#4338ca;">${i+1}</div>
                        <p style="font-size:14px;font-weight:700;color:#1e293b;line-height:1.5;">${q.question_text || q.question}</p>
                    </div>
                </div>
                <div style="padding:14px 16px;">
                    ${q.advice_text ? `<div style="background:#fffbeb;border-left:4px solid #f59e0b;border-radius:0 10px 10px 0;padding:10px 14px;margin-bottom:10px;">
                        <p style="font-size:12px;font-weight:800;color:#92400e;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;"><i class="fas fa-lightbulb" style="margin-right:4px;"></i>Advice</p>
                        <p style="font-size:14px;color:#78350f;line-height:1.6;">${q.advice_text}</p>
                    </div>` : ''}
                    ${matHtml}
                    ${linkHtml}
                    <p style="font-size:12px;color:#94a3b8;font-weight:600;margin-top:10px;"><i class="fas fa-clock" style="font-size:12px;margin-right:3px;"></i>Added ${remDate}</p>
                </div>`;
            container.appendChild(card);
        });
    }

    /* ── Build Arcade Analysis Orders ── */
    function buildArcadeAnalysis(attempts) {
        const container = document.getElementById('armQuestionsList');
        if (!container) return;
        container.innerHTML = '';

        attempts.forEach((att, i) => {
            const isCorrect = att.is_correct == 1;
            const badge = isCorrect
                ? `<span style="font-size:12px;font-weight:800;background:#dcfce7;color:#15803d;padding:3px 10px;border-radius:9999px;"><i class="fas fa-check" style="margin-right:3px;"></i>Success</span>`
                : `<span style="font-size:12px;font-weight:800;background:#fee2e2;color:#dc2626;padding:3px 10px;border-radius:9999px;"><i class="fas fa-times" style="margin-right:3px;"></i>${att.is_timeout ? 'Timeout' : 'Failed'}</span>`;

            const rtVal = parseFloat(att.response_time_s);
            const timeBadge = !isNaN(rtVal) && rtVal > 0
                ? `<span style="font-size:12px;font-weight:700;color:#64748b;background:#f1f5f9;padding:3px 8px;border-radius:9999px;"><i class="fas fa-stopwatch" style="font-size:12px;margin-right:3px;"></i>${rtVal.toFixed(1)}s</span>`
                : '';

            const hesVal = parseFloat(att.hesitation_score);
            const hesitationBadge = !isNaN(hesVal) && hesVal > 0
                ? `<span style="font-size:12px;font-weight:700;color:#f97316;background:#fff7ed;padding:3px 8px;border-radius:9999px;"><i class="fas fa-brain" style="font-size:12px;margin-right:3px;"></i>Hesitation: ${(hesVal * 100).toFixed(0)}%</span>`
                : '';

            const hasHint = att.scaffolding_used && !['0', 0, 'none', 'false', 'null', ''].includes(String(att.scaffolding_used).trim().toLowerCase());

            const card = document.createElement('div');
            card.className = 'q-result-card';
            card.innerHTML = `
                <div style="padding:14px 16px;border-bottom:1.5px solid #f1f5f9;">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                        <div style="display:flex;align-items:flex-start;gap:10px;flex:1;">
                            <div style="width:30px;height:30px;border-radius:10px;background:${isCorrect?'#dcfce7':'#fee2e2'};display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:14px;font-weight:900;color:${isCorrect?'#15803d':'#dc2626'};">${i+1}</div>
                            <div style="flex:1;">
                                <span style="font-size:11px;font-weight:800;color:#0891b2;text-transform:uppercase;letter-spacing:0.05em;">Customer Order #${att.customer_index || i+1}</span>
                                <p style="font-size:14px;font-weight:700;color:#1e293b;line-height:1.5;margin-top:2px;">${att.question_snapshot || 'Elemental Request'}</p>
                            </div>
                        </div>
                        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;">
                            ${badge}
                            ${timeBadge}
                            ${hesitationBadge}
                        </div>
                    </div>

                    <div style="display:flex;gap:12px;margin-top:12px;flex-wrap:wrap;">
                        <div style="background:#f0fdf4;border:1.5px solid #22c55e;border-radius:12px;padding:8px 14px;flex:1;min-width:140px;">
                            <p style="font-size:11px;font-weight:800;color:#15803d;text-transform:uppercase;margin-bottom:2px;">Target Formula / Answer</p>
                            <p style="font-size:15px;font-weight:900;color:#15803d;font-family:monospace;">${att.correct_answer || '—'}</p>
                        </div>
                        <div style="background:${isCorrect?'#f0fdf4':'#fff1f2'};border:1.5px solid ${isCorrect?'#22c55e':'#f43f5e'};border-radius:12px;padding:8px 14px;flex:1;min-width:140px;">
                            <p style="font-size:11px;font-weight:800;color:${isCorrect?'#15803d':'#be123c'};text-transform:uppercase;margin-bottom:2px;">Delivered / Selected</p>
                            <p style="font-size:15px;font-weight:900;color:${isCorrect?'#15803d':'#e11d48'};font-family:monospace;">${att.player_answer || (att.is_timeout ? 'TIMEOUT' : 'No Output')}</p>
                        </div>
                    </div>

                    ${!isCorrect && att.failure_type ? `
                        <div style="margin-top:8px;padding:6px 10px;background:#fef2f2;border-radius:8px;font-size:12px;color:#991b1b;font-weight:600;">
                            <i class="fas fa-exclamation-triangle mr-1"></i> Root Cause: <span style="font-weight:800;text-transform:capitalize;">${(att.failure_type || '').replace(/_/g, ' ')}</span>
                        </div>
                    ` : ''}

                    ${(att.advice_text || att.explanation || att.discussion) ? `
                        <div style="margin-top:10px;padding:10px 12px;background:#f8fafc;border-left:4px solid #0891b2;border-radius:8px;">
                            <span style="font-size:11px;font-weight:800;color:#0e7490;text-transform:uppercase;letter-spacing:0.05em;display:flex;align-items:center;gap:5px;margin-bottom:3px;">
                                <i class="fas fa-lightbulb text-amber-500"></i> Solution & Discussion
                            </span>
                            <p style="font-size:12px;font-weight:500;color:#334155;line-height:1.5;margin:0;">${att.advice_text || att.explanation || att.discussion}</p>
                        </div>
                    ` : ''}
                </div>
                <div style="padding:8px 16px;background:#f8fafc;display:flex;align-items:center;gap:8px;">
                    <span style="font-size:12px;font-weight:700;color:#94a3b8;">Arcade Module:</span>
                    <span style="font-size:12px;font-weight:800;color:#0891b2;background:#ecfeff;padding:2px 8px;border-radius:9999px;">${att.machine_used || 'Reaction Console'}</span>
                    ${hasHint ? '<span style="font-size:11px;font-weight:700;color:#d97706;background:#fef3c7;padding:2px 8px;border-radius:9999px;"><i class="fas fa-life-ring"></i> Hint Used</span>' : ''}
                </div>`;
            container.appendChild(card);
        });
    }

    /* ── Build Arcade Remediation Review ── */
    function buildArcadeReview(attempts) {
        const container = document.getElementById('armReviewList');
        if (!container) return;
        container.innerHTML = '';

        const failedAttempts = attempts.filter(a => a.is_correct == 0);
        if (failedAttempts.length === 0) {
            container.innerHTML = `
