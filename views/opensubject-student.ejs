        const maxWordsEl = document.getElementById('subReqMaxWords');
        if (maxWordsEl) maxWordsEl.textContent = maxWords ? `Max: ${maxWords} words` : 'Max: Unlimited';

        const blankEl = document.getElementById('subReqBlank');
        if (blankEl) blankEl.textContent = disallowBlank ? 'Strict' : 'Permitted';

        const typesStr = (allowedTypes || '.pdf,.docx,.doc').toLowerCase();
