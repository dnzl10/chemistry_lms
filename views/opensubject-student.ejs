    function switchArmTab(tab) {
        document.getElementById('armAnalysis').style.display = tab === 'analysis' ? 'flex' : 'none';
        document.getElementById('armReview').style.display   = tab === 'review'   ? 'block' : 'none';
        document.getElementById('armTabAnalysis').classList.toggle('active', tab === 'analysis');
        document.getElementById('armTabReview').classList.toggle('active', tab === 'review');
    }

    async function openResultModal(assessmentId) {
        closeTicketModal();
        const modal = document.getElementById('assessmentResultModal');
        if (window.ModalManager) {
            ModalManager.open('assessmentResultModal');
        } else {
            modal.classList.remove('hidden');
        }
        switchArmTab('analysis');
        document.getElementById('armLoader').style.display = 'flex';
        document.getElementById('armAnalysis').style.display = 'none';
        document.getElementById('armReview').style.display = 'none';

        try {
            const res = await fetch(`/api/assessment-result/${assessmentId}`);
            const { score, questions, arcadeAttempts, dualMatch } = await res.json();

            // Header meta
            const totalItemsCount = score.total_items || score.total_possible_score || (arcadeAttempts ? arcadeAttempts.length : (questions ? questions.length : '—'));
            document.getElementById('armTitle').textContent = score.assessment_name;
            if (dualMatch && dualMatch.isDual) {
                const outcomeLabel = dualMatch.outcome === 'VICTORY' ? '🏆 VICTORY' : (dualMatch.outcome === 'DEFEAT' ? '🥈 RUNNER-UP' : '🤝 DRAW');
                document.getElementById('armMeta').textContent =
                    `1v1 Dual Clash · ${score.assessment_type || 'Competitive'} · ${totalItemsCount} Items · ${outcomeLabel}`;
            } else {
                document.getElementById('armMeta').textContent =
                    `${score.assessment_type || 'Arcade Assessment'} · ${totalItemsCount} Items`;
            }

            // 1v1 Dual Arena Match Telemetry Container Rendering
            const dualContainer = document.getElementById('armDualClashContainer');
            if (dualContainer) {
                if (dualMatch && dualMatch.isDual) {
                    dualContainer.style.display = 'block';
                    dualContainer.innerHTML = renderDualClashCard(dualMatch);
                } else {
                    dualContainer.style.display = 'none';
                    dualContainer.innerHTML = '';
                }
            }

            // Score stats
            const pct = score.total_possible_score > 0
                ? Math.round((score.score_obtained / score.total_possible_score) * 100) : 0;
            document.getElementById('armScorePct').textContent = pct + '%';
            document.getElementById('armScoreVal').textContent  = `${score.score_obtained}/${score.total_possible_score}`;
            document.getElementById('armExpVal').textContent    = '+' + (score.exp_gained || 0) + ' EXP';
            document.getElementById('armItemsVal').textContent  = totalItemsCount;
            document.getElementById('armTimerVal').textContent  =
                score.timer_type === 'Global'
                    ? `${score.duration_minutes || '—'} min (Global)`
                    : (score.timer_type === 'PerItem' ? 'Per Item' : (score.assessment_type === 'Assignment' ? 'Untimed' : 'Arcade Kiosk'));

            // Pie chart
            drawArmPie(pct);

            // Questions / Arcade Attempts
            if (questions && questions.length > 0) {
                buildAnalysisQuestions(questions, score.timer_type);
                buildReviewQuestions(questions);
            } else if (arcadeAttempts && arcadeAttempts.length > 0) {
                buildArcadeAnalysis(arcadeAttempts);
                buildArcadeReview(arcadeAttempts);
            } else {
                const feedbackHtml = score.feedback ? `
                    <div style="background:#eef2ff;border:1.5px solid #c7d2fe;border-radius:12px;padding:14px 16px;margin-bottom:14px;text-align:left;">
                        <span style="font-size:11px;font-weight:800;color:#4338ca;text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:4px;"><i class="fas fa-comment-alt" style="margin-right:5px;"></i>Teacher Feedback</span>
                        <p style="font-size:13px;font-weight:600;color:#1e293b;line-height:1.5;margin:0;">${score.feedback}</p>
                    </div>` : '';

                document.getElementById('armQuestionsList').innerHTML = feedbackHtml +
                    '<div class="text-center p-8 text-slate-400 font-bold text-xs"><i class="fas fa-clipboard-check text-2xl mb-2 text-slate-300 block"></i>Assessment completed. Score recorded in gradebook.</div>';
                document.getElementById('armReviewList').innerHTML =
                    '<div class="text-center p-8 text-slate-400 font-bold text-xs"><i class="fas fa-book-open text-2xl mb-2 text-slate-300 block"></i>No remediation materials flagged for this performance.</div>';
            }

            document.getElementById('armLoader').style.display = 'none';
            document.getElementById('armAnalysis').style.display = 'flex';

        } catch(err) {
            console.error('Failed to load assessment result:', err);
            document.getElementById('armLoader').innerHTML =
                `<p style="color:#ef4444;font-weight:700;">Failed to load results.</p>`;
        }
    }

