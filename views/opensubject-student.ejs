    </div>
    <script>
        function openStudentAttendanceModal() {
            const m = document.getElementById('studentAttendanceModal');
            if (m) m.classList.remove('hidden');
        }
        function closeStudentAttendanceModal() {
            const m = document.getElementById('studentAttendanceModal');
            if (m) m.classList.add('hidden');
        }
    </script>
</body>
</html>