        loadingDiv.classList.remove('hidden');

        try {
            const res = await fetch('/api/material/' + materialId + '/ai-data');
            const data = await res.json();

            if (!res.ok) throw new Error(data.error || 'Failed to fetch AI data');

            loadingDiv.classList.add('hidden');
            contentDiv.classList.remove('hidden');

            if (data.ai_status === 'pending' || data.ai_status === 'processing') {
                contentDiv.innerHTML = '<div class="p-8 text-center"><i class="fas fa-spinner fa-spin text-4xl text-indigo-500 mb-4"></i><p>The AI is currently processing this document. Please check back in a few minutes!</p><div class="mt-4"><button onclick="openAIGuide(\'' + escapeHtml(materialId) + '\')" class="px-4 py-2 bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs rounded-xl transition">Refresh Status</button></div></div>';
