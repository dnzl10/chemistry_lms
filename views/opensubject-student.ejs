                onclick="toggleNotifications()" 
                class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[60] hidden transition-opacity duration-300 opacity-0">
            </div>

            <div id="notification-panel" 
                class="fixed top-0 right-0 h-screen w-80 md:w-96 bg-white shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-200 flex flex-col">
                
                <div class="p-5 border-b flex justify-between items-center bg-blue-600 text-white flex-shrink-0">
                    <div>
                        <h2 class="text-lg font-bold flex items-center gap-2">
                            <i class="far fa-bell"></i> Notifications
                        </h2>
                        <p id="notifSubtitle" class="text-[11px] text-blue-200 font-medium">Activity updates</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="NotificationHub.markAllRead('notification-list')" title="Mark all as read" class="hover:bg-blue-700 text-blue-100 hover:text-white p-2 rounded-lg transition text-xs font-bold flex items-center gap-1">
                            <i class="fas fa-check-double text-sm"></i>
                        </button>
                        <button onclick="toggleNotifications()" class="hover:bg-blue-700 p-2 rounded-lg transition">
                            <i class="fas fa-times text-xl"></i>
                        </button>
                    </div>
                </div>

                <div class="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50 no-scrollbar" id="notification-list">
                    <div id="notification-loader" class="flex flex-col items-center justify-center h-full text-slate-400">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-2"></div>
                        <p class="text-xs font-bold uppercase tracking-wider">Loading Updates...</p>
                    </div>
                </div>
            </div>

    <script>
        function toggleNotifications() {
            const panel = document.getElementById('notification-panel');
            const overlay = document.getElementById('notification-overlay');

            if (!panel || !overlay) return;

            if (panel.classList.contains('translate-x-full')) {
                // OPEN PANEL
                panel.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.add('opacity-100'), 10);
                if (window.NotificationHub) {
                    NotificationHub.loadNotifications('notification-list', false);
                }
            } else {
                // CLOSE PANEL
                panel.classList.add('translate-x-full');
                overlay.classList.remove('opacity-100');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function formatTimeAgo(dateString) {
            if (!dateString) return '';
            const now = new Date();
            const past = new Date(dateString);
            const diffInMs = now - past;
            const diffInMins = Math.floor(diffInMs / 60000);
            
            if (diffInMins < 0) return 'Upcoming'; // For future due dates
            if (diffInMins < 1) return 'Just now';
            if (diffInMins < 60) return `${diffInMins}m ago`;
            const diffInHours = Math.floor(diffInMins / 60);
            if (diffInHours < 24) return `${diffInHours}h ago`;
            return past.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const main = document.getElementById('mainContent');
            const header = document.querySelector('header');
            
            if (window.innerWidth < 768) {
                sidebar.classList.toggle('sidebar-open');
                sidebar.classList.toggle('sidebar-collapsed');
                overlay.classList.toggle('hidden');
            } else {
                sidebar.classList.toggle('sidebar-collapsed');
                if (main) main.classList.toggle('sidebar-collapsed-main');
                if (header) header.classList.toggle('sidebar-collapsed-header');
            }
        }

        function toggleUserMenu(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('userMenuBtn');
            const isExpanded = !dropdown.classList.contains('hidden');
            dropdown.classList.toggle('hidden');
            if (btn) btn.setAttribute('aria-expanded', !isExpanded);
        }

        // Close dropdown when clicking outside
        window.addEventListener('click', function() {
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('userMenuBtn');
            if (dropdown && !dropdown.classList.contains('hidden')) {
                dropdown.classList.add('hidden');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
        });

        // Auto-handle sidebar on resize
        window.addEventListener('resize', () => {
            const sidebar = document.getElementById('sidebar');
            const main = document.getElementById('mainContent');
            if (window.innerWidth >= 768) {
                sidebar.classList.remove('sidebar-collapsed', 'sidebar-open');
                main.classList.add('md:ml-64');
            } else {
                sidebar.classList.add('sidebar-collapsed');
                main.classList.remove('md:ml-64');
            }
        });

    function closeLockedModal() {
        if (window.ModalManager) {
            ModalManager.close('lockedModal');
        } else {
            document.getElementById('lockedModal').classList.add('hidden');
        }
    }

    /* ── Dedicated Locked Topic / Assessment Modal Controllers ── */
    function openLockedNoticeModal(message, title) {
        const modal = document.getElementById('lockedNoticeModal');
        if (!modal) return;
        const descEl = document.getElementById('lockedNoticeModalDesc');
        const titleEl = document.getElementById('lockedNoticeModalTitle');
        if (descEl) {
            descEl.textContent = message || 'This topic or assessment is currently locked by your instructor.';
        }
        if (titleEl && title) {
            titleEl.textContent = title;
        }
        if (window.ModalManager) {
            ModalManager.open('lockedNoticeModal');
        } else {
            modal.classList.remove('hidden');
        }
    }

    function closeLockedNoticeModal() {
        if (window.ModalManager) {
            ModalManager.close('lockedNoticeModal');
        } else {
            const modal = document.getElementById('lockedNoticeModal');
            if (modal) modal.classList.add('hidden');
        }
    }

    window.openLockedNoticeModal = openLockedNoticeModal;
    window.closeLockedNoticeModal = closeLockedNoticeModal;
    /* ── Direct New-Tab Learning Material Handler ── */
    async function handleResourceClick(materialId, type, filePath, title, isLocked) {
        if (isLocked) {
            if (typeof openLockedNoticeModal === 'function') {
                openLockedNoticeModal('This learning material is currently locked by your instructor.', title);
            } else {
                const modal = document.getElementById('lockedModal');
                if (modal) modal.classList.remove('hidden');
            }
            return;
        }

        // 1. Maintain progress tracking
        trackInteraction(materialId, 'viewed');

        // 2. Mark resource viewed locally in the UI
        markResourceViewed(materialId, false);

        // 3. Resolve target URL and open directly in a new tab
        const cleanPath = (filePath || '').replace(/^(\/?material_uploads\/?)+/, '');
        const targetUrl = (filePath && filePath.startsWith('http')) 
            ? filePath 
            : ('/material_uploads/' + cleanPath);

        window.open(targetUrl, '_blank', 'noopener,noreferrer');
    }

    /* ── Link Card Click Handler ── */
    async function handleLinkClick(materialId, url, isLocked) {
        if (isLocked) {
            document.getElementById('lockedModal').classList.remove('hidden');
            return;
        }
        // Log interaction as 'viewed'
        trackInteraction(materialId, 'viewed');
        const linkCards = document.querySelectorAll(`[onclick*="handleLinkClick(${materialId},"]`);
        linkCards.forEach(linkCard => {
            const tabId = linkCard.getAttribute('data-link-item');
            if (tabId && !linkCard.classList.contains('link-viewed')) {
                linkCard.classList.add('link-viewed');
                const badge = document.getElementById(`${tabId}-badge-links`);
                if (badge) {
                    let count = parseInt(badge.textContent.trim(), 10) || 0;
                    if (count > 0) badge.textContent = count - 1;
                }
            }
        });
        window.open(url, '_blank', 'noopener,noreferrer');
    }

    /* ── Track material interaction (fire-and-forget) ── */
    async function trackInteraction(materialId, interactionType) {
        try {
            await fetch('/api/material-interaction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ material_id: materialId, interaction_type: interactionType })
            });
            // Update chip border to green immediately (optimistic UI)
            document.querySelectorAll(`[data-resource-id="${materialId}"]`).forEach(row => {
                const statusBadge = row.querySelector('.resource-status-badge');
                const wasCompleted = statusBadge && statusBadge.textContent.includes('Completed');
                if (statusBadge) {
                    statusBadge.className = 'resource-status-badge inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-xs font-semibold bg-emerald-50 text-emerald-700 border border-emerald-200';
                    statusBadge.innerHTML = '<i class="fas fa-check-circle text-[10px] text-emerald-500"></i> Completed';
                }
                const viewBtn = row.querySelector('.resource-view-btn');
                if (viewBtn) {
                    viewBtn.className = 'resource-view-btn w-8 h-8 rounded-xl flex items-center justify-center transition-all bg-emerald-50 text-emerald-600 border border-emerald-200 hover:bg-emerald-600 hover:text-white';
                    viewBtn.title = 'Viewed - Open Material';
                }
                if (!wasCompleted) {
                    const tabId = row.getAttribute('data-resource-item');
                    if (tabId) {
                        const badge = document.getElementById(`${tabId}-badge-resources`);
                        if (badge) {
                            let count = parseInt(badge.textContent.trim(), 10) || 0;
                            if (count > 0) badge.textContent = count - 1;
                        }
                    }
                }
            });

            document.querySelectorAll(`[onclick*="handleResourceClick(${materialId},"]`).forEach(btn => {
                // Only legacy resource-chips receive border and inner icon adjustments
                if (btn.classList.contains('resource-chip')) {
                    btn.style.borderColor = '#22c55e';
                    const lockIcon = btn.querySelector('.fa-lock');
                    if (lockIcon) lockIcon.remove();
                    const checkIcon = btn.querySelector('.fa-check-circle');
                    if (!checkIcon) {
                        const i = document.createElement('i');
                        i.className = 'fas fa-check-circle';
                        i.style.cssText = 'font-size:12px;color:#22c55e;margin-left:2px;';
                        btn.appendChild(i);
                    }
                }
            });
        } catch(e) { /* silent fail — interaction logging is non-critical */ }
    }

