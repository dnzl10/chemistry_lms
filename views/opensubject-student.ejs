            <div id="notification-panel" 
                class="fixed top-0 right-0 h-screen w-80 md:w-96 bg-white shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-200 flex flex-col">
                
                <div class="p-5 border-b flex justify-between items-center bg-blue-600 text-white flex-shrink-0">
                    <h2 class="text-lg font-bold flex items-center gap-2">
                        <i class="far fa-bell"></i> Notifications
                    </h2>
                    <button onclick="toggleNotifications()" class="hover:bg-blue-700 p-2 rounded-lg transition">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>

                <div class="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50 no-scrollbar" id="notification-list">
                    <div id="notification-loader" class="flex flex-col items-center justify-center h-full text-slate-400">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-2"></div>
                        <p class="text-xs font-bold uppercase tracking-wider">Loading Arcade Updates...</p>
                    </div>
                </div>
            </div>

    <script>
        async function toggleNotifications() {
            const panel = document.getElementById('notification-panel');
            const overlay = document.getElementById('notification-overlay');
            const list = document.getElementById('notification-list');

            if (panel.classList.contains('translate-x-full')) {
                // OPEN PANEL
                panel.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.add('opacity-100'), 10);

                // FETCH DATA FROM DATABASE
                try {
                    const response = await fetch('/api/notifications'); 
                    const notifications = await response.json();

                    list.innerHTML = '';

                    if (notifications.length === 0) {
                        list.innerHTML = `
                            <div class="flex flex-col items-center justify-center h-64 text-gray-400">
                                <i class="fas fa-check-circle text-4xl mb-2 opacity-20"></i>
                                <p>All caught up!</p>
                            </div>`;
                        return;
                    }

                    notifications.forEach(notif => {
                        const timeAgo = formatTimeAgo(notif.created_at);
                        
                        // --- DYNAMIC CONFIGURATION BASED ON TYPE ---
                        let config = {
                            icon: 'fa-info-circle',
                            border: 'border-gray-500',
                            badge: 'bg-gray-100 text-gray-600',
                            label: notif.type
                        };

                        switch(notif.type) {
                            case 'announcement':
                                config = { icon: 'fa-bullhorn', border: 'border-blue-500', badge: 'bg-blue-100 text-blue-600', label: 'Announcement' };
                                break;
                            case 'assessment':
                                config = { icon: 'fa-file-alt', border: 'border-red-500', badge: 'bg-red-100 text-red-600', label: 'Assessment' };
                                break;
                            case 'material':
                                config = { icon: 'fa-book', border: 'border-purple-500', badge: 'bg-purple-100 text-purple-600', label: 'New Material' };
                                break;
                            case 'forum_new':
                            case 'forum_reply':
                                config = { icon: 'fa-comments', border: 'border-green-500', badge: 'bg-green-100 text-green-600', label: 'Forum' };
                                break;
                            case 'score':
                                config = { icon: 'fa-star', border: 'border-yellow-500', badge: 'bg-yellow-100 text-yellow-700', label: 'Result' };
                                break;
                        }

                        // --- BUILD EXTRA INFO (EXP GAINED / SUBJECT NAME) ---
                        let extraBadge = '';
                        if (notif.extra_info) {
                            const isExp = notif.extra_info.includes('EXP');
                            extraBadge = `<span class="mt-1 inline-block px-2 py-0.5 rounded text-[10px] font-bold ${isExp ? 'bg-green-500 text-white' : 'bg-slate-200 text-slate-700'}">${notif.extra_info}</span>`;
                        }

                        const itemHTML = `
                            <div class="bg-white p-3 rounded-lg border-l-4 ${config.border} shadow-sm hover:shadow-md transition-all cursor-pointer group">
                                <div class="flex justify-between items-start mb-1">
                                    <span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded ${config.badge}">
                                        <i class="fas ${config.icon} mr-1"></i>${config.label}
                                    </span>
                                    <span class="text-[10px] text-gray-400 group-hover:text-gray-600">${timeAgo}</span>
                                </div>
                                <p class="text-sm font-bold text-gray-800 leading-tight">${notif.heading}</p>
                                <p class="text-xs text-gray-500 mt-0.5 line-clamp-2">${notif.snippet}</p>
                                ${extraBadge}
                            </div>
                        `;
                        list.insertAdjacentHTML('beforeend', itemHTML);
                    });

                } catch (err) {
                    list.innerHTML = `<p class="text-center text-red-500 p-4">Failed to load notifications.</p>`;
                    console.error(err);
                }
            } else {
                // CLOSE PANEL
                panel.classList.add('translate-x-full');
                overlay.classList.remove('opacity-100');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function formatTimeAgo(dateString) {
            if (!dateString) return '';
            const now = new Date();
            const past = new Date(dateString);
            const diffInMs = now - past;
            const diffInMins = Math.floor(diffInMs / 60000);
            
            if (diffInMins < 0) return 'Upcoming'; // For future due dates
            if (diffInMins < 1) return 'Just now';
            if (diffInMins < 60) return `${diffInMins}m ago`;
            const diffInHours = Math.floor(diffInMins / 60);
            if (diffInHours < 24) return `${diffInHours}h ago`;
            return past.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            
            if (window.innerWidth < 768) {
                sidebar.classList.toggle('sidebar-collapsed');
                sidebar.classList.toggle('sidebar-open');
                overlay.classList.toggle('hidden');
            } else {
                // For desktop, usually you'd toggle a mini-sidebar or just leave it
                sidebar.classList.toggle('sidebar-collapsed');
                document.getElementById('mainContent').classList.toggle('md:ml-64');
                document.getElementById('mainContent').classList.toggle('md:ml-0');
            }
        }

        function toggleUserMenu(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('userDropdown');
            dropdown.classList.toggle('hidden');
        }

        // Close dropdown when clicking outside
        window.addEventListener('click', function() {
            const dropdown = document.getElementById('userDropdown');
            if (!dropdown.classList.contains('hidden')) {
                dropdown.classList.add('hidden');
            }
        });

        // Auto-handle sidebar on resize
        window.addEventListener('resize', () => {
            const sidebar = document.getElementById('sidebar');
            const main = document.getElementById('mainContent');
            if (window.innerWidth >= 768) {
                sidebar.classList.remove('sidebar-collapsed', 'sidebar-open');
                main.classList.add('md:ml-64');
            } else {
                sidebar.classList.add('sidebar-collapsed');
                main.classList.remove('md:ml-64');
            }
        });

        function openPreview(type, filePath, title, materialId) {
        const modal = document.getElementById('previewModal');
        const content = document.getElementById('previewContent');
        const titleEl = document.getElementById('previewTitle');
        const downloadBtn = document.getElementById('downloadBtn');

        titleEl.textContent = title;
        if (materialId) downloadBtn.dataset.materialId = materialId;

        let html = '';

        switch(type) {
            case 'pdf':
                downloadBtn.href = '/material_uploads/' + filePath;
                downloadBtn.style.display = '';
                html = `<iframe src="/material_uploads/${filePath}" class="w-full h-[60vh]" frameborder="0"></iframe>`;
                break;
            case 'video':
                downloadBtn.href = '/material_uploads/' + filePath;
                downloadBtn.style.display = '';
                html = `<video src="/material_uploads/${filePath}" controls class="w-full max-h-[60vh]"></video>`;
                break;
            case 'img':
                downloadBtn.href = '/material_uploads/' + filePath;
                downloadBtn.style.display = '';
                html = `<img src="/material_uploads/${filePath}" class="max-h-[60vh] max-w-full object-contain" />`;
                break;
            case 'word':
            case 'presentation':
                const fullUrl = window.location.origin + '/material_uploads/' + filePath;
                const isLocal = window.location.hostname === 'localhost' || window.location.hostname === '127.0.0.1';

                if (isLocal) {
                    html = `
                        <div style="text-align:center; padding:40px; border:2px dashed #cbd5e1; border-radius:8px;">
                            <i class="fas fa-File-powerpoint" style="font-size:48px; color:#f97316; margin-bottom:16px;"></i>
                            <p style="font-weight:700;">Local Preview Not Available</p>
                            <p style="font-size:14px; color:#64748b;">Google/Office viewers cannot see files on 'localhost'.</p>
                            <a href="${fullUrl}" download style="display:inline-block; margin-top:15px; padding:8px 16px; background:#3b82f6; color:white; border-radius:4px; text-decoration:none;">Download to View</a>
                        </div>`;
                        downloadBtn.hidden = true;
                } else {
                    html = `<iframe src="https://docs.google.com/viewer?url=${encodeURIComponent(fullUrl)}&embedded=true" class="w-full h-[60vh]" frameborder="0"></iframe>`;
                }
                break;
                
            default:
                downloadBtn.href = '/material_uploads/' + filePath;
                downloadBtn.style.display = '';
                html = `<div style="text-align:center;padding:40px;color:#94a3b8;">
                    <i class="fas fa-file" style="font-size:48px;margin-bottom:16px;"></i>
                    <p style="font-weight:700;">Cannot preview this file type.</p>
                    <p style="font-size:12px;margin-top:6px;">Use the Save button below to download it.</p>
                </div>`;
        }

        content.innerHTML = html;
        modal.classList.remove('hidden');
    }

    /* ── Resource Chip Click Handler ── */
    async function handleResourceClick(materialId, type, filePath, title, isLocked) {
        if (isLocked) {
            document.getElementById('lockedModal').classList.remove('hidden');
            return;
        }
        // Log interaction as 'viewed'
        trackInteraction(materialId, 'viewed');
        openPreview(type, filePath, title, materialId);
    }

    /* ── Link Card Click Handler ── */
    async function handleLinkClick(materialId, url, isLocked) {
        if (isLocked) {
            document.getElementById('lockedModal').classList.remove('hidden');
            return;
        }
        // Log interaction as 'viewed'
        trackInteraction(materialId, 'viewed');
        window.open(url, '_blank', 'noopener,noreferrer');
    }

    /* ── Track material interaction (fire-and-forget) ── */
    async function trackInteraction(materialId, interactionType) {
        try {
            await fetch('/api/material-interaction', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ material_id: materialId, interaction_type: interactionType })
            });
            // Update chip border to green immediately (optimistic UI)
            document.querySelectorAll(`[onclick*="handleResourceClick(${materialId},"]`).forEach(btn => {
                btn.style.borderColor = '#22c55e';
                const lockIcon = btn.querySelector('.fa-lock');
                if (lockIcon) lockIcon.remove();
                const checkIcon = btn.querySelector('.fa-check-circle');
                if (!checkIcon) {
                    const i = document.createElement('i');
                    i.className = 'fas fa-check-circle';
                    i.style.cssText = 'font-size:9px;color:#22c55e;margin-left:2px;';
                    btn.appendChild(i);
                }
            });
        } catch(e) { /* silent fail — interaction logging is non-critical */ }
    }

    /* ── Download button interaction track ── */
    document.addEventListener('DOMContentLoaded', () => {
        document.getElementById('downloadBtn').addEventListener('click', () => {
            const currentMaterialId = document.getElementById('downloadBtn').dataset.materialId;
            if (currentMaterialId) trackInteraction(parseInt(currentMaterialId), 'downloaded');
        });
        loadLinkThumbnails();
    });

    function closePreview() {
        document.getElementById('previewModal').classList.add('hidden');
        document.getElementById('previewContent').innerHTML = '';
        document.getElementById('downloadBtn').removeAttribute('data-material-id');
    }

    function openFullScreen() {
        const el = document.querySelector('#previewContent iframe, #previewContent video, #previewContent img');
        if (el) {
            if (el.requestFullscreen) el.requestFullscreen();
            else if (el.webkitRequestFullscreen) el.webkitRequestFullscreen();
            else if (el.msRequestFullscreen) el.msRequestFullscreen();
        }
    }

    function switchTab(tabId, panel) {
    const allPanels = document.querySelectorAll(`[id^="${tabId}-"]:not([id*="-btn-"])`);
    allPanels.forEach(p => p.classList.add('hidden'));

    const allBtns = document.querySelectorAll(`[id^="${tabId}-btn-"]`);
    allBtns.forEach(btn => btn.classList.remove('active'));

    const activePanel = document.getElementById(`${tabId}-${panel}`);
    if (activePanel) activePanel.classList.remove('hidden');

    const activeBtn = document.getElementById(`${tabId}-btn-${panel}`);
    if (activeBtn) activeBtn.classList.add('active');
    }

    function toggleQuarter(qId) {
    const panel  = document.getElementById('q-' + qId);
    const btn    = document.getElementById('qbtn-' + qId);
    const isOpen = !panel.classList.contains('hidden');

    if (isOpen) {
        panel.classList.add('hidden');
        btn.classList.remove('open');
        btn.style.background = 'white';
    } else {
        panel.classList.remove('hidden');
        btn.classList.add('open');
        btn.style.background = 'linear-gradient(90deg,#ecfeff,#eef2ff)';
    }
    }

    /* ── Link Thumbnail Loader ── */
    function getYouTubeId(url) {
        try {
            const u = new URL(url);
            if (u.hostname.includes('youtu.be')) return u.pathname.slice(1).split('?')[0];
            if (u.hostname.includes('youtube.com')) return u.searchParams.get('v');
        } catch(e) {}
        return null;
    }

    function loadLinkThumbnails() {
        document.querySelectorAll('.link-thumb-placeholder[data-url]').forEach(el => {
            const url = el.dataset.url;
            if (!url) return; // locked — leave lock icon placeholder

            const ytId = getYouTubeId(url);
            if (ytId) {
                const img = document.createElement('img');
                img.className = 'link-thumb';
                img.alt = 'thumbnail';
                img.onerror = function() {
                    this.src = `https://img.youtube.com/vi/${ytId}/hqdefault.jpg`;
                    this.onerror = null;
                };
                img.src = `https://img.youtube.com/vi/${ytId}/maxresdefault.jpg`;
                el.replaceWith(img);
                return;
            }

            try {
                const domain = new URL(url).hostname;
                el.innerHTML = `
                    <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;height:100%;width:100%;background:linear-gradient(135deg,#ecfeff,#eef2ff);">
                        <img src="https://www.google.com/s2/favicons?sz=64&domain=${domain}"
                             style="width:40px;height:40px;border-radius:12px;border:1.5px solid #e2e8f0;background:#fff;object-fit:contain;"
                             onerror="this.style.display='none'">
                        <span style="font-size:10px;font-weight:800;color:#94a3b8;letter-spacing:0.04em;">${domain}</span>
                    </div>`;
            } catch(e) {
                el.innerHTML = `<i class="fas fa-globe" style="font-size:28px;color:#cbd5e1;"></i>`;
            }
        });
    }

    /* ══════════════════════════════════════════════
       ASSESSMENT CLICK HANDLER
    ══════════════════════════════════════════════ */
    let _pendingAssessmentId = null;

    function handleAssessmentClick(assessmentId, assessmentName, isDone) {
        if (isDone) {
            openResultModal(assessmentId);
        } else {
            _pendingAssessmentId = assessmentId;
            document.getElementById('arcadeConfirmMsg').textContent =
                `Are you ready to take "${assessmentName}" via Arcade?`;
            document.getElementById('arcadeConfirmModal').classList.remove('hidden');
        }
    }

    function closeArcadeConfirm() {
        document.getElementById('arcadeConfirmModal').classList.add('hidden');
        _pendingAssessmentId = null;
    }

    async function confirmArcade() {
        if (!_pendingAssessmentId) return;
        const btn = document.getElementById('arcadeYesBtn');
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Flagging...';
        try {
            await fetch('/api/flag-assessment', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ assessment_id: _pendingAssessmentId })
            });
        } catch(e) {}
        closeArcadeConfirm();
        btn.disabled = false;
        btn.innerHTML = "Yes, Let\'s Go! <i class=\"fas fa-arrow-right\" style=\"margin-left:4px;\"></i>";
        // Redirect to arcade standby
        window.location.href = '/arcade/standby';
    }

    /* ══════════════════════════════════════════════
       RESULT MODAL
    ══════════════════════════════════════════════ */
    function closeResultModal() {
        document.getElementById('assessmentResultModal').classList.add('hidden');
    }

    function switchArmTab(tab) {
        document.getElementById('armAnalysis').style.display = tab === 'analysis' ? 'flex' : 'none';
        document.getElementById('armReview').style.display   = tab === 'review'   ? 'block' : 'none';
        document.getElementById('armTabAnalysis').classList.toggle('active', tab === 'analysis');
        document.getElementById('armTabReview').classList.toggle('active', tab === 'review');
    }

    async function openResultModal(assessmentId) {
        const modal = document.getElementById('assessmentResultModal');
        modal.classList.remove('hidden');
        switchArmTab('analysis');
        document.getElementById('armLoader').style.display = 'flex';
        document.getElementById('armAnalysis').style.display = 'none';
        document.getElementById('armReview').style.display = 'none';

        try {
            const res = await fetch(`/api/assessment-result/${assessmentId}`);
            const { score, questions } = await res.json();

            // Header meta
            document.getElementById('armTitle').textContent = score.assessment_name;
            document.getElementById('armMeta').textContent =
                `${score.assessment_type} · ${score.total_items} Items`;

            // Score stats
            const pct = score.total_possible_score > 0
                ? Math.round((score.score_obtained / score.total_possible_score) * 100) : 0;
            document.getElementById('armScorePct').textContent = pct + '%';
            document.getElementById('armScoreVal').textContent  = `${score.score_obtained}/${score.total_possible_score}`;
            document.getElementById('armExpVal').textContent    = '+' + (score.exp_gained || 0) + ' EXP';
            document.getElementById('armItemsVal').textContent  = score.total_items;
            document.getElementById('armTimerVal').textContent  =
                score.timer_type === 'Global'
                    ? `${score.duration_minutes || '—'} min (Global)`
                    : 'Per Item';

            // Pie chart
            drawArmPie(pct);

            // Questions
            buildAnalysisQuestions(questions, score.timer_type);
            buildReviewQuestions(questions);

            document.getElementById('armLoader').style.display = 'none';
            document.getElementById('armAnalysis').style.display = 'flex';

        } catch(err) {
            document.getElementById('armLoader').innerHTML =
                `<p style="color:#ef4444;font-weight:700;">Failed to load results.</p>`;
        }
    }

    /* ── Pie Chart ── */
    function drawArmPie(pct) {
        const canvas = document.getElementById('armPieChart');
        const ctx = canvas.getContext('2d');
        const cx = 55, cy = 55, r = 46, lineW = 10;
        const startAngle = -Math.PI / 2;
        const fillAngle = startAngle + (pct / 100) * 2 * Math.PI;

        ctx.clearRect(0, 0, 110, 110);

        // Track
        ctx.beginPath();
        ctx.arc(cx, cy, r, 0, 2 * Math.PI);
        ctx.strokeStyle = '#e2e8f0'; ctx.lineWidth = lineW; ctx.stroke();

        // Fill
        const color = pct >= 75 ? '#22c55e' : pct >= 50 ? '#f59e0b' : '#ef4444';
        ctx.beginPath();
        ctx.arc(cx, cy, r, startAngle, fillAngle);
        ctx.strokeStyle = color; ctx.lineWidth = lineW;
        ctx.lineCap = 'round'; ctx.stroke();
    }

    /* ── Element Card HTML ── */
    function elementCardHtml(symbol, subscript, cls) {
        // Get atomic number from a small lookup (common chemistry elements)
        const atomicNums = {H:1,He:2,Li:3,Be:4,B:5,C:6,N:7,O:8,F:9,Ne:10,Na:11,Mg:12,Al:13,Si:14,P:15,S:16,Cl:17,Ar:18,K:19,Ca:20,Sc:21,Ti:22,V:23,Cr:24,Mn:25,Fe:26,Co:27,Ni:28,Cu:29,Zn:30,Ga:31,Ge:32,As:33,Se:34,Br:35,Kr:36,Rb:37,Sr:38,Y:39,Zr:40,Nb:41,Mo:42,Tc:43,Ru:44,Rh:45,Pd:46,Ag:47,Cd:48,In:49,Sn:50,Sb:51,Te:52,I:53,Xe:54,Cs:55,Ba:56,La:57,Ce:58,Pr:59,Nd:60,Pm:61,Sm:62,Eu:63,Gd:64,Tb:65,Dy:66,Ho:67,Er:68,Tm:69,Yb:70,Lu:71,Hf:72,Ta:73,W:74,Re:75,Os:76,Ir:77,Pt:78,Au:79,Hg:80,Tl:81,Pb:82,Bi:83,Po:84,At:85,Rn:86,Fr:87,Ra:88,Ac:89,Th:90,Pa:91,U:92,Np:93,Pu:94};
        const num = atomicNums[symbol] || '';
        const sub = subscript ? `<span class="el-sub">${subscript}</span>` : '';
        return `<div class="element-card ${cls}">
            <span class="el-num">${num}</span>
            <span class="el-sym">${symbol}</span>
            ${sub}
        </div>`;
    }

    /* ── Build Analysis Questions ── */
    function buildAnalysisQuestions(questions, timerType) {
        const container = document.getElementById('armQuestionsList');
        container.innerHTML = '';
        questions.forEach((q, i) => {
            const isCorrect = q.is_correct == 1;
            const badge = isCorrect
                ? `<span style="font-size:10px;font-weight:800;background:#dcfce7;color:#15803d;padding:3px 10px;border-radius:9999px;"><i class="fas fa-check" style="margin-right:3px;"></i>Correct</span>`
                : `<span style="font-size:10px;font-weight:800;background:#fee2e2;color:#dc2626;padding:3px 10px;border-radius:9999px;"><i class="fas fa-times" style="margin-right:3px;"></i>Wrong</span>`;

            const ms = q.response_time_ms;
            const timeBadge = ms != null
                ? `<span style="font-size:10px;font-weight:700;color:#64748b;background:#f1f5f9;padding:3px 8px;border-radius:9999px;"><i class="fas fa-stopwatch" style="font-size:9px;margin-right:3px;"></i>${(ms/1000).toFixed(1)}s</span>`
                : '';

            const perItemTimer = (timerType === 'PerItem' && q.time_limit)
                ? `<span style="font-size:10px;font-weight:700;color:#f97316;background:#fff7ed;padding:3px 8px;border-radius:9999px;"><i class="fas fa-clock" style="font-size:9px;margin-right:3px;"></i>${q.time_limit}s limit</span>`
                : '';

            let answerHtml = '';

            if (['Standard', 'standard_mcq'].includes(q.input_mode) || !q.input_mode) {
                // MCQ choices
                const opts = ['a','b','c','d'];
                answerHtml = `<div style="display:flex;flex-direction:column;gap:6px;margin-top:8px;">`;
                opts.forEach(letter => {
                    const txt = q[`option_${letter}`];
                    if (!txt) return;
                    const img = q[`option_${letter}_image`];
                    const isCorrectOpt = q.correct_answer && q.correct_answer.toLowerCase().includes(letter);
                    const isStudentOpt = q.selected_option && q.selected_option.toLowerCase().includes(letter);
                    const isWrongStudent = isStudentOpt && !isCorrectOpt;
                    let cls = 'option-choice';
                    if (isCorrectOpt) cls += ' correct-opt';
                    if (isStudentOpt) cls += ' student-opt';
                    if (isWrongStudent) cls += ' wrong-student';
                    const imgTag = img ? `<img src="/material_uploads/${img}" style="height:40px;border-radius:6px;object-fit:cover;margin-top:4px;">` : '';
                    const letterBadge = `<span style="width:20px;height:20px;border-radius:50%;background:${isCorrectOpt?'#22c55e':isWrongStudent?'#ef4444':'#e2e8f0'};color:${isCorrectOpt||isWrongStudent?'#fff':'#64748b'};font-size:10px;font-weight:900;display:flex;align-items:center;justify-content:center;flex-shrink:0;">${letter.toUpperCase()}</span>`;
                    const icons = `${isCorrectOpt ? '<i class="fas fa-check-circle" style="color:#22c55e;font-size:11px;margin-left:auto;flex-shrink:0;"></i>' : ''}${isStudentOpt && !isCorrectOpt ? '<i class="fas fa-circle" style="color:#f97316;font-size:8px;margin-left:auto;flex-shrink:0;border:2px solid #f97316;border-radius:50%;"></i>' : ''}`;
                    answerHtml += `<div class="${cls}">${letterBadge}<div style="flex:1;">${txt}${imgTag}</div>${icons}</div>`;
                });
                answerHtml += `</div>`;

            } else if (q.input_mode === 'Numeric') {
                // Numeric
                const correctNum = q.numeric_answer;
                const studentNum = q.selected_option;
                answerHtml = `<div style="display:flex;gap:12px;margin-top:8px;flex-wrap:wrap;">
                    <div style="background:#f0fdf4;border:2px solid #22c55e;border-radius:12px;padding:10px 18px;text-align:center;">
                        <p style="font-size:9px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin-bottom:3px;">Correct</p>
                        <p style="font-size:22px;font-weight:900;color:#15803d;font-family:monospace;">${correctNum}<span style="font-size:11px;color:#94a3b8;">±${q.numeric_tolerance||0}</span></p>
                    </div>
                    <div style="background:${isCorrect?'#f0fdf4':'#fff1f2'};border:2px solid ${isCorrect?'#22c55e':'#f97316'};border-radius:12px;padding:10px 18px;text-align:center;">
                        <p style="font-size:9px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin-bottom:3px;">Your Answer</p>
                        <p style="font-size:22px;font-weight:900;color:${isCorrect?'#15803d':'#ea580c'};font-family:monospace;">${studentNum||'—'}</p>
                    </div>
                </div>`;

            } else if (q.input_mode === 'Periodic_Single') {
                // Single element
                const correctSym = q.correct_answer || '?';
                const studentSym = q.selected_option || '?';
                answerHtml = `<div style="display:flex;gap:14px;align-items:center;margin-top:8px;flex-wrap:wrap;">
                    <div>
                        <p style="font-size:9px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin-bottom:5px;">Correct Answer</p>
                        ${elementCardHtml(correctSym, '', 'correct-el')}
                    </div>`;
                if (!isCorrect) {
                    answerHtml += `<div>
                        <p style="font-size:9px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin-bottom:5px;">Your Answer</p>
                        ${elementCardHtml(studentSym, '', 'student-el')}
                    </div>`;
                }
                answerHtml += `</div>`;

            } else if (q.input_mode === 'Periodic_Sequence') {
                // Sequence of elements
                const seqHtml = (q.sequences || []).map(s => elementCardHtml(s.element_symbol, s.subscript, 'correct-el')).join('<span style="font-size:16px;color:#94a3b8;align-self:center;">→</span>');
                const studentSeqRaw = q.selected_option || '';
                let studentSeqHtml = '';
                try {
                    const parsed = JSON.parse(studentSeqRaw);
                    if (Array.isArray(parsed)) {
                        studentSeqHtml = parsed.map(s => elementCardHtml(s.symbol||s.element_symbol, s.subscript||'', isCorrect?'correct-el':'student-el')).join('<span style="font-size:16px;color:#94a3b8;align-self:center;">→</span>');
                    } else { studentSeqHtml = `<span style="color:#94a3b8;">${studentSeqRaw}</span>`; }
                } catch(e) { studentSeqHtml = `<span style="color:#94a3b8;">${studentSeqRaw}</span>`; }

                answerHtml = `<div style="margin-top:10px;">
                    <p style="font-size:9px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin-bottom:6px;">Correct Sequence</p>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">${seqHtml}</div>
                    ${!isCorrect ? `<p style="font-size:9px;font-weight:800;color:#94a3b8;text-transform:uppercase;margin:10px 0 6px;">Your Sequence</p>
                    <div style="display:flex;gap:6px;flex-wrap:wrap;align-items:center;">${studentSeqHtml}</div>` : ''}
                </div>`;
            }

            const card = document.createElement('div');
            card.className = 'q-result-card';
            card.innerHTML = `
                <div style="padding:14px 16px;border-bottom:1.5px solid #f1f5f9;">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                        <div style="display:flex;align-items:flex-start;gap:10px;flex:1;">
                            <div style="width:30px;height:30px;border-radius:10px;background:${isCorrect?'#dcfce7':'#fee2e2'};display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:12px;font-weight:900;color:${isCorrect?'#15803d':'#dc2626'};">${i+1}</div>
                            <p style="font-size:13px;font-weight:700;color:#1e293b;line-height:1.5;flex:1;">${q.question_text || q.question}</p>
                        </div>
                        <div style="display:flex;flex-direction:column;align-items:flex-end;gap:4px;flex-shrink:0;">${badge}${timeBadge}${perItemTimer}</div>
                    </div>
                    ${answerHtml}
                </div>
                <div style="padding:8px 16px;background:#f8fafc;display:flex;align-items:center;gap:8px;">
                    <span style="font-size:10px;font-weight:700;color:#94a3b8;">Mechanic:</span>
                    <span style="font-size:10px;font-weight:800;color:#0891b2;background:#ecfeff;padding:2px 8px;border-radius:9999px;">${q.mechanic_type||'—'}</span>
                    <span style="font-size:10px;font-weight:700;color:#94a3b8;margin-left:auto;">+${q.base_exp||0} EXP</span>
                </div>`;
            container.appendChild(card);
        });
    }

    /* ── Build Review Questions ── */
    function buildReviewQuestions(questions) {
        const container = document.getElementById('armReviewList');
        container.innerHTML = '';

        const withRemediation = questions.filter(q => q.remediation_id);
        if (withRemediation.length === 0) {
            container.innerHTML = `<div class="empty-state"><div class="empty-icon"><i class="fas fa-book-open"></i></div><p>No remediation materials for this assessment.</p></div>`;
            return;
        }

        withRemediation.forEach((q, i) => {
            let preview = null;
            if (q.preview_json) {
                try { preview = typeof q.preview_json === 'string' ? JSON.parse(q.preview_json) : q.preview_json; } catch(e) {}
            }
            const remDate = q.remediation_created_at
                ? new Date(q.remediation_created_at).toLocaleDateString('en-PH', { dateStyle: 'medium' }) : '—';

            let thumbHtml = '';
            if (preview && preview.thumbnail) {
                thumbHtml = `<img src="${preview.thumbnail}" style="width:100%;height:110px;object-fit:cover;display:block;" onerror="this.style.display='none'">`;
            }

            let matHtml = '';
            if (q.material_title) {
                matHtml = `<div style="display:flex;align-items:center;gap:6px;margin-top:8px;padding:7px 10px;background:#ecfeff;border-radius:9px;border:1.5px solid #cffafe;">
                    <i class="fas fa-file-alt" style="font-size:11px;color:#0891b2;"></i>
                    <span style="font-size:11px;font-weight:700;color:#0891b2;">${q.material_title}</span>
                </div>`;
            }

            let linkHtml = '';
            if (q.link_url) {
                const domain = (() => { try { return new URL(q.link_url).hostname.replace('www.',''); } catch(e) { return q.link_url; }})();
                linkHtml = `<a href="${q.link_url}" target="_blank" rel="noopener noreferrer"
                    style="display:flex;gap:10px;border-radius:10px;border:1.5px solid #e0e7ff;overflow:hidden;background:#fff;margin-top:8px;text-decoration:none;transition:box-shadow 0.15s;"
                    onmouseover="this.style.boxShadow='0 4px 16px rgba(8,145,178,0.12)'"
                    onmouseout="this.style.boxShadow='none'">
                    ${thumbHtml ? `<div style="width:100px;flex-shrink:0;overflow:hidden;">${thumbHtml}</div>` : ''}
                    <div style="padding:10px 12px;flex:1;min-width:0;">
                        <p style="font-size:12px;font-weight:800;color:#1e293b;margin-bottom:3px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;">${(preview&&preview.title)||domain}</p>
                        ${preview&&preview.description ? `<p style="font-size:11px;color:#64748b;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">${preview.description}</p>` : ''}
                        <p style="font-size:10px;font-weight:700;color:#0891b2;margin-top:5px;"><i class="fas fa-external-link-alt" style="font-size:8px;"></i> ${domain}</p>
                    </div>
                </a>`;
            }

            const card = document.createElement('div');
            card.className = 'remediation-card';
            card.innerHTML = `
                <div style="padding:14px 16px;border-bottom:1.5px solid #e0e7ff;">
                    <div style="display:flex;align-items:flex-start;gap:10px;">
                        <div style="width:28px;height:28px;border-radius:9px;background:#e0e7ff;display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:11px;font-weight:900;color:#4338ca;">${i+1}</div>
                        <p style="font-size:13px;font-weight:700;color:#1e293b;line-height:1.5;">${q.question_text || q.question}</p>
                    </div>
                </div>
                <div style="padding:14px 16px;">
                    ${q.advice_text ? `<div style="background:#fffbeb;border-left:4px solid #f59e0b;border-radius:0 10px 10px 0;padding:10px 14px;margin-bottom:10px;">
                        <p style="font-size:10px;font-weight:800;color:#92400e;text-transform:uppercase;letter-spacing:0.06em;margin-bottom:4px;"><i class="fas fa-lightbulb" style="margin-right:4px;"></i>Advice</p>
                        <p style="font-size:12px;color:#78350f;line-height:1.6;">${q.advice_text}</p>
                    </div>` : ''}
                    ${matHtml}
                    ${linkHtml}
                    <p style="font-size:10px;color:#94a3b8;font-weight:600;margin-top:10px;"><i class="fas fa-clock" style="font-size:9px;margin-right:3px;"></i>Added ${remDate}</p>
                </div>`;
            container.appendChild(card);
        });
    }
    </script>
