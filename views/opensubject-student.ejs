                contentDiv.innerHTML = '<div class="p-8 text-center text-rose-500"><i class="fas fa-exclamation-triangle text-4xl mb-4"></i><p>The AI failed to process this document. It might be too large, or no readable text was found.</p></div>';
            } else if (data.ai_status === 'completed') {
                let flashcardsHtml = '';
                if (data.ai_flashcards) {
