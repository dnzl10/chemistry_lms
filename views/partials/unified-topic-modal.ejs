<!-- ============================================================================
     views/partials/unified-topic-modal.ejs
     Unified Responsive Add/Edit Topic Modal for Teacher & Admin
     Features:
     1. Responsive modal shell & dynamic auto-expanding fields (ResizeObserver)
     2. Interactive multi-line Bullet Objectives Builder
     3. Live Video URL Embed Preview (YouTube, Vimeo, Direct Video)
     4. Embedded Learning Materials Queue & Existing Materials Manager
     5. Manual Lock/Unlock + Automatic Unlock/Lock Scheduling
     6. Unsaved Changes Guard & Responsive Save Confirmation Modal
     ============================================================================ -->

<style>
    .utm-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(15, 23, 42, 0.55);
        backdrop-filter: blur(4px);
        z-index: 220;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 12px;
    }
    .utm-backdrop.open {
        display: flex !important;
    }
    .utm-card {
        background: #ffffff;
        border-radius: 20px;
        width: min(96vw, 760px);
        max-height: 92vh;
        display: flex;
        flex-direction: column;
        box-shadow: 0 25px 50px -12px rgba(15, 23, 42, 0.28);
        border: 1px solid #e2e8f0;
        overflow: hidden;
        animation: utmSlideUp 0.18s ease-out;
    }
    @keyframes utmSlideUp {
        from { opacity: 0; transform: translateY(10px) scale(0.99); }
        to   { opacity: 1; transform: translateY(0) scale(1); }
    }
    .utm-header {
        padding: 16px 22px;
        border-bottom: 1px solid #f1f5f9;
        display: flex;
        align-items: center;
        justify-content: space-between;
        background: linear-gradient(90deg, #f8fafc 0%, #eef2ff 100%);
        flex-shrink: 0;
    }
    .utm-body {
        padding: 20px 22px;
        overflow-y: auto;
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 18px;
    }
    .utm-footer {
        padding: 14px 22px;
        border-top: 1px solid #f1f5f9;
        background: #f8fafc;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        flex-shrink: 0;
        flex-wrap: wrap;
    }
    .utm-section-box {
        border: 1px solid #e2e8f0;
        border-radius: 14px;
        padding: 14px 16px;
        background: #ffffff;
    }
    .utm-label {
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 12px;
        font-weight: 800;
        color: #334155;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        margin-bottom: 6px;
    }
    .utm-input {
        width: 100%;
        border: 1.5px solid #cbd5e1;
        border-radius: 12px;
        padding: 10px 13px;
        font-size: 13.5px;
        line-height: 1.5;
        color: #1e293b;
        background: #f8fafc;
        transition: border-color 0.15s, background-color 0.15s, box-shadow 0.15s;
        outline: none;
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    .utm-input:focus {
        background: #ffffff;
        border-color: #6366f1;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.14);
    }
    .utm-obj-row {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        padding: 6px 8px;
        border-radius: 12px;
        border: 1px solid #e2e8f0;
        background: #f8fafc;
        transition: border-color 0.15s, background-color 0.15s;
    }
    .utm-obj-row:focus-within {
        border-color: #6366f1;
        background: #ffffff;
        box-shadow: 0 0 0 3px rgba(99, 102, 241, 0.1);
    }
    .utm-obj-bullet {
        width: 22px;
        height: 28px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #4f46e5;
        font-weight: 900;
        font-size: 16px;
        flex-shrink: 0;
        user-select: none;
    }
    .utm-obj-textarea {
        flex: 1;
        border: none;
        background: transparent;
        font-size: 13px;
        line-height: 1.48;
        color: #1e293b;
        padding: 4px 2px;
        resize: none;
        outline: none;
        min-height: 28px;
        max-height: 220px;
        overflow-y: hidden;
        overflow-wrap: anywhere;
        word-break: break-word;
    }
    .utm-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        padding: 9px 16px;
        border-radius: 11px;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.15s;
        border: 1px solid #cbd5e1;
        background: #ffffff;
        color: #475569;
    }
    .utm-btn:hover {
        background: #f1f5f9;
        color: #1e293b;
    }
    .utm-btn-primary {
        background: linear-gradient(135deg, #4f46e5 0%, #06b6d4 100%);
        border-color: #4338ca;
        color: #ffffff;
        box-shadow: 0 4px 12px rgba(79, 70, 229, 0.22);
    }
    .utm-btn-primary:hover {
        opacity: 0.94;
        color: #ffffff;
        background: linear-gradient(135deg, #4338ca 0%, #0891b2 100%);
    }
    .utm-btn-danger {
        background: #e11d48;
        border-color: #be123c;
        color: #ffffff;
    }
    .utm-btn-danger:hover {
        background: #be123c;
        color: #ffffff;
    }
    @media (max-width: 640px) {
        .utm-header, .utm-body, .utm-footer {
            padding-left: 14px;
            padding-right: 14px;
        }
        .utm-card {
            width: 98vw;
            max-height: 95vh;
            border-radius: 16px;
        }
    }
</style>

<!-- ======= UNIFIED ADD / EDIT TOPIC MODAL ======= -->
<div class="modal-backdrop modal-overlay utm-backdrop" id="topicModal">
    <div class="utm-card">
        <!-- Sticky Modal Header -->
        <div class="utm-header">
            <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-xl bg-indigo-100 border border-indigo-200 flex items-center justify-center text-indigo-600 flex-shrink-0 shadow-2xs">
                    <i class="fas fa-layer-group text-base" id="topicModalHeaderIcon"></i>
                </div>
                <div class="min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h3 class="font-black text-slate-800 text-base sm:text-lg truncate" id="topicModalTitle">Add Topic</h3>
                        <span class="text-[10px] font-extrabold uppercase tracking-wider px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200" id="topicModalRoleBadge">
                            <%= typeof roleContext !== 'undefined' ? roleContext : 'Curriculum' %>
                        </span>
                    </div>
                    <p class="text-[11px] text-slate-500 truncate" id="topicModalSubtitle">Configure topic details, bullet objectives, learning materials, and access schedule</p>
                </div>
            </div>
            <button type="button" onclick="handleTopicModalClose()" class="w-8 h-8 rounded-xl bg-white hover:bg-rose-50 border border-slate-200 hover:border-rose-200 flex items-center justify-center text-slate-400 hover:text-rose-600 transition cursor-pointer flex-shrink-0" title="Close">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <!-- Scrollable Form Body -->
        <form id="topicForm" onsubmit="submitTopicForm(event)" style="display:flex; flex-direction:column; min-height:0; flex:1;">
            <input type="hidden" id="topicId" name="topic_id">
            <input type="hidden" id="topicQuarterId" name="quarter_id">

            <div class="utm-body" id="topicModalScrollBody">
                <!-- 1. TOPIC NAME & DESCRIPTION -->
                <div class="utm-section-box space-y-4">
                    <div>
                        <div class="utm-label">
                            <span><i class="fas fa-tag text-indigo-500 mr-1.5"></i>Topic Name <span class="text-rose-500">*</span></span>
                            <span class="text-[11px] font-semibold text-slate-400 normal-case" id="topicNameCount">0 chars</span>
                        </div>
                        <textarea id="topicName" name="topic_name" class="utm-input topic-autofit-field"
                            placeholder="e.g. Chemical Bonding & Molecular Geometry" required rows="1"
                            data-min-height="42" data-max-height="140"
                            oninput="autoResizeTopicField(this); updateTopicCharCounts();"
                            style="resize:none; overflow-y:hidden; min-height:42px;"></textarea>
                    </div>

                    <div>
                        <div class="utm-label">
                            <span><i class="fas fa-align-left text-indigo-500 mr-1.5"></i>Topic Description <span class="text-rose-500">*</span></span>
                            <span class="text-[11px] font-semibold text-slate-400 normal-case" id="topicDescCount">0 words • 0 chars</span>
                        </div>
                        <textarea id="topicDesc" name="topic_description" class="utm-input topic-autofit-field"
                            placeholder="Provide a comprehensive overview of the concepts, real-world applications, and scope of this topic..."
                            required rows="3" data-min-height="84" data-max-height="320"
                            oninput="autoResizeTopicField(this); updateTopicCharCounts();"
                            style="resize:none; overflow-y:hidden; min-height:84px;"></textarea>
                    </div>
                </div>

                <!-- 2. INTERACTIVE BULLET OBJECTIVES BUILDER -->
                <div class="utm-section-box" style="background: linear-gradient(180deg, #ffffff 0%, #f8fafc 100%);">
                    <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
                        <div>
                            <div class="utm-label mb-0">
                                <span><i class="fas fa-list-ul text-indigo-600 mr-1.5"></i>Learning Objectives (Displayed as Bullets) <span class="text-rose-500">*</span></span>
                            </div>
                            <p class="text-[11px] text-slate-500 mt-0.5">
                                Each item below is displayed as a bullet point on the student's subject page. Press <kbd class="px-1.5 py-0.5 text-[10px] font-mono bg-slate-100 border border-slate-300 rounded">Enter</kbd> to add a new bullet, or paste multiple lines at once.
                            </p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span id="topicObjCountBadge" class="text-[11px] font-extrabold px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">1 Objective</span>
                            <button type="button" onclick="addTopicObjectiveRow('', true)" class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-xs font-bold transition shadow-2xs flex items-center gap-1.5 cursor-pointer">
                                <i class="fas fa-plus text-[10px]"></i> Add Bullet
                            </button>
                        </div>
                    </div>

                    <!-- Dynamic Bullet Rows Container -->
                    <div id="topicObjectivesList" class="space-y-2 mt-2.5"></div>

                    <!-- Hidden serialized textarea for backward-compatible form submission -->
                    <textarea id="topicObj" name="topic_objectives" class="hidden" required></textarea>
                </div>

                <!-- 3. VIDEO LESSON URL & LIVE PREVIEW -->
                <div class="utm-section-box">
                    <div class="utm-label">
                        <span><i class="fas fa-circle-play text-indigo-500 mr-1.5"></i>Video Lesson URL <span class="text-rose-500">*</span></span>
                        <span class="text-[11px] font-semibold text-slate-400 normal-case">YouTube, Vimeo, or direct .mp4</span>
                    </div>
                    <div class="relative">
                        <textarea id="topicVideoUrl" name="video_url" class="utm-input topic-autofit-field pr-9"
                            placeholder="e.g. https://www.youtube.com/watch?v=... or https://youtu.be/..."
                            required rows="1" data-min-height="42" data-max-height="110"
                            oninput="autoResizeTopicField(this); handleUnifiedTopicVideoPreview();"
                            onchange="handleUnifiedTopicVideoPreview();"
                            style="resize:none; overflow-y:hidden; min-height:42px; word-break:break-all;"></textarea>
                        <button type="button" id="topicVideoClearBtn" onclick="clearUnifiedTopicVideoPreview()"
                            class="absolute right-2.5 top-2.5 text-slate-400 hover:text-rose-500 text-sm hidden cursor-pointer" title="Clear Video URL">
                            <i class="fas fa-times-circle"></i>
                        </button>
                    </div>

                    <div id="topicVideoPreviewContainer" class="mt-3 rounded-xl border border-slate-200 bg-slate-50 p-2.5 overflow-hidden transition-all hidden">
                        <div class="flex items-center justify-between pb-2 px-1 text-xs font-bold text-slate-600">
                            <span class="flex items-center gap-1.5 text-indigo-600"><i class="fas fa-tv"></i> Live Video Preview</span>
                            <span id="topicVideoBadge" class="text-[11px] text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200 font-semibold flex items-center gap-1">
                                <i class="fas fa-check-circle"></i> Valid URL
                            </span>
                        </div>
                        <div class="w-full aspect-video rounded-lg overflow-hidden bg-slate-900 shadow-inner flex items-center justify-center border border-slate-200" id="topicVideoFrameWrapper"></div>
                    </div>
                </div>

                <!-- 4. EMBEDDED LEARNING MATERIALS SECTION -->
                <div class="utm-section-box" style="border-color:#99f6e4; background:linear-gradient(180deg, #f0fdfa 0%, #ffffff 100%);">
                    <div class="flex items-center justify-between flex-wrap gap-2 mb-2">
                        <div>
                            <div class="utm-label mb-0" style="color:#0f766e;">
                                <span><i class="fas fa-folder-open text-teal-600 mr-1.5"></i>Topic Learning Materials <span class="text-rose-500" id="utmMatRequiredStar">*</span></span>
                            </div>
                            <p class="text-[11px] text-slate-500 mt-0.5">
                                Attach lecture notes, PDFs, slides, videos, or reference links so this topic is never empty for students.
                            </p>
                        </div>
                        <span id="utmMaterialsTotalBadge" class="text-[11px] font-extrabold px-2.5 py-1 rounded-full bg-teal-50 text-teal-700 border border-teal-200">
                            0 Materials
                        </span>
                    </div>

                    <!-- Existing Materials (Shown in Edit Mode) -->
                    <div id="utmExistingMaterialsWrap" class="hidden mb-3">
                        <div class="text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1.5 flex items-center justify-between">
                            <span>Attached Materials (<span id="utmExistingMatCount">0</span>)</span>
                            <span class="text-[10px] font-normal text-slate-400">Toggle lock or remove</span>
                        </div>
                        <div id="utmExistingMaterialsList" class="space-y-1.5 max-h-52 overflow-y-auto pr-1"></div>
                    </div>

                    <!-- Add / Queue New Materials Switcher -->
                    <div class="bg-white border border-slate-200 rounded-xl p-3 space-y-3">
                        <div class="flex items-center justify-between gap-2 flex-wrap">
                            <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                                <i class="fas fa-plus-circle text-teal-600"></i> Add Learning Material(s) to Topic
                            </span>
                            <div class="inline-flex bg-slate-100 p-1 rounded-lg border border-slate-200">
                                <button type="button" id="utmMatTabFileBtn" onclick="switchUtmMaterialMode('file')"
                                    class="px-3 py-1 rounded-md text-xs font-bold transition cursor-pointer bg-white text-indigo-600 shadow-2xs">
                                    <i class="fas fa-cloud-arrow-up mr-1"></i> Upload File(s)
                                </button>
                                <button type="button" id="utmMatTabUrlBtn" onclick="switchUtmMaterialMode('url')"
                                    class="px-3 py-1 rounded-md text-xs font-bold transition cursor-pointer text-slate-600 hover:text-slate-800">
                                    <i class="fas fa-link mr-1"></i> Add Web Link / URL
                                </button>
                            </div>
                        </div>

                        <!-- Mode A: File Upload Dropzone -->
                        <div id="utmMatFilePane">
                            <div id="utmMatDropzone"
                                 onclick="document.getElementById('utmMaterialFileInput').click()"
                                 ondragover="handleUtmMatDragOver(event)"
                                 ondragleave="handleUtmMatDragLeave(event)"
                                 ondrop="handleUtmMatDrop(event)"
                                 class="border-2 border-dashed border-teal-300 hover:border-indigo-400 rounded-xl p-4 text-center cursor-pointer transition bg-teal-50/40 hover:bg-indigo-50/30">
                                <div class="w-9 h-9 rounded-full bg-teal-100 text-teal-600 flex items-center justify-center mx-auto mb-1.5 text-base">
                                    <i class="fas fa-file-arrow-up"></i>
                                </div>
                                <p class="text-xs font-bold text-slate-700">Click to select files or drag & drop here</p>
                                <p class="text-[11px] text-slate-500 mt-0.5">Supports PDF, Word (.doc/.docx), PPT (.ppt/.pptx), Images, or Video (.mp4/.webm) • Max 50MB/file</p>
                            </div>
                            <input type="file" id="utmMaterialFileInput" class="hidden" multiple
                                   accept=".pdf,.doc,.docx,.ppt,.pptx,.mp4,.webm,.ogg,.mkv,.jpg,.jpeg,.png,.webp,.gif"
                                   onchange="onUtmMaterialFilesSelected(this)">
                        </div>

                        <!-- Mode B: Add Link / URL Sub-Form -->
                        <div id="utmMatUrlPane" class="hidden space-y-2.5">
                            <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                <div class="sm:col-span-2">
                                    <label class="block text-[11px] font-bold text-slate-600 mb-1">Resource Title</label>
                                    <input type="text" id="utmLinkTitleInput" class="utm-input py-2 text-xs" placeholder="e.g. PhET Interactive Periodic Table">
                                </div>
                                <div>
                                    <label class="block text-[11px] font-bold text-slate-600 mb-1">Material Type</label>
                                    <select id="utmLinkTypeInput" class="utm-input py-2 text-xs">
                                        <option value="link">Web Link / URL</option>
                                        <option value="video">External Video Link</option>
                                        <option value="pdf">External PDF Link</option>
                                    </select>
                                </div>
                            </div>
                            <div class="flex flex-col sm:flex-row gap-2">
                                <input type="url" id="utmLinkUrlInput" class="utm-input py-2 text-xs flex-1" placeholder="https://...">
                                <button type="button" onclick="addUtmUrlMaterialToQueue()" class="px-3.5 py-2 rounded-xl bg-teal-600 hover:bg-teal-700 text-white text-xs font-bold transition flex items-center justify-center gap-1.5 cursor-pointer flex-shrink-0">
                                    <i class="fas fa-plus"></i> Queue Link
                                </button>
                            </div>
                        </div>

                        <!-- Queued New Materials Staging List -->
                        <div id="utmQueuedMaterialsWrap" class="hidden pt-2 border-t border-slate-100">
                            <div class="flex items-center justify-between mb-1.5">
                                <span class="text-[11px] font-extrabold text-indigo-700 uppercase tracking-wider">
                                    <i class="fas fa-layer-group mr-1"></i>Queued to Upload on Save (<span id="utmQueuedMatCount">0</span>)
                                </span>
                                <button type="button" onclick="clearUtmMaterialQueue()" class="text-[11px] font-bold text-rose-500 hover:underline cursor-pointer">
                                    Clear Queue
                                </button>
                            </div>
                            <div id="utmQueuedMaterialsList" class="space-y-2 max-h-60 overflow-y-auto pr-1"></div>
                        </div>
                    </div>
                </div>

                <!-- 5. TOPIC ACCESS & AUTOMATIC LOCK / UNLOCK SCHEDULING -->
                <div class="utm-section-box" style="border-color:#c7d2fe; background:linear-gradient(180deg, #eef2ff 0%, #ffffff 100%);">
                    <div class="flex items-center justify-between flex-wrap gap-2 mb-3">
                        <div>
                            <div class="utm-label mb-0" style="color:#3730a3;">
                                <span><i class="fas fa-user-lock text-indigo-600 mr-1.5"></i>Topic Access & Automatic Unlock / Lock</span>
                            </div>
                            <p class="text-[11px] text-slate-500 mt-0.5">
                                Control whether students can access this topic right now, or schedule automatic unlock and lock dates.
                            </p>
                        </div>

                        <!-- Manual Lock / Unlock Segmented Switch -->
                        <div class="inline-flex bg-slate-100 p-1 rounded-xl border border-slate-200">
                            <input type="hidden" id="topicIsLockedInput" name="is_locked" value="1">
                            <button type="button" id="utmLockStateLockedBtn" onclick="setUtmTopicLockState(1)"
                                class="px-3 py-1.5 rounded-lg text-xs font-extrabold transition flex items-center gap-1.5 cursor-pointer bg-amber-500 text-white shadow-2xs">
                                <i class="fas fa-lock"></i> Locked
                            </button>
                            <button type="button" id="utmLockStateUnlockedBtn" onclick="setUtmTopicLockState(0)"
                                class="px-3 py-1.5 rounded-lg text-xs font-extrabold transition flex items-center gap-1.5 cursor-pointer text-slate-600 hover:text-slate-800">
                                <i class="fas fa-lock-open"></i> Unlocked
                            </button>
                        </div>
                    </div>

                    <!-- Auto-Unlock and Auto-Lock Date/Time Pickers -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-2 border-t border-indigo-100">
                        <div class="bg-white p-3 rounded-xl border border-slate-200">
                            <div class="flex items-center justify-between mb-1">
                                <label class="text-[11px] font-extrabold text-emerald-700 uppercase tracking-wider flex items-center gap-1">
                                    <i class="fas fa-clock"></i> Auto-Unlock At
                                </label>
                                <div class="flex items-center gap-2">
                                    <button type="button" onclick="setUtmScheduleNow('topicAutoUnlockAt')" class="text-[10px] font-extrabold text-emerald-700 hover:text-emerald-900 bg-emerald-50 hover:bg-emerald-100 px-1.5 py-0.5 rounded border border-emerald-200 cursor-pointer transition" title="Set to right now (triggers ~1s after saving)">
                                        Now
                                    </button>
                                    <button type="button" onclick="clearUtmScheduleField('topicAutoUnlockAt')" class="text-[10px] font-bold text-slate-400 hover:text-rose-500 cursor-pointer">
                                        Clear
                                    </button>
                                </div>
                            </div>
                            <input type="datetime-local" id="topicAutoUnlockAt" name="auto_unlock_at" step="1"
                                onchange="onUtmScheduleFieldChange('unlock')"
                                class="utm-input py-2 text-xs bg-slate-50">
                            <p class="text-[10px] text-slate-400 mt-1">Automatically unlocks topic for students at this date & time.</p>
                        </div>

                        <div class="bg-white p-3 rounded-xl border border-slate-200">
                            <div class="flex items-center justify-between mb-1">
                                <label class="text-[11px] font-extrabold text-rose-700 uppercase tracking-wider flex items-center gap-1">
                                    <i class="fas fa-hourglass-end"></i> Auto-Lock At
                                </label>
                                <div class="flex items-center gap-2">
                                    <button type="button" onclick="setUtmScheduleNow('topicAutoLockAt')" class="text-[10px] font-extrabold text-rose-700 hover:text-rose-900 bg-rose-50 hover:bg-rose-100 px-1.5 py-0.5 rounded border border-rose-200 cursor-pointer transition" title="Set to right now (triggers ~1s after saving)">
                                        Now
                                    </button>
                                    <button type="button" onclick="clearUtmScheduleField('topicAutoLockAt')" class="text-[10px] font-bold text-slate-400 hover:text-rose-500 cursor-pointer">
                                        Clear
                                    </button>
                                </div>
                            </div>
                            <input type="datetime-local" id="topicAutoLockAt" name="auto_lock_at" step="1"
                                onchange="onUtmScheduleFieldChange('lock')"
                                class="utm-input py-2 text-xs bg-slate-50">
                            <p class="text-[10px] text-slate-400 mt-1">Automatically locks topic when this deadline is reached.</p>
                        </div>
                    </div>

                    <!-- Live Schedule Status Banner -->
                    <div id="utmScheduleSummaryBanner" class="mt-2.5 px-3 py-2 rounded-xl bg-indigo-50 border border-indigo-200 text-indigo-800 text-xs font-semibold flex items-center gap-2 hidden">
                        <i class="fas fa-calendar-check text-indigo-600 flex-shrink-0"></i>
                        <span id="utmScheduleSummaryText" class="break-words"></span>
                    </div>
                </div>
            </div>

            <!-- Sticky Modal Footer -->
            <div class="utm-footer">
                <div class="text-[11px] text-slate-500 font-medium flex items-center gap-1.5">
                    <i class="fas fa-shield-halved text-indigo-500"></i>
                    <span>All fields auto-expand dynamically to fit long content</span>
                </div>
                <div class="flex items-center gap-2 ml-auto">
                    <button type="button" onclick="handleTopicModalClose()" class="utm-btn">Cancel</button>
                    <button type="submit" id="topicSaveBtn" class="utm-btn utm-btn-primary">
                        <i class="fas fa-save text-xs"></i> <span id="topicSaveBtnText">Save Topic</span>
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

