            <button type="button" id="topicExecuteSaveBtn" onclick="confirmExecuteTopicSave()" class="utm-btn utm-btn-primary">
                <i class="fas fa-check text-xs"></i> <span id="topicExecuteSaveBtnText">Yes, Save Topic</span>
            </button>
        </div>
