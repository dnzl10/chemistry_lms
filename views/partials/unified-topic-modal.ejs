                    <div>
                        <span class="text-slate-400 font-bold uppercase text-[10px] tracking-wider">Access & Schedule</span>
                        <div class="font-bold text-indigo-700 mt-0.5 break-words" id="topicConfirmSchedule"></div>
                    </div>
