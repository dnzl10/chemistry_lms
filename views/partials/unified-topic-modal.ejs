</div>

<script>
/* ============================================================================
   UNIFIED TOPIC MODAL CONTROLLER (Shared by Teacher & Admin)
   ============================================================================ */
(function() {
    if (window.__UNIFIED_TOPIC_MODAL_LOADED__) return;
    window.__UNIFIED_TOPIC_MODAL_LOADED__ = true;

    window.UTM_ROLE_CONTEXT = '<%= typeof roleContext !== "undefined" ? roleContext : "Teacher" %>';
    window.topicInitialState = null;
    window.pendingTopicPayload = null;
    window.utmExistingMaterials = [];
    window.utmQueuedMaterials = [];
    window.utmCurrentMaterialMode = 'file';

    /* ── Toast & Modal Bridge Helpers ── */
    window.utmToast = function(msg, type = 'success') {
        if (typeof window.cmToast === 'function') {
            window.cmToast(msg, type);
        } else if (typeof window.showToast === 'function') {
            window.showToast(msg, type);
        } else {
            alert(msg);
        }
    };

    window.utmOpenModal = function(id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.add('open');
        if (typeof window.openModal === 'function') {
            try { window.openModal(id); } catch (_) {}
        }
    };

    window.utmCloseModal = function(id) {
        const el = document.getElementById(id);
        if (!el) return;
        el.classList.remove('open');
        if (typeof window.closeModal === 'function') {
            try { window.closeModal(id); } catch (_) {}
        }
    };

    window.utmEscapeHtml = function(str) {
        if (!str) return '';
        return String(str)
            .replace(/&/g, '&amp;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#039;');
    };

    /* ── 1. Responsive & Dynamic Auto-Resizing Fields Engine ── */
    window.autoResizeTopicField = function(el) {
        if (!el) return;
        const minH = parseInt(el.getAttribute('data-min-height') || '36', 10);
        const maxH = parseInt(el.getAttribute('data-max-height') || '320', 10);
        el.style.height = 'auto';
        const targetH = Math.max(minH, el.scrollHeight);
        if (targetH > maxH) {
            el.style.height = maxH + 'px';
            el.style.overflowY = 'auto';
        } else {
            el.style.height = targetH + 'px';
            el.style.overflowY = 'hidden';
        }
    };

    window.autoResizeAllTopicFields = function() {
        const fields = document.querySelectorAll('#topicModal .topic-autofit-field');
        fields.forEach(field => window.autoResizeTopicField(field));
    };

    window.updateTopicCharCounts = function() {
        const nameVal = (document.getElementById('topicName')?.value || '');
        const descVal = (document.getElementById('topicDesc')?.value || '');
        const nameCountEl = document.getElementById('topicNameCount');
        const descCountEl = document.getElementById('topicDescCount');

        if (nameCountEl) {
            nameCountEl.textContent = `${nameVal.length} chars`;
        }
        if (descCountEl) {
            const words = descVal.trim() ? descVal.trim().split(/\s+/).length : 0;
            descCountEl.textContent = `${words} word${words === 1 ? '' : 's'} • ${descVal.length} chars`;
        }
    };

    // Observe modal body size changes so wrapping textareas adjust on viewport resize
    if (typeof ResizeObserver !== 'undefined') {
        const ro = new ResizeObserver(() => {
            const modalEl = document.getElementById('topicModal');
            if (modalEl && modalEl.classList.contains('open')) {
                window.autoResizeAllTopicFields();
            }
        });
        window.addEventListener('DOMContentLoaded', () => {
            const scrollBody = document.getElementById('topicModalScrollBody');
            if (scrollBody) ro.observe(scrollBody);
        });
    }
    window.addEventListener('resize', () => {
        const modalEl = document.getElementById('topicModal');
        if (modalEl && modalEl.classList.contains('open')) {
            window.autoResizeAllTopicFields();
        }
    });

    /* ── 2. Interactive Bullet Objectives Builder ── */
    window.parseRawObjectivesToArray = function(rawText) {
        if (!rawText || !String(rawText).trim()) return [];
        const text = String(rawText).trim();

        // First split by newlines
        let lines = text.split(/\r?\n/).map(l => l.trim()).filter(Boolean);

        // If single line contains multiple inline bullets (e.g. "• Obj 1 • Obj 2" or "1. Obj 1 2. Obj 2")
        if (lines.length === 1) {
            const inlineSplit = lines[0]
                .split(/(?:^|\s+)(?:\d+[\.\)]|[•\*])(?:\s+)/)
                .map(s => s.trim())
                .filter(Boolean);
            if (inlineSplit.length > 1) {
                lines = inlineSplit;
            }
        }

        return lines
            .map(line => line.replace(/^(?:\d+[\.\)]|[-•\*])\s*/, '').trim())
            .filter(Boolean);
    };

    window.syncObjectivesHiddenField = function() {
        const inputs = Array.from(document.querySelectorAll('#topicObjectivesList .utm-obj-textarea'));
        const values = inputs.map(el => el.value.replace(/\r?\n/g, ' ').trim()).filter(Boolean);
        const hiddenEl = document.getElementById('topicObj');
        if (hiddenEl) {
            hiddenEl.value = values.map(v => `• ${v}`).join('\n');
        }
        const badgeEl = document.getElementById('topicObjCountBadge');
        if (badgeEl) {
            const count = values.length;
            badgeEl.textContent = `${count} Objective${count === 1 ? '' : 's'}`;
        }
        return values;
    };

    window.renderTopicObjectiveRows = function(items) {
        const container = document.getElementById('topicObjectivesList');
        if (!container) return;
        const list = (Array.isArray(items) && items.length > 0) ? items : [''];
        container.innerHTML = '';
        list.forEach((val) => {
            window.addTopicObjectiveRow(val, false);
        });
        window.syncObjectivesHiddenField();
        setTimeout(window.autoResizeAllTopicFields, 20);
    };

    window.addTopicObjectiveRow = function(initialText = '', focusNew = true, insertAfterRow = null) {
        const container = document.getElementById('topicObjectivesList');
        if (!container) return null;

        const row = document.createElement('div');
        row.className = 'utm-obj-row';

        const bullet = document.createElement('div');
        bullet.className = 'utm-obj-bullet';
        bullet.textContent = '•';

        const textarea = document.createElement('textarea');
        textarea.className = 'utm-obj-textarea topic-autofit-field';
        textarea.rows = 1;
        textarea.setAttribute('data-min-height', '28');
        textarea.setAttribute('data-max-height', '220');
        textarea.placeholder = 'Enter a specific learning objective (e.g. Explain how ionic and covalent bonds form)...';
        textarea.value = initialText || '';

        textarea.addEventListener('input', function() {
            window.autoResizeTopicField(this);
            window.syncObjectivesHiddenField();
        });

        textarea.addEventListener('keydown', function(ev) {
            if (ev.key === 'Enter' && !ev.shiftKey) {
                ev.preventDefault();
                window.addTopicObjectiveRow('', true, row);
            } else if (ev.key === 'Backspace' && !this.value.trim()) {
                const allRows = container.querySelectorAll('.utm-obj-row');
                if (allRows.length > 1) {
                    ev.preventDefault();
                    const prevRow = row.previousElementSibling || row.nextElementSibling;
                    row.remove();
                    window.syncObjectivesHiddenField();
                    if (prevRow) {
                        const prevInput = prevRow.querySelector('.utm-obj-textarea');
                        if (prevInput) {
                            prevInput.focus();
                            prevInput.setSelectionRange(prevInput.value.length, prevInput.value.length);
                        }
                    }
                }
            }
        });

        // Smart multi-line paste: split pasted lines into individual bullet rows
        textarea.addEventListener('paste', function(ev) {
            const clipText = (ev.clipboardData || window.clipboardData)?.getData('text') || '';
            if (clipText && /\r?\n/.test(clipText.trim())) {
                const parsedItems = window.parseRawObjectivesToArray(clipText);
                if (parsedItems.length > 1) {
                    ev.preventDefault();
                    if (!this.value.trim()) {
                        this.value = parsedItems[0];
                        window.autoResizeTopicField(this);
                    } else {
                        this.value = (this.value + ' ' + parsedItems[0]).trim();
                        window.autoResizeTopicField(this);
                    }
                    let anchor = row;
                    for (let i = 1; i < parsedItems.length; i++) {
                        anchor = window.addTopicObjectiveRow(parsedItems[i], i === parsedItems.length - 1, anchor);
                    }
                    window.syncObjectivesHiddenField();
                }
            }
        });

        const delBtn = document.createElement('button');
        delBtn.type = 'button';
        delBtn.className = 'w-7 h-7 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition flex-shrink-0 cursor-pointer';
        delBtn.title = 'Remove objective';
        delBtn.innerHTML = '<i class="fas fa-times text-xs"></i>';
        delBtn.onclick = function() {
            const allRows = container.querySelectorAll('.utm-obj-row');
            if (allRows.length <= 1) {
                textarea.value = '';
                window.autoResizeTopicField(textarea);
                window.syncObjectivesHiddenField();
                textarea.focus();
                return;
            }
            row.remove();
            window.syncObjectivesHiddenField();
        };

        row.appendChild(bullet);
        row.appendChild(textarea);
        row.appendChild(delBtn);

        if (insertAfterRow && insertAfterRow.parentNode === container) {
            insertAfterRow.insertAdjacentElement('afterend', row);
        } else {
            container.appendChild(row);
        }

        window.autoResizeTopicField(textarea);
        window.syncObjectivesHiddenField();

        if (focusNew) {
            setTimeout(() => textarea.focus(), 10);
        }
        return row;
    };

    /* ── 3. Video URL Embed Parser & Live Preview ── */
    window.parseUnifiedVideoEmbedInfo = function(rawUrl) {
        if (!rawUrl || !rawUrl.trim()) return null;
        rawUrl = rawUrl.trim();

        const ytMatch = rawUrl.match(/(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/|youtube\.com\/shorts\/)([^"&?\/\s]{11})/i);
        if (ytMatch && ytMatch[1]) {
            return {
                type: 'iframe',
                src: `https://www.youtube-nocookie.com/embed/${ytMatch[1]}?rel=0`,
                platform: 'YouTube',
                rawUrl
            };
        }

        const vimeoMatch = rawUrl.match(/(?:vimeo\.com\/(?:channels\/(?:\w+\/)?|groups\/[^\/]*\/videos\/|album\/\d+\/video\/|video\/|)(\d+))/i);
        if (vimeoMatch && vimeoMatch[1]) {
            return {
                type: 'iframe',
                src: `https://player.vimeo.com/video/${vimeoMatch[1]}`,
                platform: 'Vimeo',
                rawUrl
            };
        }

        if (/\.(mp4|webm|ogg)($|\?)/i.test(rawUrl)) {
            return {
                type: 'video',
                src: rawUrl,
                platform: 'Direct Video',
                rawUrl
            };
        }

        if (/^https?:\/\//i.test(rawUrl)) {
            return {
                type: 'generic',
                src: rawUrl,
                platform: 'External Video',
                rawUrl
            };
        }

        return null;
    };

    window.handleUnifiedTopicVideoPreview = function() {
        const input = document.getElementById('topicVideoUrl');
        const container = document.getElementById('topicVideoPreviewContainer');
        const wrapper = document.getElementById('topicVideoFrameWrapper');
        const clearBtn = document.getElementById('topicVideoClearBtn');
        const badge = document.getElementById('topicVideoBadge');
        if (!input || !container || !wrapper) return;

        const val = input.value.trim();
        if (clearBtn) {
            clearBtn.classList.toggle('hidden', !val);
        }

        if (!val) {
            container.classList.add('hidden');
            wrapper.innerHTML = '';
            return;
        }

        const info = window.parseUnifiedVideoEmbedInfo(val);
        container.classList.remove('hidden');

        if (!info) {
            if (badge) {
                badge.className = 'text-[11px] text-amber-600 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200 font-semibold flex items-center gap-1';
                badge.innerHTML = '<i class="fas fa-exclamation-circle"></i> Invalid URL';
            }
            wrapper.innerHTML = `
                <div class="text-center p-4 text-slate-400">
                    <i class="fas fa-video-slash text-2xl text-slate-300 mb-1 block"></i>
                    <p class="text-xs font-semibold text-slate-500">Unrecognized video URL</p>
                    <p class="text-[10px] text-slate-400 mt-0.5">Please provide a valid YouTube, Vimeo, or direct video (.mp4) link.</p>
                </div>
            `;
            return;
        }

        if (badge) {
            badge.className = 'text-[11px] text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200 font-semibold flex items-center gap-1';
            badge.innerHTML = `<i class="fas fa-check-circle"></i> ${info.platform} Ready`;
        }

        if (info.type === 'iframe') {
            wrapper.innerHTML = `
                <iframe src="${info.src}" class="w-full h-full border-0 rounded-lg"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
            `;
        } else if (info.type === 'video') {
            wrapper.innerHTML = `
                <video src="${info.src}" controls class="w-full h-full object-contain rounded-lg bg-black">
                    Your browser does not support the video tag.
                </video>
            `;
        } else {
            wrapper.innerHTML = `
                <iframe src="${info.src}" class="w-full h-full border-0 rounded-lg" allowfullscreen sandbox="allow-scripts allow-same-origin allow-presentation"></iframe>
            `;
        }
    };

    window.clearUnifiedTopicVideoPreview = function() {
        const input = document.getElementById('topicVideoUrl');
        if (input) {
            input.value = '';
            window.autoResizeTopicField(input);
        }
        window.handleUnifiedTopicVideoPreview();
    };

    /* ── 4. Embedded Learning Materials Manager (Existing + Queued) ── */
    const UTM_MAT_ICONS = {
        pdf: 'fa-file-pdf text-rose-500',
        word: 'fa-file-word text-blue-600',
        presentation: 'fa-file-powerpoint text-orange-500',
        video: 'fa-file-video text-purple-600',
        img: 'fa-file-image text-emerald-600',
        link: 'fa-link text-indigo-600'
    };

    window.detectMaterialTypeFromFile = function(fileName) {
        const ext = (fileName.split('.').pop() || '').toLowerCase();
        if (ext === 'pdf') return 'pdf';
        if (['doc', 'docx'].includes(ext)) return 'word';
        if (['ppt', 'pptx'].includes(ext)) return 'presentation';
        if (['mp4', 'webm', 'ogg', 'mkv', 'mov', 'avi'].includes(ext)) return 'video';
        if (['jpg', 'jpeg', 'png', 'webp', 'gif', 'svg'].includes(ext)) return 'img';
        return 'pdf';
    };

    window.updateUtmMaterialsBadges = function() {
        const existingCount = window.utmExistingMaterials.length;
        const queuedCount = window.utmQueuedMaterials.length;
        const total = existingCount + queuedCount;
        const totalBadge = document.getElementById('utmMaterialsTotalBadge');
        if (totalBadge) {
            totalBadge.textContent = `${total} Material${total === 1 ? '' : 's'}${queuedCount > 0 ? ` (${queuedCount} new)` : ''}`;
            totalBadge.className = total > 0
                ? 'text-[11px] font-extrabold px-2.5 py-1 rounded-full bg-teal-50 text-teal-700 border border-teal-200'
                : 'text-[11px] font-extrabold px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 border border-amber-200';
        }
    };

    window.renderUtmExistingMaterials = function() {
        const wrap = document.getElementById('utmExistingMaterialsWrap');
        const listEl = document.getElementById('utmExistingMaterialsList');
        const countEl = document.getElementById('utmExistingMatCount');
        if (!wrap || !listEl) return;

        if (!window.utmExistingMaterials || window.utmExistingMaterials.length === 0) {
            wrap.classList.add('hidden');
            listEl.innerHTML = '';
            window.updateUtmMaterialsBadges();
            return;
        }

        wrap.classList.remove('hidden');
        if (countEl) countEl.textContent = String(window.utmExistingMaterials.length);

        listEl.innerHTML = window.utmExistingMaterials.map((m) => {
            const isLocked = Number(m.is_locked) === 1;
            const iconCls = UTM_MAT_ICONS[m.material_type] || 'fa-file text-slate-500';
            const rawPath = m.file_path_or_url || '';
            const href = (rawPath.startsWith('http://') || rawPath.startsWith('https://'))
                ? rawPath
                : `/material_uploads/${rawPath.replace(/^\/?material_uploads\//, '')}`;

            return `
                <div class="flex items-center justify-between gap-2 p-2.5 rounded-xl bg-white border border-slate-200 shadow-2xs">
                    <div class="flex items-center gap-2.5 min-w-0 flex-1">
                        <div class="w-8 h-8 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center flex-shrink-0">
                            <i class="fas ${iconCls} text-sm"></i>
                        </div>
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-bold text-slate-800 break-words leading-snug">${window.utmEscapeHtml(m.title)}</p>
                            <div class="flex items-center gap-2 mt-0.5">
                                <span class="text-[10px] font-bold uppercase text-slate-400">${window.utmEscapeHtml(m.material_type || 'file')}</span>
                                <a href="${window.utmEscapeHtml(href)}" target="_blank" class="text-[11px] font-semibold text-indigo-600 hover:underline">
                                    <i class="fas fa-arrow-up-right-from-square text-[9px] mr-0.5"></i>Open
                                </a>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-1 flex-shrink-0">
                        <button type="button" onclick="toggleUtmExistingMaterialLock(${m.material_id}, ${isLocked ? 1 : 0})"
                            class="px-2 py-1 rounded-lg text-[11px] font-bold border transition cursor-pointer ${isLocked ? 'bg-amber-50 text-amber-700 border-amber-200 hover:bg-amber-100' : 'bg-emerald-50 text-emerald-700 border-emerald-200 hover:bg-emerald-100'}"
                            title="${isLocked ? 'Click to Unlock Material' : 'Click to Lock Material'}">
                            <i class="fas ${isLocked ? 'fa-lock' : 'fa-lock-open'}"></i> ${isLocked ? 'Locked' : 'Unlocked'}
                        </button>
                        <button type="button" onclick="deleteUtmExistingMaterial(${m.material_id})"
                            class="w-7 h-7 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center transition cursor-pointer"
                            title="Delete material">
                            <i class="fas fa-trash-can text-xs"></i>
                        </button>
                    </div>
                </div>
            `;
        }).join('');

        window.updateUtmMaterialsBadges();
    };

    window.toggleUtmExistingMaterialLock = async function(matId, currentLocked) {
        const newVal = currentLocked ? 0 : 1;
        try {
            const res = await fetch(`/teacher/api/material/${matId}/lock`, {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ is_locked: newVal })
            });
            if (!res.ok) throw new Error();
            const item = window.utmExistingMaterials.find(m => Number(m.material_id) === Number(matId));
            if (item) item.is_locked = newVal;
            window.renderUtmExistingMaterials();
            window.utmToast(`Material ${newVal ? 'locked' : 'unlocked'}.`, 'success');
        } catch (_) {
            window.utmToast('Failed to update material lock state.', 'error');
        }
    };

    window.deleteUtmExistingMaterial = async function(matId) {
        if (!confirm('Remove this learning material from the topic?')) return;
        try {
            const res = await fetch(`/teacher/api/material/${matId}`, { method: 'DELETE' });
            if (!res.ok) throw new Error();
            window.utmExistingMaterials = window.utmExistingMaterials.filter(m => Number(m.material_id) !== Number(matId));
            window.renderUtmExistingMaterials();
            window.utmToast('Material removed.', 'success');
        } catch (_) {
            window.utmToast('Failed to delete material.', 'error');
        }
    };

    window.switchUtmMaterialMode = function(mode) {
        window.utmCurrentMaterialMode = mode === 'url' ? 'url' : 'file';
        const filePane = document.getElementById('utmMatFilePane');
        const urlPane = document.getElementById('utmMatUrlPane');
        const fileBtn = document.getElementById('utmMatTabFileBtn');
        const urlBtn = document.getElementById('utmMatTabUrlBtn');

        if (window.utmCurrentMaterialMode === 'file') {
            filePane?.classList.remove('hidden');
            urlPane?.classList.add('hidden');
            if (fileBtn) fileBtn.className = 'px-3 py-1 rounded-md text-xs font-bold transition cursor-pointer bg-white text-indigo-600 shadow-2xs';
            if (urlBtn) urlBtn.className = 'px-3 py-1 rounded-md text-xs font-bold transition cursor-pointer text-slate-600 hover:text-slate-800';
        } else {
            filePane?.classList.add('hidden');
            urlPane?.classList.remove('hidden');
            if (urlBtn) urlBtn.className = 'px-3 py-1 rounded-md text-xs font-bold transition cursor-pointer bg-white text-indigo-600 shadow-2xs';
            if (fileBtn) fileBtn.className = 'px-3 py-1 rounded-md text-xs font-bold transition cursor-pointer text-slate-600 hover:text-slate-800';
        }
    };

    window.handleUtmMatDragOver = function(e) {
        e.preventDefault();
        e.stopPropagation();
        const dz = document.getElementById('utmMatDropzone');
        if (dz) dz.classList.add('border-indigo-500', 'bg-indigo-50');
    };

    window.handleUtmMatDragLeave = function(e) {
        e.preventDefault();
        e.stopPropagation();
        const dz = document.getElementById('utmMatDropzone');
        if (dz) dz.classList.remove('border-indigo-500', 'bg-indigo-50');
    };

    window.handleUtmMatDrop = function(e) {
        e.preventDefault();
        e.stopPropagation();
        window.handleUtmMatDragLeave(e);
        if (e.dataTransfer?.files?.length) {
            window.enqueueUtmMaterialFiles(e.dataTransfer.files);
        }
    };

    window.onUtmMaterialFilesSelected = function(input) {
        if (input.files && input.files.length > 0) {
            window.enqueueUtmMaterialFiles(input.files);
            input.value = '';
        }
    };

    window.enqueueUtmMaterialFiles = function(fileList) {
        const maxBytes = 50 * 1024 * 1024;
        for (const file of Array.from(fileList)) {
            if (file.size > maxBytes) {
                window.utmToast(`File "${file.name}" exceeds the 50MB limit.`, 'error');
                continue;
            }
            const cleanTitle = file.name.replace(/\.[^/.]+$/, '').replace(/[_-]+/g, ' ');
            const detectedType = window.detectMaterialTypeFromFile(file.name);
            window.utmQueuedMaterials.push({
                sourceMode: 'file',
                file: file,
                url: '',
                title: cleanTitle,
                material_type: detectedType,
                is_locked: 0
            });
        }
        window.renderUtmQueuedMaterials();
    };

    window.addUtmUrlMaterialToQueue = function() {
        const titleEl = document.getElementById('utmLinkTitleInput');
        const typeEl = document.getElementById('utmLinkTypeInput');
        const urlEl = document.getElementById('utmLinkUrlInput');

        const title = (titleEl?.value || '').trim();
        const type = typeEl?.value || 'link';
        const url = (urlEl?.value || '').trim();

        if (!title) {
            window.utmToast('Please enter a title for the link resource.', 'error');
            titleEl?.focus();
            return;
        }
        if (!url || !/^https?:\/\//i.test(url)) {
            window.utmToast('Please enter a valid URL starting with http:// or https://', 'error');
            urlEl?.focus();
            return;
        }

        window.utmQueuedMaterials.push({
            sourceMode: 'url',
            file: null,
            url: url,
            title: title,
            material_type: type,
            is_locked: 0
        });

        if (titleEl) titleEl.value = '';
        if (urlEl) urlEl.value = '';
        window.renderUtmQueuedMaterials();
    };

    window.removeUtmQueuedMaterial = function(idx) {
        window.utmQueuedMaterials.splice(idx, 1);
        window.renderUtmQueuedMaterials();
    };

    window.clearUtmMaterialQueue = function() {
        window.utmQueuedMaterials = [];
        window.renderUtmQueuedMaterials();
    };

    window.renderUtmQueuedMaterials = function() {
        const wrap = document.getElementById('utmQueuedMaterialsWrap');
        const listEl = document.getElementById('utmQueuedMaterialsList');
        const countEl = document.getElementById('utmQueuedMatCount');
