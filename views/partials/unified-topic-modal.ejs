                <div class="pt-1 border-t border-slate-200">
                    <span class="text-slate-400 font-bold uppercase text-[10px] tracking-wider">Video URL</span>
                    <div class="text-indigo-600 mt-0.5 break-all font-mono text-[11px]" id="topicConfirmVideo"></div>
                </div>
