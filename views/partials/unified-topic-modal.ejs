        wrap.classList.remove('hidden');
        if (countEl) countEl.textContent = String(window.utmQueuedMaterials.length);

        listEl.innerHTML = window.utmQueuedMaterials.map((item, idx) => {
            const iconCls = UTM_MAT_ICONS[item.material_type] || 'fa-file text-indigo-500';
            const subInfo = item.sourceMode === 'file'
                ? `${item.file.name} (${(item.file.size / 1024 / 1024).toFixed(2)} MB)`
                : item.url;

            return `
                <div class="p-2.5 rounded-xl bg-indigo-50/50 border border-indigo-200 space-y-2">
                    <div class="flex items-start justify-between gap-2">
                        <div class="flex items-center gap-2 min-w-0 flex-1">
                            <i class="fas ${iconCls} text-sm flex-shrink-0"></i>
                            <input type="text" value="${window.utmEscapeHtml(item.title)}"
                                oninput="window.utmQueuedMaterials[${idx}].title = this.value"
                                placeholder="Material Title *"
                                class="utm-input py-1.5 px-2.5 text-xs font-bold bg-white flex-1">
                        </div>
                        <button type="button" onclick="removeUtmQueuedMaterial(${idx})"
                            class="w-7 h-7 rounded-lg text-slate-400 hover:text-rose-600 hover:bg-rose-50 flex items-center justify-center cursor-pointer flex-shrink-0"
                            title="Remove from queue">
                            <i class="fas fa-times text-xs"></i>
                        </button>
                    </div>
                    <div class="flex items-center justify-between gap-2 flex-wrap text-[11px] pl-6">
                        <span class="text-slate-500 truncate max-w-[260px]" title="${window.utmEscapeHtml(subInfo)}">${window.utmEscapeHtml(subInfo)}</span>
                        <div class="flex items-center gap-2">
                            <select onchange="window.utmQueuedMaterials[${idx}].material_type = this.value; window.renderUtmQueuedMaterials();"
                                class="border border-slate-200 rounded-lg px-2 py-1 text-[11px] font-semibold bg-white text-slate-700">
                                <option value="pdf" ${item.material_type === 'pdf' ? 'selected' : ''}>PDF</option>
                                <option value="word" ${item.material_type === 'word' ? 'selected' : ''}>Word</option>
                                <option value="presentation" ${item.material_type === 'presentation' ? 'selected' : ''}>Presentation</option>
                                <option value="video" ${item.material_type === 'video' ? 'selected' : ''}>Video</option>
                                <option value="img" ${item.material_type === 'img' ? 'selected' : ''}>Image</option>
