<script>
    // ========================================================
    // Standardized Student Side Navigation & Tree UI Controller
    // ========================================================

    const TREE_STORAGE_KEY = 'elementa_student_tree_nodes_v2';
    const SIDEBAR_COLLAPSE_KEY = 'elementa_student_sidebar_collapsed';
    const SIDEBAR_SCROLL_KEY = 'elementa_student_nav_scroll';

    // 1. Dual-Mode Sidebar Collapse (Desktop Margin + Mobile Drawer)
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        const main = document.getElementById('mainContent');
        const header = document.querySelector('header');
        
        if (window.innerWidth < 768) {
            if (sidebar) {
                sidebar.classList.toggle('sidebar-open');
                sidebar.classList.toggle('sidebar-collapsed');
            }
            if (overlay) {
                overlay.classList.toggle('hidden');
            }
        } else {
            if (sidebar) {
                const isCollapsed = sidebar.classList.toggle('sidebar-collapsed');
                if (main) main.classList.toggle('sidebar-collapsed-main', isCollapsed);
                if (header) header.classList.toggle('sidebar-collapsed-header', isCollapsed);
                try {
                    localStorage.setItem(SIDEBAR_COLLAPSE_KEY, isCollapsed ? '1' : '0');
                } catch (e) {}
            }
        }
    }

    // 2. Tree Navigation State & LocalStorage Persistence Manager
    function getStoredTreeState() {
        try {
            const raw = localStorage.getItem(TREE_STORAGE_KEY);
            return raw ? JSON.parse(raw) : null;
        } catch (e) {
            return null;
        }
    }

    function setStoredTreeState(stateArray) {
        try {
            localStorage.setItem(TREE_STORAGE_KEY, JSON.stringify(stateArray));
        } catch (e) {}
    }

    // Interactive Toggle for Individual Tree Branches
    function toggleTreeNode(branchId) {
        const branch = document.getElementById(branchId);
        if (!branch) return;

        const isExpanded = branch.classList.toggle('tree-expanded');
        const headerBtn = branch.querySelector('.tree-branch-header');
        if (headerBtn) {
            headerBtn.setAttribute('aria-expanded', isExpanded ? 'true' : 'false');
        }

        // Synchronize with LocalStorage
        const branchKey = branch.getAttribute('data-branch') || branchId.replace('branch-', '');
        let stored = getStoredTreeState();
        if (!Array.isArray(stored)) {
            stored = ['main', 'academics', 'community', 'progression'];
        }

        if (isExpanded) {
            if (!stored.includes(branchKey)) stored.push(branchKey);
        } else {
            stored = stored.filter(k => k !== branchKey);
        }
        setStoredTreeState(stored);
    }

    // 3. Tree Initialization with Auto-Expansion of Active Branch & Zero Reload Jitter
    function initStudentNavTree() {
        const stored = getStoredTreeState();
        const branches = document.querySelectorAll('.tree-branch');

        branches.forEach(branch => {
            const branchKey = branch.getAttribute('data-branch') || branch.id.replace('branch-', '');
            const isActiveBranch = branch.classList.contains('is-active-branch');
            const headerBtn = branch.querySelector('.tree-branch-header');

            let shouldExpand = false;
            if (stored === null) {
                // Default first-run: keep all navigation branches expanded by default (Main, Academics, Community, Progression)
                shouldExpand = true;
            } else {
                shouldExpand = stored.includes(branchKey) || isActiveBranch;
            }

            if (shouldExpand) {
                branch.classList.add('tree-expanded');
                if (headerBtn) headerBtn.setAttribute('aria-expanded', 'true');
            } else {
                branch.classList.remove('tree-expanded');
                if (headerBtn) headerBtn.setAttribute('aria-expanded', 'false');
            }

            // Keyboard navigation support on branch header button
            if (headerBtn && !headerBtn.dataset.treeNavBound) {
                headerBtn.dataset.treeNavBound = 'true';
                headerBtn.addEventListener('keydown', function(e) {
                    if (e.key === 'ArrowRight' && !branch.classList.contains('tree-expanded')) {
                        toggleTreeNode(branch.id);
                        e.preventDefault();
                    } else if (e.key === 'ArrowLeft' && branch.classList.contains('tree-expanded')) {
                        toggleTreeNode(branch.id);
                        e.preventDefault();
                    }
                });
            }
        });

        // 4. Persistent Scroll Position Restoration
        const navEl = document.getElementById('studentNavTree') || document.querySelector('#sidebar nav');
        if (navEl && !navEl.dataset.scrollBound) {
            navEl.dataset.scrollBound = 'true';
            try {
                const savedScroll = sessionStorage.getItem(SIDEBAR_SCROLL_KEY);
                if (savedScroll !== null) {
                    navEl.scrollTop = parseInt(savedScroll, 10);
                }
            } catch (e) {}

            navEl.addEventListener('scroll', () => {
                try {
                    sessionStorage.setItem(SIDEBAR_SCROLL_KEY, navEl.scrollTop);
                } catch (e) {}
            }, { passive: true });

            navEl.querySelectorAll('a').forEach(a => {
                a.addEventListener('click', () => {
                    try {
                        sessionStorage.setItem(SIDEBAR_SCROLL_KEY, navEl.scrollTop);
                    } catch (e) {}
                });
            });
        }

        // 5. Instant Hover Pre-fetching: Eliminates network latency between student views
        const prefetched = new Set();
        function prefetchUrl(url) {
            if (!url || prefetched.has(url) || url.startsWith('http') || url.startsWith('#') || url === '/logout') return;
            prefetched.add(url);
            const link = document.createElement('link');
            link.rel = 'prefetch';
            link.href = url;
            document.head.appendChild(link);
        }

        if (navEl) {
            navEl.querySelectorAll('a[href^="/"]').forEach(a => {
                const href = a.getAttribute('href');
                if (href && href !== '/logout') {
                    a.addEventListener('mouseenter', () => prefetchUrl(href), { passive: true });
                    a.addEventListener('touchstart', () => prefetchUrl(href), { passive: true });
                }
            });
        }

        // 6. Watch sidebar class changes to persist collapsed state regardless of which toggle function triggers it
        const sidebar = document.getElementById('sidebar');
        if (sidebar && !sidebar.dataset.collapseObserver) {
            sidebar.dataset.collapseObserver = 'true';
            if (window.MutationObserver) {
                const obs = new MutationObserver(() => {
                    const isCollapsed = sidebar.classList.contains('sidebar-collapsed');
                    try {
                        localStorage.setItem(SIDEBAR_COLLAPSE_KEY, isCollapsed ? '1' : '0');
                    } catch (e) {}
                });
                obs.observe(sidebar, { attributes: true, attributeFilter: ['class'] });
            }
        }

        // 7. Remove initial-load animation suppression smoothly after layout stabilizes
        requestAnimationFrame(() => {
            setTimeout(() => {
                if (sidebar) sidebar.classList.remove('tree-nav-initial-load');
            }, 80);
        });
    }

    // Auto-run on DOM Ready
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initStudentNavTree);
    } else {
        initStudentNavTree();
    }
</script>

