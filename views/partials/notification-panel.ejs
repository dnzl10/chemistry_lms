<!-- =============================================
     REUSABLE NOTIFICATION PANEL PARTIAL
     Include with: include('../partials/notification-panel')
     Requires: `notifications` and `user` in res.locals
============================================= -->

<!-- Notification Bell (drop this wherever you need the bell icon) -->
<!-- NOTE: The bell itself stays in each page's header. This partial is the PANEL + BACKDROP + SCRIPT only. -->

<!-- Panel -->
<div id="notifPanel" class="fixed top-0 right-0 h-full w-full max-w-sm z-[200] translate-x-full transition-transform duration-300 ease-in-out flex flex-col"
     style="background: linear-gradient(180deg, #0d1a2e 0%, #0f1f38 100%); box-shadow: -8px 0 40px rgba(6,182,212,0.15);">

    <div class="flex items-center justify-between px-6 py-5 border-b border-white/10 flex-shrink-0">
        <div>
            <h3 class="text-white font-black text-base tracking-tight uppercase italic flex items-center gap-2">
                <i class="fas fa-bell text-cyan-400 text-sm"></i> Notifications
            </h3>
            <% const _unreadCount = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications.filter(n => !n.is_read).length : 0; %>
            <p id="notifSubtitle" class="text-indigo-400 text-[10px] font-bold uppercase tracking-widest mt-0.5">
                <%= _unreadCount > 0 ? (_unreadCount + ' unread update' + (_unreadCount !== 1 ? 's' : '')) : 'All caught up' %>
            </p>
        </div>
        <div class="flex items-center gap-2">
            <button type="button" 
                    id="notifSettingsBtn"
                    onclick="toggleNotifSettings()" 
                    title="Notification Settings & Sound" 
                    aria-label="Notification Settings & Sound" 
                    class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 hover:bg-cyan-500/20 text-indigo-300 hover:text-cyan-300 transition text-xs">
                <i class="fas fa-cog text-sm"></i>
            </button>
            <button onclick="if(window.NotificationHub) NotificationHub.markAllRead('notifPanelList', true)" title="Mark all as read" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 hover:bg-cyan-500/20 text-cyan-300 transition text-xs">
                <i class="fas fa-check-double"></i>
            </button>
            <button onclick="toggleNotifPanel()" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 hover:bg-rose-500/20 text-indigo-300 hover:text-rose-400 transition">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>
    </div>

    <!-- Notification Settings Drawer (Sound selection & test) -->
    <div id="notifSettingsDrawer" class="hidden px-6 py-3 bg-white/5 border-b border-white/10 flex items-center justify-between text-xs text-indigo-300 flex-shrink-0 transition-all">
        <div class="flex items-center gap-2">
            <i class="fas fa-volume-up text-cyan-400 text-xs"></i>
            <span class="text-[11px] font-bold text-slate-300">Sound:</span>
            <select id="notifSoundSelect"
                    onchange="if(window.SoundManager) window.SoundManager.setSoundPack(this.value)" 
                    class="bg-white/10 text-white rounded-lg px-2.5 py-1 text-[11px] border border-white/10 focus:outline-none focus:ring-1 focus:ring-cyan-400 cursor-pointer">
                <option value="soft" class="bg-slate-900 text-white">Soft Chime</option>
                <option value="modern" class="bg-slate-900 text-white">Modern Pop</option>
                <option value="pop" class="bg-slate-900 text-white">Subtle Tone</option>
                <option value="mute" class="bg-slate-900 text-white">Mute Audio</option>
            </select>
        </div>
        <button type="button" 
                onclick="if(window.SoundManager) window.SoundManager.playSound()" 
                class="hover:text-cyan-300 text-[11px] font-bold flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white/5 hover:bg-cyan-500/20 border border-white/10 transition cursor-pointer" 
                title="Test audio cue">
            <i class="fas fa-play text-[9px]"></i> Test Sound
        </button>
    </div>

    <div id="notifPanelList" class="flex-1 overflow-y-auto no-scrollbar px-4 py-4 space-y-2">
        <% if (typeof notifications !== 'undefined' && notifications.length > 0) { %>
            <% notifications.forEach(notif => { %>
                <%
                    let href = notif.target_url || '#';
                    let iconClass = 'fas fa-book-open text-cyan-400';
                    let badgeClass = 'bg-blue-500/20 text-blue-300 border-blue-500/30';
                    let badgeLabel = 'Academic';
                    const cat = notif.category || '';
                    const evType = notif.event_type || notif.notif_type || '';

                    if (cat === 'assessment' || evType.includes('submission') || evType.includes('deadline') || evType.includes('assessment') || evType.includes('duel')) {
                        iconClass = 'fas fa-file-lines text-rose-400';
                        badgeClass = 'bg-rose-500/20 text-rose-300 border-rose-500/30';
                        badgeLabel = 'Assessment';
                    } else if (cat === 'forum' || evType.includes('forum')) {
                        iconClass = 'fas fa-comments text-emerald-400';
                        badgeClass = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
                        badgeLabel = 'Discussion';
                    } else if (cat === 'integrity' || evType.includes('flag') || evType.includes('report')) {
                        iconClass = 'fas fa-triangle-exclamation text-amber-400';
                        badgeClass = 'bg-amber-500/20 text-amber-300 border-amber-500/30';
                        badgeLabel = 'Integrity Alert';
                    } else if (cat === 'system' || evType.includes('registration') || evType.includes('enrolled') || evType.includes('class')) {
                        iconClass = 'fas fa-gear text-purple-400';
                        badgeClass = 'bg-purple-500/20 text-purple-300 border-purple-500/30';
                        badgeLabel = 'System';
                    } else if (cat === 'social' || evType.includes('message') || evType.includes('mention')) {
                        iconClass = 'fas fa-envelope text-cyan-400';
                        badgeClass = 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30';
                        badgeLabel = 'Message';
                    }

                    const isUnread = !notif.is_read;
                    const clickUrl = notif.notification_id ? ('/api/notifications/' + notif.notification_id + '/navigate') : href;
                    const timeVal = notif.created_at || notif.notif_time;
                %>
                <a href="<%= clickUrl %>"
                   class="flex items-start gap-3 p-3.5 rounded-2xl transition group relative cursor-pointer border <%= isUnread ? 'bg-white/10 border-cyan-500/40 shadow-lg shadow-cyan-950/20' : 'bg-white/5 hover:bg-white/10 border-white/5' %>">
                    <% if (isUnread) { %>
                        <span class="absolute top-3 right-3 w-2 h-2 rounded-full bg-cyan-400 shadow-sm shadow-cyan-400/80"></span>
                    <% } %>

                    <div class="flex-shrink-0 mt-0.5">
                        <% if (notif.actor_pic) { %>
                            <img src="/profile_uploads/<%= notif.actor_pic %>" class="w-9 h-9 rounded-xl object-cover ring-1 ring-white/10 group-hover:ring-cyan-400/40 transition" onerror="this.src='/profile_uploads/default_avatar.png'">
                        <% } else { %>
                            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center">
                                <i class="<%= iconClass %> text-sm"></i>
                            </div>
                        <% } %>
                    </div>

                    <div class="flex-1 min-w-0 pr-4">
                        <div class="flex items-center gap-2 mb-1 flex-wrap">
                            <span class="text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-lg border <%= badgeClass %>"><%= badgeLabel %></span>
                            <% if (timeVal) { %>
                                <span class="text-[9px] font-semibold text-indigo-400">
                                    <%= new Date(timeVal).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                </span>
                            <% } %>
                        </div>
                        <% if (notif.title) { %>
                            <p class="text-xs font-bold text-white group-hover:text-cyan-300 transition leading-snug line-clamp-2">
                                <%= notif.title %>
                            </p>
                            <p class="text-[11px] text-slate-300/80 mt-0.5 line-clamp-2 leading-tight">
                                <%= notif.message %>
                            </p>
                        <% } else { %>
                            <p class="text-white text-[11px] font-bold leading-snug group-hover:text-cyan-300 transition line-clamp-2">
                                <% if (notif.actor_name) { %>
                                    <span class="text-cyan-400"><%= notif.actor_name %></span>
                                <% } %>
                                <%= notif.message %>
                            </p>
                        <% } %>
                    </div>

                    <div class="flex-shrink-0 self-center text-indigo-500 group-hover:text-cyan-400 transition ml-auto">
                        <i class="fas fa-chevron-right text-[10px]"></i>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <div class="flex flex-col items-center justify-center h-full py-20 text-center">
                <div class="w-16 h-16 rounded-3xl bg-white/5 flex items-center justify-center mb-4">
                    <i class="fas fa-bell-slash text-indigo-500 text-2xl"></i>
                </div>
                <p class="text-indigo-400 text-xs font-black uppercase tracking-widest">You're all caught up!</p>
                <p class="text-indigo-600 text-[10px] font-bold mt-1">No new notifications</p>
            </div>
        <% } %>
    </div>

</div>

<!-- Backdrop -->
<div id="notifBackdrop" class="fixed inset-0 bg-indigo-950/50 backdrop-blur-sm z-[199] hidden" onclick="toggleNotifPanel()"></div>

<!-- Audio Manager, Notification Hub & Toggle Script -->
<script src="/js/soundManager.js"></script>
<script src="/js/notificationHub.js"></script>
<script>
    function toggleNotifSettings() {
        const drawer = document.getElementById('notifSettingsDrawer');
        const btn = document.getElementById('notifSettingsBtn');
        if (!drawer) return;
        const isHidden = drawer.classList.contains('hidden');
        if (isHidden) {
            if (window.SoundManager) {
                const currentPack = window.SoundManager.getSoundPack();
                const sel = document.getElementById('notifSoundSelect');
                if (sel) sel.value = currentPack;
            }
            drawer.classList.remove('hidden');
            if (btn) {
                btn.classList.add('bg-cyan-500/20', 'text-cyan-300');
                btn.classList.remove('text-indigo-300');
            }
        } else {
            drawer.classList.add('hidden');
            if (btn) {
                btn.classList.remove('bg-cyan-500/20', 'text-cyan-300');
                btn.classList.add('text-indigo-300');
            }
        }
    }

    function toggleNotifPanel() {
        const panel = document.getElementById('notifPanel');
        const backdrop = document.getElementById('notifBackdrop');
        const drawer = document.getElementById('notifSettingsDrawer');
        const btn = document.getElementById('notifSettingsBtn');
        if (!panel || !backdrop) return;
        const isOpen = !panel.classList.contains('translate-x-full');
        if (isOpen) {
            panel.classList.add('translate-x-full');
            backdrop.classList.add('hidden');
            if (drawer) drawer.classList.add('hidden');
            if (btn) {
                btn.classList.remove('bg-cyan-500/20', 'text-cyan-300');
                btn.classList.add('text-indigo-300');
            }
        } else {
            panel.classList.remove('translate-x-full');
            backdrop.classList.remove('hidden');
            if (window.NotificationHub) {
                window.NotificationHub.loadNotifications('notifPanelList', true);
            }
        }
    }
</script>