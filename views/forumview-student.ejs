                                <button type="button" id="modalTopReplyBtn" onclick="focusReplyBox()" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl border border-slate-200 hover:border-cyan-400 hover:bg-cyan-50 text-xs font-bold text-slate-700 hover:text-cyan-700 transition cursor-pointer shadow-2xs">
                                    <i class="fas fa-plus text-[10px]"></i> Reply
                                </button>
