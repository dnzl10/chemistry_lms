                                <i class="fas fa-paperclip text-cyan-600"></i>
                                <span>Files & Media</span>
                            </span>
                            <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-600">
                                <span id="shelfFilesCount">0</span>
                            </span>
                        </h4>

                        <!-- Files List -->
                        <div id="shelfFilesList" class="space-y-2">
                            <!-- Injected dynamically via renderShelfFiles -->
                        </div>
                    </div>

                    <!-- Contributors Section -->
                    <div class="pt-5 border-t border-slate-100">
                        <h5 class="text-xs font-black uppercase tracking-wider text-slate-500 mb-3 flex items-center justify-between">
                            <span class="flex items-center gap-1.5">
                                <i class="fas fa-users text-cyan-600"></i>
                                <span>Contributors</span>
                            </span>
                            <span class="px-2 py-0.5 rounded-full text-[11px] font-bold bg-slate-100 text-slate-600">
                                <span id="threadContributorsCount">0</span>
                            </span>
                        </h5>

                        <!-- Overlapping Avatar Row -->
                        <div id="threadContributorsAvatars" class="flex items-center -space-x-1.5 mb-3.5 overflow-hidden">
                            <!-- Injected dynamically -->
