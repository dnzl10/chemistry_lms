                        <div class="flex items-center justify-between mb-2">
                            <span class="text-[10px] font-extrabold uppercase tracking-widest text-cyan-300 flex items-center gap-1">
                                <i class="fas fa-trophy text-amber-400"></i> Forum Mission
                            </span>
                            <span class="inline-flex items-center gap-1 text-[11px] font-bold text-amber-300 bg-amber-400/15 border border-amber-400/30 px-2 py-0.5 rounded-full shadow-2xs">
                                <i class="fas fa-bolt text-amber-400"></i> <%= (typeof expPreview !== 'undefined' && expPreview && expPreview.expToAward) ? expPreview.expToAward : ((forum && forum.base_exp) ? forum.base_exp : 50) %> EXP
                            </span>
