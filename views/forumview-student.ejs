        // ── Intelligent Chemical Formula & Equation Auto-Formatter ───────────
        function formatChemicalFormula(raw) {
            if (!raw) return '';
            let str = raw.trim();

            // If user already entered HTML with sub or sup, don't double encode
            if (str.includes('<sub>') || str.includes('<sup>')) {
                return str;
            }

            // 1. Convert reaction arrows and equilibrium symbols
            str = str.replace(/<==>|<=>|<->|&rightleftharpoons;/g, ' ⇌ ');
            str = str.replace(/-->|->|&rarr;/g, ' → ');

            // 2. Protect state of matter notation: (s), (l), (g), (aq)
            const stateMap = {};
            let stateIdx = 0;
            str = str.replace(/\((s|l|g|aq)\)/gi, (match) => {
                const key = `__CHEM_STATE_${stateIdx++}__`;
                stateMap[key] = match.toLowerCase();
                return key;
            });

            // 3. Convert explicit caret superscripts (e.g., ^2+, ^2-, ^+, ^-, ^2, ^3)
            str = str.replace(/\^([0-9]*[+-]|[+-][0-9]*|[0-9]+)/g, '<sup>$1</sup>');

            // 4. Convert numbers following letters or closing parentheses to subscripts
            // e.g. H2O -> H₂O, CaCO3 -> CaCO₃, (NH4)2SO4 -> (NH₄)₂SO₄
            str = str.replace(/([A-Za-z\)])([0-9]+)/g, '$1<sub>$2</sub>');

            // 5. Restore states of matter
            Object.keys(stateMap).forEach(key => {
                str = str.replace(key, stateMap[key]);
            });

            return str;
        }

