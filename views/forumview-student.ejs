                                            <button type="button" onclick="insertChemSymbol('₃')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-xs font-mono text-slate-700 transition cursor-pointer" title="Subscript 3">₃</button>
                                            <button type="button" onclick="insertChemSymbol('₄')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-xs font-mono text-slate-700 transition cursor-pointer" title="Subscript 4">₄</button>
