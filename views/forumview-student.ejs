    </div>

    <!-- Notification Toast Container -->
    <div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Client-Side Controller Scripts -->
    <script>
        function escHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        // ── Layout Controllers ───────────────────────────────────────────────
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const main = document.getElementById('mainContent');
            const header = document.querySelector('header');
            
            if (window.innerWidth < 768) {
                sidebar.classList.toggle('sidebar-open');
                sidebar.classList.toggle('sidebar-collapsed');
                overlay.classList.toggle('hidden');
            } else {
                sidebar.classList.toggle('sidebar-collapsed');
                if (main) main.classList.toggle('sidebar-collapsed-main');
                if (header) header.classList.toggle('sidebar-collapsed-header');
            }
        }

        function toggleNotifications() {
            const panel = document.getElementById('notification-panel');
            const overlay = document.getElementById('notification-overlay');

            if (!panel || !overlay) return;

            if (panel.classList.contains('translate-x-full')) {
                panel.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.add('opacity-100'), 10);
                if (window.NotificationHub) {
                    NotificationHub.loadNotifications('notification-list', false);
                }
            } else {
                panel.classList.add('translate-x-full');
                overlay.classList.remove('opacity-100');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function toggleUserMenu(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('userMenuBtn');
            const isExpanded = !dropdown.classList.contains('hidden');
            dropdown.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', !isExpanded);
        }

        window.addEventListener('click', function() {
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('userMenuBtn');
            if (dropdown && !dropdown.classList.contains('hidden')) {
                dropdown.classList.add('hidden');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
            closeAllActionDropdowns();
        });

        // ── Mark as Done Toggle ──────────────────────────────────────────────
        async function toggleForumDone(forumId) {
            const btn = document.getElementById('markDoneBtn');
            const icon = document.getElementById('markDoneIcon');
            const text = document.getElementById('markDoneText');

            try {
                const res = await fetch('/api/forum-done', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ forum_id: forumId })
                });
                const data = await res.json();

                if (data.success) {
                    if (data.is_done) {
                        btn.className = "status-badge done cursor-pointer";
                        icon.className = "fas fa-check-circle text-xs";
                        text.textContent = "Done";
                        showToast('Forum marked as completed! 🎉', 'success');
                        const pill = document.getElementById('statStatusPill');
                        if (pill) {
                            pill.className = "text-xs font-black px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-700";
                            pill.textContent = "Completed";
                        }
                        const bar = document.getElementById('statProgressBar');
                        if (bar) bar.style.width = "100%";
                    } else {
                        btn.className = "status-badge not-done cursor-pointer";
                        icon.className = "fas fa-circle text-xs";
                        text.textContent = "Mark as Done";
                        showToast('Forum marked as not completed.', 'info');
                        const pill = document.getElementById('statStatusPill');
                        if (pill) {
                            pill.className = "text-xs font-black px-2 py-0.5 rounded-full bg-amber-100 text-amber-700";
                            pill.textContent = "Action Required";
                        }
                        const bar = document.getElementById('statProgressBar');
                        if (bar) bar.style.width = "35%";
                    }
                }
            } catch (err) {
                console.error('Failed to toggle forum done status:', err);
                showToast('Unable to update completion status.', 'error');
            }
        }

        // ── Search & Filter Logic ────────────────────────────────────────────
        let currentFilter = 'all';

        function handleSearch(query) {
            const clearBtn = document.getElementById('clearSearchBtn');
            const q = (query || '').toLowerCase().trim();
            clearBtn.classList.toggle('hidden', q.length === 0);

            const rows = document.querySelectorAll('.discussion-row');
            const cards = document.querySelectorAll('.discussion-card');
            let matchCount = 0;

            rows.forEach(row => {
                const title = row.getAttribute('data-title') || '';
                const author = row.getAttribute('data-author') || '';
                const isStarred = row.getAttribute('data-starred') === '1';
                const isHidden = row.getAttribute('data-hidden') === '1';

                const matchesFilter = currentFilter === 'all' || (currentFilter === 'starred' && isStarred);
                const matchesSearch = !q || title.includes(q) || author.includes(q);

                if (!isHidden && matchesFilter && matchesSearch) {
                    row.classList.remove('hidden');
                    matchCount++;
                } else {
                    row.classList.add('hidden');
                }
            });

            cards.forEach(card => {
                const title = card.getAttribute('data-title') || '';
                const author = card.getAttribute('data-author') || '';
                const isStarred = card.getAttribute('data-starred') === '1';

                const matchesFilter = currentFilter === 'all' || (currentFilter === 'starred' && isStarred);
                const matchesSearch = !q || title.includes(q) || author.includes(q);

                card.classList.toggle('hidden', !(matchesFilter && matchesSearch));
            });

            const noResults = document.getElementById('searchNoResults');
            noResults.classList.toggle('hidden', matchCount > 0 || rows.length === 0);
        }

        function clearSearch() {
            const input = document.getElementById('discussionSearch');
            input.value = '';
            handleSearch('');
        }

        function setFilter(filterType, btn) {
            currentFilter = filterType;
            document.querySelectorAll('.filter-pill').forEach(b => {
                b.className = "filter-pill px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-600 transition";
            });
            btn.className = "filter-pill active px-3 py-1 rounded-lg text-xs font-bold bg-cyan-600 text-white shadow-2xs transition";
            handleSearch(document.getElementById('discussionSearch').value);
        }

        // ── Action Ellipses Dropdown ─────────────────────────────────────────
        function toggleActionDropdown(event, id) {
            event.stopPropagation();
            const dropdown = document.getElementById('dropdown-' + id);
            if (!dropdown) return;
            const isHidden = dropdown.classList.contains('hidden');
            closeAllActionDropdowns();
            if (isHidden) dropdown.classList.remove('hidden');
        }

        function closeAllActionDropdowns() {
            document.querySelectorAll('.dropdown-menu').forEach(el => el.classList.add('hidden'));
        }

        // ── Star / Bookmark Toggle ───────────────────────────────────────────
        async function toggleStarDiscussion(replyId, btn) {
            try {
                const res = await fetch(`/api/forum-reply/${replyId}/star`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    const row = document.getElementById('topic-row-' + replyId);
                    if (row) row.setAttribute('data-starred', data.is_starred ? '1' : '0');

                    document.querySelectorAll(`.discussion-row[data-id="${replyId}"] .star-btn`).forEach(starBtn => {
                        starBtn.className = `star-btn w-9 h-9 rounded-xl flex items-center justify-center transition ${data.is_starred ? 'bg-amber-50 text-amber-500 border border-amber-200' : 'bg-slate-50 text-slate-400 hover:text-amber-500 border border-slate-200'}`;
                    });

                    // Update count
                    const countStarredEl = document.getElementById('countStarred');
                    if (countStarredEl) {
                        let current = parseInt(countStarredEl.textContent, 10) || 0;
                        countStarredEl.textContent = data.is_starred ? current + 1 : Math.max(0, current - 1);
                    }

                    showToast(data.is_starred ? 'Discussion topic starred! ⭐' : 'Removed from starred discussions.', 'info');
                }
            } catch (err) {
                console.error('Star toggle failed:', err);
            }
        }

        // ── Hide For Me ──────────────────────────────────────────────────────
        async function hideDiscussion(replyId, btn) {
            if (!confirm('Hide this discussion from your view? You can still access other forum topics.')) return;
            try {
                const res = await fetch(`/api/forum-reply/${replyId}/hide`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    const row = document.getElementById('topic-row-' + replyId);
                    const card = document.getElementById('mobile-card-' + replyId);
                    if (row) {
                        row.style.transition = 'all 0.3s ease';
                        row.style.opacity = '0';
                        setTimeout(() => row.remove(), 300);
                    }
                    if (card) card.remove();
                    showToast('Discussion hidden from your view.', 'info');
                }
            } catch (err) {
                console.error('Hide failed:', err);
            }
        }

        // ══════════════════════════════════════════════════════════════════════
        // 📌 DYNAMIC MODAL Z-INDEX & DISPLAY LAYERING MANAGER
        // ══════════════════════════════════════════════════════════════════════
        let currentModalZIndex = 1000;
        let openModalsStack = [];
        const ALL_MODAL_IDS = [
            'discussionModal',
            'newTopicModal',
            'safeguardModal',
            'customIndentModal',
            'linkInsertModal',
            'mediaInsertModal',
            'directRecordModal',
            'equationEditorModal',
            'characterMapModal',
            'tableConfigModal',
            'reportModal'
        ];

        function bringModalToFront(modal) {
            if (!modal) return;
            const el = typeof modal === 'string' ? document.getElementById(modal) : modal;
            if (!el) return;
            currentModalZIndex += 10;
            el.style.zIndex = currentModalZIndex;
            openModalsStack = openModalsStack.filter(m => m !== el);
            openModalsStack.push(el);
        }

        function removeModalFromStack(modal) {
            const el = typeof modal === 'string' ? document.getElementById(modal) : modal;
            if (!el) return;
            openModalsStack = openModalsStack.filter(m => m !== el);
        }

        function getTopmostActiveModal() {
            return openModalsStack.length > 0 ? openModalsStack[openModalsStack.length - 1] : null;
        }

        function handleModalBackdropClick(id) {
            if (id === 'safeguardModal') closeSafeguardModal();
            else if (id === 'newTopicModal') checkDirtyAndClose();
            else if (id === 'discussionModal') closeDiscussionModal();
            else if (id === 'customIndentModal') closeCustomIndentModal();
            else if (id === 'linkInsertModal') closeLinkInsertModal();
            else if (id === 'mediaInsertModal') closeMediaInsertModal();
            else if (id === 'directRecordModal') closeDirectRecordModal();
            else if (id === 'equationEditorModal') closeEquationEditorModal();
            else if (id === 'characterMapModal') closeCharacterMapModal();
            else if (id === 'tableConfigModal') closeTableConfigModal();
            else if (id === 'reportModal') closeReportModal();
        }

        // Initialize listeners and MutationObserver so whenever any modal is triggered or clicked,
        // it is brought to the absolute top of the visual stack.
        document.addEventListener('DOMContentLoaded', () => {
            const observer = new MutationObserver(mutations => {
                mutations.forEach(mutation => {
                    if (mutation.attributeName === 'class') {
                        const target = mutation.target;
                        if (!target.classList.contains('hidden')) {
                            bringModalToFront(target);
                        } else {
                            removeModalFromStack(target);
                        }
                    }
                });
            });

            ALL_MODAL_IDS.forEach(id => {
                const el = document.getElementById(id);
                if (el) {
                    el.addEventListener('mousedown', (e) => {
                        bringModalToFront(el);
                        if (e.target === el) {
                            handleModalBackdropClick(id);
                        }
                    });
                    observer.observe(el, { attributes: true, attributeFilter: ['class'] });
                }
            });

            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' || e.key === 'Esc') {
                    const topModal = getTopmostActiveModal();
                    if (topModal && !topModal.classList.contains('hidden')) {
                        handleModalBackdropClick(topModal.id);
                    }
                }
            });
        });

        // ── Report Modal Logic ───────────────────────────────────────────────
        function openReportModal(replyId) {
            bringModalToFront('reportModal');
            document.getElementById('reportReplyId').value = replyId;
            document.getElementById('reportReason').value = '';
            document.getElementById('reportDetails').value = '';
            document.getElementById('reportModal').classList.remove('hidden');
        }

        function closeReportModal() {
            document.getElementById('reportModal').classList.add('hidden');
            removeModalFromStack('reportModal');
        }

        async function submitReport(e) {
            e.preventDefault();
            const replyId = document.getElementById('reportReplyId').value;
            const reason = document.getElementById('reportReason').value;
            const details = document.getElementById('reportDetails').value;

            try {
                const res = await fetch(`/api/forum-reply/${replyId}/report`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason, details })
                });
                const data = await res.json();
                if (data.success) {
                    closeReportModal();
                    showToast('Report submitted. Thank you for your feedback.', 'success');
                } else {
                    alert(data.error || 'Failed to submit report.');
                }
            } catch (err) {
                console.error('Report submission error:', err);
            }
        }

        // ── Toast Notification Helper ────────────────────────────────────────
        function showToast(msg, type = 'info') {
            const container = document.getElementById('toastContainer');
            if (!container) return;
            const toast = document.createElement('div');
            let bgClass = 'bg-slate-900 text-white';
            let iconHtml = '<i class="fas fa-info-circle text-cyan-400"></i>';
            if (type === 'success') {
                bgClass = 'bg-emerald-600 text-white';
                iconHtml = '<i class="fas fa-circle-check text-white"></i>';
            } else if (type === 'error') {
                bgClass = 'bg-rose-600 text-white';
                iconHtml = '<i class="fas fa-circle-xmark text-white"></i>';
            } else if (type === 'warning') {
                bgClass = 'bg-amber-600 text-white shadow-amber-500/30';
                iconHtml = '<i class="fas fa-triangle-exclamation text-amber-100"></i>';
            }
            toast.className = `${bgClass} px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 pointer-events-auto transform transition-all duration-300 translate-y-4 opacity-0 z-50`;
            toast.innerHTML = `${iconHtml}<span>${msg}</span>`;
            container.appendChild(toast);
            setTimeout(() => {
                toast.classList.remove('translate-y-4', 'opacity-0');
            }, 10);
            setTimeout(() => {
                toast.classList.add('translate-y-4', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3800);
        }

        // ══════════════════════════════════════════════════════════════════════
        // 📌 PHASE 4: DISCUSSION VIEWER MODAL CONTROLLER
        // ══════════════════════════════════════════════════════════════════════
        const CURRENT_STUDENT_ID = <%= user ? (user.id || user.user_id || 0) : 0 %>;
        const IS_FORUM_EXPIRED = <%= (typeof isExpired !== 'undefined' && isExpired) ? 'true' : 'false' %>;
        let activeDiscussionData = null;

        let isModalFullscreen = false; // Floating centered workbench by default

        function applyModalScreenState(fullscreen) {
            const modal = document.getElementById('discussionModal');
            const container = document.getElementById('discussionModalContainer');
            const icon = document.getElementById('modalFullscreenIcon');
            const btn = document.getElementById('modalFullscreenBtn');
            if (!container || !modal) return;

            isModalFullscreen = !!fullscreen;
            if (isModalFullscreen) {
                modal.classList.remove('p-3', 'md:p-6', 'lg:p-8', 'p-2', 'md:p-3');
                modal.classList.add('p-0');

                container.classList.remove('max-w-6xl', 'xl:max-w-7xl', 'h-[92vh]', 'rounded-[28px]', 'border', 'border-slate-200/90', 'shadow-2xl');
                container.classList.add('w-full', 'h-full', 'max-w-none', 'rounded-none', 'border-0', 'shadow-none');

                if (icon) icon.className = "fas fa-compress-alt text-xs";
                if (btn) btn.title = "Restore window size";
            } else {
                modal.classList.remove('p-0', 'p-2', 'md:p-3');
                modal.classList.add('p-3', 'md:p-6', 'lg:p-8');

                container.classList.remove('w-full', 'h-full', 'max-w-none', 'rounded-none', 'border-0', 'shadow-none');
                container.classList.add('w-full', 'max-w-6xl', 'xl:max-w-7xl', 'h-[92vh]', 'rounded-[28px]', 'border', 'border-slate-200/90', 'shadow-2xl');

                if (icon) icon.className = "fas fa-expand-alt text-xs";
                if (btn) btn.title = "Full screen";
            }
        }

        function toggleModalFullscreen() {
            applyModalScreenState(!isModalFullscreen);
        }

        // Global Escape key listener to dismiss discussion modal
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') {
                const modal = document.getElementById('discussionModal');
                if (modal && !modal.classList.contains('hidden')) {
                    closeDiscussionModal();
                }
            }
        });

        async function openDiscussionModal(replyId) {
            const modal = document.getElementById('discussionModal');
            const loading = document.getElementById('modalLoadingState');
            const content = document.getElementById('modalRootContent');
            
            // Default to elevated floating workbench dialog
            applyModalScreenState(false);

            bringModalToFront(modal);
            modal.classList.remove('hidden');
            loading.classList.remove('hidden');
            content.classList.add('hidden');
            cancelReplyTarget();

            try {
                const res = await fetch(`/api/forum-discussion/${replyId}`);
                const data = await res.json();

                if (!data.success) {
                    alert(data.error || 'Could not load discussion.');
                    closeDiscussionModal();
                    return;
                }

                activeDiscussionData = data;
                populateDiscussionModal(data);

                loading.classList.add('hidden');
                content.classList.remove('hidden');

            } catch (err) {
                console.error('Failed to load discussion:', err);
                showToast('Network error while opening discussion.', 'error');
                closeDiscussionModal();
            }
        }

        function closeDiscussionModal() {
            const modal = document.getElementById('discussionModal');
            if (modal) modal.classList.add('hidden');
            removeModalFromStack('discussionModal');
            activeDiscussionData = null;
            applyModalScreenState(false);
        }

        function populateDiscussionModal(data) {
            const root = data.rootTopic;
            const isClosed = Boolean(root.is_closed || IS_FORUM_EXPIRED);

            // Closed / Read-Only Header Badge
