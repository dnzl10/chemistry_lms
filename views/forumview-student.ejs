                    month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true
                }).replace(',', ' at');
            }

            const headerEndorsed = document.getElementById('modalHeaderEndorsedBadge');
            if (headerEndorsed) {
                if (root.is_endorsed) headerEndorsed.classList.remove('hidden');
                else headerEndorsed.classList.add('hidden');
