                                            <button type="button" onclick="insertChemSymbol('⁻')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-xs font-mono text-slate-700 transition cursor-pointer" title="Negative charge">⁻</button>
                                            <button type="button" onclick="insertChemSymbol('²⁺')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-xs font-mono text-slate-700 transition cursor-pointer" title="2+ ion">²⁺</button>
                                            <button type="button" onclick="insertChemSymbol('²⁻')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-xs font-mono text-slate-700 transition cursor-pointer" title="2- ion">²⁻</button>
                                            <button type="button" onclick="insertChemSymbol('³⁺')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-xs font-mono text-slate-700 transition cursor-pointer" title="3+ ion">³⁺</button>
