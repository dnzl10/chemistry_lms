                                        <div class="flex items-center gap-3">
                                            <!-- Styled Anonymous Toggle -->
                                            <label class="inline-flex items-center gap-1.5 cursor-pointer text-xs font-medium text-slate-500 hover:text-slate-700 select-none py-1 px-2 rounded-lg hover:bg-slate-50 transition" title="Hide your name from classmates. Visible to teacher for grading.">
