                        <p class="text-xs text-slate-200 font-medium mb-3 leading-snug">
                            <%= (typeof expPreview !== 'undefined' && expPreview && expPreview.tierTitle) ? expPreview.tierTitle : 'Participate constructively to earn forum participation EXP.' %>
                        </p>
                        <div class="pt-2.5 border-t border-white/10 flex items-center justify-between text-[11px] text-slate-300 font-medium">
                            <span class="inline-flex items-center gap-1">
                                <i class="far fa-calendar-alt text-slate-400"></i>
                                <span><%= (forum && forum.due_date) ? new Date(forum.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) : 'No Deadline' %></span>
                            </span>
                            <span id="railParticipationStatus">
                                <% if ((typeof hasPosted !== 'undefined' && hasPosted) || (forum && forum.is_done)) { %>
                                    <span class="inline-flex items-center gap-1 text-emerald-300 font-bold">
                                        <i class="fas fa-circle-check text-emerald-400"></i> Requirement Met
                                    </span>
                                <% } else { %>
                                    <span class="inline-flex items-center gap-1 text-amber-300 font-bold">
                                        <i class="fas fa-pen-nib text-amber-300"></i> 1 Reply Needed
