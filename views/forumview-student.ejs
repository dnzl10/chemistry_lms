        // ── Clipboard Paste Sanitizer (Strip Word / Office Bloat) ────────────
        function sanitizePastedHtml(html) {
            let clean = html.replace(/<!--[\s\S]*?-->/gi, '');
            clean = clean.replace(/<style[\s\S]*?<\/style>/gi, '');
            clean = clean.replace(/<xml[\s\S]*?<\/xml>/gi, '');
            clean = clean.replace(/<meta[\s\S]*?>/gi, '');
            clean = clean.replace(/<link[\s\S]*?>/gi, '');

            const doc = new DOMParser().parseFromString(clean, 'text/html');
            const allowedTags = new Set([
                'P', 'BR', 'B', 'STRONG', 'I', 'EM', 'U', 'S', 'STRIKE',
                'SUB', 'SUP', 'H1', 'H2', 'H3', 'H4', 'BLOCKQUOTE', 'PRE', 'CODE',
                'UL', 'OL', 'LI', 'TABLE', 'THEAD', 'TBODY', 'TR', 'TH', 'TD', 'A', 'IMG'
            ]);

            function cleanNode(node) {
                const children = Array.from(node.childNodes);
                for (const child of children) {
                    if (child.nodeType === Node.ELEMENT_NODE) {
                        if (!allowedTags.has(child.tagName)) {
                            while (child.firstChild) {
                                node.insertBefore(child.firstChild, child);
                            }
                            node.removeChild(child);
                        } else {
                            child.removeAttribute('style');
                            child.removeAttribute('class');
                            if (child.tagName === 'A') {
                                const href = child.getAttribute('href') || '';
                                if (!href.startsWith('http://') && !href.startsWith('https://') && !href.startsWith('/')) {
                                    child.removeAttribute('href');
                                } else {
                                    child.setAttribute('target', '_blank');
                                    child.setAttribute('rel', 'noopener noreferrer');
                                    child.className = 'text-cyan-600 font-bold hover:underline';
                                }
                            }
                            cleanNode(child);
                        }
                    }
                }
            }

            cleanNode(doc.body);
            return doc.body.innerHTML;
        }

        function updateEditorWordCount() {
            const text = (document.getElementById('editorArea').innerText || '').trim();
            const words = text ? text.split(/\s+/).length : 0;
            const chars = text.length;
            document.getElementById('editorWordCount').textContent = `${words} words · ${chars} chars`;
        }

        document.addEventListener('DOMContentLoaded', () => {
            const editor = document.getElementById('editorArea');
            if (editor) {
                editor.addEventListener('input', () => {
                    checkEditorEmptyState();
                    updateEditorWordCount();
                    triggerDraftAutoSave();
                });
                editor.addEventListener('blur', checkEditorEmptyState);
                editor.addEventListener('paste', (e) => {
                    e.preventDefault();
                    const clipboard = e.clipboardData || window.clipboardData;
                    if (!clipboard) return;

                    const html = clipboard.getData('text/html');
                    const text = clipboard.getData('text/plain');

                    if (html && html.trim().length > 0) {
                        const sanitized = sanitizePastedHtml(html);
                        document.execCommand('insertHTML', false, sanitized);
                    } else if (text) {
                        document.execCommand('insertText', false, text);
                    }

                    checkEditorEmptyState();
                    updateEditorWordCount();
                    triggerDraftAutoSave();
                    saveEditorSelection();
                });
                editor.addEventListener('keyup', saveEditorSelection);
                editor.addEventListener('mouseup', saveEditorSelection);
                editor.addEventListener('touchend', saveEditorSelection);
                checkEditorEmptyState();
            }

            const extLinkInput = document.getElementById('editorExternalLink');
            if (extLinkInput) {
                extLinkInput.addEventListener('input', triggerDraftAutoSave);
            }
            const anonBox = document.getElementById('topicIsAnonymous');
            if (anonBox) {
                anonBox.addEventListener('change', triggerDraftAutoSave);
            }

            // Keyboard Shortcuts: Ctrl+Enter (Publish) & Escape (Safe Dismissal)
            document.addEventListener('keydown', (e) => {
                const newTopicModal = document.getElementById('newTopicModal');
                if (!newTopicModal || newTopicModal.classList.contains('hidden')) return;

                // Instant Publish on Ctrl+Enter or Cmd+Enter
                if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') {
                    const postBtn = document.getElementById('postTopicBtn');
                    if (postBtn && !postBtn.disabled) {
                        e.preventDefault();
                        postBtn.click();
                        return;
                    }
                }

                // Hierarchical Escape Dismissal
                if (e.key === 'Escape') {
                    const activeSubModals = [
                        { id: 'safeguardModal', close: closeSafeguardModal },
                        { id: 'linkInsertModal', close: closeLinkInsertModal },
                        { id: 'mediaInsertModal', close: closeMediaInsertModal },
                        { id: 'directRecordModal', close: closeDirectRecordModal },
                        { id: 'equationEditorModal', close: closeEquationEditorModal },
                        { id: 'characterMapModal', close: closeCharacterMapModal },
                        { id: 'tableConfigModal', close: closeTableConfigModal }
                    ];

                    for (const sub of activeSubModals) {
                        const el = document.getElementById(sub.id);
                        if (el && !el.classList.contains('hidden')) {
                            e.preventDefault();
                            sub.close();
                            return;
                        }
                    }

                    const emojiPopover = document.getElementById('emojiPickerPopover');
                    if (emojiPopover && !emojiPopover.classList.contains('hidden')) {
                        e.preventDefault();
                        emojiPopover.classList.add('hidden');
                        return;
                    }

                    e.preventDefault();
                    checkDirtyAndClose();
                }
            });
        });

