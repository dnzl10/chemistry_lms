                            <div class="flex items-start gap-3">
                                <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" class="w-9 h-9 rounded-full object-cover ring-2 ring-slate-100 shadow-2xs flex-shrink-0 mt-1" alt="<%= user.name %>" onerror="this.onerror=null;this.src='/profile_uploads/default_avatar.png';">
                                <div class="flex-1 bg-white border border-slate-200/90 rounded-2xl p-3 shadow-xs focus-within:ring-2 focus-within:ring-cyan-500/30 focus-within:border-cyan-500 transition">
                                    
                                    <!-- Chemistry Formula Quick-Bar (Collapsible) -->
                                    <div id="chemSymbolsToolbar" class="hidden pb-2.5 mb-2.5 border-b border-slate-100 flex flex-wrap items-center gap-1.5 transition-all">
                                        <span class="text-[10px] uppercase font-bold text-slate-400 mr-0.5 select-none flex items-center gap-1">
                                            <i class="fas fa-atom text-cyan-600"></i> Chem:
                                        </span>
                                        <!-- Reactions -->
                                        <div class="inline-flex items-center gap-1 border-r border-slate-200 pr-1.5">
                                            <button type="button" onclick="insertChemSymbol('⇌')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-xs font-mono text-slate-700 transition cursor-pointer" title="Equilibrium arrow">⇌</button>
                                            <button type="button" onclick="insertChemSymbol('→')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-xs font-mono text-slate-700 transition cursor-pointer" title="Yields arrow">→</button>
                                            <button type="button" onclick="insertChemSymbol('⇄')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-xs font-mono text-slate-700 transition cursor-pointer" title="Reversible arrow">⇄</button>
                                            <button type="button" onclick="insertChemSymbol('Δ')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-xs font-mono text-slate-700 transition cursor-pointer" title="Delta / Heat">Δ</button>
                                        </div>
