                        </div>
                    </div>

                    <!-- Thread Reply Composer Box (Pinned at bottom, matching UI Modal Design.jpg) -->
                    <div id="threadComposerContainer" class="p-4 md:p-5 bg-white border-t border-slate-200/80 flex-shrink-0 relative shadow-xs">
