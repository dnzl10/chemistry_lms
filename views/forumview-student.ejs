        // Render Right Shelf Files (matching UI Modal Design.jpg cards with color-coded badges & download link)
        function renderShelfFiles(files) {
            const shelf = document.getElementById('shelfFilesList');
            const countEl = document.getElementById('shelfFilesCount');
            if (countEl) countEl.textContent = files ? files.length : 0;

            if (!files || files.length === 0) {
                shelf.innerHTML = `
                    <div class="py-6 px-4 rounded-xl border border-dashed border-slate-200/90 text-center text-xs text-slate-400 bg-slate-50/50 flex flex-col items-center justify-center space-y-1.5">
                        <i class="far fa-folder-open text-xl text-slate-300"></i>
                        <span class="font-medium text-slate-500">No attachments in thread</span>
                        <span class="text-[10px] text-slate-400">Files and images uploaded by contributors will appear here</span>
                    </div>
                `;
                return;
            }

            let html = '';
            files.forEach(f => {
                const ext = (f.file_path ? f.file_path.split('.').pop() : '').toLowerCase();
                let badgeClass = 'bg-slate-100 text-slate-600 border border-slate-200';
                let iconContent = '<i class="far fa-file"></i>';
                let typeLabel = 'Attachment';

                if (['pdf'].includes(ext)) {
                    badgeClass = 'bg-rose-50 text-rose-600 border border-rose-200';
                    iconContent = '<i class="far fa-file-pdf"></i>';
                    typeLabel = 'PDF Document';
                } else if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext)) {
                    badgeClass = 'bg-emerald-50 text-emerald-600 border border-emerald-200';
                    iconContent = '<i class="far fa-image"></i>';
                    typeLabel = 'Image File';
                } else if (['mp3', 'wav', 'ogg', 'webm', 'm4a'].includes(ext)) {
                    badgeClass = 'bg-indigo-50 text-indigo-600 border border-indigo-200';
                    iconContent = '<i class="fas fa-volume-up"></i>';
                    typeLabel = 'Audio Clip';
                } else if (['xls', 'xlsx', 'csv'].includes(ext)) {
                    badgeClass = 'bg-emerald-50 text-emerald-700 border border-emerald-200';
                    iconContent = '<i class="far fa-file-excel"></i>';
                    typeLabel = 'Spreadsheet';
                } else if (['doc', 'docx'].includes(ext)) {
                    badgeClass = 'bg-blue-50 text-blue-600 border border-blue-200';
                    iconContent = '<i class="far fa-file-word"></i>';
                    typeLabel = 'Word Doc';
