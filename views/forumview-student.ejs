        // Render Contributors (with verified faculty distinction and contribution counts)
        function renderContributors(root, subReplies) {
            const avatarRow = document.getElementById('threadContributorsAvatars');
            const list = document.getElementById('threadContributorsList');
            const countEl = document.getElementById('threadContributorsCount');
            
            const uniqueUsers = [];
            const seenIds = new Set();
            const seenNames = new Set();

            function addUniqueContributor(userId, userName, userPic, role, isOp = false) {
                if (!userName || !userName.trim()) return;
                const cleanName = userName.trim();
                const normName = cleanName.toLowerCase();
                const normId = (userId !== undefined && userId !== null && userId !== '') ? String(userId) : null;
                const key = normId || normName;

                const existing = uniqueUsers.find(u => (normId && u.id === normId) || u.name.toLowerCase() === normName);
                if (existing) {
                    existing.postCount++;
                    if (!existing.role && role) existing.role = role;
                    if (isOp) existing.isOp = true;
                    return;
                }

                uniqueUsers.push({
                    id: key,
                    name: cleanName,
                    pic: (userPic && userPic.trim()) ? userPic.trim() : 'default_avatar.png',
                    role: role || 'student',
                    isOp: Boolean(isOp),
                    postCount: 1
                });
            }

            // 1. Register root topic author (Original Poster)
            if (root) {
                const rootId = root.author_id || root.user_id;
                addUniqueContributor(rootId, root.author_name, root.author_pic, root.author_role || root.role || 'student', true);
            }

            // 2. Register each reply contributor
            if (Array.isArray(subReplies)) {
                subReplies.forEach(r => {
                    if (r) {
                        const replierId = r.user_id || r.author_id;
                        addUniqueContributor(replierId, r.user_name || r.author_name, r.profile_pic || r.author_pic, r.role || 'student', false);
                    }
                });
            }

            // Update contributor count indicator
            if (countEl) countEl.textContent = uniqueUsers.length;

            // 1. Overlapping avatars row (showing up to 5 avatars + overflow badge)
            if (avatarRow) {
                let avHtml = '';
                const maxAvatars = 5;
                const visibleUsers = uniqueUsers.slice(0, maxAvatars);
                const remaining = uniqueUsers.length - maxAvatars;

                visibleUsers.forEach(user => {
                    const pic = (user.pic && user.pic !== 'default_avatar.png')
                        ? '/profile_uploads/' + user.pic
                        : '/profile_uploads/default_avatar.png';
                    avHtml += `
                        <img src="${pic}" class="w-7 h-7 rounded-full object-cover ring-2 ring-white shadow-2xs flex-shrink-0 cursor-pointer hover:scale-110 transition duration-150" title="${escHtml(user.name)}" alt="${escHtml(user.name)}" onerror="this.onerror=null;this.src='/profile_uploads/default_avatar.png';">
                    `;
                });

                if (remaining > 0) {
                    avHtml += `
                        <span class="w-7 h-7 rounded-full bg-slate-800 text-white ring-2 ring-white shadow-2xs flex items-center justify-center text-[10px] font-bold flex-shrink-0 cursor-default" title="${remaining} more contributor(s)">
                            +${remaining}
                        </span>
                    `;
                }

                avatarRow.innerHTML = avHtml;
            }

            // 2. Individual contributor pill rows
            if (list) {
                let listHtml = '';
                uniqueUsers.forEach(user => {
                    const pic = (user.pic && user.pic !== 'default_avatar.png')
                        ? '/profile_uploads/' + user.pic
                        : '/profile_uploads/default_avatar.png';
                    const isInstructor = (user.role || '').toLowerCase() === 'teacher';
                    
                    listHtml += `
                        <div class="flex items-center justify-between p-2 rounded-xl bg-slate-50/70 border border-slate-200/70 hover:border-slate-300 transition">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <img src="${pic}" class="w-6 h-6 rounded-full object-cover ring-1 ring-slate-200 flex-shrink-0" onerror="this.onerror=null;this.src='/profile_uploads/default_avatar.png';">
                                <span class="text-xs font-semibold text-slate-700 truncate max-w-[110px]" title="${escHtml(user.name)}">
                                    ${escHtml(user.name)}
                                </span>
                            </div>
                            <div class="flex items-center gap-1.5 flex-shrink-0">
                                ${isInstructor 
                                    ? '<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200"><i class="fas fa-graduation-cap text-[9px]"></i> Faculty</span>' 
                                    : user.isOp 
                                        ? '<span class="inline-flex items-center gap-0.5 px-1.5 py-0.5 rounded text-[10px] font-bold bg-cyan-50 text-cyan-700 border border-cyan-200" title="Original Poster">OP</span>'
                                        : '<span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-white text-slate-500 border border-slate-200">Scholar</span>'}
                                <span class="px-1.5 py-0.5 rounded-full text-[10px] font-bold bg-slate-200/80 text-slate-600" title="${user.postCount} contribution(s)">
                                    ${user.postCount}
                                </span>
                            </div>
                        </div>
                    `;
                });
                list.innerHTML = listHtml;
            }
        }

        // ── Composer & Chemistry Formula Functions ─────────────────────────
        function focusReplyBox() {
            if (activeDiscussionData?.rootTopic?.is_closed || IS_FORUM_EXPIRED) {
                showToast('This discussion thread is closed. Further replies are locked.', 'warning');
                return;
            }
            const input = document.getElementById('replyTextInput');
            if (input) {
                input.focus();
                input.scrollIntoView({ behavior: 'smooth' });
            }
        }

        function toggleChemSymbolsToolbar() {
            const bar = document.getElementById('chemSymbolsToolbar');
            const btn = document.getElementById('chemToolbarToggleBtn');
            if (!bar) return;
            bar.classList.toggle('hidden');
            if (!bar.classList.contains('hidden')) {
                btn?.classList.add('bg-cyan-100', 'text-cyan-800');
                document.getElementById('replyTextInput')?.focus();
            } else {
                btn?.classList.remove('bg-cyan-100', 'text-cyan-800');
            }
        }

        function handleReplyInputGrow(el) {
            if (!el) return;
            el.style.height = 'auto';
            el.style.height = Math.min(el.scrollHeight, 220) + 'px';
        }

        function insertChemSymbol(symbol) {
            const textarea = document.getElementById('replyTextInput');
            if (!textarea) return;
            const start = textarea.selectionStart || 0;
            const end = textarea.selectionEnd || 0;
            const text = textarea.value;
            textarea.value = text.substring(0, start) + symbol + text.substring(end);
            textarea.selectionStart = textarea.selectionEnd = start + symbol.length;
            handleReplyInputGrow(textarea);
            textarea.focus();
        }

        function setReplyTarget(replyId, authorName) {
            if (activeDiscussionData?.rootTopic?.is_closed || IS_FORUM_EXPIRED) {
                showToast('This discussion thread is closed. Further replies are locked.', 'warning');
                return;
            }
            const parentInput = document.getElementById('replyTargetParentId');
            const nameEl = document.getElementById('replyingToName');
            const banner = document.getElementById('replyingToBanner');

            if (parentInput) parentInput.value = replyId;
            if (nameEl) nameEl.textContent = authorName;
            if (banner) banner.classList.remove('hidden');
            focusReplyBox();
        }

        function cancelReplyTarget() {
            const parentInput = document.getElementById('replyTargetParentId');
            const banner = document.getElementById('replyingToBanner');
            if (parentInput) parentInput.value = '';
            if (banner) banner.classList.add('hidden');
        }

        function handleReplyFileSelected(input) {
            if (input.files && input.files[0]) {
                const name = input.files[0].name;
                const nameSpan = document.getElementById('replySelectedFileName');
                const chip = document.getElementById('replySelectedChip');
                if (nameSpan) nameSpan.textContent = name;
                if (chip) chip.classList.remove('hidden');
            }
        }

        function removeReplyFile() {
            const input = document.getElementById('replyFileInput');
            if (input) input.value = '';
            const chip = document.getElementById('replySelectedChip');
            if (chip) chip.classList.add('hidden');
        }

        async function submitThreadReply(e) {
            e.preventDefault();
            if (!activeDiscussionData) return;

            if (activeDiscussionData.rootTopic?.is_closed || IS_FORUM_EXPIRED) {
                showToast('This discussion thread is closed. Further replies are locked.', 'warning');
                return;
            }

            const textInput = document.getElementById('replyTextInput');
            const fileInput = document.getElementById('replyFileInput');
            const parentIdInput = document.getElementById('replyTargetParentId');
            const submitBtn = document.getElementById('replySubmitBtn');

            const content = textInput.value.trim();
            if (!content) return;

            const parentId = parentIdInput.value || activeDiscussionData.rootTopic.reply_id;

            const isAnon = document.getElementById('replyIsAnonymous')?.checked || false;

            const formData = new FormData();
            formData.append('forum_id', activeDiscussionData.rootTopic.topic_id);
            formData.append('parent_reply_id', parentId);
            formData.append('reply_content', content);
            formData.append('is_anonymous', isAnon ? '1' : '0');
            if (fileInput.files && fileInput.files[0]) {
                formData.append('file', fileInput.files[0]);
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Posting...`;

            try {
                const res = await fetch('/api/forum-subreply', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (data.success) {
                    textInput.value = '';
                    textInput.style.height = 'auto';
                    const anonBox = document.getElementById('replyIsAnonymous');
                    if (anonBox) anonBox.checked = false;
                    removeReplyFile();
                    cancelReplyTarget();

                    // Reload thread data seamlessly
                    const refreshRes = await fetch(`/api/forum-discussion/${activeDiscussionData.rootTopic.reply_id}`);
                    const refreshData = await refreshRes.json();
                    if (refreshData.success) {
                        activeDiscussionData = refreshData;
                        renderRepliesTree(refreshData.subReplies || []);
                        renderShelfFiles(refreshData.files || []);
                        renderContributors(refreshData.rootTopic, refreshData.subReplies || []);

                        const railStatus = document.getElementById('railParticipationStatus');
                        if (railStatus) {
                            railStatus.innerHTML = `
                                <span class="inline-flex items-center gap-1 text-emerald-300 font-bold">
                                    <i class="fas fa-circle-check text-emerald-400"></i> Requirement Met
                                </span>
                            `;
                        }
                    }

                    showToast('Reply posted successfully!', 'success');
                } else {
                    if (data.isClosed) {
                        showToast(data.error || 'Discussion thread is closed.', 'warning');
                        document.getElementById('threadReplyForm')?.classList.add('hidden');
                        document.getElementById('threadClosedBanner')?.classList.remove('hidden');
                        document.getElementById('modalTopReplyBtn')?.classList.add('hidden');
                        document.getElementById('modalHeaderClosedBadge')?.classList.remove('hidden');
                    } else {
                        alert(data.error || 'Failed to post reply.');
                    }
                }
            } catch (err) {
                console.error('Failed to submit sub-reply:', err);
                showToast('Network error while posting reply.', 'error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = `<span>Post Reply</span><i class="fas fa-paper-plane text-[10px]"></i>`;
            }
        }

        // Toggle Like for Root Discussion
        async function toggleRootLike() {
            if (!activeDiscussionData) return;
            const rootId = activeDiscussionData.rootTopic.reply_id;

            try {
                const res = await fetch(`/api/forum-reply/${rootId}/like`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    const icon = document.getElementById('rootLikeIcon');
                    document.getElementById('rootLikeCount').textContent = data.like_count;
                }
            } catch (err) {
                console.error('Root like toggle error:', err);
            }
        }

        // Toggle Like for Sub-Replies
        async function toggleSubReplyLike(replyId, btn) {
            try {
                const res = await fetch(`/api/forum-reply/${replyId}/like`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    const icon = btn.querySelector('i');
                    const countSpan = btn.querySelector('.like-num');
                    if (countSpan) countSpan.textContent = data.like_count;
                    if (icon) {
                        icon.className = data.liked ? 'fas fa-heart text-rose-500' : 'far fa-heart text-slate-400';
                    }
                }
            } catch (err) {
                console.error('Sub-reply like toggle error:', err);
            }
        }

