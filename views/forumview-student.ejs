                html += `
                    <div class="group flex items-center justify-between gap-3 p-2.5 rounded-xl border border-slate-200/80 hover:border-cyan-300 hover:bg-cyan-50/20 bg-white transition shadow-2xs">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <div class="w-8 h-8 rounded-lg ${badgeClass} flex items-center justify-center text-xs flex-shrink-0">
                                ${iconContent}
                            </div>
                            <div class="min-w-0">
                                <p class="text-xs font-bold text-slate-800 truncate" title="${escHtml(f.file_name || 'File')}">${escHtml(f.file_name || typeLabel)}</p>
                                <p class="text-[10px] text-slate-400 truncate flex items-center gap-1">
                                    <span>${typeLabel}</span>
                                    <span>•</span>
                                    <span class="font-medium text-slate-500">${escHtml(f.author_name || 'User')}</span>
                                </p>
                            </div>
                        </div>
                        <a href="/forum_uploads/${encodeURIComponent(f.file_path)}" download="${escHtml(f.file_name)}" target="_blank" class="w-7 h-7 rounded-lg border border-slate-200 text-slate-500 hover:text-cyan-700 hover:bg-cyan-50 hover:border-cyan-300 flex items-center justify-center flex-shrink-0 transition" title="Download ${escHtml(f.file_name)}">
