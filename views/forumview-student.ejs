                            <i class="fas fa-comments"></i>
                        </div>
                        <div class="max-w-sm space-y-1">
                            <h5 class="text-sm font-bold text-slate-800">No responses yet</h5>
                            <p class="text-xs text-slate-500 leading-relaxed">Be the first to share your thoughts, ask questions, or provide insights below.</p>
                        </div>
                    </div>
                `;
                return;
            }

            let html = '';
            const isThreadClosed = Boolean(activeDiscussionData?.rootTopic?.is_closed || IS_FORUM_EXPIRED);
