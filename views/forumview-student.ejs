                    ? "text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800 border border-blue-200"
                    : "text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-700";
            }

            const rootEndorsedBadge = document.getElementById('rootEndorsedBadge');
