                <button type="button" onclick="insertSymbol('°C')" class="p-2 bg-slate-50 hover:bg-cyan-100 rounded-xl font-mono text-xs transition cursor-pointer">°C</button>
                <button type="button" onclick="insertSymbol('±')" class="p-2 bg-slate-50 hover:bg-cyan-100 rounded-xl transition cursor-pointer">±</button>
                <button type="button" onclick="insertSymbol('≈')" class="p-2 bg-slate-50 hover:bg-cyan-100 rounded-xl transition cursor-pointer">≈</button>
                <button type="button" onclick="insertSymbol('≠')" class="p-2 bg-slate-50 hover:bg-cyan-100 rounded-xl transition cursor-pointer">≠</button>
                <button type="button" onclick="insertSymbol('≤')" class="p-2 bg-slate-50 hover:bg-cyan-100 rounded-xl transition cursor-pointer">≤</button>
                <button type="button" onclick="insertSymbol('≥')" class="p-2 bg-slate-50 hover:bg-cyan-100 rounded-xl transition cursor-pointer">≥</button>
                <button type="button" onclick="insertSymbol('→')" class="p-2 bg-slate-50 hover:bg-cyan-100 rounded-xl transition cursor-pointer">→</button>
                <button type="button" onclick="insertSymbol('⇌')" class="p-2 bg-slate-50 hover:bg-cyan-100 rounded-xl transition cursor-pointer">⇌</button>
                <button type="button" onclick="insertSymbol('↑')" class="p-2 bg-slate-50 hover:bg-cyan-100 rounded-xl transition cursor-pointer">↑</button>
                <button type="button" onclick="insertSymbol('↓')" class="p-2 bg-slate-50 hover:bg-cyan-100 rounded-xl transition cursor-pointer">↓</button>
            </div>

            <div class="mt-4 flex justify-end">
                <button type="button" onclick="closeCharacterMapModal()" class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition cursor-pointer">Close</button>
            </div>
        </div>
    </div>

    <!-- Table Configuration Sub-Modal -->
    <div id="tableConfigModal" class="fixed inset-0 z-60 hidden flex items-center justify-center p-4 bg-slate-950/70 backdrop-blur-sm">
        <div class="bg-white rounded-3xl max-w-sm w-full p-6 shadow-2xl border border-slate-200/90 animate-in zoom-in-95 duration-150">
            <h4 class="text-sm font-black text-slate-900 mb-3 flex items-center gap-2">
                <i class="fas fa-table text-indigo-600"></i> Configure & Insert Table
            </h4>
            <div class="space-y-3 mb-4">
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">Rows</label>
                        <input type="number" id="tableRowsInput" value="3" min="1" max="15" class="w-full text-xs font-bold p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">Columns</label>
                        <input type="number" id="tableColsInput" value="3" min="1" max="8" class="w-full text-xs font-bold p-2.5 bg-slate-50 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500">
                    </div>
                </div>
                <div class="flex items-center gap-2 pt-1">
                    <input type="checkbox" id="tableHeaderToggle" checked class="w-4 h-4 rounded text-cyan-600 focus:ring-0 cursor-pointer">
                    <label for="tableHeaderToggle" class="text-xs font-bold text-slate-700 cursor-pointer">Include Header Row</label>
                </div>
            </div>
            <div class="flex justify-end gap-2">
                <button type="button" onclick="closeTableConfigModal()" class="px-4 py-2 text-xs font-bold text-slate-500 hover:bg-slate-100 rounded-xl transition cursor-pointer">Cancel</button>
                <button type="button" onclick="applyInsertTable()" class="px-4 py-2 text-xs font-black text-white bg-indigo-600 hover:bg-indigo-700 rounded-xl shadow-xs transition cursor-pointer">Insert Table</button>
            </div>
        </div>
    </div>

    <!-- ══════════════════════════════════════════════════════════════════════
         REPORT DISCUSSION POST MODAL
    ══════════════════════════════════════════════════════════════════════ -->
    <div id="reportModal" class="fixed inset-0 z-60 hidden flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs">
        <div class="bg-white rounded-3xl max-w-md w-full p-6 shadow-2xl border border-slate-100 animate-in zoom-in-95 duration-150">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2 text-rose-600 font-bold text-sm">
                    <div class="w-8 h-8 rounded-xl bg-rose-50 text-rose-600 flex items-center justify-center text-sm">
                        <i class="fas fa-flag"></i>
                    </div>
                    <span>Report Discussion Post</span>
                </div>
                <button type="button" onclick="closeReportModal()" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-500 flex items-center justify-center transition">
                    <i class="fas fa-times text-xs"></i>
                </button>
            </div>
            <form onsubmit="submitReport(event)">
                <input type="hidden" id="reportReplyId" value="">
                <div class="mb-4">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Reason for Report</label>
                    <select id="reportReason" required class="w-full text-xs font-semibold px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500">
                        <option value="">Select a reason...</option>
                        <option value="inappropriate">Inappropriate Content</option>
                        <option value="harassment">Harassment or Bullying</option>
                        <option value="spam">Spam or Irrelevant</option>
                        <option value="academic_dishonesty">Academic Dishonesty / Cheating</option>
                        <option value="misinformation">Misleading or Harmful Information</option>
                        <option value="other">Other</option>
                    </select>
                </div>
                <div class="mb-5">
                    <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider mb-1.5">Additional Details</label>
                    <textarea id="reportDetails" rows="3" placeholder="Provide extra details to help moderators investigate..." class="w-full text-xs px-3 py-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:ring-2 focus:ring-rose-500"></textarea>
                </div>
                <div class="flex justify-end gap-2.5">
                    <button type="button" onclick="closeReportModal()" class="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition">
                        Cancel
                    </button>
                    <button type="submit" class="px-4 py-2 text-xs font-bold text-white bg-rose-600 hover:bg-rose-700 rounded-xl shadow-sm transition">
                        Submit Report
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Notification Overlay & Sliding Drawer -->
    <div id="notification-overlay" 
         onclick="toggleNotifications()" 
         class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[60] hidden transition-opacity duration-300 opacity-0">
    </div>

    <div id="notification-panel" 
         class="fixed top-0 right-0 h-screen w-80 md:w-96 bg-white shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-200 flex flex-col"
         role="dialog"
         aria-label="Notifications Panel">
        
        <div class="p-5 border-b flex justify-between items-center bg-blue-600 text-white flex-shrink-0">
            <div>
                <h2 class="text-lg font-bold flex items-center gap-2">
                    <i class="far fa-bell"></i> Notifications
                </h2>
                <p id="notifSubtitle" class="text-xs text-blue-100 font-medium">Activity updates</p>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="NotificationHub.markAllRead('notification-list')" aria-label="Mark all notifications as read" title="Mark all as read" class="hover:bg-blue-700 text-blue-100 hover:text-white p-2 rounded-lg transition text-xs font-bold flex items-center gap-1 focus-visible:ring-2 focus-visible:ring-white">
                    <i class="fas fa-check-double text-sm"></i>
                </button>
                <button onclick="toggleNotifications()" aria-label="Close notifications panel" class="hover:bg-blue-700 p-2 rounded-lg transition focus-visible:ring-2 focus-visible:ring-white">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
        </div>

        <div class="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-50 no-scrollbar" id="notification-list">
            <div id="notification-loader" class="flex flex-col items-center justify-center h-full text-slate-500">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-2"></div>
                <p class="text-xs font-bold uppercase tracking-wider">Loading Updates...</p>
            </div>
        </div>
    </div>

    <!-- Universal Notification Hub Engine -->
    <script src="/js/notificationHub.js"></script>
</body>
</html>
