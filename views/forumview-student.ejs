                            <!-- Replying-to Banner -->
                            <div id="replyingToBanner" class="hidden mb-2 px-3 py-1.5 rounded-xl bg-indigo-50 border border-indigo-200/80 text-xs text-indigo-900 font-medium flex items-center justify-between shadow-2xs">
                                <span class="inline-flex items-center gap-1.5">
                                    <i class="fas fa-reply text-indigo-600"></i>
                                    <span>Replying to <span id="replyingToName" class="font-bold text-indigo-950">User</span></span>
                                </span>
                                <button type="button" onclick="cancelReplyTarget()" class="text-indigo-400 hover:text-indigo-700 cursor-pointer p-0.5 transition" title="Cancel replying target">
                                    <i class="fas fa-times text-xs"></i>
                                </button>
