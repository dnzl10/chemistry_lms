                                                <i class="fas fa-paperclip text-[10px] text-cyan-600"></i>
                                                <span id="replySelectedFileName" class="truncate max-w-[130px]">file.png</span>
                                                <button type="button" id="replyRemoveFileBtn" onclick="removeReplyFile()" class="text-cyan-500 hover:text-rose-600 ml-0.5 cursor-pointer" title="Remove file">
                                                    <i class="fas fa-times text-xs"></i>
