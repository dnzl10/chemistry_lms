        // ══════════════════════════════════════════════════════════════════════
        // 📌 CARET SELECTION MEMORY ENGINE & DOM RANGE INSERTER
        // ══════════════════════════════════════════════════════════════════════
        let savedEditorRange = null;

        function saveEditorSelection() {
            const sel = window.getSelection();
            if (sel && sel.rangeCount > 0) {
                const range = sel.getRangeAt(0);
                const editor = document.getElementById('editorArea');
                if (editor && editor.contains(range.commonAncestorContainer)) {
                    savedEditorRange = range.cloneRange();
                    return;
                }
            }
        }

        function restoreEditorSelection() {
            const editor = document.getElementById('editorArea');
            if (!editor) return;
            editor.focus();

            const sel = window.getSelection();
            if (!sel) return;

            if (savedEditorRange) {
                try {
                    sel.removeAllRanges();
                    sel.addRange(savedEditorRange);
                    return;
                } catch (e) {
                    console.warn('Could not restore saved range:', e);
                }
            }

            // Fallback: move caret cleanly to the end of editorArea
            const range = document.createRange();
            range.selectNodeContents(editor);
            range.collapse(false);
            sel.removeAllRanges();
            sel.addRange(range);
            savedEditorRange = range.cloneRange();
        }

        function insertHtmlAtCaret(html) {
            restoreEditorSelection();
            const sel = window.getSelection();
            if (!sel || sel.rangeCount === 0) return;

            const range = sel.getRangeAt(0);
            range.deleteContents();

            const tempDiv = document.createElement('div');
            tempDiv.innerHTML = html;
            const frag = document.createDocumentFragment();
            let node, lastNode;
            while ((node = tempDiv.firstChild)) {
                lastNode = frag.appendChild(node);
            }
            range.insertNode(frag);

            if (lastNode) {
                const newRange = range.cloneRange();
                newRange.setStartAfter(lastNode);
                newRange.collapse(true);
                sel.removeAllRanges();
                sel.addRange(newRange);
                savedEditorRange = newRange.cloneRange();
            }

            const editor = document.getElementById('editorArea');
            if (editor) editor.focus();

            checkEditorEmptyState();
            updateEditorWordCount();
            triggerDraftAutoSave();
        }

        // WYSIWYG Document Formatter
        function formatDoc(cmd, val = null) {
            restoreEditorSelection();
            document.execCommand(cmd, false, val);
            saveEditorSelection();
            checkEditorEmptyState();
            updateEditorWordCount();
        }

