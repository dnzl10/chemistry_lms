                const isSubReply = reply.parent_reply_id !== activeDiscussionData.rootTopic.reply_id;
                const fileExt = (reply.file_path ? reply.file_path.split('.').pop() : '').toLowerCase();
                const isAudio = ['mp3', 'wav', 'ogg', 'webm', 'm4a'].includes(fileExt);
                const isImage = ['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(fileExt);
                const isTeacher = (reply.role || '').toLowerCase() === 'teacher';
                const escAuthor = (reply.user_name || 'User').replace(/'/g, "\\'");
                const formattedTime = new Date(reply.created_at).toLocaleString('en-US', {
                    month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true
