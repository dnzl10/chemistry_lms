        // ── Topic Draft Storage & Auto-Save ──────────────────────────────────
        const TOPIC_DRAFT_KEY = 'lms_draft_forum_<%= forum.forum_id %>';
        let draftSaveDebounce = null;

        function triggerDraftAutoSave() {
            clearTimeout(draftSaveDebounce);
            draftSaveDebounce = setTimeout(() => {
                saveTopicDraft();
            }, 800);
        }

        function saveTopicDraft() {
            const title = (document.getElementById('topicTitleInput')?.value || '').trim();
            const content = (document.getElementById('editorArea')?.innerHTML || '').trim();
            const extLink = (document.getElementById('editorExternalLink')?.value || '').trim();
            const isAnon = document.getElementById('topicIsAnonymous')?.checked || false;

            if (!title && (!content || content === '<br>')) {
                sessionStorage.removeItem(TOPIC_DRAFT_KEY);
                return;
            }

            const draftData = {
                title,
                content,
                extLink,
                isAnon,
                savedAt: Date.now()
            };
            try {
                sessionStorage.setItem(TOPIC_DRAFT_KEY, JSON.stringify(draftData));
            } catch (e) {}
        }

        function restoreTopicDraftIfExists() {
            try {
                const raw = sessionStorage.getItem(TOPIC_DRAFT_KEY);
                if (!raw) return;
                const draft = JSON.parse(raw);
                if (!draft) return;

                const titleInput = document.getElementById('topicTitleInput');
                const editor = document.getElementById('editorArea');
                const linkInput = document.getElementById('editorExternalLink');
                const anonCheckbox = document.getElementById('topicIsAnonymous');

                if (titleInput && !titleInput.value.trim() && draft.title) {
                    titleInput.value = draft.title;
                    handleTopicTitleInput(titleInput);
                }
                if (editor && (!editor.innerText.trim()) && draft.content) {
                    editor.innerHTML = draft.content;
                    checkEditorEmptyState();
                    updateEditorWordCount();
                }
                if (linkInput && !linkInput.value && draft.extLink) {
                    linkInput.value = draft.extLink;
                }
                if (anonCheckbox && draft.isAnon) {
                    anonCheckbox.checked = true;
                }

                showToast('Restored unsaved draft 📝', 'info');
            } catch (e) {}
        }

