                                            <button type="button" onclick="insertChemSymbol('₍aq₎')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-[11px] font-mono text-slate-700 transition cursor-pointer" title="Aqueous solution">₍aq₎</button>
                                            <button type="button" onclick="insertChemSymbol('₍s₎')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-[11px] font-mono text-slate-700 transition cursor-pointer" title="Solid precipitate">₍s₎</button>
                                            <button type="button" onclick="insertChemSymbol('₍g₎')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-[11px] font-mono text-slate-700 transition cursor-pointer" title="Gas evolution">₍g₎</button>
                                            <button type="button" onclick="insertChemSymbol('₍l₎')" class="px-1.5 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-100 hover:text-cyan-800 text-[11px] font-mono text-slate-700 transition cursor-pointer" title="Liquid state">₍l₎</button>
