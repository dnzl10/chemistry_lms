            if (headerClosed) {
                if (isClosed) headerClosed.classList.remove('hidden');
                else headerClosed.classList.add('hidden');
            }

            // Top "+ Reply" Button
            const topReplyBtn = document.getElementById('modalTopReplyBtn');
            if (topReplyBtn) {
                if (isClosed) topReplyBtn.classList.add('hidden');
                else topReplyBtn.classList.remove('hidden');
            }

            // Composer vs Closed Banner Toggle
            const replyForm = document.getElementById('threadReplyForm');
            const closedBanner = document.getElementById('threadClosedBanner');
            if (replyForm && closedBanner) {
                if (isClosed) {
                    replyForm.classList.add('hidden');
                    closedBanner.classList.remove('hidden');
