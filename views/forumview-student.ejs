        function openEquationEditorModal() {
            saveEditorSelection();
            const input = document.getElementById('customEquationInput');
            if (input) {
                input.value = '';
                handleEquationInputPreview(input);
            }
            bringModalToFront('equationEditorModal');
            document.getElementById('equationEditorModal').classList.remove('hidden');
            setTimeout(() => {
                if (input) input.focus();
            }, 100);
        }
        function closeEquationEditorModal() {
            document.getElementById('equationEditorModal').classList.add('hidden');
            removeModalFromStack('equationEditorModal');
        }
        function insertQuickFormula(formulaHtml) {
            const renderedHtml = `<span class="font-mono bg-slate-100 text-indigo-900 px-2 py-0.5 rounded border border-slate-200 inline-block font-bold">${formulaHtml}</span>&nbsp;`;
            closeEquationEditorModal();
            insertHtmlAtCaret(renderedHtml);
        }
        function applyCustomEquation() {
            const input = document.getElementById('customEquationInput');
            const raw = (input ? input.value : '').trim();
            if (!raw) return;
            const formatted = formatChemicalFormula(raw);
            const renderedHtml = `<span class="font-mono bg-slate-100 text-indigo-900 px-2 py-0.5 rounded border border-slate-200 inline-block font-bold">${formatted}</span>&nbsp;`;
            closeEquationEditorModal();
            insertHtmlAtCaret(renderedHtml);
            if (input) {
                input.value = '';
                handleEquationInputPreview(input);
            }
        }

        // ── Scientific Character Map Modal ───────────────────────────────────
        function openCharacterMapModal() {
            saveEditorSelection();
            bringModalToFront('characterMapModal');
            document.getElementById('characterMapModal').classList.remove('hidden');
        }
        function closeCharacterMapModal() {
            document.getElementById('characterMapModal').classList.add('hidden');
            removeModalFromStack('characterMapModal');
        }
        function insertSymbol(sym) {
            insertHtmlAtCaret(sym);
        }

        // ── Table Configuration Sub-Modal ────────────────────────────────────
        function openTableConfigModal() {
            saveEditorSelection();
            bringModalToFront('tableConfigModal');
            document.getElementById('tableConfigModal').classList.remove('hidden');
        }
        function closeTableConfigModal() {
            document.getElementById('tableConfigModal').classList.add('hidden');
            removeModalFromStack('tableConfigModal');
        }
        function applyInsertTable() {
            const rows = parseInt(document.getElementById('tableRowsInput').value, 10) || 3;
            const cols = parseInt(document.getElementById('tableColsInput').value, 10) || 3;
            const withHeader = document.getElementById('tableHeaderToggle').checked;

            let tableHtml = `<table class="w-full border-collapse border border-slate-300 my-3 text-sm">`;
            if (withHeader) {
                tableHtml += `<thead class="bg-slate-100"><tr>`;
                for (let c = 0; c < cols; c++) {
                    tableHtml += `<th class="border border-slate-300 p-2 font-bold text-slate-700">Header ${c + 1}</th>`;
                }
                tableHtml += `</tr></thead>`;
            }
            tableHtml += `<tbody>`;
            for (let r = 0; r < rows; r++) {
                tableHtml += `<tr class="${r % 2 === 0 ? 'bg-white' : 'bg-slate-50'}">`;
                for (let c = 0; c < cols; c++) {
                    tableHtml += `<td class="border border-slate-300 p-2 text-slate-800">Cell (${r + 1},${c + 1})</td>`;
                }
                tableHtml += `</tr>`;
            }
            tableHtml += `</tbody></table>&nbsp;`;

            closeTableConfigModal();
            insertHtmlAtCaret(tableHtml);
        }

        // ── Submit New Discussion Topic ──────────────────────────────────────
        async function submitNewDiscussionTopic(e) {
            e.preventDefault();
            if (IS_FORUM_EXPIRED) {
                showToast('This forum is closed. New discussion topics can no longer be submitted.', 'warning');
                forceCloseNewTopicModal();
                return;
            }
            const titleInput = document.getElementById('topicTitleInput');
            const editor = document.getElementById('editorArea');
            const submitBtn = document.getElementById('postTopicBtn');

            const title = (titleInput.value || '').trim();
            const content = (editor.innerHTML || '').trim();

            if (!title) {
                alert('Please enter a discussion topic title.');
                titleInput.focus();
                return;
            }
            if (!content || editor.innerText.trim().length === 0) {
                alert('Please write some content for your discussion topic.');
                editor.focus();
                return;
            }

            const isAnon = document.getElementById('topicIsAnonymous')?.checked || false;

            const formData = new FormData();
            formData.append('forum_id', '<%= forum.forum_id %>');
            formData.append('reply_title', title);
            formData.append('reply_content', content);
            formData.append('is_anonymous', isAnon ? '1' : '0');
            
            const extLink = (document.getElementById('editorExternalLink').value || '').trim();
            if (extLink) formData.append('external_link', extLink);

            // Attach recorded voice note or file
            if (activeAudioFile) {
                formData.append('file', activeAudioFile);
            } else {
                const fileInput = document.getElementById('editorFileInput');
                if (fileInput.files && fileInput.files[0]) {
                    formData.append('file', fileInput.files[0]);
                }
            }

            submitBtn.disabled = true;
            submitBtn.innerHTML = `<i class="fas fa-spinner fa-spin mr-1.5"></i> Posting to Forum...`;

            try {
                const res = await fetch('/api/forum-discussion-topic', {
                    method: 'POST',
                    body: formData
                });
                const data = await res.json();

                if (data.success) {
                    clearTopicDraft();
                    forceCloseNewTopicModal();
                    showToast('Discussion topic published successfully! 🎉', 'success');

                    // Refresh table list
                    setTimeout(() => {
                        window.location.reload();
                    }, 800);
                } else {
                    if (data.isClosed) {
                        clearTopicDraft();
                        showToast(data.error || 'This forum is closed.', 'warning');
                        forceCloseNewTopicModal();
                        setTimeout(() => window.location.reload(), 1200);
                    } else {
                        alert(data.error || 'Failed to post discussion topic.');
                    }
                }
            } catch (err) {
                console.error('Error posting discussion topic:', err);
                showToast('Network error while publishing discussion.', 'error');
            } finally {
                submitBtn.disabled = false;
                submitBtn.innerHTML = `<span>Publish Topic</span><i class="fas fa-paper-plane text-xs"></i>`;
            }
        }
    </script>

