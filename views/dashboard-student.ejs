                        </span>
                        <p style="font-size:12px;font-weight:500;color:#334155;line-height:1.5;margin:0;">${explanationText}</p>
                    </div>
                ` : '';

                const card = document.createElement('div');
                card.className = 'q-result-card';
                card.innerHTML = `
                    <div style="padding:14px 16px;border-bottom:1.5px solid #f1f5f9;">
                        <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;">
                            <div style="display:flex;align-items:flex-start;gap:10px;flex:1;">
                                <div style="width:28px;height:28px;border-radius:8px;background:${isCorrect?'#dcfce7':'#fee2e2'};display:flex;align-items:center;justify-content:center;flex-shrink:0;font-size:13px;font-weight:900;color:${isCorrect?'#15803d':'#dc2626'};">${i+1}</div>
                                <p style="font-size:13px;font-weight:700;color:#1e293b;line-height:1.5;flex:1;">${q.question_text || q.question || ('Item #' + (i+1))}</p>
