                            <label for="formEndDate" class="block text-[10px] font-bold text-slate-500 mb-1">End Date &amp; Time</label>
                            <input type="datetime-local" name="end_date" id="formEndDate" class="w-full px-3 py-2 bg-white border border-blue-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-blue-500">
