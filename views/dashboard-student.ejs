        async function openResultModal(assessmentId) {
            const modal = document.getElementById('assessmentResultModal');
            if (window.ModalManager) {
                ModalManager.open('assessmentResultModal');
            } else if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }

            switchArmTab('analysis');
            const loader = document.getElementById('armLoader');
            const analysis = document.getElementById('armAnalysis');
            const review = document.getElementById('armReview');
            const rubricContainer = document.getElementById('armRubricContainer');
            const rubricList = document.getElementById('armRubricList');
            const feedbackBox = document.getElementById('armFeedbackBox');
            const feedbackText = document.getElementById('armFeedbackText');

            if (loader) loader.style.display = 'flex';
            if (analysis) analysis.style.display = 'none';
            if (review) review.style.display = 'none';
            if (rubricContainer) rubricContainer.style.display = 'none';
            if (feedbackBox) feedbackBox.style.display = 'none';

            try {
                const res = await fetch(`/api/assessment-result/${assessmentId}`);
                if (!res.ok) throw new Error('Result not available');
                const { score, questions, arcadeAttempts } = await res.json();

                const hasArcade = arcadeAttempts && arcadeAttempts.length > 0;
                const hasQuestions = questions && questions.length > 0;

                const totalItemsCount = hasArcade
                    ? arcadeAttempts.length 
                    : (score.total_items || score.total_possible_score || (hasQuestions ? questions.length : '—'));

                const titleEl = document.getElementById('armTitle');
                const metaEl = document.getElementById('armMeta');
                if (titleEl) titleEl.textContent = score.assessment_name || 'Assessment Result';
                if (metaEl) {
                    metaEl.textContent = `${score.assessment_type || 'Assessment'} · ${score.subject_code ? score.subject_code + ' · ' : ''}${totalItemsCount} Total Items`;
                }

                // Stats calculation
                const maxScore = hasArcade
                    ? arcadeAttempts.length
                    : (score.total_possible_score || score.total_items || (hasQuestions ? questions.length : 100));

                const scoreObtained = hasArcade
                    ? (score.score_obtained != null ? Number(score.score_obtained) : arcadeAttempts.filter(a => a.is_correct == 1).length)
                    : (score.score_obtained != null ? Number(score.score_obtained) : 0);

                const pct = maxScore > 0 ? Math.min(100, Math.round((scoreObtained / maxScore) * 100)) : 0;

                const scorePctEl = document.getElementById('armScorePct');
                const scoreValEl = document.getElementById('armScoreVal');
                const expValEl = document.getElementById('armExpVal');
                const itemsValEl = document.getElementById('armItemsVal');
                const timerValEl = document.getElementById('armTimerVal');

                if (scorePctEl) scorePctEl.textContent = pct + '%';
                if (scoreValEl) scoreValEl.textContent = `${scoreObtained}/${maxScore}`;
                if (expValEl) expValEl.textContent = '+' + (score.exp_gained || (scoreObtained * 10)) + ' EXP';
                if (itemsValEl) itemsValEl.textContent = totalItemsCount;

                if (timerValEl) {
                    if (hasArcade) {
                        const totalSeconds = arcadeAttempts.reduce((acc, a) => acc + (Number(a.response_time_s) || 0), 0);
                        if (totalSeconds > 0) {
                            const mins = Math.floor(totalSeconds / 60);
                            const secs = Math.round(totalSeconds % 60);
                            timerValEl.textContent = `${mins > 0 ? mins + 'm ' : ''}${secs}s (Time Spent)`;
                        } else if (score.duration_minutes) {
                            timerValEl.textContent = `${score.duration_minutes} min (Kiosk Session)`;
                        } else {
                            timerValEl.textContent = 'Arcade Kiosk';
                        }
                    } else {
                        timerValEl.textContent = score.timer_type === 'Global'
                            ? `${score.duration_minutes || '—'} min (Global)`
                            : (score.timer_type === 'PerItem' ? 'Per Item Limit' : (score.assessment_type === 'Assignment' ? 'Untimed Deliverable' : 'Standard Assessment'));
                    }
                }

                drawArmPie(pct);

                // Teacher Feedback
                if (feedbackBox && feedbackText && score.feedback && score.feedback.trim().length > 0) {
                    feedbackText.textContent = score.feedback;
                    feedbackBox.style.display = 'block';
                }

                // Rubrics breakdown (conditionally render only if rubric was utilized during grading)
                const hasValidRubrics = Array.isArray(score.rubrics) && score.rubrics.length > 0;
                const hasRubricGrading = hasValidRubrics && score.rubrics.some(r => {
                    const hasValidPoints = r.points_awarded !== null && 
                                           r.points_awarded !== undefined && 
                                           r.points_awarded !== '' && 
                                           !isNaN(Number(r.points_awarded)) && 
                                           Number(r.points_awarded) > 0;
                    const hasFeedback = typeof r.criterion_feedback === 'string' && 
                                        r.criterion_feedback.trim().length > 0;
                    return hasValidPoints || hasFeedback;
                });

                if (hasRubricGrading && rubricContainer && rubricList) {
                    rubricList.innerHTML = score.rubrics.map(r => {
                        const rPts = Number(r.points_awarded || 0);
                        const rMax = Number(r.max_points || 100);
                        const rPct = rMax > 0 ? Math.round((rPts / rMax) * 100) : 0;
                        return `
                            <div class="p-3 bg-slate-50/80 rounded-xl border border-slate-100">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="text-xs font-black text-slate-800">${r.title || 'Criterion'}</span>
                                    <span class="text-xs font-black text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-md border border-indigo-100">${rPts} / ${rMax} pts (${rPct}%)</span>
                                </div>
                                <div class="w-full h-1.5 bg-slate-200 rounded-full overflow-hidden mb-1.5">
                                    <div class="h-full bg-gradient-to-r from-indigo-500 to-blue-500 rounded-full" style="width: ${rPct}%"></div>
                                </div>
                                ${r.description ? `<p class="text-[11px] text-slate-500 font-medium leading-relaxed">${r.description}</p>` : ''}
                                ${r.criterion_feedback ? `<p class="text-[11px] text-indigo-800 font-bold mt-1 bg-white p-2 rounded-lg border border-indigo-100 italic">Teacher note: ${r.criterion_feedback}</p>` : ''}
                            </div>
                        `;
                    }).join('');
                    rubricContainer.style.display = 'block';
                } else {
                    if (rubricContainer) rubricContainer.style.display = 'none';
                    if (rubricList) rubricList.innerHTML = '';
                }

                // Questions / Arcade breakdown
                const qList = document.getElementById('armQuestionsList');
                const revList = document.getElementById('armReviewList');

                if (arcadeAttempts && arcadeAttempts.length > 0) {
                    buildArcadeAnalysis(arcadeAttempts);
                    buildArcadeReview(arcadeAttempts);
                } else if (questions && questions.length > 0) {
                    buildAnalysisQuestions(questions, score.timer_type);
                    buildReviewQuestions(questions);
                } else {
                    if (qList) {
                        qList.innerHTML = `
                            <div class="p-8 text-center bg-white rounded-2xl border border-slate-200">
                                <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-full flex items-center justify-center mx-auto mb-3 text-lg">
                                    <i class="fas fa-clipboard-check"></i>
                                </div>
                                <p class="text-xs font-black uppercase tracking-wider text-slate-700">Official Submission Recorded</p>
                                <p class="text-[11px] text-slate-400 mt-1">This assessment has been graded and confirmed in your official institutional gradebook.</p>
                                ${score.file_path ? `
                                    <a href="${score.file_path}" target="_blank" class="mt-4 inline-flex items-center gap-1.5 px-4 py-2 bg-indigo-50 text-indigo-700 hover:bg-indigo-100 rounded-xl text-xs font-bold transition">
                                        <i class="fas fa-paperclip"></i>
                                        <span>View Submitted Deliverable (${score.original_filename || 'File'})</span>
                                    </a>
                                ` : ''}
                            </div>
                        `;
                    }
                    if (revList) {
                        revList.innerHTML = '<div class="p-8 text-center text-slate-400 font-bold text-xs"><i class="fas fa-book-open text-2xl mb-2 text-slate-300 block"></i>No remediation items flagged for this submission.</div>';
                    }
                }

                if (loader) loader.style.display = 'none';
                if (analysis) analysis.style.display = 'flex';

            } catch(err) {
                console.error('Failed to load assessment result:', err);
                if (loader) {
                    loader.innerHTML = `
                        <div class="text-center p-6">
                            <i class="fas fa-exclamation-triangle text-2xl text-rose-500 mb-2"></i>
                            <p style="color:#ef4444;font-weight:700;font-size:13px;">Unable to load assessment result details.</p>
                            <p class="text-xs text-slate-400 mt-1">Please try again later or check your active network connection.</p>
                        </div>
                    `;
                }
            }
        }

        function drawArmPie(pct) {
            const canvas = document.getElementById('armPieChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            const cx = 55, cy = 55, r = 46, lineW = 10;
            const startAngle = -Math.PI / 2;
            const fillAngle = startAngle + (pct / 100) * 2 * Math.PI;

            ctx.clearRect(0, 0, 110, 110);

            // Track
            ctx.beginPath();
            ctx.arc(cx, cy, r, 0, 2 * Math.PI);
            ctx.strokeStyle = '#e2e8f0'; ctx.lineWidth = lineW; ctx.stroke();

            // Fill
            const color = pct >= 90 ? '#10b981' : pct >= 75 ? '#06b6d4' : pct >= 60 ? '#f59e0b' : '#ef4444';
            ctx.beginPath();
            ctx.arc(cx, cy, r, startAngle, fillAngle);
            ctx.strokeStyle = color; ctx.lineWidth = lineW;
            ctx.lineCap = 'round'; ctx.stroke();
        }

        function buildAnalysisQuestions(questions, timerType) {
            const container = document.getElementById('armQuestionsList');
            if (!container) return;
            container.innerHTML = '';

            questions.forEach((q, i) => {
                const isCorrect = q.is_correct == 1;
                const badge = isCorrect
                    ? `<span style="font-size:11px;font-weight:800;background:#dcfce7;color:#15803d;padding:3px 10px;border-radius:9999px;"><i class="fas fa-check" style="margin-right:3px;"></i>Correct</span>`
                    : `<span style="font-size:11px;font-weight:800;background:#fee2e2;color:#dc2626;padding:3px 10px;border-radius:9999px;"><i class="fas fa-times" style="margin-right:3px;"></i>Incorrect</span>`;

                let answerHtml = '';
                if (q.option_a || q.option_b) {
                    const opts = ['a','b','c','d'];
                    answerHtml = '<div style="display:flex;flex-direction:column;gap:6px;margin-top:8px;">';
                    opts.forEach(letter => {
                        const txt = q['option_' + letter];
                        if (!txt) return;
                        const isCorrectOpt = q.correct_answer && q.correct_answer.toLowerCase().includes(letter);
                        const isStudentOpt = q.selected_option && q.selected_option.toLowerCase().includes(letter);
                        const isWrongStudent = isStudentOpt && !isCorrectOpt;
                        let cls = 'option-choice';
                        if (isCorrectOpt) cls += ' correct-opt';
                        if (isStudentOpt) cls += ' student-opt';
                        if (isWrongStudent) cls += ' wrong-student';

                        const letterBadge = `<span style="width:20px;height:20px;border-radius:50%;background:${isCorrectOpt?'#22c55e':isWrongStudent?'#ef4444':'#e2e8f0'};color:${isCorrectOpt||isWrongStudent?'#fff':'#64748b'};font-size:11px;font-weight:900;display:flex;align-items:center;justify-content:center;flex-shrink:0;">${letter.toUpperCase()}</span>`;
                        const icon = isCorrectOpt ? '<i class="fas fa-check-circle" style="color:#22c55e;font-size:12px;margin-left:auto;"></i>' : '';
                        answerHtml += `<div class="${cls}">${letterBadge}<div style="flex:1;">${txt}</div>${icon}</div>`;
                    });
                    answerHtml += '</div>';
                } else if (q.correct_answer) {
                    answerHtml = `
                        <div class="mt-2 p-2.5 bg-slate-50 rounded-xl border border-slate-200 text-xs">
                            <span class="font-extrabold text-slate-500 uppercase tracking-wider block mb-1">Answer Key:</span>
                            <span class="font-black text-emerald-700 font-mono">${q.correct_answer}</span>
                        </div>
                    `;
                }

                // Answer Discussion & Explanation
                const explanationText = q.advice_text || q.explanation || q.answer_discussion;
                const explanationHtml = explanationText ? `
                    <div style="margin-top:10px;padding:12px 14px;background:#f8fafc;border-left:4px solid #0891b2;border-radius:8px;">
                        <span style="font-size:11px;font-weight:800;color:#0e7490;text-transform:uppercase;letter-spacing:0.05em;display:flex;align-items:center;gap:5px;margin-bottom:4px;">
