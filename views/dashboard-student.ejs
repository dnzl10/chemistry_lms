    <div id="calendarHoverPopover"
         class="fixed hidden z-[95] pointer-events-none transition-all duration-150 opacity-0 w-72 max-w-[90vw] bg-white/95 backdrop-blur-md rounded-2xl shadow-xl border border-slate-200/90 p-3.5 text-left text-slate-800"
         style="top: 0; left: 0;">
        <div id="calendarHoverContent"></div>
    </div>

    <script>
        // View All Modals Controllers
        function openViewAllUpcomingModal() {
            const modal = document.getElementById('allUpcomingModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }

        function closeViewAllUpcomingModal() {
            const modal = document.getElementById('allUpcomingModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        function openViewAllUpdatesModal() {
            const modal = document.getElementById('allUpdatesModal');
            if (modal) {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
            }
        }

        function closeViewAllUpdatesModal() {
            const modal = document.getElementById('allUpdatesModal');
            if (modal) {
                modal.classList.add('hidden');
                modal.classList.remove('flex');
            }
        }

        // Direct Learning Material Opener for Recently Viewed Arrow Action
        function openMaterialDirectly(event, material) {
            if (event) {
                if (typeof event.stopPropagation === 'function') event.stopPropagation();
            }
            if (!material) return;

            // Access control check: locked status
            if (material.is_locked === 1 || material.is_locked === '1' || material.is_locked === true) {
                alert('This learning material is currently locked by your instructor.');
                return;
            }

            // Track interaction immediately to backend
            if (material.material_id) {
                trackMaterialInteraction(material.material_id, 'viewed');
            }

            const filePath = material.file_path_or_url || '';
            if (!filePath) {
                // Graceful fallback to preview modal if direct link is missing
                openMaterialPreview(material);
                return;
            }

            const cleanPath = filePath.replace(/^(\/?material_uploads\/?)+/, '');
            const targetUrl = (filePath.startsWith('http://') || filePath.startsWith('https://'))
                ? filePath
                : ('/material_uploads/' + cleanPath);

            window.open(targetUrl, '_blank', 'noopener,noreferrer');
        }
        window.openMaterialDirectly = openMaterialDirectly;

        // Dedicated Learning Material Preview Modal Controller
        function openMaterialPreview(material) {
            if (!material) return;

            // Track interaction immediately to backend
            if (material.material_id) {
                trackMaterialInteraction(material.material_id, 'viewed');
            }

            const titleEl = document.getElementById('materialModalTitle');
            const subjectEl = document.getElementById('materialModalSubjectCode');
            const typeLabelEl = document.getElementById('materialModalTypeLabel');
            const iconEl = document.getElementById('materialModalIcon');
            const typeBadge = document.getElementById('materialModalTypeBadge');
            const bodyEl = document.getElementById('materialModalBody');
            const downloadBtn = document.getElementById('materialModalDownloadBtn');
            const subjectLink = document.getElementById('materialModalSubjectLink');
            const aiSummaryContainer = document.getElementById('materialModalAISummary');
            const aiText = document.getElementById('materialModalAIText');

            if (titleEl) titleEl.textContent = material.title || 'Learning Material';
            if (subjectEl) subjectEl.textContent = material.subject_code || 'Subject';
            if (subjectLink) {
                subjectLink.href = material.subject_id 
                    ? `/subjects/open/${material.subject_id}` 
                    : '/subjects';
            }

            const matType = (material.material_type || '').toLowerCase();
            const filePath = material.file_path_or_url || '';
            const fileUrl = filePath.startsWith('http://') || filePath.startsWith('https://') 
                            ? filePath 
                            : (filePath.startsWith('/') ? filePath : '/material_uploads/' + filePath);

            if (downloadBtn) {
                downloadBtn.href = fileUrl;
                if (matType === 'link') {
                    downloadBtn.classList.add('hidden');
                } else {
                    downloadBtn.classList.remove('hidden');
                }
            }

            const typeConfig = {
                pdf: { icon: 'fa-file-pdf', label: 'PDF Document', gradient: 'from-rose-500 to-red-600' },
                img: { icon: 'fa-file-image', label: 'Image Diagram', gradient: 'from-amber-500 to-orange-500' },
                video: { icon: 'fa-file-video', label: 'Video Lecture', gradient: 'from-purple-600 to-indigo-600' },
                word: { icon: 'fa-file-word', label: 'Word Document', gradient: 'from-blue-600 to-cyan-600' },
                presentation: { icon: 'fa-file-powerpoint', label: 'Slide Deck', gradient: 'from-orange-500 to-amber-600' },
                link: { icon: 'fa-link', label: 'External Resource', gradient: 'from-emerald-500 to-teal-600' }
            };

