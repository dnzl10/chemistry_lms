                                <!-- Event Peek (UX Psychology: Anticipation) -->
                                <div class="mt-8 space-y-3 relative z-10">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="w-1.5 h-1.5 bg-orange-500 rounded-full animate-pulse"></span>
                                        <h4 class="text-[10px] font-black uppercase text-slate-400 tracking-[0.15em]">Live Peek</h4>
                                    </div>

                                    <% if(events.length > 0){ %>
                                        <% events.slice(0,5).forEach(event => { %>
                                            <div class="group/event p-4 bg-slate-50 hover:bg-white rounded-[1.25rem] flex items-center gap-4 border border-slate-100 hover:border-blue-200 hover:shadow-xl hover:shadow-blue-500/5 transition-all duration-300">
                                                <div class="flex-shrink-0 w-10 h-10 bg-white rounded-xl flex flex-col items-center justify-center border border-slate-100 group-hover/event:border-blue-200 group-hover/event:bg-blue-50 transition-colors">
                                                    <span class="text-[9px] font-black text-slate-400 group-hover/event:text-blue-400 uppercase leading-none">
                                                        <%= new Date(event.event_date).toLocaleString('default', {month: 'short'}) %>
                                                    </span>
                                                    <span class="text-sm font-black text-slate-700 group-hover/event:text-blue-600">
                                                        <%= new Date(event.event_date).getDate() %>
                                                    </span>
                                                </div>

                                                <div class="min-w-0">
                                                    <p class="text-xs text-slate-800 font-black truncate group-hover/event:text-blue-700">
                                                        <%= event.event_title || 'Campus Event' %>
                                                    </p>
                                                    <p class="text-[10px] text-slate-400 font-medium">
                                                        Starts at <%= new Date(event.event_date).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                                    </p>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="py-6 flex flex-col items-center justify-center border-2 border-dashed border-slate-100 rounded-2xl">
                                            <i class="far fa-calendar-check text-slate-200 text-2xl mb-2"></i>
                                            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Quiet Month</p>
                                        </div>
                                    <% } %>
                                </div>
                            </section>
                        </div>
                    </div>
                </div>




                <footer class="mt-auto py-6 px-8 border-t border-slate-200 bg-white/50">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                        <div class="text-center md:text-left">
                            <p class="text-sm text-slate-500 font-medium">
                                &copy; 2026 <span class="text-blue-600 font-bold">Mabini College</span>. All rights reserved.
                            </p>
                            <p class="text-[10px] text-slate-400 uppercase tracking-widest mt-1">
                                System Version 2.4.0-stable
                            </p>
                        </div>

                        <div class="flex flex-wrap justify-center gap-6">
                            <a href="/privacy" class="text-xs font-bold text-slate-500 hover:text-blue-600 transition">Privacy Policy</a>
                            <a href="/terms" class="text-xs font-bold text-slate-500 hover:text-blue-600 transition">Terms of Service</a>
                            <a href="/support" class="text-xs font-bold text-slate-500 hover:text-blue-600 transition flex items-center gap-1">
                                <i class="far fa-question-circle"></i> Help & Support
                            </a>
