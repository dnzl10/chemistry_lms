<%
    var user = locals.user || {};
    var announcements = locals.announcements || [];
    var upcomingTasks = locals.upcomingTasks || [];
    var timeline = locals.timeline || [];
    var subjects = locals.subjects || [];
    var events = locals.events || [];
    var calendarDays = locals.calendarDays || [];
    var month = typeof locals.month !== 'undefined' ? locals.month : (new Date().getMonth());
    var year = typeof locals.year !== 'undefined' ? locals.year : (new Date().getFullYear());
    var dueDays = locals.dueDays || [];
    var recentForums = locals.recentForums || [];
    var recentUpdates = locals.recentUpdates || [];
    var recentMaterials = locals.recentMaterials || [];
    var completedAssessments = locals.completedAssessments || [];
    var flaggedAssessmentId = locals.flaggedAssessmentId || null;
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard | Elementa Chemistry</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        
        .glass-effect {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
        }

        .modal-anim { animation: modalIn 0.2s ease forwards; }

        /* Assessment Result & Analytics Modal Styles */
        .amodal-tab-pill {
            padding: 7px 18px; border-radius: 9999px;
            font-size: 12px; font-weight: 800; letter-spacing: 0.04em;
            border: none; cursor: pointer; transition: all 0.18s;
            color: #94a3b8; background: transparent;
        }
        .amodal-tab-pill.active { background: #0891b2; color: #fff; box-shadow: 0 2px 8px rgba(8,145,178,0.3); }
        .element-card {
            display: inline-flex; flex-direction: column; align-items: center; justify-content: center;
            width: 52px; height: 58px; border-radius: 10px;
            border: 2px solid #e2e8f0; background: #fff;
            font-family: monospace; position: relative;
            box-shadow: 0 2px 8px rgba(0,0,0,0.07);
        }
        .element-card .el-num { font-size: 11px; font-weight: 700; color: #94a3b8; position: absolute; top: 4px; left: 5px; }
        .element-card .el-sym { font-size: 20px; font-weight: 900; color: #1e293b; line-height: 1; }
        .element-card .el-sub { font-size: 11px; font-weight: 700; color: #64748b; }
        .element-card.correct-el { border-color: #22c55e; background: #f0fdf4; }
        .element-card.wrong-el   { border-color: #ef4444; background: #fff1f2; }
        .element-card.student-el { border-color: #f97316; background: #fff7ed; }
        .option-choice {
            display: flex; align-items: flex-start; gap: 10px;
            padding: 10px 14px; border-radius: 12px; border: 2px solid #e2e8f0;
            background: #fff; font-size: 13px; font-weight: 600; color: #475569;
            position: relative; transition: border-color 0.15s;
        }
        .option-choice.correct-opt   { border-color: #22c55e; background: #f0fdf4; color: #15803d; }
        .option-choice.student-opt   { outline: 3px solid #f97316; outline-offset: 1px; }
        .option-choice.wrong-student { border-color: #ef4444; background: #fff1f2; color: #dc2626; }
        .q-result-card {
            border-radius: 16px; border: 1.5px solid #e2e8f0;
            background: #fff; overflow: hidden;
            box-shadow: 0 1px 6px rgba(0,0,0,0.04);
        }
        .remediation-card {
            border-radius: 12px; border: 1.5px solid #e0e7ff;
            background: #f8faff; overflow: hidden;
        }
        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.96); }
            to { opacity: 1; transform: scale(1); }
        }
    </style>

    <!-- Standardized Student Navigation & Responsive Styles -->
    <%- include('partials/student-nav-styles') %>
</head>
<body class="bg-gradient-to-br from-slate-50 via-white to-indigo-50/30 text-slate-900 min-h-screen">

    <div class="flex min-h-screen relative overflow-x-hidden">
        <!-- Standardized Student Sidebar Partial -->
        <%- include('partials/student-sidebar', { activeNav: 'dashboard' }) %>

        <!-- Main Content Area -->
        <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">
            <!-- App Header -->
            <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    <div>
                        <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">
                            Welcome, <%= user.first_name %>!
                        </h1>
                        <p class="text-xs text-slate-600 hidden sm:block font-medium">
                            <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                            Chemistry Enthusiast &nbsp;·&nbsp; <%= new Date().toLocaleDateString('en-PH', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3 md:gap-6">
                    <!-- Messages Navigation Button (Entry point to message-student view) -->
                    <a href="/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                        <i class="far fa-comment-dots text-xl"></i>
                        
                        <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                            <span class="msg-badge-count">0</span>
                        </span>

                        <!-- Tooltip with keyboard and hover accessibility -->
                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Messages
                        </span>
                    </a>

                    <!-- Notification Button with keyboard-accessible tooltip -->
                    <button type="button" onclick="toggleNotifications()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                        <i class="far fa-bell text-xl text-slate-700"></i>
                        
                        <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center notif-badge hidden" aria-hidden="true">
                            <span class="notif-badge-count">0</span>
                        </span>

                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Notifications
                        </span>
                    </button>
                    
                    <!-- User Profile Dropdown -->
                    <div class="relative">
                        <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                            <div class="text-right hidden lg:block">
                                <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                                <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none"><%= user.role %></p>
                            </div>
                            <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100">
                            <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                        </button>

                        <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                            <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                                <p class="text-sm font-bold text-slate-800"><%= user.first_name %> <%= user.last_name %></p>
                                <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role %></p>
                            </div>
                            <a href="/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                                <i class="far fa-user w-5 text-center"></i> View Profile
                            </a>
                            <hr class="my-2 border-slate-100">
                            <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                                <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Scrollable Main Container -->
            <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
                <div class="p-4 md:p-8 flex-1">
                    <!-- Standard Announcement Slider -->
                    <section id="announcement-slider-container" class="relative group overflow-hidden rounded-3xl shadow-sm border border-slate-200 min-h-[220px] mb-6 flex flex-col justify-center" aria-label="Campus Announcements">
                        <% if (announcements && announcements.length > 0) { %>
                            <div class="relative w-full overflow-hidden rounded-3xl">
                                <!-- Slides Track -->
                                <div id="announcement-slider-track" class="flex transition-transform duration-500 ease-in-out" style="transform: translateX(0%);">
                                    <% announcements.forEach((ann, index) => { %>
                                        <div class="announcement-slide announcement-item w-full flex-shrink-0 min-w-full relative flex items-center justify-between p-6 md:p-10 text-white bg-gradient-to-r from-slate-900 via-slate-800 to-indigo-950" 
                                            data-index="<%= index %>">
                                            
                                            <!-- Decorative Ambient Pattern -->
                                            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-indigo-500/10 via-transparent to-transparent pointer-events-none"></div>

                                            <!-- Content Container -->
                                            <div class="max-w-2xl relative z-20" id="ann-card-<%= ann.announcement_id %>">
                                                <div class="flex items-center gap-2 mb-2 flex-wrap">
                                                    <p class="text-slate-300 text-xs uppercase tracking-wider font-bold">
                                                        <%= ann.scope === 'global' ? 'Global Campus Broadcast' : ('Update from Teacher ' + ann.last_name) %>
                                                    </p>
                                                    <% if (ann.is_critical) { %>
                                                        <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase bg-rose-500 text-white animate-pulse">
                                                            <i class="fas fa-triangle-exclamation"></i> Emergency
                                                        </span>
                                                    <% } else if (ann.is_priority) { %>
                                                        <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase bg-amber-400 text-slate-900">
                                                            <i class="fas fa-flag"></i> Priority
                                                        </span>
                                                    <% } %>

                                                    <% if (ann.due_date) { 
                                                        const d = new Date(ann.due_date);
                                                        const diffHours = Math.round((d - new Date()) / (1000 * 60 * 60));
                                                        const isUrgent = diffHours < 24;
                                                    %>
                                                        <span class="px-2.5 py-0.5 rounded-full text-xs font-black uppercase tracking-wide <%= isUrgent ? 'bg-rose-600 text-white animate-pulse' : 'bg-cyan-500 text-slate-900' %>">
                                                            <i class="fas fa-hourglass-half"></i> <%= diffHours > 0 ? (diffHours > 24 ? Math.ceil(diffHours/24) + ' Days Left' : diffHours + 'h Left') : 'Overdue' %> &bull; <%= d.toLocaleDateString('en-US', {month:'short', day:'numeric'}) %>
                                                        </span>
                                                    <% } %>
                                                </div>

                                                <h2 class="text-xl md:text-3xl font-black leading-tight text-white"><%= ann.title %></h2>
                                                <p class="text-slate-200 text-sm mt-2 opacity-95 line-clamp-2"><%= ann.content %></p>
                                                
                                                <!-- Action Buttons -->
                                                <div class="flex items-center gap-3 mt-4 flex-wrap">
                                                    <% if (ann.due_date) { 
                                                        const startIso = new Date(ann.due_date).toISOString().replace(/-|:|\.\d\d\d/g, '');
                                                        const gcalUrl = 'https://calendar.google.com/calendar/render?action=TEMPLATE&text=' + encodeURIComponent(ann.title) + '&details=' + encodeURIComponent(ann.content) + '&dates=' + startIso + '/' + startIso;
                                                    %>
                                                        <a href="<%= gcalUrl %>" target="_blank" rel="noopener noreferrer"
                                                           class="px-3.5 py-2 bg-white/20 hover:bg-white/30 text-white rounded-xl text-xs font-bold transition-all shadow flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-white">
                                                            <i class="fab fa-google text-amber-300"></i> Calendar
                                                        </a>
                                                    <% } %>

                                                    <% if (ann.attachment_url) { %>
                                                        <button type="button" onclick='openAnnouncementPreview(<%- JSON.stringify(ann) %>)'
                                                                class="px-3 py-2 bg-cyan-500/30 hover:bg-cyan-500/50 text-cyan-200 border border-cyan-400/40 rounded-xl text-xs font-bold transition-all shadow flex items-center gap-1.5 backdrop-blur-sm focus-visible:ring-2 focus-visible:ring-cyan-300">
                                                            <i class="fas fa-paperclip text-cyan-300"></i> <span>View Proof</span>
                                                        </button>
                                                    <% } %>

                                                    <button type="button" onclick='openAnnouncementPreview(<%- JSON.stringify(ann) %>)'
                                                            class="px-3.5 py-2 bg-white/20 hover:bg-white/30 text-white rounded-xl text-xs font-bold transition-all shadow flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-white">
                                                        <i class="fas fa-expand text-xs"></i> <span>Read & Proof</span>
                                                    </button>
                                                </div>
                                            </div>
                                            
                                            <!-- Ambient Icon -->
                                            <i class="fas fa-bullhorn text-7xl text-white/10 hidden sm:block relative z-20" aria-hidden="true"></i>
                                        </div>
                                    <% }) %>
                                </div>

                                <!-- Slider Navigation Controls (Only if more than 1 announcement) -->
                                <% if (announcements.length > 1) { %>
                                    <!-- Previous Slide Button -->
                                    <button type="button" 
                                            id="announcement-prev-btn" 
                                            aria-label="Previous announcement" 
                                            class="absolute left-3 top-1/2 -translate-y-1/2 z-30 w-9 h-9 rounded-full bg-slate-900/60 hover:bg-slate-900 text-white flex items-center justify-center transition border border-white/20 shadow-md backdrop-blur-xs cursor-pointer focus-visible:ring-2 focus-visible:ring-white">
                                        <i class="fas fa-chevron-left text-xs"></i>
                                    </button>

                                    <!-- Next Slide Button -->
                                    <button type="button" 
                                            id="announcement-next-btn" 
                                            aria-label="Next announcement" 
                                            class="absolute right-3 top-1/2 -translate-y-1/2 z-30 w-9 h-9 rounded-full bg-slate-900/60 hover:bg-slate-900 text-white flex items-center justify-center transition border border-white/20 shadow-md backdrop-blur-xs cursor-pointer focus-visible:ring-2 focus-visible:ring-white">
                                        <i class="fas fa-chevron-right text-xs"></i>
                                    </button>

                                    <!-- Pagination Dots -->
                                    <div class="absolute bottom-3 left-1/2 -translate-x-1/2 z-30 flex items-center gap-1.5 bg-slate-900/50 backdrop-blur-xs px-2.5 py-1 rounded-full border border-white/10">
                                        <% announcements.forEach((_, idx) => { %>
                                            <button type="button" 
                                                    class="announcement-dot h-2 rounded-full transition-all duration-300 cursor-pointer <%= idx === 0 ? 'bg-white w-5' : 'bg-white/40 w-2 hover:bg-white/70' %>" 
                                                    data-index="<%= idx %>" 
                                                    aria-label="Go to announcement slide <%= idx + 1 %>">
                                            </button>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>
                        <% } else { %>
                            <!-- Fallback empty state -->
                            <div class="bg-white min-h-[220px] flex-1 rounded-3xl flex flex-col items-center justify-center text-center border-2 border-dashed border-slate-200 p-8 w-full">
                                <div class="bg-slate-50 w-16 h-16 rounded-full flex items-center justify-center mb-4">
                                    <i class="fas fa-megaphone text-slate-400 text-2xl"></i>
                                </div>
                                <h2 class="text-indigo-950 font-bold text-sm uppercase tracking-tight">Silent Campus</h2>
                                <p class="text-slate-600 text-xs mt-1 italic font-medium">
                                    "There is no announcement posted"
                                </p>
                                <p class="text-xs text-slate-500 mt-3 uppercase font-bold tracking-wider">Check back later for updates</p>
                            </div>
                        <% } %>
                    </section>

                    <!-- Main Grid -->
                    <div class="grid grid-cols-1 xl:grid-cols-12 gap-8 items-start">
                        <div class="xl:col-span-8 space-y-8">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 items-stretch">
                                <!-- Upcoming Assessments Section -->
                                <section class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col h-full">
                                    <div class="flex items-center justify-between mb-5 flex-shrink-0">
                                        <h2 class="text-sm font-black text-slate-800 flex items-center gap-3">
                                            <div class="bg-gradient-to-tr from-indigo-600 to-violet-500 p-2.5 rounded-xl shadow-md text-white">
                                                <i class="fas fa-clipboard-list text-xs"></i>
                                            </div>
                                            <span class="uppercase tracking-wider">Upcoming Assessments</span>
                                        </h2>
                                        <button type="button" 
                                                onclick="openViewAllUpcomingModal()" 
                                                aria-label="View all upcoming assessments" 
                                                class="group/btn flex items-center gap-2 bg-slate-50 hover:bg-slate-800 px-3.5 py-1.5 rounded-xl border border-slate-200 shadow-xs transition cursor-pointer">
                                            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 group-hover/btn:text-white">View All</span>
                                            <i class="fas fa-chevron-right text-xs text-slate-500 group-hover/btn:text-white transition-transform group-hover/btn:translate-x-0.5"></i>
                                        </button>
                                    </div>

                                    <% 
                                        const tasksList = (typeof upcomingTasks !== 'undefined' && Array.isArray(upcomingTasks)) ? upcomingTasks : [];
                                        const displayTasks = tasksList.slice(0, 3);
                                        if (displayTasks.length > 0) { 
                                    %>
                                        <div class="space-y-3">
                                            <% displayTasks.forEach(task => { 
                                                const assessmentType = (task.assessment_type || 'assessment').toLowerCase();
                                                const isQuiz = assessmentType === 'quiz';
                                                const isAssignment = assessmentType === 'assignment';
                                                const tabName = isAssignment ? 'assignments' : 'assessments';
                                                const anchorId = isAssignment ? `asgn-card-${task.assessment_id}` : `assessment-${task.assessment_id}`;
                                                const targetUrl = task.subject_id 
                                                    ? `/subjects/open/${task.subject_id}?tab=${tabName}&assessment_id=${task.assessment_id}${task.topic_id ? '&topic_id=' + task.topic_id : ''}#${anchorId}` 
                                                    : '/subjects';
                                                
                                                const theme = isQuiz 
                                                    ? { 
                                                        card: 'bg-gradient-to-r from-orange-50/80 to-rose-50/50 hover:from-orange-100/90 hover:to-rose-100/70', 
                                                        border: 'border-orange-100 hover:border-orange-300', 
                                                        badge: 'bg-gradient-to-br from-orange-500 to-rose-500',
                                                        text: 'text-orange-600',
                                                        hoverBtn: 'group-hover:bg-orange-600'
                                                    }
                                                    : { 
                                                        card: 'bg-gradient-to-r from-blue-50/80 to-indigo-50/50 hover:from-blue-100/90 hover:to-indigo-100/70', 
                                                        border: 'border-blue-100 hover:border-indigo-300', 
                                                        badge: 'bg-gradient-to-br from-blue-600 to-indigo-600',
                                                        text: 'text-blue-600',
                                                        hoverBtn: 'group-hover:bg-indigo-600'
                                                    };
                                            %>
                                                <a href="<%= targetUrl %>" 
                                                   aria-label="Open <%= task.assessment_name %> assessment"
                                                   class="group block relative p-4 <%= theme.card %> rounded-2xl border <%= theme.border %> transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md cursor-pointer">
                                                    <div class="flex items-center gap-4">
                                                        <!-- Badge Section -->
                                                        <div class="flex-shrink-0 w-12 h-12 <%= theme.badge %> shadow-md rounded-xl flex flex-col items-center justify-center text-white transition-transform group-hover:scale-105">
                                                            <i class="fas <%= isQuiz ? 'fa-bolt' : 'fa-book-open' %> text-xs mb-0.5"></i>
                                                            <span class="text-[10px] font-black uppercase tracking-tighter"><%= task.assessment_type || 'Task' %></span>
                                                        </div>

                                                        <!-- Text Details -->
                                                        <div class="flex-1 min-w-0">
                                                            <div class="flex items-center gap-1.5 mb-1 flex-wrap">
                                                                <% if (task.subject_code) { %>
                                                                    <span class="text-[10px] font-black px-2 py-0.5 rounded-md bg-white/90 border border-slate-200/60 text-slate-700 uppercase tracking-wider">
                                                                        <%= task.subject_code %>
                                                                    </span>
                                                                <% } %>
                                                                <% if (task.category) { %>
                                                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 uppercase tracking-wider">
                                                                        <%= task.category %>
                                                                    </span>
                                                                <% } %>
                                                            </div>
                                                            <h3 class="text-sm font-black text-slate-800 truncate group-hover:text-indigo-950 transition-colors">
                                                                <%= task.assessment_name %>
                                                            </h3>
                                                            <div class="flex items-center gap-2 mt-1">
                                                                <span class="flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-white border border-slate-100 text-xs font-bold <%= theme.text %> shadow-xs">
                                                                    <i class="far fa-clock"></i>
                                                                    Due: <%= new Date(task.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <!-- Arrow Button Indicator -->
                                                        <div class="w-9 h-9 rounded-xl bg-white shadow-sm border border-slate-100 flex items-center justify-center text-slate-500 group-hover:text-white <%= theme.hoverBtn %> transition-all flex-shrink-0">
                                                            <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
                                                        </div>
                                                    </div>
                                                </a>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <!-- Empty State UI -->
                                        <div class="flex-1 min-h-[220px] py-8 px-4 flex flex-col items-center justify-center text-center bg-slate-50/70 rounded-2xl border border-dashed border-slate-200 w-full">
                                            <div class="w-14 h-14 bg-white rounded-2xl shadow-xs border border-slate-100 flex items-center justify-center mb-3 text-emerald-500">
                                                <i class="fas fa-clipboard-check text-2xl"></i>
                                            </div>
                                            <p class="text-xs font-black text-slate-800 uppercase tracking-wider">All Caught Up!</p>
                                            <p class="text-xs text-slate-500 font-medium mt-1 max-w-xs">No pending assessments or tasks scheduled right now.</p>
                                            <a href="/subjects" class="mt-4 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-bold text-indigo-600 hover:text-indigo-800 hover:border-indigo-300 shadow-xs transition">
                                                <span>Explore Coursework</span>
                                                <i class="fas fa-arrow-right text-[10px]"></i>
                                            </a>
                                        </div>
                                    <% } %>
                                </section>

                                <!-- Recent Update Section -->
                                <section class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col h-full">
                                    <div class="flex items-center justify-between mb-5 flex-shrink-0">
                                        <h2 class="text-sm font-black text-slate-800 flex items-center gap-3">
                                            <div class="bg-gradient-to-tr from-emerald-500 to-teal-400 p-2.5 rounded-xl shadow-md text-white">
                                                <i class="fas fa-history text-xs"></i>
                                            </div>
                                            <span class="uppercase tracking-wider">Recent Updates</span>
                                        </h2>
                                        <button type="button" 
                                                onclick="openViewAllUpdatesModal()" 
                                                aria-label="View all recent updates" 
                                                class="group/btn flex items-center gap-2 bg-slate-50 hover:bg-slate-800 px-3.5 py-1.5 rounded-xl border border-slate-200 shadow-xs transition cursor-pointer">
                                            <span class="text-xs font-bold uppercase tracking-wider text-slate-700 group-hover/btn:text-white">View All</span>
                                            <i class="fas fa-chevron-right text-xs text-slate-500 group-hover/btn:text-white transition-transform group-hover/btn:translate-x-0.5"></i>
                                        </button>
                                    </div>

                                    <% 
                                        const updatesList = (typeof recentUpdates !== 'undefined' && Array.isArray(recentUpdates)) ? recentUpdates : []; 
                                        const displayUpdates = updatesList.slice(0, 4);
                                        if (displayUpdates.length > 0) { 
                                    %>
                                        <div class="space-y-3">
                                            <% displayUpdates.forEach(item => {
                                                const typeMap = {
                                                    announcement: { icon: 'fa-bullhorn', badge: 'bg-gradient-to-br from-emerald-500 to-teal-500', card: 'bg-gradient-to-r from-emerald-50/80 to-teal-50/50 hover:from-emerald-100/90 hover:to-teal-100/70', border: 'border-emerald-100 hover:border-emerald-300', text: 'text-emerald-700', label: 'ANNOUNCEMENT', hoverBtn: 'group-hover:bg-emerald-600' },
                                                    forum:        { icon: 'fa-comment-dots', badge: 'bg-gradient-to-br from-amber-500 to-orange-500', card: 'bg-gradient-to-r from-amber-50/80 to-orange-50/50 hover:from-amber-100/90 hover:to-orange-100/70', border: 'border-amber-100 hover:border-amber-300', text: 'text-amber-700', label: 'FORUM', hoverBtn: 'group-hover:bg-amber-600' },
                                                    material:     { icon: 'fa-book-open', badge: 'bg-gradient-to-br from-sky-500 to-cyan-500', card: 'bg-gradient-to-r from-sky-50/80 to-cyan-50/50 hover:from-sky-100/90 hover:to-cyan-100/70', border: 'border-sky-100 hover:border-sky-300', text: 'text-sky-700', label: 'MATERIAL', hoverBtn: 'group-hover:bg-sky-600' },
                                                    assessment:   { icon: 'fa-file-pen', badge: 'bg-gradient-to-br from-violet-500 to-purple-500', card: 'bg-gradient-to-r from-violet-50/80 to-purple-50/50 hover:from-violet-100/90 hover:to-purple-100/70', border: 'border-violet-100 hover:border-violet-300', text: 'text-violet-700', label: 'ASSESSMENT', hoverBtn: 'group-hover:bg-violet-600' },
                                                };
                                                const theme = typeMap[item.update_type] || typeMap.announcement;
                                                const targetUrl = item.link_url || (item.subject_id ? `/subjects/open/${item.subject_id}` : '/dashboard');
                                            %>
                                                <a href="<%= targetUrl %>" 
                                                   aria-label="Open <%= item.title %> (<%= theme.label %>)"
                                                   class="group block relative p-4 <%= theme.card %> rounded-2xl border <%= theme.border %> transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md cursor-pointer">
                                                    <div class="flex items-center gap-4">
                                                        <!-- Badge Icon -->
                                                        <div class="flex-shrink-0 w-11 h-11 <%= theme.badge %> shadow-sm rounded-xl flex items-center justify-center text-white transition-transform group-hover:scale-105">
                                                            <i class="fas <%= theme.icon %> text-xs"></i>
                                                        </div>

                                                        <!-- Text Details -->
                                                        <div class="flex-1 min-w-0">
                                                            <h3 class="text-xs font-black text-slate-800 truncate group-hover:text-slate-950 transition-colors">
                                                                <%= item.title %>
                                                            </h3>
                                                            <div class="flex items-center gap-2 mt-1">
                                                                <span class="text-xs font-bold text-slate-600 uppercase tracking-wider truncate">
                                                                    <%= item.subject_code || item.subject_name %>
                                                                </span>
                                                                <% if (item.created_at) { %>
                                                                    <span class="text-slate-300 text-xs">·</span>
                                                                    <span class="text-[11px] font-medium text-slate-500 flex-shrink-0">
                                                                        <%= new Date(item.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                                                    </span>
                                                                <% } %>
                                                            </div>
                                                        </div>

                                                        <!-- Type/Status Indicator & Action Arrow -->
                                                        <div class="flex items-center gap-2 flex-shrink-0">
                                                            <span class="px-2.5 py-1 rounded-md bg-white border border-slate-100 text-xs font-black <%= theme.text %> shadow-xs">
                                                                <%= theme.label %>
                                                            </span>
                                                            <div class="w-8 h-8 rounded-xl bg-white shadow-sm border border-slate-100 flex items-center justify-center text-slate-400 group-hover:text-white <%= theme.hoverBtn %> transition-all">
                                                                <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            <% }) %>
                                        </div>
                                    <% } else { %>
                                        <!-- Empty State UI -->
                                        <div class="flex-1 min-h-[220px] py-8 px-4 flex flex-col items-center justify-center text-center bg-slate-50/70 rounded-2xl border border-dashed border-slate-200 w-full">
                                            <div class="w-14 h-14 bg-white rounded-2xl shadow-xs border border-slate-100 flex items-center justify-center mb-3 text-teal-500">
                                                <i class="fas fa-bell-slash text-2xl"></i>
                                            </div>
                                            <p class="text-xs font-black text-slate-800 uppercase tracking-wider">Quiet Feed</p>
                                            <p class="text-xs text-slate-500 font-medium mt-1 max-w-xs">No recent announcements, forum posts, or material updates yet.</p>
                                            <a href="/forums" class="mt-4 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-bold text-teal-600 hover:text-teal-800 hover:border-teal-300 shadow-xs transition">
                                                <span>Join Community Forums</span>
                                                <i class="fas fa-arrow-right text-[10px]"></i>
                                            </a>
                                        </div>
                                    <% } %>
                                </section>
                            </div>

                            <!-- Recent Forums Section -->
                            <section class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col">
                                <div class="flex items-center justify-between mb-6 flex-shrink-0">
                                    <h2 class="text-sm font-black text-slate-800 flex items-center gap-3">
                                        <div class="bg-gradient-to-tr from-amber-500 to-orange-400 p-2.5 rounded-xl shadow-md text-white">
                                            <i class="fas fa-comments text-xs"></i>
                                        </div>
                                        <span class="uppercase tracking-wider">Recent Forums</span>
                                    </h2>
                                    <a href="/forums" aria-label="View all forums" class="group/btn flex items-center gap-2 bg-slate-50 hover:bg-slate-800 px-3.5 py-1.5 rounded-xl border border-slate-200 shadow-xs transition">
                                        <span class="text-xs font-bold uppercase tracking-wider text-slate-700 group-hover/btn:text-white">View All</span>
                                        <i class="fas fa-chevron-right text-xs text-slate-500 group-hover/btn:text-white transition-transform group-hover/btn:translate-x-0.5"></i>
                                    </a>
                                </div>

                                <% if (recentForums && recentForums.length > 0) { %>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                        <% recentForums.slice(0, 2).forEach(forum => { %>
                                            <div class="group relative">
                                                <a href="/forums/view/<%= forum.forum_id %>" aria-label="Open discussion: <%= forum.title %>" class="relative flex items-center gap-4 p-4 bg-slate-50/80 rounded-2xl border border-slate-200/80 transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md hover:bg-white">
                                                    <!-- Forum Avatar/Icon -->
                                                    <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-amber-100 to-orange-100 rounded-xl flex items-center justify-center border border-amber-200/60 shadow-xs">
                                                        <i class="fas fa-comment-dots text-amber-600 text-lg"></i>
                                                    </div>

                                                    <!-- Content Details -->
                                                    <div class="flex-1 min-w-0">
                                                        <h3 class="text-sm font-black text-slate-800 truncate group-hover:text-amber-700 transition-colors">
                                                            <%= forum.title %>
                                                        </h3>
                                                        <div class="flex items-center gap-2 mt-1.5">
                                                            <span class="px-2 py-0.5 rounded-md bg-amber-500 text-white text-xs font-black uppercase tracking-wider">
                                                                <%= forum.subject_code %>
                                                            </span>
                                                            <span class="flex items-center gap-1 text-xs font-bold text-slate-600">
                                                                <i class="far fa-clock"></i>
                                                                <%= new Date(forum.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <!-- Hover Arrow -->
                                                    <div class="w-8 h-8 rounded-lg bg-white border border-slate-100 flex items-center justify-center text-slate-500 group-hover:bg-amber-500 group-hover:text-white transition-all">
                                                        <i class="fas fa-external-link-alt text-xs"></i>
                                                    </div>
                                                </a>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="flex-1 min-h-[160px] py-10 px-4 flex flex-col items-center justify-center text-center bg-slate-50/50 rounded-2xl border-2 border-dashed border-slate-200 w-full">
                                        <div class="w-14 h-14 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-3 text-slate-400">
                                            <i class="fas fa-inbox text-2xl"></i>
                                        </div>
                                        <p class="text-xs font-bold text-slate-600 uppercase tracking-widest">The floor is quiet</p>
                                        <p class="text-xs font-medium text-slate-500 mt-1 italic">Start a new discussion today!</p>
                                    </div>
                                <% } %>
                            </section>

                            <!-- Enrolled Subjects Section -->
                            <section class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col">
                                <div class="flex items-center justify-between mb-6 flex-shrink-0">
                                    <h2 class="text-sm font-black text-slate-800 flex items-center gap-3">
                                        <div class="bg-gradient-to-tr from-blue-600 to-cyan-500 p-2.5 rounded-xl shadow-md text-white">
                                            <i class="fas fa-graduation-cap text-xs"></i>
                                        </div>
                                        <span class="uppercase tracking-wider">Enrolled Subjects</span>
                                    </h2>
                                    <% if (typeof currentSY !== 'undefined' && currentSY) { %>
                                    <div class="flex items-center gap-1.5 px-3 py-1 rounded-full bg-emerald-50 border border-emerald-200/80 text-[11px] font-black text-emerald-800 shadow-xs">
                                        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                        <span>S.Y. <%= currentSY.sy_range %></span>
                                    </div>
                                    <% } %>
                                </div>

                                <% if (subjects && subjects.length > 0) { %>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
                                        <% subjects.forEach(subject => { %>
                                            <div class="group relative">
                                                <a href="/subjects/open/<%= subject.subject_id %>" aria-label="Open <%= subject.subject_name %> subject page" class="block relative bg-white rounded-2xl overflow-hidden border border-slate-200/80 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg cursor-pointer">
                                                    <!-- Subject Header Image -->
                                                    <div class="h-32 bg-slate-900 flex flex-col justify-between relative overflow-hidden">
                                                        <% 
                                                            var displayImg = (subject.subject_image && subject.subject_image !== 'default_subject.png') 
                                                                            ? subject.subject_image 
                                                                            : 'default_subject.png'; 
                                                        %>
                                                        <img src="/profile_uploads/<%= displayImg %>" 
                                                            alt="<%= subject.subject_name %>" 
                                                            class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-105 transition-transform duration-500"
                                                            onerror="this.src='/profile_uploads/default_subject.png'">

                                                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-900/30 to-slate-900/60 z-0"></div>
                                                        
                                                        <!-- Header Content -->
                                                        <div class="p-5 h-full flex flex-col justify-between relative z-10">
                                                            <div class="flex justify-between items-start">
                                                                <span class="px-2.5 py-1 rounded-md bg-slate-900/70 backdrop-blur-md border border-white/20 text-white text-xs font-black tracking-wider uppercase">
                                                                    <%= subject.subject_code %>
                                                                </span>
                                                                <div class="w-8 h-8 rounded-full bg-white/20 backdrop-blur-sm border border-white/20 flex items-center justify-center text-white group-hover:bg-blue-600 transition-all">
                                                                    <i class="fas fa-arrow-up-right-from-square text-xs"></i>
                                                                </div>
                                                            </div>

                                                            <h3 class="text-white font-black text-base md:text-lg leading-tight truncate group-hover:text-cyan-200 transition-colors">
                                                                <%= subject.subject_name %>
                                                            </h3>
                                                        </div>
                                                    </div>

                                                    <!-- Progress Section -->
                                                    <div class="p-5 bg-slate-50/50">
                                                        <div class="flex justify-between items-end mb-2.5">
                                                            <div>
                                                                <p class="text-xs font-bold text-slate-600 uppercase tracking-wider mb-0.5">Course Completion</p>
                                                                <p class="text-lg font-black text-slate-900">
                                                                    <%= subject.progress_percent || 0 %><span class="text-sm text-blue-600">%</span>
                                                                </p>
                                                            </div>
                                                            <span class="text-xs font-black px-2.5 py-1 rounded-md <%= (subject.progress_percent >= 100) ? 'bg-emerald-100 text-emerald-800' : 'bg-blue-100 text-blue-800' %>">
                                                                <%= (subject.progress_percent >= 100) ? 'COMPLETED' : 'IN PROGRESS' %>
                                                            </span>
                                                        </div>

                                                        <!-- Accessible Progress Bar -->
                                                        <div class="relative w-full h-2.5 bg-slate-200 rounded-full overflow-hidden shadow-inner"
                                                             role="progressbar" 
                                                             aria-valuenow="<%= subject.progress_percent || 0 %>" 
                                                             aria-valuemin="0" 
                                                             aria-valuemax="100" 
                                                             aria-label="Course completion progress for <%= subject.subject_name %>">
                                                            <div class="absolute inset-y-0 left-0 bg-gradient-to-r from-blue-600 via-indigo-500 to-cyan-400 h-full transition-all duration-700 ease-out" 
                                                                style="width:<%= Math.min(100, Math.max(0, subject.progress_percent || 0)) %>%">
                                                            </div>
                                                        </div>
                                                    </div>
                                                </a>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="flex-1 min-h-[180px] py-10 px-4 flex flex-col items-center justify-center text-center bg-slate-50/50 rounded-2xl border-2 border-dashed border-slate-200 w-full">
                                        <div class="w-14 h-14 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-3 text-slate-400">
                                            <i class="fas fa-graduation-cap text-2xl"></i>
                                        </div>
                                        <p class="text-xs font-bold text-slate-600 uppercase tracking-widest">No Enrolled Subjects</p>
                                        <p class="text-xs font-medium text-slate-500 mt-1 italic">You are not currently enrolled in any subjects for this academic year.</p>
                                        <a href="/home" class="mt-4 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-white border border-slate-200 text-xs font-bold text-blue-600 hover:text-blue-800 hover:border-blue-300 shadow-xs transition">
                                            <span>Enroll in Courses</span>
                                            <i class="fas fa-arrow-right text-[10px]"></i>
                                        </a>
                                    </div>
                                <% } %>

                                <!-- Collapsible Academic History / Past School Years Drawer -->
                                <% if (typeof archivedSubjects !== 'undefined' && archivedSubjects && archivedSubjects.length > 0) { %>
                                <div class="mt-6 pt-5 border-t border-slate-100">
                                    <details class="group bg-slate-50/70 rounded-2xl border border-slate-200/80 p-4 transition-all">
                                        <summary class="flex items-center justify-between cursor-pointer list-none select-none">
                                            <div class="flex items-center gap-2.5 text-xs font-bold text-slate-700">
                                                <i class="fas fa-box-archive text-slate-400 group-open:text-indigo-600 transition-colors"></i>
                                                <span>Completed Courses / Academic History</span>
                                                <span class="text-[10px] font-bold bg-slate-200 text-slate-700 px-2 py-0.5 rounded-full"><%= archivedSubjects.length %> archived</span>
                                            </div>
                                            <i class="fas fa-chevron-down text-slate-400 text-xs transition-transform duration-200 group-open:rotate-180"></i>
                                        </summary>
                                        <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3.5">
                                            <% archivedSubjects.forEach(arch => { %>
                                                <div class="p-3.5 rounded-xl bg-white border border-slate-200 flex items-center justify-between gap-3 shadow-2xs">
                                                    <div>
                                                        <div class="flex items-center gap-1.5 mb-1">
                                                            <span class="text-[10px] font-bold bg-slate-100 text-slate-600 px-1.5 py-0.5 rounded"><%= arch.sy_range %></span>
                                                            <span class="text-[10px] font-bold text-slate-400 uppercase"><%= arch.subject_code %></span>
                                                        </div>
                                                        <h4 class="text-xs font-bold text-slate-800"><%= arch.subject_name %></h4>
                                                        <p class="text-[11px] text-slate-400 mt-0.5"><%= arch.class_name %></p>
                                                    </div>
                                                    <div class="text-right flex flex-col items-end gap-1">
                                                        <span class="text-xs font-black text-slate-700"><%= arch.progress_percent %>%</span>
                                                        <a href="/subjects/open/<%= arch.subject_id %>" class="text-[10px] font-bold text-indigo-600 hover:underline">Review</a>
                                                    </div>
                                                </div>
                                            <% }); %>
                                        </div>
                                    </details>
                                </div>
                                <% } %>
                            </section>

                            <!-- Recent Completed Assignments & Performance Outcomes Section -->
                            <section class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col">
                                <div class="flex items-center justify-between mb-6 flex-shrink-0">
                                    <h2 class="text-sm font-black text-slate-800 flex items-center gap-3">
                                        <div class="bg-gradient-to-tr from-indigo-500 to-purple-400 p-2.5 rounded-xl shadow-md text-white">
                                            <i class="fas fa-file-signature text-xs"></i>
                                        </div>
                                        <span class="uppercase tracking-wider">Recent Completed Assignments</span>
                                    </h2>
                                    <% const assignmentsList = (typeof completedAssignments !== 'undefined' && completedAssignments) ? completedAssignments.slice(0, 2) : []; %>
                                    <% if (assignmentsList.length > 0) { %>
                                        <span class="text-xs font-black px-2.5 py-1 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-100 flex items-center gap-1.5">
                                            <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
                                            <%= assignmentsList.length %> Recorded
                                        </span>
                                    <% } %>
                                </div>

                                <% if (assignmentsList.length > 0) { %>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <% assignmentsList.forEach(asmt => { %>
                                            <% 
                                                const maxPts = asmt.total_possible_score || asmt.total_items || 100;
                                                const scoreVal = asmt.score_obtained != null ? Number(asmt.score_obtained) : 0;
                                                const pct = maxPts > 0 ? Math.min(100, Math.max(0, Math.round((scoreVal / maxPts) * 100))) : 0;
                                                
                                                let outcome = { label: 'Needs Review', text: 'text-rose-700', bg: 'bg-rose-50', border: 'border-rose-200', barGrad: 'from-rose-500 to-red-500', badgeIcon: 'fa-exclamation-circle' };
                                                if (pct >= 90) {
                                                    outcome = { label: 'Mastery', text: 'text-emerald-700', bg: 'bg-emerald-50', border: 'border-emerald-200', barGrad: 'from-emerald-500 to-teal-400', badgeIcon: 'fa-trophy' };
                                                } else if (pct >= 75) {
                                                    outcome = { label: 'Proficient', text: 'text-blue-700', bg: 'bg-blue-50', border: 'border-blue-200', barGrad: 'from-blue-600 to-cyan-500', badgeIcon: 'fa-medal' };
                                                } else if (pct >= 60) {
                                                    outcome = { label: 'Passing', text: 'text-amber-700', bg: 'bg-amber-50', border: 'border-amber-200', barGrad: 'from-amber-500 to-orange-400', badgeIcon: 'fa-check-circle' };
                                                }

                                                const asmtType = asmt.assessment_type || 'Assignment';
                                            %>
                                            <div class="group relative p-4 bg-gradient-to-br from-slate-50/80 via-white to-indigo-50/20 rounded-2xl border border-slate-200/90 hover:border-indigo-300 hover:shadow-md transition-all duration-200 cursor-pointer flex flex-col justify-between"
                                                 onclick="openResultModal(<%= asmt.assessment_id %>)"
                                                 role="button"
                                                 tabindex="0"
                                                 onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault(); openResultModal(<%= asmt.assessment_id %>);}"
                                                 aria-label="View detailed results for <%= asmt.assessment_name %>">
                                                
                                                <div>
                                                    <!-- Metadata Header -->
                                                    <div class="flex items-center justify-between gap-2 mb-2">
                                                        <div class="flex items-center gap-1.5 flex-wrap">
                                                            <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 tracking-wider">
                                                                <%= asmt.subject_code %>
                                                            </span>
                                                            <span class="text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 tracking-wider border border-indigo-100">
                                                                <%= asmtType %>
                                                            </span>
                                                        </div>
                                                        <span class="text-[10px] font-bold text-slate-400 flex items-center gap-1 shrink-0">
                                                            <i class="far fa-calendar-check text-slate-400"></i>
                                                            <%= new Date(asmt.completion_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                                        </span>
                                                    </div>

                                                    <!-- Title -->
                                                    <h3 class="text-sm font-black text-slate-800 line-clamp-1 group-hover:text-indigo-700 transition-colors">
                                                        <%= asmt.assessment_name %>
                                                    </h3>
                                                    <p class="text-[11px] font-medium text-slate-400 truncate mb-3">
                                                        <%= asmt.subject_name %>
                                                    </p>

                                                    <!-- Score & Performance Outcome -->
                                                    <div class="p-3 bg-white rounded-xl border border-slate-100 shadow-2xs mb-3 flex items-center justify-between">
                                                        <div>
                                                            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 block mb-0.5">Final Score</span>
                                                            <div class="flex items-baseline gap-1">
                                                                <span class="text-2xl font-black text-slate-900 leading-none"><%= scoreVal %></span>
                                                                <span class="text-xs font-bold text-slate-400">/<%= maxPts %></span>
                                                            </div>
                                                        </div>
                                                        <div class="text-right">
                                                            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 block mb-0.5">Outcome</span>
                                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-black border <%= outcome.bg %> <%= outcome.text %> <%= outcome.border %>">
                                                                <i class="fas <%= outcome.badgeIcon %> text-[10px]"></i>
                                                                <%= outcome.label %> · <%= pct %>%
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <!-- Micro Progress Bar -->
                                                    <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden mb-3">
                                                        <div class="h-full rounded-full bg-gradient-to-r <%= outcome.barGrad %> transition-all duration-500" style="width: <%= pct %>%"></div>
                                                    </div>

                                                    <% if (asmt.feedback) { %>
                                                        <div class="p-2 bg-indigo-50/60 rounded-lg border border-indigo-100/60 mb-2 flex items-start gap-1.5 text-[11px] text-indigo-900 font-medium">
                                                            <i class="fas fa-comment-dots text-indigo-500 mt-0.5 shrink-0"></i>
                                                            <span class="line-clamp-1 italic"><%= asmt.feedback %></span>
                                                        </div>
                                                    <% } %>
                                                </div>

                                                <!-- Interactive Footer -->
                                                <div class="pt-2 border-t border-slate-100/80 flex items-center justify-between mt-auto">
                                                    <span class="text-[11px] font-bold text-slate-500 group-hover:text-indigo-700 transition flex items-center gap-1.5">
                                                        <i class="fas fa-chart-pie text-xs text-indigo-500"></i>
                                                        <span>View Results &amp; Analytics</span>
                                                    </span>
                                                    <div class="w-7 h-7 rounded-lg bg-slate-50 group-hover:bg-indigo-600 text-slate-400 group-hover:text-white flex items-center justify-center transition-all duration-200 border border-slate-200/80 group-hover:border-indigo-600 shadow-2xs">
                                                        <i class="fas fa-arrow-right text-[10px]"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <!-- Empty State -->
                                    <div class="flex-1 min-h-[160px] py-10 px-4 flex flex-col items-center justify-center text-center bg-slate-50/50 rounded-2xl border-2 border-dashed border-slate-200 w-full">
                                        <div class="w-14 h-14 bg-white rounded-2xl shadow-xs flex items-center justify-center mb-3 text-slate-400">
                                            <i class="fas fa-file-signature text-2xl text-slate-400"></i>
                                        </div>
                                        <p class="text-xs font-bold text-slate-600 uppercase tracking-widest">No Completed Assignments</p>
                                        <p class="text-xs font-medium text-slate-500 mt-1 italic">When you submit assignments or coursework deliverables, your grades and feedback will appear here.</p>
                                    </div>
                                <% } %>
                            </section>

                            <!-- Recent Completed Assessments & Performance Outcomes Section -->
                            <section class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col">
                                <div class="flex items-center justify-between mb-6 flex-shrink-0">
                                    <h2 class="text-sm font-black text-slate-800 flex items-center gap-3">
                                        <div class="bg-gradient-to-tr from-emerald-500 to-teal-400 p-2.5 rounded-xl shadow-md text-white">
                                            <i class="fas fa-award text-xs"></i>
                                        </div>
                                        <span class="uppercase tracking-wider">Recent Completed Assessments</span>
                                    </h2>
                                    <% const assessmentsList = (typeof completedAssessments !== 'undefined' && completedAssessments) ? completedAssessments.slice(0, 2) : []; %>
                                    <% if (assessmentsList.length > 0) { %>
                                        <span class="text-xs font-black px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-100 flex items-center gap-1.5">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                            <%= assessmentsList.length %> Recorded
                                        </span>
                                    <% } %>
                                </div>

                                <% if (assessmentsList.length > 0) { %>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <% assessmentsList.forEach(asmt => { %>
                                            <% 
                                                const maxPts = asmt.total_possible_score || asmt.total_items || 100;
                                                const scoreVal = asmt.score_obtained != null ? Number(asmt.score_obtained) : 0;
                                                const pct = maxPts > 0 ? Math.min(100, Math.max(0, Math.round((scoreVal / maxPts) * 100))) : 0;
                                                
                                                let outcome = { label: 'Needs Review', text: 'text-rose-700', bg: 'bg-rose-50', border: 'border-rose-200', barGrad: 'from-rose-500 to-red-500', badgeIcon: 'fa-exclamation-circle' };
                                                if (pct >= 90) {
                                                    outcome = { label: 'Mastery', text: 'text-emerald-700', bg: 'bg-emerald-50', border: 'border-emerald-200', barGrad: 'from-emerald-500 to-teal-400', badgeIcon: 'fa-trophy' };
                                                } else if (pct >= 75) {
                                                    outcome = { label: 'Proficient', text: 'text-blue-700', bg: 'bg-blue-50', border: 'border-blue-200', barGrad: 'from-blue-600 to-cyan-500', badgeIcon: 'fa-medal' };
                                                } else if (pct >= 60) {
                                                    outcome = { label: 'Passing', text: 'text-amber-700', bg: 'bg-amber-50', border: 'border-amber-200', barGrad: 'from-amber-500 to-orange-400', badgeIcon: 'fa-check-circle' };
                                                }

                                                const asmtType = asmt.assessment_type || 'Assessment';
                                            %>
                                            <div class="group relative p-4 bg-gradient-to-br from-slate-50/80 via-white to-emerald-50/20 rounded-2xl border border-slate-200/90 hover:border-emerald-300 hover:shadow-md transition-all duration-200 cursor-pointer flex flex-col justify-between"
                                                 onclick="openResultModal(<%= asmt.assessment_id %>)"
                                                 role="button"
                                                 tabindex="0"
                                                 onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault(); openResultModal(<%= asmt.assessment_id %>);}"
                                                 aria-label="View detailed results for <%= asmt.assessment_name %>">
                                                
                                                <div>
                                                    <!-- Metadata Header -->
                                                    <div class="flex items-center justify-between gap-2 mb-2">
                                                        <div class="flex items-center gap-1.5 flex-wrap">
                                                            <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 tracking-wider">
                                                                <%= asmt.subject_code %>
                                                            </span>
                                                            <span class="text-[9px] font-extrabold uppercase px-2 py-0.5 rounded-md bg-emerald-50 text-emerald-700 tracking-wider border border-emerald-100">
                                                                <%= asmtType %>
                                                            </span>
                                                        </div>
                                                        <span class="text-[10px] font-bold text-slate-400 flex items-center gap-1 shrink-0">
                                                            <i class="far fa-calendar-check text-slate-400"></i>
                                                            <%= new Date(asmt.completion_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                                        </span>
                                                    </div>

                                                    <!-- Title -->
                                                    <h3 class="text-sm font-black text-slate-800 line-clamp-1 group-hover:text-emerald-700 transition-colors">
                                                        <%= asmt.assessment_name %>
                                                    </h3>
                                                    <p class="text-[11px] font-medium text-slate-400 truncate mb-3">
                                                        <%= asmt.subject_name %>
                                                    </p>

                                                    <!-- Score & Performance Outcome -->
                                                    <div class="p-3 bg-white rounded-xl border border-slate-100 shadow-2xs mb-3 flex items-center justify-between">
                                                        <div>
                                                            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 block mb-0.5">Final Score</span>
                                                            <div class="flex items-baseline gap-1">
                                                                <span class="text-2xl font-black text-slate-900 leading-none"><%= scoreVal %></span>
                                                                <span class="text-xs font-bold text-slate-400">/<%= maxPts %></span>
                                                            </div>
                                                        </div>
                                                        <div class="text-right">
                                                            <span class="text-[10px] font-extrabold uppercase tracking-wider text-slate-400 block mb-0.5">Outcome</span>
                                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-xs font-black border <%= outcome.bg %> <%= outcome.text %> <%= outcome.border %>">
                                                                <i class="fas <%= outcome.badgeIcon %> text-[10px]"></i>
                                                                <%= outcome.label %> · <%= pct %>%
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <!-- Micro Progress Bar -->
                                                    <div class="w-full h-1.5 bg-slate-100 rounded-full overflow-hidden mb-3">
                                                        <div class="h-full rounded-full bg-gradient-to-r <%= outcome.barGrad %> transition-all duration-500" style="width: <%= pct %>%"></div>
                                                    </div>

                                                    <% if (asmt.feedback) { %>
                                                        <div class="p-2 bg-indigo-50/60 rounded-lg border border-indigo-100/60 mb-2 flex items-start gap-1.5 text-[11px] text-indigo-900 font-medium">
                                                            <i class="fas fa-comment-dots text-indigo-500 mt-0.5 shrink-0"></i>
                                                            <span class="line-clamp-1 italic"><%= asmt.feedback %></span>
                                                        </div>
                                                    <% } %>
                                                </div>

                                                <!-- Interactive Footer -->
                                                <div class="pt-2 border-t border-slate-100/80 flex items-center justify-between mt-auto">
                                                    <span class="text-[11px] font-bold text-slate-500 group-hover:text-emerald-700 transition flex items-center gap-1.5">
                                                        <i class="fas fa-chart-pie text-xs text-emerald-500"></i>
                                                        <span>View Results &amp; Analytics</span>
                                                    </span>
                                                    <div class="w-7 h-7 rounded-lg bg-slate-50 group-hover:bg-emerald-600 text-slate-400 group-hover:text-white flex items-center justify-center transition-all duration-200 border border-slate-200/80 group-hover:border-emerald-600 shadow-2xs">
                                                        <i class="fas fa-arrow-right text-[10px]"></i>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <!-- Empty State -->
                                    <div class="flex-1 min-h-[160px] py-10 px-4 flex flex-col items-center justify-center text-center bg-slate-50/50 rounded-2xl border-2 border-dashed border-slate-200 w-full">
                                        <div class="w-14 h-14 bg-white rounded-2xl shadow-xs flex items-center justify-center mb-3 text-slate-400">
                                            <i class="fas fa-award text-2xl text-slate-400"></i>
                                        </div>
                                        <p class="text-xs font-bold text-slate-600 uppercase tracking-widest">No Completed Assessments</p>
                                        <p class="text-xs font-medium text-slate-500 mt-1 italic">When you complete quizzes, diagnostic tests, or arcade challenges, your scores and detailed performance analytics will appear here.</p>
                                    </div>
                                <% } %>
                            </section>
                        </div>

                        <!-- Right Sidebar Column -->
                        <div class="xl:col-span-4 space-y-8 xl:sticky xl:top-24 xl:self-start">
                            <!-- Calendar Section -->
                            <section class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col relative overflow-hidden">
                                <div class="flex items-center justify-between mb-6 relative z-10">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-500 shadow-md flex items-center justify-center text-white">
                                            <i class="fas fa-calendar-alt text-sm"></i>
                                        </div>
                                        <h2 class="text-lg font-black text-slate-800 tracking-tight">Calendar</h2>
                                    </div>
                                    <span class="text-xs font-bold text-blue-700 bg-blue-50 px-3.5 py-1.5 rounded-full border border-blue-100 uppercase tracking-wider">
                                        <%= new Date(year, month).toLocaleString('default',{month:'long'}) %> <%= year %>
                                    </span>
                                </div>

                                <!-- Days Header -->
                                <div class="grid grid-cols-7 gap-1 text-center mb-3 border-b border-slate-100 pb-2 relative z-10">
                                    <% ['S','M','T','W','T','F','S'].forEach(day => { %>
                                        <div class="text-xs text-slate-600 uppercase font-bold py-1"><%= day %></div>
                                    <% }) %>
                                </div>

                                <!-- Calendar Grid -->
                                <div class="grid grid-cols-7 gap-1.5 text-center relative z-10">
                                    <% calendarDays.forEach(day => { %>
                                        <% if(!day){ %>
                                            <div class="aspect-square"></div>
                                        <% } else { 
                                            const dayEvents = (events || []).filter(e => {
                                                const d = new Date(e.event_date);
                                                return d.getDate() === day && d.getMonth() === month && d.getFullYear() === year;
                                            });
                                            const hasEvent = dayEvents.length > 0;
                                            const hasAssessment = (dueDays || []).includes(day);
                                            const paddedMonth = String(month + 1).padStart(2, '0');
                                            const paddedDay = String(day).padStart(2, '0');
                                            const dateStr = `${year}-${paddedMonth}-${paddedDay}`;
                                            const dateFormatted = new Date(year, month, day).toLocaleDateString('default', { weekday: 'short', month: 'short', day: 'numeric', year: 'numeric' });
                                        %>
                                            <button type="button"
                                                class="calendar-day-btn aspect-square w-full flex items-center justify-center text-xs font-bold relative rounded-xl transition-all cursor-pointer focus:outline-none focus:ring-2 focus:ring-blue-500/50 hover:scale-105 active:scale-95 <%= hasEvent ? 'bg-orange-500 text-white shadow-sm font-black hover:bg-orange-600' : 'text-slate-700 hover:bg-slate-100' %>"
                                                data-date="<%= dateStr %>"
                                                data-date-label="<%= dateFormatted %>"
                                                data-events="<%= encodeURIComponent(JSON.stringify(dayEvents.map(e => ({
                                                    title: e.event_title || 'Campus Event',
                                                    type: e.event_type || 'Event',
                                                    location: e.event_location || '',
                                                    time: e.event_date ? new Date(e.event_date).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) : ''
                                                })))) %>"
                                                onclick="openEventModal('<%= dateStr %>')"
                                                aria-label="<%= dateFormatted %> - <%= dayEvents.length %> events">
                                                <%= day %>
                                                <% if(hasAssessment){ %>
                                                    <span class="absolute top-1 right-1 w-2 h-2 <%= hasEvent ? 'bg-white' : 'bg-rose-500' %> rounded-full ring-2 ring-white"></span>
                                                <% } %>
                                            </button>
                                        <% } %>
                                    <% }) %>
                                </div>

                                <!-- Live Peek Events -->
                                <div class="mt-8 space-y-3 relative z-10">
                                    <div class="flex items-center gap-2 mb-1">
                                        <span class="w-2 h-2 bg-orange-500 rounded-full animate-pulse"></span>
                                        <h3 class="text-xs font-bold uppercase text-slate-600 tracking-wider">Live Peek</h3>
                                    </div>

                                    <% if(events && events.length > 0){ %>
                                        <% events.slice(0, 4).forEach(event => { 
                                            const eventSubject = (typeof subjects !== 'undefined' && Array.isArray(subjects))
                                                ? subjects.find(s => String(s.subject_id) === String(event.subject_id))
                                                : null;
                                            const eventPayload = {
                                                event_id: event.event_id,
                                                event_title: event.event_title || 'Campus Event',
                                                event_description: event.event_description || '',
                                                event_type: event.event_type || 'General',
                                                event_date: event.event_date,
                                                event_location: event.event_location || '',
                                                duration_type: event.duration_type || 'None',
                                                start_date: event.start_date || null,
                                                end_date: event.end_date || null,
                                                duration_minutes: event.duration_minutes || null,
                                                is_repeatable: event.is_repeatable || 0,
                                                repeat_cycle: event.repeat_cycle || '',
                                                subject_id: event.subject_id || '',
                                                subject_name: eventSubject ? (eventSubject.subject_name || eventSubject.subject_code || '') : ''
                                            };
                                        %>
                                            <div class="p-3.5 bg-slate-50 hover:bg-white rounded-xl flex items-center gap-3 border border-slate-200/70 hover:border-orange-300 hover:shadow-md transition-all cursor-pointer group active:scale-[0.99]"
                                                 role="button"
                                                 tabindex="0"
                                                 aria-label="View details for <%= event.event_title || 'Campus Event' %>"
                                                 data-event="<%= encodeURIComponent(JSON.stringify(eventPayload)) %>"
                                                 onclick="openEventDetailsModal(this)"
                                                 onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault(); openEventDetailsModal(this);}">
                                                <div class="flex-shrink-0 w-11 h-11 bg-white rounded-lg flex flex-col items-center justify-center border border-slate-200 group-hover:border-orange-200 transition-colors">
                                                    <span class="text-xs font-bold text-slate-500 uppercase leading-none">
                                                        <%= new Date(event.event_date).toLocaleString('default', {month: 'short'}) %>
                                                    </span>
                                                    <span class="text-sm font-black text-slate-800">
                                                        <%= new Date(event.event_date).getDate() %>
                                                    </span>
                                                </div>

                                                <div class="min-w-0 flex-1">
                                                    <p class="text-xs text-slate-800 font-bold truncate group-hover:text-orange-600 transition-colors">
                                                        <%= event.event_title || 'Campus Event' %>
                                                    </p>
                                                    <p class="text-xs text-slate-500 font-medium">
                                                        Starts at <%= new Date(event.event_date).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %>
                                                    </p>
                                                </div>
                                                <div class="text-slate-300 group-hover:text-orange-500 transition-colors text-xs flex-shrink-0 pr-0.5">
                                                    <i class="fas fa-chevron-right"></i>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="py-8 px-4 flex flex-col items-center justify-center text-center border-2 border-dashed border-slate-200 rounded-xl w-full">
                                            <div class="w-10 h-10 bg-slate-50 rounded-full flex items-center justify-center mb-2 text-slate-400">
                                                <i class="far fa-calendar-check text-lg"></i>
                                            </div>
                                            <p class="text-xs font-bold text-slate-600 uppercase tracking-wider">Quiet Month</p>
                                            <p class="text-[11px] text-slate-400 mt-0.5">No upcoming events scheduled</p>
                                        </div>
                                    <% } %>
                                </div>
                            </section>

                            <!-- Recently Viewed Materials Section -->
                            <section class="bg-white p-6 rounded-3xl border border-slate-200/80 shadow-sm flex flex-col">
                                <h2 class="text-sm font-black text-slate-800 mb-5 flex items-center gap-3 flex-shrink-0">
                                    <div class="bg-gradient-to-tr from-fuchsia-500 to-pink-400 p-2.5 rounded-xl shadow-md text-white">
                                        <i class="fas fa-clock text-xs"></i>
                                    </div>
                                    <span class="uppercase tracking-wider">Recently Viewed</span>
                                </h2>

                                <% 
                                    const materialsList = (typeof recentMaterials !== 'undefined' && Array.isArray(recentMaterials)) ? recentMaterials : []; 
                                    if (materialsList.length > 0) { 
                                %>
                                    <div class="space-y-3">
                                        <% 
                                            const matIconMap = { pdf: 'fa-file-pdf', word: 'fa-file-word', img: 'fa-file-image', video: 'fa-file-video', link: 'fa-link', presentation: 'fa-file-powerpoint' }; 
                                            const matGradMap = {
                                                pdf: 'from-rose-500 to-red-600',
                                                word: 'from-blue-600 to-cyan-600',
                                                img: 'from-amber-500 to-orange-500',
                                                video: 'from-purple-600 to-indigo-600',
                                                presentation: 'from-orange-500 to-amber-600',
                                                link: 'from-emerald-500 to-teal-600'
                                            };
                                        %>
                                        <% materialsList.forEach(mat => { %>
                                            <div class="group relative p-3 bg-gradient-to-br from-slate-50/90 via-white to-fuchsia-50/30 rounded-2xl border border-slate-200/90 hover:border-fuchsia-300 hover:shadow-md transition-all duration-200 cursor-pointer flex items-center gap-3"
                                                 onclick="openMaterialPreview(<%= JSON.stringify(mat).replace(/"/g, '&quot;') %>)"
                                                 role="button"
                                                 tabindex="0"
                                                 onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault(); openMaterialPreview(<%= JSON.stringify(mat).replace(/"/g, '&quot;') %>);}"
                                                 aria-label="Preview <%= mat.title %>">
                                                
                                                <!-- Icon Badge -->
                                                <div class="w-10 h-10 rounded-xl flex items-center justify-center text-white shrink-0 shadow-xs transition-transform group-hover:scale-105 duration-200 bg-gradient-to-br <%= matGradMap[mat.material_type] || 'from-fuchsia-500 to-pink-500' %>">
                                                    <i class="fas <%= matIconMap[mat.material_type] || 'fa-file-alt' %> text-sm"></i>
                                                </div>

                                                <!-- Content Info -->
                                                <div class="min-w-0 flex-1">
                                                    <div class="flex items-center gap-2 mb-0.5">
                                                        <span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 tracking-wider">
                                                            <%= mat.subject_code %>
                                                        </span>
                                                        <span class="text-[10px] font-bold text-slate-400 capitalize">
                                                            <%= mat.interaction_type || 'Viewed' %>
                                                        </span>
                                                    </div>
                                                    <h3 class="text-xs font-black text-slate-800 line-clamp-1 leading-snug group-hover:text-fuchsia-700 transition-colors">
                                                        <%= mat.title %>
                                                    </h3>
                                                    <% if (mat.ai_summary) { %>
                                                        <p class="text-[10px] font-semibold text-fuchsia-600 flex items-center gap-1 mt-0.5">
                                                            <i class="fas fa-sparkles text-[8px]"></i> AI Summary available
                                                        </p>
                                                    <% } %>
                                                </div>

                                                <!-- Interactive Action Button (Directly opens learning material) -->
                                                <button type="button"
                                                        onclick="openMaterialDirectly(event, <%= JSON.stringify(mat).replace(/"/g, '&quot;') %>)"
                                                        onkeydown="event.stopPropagation()"
                                                        title="Directly open <%= mat.title %>"
                                                        aria-label="Directly open <%= mat.title %>"
                                                        class="w-8 h-8 rounded-xl bg-slate-50 group-hover:bg-fuchsia-600 text-slate-400 group-hover:text-white hover:!bg-fuchsia-700 hover:!text-white hover:scale-110 active:scale-95 focus:outline-none focus:ring-2 focus:ring-fuchsia-400 focus:ring-offset-1 flex items-center justify-center shrink-0 transition-all duration-200 border border-slate-200/80 group-hover:border-fuchsia-600 hover:!border-fuchsia-700 shadow-2xs cursor-pointer z-10">
                                                    <i class="fas fa-arrow-right text-[11px] transition-transform group-hover:translate-x-0.5"></i>
                                                </button>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } else { %>
                                    <div class="flex-1 min-h-[140px] py-8 px-4 flex flex-col items-center justify-center text-center bg-slate-50/50 rounded-2xl border border-dashed border-slate-200 w-full">
                                        <div class="w-12 h-12 bg-white rounded-xl shadow-xs flex items-center justify-center mb-2 text-slate-400">
                                            <i class="fas fa-book-reader text-lg"></i>
                                        </div>
                                        <p class="text-xs font-bold text-slate-600 uppercase tracking-wider">No Recently Viewed Materials</p>
                                        <p class="text-[11px] text-slate-400 mt-0.5">Materials you access in your subjects will appear here</p>
                                    </div>
                                <% } %>
                            </section>
                        </div>
                    </div>
                </div>

                <!-- Footer -->
                <footer class="mt-auto py-6 px-8 border-t border-slate-200 bg-white/70">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
