                                                            <%= subject.subject_name %>
                                                        </h4>
                                                    </div>
                                                </div>

                                                <!-- Progress Section: Glassmorphism Style -->
                                                <div class="p-6 bg-gradient-to-b from-transparent to-white/30">
                                                    <div class="flex justify-between items-end mb-3">
                                                        <div>
                                                            <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mb-0.5">Course Completion</p>
                                                            <p class="text-xl font-black text-slate-800">
                                                                <%= subject.progress_percent || 0 %><span class="text-sm text-blue-500">%</span>
                                                            </p>
                                                        </div>
                                                        <!-- Status Badge -->
                                                        <span class="text-[8px] font-black px-2 py-1 rounded-md <%= (subject.progress_percent >= 100) ? 'bg-emerald-100 text-emerald-600' : 'bg-blue-50 text-blue-600' %>">
                                                            <%= (subject.progress_percent >= 100) ? 'COMPLETED' : 'IN PROGRESS' %>
                                                        </span>
                                                    </div>

                                                    <!-- Modernized Progress Bar -->
                                                    <div class="relative w-full h-3 bg-slate-100 rounded-full overflow-hidden shadow-inner">
                                                        <div class="absolute inset-y-0 left-0 bg-gradient-to-r from-blue-600 via-indigo-500 to-cyan-400 h-full transition-all duration-[1500ms] ease-out group-hover:brightness-110 shadow-[0_0_15px_rgba(37,99,235,0.3)]" 
                                                            style="width:<%= subject.progress_percent || 0 %>%">
                                                            <!-- Animating Shine Effect -->
                                                            <div class="absolute inset-0 bg-gradient-to-r from-transparent via-white/20 to-transparent skew-x-12 translate-x-[-100%] group-hover:translate-x-[200%] transition-transform duration-1000"></div>
