                                                                <%= subject.subject_code %>
                                                            </span>
                                                            <div class="w-8 h-8 rounded-full bg-white/10 backdrop-blur-sm border border-white/10 flex items-center justify-center group-hover:bg-blue-500 group-hover:border-blue-400 transition-all duration-300">
                                                                <i class="fas fa-arrow-up-right-from-square text-white text-[10px]"></i>
                                                            </div>
                                                        </div>

