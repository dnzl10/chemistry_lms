                            <section class="bg-cyan p-6 rounded-[2.5rem] border border-slate-100 shadow-[0_20px_50px_rgba(0,0,0,0.05)]">
                                <!-- Header with Indigo-Violet Polish -->
                                <h2 class="text-sm font-black text-slate-800 mb-6 flex items-center gap-3">
                                    <div class="bg-gradient-to-tr from-blue-600 to-cyan-500 p-2.5 rounded-2xl shadow-lg shadow-blue-100">
                                        <i class="fas fa-graduation-cap text-white text-xs"></i>
                                    </div>
