                                            <div class="w-14 h-14 bg-white rounded-3xl shadow-sm flex items-center justify-center mb-4">
                                                <i class="fas fa-inbox text-slate-200 text-xl"></i>
                                            </div>
                                            <p class="text-[11px] font-black text-slate-400 uppercase tracking-[0.25em]">The floor is quiet</p>
                                            <p class="text-[9px] font-bold text-slate-300 mt-1 italic">Start a new discussion today!</p>
                                        </div>
