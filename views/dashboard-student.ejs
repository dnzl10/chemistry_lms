    <!-- Assessment Comprehensive Results & Analytics Modal -->
    <div id="assessmentResultModal" 
         class="fixed inset-0 bg-black/60 backdrop-blur-sm hidden z-[200] flex items-center justify-center p-2 md:p-4 cursor-pointer"
         role="dialog" 
         aria-modal="true" 
         aria-labelledby="armTitle" 
         onclick="if(event.target === this) closeResultModal()">
        <div class="bg-white rounded-3xl w-full max-w-3xl max-h-[94vh] flex flex-col overflow-hidden shadow-2xl cursor-default border border-slate-200 animate-in fade-in zoom-in-95 duration-200">

            <!-- Modal Header -->
            <div style="background:linear-gradient(135deg,#0d1a2e,#0891b2);padding:18px 22px;flex-shrink:0;">
                <div class="flex items-center justify-between">
                    <div>
                        <h3 id="armTitle" style="font-size:16px;font-weight:900;color:#fff;margin-bottom:3px;">Assessment Result</h3>
                        <p id="armMeta" style="font-size:12px;color:rgba(199,210,254,0.8);font-weight:600;"></p>
                    </div>
                    <button type="button" onclick="closeResultModal()" aria-label="Close assessment result" style="width:32px;height:32px;border-radius:50%;background:rgba(255,255,255,0.15);border:none;cursor:pointer;color:#fff;font-size:16px;" class="hover:bg-white/25 transition">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
                <!-- Tab Pills -->
                <div role="tablist" aria-label="Result Sections" style="display:flex;gap:6px;margin-top:14px;">
                    <button class="amodal-tab-pill active" id="armTabAnalysis" role="tab" aria-selected="true" aria-controls="armAnalysis" onclick="switchArmTab('analysis')">
                        <i class="fas fa-chart-pie" style="margin-right:5px;"></i>Analysis
                    </button>
                    <button class="amodal-tab-pill" id="armTabReview" role="tab" aria-selected="false" aria-controls="armReview" onclick="switchArmTab('review')">
                        <i class="fas fa-book-open" style="margin-right:5px;"></i>Review &amp; Remediation
                    </button>
                </div>
            </div>

            <!-- Modal Body -->
            <div class="flex-1 overflow-y-auto no-scrollbar" style="background:#f8fafc;">
                <!-- Loading State -->
                <div id="armLoader" style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:60px;gap:12px;">
                    <div style="width:36px;height:36px;border-radius:50%;border:4px solid #e0e7ff;border-top-color:#0891b2;animation:spin 0.8s linear infinite;"></div>
                    <p style="font-size:14px;color:#94a3b8;font-weight:700;">Loading detailed assessment insights...</p>
                </div>

                <!-- Analysis Tab -->
                <div id="armAnalysis" style="display:none;padding:20px;gap:16px;flex-direction:column;">

                    <!-- Score Summary Row -->
                    <div style="display:grid;grid-template-columns:auto 1fr;gap:16px;align-items:center;background:#fff;border-radius:16px;padding:16px;border:1.5px solid #e0e7ff;">
                        <!-- Pie Chart -->
                        <div style="position:relative;width:110px;height:110px;flex-shrink:0;">
                            <canvas id="armPieChart" width="110" height="110"></canvas>
                            <div style="position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;pointer-events:none;">
                                <span id="armScorePct" style="font-size:20px;font-weight:900;color:#1e293b;line-height:1;"></span>
                                <span style="font-size:10px;font-weight:800;color:#94a3b8;margin-top:2px;">SCORE</span>
                            </div>
                        </div>
                        <!-- Stats Tiles -->
                        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
                            <div style="background:#ecfeff;border-radius:12px;padding:10px 14px;">
                                <p style="font-size:11px;font-weight:800;color:#0891b2;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:3px;">Final Score</p>
                                <p id="armScoreVal" style="font-size:18px;font-weight:900;color:#0891b2;line-height:1;"></p>
                            </div>
                            <div style="background:#fef9c3;border-radius:12px;padding:10px 14px;">
                                <p style="font-size:11px;font-weight:800;color:#a16207;text-transform:uppercase;letter-spacing:0.07em;margin-bottom:3px;">Total Items</p>
                                <p id="armItemsVal" style="font-size:18px;font-weight:900;color:#854d0e;line-height:1;"></p>
                            </div>
                        </div>
                    </div>

                    <!-- Rubric Breakdown Container (for assignments) -->
                    <div id="armRubricContainer" style="display:none;background:#fff;border-radius:16px;padding:16px;border:1.5px solid #e0e7ff;">
                        <div class="flex items-center gap-2 mb-3 text-indigo-700 font-extrabold text-xs uppercase tracking-wider">
                            <i class="fas fa-tasks text-indigo-500"></i>
                            <span>Rubric Criteria Breakdown</span>
                        </div>
                        <div id="armRubricList" class="space-y-3"></div>
                    </div>

                    <!-- Teacher Feedback Box -->
                    <div id="armFeedbackBox" style="display:none;background:#eef2ff;border:1.5px solid #c7d2fe;border-radius:16px;padding:14px 16px;">
                        <span style="font-size:11px;font-weight:800;color:#4338ca;text-transform:uppercase;letter-spacing:0.05em;display:flex;align-items:center;gap:6px;margin-bottom:4px;">
                            <i class="fas fa-comment-alt text-indigo-500"></i> Teacher Feedback
                        </span>
                        <p id="armFeedbackText" style="font-size:13px;font-weight:600;color:#1e293b;line-height:1.5;margin:0;"></p>
                    </div>

                    <!-- Questions / Responses List -->
                    <div id="armQuestionsList" style="display:flex;flex-direction:column;gap:12px;"></div>
                </div>

                <!-- Review Tab -->
                <div id="armReview" style="display:none;padding:20px;">
                    <div id="armReviewList" style="display:flex;flex-direction:column;gap:14px;"></div>
                </div>
            </div>

            <!-- Modal Footer -->
            <div class="flex items-center justify-between p-4 border-t border-slate-100 bg-white shrink-0">
                <span class="text-xs text-slate-400 font-medium">Elementa Chemistry Diagnostic Suite</span>
                <button type="button" 
                        onclick="closeResultModal()" 
                        class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs transition">
                    Close Result
                </button>
            </div>
        </div>
    </div>

    <!-- Modal: View All Upcoming Assessments -->
    <div id="allUpcomingModal" class="fixed inset-0 z-[200] bg-slate-950/70 backdrop-blur-sm hidden items-center justify-center p-4 cursor-pointer" role="dialog" aria-modal="true" aria-labelledby="allUpcomingModalTitle" onclick="if(event.target === this) closeViewAllUpcomingModal()">
        <div class="bg-white rounded-3xl max-w-2xl w-full p-6 md:p-8 shadow-2xl border border-slate-100 transform transition-all relative cursor-default max-h-[90vh] flex flex-col">
            <!-- Header -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 flex-shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-violet-500 text-white flex items-center justify-center shadow-md">
                        <i class="fas fa-clipboard-list text-sm"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 id="allUpcomingModalTitle" class="text-base font-black text-slate-800 tracking-tight">All Upcoming Assessments</h3>
                            <span class="px-2 py-0.5 rounded-full bg-indigo-50 border border-indigo-100 text-indigo-700 text-xs font-black">
                                <%= (typeof upcomingTasks !== 'undefined' && Array.isArray(upcomingTasks)) ? upcomingTasks.length : 0 %>
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 font-medium">Click any assessment to open its coursework directly</p>
                    </div>
                </div>
                <div class="flex items-center gap-2">
                    <a href="/events" class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-slate-50 hover:bg-slate-100 border border-slate-200 text-xs font-bold text-slate-700 transition" title="Open Calendar">
                        <i class="fas fa-calendar-alt text-indigo-600"></i>
                        <span>Calendar</span>
                    </a>
                    <button type="button" onclick="closeViewAllUpcomingModal()" aria-label="Close dialog" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-400 hover:text-slate-600 transition flex items-center justify-center text-sm">
                        <i class="fas fa-times"></i>
                    </button>
                </div>
            </div>

            <!-- Body List -->
            <div class="flex-1 overflow-y-auto py-4 space-y-3 no-scrollbar">
                <% 
                    const allTasksList = (typeof upcomingTasks !== 'undefined' && Array.isArray(upcomingTasks)) ? upcomingTasks : [];
                    if (allTasksList.length > 0) { 
                %>
                    <% allTasksList.forEach(task => { 
                        const assessmentType = (task.assessment_type || 'assessment').toLowerCase();
                        const isQuiz = assessmentType === 'quiz';
                        const isAssignment = assessmentType === 'assignment';
                        const tabName = isAssignment ? 'assignments' : 'assessments';
                        const anchorId = isAssignment ? `asgn-card-${task.assessment_id}` : `assessment-${task.assessment_id}`;
                        const targetUrl = task.subject_id 
                            ? `/subjects/open/${task.subject_id}?tab=${tabName}&assessment_id=${task.assessment_id}${task.topic_id ? '&topic_id=' + task.topic_id : ''}#${anchorId}` 
                            : '/subjects';
                        
                        const theme = isQuiz 
                            ? { 
                                card: 'bg-gradient-to-r from-orange-50/80 to-rose-50/50 hover:from-orange-100/90 hover:to-rose-100/70', 
                                border: 'border-orange-100 hover:border-orange-300', 
                                badge: 'bg-gradient-to-br from-orange-500 to-rose-500',
                                text: 'text-orange-600',
                                hoverBtn: 'group-hover:bg-orange-600'
                            }
                            : { 
                                card: 'bg-gradient-to-r from-blue-50/80 to-indigo-50/50 hover:from-blue-100/90 hover:to-indigo-100/70', 
                                border: 'border-blue-100 hover:border-indigo-300', 
                                badge: 'bg-gradient-to-br from-blue-600 to-indigo-600',
                                text: 'text-blue-600',
                                hoverBtn: 'group-hover:bg-indigo-600'
                            };
                    %>
                        <a href="<%= targetUrl %>" 
                           aria-label="Open <%= task.assessment_name %> assessment"
                           class="group block relative p-4 <%= theme.card %> rounded-2xl border <%= theme.border %> transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md cursor-pointer">
                            <div class="flex items-center gap-4">
                                <!-- Badge Section -->
                                <div class="flex-shrink-0 w-12 h-12 <%= theme.badge %> shadow-md rounded-xl flex flex-col items-center justify-center text-white transition-transform group-hover:scale-105">
                                    <i class="fas <%= isQuiz ? 'fa-bolt' : 'fa-book-open' %> text-xs mb-0.5"></i>
                                    <span class="text-[10px] font-black uppercase tracking-tighter"><%= task.assessment_type || 'Task' %></span>
                                </div>

                                <!-- Text Details -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex items-center gap-1.5 mb-1 flex-wrap">
                                        <% if (task.subject_code) { %>
                                            <span class="text-[10px] font-black px-2 py-0.5 rounded-md bg-white/90 border border-slate-200/60 text-slate-700 uppercase tracking-wider">
                                                <%= task.subject_code %>
                                            </span>
                                        <% } %>
                                        <% if (task.category) { %>
                                            <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 uppercase tracking-wider">
                                                <%= task.category %>
                                            </span>
                                        <% } %>
                                        <% if (task.subject_name) { %>
                                            <span class="text-xs font-bold text-slate-500 truncate">
                                                <%= task.subject_name %>
                                            </span>
                                        <% } %>
                                    </div>
                                    <h4 class="text-sm font-black text-slate-800 truncate group-hover:text-indigo-950 transition-colors">
                                        <%= task.assessment_name %>
                                    </h4>
                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="flex items-center gap-1 px-2.5 py-0.5 rounded-full bg-white border border-slate-100 text-xs font-bold <%= theme.text %> shadow-xs">
                                            <i class="far fa-clock"></i>
                                            Due: <%= new Date(task.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                        </span>
                                    </div>
                                </div>

                                <!-- Action Arrow -->
                                <div class="w-9 h-9 rounded-xl bg-white shadow-sm border border-slate-100 flex items-center justify-center text-slate-500 group-hover:text-white <%= theme.hoverBtn %> transition-all flex-shrink-0">
                                    <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div class="py-12 flex flex-col items-center justify-center text-center bg-slate-50/70 rounded-2xl border border-dashed border-slate-200">
                        <div class="w-14 h-14 bg-white rounded-2xl shadow-xs border border-slate-100 flex items-center justify-center mb-3 text-emerald-500">
                            <i class="fas fa-clipboard-check text-2xl"></i>
                        </div>
                        <p class="text-xs font-black text-slate-800 uppercase tracking-wider">All Caught Up!</p>
                        <p class="text-xs text-slate-500 font-medium mt-1">No pending assessments or tasks scheduled.</p>
                    </div>
                <% } %>
            </div>

            <!-- Footer -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-between flex-shrink-0">
                <a href="/events" class="text-xs font-bold text-indigo-600 hover:text-indigo-800 flex items-center gap-1.5 transition">
                    <i class="fas fa-calendar-days"></i>
                    <span>Open Events & Deadlines Calendar</span>
                </a>
                <button type="button" onclick="closeViewAllUpcomingModal()" class="py-2 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition">
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- Modal: View All Recent Updates -->
    <div id="allUpdatesModal" class="fixed inset-0 z-[200] bg-slate-950/70 backdrop-blur-sm hidden items-center justify-center p-4 cursor-pointer" role="dialog" aria-modal="true" aria-labelledby="allUpdatesModalTitle" onclick="if(event.target === this) closeViewAllUpdatesModal()">
        <div class="bg-white rounded-3xl max-w-2xl w-full p-6 md:p-8 shadow-2xl border border-slate-100 transform transition-all relative cursor-default max-h-[90vh] flex flex-col">
            <!-- Header -->
            <div class="flex items-center justify-between pb-4 border-b border-slate-100 flex-shrink-0">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-emerald-500 to-teal-400 text-white flex items-center justify-center shadow-md">
                        <i class="fas fa-history text-sm"></i>
                    </div>
                    <div>
                        <div class="flex items-center gap-2">
                            <h3 id="allUpdatesModalTitle" class="text-base font-black text-slate-800 tracking-tight">Recent Activity Feed</h3>
                            <span class="px-2 py-0.5 rounded-full bg-emerald-50 border border-emerald-100 text-emerald-700 text-xs font-black">
                                <%= (typeof recentUpdates !== 'undefined' && Array.isArray(recentUpdates)) ? recentUpdates.length : 0 %>
                            </span>
                        </div>
                        <p class="text-xs text-slate-500 font-medium">Click any update to jump directly to that content</p>
                    </div>
                </div>
                <button type="button" onclick="closeViewAllUpdatesModal()" aria-label="Close dialog" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-400 hover:text-slate-600 transition flex items-center justify-center text-sm">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Category Filter Tabs -->
            <div class="flex items-center gap-2 py-3 border-b border-slate-100 overflow-x-auto no-scrollbar flex-shrink-0">
                <button type="button" onclick="filterUpdatesModal('all', this)" class="update-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-900 text-white shadow-xs transition cursor-pointer" data-filter="all">
                    All (<%= (typeof recentUpdates !== 'undefined' && Array.isArray(recentUpdates)) ? recentUpdates.length : 0 %>)
                </button>
                <button type="button" onclick="filterUpdatesModal('announcement', this)" class="update-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition cursor-pointer" data-filter="announcement">
                    Announcements
                </button>
                <button type="button" onclick="filterUpdatesModal('forum', this)" class="update-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition cursor-pointer" data-filter="forum">
                    Forums
                </button>
                <button type="button" onclick="filterUpdatesModal('assessment', this)" class="update-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition cursor-pointer" data-filter="assessment">
                    Assessments
                </button>
                <button type="button" onclick="filterUpdatesModal('material', this)" class="update-filter-btn px-3 py-1.5 rounded-xl text-xs font-bold bg-slate-100 text-slate-600 hover:bg-slate-200 transition cursor-pointer" data-filter="material">
                    Materials
                </button>
            </div>

            <!-- Body List -->
            <div class="flex-1 overflow-y-auto py-4 space-y-3 no-scrollbar" id="modalUpdatesList">
                <% 
                    const allUpdatesList = (typeof recentUpdates !== 'undefined' && Array.isArray(recentUpdates)) ? recentUpdates : [];
                    if (allUpdatesList.length > 0) { 
                %>
                    <% allUpdatesList.forEach(item => { 
                        const typeMap = {
                            announcement: { icon: 'fa-bullhorn', badge: 'bg-gradient-to-br from-emerald-500 to-teal-500', card: 'bg-gradient-to-r from-emerald-50/80 to-teal-50/50 hover:from-emerald-100/90 hover:to-teal-100/70', border: 'border-emerald-100 hover:border-emerald-300', text: 'text-emerald-700', label: 'ANNOUNCEMENT', hoverBtn: 'group-hover:bg-emerald-600' },
                            forum:        { icon: 'fa-comment-dots', badge: 'bg-gradient-to-br from-amber-500 to-orange-500', card: 'bg-gradient-to-r from-amber-50/80 to-orange-50/50 hover:from-amber-100/90 hover:to-orange-100/70', border: 'border-amber-100 hover:border-amber-300', text: 'text-amber-700', label: 'FORUM', hoverBtn: 'group-hover:bg-amber-600' },
                            material:     { icon: 'fa-book-open', badge: 'bg-gradient-to-br from-sky-500 to-cyan-500', card: 'bg-gradient-to-r from-sky-50/80 to-cyan-50/50 hover:from-sky-100/90 hover:to-cyan-100/70', border: 'border-sky-100 hover:border-sky-300', text: 'text-sky-700', label: 'MATERIAL', hoverBtn: 'group-hover:bg-sky-600' },
                            assessment:   { icon: 'fa-file-pen', badge: 'bg-gradient-to-br from-violet-500 to-purple-500', card: 'bg-gradient-to-r from-violet-50/80 to-purple-50/50 hover:from-violet-100/90 hover:to-purple-100/70', border: 'border-violet-100 hover:border-violet-300', text: 'text-violet-700', label: 'ASSESSMENT', hoverBtn: 'group-hover:bg-violet-600' },
                        };
                        const theme = typeMap[item.update_type] || typeMap.announcement;
                        const targetUrl = item.link_url || (item.subject_id ? `/subjects/open/${item.subject_id}` : '/dashboard');
                    %>
                        <a href="<%= targetUrl %>" 
                           data-update-type="<%= item.update_type %>"
                           aria-label="Open <%= item.title %> (<%= theme.label %>)"
                           class="modal-update-item group block relative p-4 <%= theme.card %> rounded-2xl border <%= theme.border %> transition-all duration-200 hover:-translate-y-0.5 hover:shadow-md cursor-pointer">
                            <div class="flex items-center gap-4">
                                <!-- Badge Icon -->
                                <div class="flex-shrink-0 w-11 h-11 <%= theme.badge %> shadow-sm rounded-xl flex items-center justify-center text-white transition-transform group-hover:scale-105">
                                    <i class="fas <%= theme.icon %> text-xs"></i>
                                </div>

                                <!-- Text Details -->
                                <div class="flex-1 min-w-0">
                                    <h4 class="text-xs font-black text-slate-800 truncate group-hover:text-slate-950 transition-colors">
                                        <%= item.title %>
                                    </h4>
                                    <div class="flex items-center gap-2 mt-1">
                                        <span class="text-xs font-bold text-slate-600 uppercase tracking-wider truncate">
                                            <%= item.subject_code || item.subject_name %>
                                        </span>
                                        <% if (item.created_at) { %>
                                            <span class="text-slate-300 text-xs">·</span>
                                            <span class="text-[11px] font-medium text-slate-500 flex-shrink-0">
                                                <%= new Date(item.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                            </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Type/Status Indicator & Action Arrow -->
                                <div class="flex items-center gap-2 flex-shrink-0">
                                    <span class="px-2.5 py-1 rounded-md bg-white border border-slate-100 text-xs font-black <%= theme.text %> shadow-xs">
                                        <%= theme.label %>
                                    </span>
                                    <div class="w-8 h-8 rounded-xl bg-white shadow-sm border border-slate-100 flex items-center justify-center text-slate-400 group-hover:text-white <%= theme.hoverBtn %> transition-all">
                                        <i class="fas fa-arrow-right text-xs transition-transform group-hover:translate-x-0.5"></i>
                                    </div>
                                </div>
                            </div>
                        </a>
                    <% }) %>
                <% } else { %>
                    <div class="py-12 flex flex-col items-center justify-center text-center bg-slate-50/70 rounded-2xl border border-dashed border-slate-200">
                        <div class="w-14 h-14 bg-white rounded-2xl shadow-xs border border-slate-100 flex items-center justify-center mb-3 text-teal-500">
                            <i class="fas fa-bell-slash text-2xl"></i>
                        </div>
                        <p class="text-xs font-black text-slate-800 uppercase tracking-wider">Quiet Feed</p>
                        <p class="text-xs text-slate-500 font-medium mt-1">No recent updates recorded yet.</p>
                    </div>
                <% } %>
            </div>

            <!-- Footer -->
            <div class="pt-4 border-t border-slate-100 flex items-center justify-end flex-shrink-0">
                <button type="button" onclick="closeViewAllUpdatesModal()" class="py-2 px-4 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition cursor-pointer">
                    Close
                </button>
            </div>
        </div>
    </div>

