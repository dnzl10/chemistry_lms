                                <!-- Decorative Aura Background -->
                                <div class="absolute -right-10 -top-10 w-32 h-32 bg-blue-50 rounded-full blur-3xl opacity-0 group-hover/calendar:opacity-100 transition-opacity duration-700"></div>

                                <!-- Header Section -->
                                <div class="flex items-center justify-between mb-8 relative z-10">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-blue-600 to-indigo-500 shadow-lg shadow-blue-100 flex items-center justify-center text-white">
                                            <i class="fas fa-calendar-alt text-sm"></i>
                                        </div>
                                        <h2 class="text-xl font-black text-slate-800 tracking-tight">Calendar</h2>
                                    </div>
                                    <span class="text-[10px] font-black text-blue-600 bg-blue-50 px-4 py-1.5 rounded-full border border-blue-100 uppercase tracking-widest">
                                        <%= new Date(year, month).toLocaleString('default',{month:'long'}) %> <%= year %>
                                    </span>
                                </div>

                                <!-- Days Header (Signpost Pattern) -->
                                <div class="grid grid-cols-7 gap-1 text-center mb-4 border-b border-slate-50 pb-2 relative z-10">
                                    <% ['S','M','T','W','T','F','S'].forEach(day => { %>
                                        <div class="text-[10px] text-slate-400 uppercase font-black py-2 tracking-tighter"><%= day %></div>
                                    <% }) %>
                                </div>

                                <!-- Calendar Grid -->
                                <div class="grid grid-cols-7 gap-2 text-center relative z-10">
                                    <% calendarDays.forEach(day => { %>
                                        <% if(!day){ %>
                                            <div class="aspect-square"></div>
                                        <% } else { 
                                            const hasEvent = events.some(e => {
                                                const d = new Date(e.event_date).getDate();
                                                const m = new Date(e.event_date).getMonth();
                                                return d === day && m === month;
                                            });
                                            const hasAssessment = (dueDays || []).includes(day);
                                        %>
                                            <div class="group/day aspect-square flex items-center justify-center text-[11px] font-black relative cursor-pointer transition-all duration-300
                                                <%= hasEvent ? 'bg-orange-500 text-white shadow-lg shadow-orange-200 rounded-xl scale-110 z-10' : 'text-slate-600 hover:bg-slate-100 rounded-xl hover:scale-105 hover:text-blue-600' %>">
                                                
                                                <%= day %>

                                                <!-- Task Indicator (Red Dot) -->
                                                <% if(hasAssessment){ %>
                                                    <span class="absolute top-1.5 right-1.5 w-1.5 h-1.5 <%= hasEvent ? 'bg-white' : 'bg-rose-500' %> rounded-full ring-2 ring-white"></span>
