<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        
        @media (max-width: 768px) {
            .sidebar-collapsed { transform: translateX(-100%); }
            .sidebar-open { transform: translateX(0); }
        }

        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        
        .glass-effect {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
        }

        .nav-active {
            background: linear-gradient(135deg, #06b6d4 0%, #FFFFFF 100%) !important;
            color: white !important;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(6,182,212,0.3), 0 2px 8px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="bg-gradient-to-br from-slate-50 via-white to-indigo-50/30 text-slate-900 min-h-screen">

    <div class="flex min-h-screen relative overflow-x-hidden">
        <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-slate-900/50 z-40 hidden md:hidden"></div>

        <aside id="sidebar" class="text-white w-64 flex-shrink-0 flex flex-col z-50 fixed inset-y-0 left-0 -translate-x-full md:translate-x-0 h-screen border-r border-indigo-900/60" style="background: linear-gradient(180deg, #0d1a2e 0%, #0b1523 100%);">
            <div class="pt-8 pb-4 px-4 flex flex-col items-center text-center relative">
                <!-- Mobile close button -->
                <button onclick="toggleSidebar()" class="md:hidden text-indigo-300 hover:text-white absolute top-4 right-4">
                    <i class="fas fa-times text-xl"></i>
                </button>

                <!-- Logo -->
                <img src="/assets/logo.png" alt="ChemArcade Logo" class="w-16 h-16 object-contain mb-3">

                <!-- Brand name -->
                <h1 class="text-xl font-black tracking-tighter text-cyan-400 uppercase italic leading-none">
                    Elem<span class="text-white">enta</span>
                </h1>
                <p class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest mt-1">Teacher Portal</p>

                <!-- Divider -->
                <!-- <div class="w-full mt-5 border-t border-indigo-800/60"></div> -->
            </div>

            <nav class="flex-1 px-4 mt-4 space-y-6 overflow-y-auto no-scrollbar pb-6">
                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Main Interface</p>
                    <div class="space-y-1">
                        <a href="/home" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-house w-5 text-cyan-500 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Home</span>
                        </a>
                    </div>

                    <div class="space-y-1">
                        <div class="space-y-1">
                        <a href="/dashboard" class="nav-active flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-chart-line w-5 text-red-500 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Dashboard</span>
                        </a>
                    </div>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Academic Management</p>
                    <div class="space-y-1">
                        <a href="/subjects" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-book w-5 text-orange-500 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">My Subjects</span>
                        </a>
                    </div>

                    <div class="space-y-1">
                        <a href="/events" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fa-solid fa-calendar-days text-lg text-violet-500 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Events</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Community & Engagement</p>
                    <div class="space-y-1">
                        <a href="/forums" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-comments w-5 text-emerald-500 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Forums</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">EXP & Rankings</p>
                    <div class="space-y-1">
                        <a href="/leaderboards" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-trophy w-5 text-yellow-500 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Leaderboards</span>
                        </a>
                    </div>
                </div>
            </nav>

            <div class="p-4 border-t" style="border-color: rgba(99,102,241,0.25);">
                <a href="/logout"
                class="flex items-center gap-3 p-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition group font-bold">
                    <i class="fas fa-right-from-bracket w-5"></i> Log Out
                </a>
            </div>
        </aside>

        <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden ">
            <header class="h-20 bg-white/90 backdrop-blur-md border-b border-cyan-100 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-slate-100 text-slate-600 md:hidden">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    <div>
                        <h2 class="text-lg font-bold text-indigo-900 uppercase tracking-tight">
                            Welcome, <%= user.first_name %>!
                        </h2>
                        <p class="text-xs text-slate-400 hidden sm:block">
                            <i class="fas fa-circle text-green-400 text-[8px] mr-1"></i>
                            Chemistry Enthusiast &nbsp;·&nbsp; <%= new Date().toLocaleDateString('en-PH', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3 md:gap-6">
                    <div onclick="toggleNotifications()" class="relative group cursor-pointer p-2 hover:bg-slate-100 rounded-full transition">
                        <i class="far fa-bell text-xl text-slate-600"></i>
                        
                        <span class="absolute top-2 right-2 flex h-2.5 w-2.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500 border-2 border-white"></span>
                        </span>

                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 transition-all bg-slate-800 text-white text-[10px] px-2 py-1 rounded">
                            Notifications
                        </span>
                    </div>
                    
                    <div class="relative">
                        <div onclick="toggleUserMenu(event)" id="userMenuBtn" class="flex items-center gap-3 pl-4 border-l border-slate-200 cursor-pointer hover:opacity-80 transition">
                            <div class="text-right hidden lg:block">
                                <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                                <p class="text-[10px] uppercase font-bold text-slate-400 tracking-widest leading-none"><%= user.role %></p>
                            </div>
                            <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100">
                            <i class="fas fa-chevron-down text-[10px] text-slate-400 ml-1"></i>
                        </div>

                        <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                            <div class="px-4 py-3 border-b border-slate-50 lg:hidden">
                                <p class="text-sm font-bold text-slate-800"><%= user.first_name %></p>
                                <p class="text-[10px] text-slate-400 mt-1 uppercase"><%= user.role %></p>
                            </div>
                            <a href="/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-600 hover:bg-blue-50 hover:text-blue-600 transition">
                                <i class="far fa-user w-5 text-center"></i> View Profile
                            </a>

                            <hr class="my-2 border-slate-50">
                            <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-500 hover:bg-red-50 transition font-bold">
                                <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
                <div class="p-4 md:p-8 flex-1">
                    <section class="relative overflow-hidden rounded-3xl shadow-xl shadow-slate-200 min-h-[220px] mb-6">
                        <% if (announcements && announcements.length > 0) { %>
                            <div id="announcement-carousel">
                                <% announcements.forEach((ann, index) => { %>
                                    <div class="announcement-item absolute inset-0 transition-all duration-1000 opacity-0 transform translate-x-10 flex items-center justify-between p-6 md:p-10 text-white" 
                                        data-index="<%= index %>"
                                        style="display: none;">
                                        
                                        <!-- DITO ANG BAGO: Dark Slate Overlay -->
                                        <!-- Iniba natin mula sa bg-black/40 para maging bg-slate-900/50 -->
                                        <!-- Mahalaga ang z-10 dito -->
                                        <div class="absolute inset-0 bg-slate-900/50 z-10"></div>
                                        
                                        <!-- Background Image Layer -->
                                        <!-- Ginamit ang z-0 para nasa likod lang -->
                                        <div class="carousel-bg absolute inset-0 z-0 bg-cover bg-center transition-all duration-700"></div>

                                        <!-- Content Container -->
                                        <!-- Dapat mas mataas ang z-index (z-20) kaysa sa overlay (z-10) para clickable at mabasa -->
                                        <div class="max-w-2xl relative z-20">
                                            <p class="text-slate-100 text-xs mb-1 uppercase tracking-widest font-bold">
                                                Update from Teacher <%= ann.last_name %>
                                            </p>
                                            <h3 class="text-xl md:text-3xl font-bold leading-tight"><%= ann.title %></h3>
                                            <p class="text-slate-50 text-sm mt-2 opacity-90 line-clamp-2"><%= ann.content %></p>
                                            
                                            <!-- Pinalitan ko rin ang kulay ng button para bumagay sa dark slate background -->
                                            <button class="mt-4 px-6 py-2 bg-white text-slate-900 rounded-lg text-sm font-bold hover:bg-slate-50 transition-all shadow-lg transform hover:scale-105">
                                                View Details
                                            </button>
                                        </div>
                                        
                                        <!-- Icon: Nasa z-20 rin para hindi matakpan ng overlay -->
                                        <i class="fas fa-bullhorn text-7xl text-white/10 hidden sm:block relative z-20"></i>
                                    </div>
                                <% }) %>
                            </div>
                        <% } else { %>
                            <!-- Fallback kapag walang announcement (Pinatili ang dating style) -->
                            <div class="bg-white h-[220px] rounded-3xl flex flex-col items-center justify-center text-center border-2 border-dashed border-slate-200 p-8">
                                <div class="bg-slate-50 w-16 h-16 rounded-full flex items-center justify-center mb-4">
                                    <i class="fas fa-megaphone text-slate-300 text-2xl"></i>
                                </div>
                                <h4 class="text-indigo-950 font-bold text-sm uppercase tracking-tight">Silent Campus</h4>
                                <p class="text-slate-400 text-xs mt-1 italic font-medium">
                                    "There is no announcement posted"
                                </p>
                                <p class="text-[10px] text-slate-300 mt-4 uppercase font-black">Check back later for updates</p>
                            </div>
                        <% } %>
                    </section>

                    <div class="grid grid-cols-1 xl:grid-cols-12 gap-8">
                        <div class="xl:col-span-8 space-y-8">
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                                <section class="bg-cyan p-6 rounded-[2.5rem] border border-slate-100 shadow-[0_20px_50px_rgba(0,0,0,0.05)]">
                                    <h2 class="text-sm font-black text-slate-800 mb-6 flex items-center gap-3">
                                        <div class="bg-gradient-to-tr from-indigo-600 to-violet-500 p-2.5 rounded-2xl shadow-lg shadow-indigo-200">
                                            <i class="fas fa-clipboard-list text-white text-xs"></i>
                                        </div>
                                        <span class="uppercase tracking-[0.15em]">Upcoming Assessments</span>
                                    </h2>

                                    <div class="space-y-4">
                                        <% if (upcomingTasks && upcomingTasks.length > 0) { %>
                                            <% upcomingTasks.slice(0, 3).forEach(task => { 
                                                const isQuiz = task.assessment_type.toLowerCase() === 'quiz';
                                                
                                                // Color Palette: Mas matapang na contrast para sa lively feel
                                                const theme = isQuiz 
                                                    ? { 
                                                        card: 'bg-gradient-to-r from-orange-50/80 to-rose-50/50', 
                                                        border: 'border-orange-100', 
                                                        badge: 'bg-gradient-to-br from-orange-500 to-rose-500',
                                                        glow: 'shadow-orange-200',
                                                        text: 'text-orange-600'
                                                    }
                                                    : { 
                                                        card: 'bg-gradient-to-r from-blue-50/80 to-indigo-50/50', 
                                                        border: 'border-blue-100', 
                                                        badge: 'bg-gradient-to-br from-blue-600 to-indigo-600',
                                                        glow: 'shadow-blue-200',
                                                        text: 'text-blue-600'
                                                    };
                                            %>
                                                <div class="group relative">
                                                    <!-- Dynamic Glow on Hover -->
                                                    <div class="absolute -inset-1 bg-gradient-to-r <%= isQuiz ? 'from-orange-400 to-rose-400' : 'from-blue-400 to-indigo-400' %> rounded-[2rem] opacity-0 group-hover:opacity-10 blur transition duration-500"></div>
                                                    
                                                    <div class="relative p-4 <%= theme.card %> backdrop-blur-sm rounded-[1.5rem] flex items-center gap-4 border <%= theme.border %> transition-all duration-300 group-hover:scale-[1.02] group-hover:shadow-md">
                                                        
                                                        <!-- Side Accent Bar -->
                                                        <div class="absolute left-0 top-1/4 bottom-1/4 w-1 <%= theme.badge %> rounded-r-full opacity-0 group-hover:opacity-100 transition-all"></div>

                                                        <!-- Badge Section -->
                                                        <div class="flex-shrink-0 w-14 h-14 <%= theme.badge %> <%= theme.glow %> shadow-xl rounded-2xl flex flex-col items-center justify-center text-white transform transition-transform group-hover:rotate-3">
                                                            <i class="fas <%= isQuiz ? 'fa-bolt' : 'fa-book-open' %> text-xs mb-1"></i>
                                                            <span class="text-[7px] font-black uppercase tracking-tighter"><%= task.assessment_type %></span>
                                                        </div>

                                                        <!-- Text Details -->
                                                        <div class="flex-1 min-w-0">
                                                            <h4 class="text-[13px] font-black text-slate-800 truncate group-hover:text-indigo-900 transition-colors">
                                                                <%= task.assessment_name %>
                                                            </h4>
                                                            <div class="flex items-center gap-2 mt-1">
                                                                <span class="flex items-center gap-1 px-2 py-0.5 rounded-full bg-white/60 border border-white text-[9px] font-bold <%= theme.text %>">
                                                                    <i class="far fa-clock"></i>
                                                                    <%= new Date(task.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <!-- Arrow Button -->
                                                        <div class="w-8 h-8 rounded-xl bg-white shadow-sm flex items-center justify-center text-slate-300 group-hover:bg-slate-800 group-hover:text-white transition-all cursor-pointer"
                                                            onclick="openArcadeModal(<%= task.assessment_id %>, '<%= task.assessment_name %>')">
                                                            <i class="fas fa-arrow-right text-[10px]"></i>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <div class="py-10 flex flex-col items-center justify-center bg-slate-50/50 rounded-[2rem] border border-dashed border-slate-200">
                                                <div class="w-12 h-12 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-3">
                                                    <i class="fas fa-check-circle text-emerald-400"></i>
                                                </div>
                                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">All Caught Up!</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </section>

                                <section class="bg-cyan p-6 rounded-[2.5rem] border border-slate-100 shadow-[0_20px_50px_rgba(0,0,0,0.05)]">
                                    <!-- Header with Gradient Icon Box -->
                                    <h2 class="text-sm font-black text-slate-800 mb-6 flex items-center gap-3">
                                        <div class="bg-gradient-to-tr from-emerald-500 to-teal-400 p-2.5 rounded-2xl shadow-lg shadow-emerald-100">
                                            <i class="fas fa-history text-white text-xs"></i>
                                        </div>
                                        <span class="uppercase tracking-[0.15em]">Recent Activity</span>
                                    </h2>

                                    <div class="space-y-4 max-h-[280px] overflow-y-auto pr-2 custom-scrollbar">
                                        <% if (timeline && timeline.length > 0) { %>
                                            <% timeline.forEach(item => { 
                                                // Color Logic: Activity usually feels good, so let's use emerald/teal for completed things
                                                const theme = {
                                                    card: 'bg-gradient-to-r from-emerald-50/80 to-teal-50/50',
                                                    border: 'border-emerald-100',
                                                    badge: 'bg-gradient-to-br from-emerald-500 to-teal-500',
                                                    text: 'text-emerald-600'
                                                };
                                            %>
                                                <div class="group relative">
                                                    <!-- Dynamic Glow on Hover -->
                                                    <div class="absolute -inset-1 bg-gradient-to-r from-emerald-400 to-teal-400 rounded-[2rem] opacity-0 group-hover:opacity-10 blur transition duration-500"></div>
                                                    
                                                    <div class="relative p-4 <%= theme.card %> backdrop-blur-sm rounded-[1.5rem] flex items-center gap-4 border <%= theme.border %> transition-all duration-300 group-hover:scale-[1.02] group-hover:shadow-md cursor-pointer">
                                                        
                                                        <!-- Side Accent Bar -->
                                                        <div class="absolute left-0 top-1/4 bottom-1/4 w-1 <%= theme.badge %> rounded-r-full opacity-0 group-hover:opacity-100 transition-all"></div>

                                                        <!-- Badge Icon -->
                                                        <div class="flex-shrink-0 w-10 h-10 <%= theme.badge %> shadow-lg shadow-emerald-100 rounded-xl flex items-center justify-center text-white transform transition-transform group-hover:-rotate-6">
                                                            <i class="fas fa-check text-[10px]"></i>
                                                        </div>

                                                        <!-- Text Details -->
                                                        <div class="flex-1 min-w-0">
                                                            <h4 class="text-[12px] font-black text-slate-800 truncate group-hover:text-emerald-900 transition-colors">
                                                                <%= item.assessment_name %>
                                                            </h4>
                                                            <div class="flex items-center gap-2 mt-0.5">
                                                                <span class="text-[9px] font-bold text-slate-400 uppercase tracking-wider">
                                                                    <%= item.subject_name %>
                                                                </span>
                                                            </div>
                                                        </div>

                                                        <!-- Time/Status Indicator -->
                                                        <div class="flex flex-col items-end gap-1">
                                                            <span class="px-2 py-0.5 rounded-full bg-white/60 border border-white text-[8px] font-black <%= theme.text %>">
                                                                RECENT
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <!-- Empty State -->
                                            <div class="py-10 flex flex-col items-center justify-center bg-slate-50/50 rounded-[2rem] border border-dashed border-slate-200">
                                                <div class="w-12 h-12 bg-white rounded-2xl shadow-sm flex items-center justify-center mb-3">
                                                    <i class="fas fa-ghost text-slate-300"></i>
                                                </div>
                                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-[0.2em]">Quiet for now...</p>
                                            </div>
                                        <% } %>
                                    </div>
                                </section>
                            </div>

                            <section class="bg-white p-6 rounded-[2.5rem] border border-slate-100 shadow-[0_20px_50px_rgba(0,0,0,0.05)]">
                                <!-- Header with Breadcrumb-style "View All" -->
                                <div class="flex items-center justify-between mb-6">
                                    <h2 class="text-sm font-black text-slate-800 flex items-center gap-3">
                                        <div class="bg-gradient-to-tr from-amber-50 to-orange-400 p-2.5 rounded-2xl shadow-lg shadow-amber-100">
                                            <i class="fas fa-comments text-white text-xs"></i>
                                        </div>
                                        <span class="uppercase tracking-[0.15em]">Recent Forums</span>
                                    </h2>
                                    <a href="/forums" class="group/btn flex items-center gap-2 bg-white/80 hover:bg-slate-800 px-4 py-1.5 rounded-xl border border-slate-100 shadow-sm transition-all duration-300">
                                        <span class="text-[10px] font-black uppercase tracking-wider text-slate-600 group-hover/btn:text-white">View All</span>
                                        <i class="fas fa-chevron-right text-[8px] text-slate-400 group-hover/btn:text-white transition-transform group-hover/btn:translate-x-0.5"></i>
                                    </a>
                                </div>

                                <!-- Grid Layout -->
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                    <% if (recentForums && recentForums.length > 0) { %>
                                        <% /* Ginamit ang .slice(0, 2) para limitahan ang display sa 2 items lamang */ %>
                                        <% recentForums.slice(0, 2).forEach(forum => { %>
                                            <div class="group relative">
                                                <!-- Dynamic Glow Effect -->
                                                <div class="absolute -inset-1 bg-gradient-to-r from-amber-400 to-orange-400 rounded-[2rem] opacity-0 group-hover:opacity-15 blur transition duration-500"></div>
                                                
                                                <a href="/forums?open=<%= forum.forum_id %>" class="relative flex items-center gap-4 p-4 bg-white/60 backdrop-blur-md rounded-[1.8rem] border border-white transition-all duration-300 group-hover:scale-[1.03] group-hover:shadow-xl group-hover:bg-white/90">
                                                    
                                                    <!-- Left Accent Bar -->
                                                    <div class="absolute left-0 top-1/3 bottom-1/3 w-1 bg-gradient-to-b from-amber-500 to-orange-500 rounded-r-full opacity-0 group-hover:opacity-100 transition-all"></div>

                                                    <!-- Forum Avatar/Icon -->
                                                    <div class="flex-shrink-0 w-12 h-12 bg-gradient-to-br from-amber-50 to-orange-50 rounded-2xl flex items-center justify-center border border-amber-100/50 shadow-inner group-hover:rotate-3 transition-transform">
                                                        <i class="fas fa-comment-dots text-amber-500 text-lg"></i>
                                                    </div>

                                                    <!-- Content Details -->
