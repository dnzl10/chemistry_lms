        function switchArmTab(tab) {
            const analysis = document.getElementById('armAnalysis');
            const review = document.getElementById('armReview');
            const tabAnalysis = document.getElementById('armTabAnalysis');
            const tabReview = document.getElementById('armTabReview');

            if (analysis) analysis.style.display = tab === 'analysis' ? 'flex' : 'none';
