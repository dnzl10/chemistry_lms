                                                                <i class="far fa-clock"></i>
                                                                <%= new Date(forum.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                                            </span>
                                                        </div>
                                                    </div>

                                                    <!-- Hover Arrow -->
                                                    <div class="w-7 h-7 rounded-lg bg-slate-50 flex items-center justify-center text-slate-300 group-hover:bg-amber-500 group-hover:text-white transition-all">
                                                        <i class="fas fa-external-link-alt text-[9px]"></i>
                                                    </div>
                                                </a>
                                            </div>
                                        <% }) %>
                                    <% } else { %>
