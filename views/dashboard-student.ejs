                                </h2>

                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
                                    <% subjects.forEach(subject => { %>
                                        <div class="group relative">
                                            <!-- Dynamic Backdrop Glow (Blue-Cyan mix) -->
                                            <div class="absolute -inset-1 bg-gradient-to-r from-blue-400 to-cyan-400 rounded-[2.5rem] opacity-0 group-hover:opacity-15 blur-lg transition duration-500"></div>
                                            
                                            <a href="/subjects/open/<%= subject.subject_id %>" class="block relative bg-white/70 backdrop-blur-md rounded-[2.2rem] overflow-hidden border border-white transition-all duration-500 group-hover:scale-[1.03] group-hover:shadow-2xl group-hover:bg-white/90 cursor-pointer">
                                                
                                                <!-- Subject Header: Image-Ready & High Impact -->
                                                <div class="h-32 bg-slate-900 flex flex-col justify-between relative overflow-hidden">
                                                    <% 
                                                        // We mirror your working logic here
                                                        var displayImg = (subject.subject_image && subject.subject_image !== 'default_subject.png') 
                                                                        ? subject.subject_image 
                                                                        : 'default_subject.png'; 
                                                    %>
                                                    
                                                    <!-- Subject Image with Cinematic Zoom -->
                                                    <img src="/profile_uploads/<%= displayImg %>" 
                                                        alt="<%= subject.subject_name %>" 
                                                        class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:scale-110 group-hover:rotate-1 transition-transform duration-700"
                                                        onerror="this.src='/profile_uploads/default_subject.png'">

                                                    <!-- Legibility Overlay Gradient -->
