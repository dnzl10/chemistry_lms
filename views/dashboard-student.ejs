        // Standard Announcement Slider
        document.addEventListener('DOMContentLoaded', function() {
            const track = document.getElementById('announcement-slider-track');
            const slides = document.querySelectorAll('.announcement-slide');
            const prevBtn = document.getElementById('announcement-prev-btn');
            const nextBtn = document.getElementById('announcement-next-btn');
            const dots = document.querySelectorAll('.announcement-dot');
            if (!track || slides.length === 0) return;

            let currentIndex = 0;
            let slideInterval = null;

            function updateSlider(index) {
                currentIndex = (index + slides.length) % slides.length;
                track.style.transform = `translateX(-${currentIndex * 100}%)`;
                dots.forEach((dot, idx) => {
                    if (idx === currentIndex) {
                        dot.classList.add('bg-white', 'w-5');
                        dot.classList.remove('bg-white/40', 'w-2');
                    } else {
                        dot.classList.add('bg-white/40', 'w-2');
                        dot.classList.remove('bg-white', 'w-5');
                    }
                });
            }

            function nextSlide() {
                updateSlider(currentIndex + 1);
            }

            function prevSlide() {
                updateSlider(currentIndex - 1);
            }

            if (nextBtn) {
                nextBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    nextSlide();
                    resetAutoplay();
                });
            }

            if (prevBtn) {
                prevBtn.addEventListener('click', function(e) {
                    e.preventDefault();
                    prevSlide();
                    resetAutoplay();
                });
            }

            dots.forEach(function(dot) {
                dot.addEventListener('click', function(e) {
                    e.preventDefault();
                    const idx = parseInt(dot.getAttribute('data-index'), 10);
                    if (!isNaN(idx)) {
                        updateSlider(idx);
                        resetAutoplay();
                    }
                });
            });

            function startAutoplay() {
                if (slides.length > 1) {
                    slideInterval = setInterval(nextSlide, 6000);
                }
            }

            function stopAutoplay() {
                if (slideInterval) {
                    clearInterval(slideInterval);
                    slideInterval = null;
                }
            }

            function resetAutoplay() {
                stopAutoplay();
                startAutoplay();
            }

            const container = document.getElementById('announcement-slider-container');
            if (container) {
                container.addEventListener('mouseenter', stopAutoplay);
                container.addEventListener('mouseleave', startAutoplay);
            }

            startAutoplay();

            // Deep-link anchor detection: auto-rotate slider directly to targeted announcement
            if (window.location.hash && window.location.hash.startsWith('#ann-card-')) {
                const targetCard = document.querySelector(window.location.hash);
                if (targetCard) {
                    const slideItem = targetCard.closest('.announcement-slide');
                    if (slideItem) {
                        const targetIdx = parseInt(slideItem.getAttribute('data-index'), 10);
                        if (!isNaN(targetIdx)) {
                            updateSlider(targetIdx);
                        }
                    }
                    setTimeout(function() {
                        targetCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    }, 100);
                }
            }
        });

        // Clean modal replacement for web assessment alert
        function openArcadeModal(assessmentId, assessmentName) {
            const nameEl = document.getElementById('constructionModalAssessmentName');
            if (nameEl) nameEl.textContent = assessmentName || 'Assessment';
            if (window.ModalManager) {
                ModalManager.open('assessmentConstructionModal');
            } else {
                const modal = document.getElementById('assessmentConstructionModal');
                if (modal) {
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                }
            }
        }

        function closeArcadeModal() {
            if (window.ModalManager) {
                ModalManager.close('assessmentConstructionModal');
            } else {
                const modal = document.getElementById('assessmentConstructionModal');
                if (modal) {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                }
            }
        }

        // ── CREATE / EDIT EVENT MODAL CONTROLLERS ──
        function openEventModal(prefillDate = null) {
            const modalTitle = document.getElementById('modalTitle');
            const formSubmitBtn = document.getElementById('formSubmitBtn');
            const eventForm = document.getElementById('eventForm');
            if (modalTitle) modalTitle.textContent = 'Create New Event';
            if (formSubmitBtn) formSubmitBtn.textContent = 'Save Event';
            if (eventForm) eventForm.action = '/events/add';

            const editEventId = document.getElementById('editEventId');
            if (editEventId) editEventId.value = '';
            const formMethod = document.getElementById('formMethod');
            if (formMethod) formMethod.value = '';

            const formSubjectId = document.getElementById('formSubjectId');
            if (formSubjectId) formSubjectId.value = '';
            const formTitle = document.getElementById('formTitle');
            if (formTitle) formTitle.value = '';
            const formDesc = document.getElementById('formDesc');
            if (formDesc) formDesc.value = '';
            const formType = document.getElementById('formType');
            if (formType) formType.value = 'Material';

            const formDate = document.getElementById('formDate');
            if (formDate) {
                if (prefillDate) {
                    formDate.value = prefillDate;
                } else {
                    const today = new Date();
                    const y = today.getFullYear();
                    const m = String(today.getMonth() + 1).padStart(2, '0');
                    const d = String(today.getDate()).padStart(2, '0');
                    formDate.value = `${y}-${m}-${d}`;
                }
            }

            const formLocation = document.getElementById('formLocation');
            if (formLocation) formLocation.value = '';

            const durationType = document.getElementById('durationType');
            if (durationType) durationType.value = 'None';
            const formStartDate = document.getElementById('formStartDate');
            if (formStartDate) formStartDate.value = '';
            const formEndDate = document.getElementById('formEndDate');
            if (formEndDate) formEndDate.value = '';
            const formMinutes = document.getElementById('formMinutes');
            if (formMinutes) formMinutes.value = '';

            const isRepeatable = document.getElementById('isRepeatable');
            if (isRepeatable) isRepeatable.checked = false;
            const repeatCycle = document.getElementById('repeatCycle');
            if (repeatCycle) repeatCycle.classList.add('hidden');

            toggleDurationFields();

            // Hide popover if open
            const popover = document.getElementById('calendarHoverPopover');
            if (popover) {
                popover.classList.add('opacity-0');
                popover.classList.add('hidden');
            }

            if (window.ModalManager) {
                ModalManager.open('eventModal');
            } else {
                const modal = document.getElementById('eventModal');
                if (modal) {
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                }
            }
        }

        function closeEventModal() {
            if (window.ModalManager) {
                ModalManager.close('eventModal');
            } else {
                const modal = document.getElementById('eventModal');
                if (modal) {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                }
            }
        }

        function toggleDurationFields() {
            const durationType = document.getElementById('durationType')?.value;
            const dateRangeFields = document.getElementById('dateRangeFields');
            const minuteFields = document.getElementById('minuteFields');
            if (dateRangeFields) dateRangeFields.classList.toggle('hidden', durationType !== 'DateRange');
            if (minuteFields) minuteFields.classList.toggle('hidden', durationType !== 'Minutes');
        }

        function toggleRepeatFields() {
            const isRepeatable = document.getElementById('isRepeatable');
            const repeatCycle = document.getElementById('repeatCycle');
            if (isRepeatable && repeatCycle) {
                repeatCycle.classList.toggle('hidden', !isRepeatable.checked);
            }
        }

        // ── EVENT DETAILS MODAL (VIEW / INSPECT) CONTROLLER ──
        function openEventDetailsModal(target) {
            let event = null;
            if (typeof target === 'string') {
                try { event = JSON.parse(decodeURIComponent(target)); } catch(e) { event = null; }
            } else if (target && target.dataset && target.dataset.event) {
                try { event = JSON.parse(decodeURIComponent(target.dataset.event)); } catch(e) { event = null; }
            } else if (typeof target === 'object' && target !== null) {
                event = target;
            }

            if (!event) return;

            // Title
            const titleEl = document.getElementById('eventDetailsModalTitle');
            if (titleEl) titleEl.textContent = event.event_title || 'Campus Event';

            // Type Badge
            const typeBadge = document.getElementById('eventDetailsTypeBadge');
            if (typeBadge) {
                const type = event.event_type || 'Event';
                typeBadge.textContent = type;
                typeBadge.className = 'text-[10px] font-black uppercase px-2.5 py-1 rounded-lg border';
                switch (type.toLowerCase()) {
                    case 'exam':
                        typeBadge.classList.add('bg-rose-100', 'text-rose-700', 'border-rose-200');
                        break;
                    case 'deadline':
                        typeBadge.classList.add('bg-amber-100', 'text-amber-700', 'border-amber-200');
                        break;
                    case 'assignment':
                        typeBadge.classList.add('bg-indigo-100', 'text-indigo-700', 'border-indigo-200');
                        break;
                    case 'holiday':
                        typeBadge.classList.add('bg-emerald-100', 'text-emerald-700', 'border-emerald-200');
                        break;
                    case 'material':
                    default:
                        typeBadge.classList.add('bg-blue-100', 'text-blue-700', 'border-blue-200');
                        break;
                }
            }

            // Subject Badge
            const subjectBadge = document.getElementById('eventDetailsSubjectBadge');
            if (subjectBadge) {
                if (event.subject_name) {
                    subjectBadge.textContent = event.subject_name;
                    subjectBadge.classList.remove('hidden');
                } else {
                    subjectBadge.classList.add('hidden');
                }
            }

            // Repeat Badge
            const repeatBadge = document.getElementById('eventDetailsRepeatBadge');
            const repeatText = document.getElementById('eventDetailsRepeatText');
            if (repeatBadge && repeatText) {
                if (event.is_repeatable) {
                    repeatText.textContent = event.repeat_cycle ? `Repeats: ${event.repeat_cycle}` : 'Repeats';
                    repeatBadge.classList.remove('hidden');
                } else {
                    repeatBadge.classList.add('hidden');
                }
            }

            // Date Formatting
            const dateEl = document.getElementById('eventDetailsDate');
            if (dateEl) {
                if (event.event_date) {
                    const parsedDate = new Date(event.event_date);
                    if (!isNaN(parsedDate.getTime())) {
                        dateEl.textContent = parsedDate.toLocaleDateString(undefined, {
                            weekday: 'long',
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        });
                    } else {
                        dateEl.textContent = String(event.event_date);
                    }
                } else {
                    dateEl.textContent = 'Date not specified';
                }
            }

            // Time / Duration Formatting
            const timeEl = document.getElementById('eventDetailsTime');
            if (timeEl) {
                let timeStr = '';
                if (event.duration_type === 'DateRange' && (event.start_date || event.end_date)) {
                    const s = event.start_date ? new Date(event.start_date) : null;
                    const e = event.end_date ? new Date(event.end_date) : null;
                    const sTime = (s && !isNaN(s.getTime())) ? s.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
                    const eTime = (e && !isNaN(e.getTime())) ? e.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
                    if (sTime && eTime) {
                        timeStr = `${sTime} – ${eTime}`;
                    } else {
                        timeStr = sTime || eTime || 'Scheduled Range';
                    }
                } else if (event.duration_type === 'Minutes' && event.duration_minutes) {
                    const baseTime = event.event_date ? new Date(event.event_date).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' }) : '';
                    timeStr = baseTime ? `${baseTime} (${event.duration_minutes} mins)` : `${event.duration_minutes} minutes duration`;
                } else if (event.event_date) {
                    const parsedDate = new Date(event.event_date);
                    if (!isNaN(parsedDate.getTime())) {
                        timeStr = parsedDate.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
                    }
                }
                timeEl.textContent = timeStr || 'All Day / Not Specified';
            }

            // Venue / Platform / Location
            const locEl = document.getElementById('eventDetailsLocation');
            const locIcon = document.getElementById('eventDetailsLocationIcon');
            if (locEl) {
                const locVal = (event.event_location || '').trim();
                if (locVal && locVal.toUpperCase() !== 'TBA') {
                    const isUrl = /^https?:\/\//i.test(locVal);
                    if (isUrl) {
                        locEl.innerHTML = `<a href="${locVal}" target="_blank" rel="noopener noreferrer" class="text-blue-600 hover:underline flex items-center gap-1.5"><i class="fas fa-external-link-alt text-[10px]"></i> ${locVal}</a>`;
                        if (locIcon) locIcon.innerHTML = '<i class="fas fa-video"></i>';
                    } else {
                        locEl.textContent = locVal;
                        if (locIcon) locIcon.innerHTML = '<i class="fas fa-map-pin"></i>';
                    }
                } else {
                    locEl.textContent = 'Venue / Platform: TBA (To be announced)';
                    if (locIcon) locIcon.innerHTML = '<i class="fas fa-location-dot"></i>';
                }
            }

            // Description
            const descEl = document.getElementById('eventDetailsDescription');
            if (descEl) {
                const desc = (event.event_description || '').trim();
                if (desc) {
                    descEl.textContent = desc;
                    descEl.classList.remove('italic', 'text-slate-400');
                    descEl.classList.add('text-slate-600');
                } else {
                    descEl.textContent = 'No additional description provided for this event entry.';
                    descEl.classList.add('italic', 'text-slate-400');
                    descEl.classList.remove('text-slate-600');
                }
            }

            // Open Modal
            if (window.ModalManager) {
                ModalManager.open('eventDetailsModal');
            } else {
                const modal = document.getElementById('eventDetailsModal');
                if (modal) {
                    modal.classList.remove('hidden');
                    modal.classList.add('flex');
                }
            }
        }

        function closeEventDetailsModal() {
            if (window.ModalManager) {
                ModalManager.close('eventDetailsModal');
            } else {
                const modal = document.getElementById('eventDetailsModal');
                if (modal) {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                }
            }
        }

        window.openEventModal = openEventModal;
        window.closeEventModal = closeEventModal;
        window.openEventDetailsModal = openEventDetailsModal;
        window.closeEventDetailsModal = closeEventDetailsModal;
        window.toggleDurationFields = toggleDurationFields;
        window.toggleRepeatFields = toggleRepeatFields;

        // Calendar Interactive Hover Popover and Form Handling
        document.addEventListener('DOMContentLoaded', function() {
            const calendarPopover = document.getElementById('calendarHoverPopover');
            const calendarPopoverContent = document.getElementById('calendarHoverContent');
            let popoverHideTimer = null;

            function escapePopoverHtml(str) {
                if (!str) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            function getEventBadgeColor(type) {
                switch ((type || '').toLowerCase()) {
                    case 'exam':
                        return 'bg-rose-100 text-rose-700 border border-rose-200';
                    case 'deadline':
                        return 'bg-amber-100 text-amber-700 border border-amber-200';
                    case 'assignment':
                        return 'bg-indigo-100 text-indigo-700 border border-indigo-200';
                    case 'holiday':
                        return 'bg-emerald-100 text-emerald-700 border border-emerald-200';
                    case 'material':
                    default:
                        return 'bg-blue-100 text-blue-700 border border-blue-200';
                }
            }

            const dayButtons = document.querySelectorAll('.calendar-day-btn');
            dayButtons.forEach(btn => {
                btn.addEventListener('mouseenter', function() {
                    if (!calendarPopover || !calendarPopoverContent) return;
                    clearTimeout(popoverHideTimer);

                    let dayEvents = [];
                    try {
                        dayEvents = JSON.parse(decodeURIComponent(btn.dataset.events || '[]'));
                    } catch (e) {
                        dayEvents = [];
                    }

                    const dateLabel = btn.dataset.dateLabel || btn.dataset.date || '';

                    let contentHtml = '';
                    if (dayEvents.length > 0) {
                        contentHtml = `
                            <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-100">
                                <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800">
                                    <i class="far fa-calendar-check text-blue-600"></i>
                                    <span>${escapePopoverHtml(dateLabel)}</span>
                                </div>
                                <span class="text-[10px] font-black bg-orange-100 text-orange-700 px-2 py-0.5 rounded-full">${dayEvents.length} event${dayEvents.length > 1 ? 's' : ''}</span>
                            </div>
                            <div class="space-y-2 max-h-48 overflow-y-auto no-scrollbar pr-0.5">
                                ${dayEvents.map(ev => `
                                    <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-100 text-xs">
                                        <div class="flex items-center justify-between gap-1 mb-1">
                                            <span class="font-bold text-slate-800 truncate">${escapePopoverHtml(ev.title)}</span>
                                            <span class="text-[9px] font-extrabold uppercase px-1.5 py-0.5 rounded ${getEventBadgeColor(ev.type)}">${escapePopoverHtml(ev.type)}</span>
                                        </div>
                                        <div class="flex items-center gap-2 text-[10px] text-slate-500 font-medium">
                                            ${ev.time ? `<span><i class="far fa-clock text-slate-400 mr-1"></i>${escapePopoverHtml(ev.time)}</span>` : ''}
                                            ${ev.location ? `<span class="truncate"><i class="fas fa-location-dot text-slate-400 mr-1"></i>${escapePopoverHtml(ev.location)}</span>` : ''}
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                            <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-slate-400 font-medium">
                                <span>Click date to schedule event</span>
                                <i class="fas fa-plus text-blue-500"></i>
                            </div>
                        `;
                    } else {
                        contentHtml = `
                            <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-100">
                                <div class="flex items-center gap-1.5 text-xs font-bold text-slate-800">
                                    <i class="far fa-calendar text-slate-400"></i>
                                    <span>${escapePopoverHtml(dateLabel)}</span>
                                </div>
                                <span class="text-[10px] font-bold bg-slate-100 text-slate-500 px-2 py-0.5 rounded-full">No Events</span>
                            </div>
                            <p class="text-xs text-slate-500 italic py-1 text-center">No events scheduled for this day.</p>
                            <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[10px] text-blue-600 font-bold">
                                <span>Click to schedule event</span>
                                <i class="fas fa-plus-circle"></i>
                            </div>
                        `;
                    }

                    calendarPopoverContent.innerHTML = contentHtml;
                    calendarPopover.classList.remove('hidden');

                    const rect = btn.getBoundingClientRect();
                    const popoverWidth = calendarPopover.offsetWidth || 288;
                    const popoverHeight = calendarPopover.offsetHeight || 130;
                    const padding = 12;

                    let left = rect.left + (rect.width / 2) - (popoverWidth / 2);
                    if (left < padding) left = padding;
                    if (left + popoverWidth > window.innerWidth - padding) {
                        left = window.innerWidth - padding - popoverWidth;
                    }

                    let top = rect.top - popoverHeight - 8;
                    if (top < padding) {
                        top = rect.bottom + 8;
                    }

                    calendarPopover.style.left = `${left}px`;
                    calendarPopover.style.top = `${top}px`;

                    requestAnimationFrame(() => {
                        calendarPopover.classList.remove('opacity-0');
                    });
                });

                btn.addEventListener('mouseleave', function() {
                    if (!calendarPopover) return;
                    calendarPopover.classList.add('opacity-0');
                    popoverHideTimer = setTimeout(() => {
                        calendarPopover.classList.add('hidden');
                    }, 150);
                });
            });

            // Form Validation on Event Submit
            const eventForm = document.getElementById('eventForm');
            if (eventForm) {
                eventForm.addEventListener('submit', function(e) {
                    const title = (document.getElementById('formTitle')?.value || '').trim();
                    if (!title) {
                        alert('Please enter an event title.');
                        document.getElementById('formTitle')?.focus();
                        e.preventDefault();
                        return false;
                    }

                    const dateVal = document.getElementById('formDate')?.value;
                    if (!dateVal) {
                        alert('Please choose an event date.');
                        document.getElementById('formDate')?.focus();
                        e.preventDefault();
                        return false;
                    }

                    const durationType = document.getElementById('durationType')?.value;
                    if (durationType === 'DateRange') {
                        const start = document.getElementById('formStartDate')?.value;
                        const end = document.getElementById('formEndDate')?.value;
                        if (start && end && new Date(start) > new Date(end)) {
                            alert('End date and time cannot be earlier than start date and time.');
                            document.getElementById('formEndDate')?.focus();
                            e.preventDefault();
                            return false;
                        }
                    }
                    return true;
                });
            }
        });

    </script>

