                                                <!-- Hover Micro-Interaction Tooltip hint -->
                                                <div class="absolute -bottom-1 left-1/2 -translate-x-1/2 w-0 h-0.5 bg-current transition-all duration-300 group-hover/day:w-1/2"></div>
