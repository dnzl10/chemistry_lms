                btnEl.classList.add('bg-slate-900', 'text-white', 'shadow-xs');
            }
            const items = document.querySelectorAll('.modal-update-item');
            items.forEach(item => {
                if (type === 'all' || item.getAttribute('data-update-type') === type) {
