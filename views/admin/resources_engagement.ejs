}

// ─── HTML ESCAPER HELPER ─────────────────────────────────────────────────────
function escHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

// ─── ADMIN UNMASK AUDIT LOGS ─────────────────────────────────────────────────
async function openUnmaskLogsModal() {
    openModal('modalUnmaskLogs');
    var container = document.getElementById('unmaskLogsContent');
    container.innerHTML = '<div class="text-center py-10 text-slate-400"><i class="fas fa-circle-notch fa-spin text-2xl mb-2"></i><p class="text-xs">Loading audit logs...</p></div>';

    try {
        var res = await fetch('/admin/api/forum-unmask-logs');
        if (!res.ok) {
            throw new Error('Server returned HTTP ' + res.status);
        }
        var data = await res.json();
        if (!data.success || !data.logs || !data.logs.length) {
            container.innerHTML = '<div class="text-center py-12 text-slate-400">' +
                '<i class="fas fa-shield-halved text-4xl mb-3 opacity-25"></i>' +
                '<p class="text-sm font-bold text-slate-600">No Unmask Logs Recorded</p>' +
                '<p class="text-xs text-slate-400 mt-1">No instructors or administrators have performed a break-glass reveal yet.</p>' +
            '</div>';
            return;
        }

        var rows = data.logs.map(function(l) {
            var roleBadge = (l.unmasker_role === 'Admin' || l.unmasker_role === 'admin')
                ? '<span class="text-[9px] uppercase font-bold text-violet-700 bg-violet-100 px-1.5 py-0.5 rounded">Admin</span>'
                : '<span class="text-[9px] uppercase font-bold text-indigo-700 bg-indigo-100 px-1.5 py-0.5 rounded">Instructor</span>';

            return '<tr class="border-b border-slate-100 hover:bg-slate-50 text-xs">' +
                '<td class="p-3 font-mono text-slate-400 font-bold">#' + l.log_id + '</td>' +
                '<td class="p-3 font-bold text-slate-700">' + escHtml(l.unmasker_name) + ' ' + roleBadge + '</td>' +
                '<td class="p-3 font-bold text-amber-700">' + escHtml(l.target_author_name) + '</td>' +
                '<td class="p-3 text-slate-700 max-w-xs">' +
                    '<p class="font-semibold text-slate-800 break-words">' + escHtml(l.justification) + '</p>' +
                    (l.reply_content ? '<p class="text-[10px] text-slate-400 italic truncate mt-0.5" title="' + escHtml(l.reply_content) + '">Reply: "' + escHtml(l.reply_content) + '"</p>' : '') +
                '</td>' +
                '<td class="p-3 text-slate-400 whitespace-nowrap">' + new Date(l.created_at).toLocaleString() + '</td>' +
            '</tr>';
        }).join('');

        container.innerHTML = '<div class="border border-slate-200 rounded-2xl overflow-hidden shadow-sm">' +
            '<table class="w-full text-left border-collapse">' +
                '<thead class="bg-slate-50 text-[10px] font-black uppercase tracking-wider text-slate-500 border-b border-slate-200">' +
                    '<tr>' +
                        '<th class="p-3">Log ID</th>' +
                        '<th class="p-3">Unmasker</th>' +
                        '<th class="p-3">Target Student</th>' +
                        '<th class="p-3">Justification & Content</th>' +
                        '<th class="p-3">Timestamp</th>' +
                    '</tr>' +
                '</thead>' +
                '<tbody class="divide-y divide-slate-100">' + rows + '</tbody>' +
            '</table>' +
        '</div>';
    } catch(err) {
        console.error('Failed to load audit logs:', err);
        container.innerHTML = '<div class="text-center py-10 text-red-500 text-xs">' +
            '<i class="fas fa-exclamation-triangle text-2xl mb-2"></i>' +
            '<p class="font-bold">Failed to load audit logs.</p>' +
            '<p class="text-[11px] text-slate-400 mt-1">' + escHtml(err.message || 'Please check network / session') + '</p>' +
        '</div>';
    }
}

