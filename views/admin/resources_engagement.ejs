// ─── Material search filter ──────────────────────────────
function clearMaterialSearch() {
    var input = document.getElementById('matSearch');
    if (input) {
        input.value = '';
        input.focus();
    }
    filterMaterials();
}

function filterMaterials() {
    var qInput = document.getElementById('matSearch');
    if (!qInput) return;
    var q = qInput.value.toLowerCase().trim();
    var clearBtn = document.getElementById('matSearchClear');
    if (clearBtn) {
        clearBtn.classList.toggle('hidden', !q);
    }

    var totalMatches = 0;
    var subjects = document.querySelectorAll('.mat-subject');
    var noResults = document.getElementById('matNoResults');
    var queryText = document.getElementById('matNoResultsQuery');

    if (!q) {
        // Reset all elements to visible and default accordion state
        subjects.forEach(function(s) {
            s.style.display = '';
            var sBody = s.querySelector(':scope > .accordion-body');
            var sToggle = s.querySelector(':scope > .accordion-toggle');
            if (sBody) sBody.classList.add('open');
            if (sToggle) sToggle.classList.remove('open');
        });
        document.querySelectorAll('.mat-quarter').forEach(function(qEl) {
            qEl.style.display = '';
            var qBody = qEl.querySelector(':scope > .accordion-body');
            var qToggle = qEl.querySelector(':scope > .accordion-toggle');
            if (qBody) qBody.classList.remove('open');
            if (qToggle) qToggle.classList.remove('open');
        });
        document.querySelectorAll('.mat-topic-section').forEach(function(t) {
            t.style.display = '';
            var expandBtn = t.querySelector('.mat-expand-btn');
            var isExpanded = expandBtn && expandBtn.getAttribute('data-expanded') === 'true';
            t.querySelectorAll('.mat-overflow-item').forEach(function(item) {
                item.style.display = '';
                if (isExpanded) {
                    item.classList.remove('hidden');
                } else {
                    item.classList.add('hidden');
                }
            });
            t.querySelectorAll('.mat-item:not(.mat-overflow-item)').forEach(function(item) {
                item.style.display = '';
                item.classList.remove('hidden');
            });
            var expandWrap = t.querySelector('.mat-expand-wrapper');
            if (expandWrap) expandWrap.classList.remove('hidden');
        });
        if (noResults) noResults.classList.add('hidden');
        return;
    }

    // Hide expand wrappers while actively searching
    document.querySelectorAll('.mat-expand-wrapper').forEach(function(w) {
        w.classList.add('hidden');
    });

    subjects.forEach(function(subjEl) {
        var subjName = (subjEl.dataset.subject || '').toLowerCase();
        var subjDirectMatch = subjName.includes(q);
        var subjMatchCount = 0;
        var quarters = subjEl.querySelectorAll('.mat-quarter');

        quarters.forEach(function(qEl) {
            var quarterData = (qEl.dataset.quarter || '').toLowerCase();
            var quarterDirectMatch = subjDirectMatch || quarterData.includes(q);
            var quarterMatchCount = 0;
            var topics = qEl.querySelectorAll('.mat-topic-section');

            topics.forEach(function(topicEl) {
                var topicName = (topicEl.dataset.topic || '').toLowerCase();
                var topicDirectMatch = quarterDirectMatch || topicName.includes(q);
                var items = topicEl.querySelectorAll('.mat-item');
                var topicItemMatchCount = 0;

                items.forEach(function(item) {
                    var searchData = (item.dataset.search || '').toLowerCase();
                    if (topicDirectMatch || searchData.includes(q)) {
                        item.style.display = '';
                        item.classList.remove('hidden');
                        topicItemMatchCount++;
                        totalMatches++;
                    } else {
                        item.style.display = 'none';
                    }
                });

                if (topicItemMatchCount > 0 || (topicDirectMatch && items.length === 0)) {
                    topicEl.style.display = '';
                    quarterMatchCount += Math.max(1, topicItemMatchCount);
                } else {
                    topicEl.style.display = 'none';
                }
            });

            if (quarterMatchCount > 0) {
                qEl.style.display = '';
                subjMatchCount += quarterMatchCount;
                // Auto-expand quarter so user can see matches immediately
                var qBody = qEl.querySelector(':scope > .accordion-body');
                var qToggle = qEl.querySelector(':scope > .accordion-toggle');
                if (qBody) qBody.classList.add('open');
                if (qToggle) qToggle.classList.add('open');
            } else {
                qEl.style.display = 'none';
                var qBody = qEl.querySelector(':scope > .accordion-body');
                var qToggle = qEl.querySelector(':scope > .accordion-toggle');
                if (qBody) qBody.classList.remove('open');
                if (qToggle) qToggle.classList.remove('open');
            }
        });

        if (subjMatchCount > 0) {
            subjEl.style.display = '';
            var sBody = subjEl.querySelector(':scope > .accordion-body');
            var sToggle = subjEl.querySelector(':scope > .accordion-toggle');
            if (sBody) sBody.classList.add('open');
        } else {
            subjEl.style.display = 'none';
        }
    });

    if (noResults) {
        if (totalMatches === 0) {
            if (queryText) queryText.textContent = q;
            noResults.classList.remove('hidden');
        } else {
            noResults.classList.add('hidden');
        }
    }
}

// ─── Material Interaction Log Pagination & Search ─────────
var interactionPage = 1;
var INTERACTION_PER_PAGE = 10;

function clearInteractionSearch() {
    var input = document.getElementById('interactionSearch');
    if (input) {
        input.value = '';
        input.focus();
    }
    filterInteractions();
}

function getFilteredInteractionRows() {
    var searchInput = document.getElementById('interactionSearch');
    var q = searchInput ? searchInput.value.toLowerCase().trim() : '';
    var clearBtn = document.getElementById('btnInteractionSearchClear');
    if (clearBtn) {
        clearBtn.classList.toggle('hidden', !q);
    }
    var allRows = Array.from(document.querySelectorAll('#interactionTableBody .interaction-row'));
    if (!q) return allRows;
    return allRows.filter(function(row) {
        return (row.dataset.search || '').includes(q);
    });
}

function renderInteractionTable() {
    var allRows = Array.from(document.querySelectorAll('#interactionTableBody .interaction-row'));
    var filteredRows = getFilteredInteractionRows();
    var total = filteredRows.length;
    var totalPages = Math.ceil(total / INTERACTION_PER_PAGE) || 1;

    if (interactionPage > totalPages) interactionPage = totalPages;
    if (interactionPage < 1) interactionPage = 1;

    // Hide all rows
    allRows.forEach(function(row) {
        row.style.display = 'none';
    });

    // Show only the 10 rows for current page
    var startIndex = (interactionPage - 1) * INTERACTION_PER_PAGE;
    var endIndex = Math.min(startIndex + INTERACTION_PER_PAGE, total);

    for (var i = startIndex; i < endIndex; i++) {
        if (filteredRows[i]) {
            filteredRows[i].style.display = '';
        }
    }

    // No matching results placeholder
    var tbody = document.getElementById('interactionTableBody');
    var noResultsRow = document.getElementById('interactionNoResultsRow');
    if (!noResultsRow && tbody) {
        noResultsRow = document.createElement('tr');
        noResultsRow.id = 'interactionNoResultsRow';
        noResultsRow.innerHTML = '<td colspan="4" class="p-8 text-center text-slate-400 italic"><i class="fas fa-search-minus mr-1.5"></i> No matching material interactions found.</td>';
        tbody.appendChild(noResultsRow);
    }
    if (noResultsRow) {
        if (total === 0 && allRows.length > 0) {
            noResultsRow.classList.remove('hidden');
        } else {
            noResultsRow.classList.add('hidden');
        }
    }

    // Update pagination labels
    var startEl = document.getElementById('interactionStart');
    var endEl   = document.getElementById('interactionEnd');
    var totalEl = document.getElementById('interactionTotal');
    if (startEl) startEl.textContent = total === 0 ? '0' : (startIndex + 1);
    if (endEl)   endEl.textContent   = total === 0 ? '0' : endIndex;
    if (totalEl) totalEl.textContent = total;

    // Update Prev / Next buttons
    var btnPrev = document.getElementById('btnPrevInteractionPage');
    var btnNext = document.getElementById('btnNextInteractionPage');
    if (btnPrev) btnPrev.disabled = (interactionPage <= 1);
    if (btnNext) btnNext.disabled = (interactionPage >= totalPages || total === 0);

    // Render page buttons
    var numContainer = document.getElementById('interactionPageNumbers');
    if (numContainer) {
        numContainer.innerHTML = '';
        if (totalPages <= 1) {
            var p1 = createInteractionPageBtn(1);
            numContainer.appendChild(p1);
        } else {
            var maxButtons = 5;
            var startPage = Math.max(1, interactionPage - 2);
            var endPage = Math.min(totalPages, startPage + maxButtons - 1);
            if (endPage - startPage + 1 < maxButtons) {
                startPage = Math.max(1, endPage - maxButtons + 1);
            }

            if (startPage > 1) {
                numContainer.appendChild(createInteractionPageBtn(1));
                if (startPage > 2) {
                    var dots = document.createElement('span');
                    dots.className = 'px-1 text-slate-400 text-xs font-bold';
                    dots.textContent = '…';
                    numContainer.appendChild(dots);
                }
            }

            for (var p = startPage; p <= endPage; p++) {
                numContainer.appendChild(createInteractionPageBtn(p));
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    var dots2 = document.createElement('span');
                    dots2.className = 'px-1 text-slate-400 text-xs font-bold';
                    dots2.textContent = '…';
                    numContainer.appendChild(dots2);
                }
                numContainer.appendChild(createInteractionPageBtn(totalPages));
            }
        }
    }

    // Toggle pagination wrapper visibility
    var paginationWrap = document.getElementById('interactionPaginationWrap');
    if (paginationWrap) {
        paginationWrap.style.display = (allRows.length === 0) ? 'none' : 'flex';
    }
}

function createInteractionPageBtn(page) {
    var btn = document.createElement('button');
    btn.type = 'button';
    btn.textContent = page;
    var isActive = (page === interactionPage);
    btn.className = 'w-7 h-7 rounded-lg text-xs font-bold transition flex items-center justify-center ' +
        (isActive
            ? 'bg-gradient-to-r from-cyan-500 to-indigo-500 text-white shadow-xs pointer-events-none'
            : 'border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-indigo-600');
    btn.onclick = function() {
        interactionPage = page;
        renderInteractionTable();
    };
    return btn;
}

function changeInteractionPage(delta) {
    var filteredRows = getFilteredInteractionRows();
    var totalPages = Math.ceil(filteredRows.length / INTERACTION_PER_PAGE) || 1;
    var targetPage = interactionPage + delta;
    if (targetPage >= 1 && targetPage <= totalPages) {
        interactionPage = targetPage;
        renderInteractionTable();
    }
}

function filterInteractions() {
    interactionPage = 1;
    renderInteractionTable();
}

function filterGameLogs() {
    var searchInput = document.getElementById('gameLogSearch');
    var clearBtn = document.getElementById('btnGameLogSearchClear');
    var query = (searchInput ? searchInput.value : '').trim().toLowerCase();

    if (clearBtn) {
        clearBtn.classList.toggle('hidden', query.length === 0);
    }

    var items = document.querySelectorAll('.game-log-item');
    var visibleCount = 0;
    items.forEach(function(item) {
        var studentData = item.getAttribute('data-student') || '';
        if (!query || studentData.indexOf(query) !== -1) {
            item.style.display = '';
            visibleCount++;
        } else {
            item.style.display = 'none';
        }
    });

    var noMatchEl = document.getElementById('gameLogNoMatch');
    if (noMatchEl) {
        noMatchEl.classList.toggle('hidden', visibleCount > 0 || items.length === 0);
    }
}

function clearGameLogSearch() {
    var searchInput = document.getElementById('gameLogSearch');
    if (searchInput) {
        searchInput.value = '';
    }
    filterGameLogs();
}

// ─── Engagement Milestone Students Pagination (3 per page) ─────────
var milestonePage = 1;
var MILESTONE_PER_PAGE = 3;

function renderMilestonePagination() {
    var allCards = Array.from(document.querySelectorAll('.milestone-student-card'));
    var total = allCards.length;
    var totalPages = Math.ceil(total / MILESTONE_PER_PAGE) || 1;

    if (milestonePage > totalPages) milestonePage = totalPages;
    if (milestonePage < 1) milestonePage = 1;

    var startIndex = (milestonePage - 1) * MILESTONE_PER_PAGE;
    var endIndex = Math.min(startIndex + MILESTONE_PER_PAGE, total);

    allCards.forEach(function(card, idx) {
        if (idx >= startIndex && idx < endIndex) {
            card.style.display = '';
        } else {
            card.style.display = 'none';
        }
    });

    var startEl = document.getElementById('milestoneStart');
    var endEl = document.getElementById('milestoneEnd');
    var totalEl = document.getElementById('milestoneTotal');
    if (startEl) startEl.textContent = total === 0 ? '0' : (startIndex + 1);
    if (endEl) endEl.textContent = total === 0 ? '0' : endIndex;
    if (totalEl) totalEl.textContent = total;

    var btnPrev = document.getElementById('btnPrevMilestonePage');
    var btnNext = document.getElementById('btnNextMilestonePage');
    if (btnPrev) btnPrev.disabled = (milestonePage <= 1);
    if (btnNext) btnNext.disabled = (milestonePage >= totalPages || total === 0);

    var numContainer = document.getElementById('milestonePageNumbers');
    if (numContainer) {
        numContainer.innerHTML = '';
        for (var p = 1; p <= totalPages; p++) {
            (function(page) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = page;
                var isActive = (page === milestonePage);
                btn.className = 'w-7 h-7 rounded-lg text-xs font-bold transition flex items-center justify-center ' +
                    (isActive
                        ? 'bg-gradient-to-r from-emerald-500 to-indigo-500 text-white shadow-xs pointer-events-none'
                        : 'border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-indigo-600');
                btn.onclick = function() {
                    milestonePage = page;
                    renderMilestonePagination();
                };
                numContainer.appendChild(btn);
            })(p);
        }
    }

    var wrap = document.getElementById('milestonePaginationWrap');
    if (wrap) {
        wrap.style.display = (total === 0) ? 'none' : 'flex';
    }
}

function changeMilestonePage(delta) {
    var allCards = document.querySelectorAll('.milestone-student-card');
    var totalPages = Math.ceil(allCards.length / MILESTONE_PER_PAGE) || 1;
    var targetPage = milestonePage + delta;
    if (targetPage >= 1 && targetPage <= totalPages) {
        milestonePage = targetPage;
        renderMilestonePagination();
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
        renderInteractionTable();
        renderMilestonePagination();
    });
} else {
    renderInteractionTable();
    renderMilestonePagination();
}

