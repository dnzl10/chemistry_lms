        desc: 'PDF documents only (.pdf)'
    },
    word: {
        label: 'Word Document',
        accept: '.doc,.docx,application/msword,application/vnd.openxmlformats-officedocument.wordprocessingml.document',
        extensions: ['.doc', '.docx'],
        icon: 'fas fa-file-word',
        iconColor: 'text-blue-500',
        badgeColor: 'bg-blue-50 text-blue-700 border-blue-100',
        desc: 'Word documents (.doc, .docx)'
    },
    img: {
        label: 'Image',
        accept: 'image/*,.jpg,.jpeg,.png,.gif,.webp,.svg',
        extensions: ['.jpg', '.jpeg', '.png', '.gif', '.webp', '.svg'],
        icon: 'fas fa-file-image',
        iconColor: 'text-emerald-500',
        badgeColor: 'bg-emerald-50 text-emerald-700 border-emerald-100',
        desc: 'Images (.jpg, .jpeg, .png, .gif, .webp, .svg)'
    },
    video: {
        label: 'Video',
        accept: 'video/*,.mp4,.mov,.avi,.mkv,.webm',
        extensions: ['.mp4', '.mov', '.avi', '.mkv', '.webm'],
        icon: 'fas fa-file-video',
        iconColor: 'text-purple-500',
        badgeColor: 'bg-purple-50 text-purple-700 border-purple-100',
        desc: 'Videos (.mp4, .mov, .avi, .mkv, .webm)'
    },
    presentation: {
        label: 'Presentation (PPT)',
        accept: '.ppt,.pptx,application/vnd.ms-powerpoint,application/vnd.openxmlformats-officedocument.presentationml.presentation',
        extensions: ['.ppt', '.pptx'],
        icon: 'fas fa-file-powerpoint',
        iconColor: 'text-amber-500',
        badgeColor: 'bg-amber-50 text-amber-700 border-amber-100',
        desc: 'Presentations (.ppt, .pptx)'
    },
    link: {
        label: 'External Link',
        accept: '',
        extensions: [],
        icon: 'fas fa-link',
        iconColor: 'text-cyan-500',
        badgeColor: 'bg-cyan-50 text-cyan-700 border-cyan-100',
        desc: 'Web Link (https://...)'
    }
};

function formatMatBytes(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    var k = 1024, dm = 1;
    var sizes = ['B', 'KB', 'MB', 'GB'];
    var i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(dm)) + ' ' + sizes[i];
}

function escapeMatHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

function toggleMatTypeFields() {
    var type = document.getElementById('matType').value;
    var isLink = (type === 'link');
    var fileWrap = document.getElementById('matFileWrap');
    var urlWrap  = document.getElementById('matUrlWrap');
    if (fileWrap) fileWrap.classList.toggle('hidden', isLink);
    if (urlWrap)  urlWrap.classList.toggle('hidden', !isLink);

    // Hide mismatch and url error when switching
    var mismatchAlert = document.getElementById('matFileMismatchAlert');
    if (mismatchAlert) mismatchAlert.classList.add('hidden');
    var errFile = document.getElementById('errMatFile');
    if (errFile) errFile.classList.add('hidden');
    var errUrl = document.getElementById('errMatUrl');
    if (errUrl) errUrl.classList.add('hidden');

    if (!isLink) {
        var cfg = MAT_TYPE_CONFIGS[type] || MAT_TYPE_CONFIGS.pdf;
        var fileInput = document.getElementById('matFile');
        if (fileInput) fileInput.accept = cfg.accept;

        var badge = document.getElementById('matTypeHintBadge');
        if (badge) {
            badge.className = 'text-[11px] font-bold px-2.5 py-0.5 rounded-full border flex items-center gap-1.5 shadow-2xs ' + cfg.badgeColor;
            badge.innerHTML = '<i class="' + cfg.icon + '"></i> <span>' + cfg.label + ' (' + cfg.extensions.join(', ') + ')</span>';
        }

        var hint = document.getElementById('matAllowedFormatsHint');
        if (hint) {
            hint.innerHTML = 'Accepted: <span class="text-slate-700 font-bold">' + cfg.extensions.join(', ') + '</span> (Max 100MB)';
        }

        // If a file was already selected, re-validate it against the new material type
        if (fileInput && fileInput.files && fileInput.files[0]) {
            validateMatFile(fileInput.files[0], type);
        } else {
            resetMatDropZoneStyle();
        }
    }
}

function resetMatDropZoneStyle() {
    var dropZone = document.getElementById('matDropZone');
    if (dropZone) {
        dropZone.className = 'border-2 border-dashed border-cyan-200 rounded-xl p-5 text-center cursor-pointer hover:border-cyan-400 hover:bg-cyan-50/20 transition group';
    }
}

function handleMatFileChange(input) {
    if (input.files && input.files[0]) {
        var type = document.getElementById('matType').value;
        validateMatFile(input.files[0], type);
    } else {
        clearSelectedMatFile();
    }
}

function validateMatFile(file, type) {
    var cfg = MAT_TYPE_CONFIGS[type];
    var mismatchAlert = document.getElementById('matFileMismatchAlert');
    var mismatchDesc  = document.getElementById('matFileMismatchDesc');
    var previewInfo   = document.getElementById('matSelectedFileInfo');
    var errFile       = document.getElementById('errMatFile');
    var dropZone      = document.getElementById('matDropZone');
    var fileInput     = document.getElementById('matFile');

    if (errFile) errFile.classList.add('hidden');

    if (!file) {
        clearSelectedMatFile();
        return false;
    }

    if (!cfg || type === 'link') return false;

    // 1. File size check (Max 100MB)
    if (file.size > 100 * 1024 * 1024) {
        if (mismatchDesc) {
            mismatchDesc.innerHTML = 'The selected file (<strong>' + escapeMatHtml(file.name) + '</strong>) is ' + formatMatBytes(file.size) + ', which exceeds the maximum limit of <strong>100MB</strong>.';
        }
        if (mismatchAlert) mismatchAlert.classList.remove('hidden');
        if (previewInfo) previewInfo.classList.add('hidden');
        if (dropZone) {
            dropZone.className = 'border-2 border-dashed border-rose-300 bg-rose-50/30 rounded-xl p-5 text-center cursor-pointer hover:border-rose-400 transition group';
        }
        if (fileInput) fileInput.value = '';
        showToast('File exceeds 100MB limit.', 'err');
        return false;
    }

    // 2. Extension validation against selected type
    var dotIdx = file.name.lastIndexOf('.');
    var ext = dotIdx !== -1 ? file.name.substring(dotIdx).toLowerCase() : '';
    var isMatch = cfg.extensions.includes(ext);

    if (!isMatch) {
        // MISMATCH DETECTED
        if (mismatchDesc) {
            var actualExtLabel = ext ? ('<strong>' + escapeMatHtml(ext) + '</strong>') : '<em>no extension</em>';
            mismatchDesc.innerHTML = 'You selected <strong>' + escapeMatHtml(cfg.label) + '</strong>, but uploaded <strong>' + escapeMatHtml(file.name) + '</strong> with extension ' + actualExtLabel + '. Allowed format(s): <span class="font-bold underline">' + cfg.extensions.join(', ') + '</span>.';
        }
        if (mismatchAlert) mismatchAlert.classList.remove('hidden');
        if (previewInfo) previewInfo.classList.add('hidden');
        if (dropZone) {
            dropZone.className = 'border-2 border-dashed border-rose-400 bg-rose-50/40 rounded-xl p-5 text-center cursor-pointer hover:border-rose-500 transition group';
        }
        if (fileInput) fileInput.value = '';

        showToast('Type mismatch: Please upload a ' + cfg.label + ' file (' + cfg.extensions.join(', ') + ').', 'err');
        return false;
    }

    // VALID FILE
    if (mismatchAlert) mismatchAlert.classList.add('hidden');
    if (dropZone) {
        dropZone.className = 'border-2 border-dashed border-emerald-400 bg-emerald-50/20 rounded-xl p-5 text-center cursor-pointer hover:border-emerald-500 transition group';
    }
    if (previewInfo) {
        document.getElementById('matSelectedFileName').textContent = file.name;
        document.getElementById('matSelectedFileSize').textContent = formatMatBytes(file.size) + ' • Matches ' + cfg.label;
        document.getElementById('matSelectedFileIcon').className = cfg.icon + ' text-sm ' + cfg.iconColor;
        previewInfo.classList.remove('hidden');
    }
    return true;
}

function clearSelectedMatFile(e) {
    if (e) {
        e.stopPropagation();
        e.preventDefault();
    }
    var fileInput = document.getElementById('matFile');
    if (fileInput) fileInput.value = '';
    var previewInfo = document.getElementById('matSelectedFileInfo');
    if (previewInfo) previewInfo.classList.add('hidden');
    var mismatchAlert = document.getElementById('matFileMismatchAlert');
    if (mismatchAlert) mismatchAlert.classList.add('hidden');
    var errFile = document.getElementById('errMatFile');
    if (errFile) errFile.classList.add('hidden');
    resetMatDropZoneStyle();
}

function resetAddMaterialModal() {
    var titleEl = document.getElementById('matTitle');
    if (titleEl) titleEl.value = '';
    var topicEl = document.getElementById('matTopicId');
    if (topicEl) topicEl.value = '';
    var typeEl = document.getElementById('matType');
    if (typeEl) typeEl.value = 'pdf';
    var lockedEl = document.getElementById('matLocked');
    if (lockedEl) lockedEl.checked = true;
    var urlEl = document.getElementById('matUrl');
    if (urlEl) urlEl.value = '';

    ['errMatTitle', 'errMatTopic', 'errMatFile', 'errMatUrl', 'matFileMismatchAlert'].forEach(function(id) {
        var el = document.getElementById(id);
        if (el) el.classList.add('hidden');
    });

    var btn = document.getElementById('btnSubmitMaterial');
    if (btn) {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-upload text-xs"></i> <span>Upload</span>';
    }

    clearSelectedMatFile();
    toggleMatTypeFields();
}

// Attach Drag & Drop to Dropzone
(function initMatDropZone() {
    function setupDrop() {
        var dropZone = document.getElementById('matDropZone');
        if (!dropZone) return;
        ['dragenter', 'dragover'].forEach(function(evt) {
            dropZone.addEventListener(evt, function(e) {
                e.preventDefault();
                e.stopPropagation();
                dropZone.classList.add('border-indigo-400', 'bg-indigo-50/30');
            });
        });
        ['dragleave', 'drop'].forEach(function(evt) {
            dropZone.addEventListener(evt, function(e) {
                e.preventDefault();
                e.stopPropagation();
                dropZone.classList.remove('border-indigo-400', 'bg-indigo-50/30');
            });
        });
        dropZone.addEventListener('drop', function(e) {
            var dt = e.dataTransfer;
            if (dt && dt.files && dt.files.length) {
                var fileInput = document.getElementById('matFile');
                if (fileInput) {
                    fileInput.files = dt.files;
                    handleMatFileChange(fileInput);
                }
            }
        });
    }
    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupDrop);
    } else {
        setupDrop();
    }
})();

// ─── Material ellipsis menu ──────────────────────────────
function toggleMaterialMenu(e, btn) {
    if (e) {
        e.stopPropagation();
        e.preventDefault();
    }
    var container = btn.closest('.mat-menu-container');
    var dropdown = container ? container.querySelector('.mat-menu-dropdown') : null;
    var card = btn.closest('.mat-card');
    var isAlreadyOpen = dropdown && !dropdown.classList.contains('hidden');

    closeAllMaterialMenus();

    if (!isAlreadyOpen && dropdown) {
        dropdown.classList.remove('hidden');
        btn.classList.add('bg-indigo-50', 'text-indigo-600', 'border-indigo-100');
        if (card) {
            card.classList.add('menu-open');
        }

        // Auto-flip upward if too close to viewport bottom
        var rect = dropdown.getBoundingClientRect();
        if (rect.bottom > window.innerHeight - 20) {
            dropdown.classList.remove('top-full', 'mt-1');
            dropdown.classList.add('bottom-full', 'mb-1');
        } else {
            dropdown.classList.remove('bottom-full', 'mb-1');
            dropdown.classList.add('top-full', 'mt-1');
        }
    }
}

function closeAllMaterialMenus() {
    document.querySelectorAll('.mat-menu-dropdown').forEach(function(d) {
        d.classList.add('hidden');
        d.classList.remove('bottom-full', 'mb-1');
        d.classList.add('top-full', 'mt-1');
    });
    document.querySelectorAll('.mat-menu-container > button').forEach(function(b) {
        b.classList.remove('bg-indigo-50', 'text-indigo-600', 'border-indigo-100');
    });
    document.querySelectorAll('.mat-card.menu-open').forEach(function(c) {
        c.classList.remove('menu-open');
    });
}

document.addEventListener('click', function(e) {
    if (!e.target.closest('.mat-menu-container')) {
        closeAllMaterialMenus();
    }
});

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.key === 'Esc') {
        closeAllMaterialMenus();
    }
});

// ─── Topic Materials Expansion Toggle ─────────────────────
function toggleTopicMaterialsExpansion(btn, topicId, totalCount) {
    var isExpanded = btn.getAttribute('data-expanded') === 'true';
    var grid = document.getElementById('matGrid_' + topicId);
    if (!grid) return;

    var overflowItems = grid.querySelectorAll('.mat-overflow-item');
    var chevron = btn.querySelector('i');
    var btnText = btn.querySelector('.btn-text');

    if (isExpanded) {
        // Collapse back to 5
        overflowItems.forEach(function(item) {
            item.classList.add('hidden');
        });
        btn.setAttribute('data-expanded', 'false');
        if (chevron) chevron.className = 'fas fa-chevron-down text-[10px] transition-transform';
        if (btnText) btnText.textContent = 'Expand to view all (' + (totalCount - 5) + ' more)';
    } else {
        // Expand to reveal all
        overflowItems.forEach(function(item) {
            item.classList.remove('hidden');
        });
        btn.setAttribute('data-expanded', 'true');
        if (chevron) chevron.className = 'fas fa-chevron-up text-[10px] transition-transform';
        if (btnText) btnText.textContent = 'Show less';
    }
}

