<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Resources &amp; Engagement | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="/js/admin_spa_handler.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .glass-card { background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); }

        .stat-card { transition: transform 0.18s ease, box-shadow 0.18s ease; }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.10); }

        .pulse-badge { animation: pulseRing 2s infinite; }
        @keyframes pulseRing { 0%,100% { opacity:1; } 50% { opacity:0.45; } }

        .table-scroll { max-height: 300px; overflow-y: auto; }
        .table-scroll::-webkit-scrollbar { width: 3px; }
        .table-scroll::-webkit-scrollbar-thumb { background: #c7d2fe; border-radius:2px; }

        .nav-active {
            background: linear-gradient(135deg, #06b6d4, #6366f1) !important;
            color: white !important; font-weight: 700;
            box-shadow: 0 4px 14px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }

        .fade-in { animation: fadeUp 0.35s ease both; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }

        .live-dot {
            width:8px; height:8px; border-radius:50%; background:#22c55e;
            box-shadow: 0 0 0 0 rgba(34,197,94,0.7);
            animation: livePulse 1.6s infinite; display:inline-block;
        }
        @keyframes livePulse {
            0%   { box-shadow: 0 0 0 0 rgba(34,197,94,0.7); }
            70%  { box-shadow: 0 0 0 7px rgba(34,197,94,0); }
            100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
        }

        /* ── TABS ── */
        .re-tab { transition: all 0.2s; border-bottom: 3px solid transparent; }
        .re-tab.active { border-bottom-color: #06b6d4; color: #0891b2; font-weight: 800; }
        .re-tab:not(.active):hover { color: #0891b2; }
        .re-pane { display: none; }
        .re-pane.active { display: block; }

        /* ── MATERIAL CARDS ── */
        .mat-card {
            background: white; border-radius: 16px; border: 1.5px solid #e2e8f0;
            transition: all 0.18s ease; position: relative;
        }
        .mat-card:hover { border-color: #06b6d4; box-shadow: 0 8px 24px rgba(6,182,212,0.12); }
        .mat-card.menu-open { z-index: 50 !important; }

        /* ── ACCORDION ── */
        .accordion-body { display: none; }
        .accordion-body.open { display: block; }
        .accordion-toggle .chevron { transition: transform 0.2s; }
        .accordion-toggle.open .chevron { transform: rotate(180deg); }

        /* ── MODAL ── */
        .re-modal {
            position: fixed; inset: 0; background: rgba(15,23,42,0.6);
            backdrop-filter: blur(6px); z-index: 9000;
            display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; transition: opacity 0.2s;
            padding: 16px;
        }
        .re-modal.open { opacity: 1; pointer-events: all; }
        .re-modal-box {
            background: white; border-radius: 20px; width: 95%;
            max-width: 580px; max-height: 90vh; overflow-y: auto;
            transform: scale(0.96) translateY(10px); transition: transform 0.2s;
            box-shadow: 0 32px 80px rgba(0,0,0,0.18);
        }
        .re-modal.open .re-modal-box { transform: scale(1) translateY(0); }
        .re-modal-box-sm { max-width: 440px; }
        .re-modal-box-lg { max-width: 700px; }

        /* ── FORM INPUTS ── */
        .fi {
            width: 100%; padding: 10px 14px; border-radius: 10px;
            border: 1.5px solid #e2e8f0; font-size: 13px;
            background: #f8fafc; color: #1e293b; font-family: inherit;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .fi:focus { border-color: #06b6d4; box-shadow: 0 0 0 3px rgba(6,182,212,0.1); outline: none; }

        /* ── BADGE ── */
        .re-badge {
            display: inline-flex; align-items: center; gap: 3px;
            font-size: 10px; font-weight: 800; padding: 2px 8px;
            border-radius: 99px; text-transform: uppercase; letter-spacing: .05em;
        }

        /* ── TOAST ── */
        #reToast {
            position: fixed; bottom: 24px; right: 24px; z-index: 99999;
            padding: 13px 20px; border-radius: 14px; font-weight: 700; font-size: 13px;
            display: flex; align-items: center; gap: 9px; min-width: 220px;
            box-shadow: 0 8px 30px rgba(0,0,0,.18);
            transform: translateY(60px); opacity: 0; pointer-events: none;
            transition: all .3s cubic-bezier(.34,1.56,.64,1);
        }
        #reToast.show  { transform: translateY(0); opacity: 1; }
        #reToast.ok    { background: linear-gradient(135deg,#10b981,#059669); color:white; }
        #reToast.err   { background: linear-gradient(135deg,#ef4444,#dc2626); color:white; }
        #reToast.warn  { background: linear-gradient(135deg,#f59e0b,#d97706); color:white; }
        #reToast.info  { background: linear-gradient(135deg,#6366f1,#4f46e5); color:white; }

        /* ── PROGRESS BAR ── */
        .prog-bar { height: 6px; border-radius: 3px; background: #e2e8f0; overflow: hidden; }
        .prog-fill { height: 100%; border-radius: 3px; background: linear-gradient(90deg,#06b6d4,#6366f1); transition: width 0.5s ease; }

        /* ── FILE TYPE ICON COLORS ── */
        .icon-pdf   { color: #ef4444; }
        .icon-word  { color: #3b82f6; }
        .icon-img   { color: #10b981; }
        .icon-video { color: #8b5cf6; }
        .icon-link  { color: #f59e0b; }
        .icon-ppt   { color: #f97316; }
        .icon-default { color: #64748b; }

        /* Data table */
        .re-table th {
            background: #f0fdfa; font-size: 10px; text-transform: uppercase;
            letter-spacing: .07em; color: #0891b2; font-weight: 800;
            border-bottom: 2px solid #ccfbf1;
        }
        .re-table td { border-bottom: 1px solid #f1f5f9; vertical-align: middle; color: #475569; }
        .re-table tbody tr:hover { background: #f0fdfa; }

        /* Button icon */
        .btn-ic {
            width: 30px; height: 30px; border-radius: 8px;
            display: inline-flex; align-items: center; justify-content: center;
            transition: all .15s; font-size: 11px; cursor: pointer; border: none;
        }
        .btn-ic:hover { transform: scale(1.1); }
        .btn-edit   { background: rgba(6,182,212,0.1);  color: #0891b2; border: 1px solid rgba(6,182,212,0.2); }
        .btn-del    { background: rgba(239,68,68,0.1);   color: #dc2626; border: 1px solid rgba(239,68,68,0.2); }
        .btn-view   { background: rgba(99,102,241,0.1);  color: #6366f1; border: 1px solid rgba(99,102,241,0.2); }
    </style>
</head>
<body class="text-slate-900">
<div class="flex min-h-screen relative overflow-x-hidden">

    <!-- Mobile overlay -->
    <div id="sidebarOverlay" onclick="toggleSidebar()"
         class="fixed inset-0 bg-cyan-900/50 z-40 hidden md:hidden"></div>

    <!-- ═══════════ SIDEBAR ═══════════ -->
    <aside id="sidebar"
        class="bg-indigo-950 text-white w-64 flex-shrink-0 flex flex-col z-50 fixed inset-y-0 left-0 -translate-x-full md:translate-x-0 h-screen border-r border-indigo-800/50">

        <div class="pt-8 pb-4 px-4 flex flex-col items-center text-center relative">
            <!-- Mobile close button -->
            <button onclick="toggleSidebar()" class="md:hidden text-indigo-300 hover:text-white absolute top-4 right-4">
                <i class="fas fa-times text-xl"></i>
            </button>

            <!-- Logo -->
            <img src="/assets/logo.png" alt="ChemArcade Logo" class="w-16 h-16 object-contain mb-3">

            <!-- Brand name -->
            <h1 class="text-xl font-black tracking-tighter text-cyan-400 uppercase italic leading-none">
                Elem<span class="text-white">enta</span>
            </h1>
            <p class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest mt-1">Admin Console</p>

            <!-- Divider -->
            <!-- <div class="w-full mt-5 border-t border-indigo-800/60"></div> -->
        </div>
        <nav class="flex-1 px-4 mt-4 space-y-6 overflow-y-auto no-scrollbar pb-6">
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Main Interface</p>
                <a href="/admin/dashboard" class="flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white hover:bg-white/10 group">
                    <i class="fas fa-chart-pie w-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
                    <span class="font-bold tracking-tight text-sm">Main Dashboard</span>
                </a>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Administrative</p>
                <div class="space-y-1">
                    <a href="/admin/user_access_control" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-users w-5 text-sky-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">User &amp; Access Control</span>
                    </a>
                    <a href="/admin/academic_management" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-graduation-cap w-5 text-emerald-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Academic Management</span>
                    </a>
                </div>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Learning Assets</p>
                <div class="space-y-1">
                    <a href="/admin/gaming_question_bank" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-gamepad w-5 text-amber-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Gaming &amp; Q-Bank</span>
                    </a>
                    <a href="/admin/resources_engagement" class="nav-active flex items-center gap-3 p-3 rounded-xl transition group">
                        <i class="fas fa-lightbulb w-5 text-lime-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Resources &amp; Engagement</span>
                    </a>
                </div>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">System Health</p>
                <div class="space-y-1">
                    <a href="/admin/reports_monitoring" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-chart-line w-5 text-blue-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Reports &amp; Monitoring</span>
                    </a>
                    <a href="/admin/system_audit" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-fingerprint w-5 text-indigo-300 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">System Audit</span>
                    </a>
                </div>
            </div>
        </nav>

        <div class="p-4 border-t border-indigo-800">
            <a href="/logout" class="flex items-center gap-3 p-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition group font-bold">
                <i class="fas fa-right-from-bracket w-5"></i> Log Out
            </a>
        </div>
    </aside>

    <!-- ═══════════ MAIN ═══════════ -->
    <main class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- Header -->
        <header class="h-20 bg-white/90 backdrop-blur-md border-b border-cyan-100 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-cyan-50 text-cyan-600 md:hidden">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <div>
                    <h2 class="text-lg font-bold text-indigo-900 uppercase tracking-tight flex items-center gap-2">
                        <i class="fas fa-lightbulb text-lime-500"></i>
                        Resources &amp; Engagement
                    </h2>
                    <p class="text-xs text-slate-400 hidden sm:block">
                        <span class="live-dot mr-1"></span>
                        Learning Vault &nbsp;·&nbsp; Forum &nbsp;·&nbsp; Analytics &nbsp;·&nbsp; Leaderboard
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3 md:gap-6">
                <!-- Dynamic School Year Context Selector -->
                <%- include('../partials/admin_sy_selector') %>

                <!-- Notification bell -->
                <div id="notifBellBtn" class="relative cursor-pointer p-2 hover:bg-cyan-50 rounded-full transition" onclick="toggleNotifPanel()">
                    <i class="far fa-bell text-xl text-cyan-600"></i>
                    <span id="notifDot" class="absolute top-2 right-2 flex h-2.5 w-2.5 hidden">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                    </span>
                    <span id="notifCount" class="absolute -top-0.5 -right-0.5 hidden bg-rose-500 text-white text-[9px] font-black rounded-full w-4 h-4 flex items-center justify-center"></span>
                </div>

                <!-- Admin profile -->
                <div class="flex items-center gap-3 pl-4 border-l border-cyan-100">
                    <div class="text-right hidden lg:block">
                        <p class="text-sm font-bold text-indigo-900"><%= user.first_name %> <%= user.last_name %></p>
                        <p class="text-[10px] uppercase font-black text-rose-500 tracking-widest">Administrator</p>
                    </div>
                    <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                         class="w-10 h-10 rounded-xl object-cover ring-2 ring-rose-400 shadow-sm">
                </div>
            </div>
        </header>

        <!-- Body -->
        <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
            <div id="adminMainContent" class="p-4 md:p-8 flex-1 fade-in">

                <!-- Dynamic Academic Context Warning Banner (Archive / Draft) -->
                <%- include('../partials/admin_sy_banner') %>

                <!-- ── KPI STAT CARDS ── -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="stat-card glass-card rounded-2xl p-5 border border-cyan-100">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-cyan-50 border border-cyan-200 flex items-center justify-center">
                                <i class="fas fa-folder-open text-cyan-600"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Materials Vault</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= reStats.totalMaterials %></p>
                        <p class="text-xs text-slate-400 mt-1">Preserved materials</p>
                    </div>
                    <div class="stat-card glass-card rounded-2xl p-5 border border-indigo-100">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-indigo-50 border border-indigo-200 flex items-center justify-center">
                                <i class="fas fa-comments text-indigo-500"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Forums (<%= typeof selectedSY !== 'undefined' && selectedSY ? selectedSY.school_year_range : '' %>)</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= reStats.totalForums %></p>
                        <p class="text-xs text-slate-400 mt-1">Discussion threads</p>
                    </div>
                    <div class="stat-card glass-card rounded-2xl p-5 border border-emerald-100">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center">
                                <i class="fas fa-hand-pointer text-emerald-600"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Interactions</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= reStats.totalInteractions %></p>
                        <p class="text-xs text-slate-400 mt-1">Views &amp; activities</p>
                    </div>
                    <div class="stat-card glass-card rounded-2xl p-5 border border-amber-100">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center">
                                <i class="fas fa-trophy text-amber-500"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Enrolled Students</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= reStats.totalStudents %></p>
                        <p class="text-xs text-slate-400 mt-1"><%= typeof selectedSY !== 'undefined' && selectedSY ? selectedSY.school_year_range : 'Academic Year' %></p>
                    </div>
                </div>

                <!-- ── PILLAR TABS ── -->
                <div class="glass-card rounded-2xl border border-cyan-100 overflow-hidden">

                    <!-- Tab nav -->
                    <div class="flex items-center gap-1 px-6 pt-4 border-b border-cyan-100 overflow-x-auto no-scrollbar flex-wrap">
                        <button class="re-tab active px-4 py-3 text-sm font-bold text-slate-500 whitespace-nowrap" onclick="switchTab('pillar1',this)">
                            <i class="fas fa-folder-open mr-1.5 text-cyan-500"></i> Learning Vault
                        </button>
                        <button class="re-tab px-4 py-3 text-sm font-bold text-slate-500 whitespace-nowrap" onclick="switchTab('pillar2',this)">
                            <i class="fas fa-comments mr-1.5 text-indigo-500"></i> Forum Moderation
                        </button>
                        <button class="re-tab px-4 py-3 text-sm font-bold text-slate-500 whitespace-nowrap" onclick="switchTab('pillar3',this)">
                            <i class="fas fa-chart-bar mr-1.5 text-emerald-500"></i> Engagement Analytics
                        </button>
                        <button class="re-tab px-4 py-3 text-sm font-bold text-slate-500 whitespace-nowrap" onclick="switchTab('pillar4',this)">
                            <i class="fas fa-trophy mr-1.5 text-amber-500"></i> Progress &amp; Rewards
                        </button>
                    </div>

                    <!-- ═══════════════════════════════════════════════
                         PILLAR 1 — LEARNING VAULT
                    ═══════════════════════════════════════════════ -->
                    <div id="pillar1" class="re-pane active p-6">

                        <!-- Toolbar -->
                        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 mb-6">
                            <div>
                                <h3 class="font-black text-indigo-900 text-lg">Learning Vault</h3>
                                <p class="text-xs text-slate-400">Manage all uploaded learning materials, grouped by Quarter &rarr; Topic.</p>
                            </div>
                            <button onclick="resetAddMaterialModal(); openModal('modalAddMaterial')"
                                class="flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-indigo-500 text-white font-bold text-sm px-4 py-2.5 rounded-xl hover:opacity-90 transition shadow-md whitespace-nowrap">
                                <i class="fas fa-plus"></i> Upload Material
                            </button>
                        </div>

                        <!-- Search bar -->
                        <div class="relative mb-5">
                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                            <input id="matSearch" type="text" placeholder="Search materials, topics, subjects, quarters…"
                                class="fi pl-9 pr-9" oninput="filterMaterials()">
                            <button id="matSearchClear" type="button" onclick="clearMaterialSearch()" 
                                class="absolute right-3 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 hidden text-sm" title="Clear search">
                                <i class="fas fa-times-circle"></i>
                            </button>
                        </div>

                        <!-- Accordion: Subject > Quarter > Topic > Material Cards -->
                        <div id="materialAccordion" class="space-y-5">
                        <div id="matNoResults" class="hidden py-14 text-center text-slate-400 bg-white rounded-2xl border border-slate-200">
                            <i class="fas fa-search text-4xl text-slate-300 block mb-3"></i>
                            <p class="font-bold text-slate-600 text-sm">No matching materials or topics found</p>
                            <p class="text-xs text-slate-400 mt-1">No results matching "<span id="matNoResultsQuery" class="font-semibold text-slate-600"></span>"</p>
                            <button type="button" onclick="clearMaterialSearch()" class="mt-3 px-3.5 py-1.5 rounded-xl bg-slate-100 hover:bg-slate-200 text-slate-600 text-xs font-bold transition">
                                Clear Search
                            </button>
                        </div>
                        <% if (quarters.length === 0) { %>
                            <div class="py-14 text-center text-slate-400">
                                <i class="fas fa-folder-open text-5xl block mb-3 opacity-20"></i>
                                <p class="font-bold">No materials uploaded yet.</p>
                            </div>
                        <% } %>
                        <%
                            /* Group quarters by subject */
                            var subjectMap = {};
                            quarters.forEach(function(q) {
                                var key = q.subject_id || 'none';
                                if (!subjectMap[key]) {
                                    subjectMap[key] = { subject_id: q.subject_id, subject_name: q.subject_name || 'Unknown Subject', quarters: [] };
                                }
                                subjectMap[key].quarters.push(q);
                            });
                            var subjectGroups = Object.values(subjectMap).sort(function(a, b) {
                                return a.subject_name.localeCompare(b.subject_name, undefined, { numeric: true, sensitivity: 'base' });
                            });
                        %>
                        <% subjectGroups.forEach(function(s, si) { %>
                            <!-- ── SUBJECT BLOCK ── -->
                            <div class="mat-subject border-2 border-indigo-200 rounded-2xl overflow-hidden bg-indigo-50/40" data-subject="<%= (s.subject_name || '').toLowerCase() %>">
                                <!-- Subject Header -->
                                <button class="accordion-toggle w-full flex items-center justify-between px-5 py-4 bg-gradient-to-r from-indigo-100 to-cyan-50 hover:from-indigo-200 hover:to-cyan-100 transition"
                                    onclick="toggleAccordion(this)">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-indigo-500 to-cyan-500 flex items-center justify-center shadow">
                                            <i class="fas fa-book text-white text-sm"></i>
                                        </div>
                                        <div class="text-left">
                                            <p class="font-black text-indigo-900 text-base"><%= s.subject_name %></p>
                                            <p class="text-[10px] text-slate-500"><%= s.quarters.length %> quarter(s)</p>
                                        </div>
                                    </div>
                                    <i class="fas fa-chevron-down chevron text-indigo-400 text-sm"></i>
                                </button>
                                <!-- Subject Body -->
                                <div class="accordion-body open">
                                <div class="p-4 space-y-4">
                        <% s.quarters.forEach(function(q) { %>
                            <div class="mat-quarter border border-cyan-100 rounded-2xl overflow-hidden" data-quarter="quarter <%= q.quarter_number %> q<%= q.quarter_number %>">
                                <!-- Quarter Header -->
                                <button class="accordion-toggle w-full flex items-center justify-between p-4 bg-cyan-50 hover:bg-cyan-100 transition"
                                    onclick="toggleAccordion(this)">
                                    <div class="flex items-center gap-3">
                                        <div class="w-8 h-8 rounded-lg bg-cyan-500 flex items-center justify-center">
                                            <span class="text-white text-xs font-black">Q<%= q.quarter_number %></span>
                                        </div>
                                        <div class="text-left">
                                            <p class="font-black text-indigo-900 text-sm">Quarter <%= q.quarter_number %></p>
                                            <p class="text-[10px] text-slate-400"><%= q.subject_name %> &nbsp;&middot;&nbsp; <%= q.topicCount %> topic(s)</p>
                                        </div>
                                    </div>
                                    <i class="fas fa-chevron-down chevron text-slate-400 text-sm"></i>
                                </button>
                                <!-- Accordion body -->
                                <div class="accordion-body">
                                <% q.topics.forEach(function(t) { %>
                                    <div class="mat-topic-section p-4 border-t border-cyan-50" data-topic="<%= (t.topic_name || '').toLowerCase() %>">
                                        <!-- Topic label -->
                                        <div class="flex items-center gap-2 mb-3">
                                            <div class="w-2 h-2 rounded-full bg-indigo-400"></div>
                                            <p class="text-sm font-bold text-indigo-700"><%= t.topic_name %></p>
                                            <span class="text-[10px] text-slate-400">(<%= t.materials.length %> file<% if(t.materials.length!==1){%>s<%}%>)</span>
                                        </div>
                                        <!-- Material cards grid / empty state -->
                                        <% if (t.materials.length === 0) { %>
                                            <!-- Empty State Component for Topic -->
                                            <div class="rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50/70 p-6 text-center transition hover:border-indigo-200">
                                                <div class="w-12 h-12 mx-auto rounded-2xl bg-indigo-50 border border-indigo-100 flex items-center justify-center text-indigo-500 mb-2.5 shadow-xs">
                                                    <i class="fas fa-folder-open text-xl"></i>
                                                </div>
                                                <p class="text-xs font-black text-slate-800">No Learning Materials Uploaded</p>
                                                <p class="text-[11px] text-slate-400 mt-1 max-w-sm mx-auto">This topic has no attached documents, presentations, or links yet.</p>
                                                <button type="button" onclick="openUploadMaterialForTopic(<%= t.topic_id %>)"
                                                    class="mt-3.5 inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold transition border border-indigo-200/70 shadow-xs">
                                                    <i class="fas fa-plus-circle text-xs"></i>
                                                    <span>Upload for this Topic</span>
                                                </button>
                                            </div>
                                        <% } else { %>
                                        <div class="flex flex-col gap-2 mat-grid" id="matGrid_<%= t.topic_id %>">
                                        <% t.materials.forEach(function(m, mIdx) { %>
                                            <% 
                                                var uploadDateStr = '—';
                                                var uploadTimeStr = '';
                                                if (m.created_at) {
                                                    var dt = new Date(m.created_at);
                                                    uploadDateStr = dt.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
                                                    uploadTimeStr = dt.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
                                                }
                                                var uploaderDisplayName = m.uploader_name || 'System Administrator';
                                                var uploaderDisplayRole = m.uploader_role || 'Admin';
                                                var isOverflow = mIdx >= 5;
                                            %>
                                            <!-- Compact horizontal material row -->
                                            <div class="mat-card mat-item flex items-center gap-3 px-3.5 py-3 <%= isOverflow ? 'mat-overflow-item hidden' : '' %>"
                                                data-index="<%= mIdx %>"
                                                data-search="<%= (m.title + ' ' + t.topic_name + ' ' + (s.subject_name || '') + ' quarter ' + q.quarter_number + ' q' + q.quarter_number + ' ' + (m.material_type || '') + ' ' + uploaderDisplayName + ' ' + uploaderDisplayRole + ' ' + uploadDateStr).toLowerCase() %>">
                                                <!-- Icon -->
                                                <div class="w-9 h-9 rounded-xl flex-shrink-0 flex items-center justify-center shadow-xs
                                                    <% if(m.material_type==='pdf'){%>bg-red-50 text-red-500<%}else if(m.material_type==='video'){%>bg-violet-50 text-violet-500<%}else if(m.material_type==='img'){%>bg-emerald-50 text-emerald-600<%}else if(m.material_type==='link'){%>bg-amber-50 text-amber-500<%}else if(m.material_type==='presentation'){%>bg-orange-50 text-orange-500<%}else{%>bg-slate-50 text-slate-500<%}%>">
                                                    <i class="text-base <%
                                                        if(m.material_type==='pdf'){%>fas fa-file-pdf icon-pdf<%
                                                        }else if(m.material_type==='word'){%>fas fa-file-word icon-word<%
                                                        }else if(m.material_type==='img'){%>fas fa-image icon-img<%
                                                        }else if(m.material_type==='video'){%>fas fa-video icon-video<%
                                                        }else if(m.material_type==='link'){%>fas fa-link icon-link<%
                                                        }else if(m.material_type==='presentation'){%>fas fa-file-powerpoint icon-ppt<%
                                                        }else{%>fas fa-file icon-default<%}%>"></i>
                                                </div>
                                                <!-- Info -->
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-center gap-2">
                                                        <p class="font-extrabold text-xs text-indigo-950 truncate leading-tight" title="<%= m.title %>"><%= m.title %></p>
                                                    </div>
                                                    <!-- Metadata: Type, Uploader, Date & Time -->
                                                    <div class="flex items-center gap-2 mt-1 flex-wrap text-[11px] leading-tight">
                                                        <span class="text-[9px] font-black uppercase tracking-wider text-slate-400 bg-slate-100/80 px-1.5 py-0.5 rounded">
                                                            <%= m.material_type %>
                                                        </span>
                                                        <span class="text-slate-300 font-bold">&middot;</span>
                                                        <span class="inline-flex items-center gap-1 text-slate-600 font-medium" title="Uploaded by">
                                                            <i class="fas fa-user-circle text-indigo-400 text-xs"></i>
                                                            <span class="font-bold text-slate-700 truncate max-w-[130px] sm:max-w-none"><%= uploaderDisplayName %></span>
                                                            <span class="text-[9px] px-1.5 py-0.5 rounded font-extrabold uppercase tracking-wider <%= uploaderDisplayRole === 'Admin' ? 'bg-violet-100 text-violet-700' : 'bg-cyan-100 text-cyan-800' %>">
                                                                <%= uploaderDisplayRole %>
                                                            </span>
                                                        </span>
                                                        <span class="text-slate-300 font-bold">&middot;</span>
                                                        <span class="inline-flex items-center gap-1 text-slate-400 font-medium" title="Upload Date &amp; Time">
                                                            <i class="far fa-clock text-slate-400 text-[10px]"></i>
                                                            <span><%= uploadDateStr %> <%= uploadTimeStr %></span>
                                                        </span>
                                                    </div>
                                                </div>
                                                <!-- Lock badge -->
                                                <% if (m.is_locked) { %>
                                                <span class="re-badge bg-red-50 text-red-500 border border-red-100 flex-shrink-0">
                                                    <i class="fas fa-lock text-[8px]"></i> Locked
                                                </span>
                                                <% } else { %>
                                                <span class="re-badge bg-emerald-50 text-emerald-600 border border-emerald-100 flex-shrink-0">
                                                    <i class="fas fa-lock-open text-[8px]"></i> Open
                                                </span>
                                                <% } %>
                                                <!-- Consolidated Actions Ellipsis Menu -->
                                                <div class="relative flex-shrink-0 mat-menu-container">
                                                    <button type="button" 
                                                        class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:bg-indigo-50/70 border border-transparent hover:border-indigo-100 transition"
                                                        title="Material Options"
                                                        onclick="toggleMaterialMenu(event, this)">
                                                        <i class="fas fa-ellipsis-v text-xs"></i>
                                                    </button>
                                                    <!-- Dropdown Menu -->
                                                    <div class="mat-menu-dropdown hidden absolute right-0 top-full mt-1 w-44 bg-white rounded-xl shadow-xl border border-slate-200/90 py-1 z-50 text-left">
                                                        <!-- Open / View -->
                                                        <a href="<%= m.material_type === 'link' ? m.file_path_or_url : (m.file_path_or_url.startsWith('/material_uploads') ? m.file_path_or_url : '/material_uploads/' + m.file_path_or_url) %>"
                                                           target="_blank"
                                                           class="flex items-center gap-2.5 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 transition"
                                                           onclick="closeAllMaterialMenus()">
                                                            <i class="fas fa-external-link-alt w-3.5 text-indigo-500"></i>
                                                            <span>Open / View</span>
                                                        </a>
                                                        <!-- Edit Details -->
                                                        <button type="button"
                                                            class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-cyan-50 hover:text-cyan-700 transition"
                                                            onclick='closeAllMaterialMenus(); openEditMaterial(<%- JSON.stringify(m) %>)'>
                                                            <i class="fas fa-pen w-3.5 text-cyan-500"></i>
                                                            <span>Edit Details</span>
                                                        </button>
                                                        <!-- Toggle Lock/Unlock -->
                                                        <button type="button"
                                                            class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-bold text-slate-700 hover:bg-amber-50 hover:text-amber-700 transition"
                                                            onclick="closeAllMaterialMenus(); toggleMatLock(<%= m.material_id %>, <%= m.is_locked %>)">
                                                            <i class="fas <%= m.is_locked ? 'fa-lock-open text-emerald-500' : 'fa-lock text-amber-500' %> w-3.5"></i>
                                                            <span><%= m.is_locked ? 'Unlock Material' : 'Lock Material' %></span>
                                                        </button>
                                                        <div class="my-1 border-t border-slate-100"></div>
                                                        <!-- Delete -->
                                                        <button type="button"
                                                            class="w-full flex items-center gap-2.5 px-3 py-2 text-xs font-bold text-rose-600 hover:bg-rose-50 transition"
                                                            onclick="closeAllMaterialMenus(); confirmDeleteMaterial(<%= m.material_id %>, '<%= m.title.replace(/'/g, '&#39;') %>')">
                                                            <i class="fas fa-trash w-3.5 text-rose-500"></i>
                                                            <span>Delete</span>
                                                        </button>
                                                    </div>
                                                </div>
                                            </div>
                                        <% }) %>
                                        </div>
                                        <% if (t.materials.length > 5) { %>
                                        <div class="mt-2.5 pt-1 flex justify-center mat-expand-wrapper">
                                            <button type="button" 
                                                class="mat-expand-btn text-xs font-bold text-indigo-600 hover:text-indigo-800 hover:bg-indigo-50 px-3.5 py-1.5 rounded-xl border border-indigo-200 transition flex items-center gap-2 shadow-xs"
                                                onclick="toggleTopicMaterialsExpansion(this, <%= t.topic_id %>, <%= t.materials.length %>)"
                                                data-expanded="false">
                                                <i class="fas fa-chevron-down text-[10px] transition-transform"></i>
                                                <span class="btn-text">Expand to view all (<%= t.materials.length - 5 %> more)</span>
                                            </button>
                                        </div>
                                        <% } %>
                                        <% } %>
                                    </div>
                                <% }) %>
                                </div>
                            </div>
                        <% }) %><!-- end quarters loop -->
                        </div><!-- /subject body inner -->
                        </div><!-- /subject accordion-body -->
                        </div><!-- /subject block -->
                        <% }) %><!-- end subjects loop -->
                        </div><!-- /accordion -->
                    </div><!-- /pillar1 -->

                    <!-- ═══════════════════════════════════════════════
                         PILLAR 2 — FORUM MODERATION
                    ═══════════════════════════════════════════════ -->
                    <div id="pillar2" class="re-pane p-6">

                        <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-3 mb-6">
                            <div>
                                <h3 class="font-black text-indigo-900 text-lg">Forum Moderation</h3>
                                <p class="text-xs text-slate-400">Create &amp; moderate discussion boards and threads across all topics.</p>
                            </div>
                            <div class="flex items-center gap-2">
                                <button onclick="openUnmaskLogsModal()"
                                    class="flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-sm px-4 py-2.5 rounded-xl transition whitespace-nowrap border border-slate-200">
                                    <i class="fas fa-shield-halved text-indigo-600"></i> Audit Unmasks
                                </button>
                                <button onclick="openModal('modalAddForum')"
                                    class="flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-violet-500 text-white font-bold text-sm px-4 py-2.5 rounded-xl hover:opacity-90 transition shadow-md whitespace-nowrap">
                                    <i class="fas fa-plus"></i> New Forum Board
                                </button>
                            </div>
                        </div>

                        <!-- Forum list -->
                        <div class="space-y-3" id="forumList">
                        <% if (forums.length === 0) { %>
                            <div class="py-14 text-center text-slate-400">
                                <div class="w-16 h-16 mx-auto mb-3 rounded-2xl bg-indigo-50 border border-indigo-200 flex items-center justify-center text-indigo-500 text-2xl shadow-sm">
                                    <i class="fas fa-comments"></i>
                                </div>
                                <p class="font-bold text-slate-700 text-base">No forum discussions for <%= typeof selectedSY !== 'undefined' && selectedSY ? selectedSY.school_year_range : 'this School Year' %></p>
                                <p class="text-xs text-slate-400 mt-1 max-w-sm mx-auto">
                                    Discussion boards refresh clean each school year to ensure students engage in fresh, unpolluted peer learning threads.
                                </p>
                            </div>
                        <% } %>
                        <% forums.forEach(function(f) { %>
                            <div class="border border-indigo-100 rounded-2xl overflow-hidden forum-board" data-forum-id="<%= f.forum_id %>">
                                <!-- Forum header -->
                                <div class="flex items-center justify-between p-4 bg-indigo-50 hover:bg-indigo-100 transition cursor-pointer"
                                    onclick="toggleForumReplies('<%= f.forum_id %>')">
                                    <div class="flex items-center gap-3 min-w-0">
                                        <div class="w-9 h-9 rounded-xl bg-indigo-500 flex items-center justify-center flex-shrink-0">
                                            <i class="fas fa-comments text-white text-sm"></i>
                                        </div>
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2">
                                                <p class="font-black text-indigo-900 text-sm truncate"><%= f.title %></p>
                                                <% if (f.is_pinned) { %>
                                                <span class="re-badge bg-amber-50 text-amber-600 border border-amber-100 flex-shrink-0">
                                                    <i class="fas fa-thumbtack text-[8px]"></i> Pinned
                                                </span>
                                                <% } %>
                                                <% if (f.status === 'solved') { %>
                                                <span class="re-badge bg-emerald-50 text-emerald-700 border border-emerald-200 flex-shrink-0">
                                                    <i class="fas fa-check-circle text-[8px]"></i> Solved
                                                </span>
                                                <% } else if (f.status === 'instructor_verified') { %>
                                                <span class="re-badge bg-blue-50 text-blue-700 border border-blue-200 flex-shrink-0">
                                                    <i class="fas fa-certificate text-[8px]"></i> Verified
                                                </span>
                                                <% } else { %>
                                                <span class="re-badge bg-amber-50 text-amber-600 border border-amber-200 flex-shrink-0">
                                                    <i class="fas fa-question-circle text-[8px]"></i> Unresolved
                                                </span>
                                                <% } %>
                                            </div>
                                            <p class="text-[10px] text-slate-400">
                                                Topic: <%= f.topic_name || 'General' %>
                                                &nbsp;&middot;&nbsp; <%= f.reply_count %> reply(-ies)
                                                &nbsp;&middot;&nbsp; by <%= f.teacher_name || 'System' %>
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 flex-shrink-0 ml-3">
                                        <button class="btn-ic btn-edit" title="Edit Forum"
                                            onclick='event.stopPropagation(); openEditForum(<%- JSON.stringify(f) %>)'>
                                            <i class="fas fa-pen"></i>
                                        </button>
                                        <button class="btn-ic btn-del" title="Delete Forum"
                                            onclick="event.stopPropagation(); confirmDeleteForum(<%= f.forum_id %>, '<%= f.title.replace(/'/g, '&#39;') %>')">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                        <i class="fas fa-chevron-down text-slate-400 text-sm transition-transform" id="forumChevron<%= f.forum_id %>"></i>
                                    </div>
                                </div>
                                <!-- Replies drill-down -->
                                <div id="forumReplies<%= f.forum_id %>" class="hidden">
                                    <div class="p-4 border-t border-indigo-100">
                                        <p class="text-xs font-bold text-indigo-700 uppercase tracking-wider mb-3">
                                            <i class="fas fa-reply mr-1"></i> Replies (<%= f.reply_count %>)
                                        </p>
                                        <% if (f.replies && f.replies.length > 0) { %>
                                        <div class="space-y-2">
                                        <% f.replies.forEach(function(r) { %>
                                            <div class="flex items-start gap-3 p-3 rounded-xl bg-white border <%= r.is_endorsed ? 'border-emerald-200 bg-emerald-50/20' : 'border-indigo-50' %>">
                                                <div class="w-7 h-7 rounded-full <%= r.is_endorsed ? 'bg-emerald-100 text-emerald-600' : 'bg-indigo-100 text-indigo-500' %> flex items-center justify-center flex-shrink-0">
                                                    <i class="fas <%= r.is_endorsed ? 'fa-check-circle' : 'fa-user' %> text-[10px]"></i>
                                                </div>
                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-center gap-2 flex-wrap">
                                                        <p class="text-xs font-bold text-indigo-800"><%= r.user_name %></p>
                                                        <% if (r.is_endorsed) { %>
                                                        <span class="re-badge bg-emerald-100 text-emerald-800 text-[9px] font-black">
                                                            <i class="fas fa-check-circle text-[8px]"></i> Endorsed
                                                        </span>
                                                        <% } %>
                                                        <% if (r.is_anonymous && !r.is_unmasked) { %>
                                                        <span class="re-badge bg-slate-100 text-slate-600 text-[9px] font-black">
                                                            <i class="fas fa-user-secret text-[8px]"></i> Anonymous
                                                        </span>
                                                        <% } %>
                                                        <span class="text-[10px] font-bold text-slate-500 bg-slate-100 px-2 py-0.5 rounded-full" title="Community Upvotes">
                                                            <i class="fas fa-arrow-up text-indigo-500 text-[8px] mr-1"></i><%= r.vote_count || 0 %>
                                                        </span>
                                                        <span class="text-[10px] text-slate-400">
                                                            <%= new Date(r.created_at).toLocaleDateString('en-PH', {month:'short', day:'numeric', year:'numeric'}) %>
                                                        </span>
                                                    </div>
                                                    <% if (r.reply_title) { %>
                                                    <p class="text-xs font-bold text-slate-800 mt-1"><i class="fas fa-heading text-indigo-500 text-[10px] mr-1"></i><%= r.reply_title %></p>
                                                    <% } %>
                                                    <p class="text-xs text-slate-600 mt-0.5 line-clamp-2"><%= r.reply_content %></p>
                                                </div>
                                                <div class="flex items-center gap-1.5 flex-shrink-0">
                                                    <% if (r.is_anonymous && !r.is_unmasked) { %>
                                                    <button class="btn-ic btn-edit" title="Break-Glass: Reveal Identity"
                                                        onclick="openAdminUnmaskModal(<%= r.reply_id %>)">
                                                        <i class="fas fa-eye"></i>
                                                    </button>
                                                    <% } %>
                                                    <% if ((r.vote_count || 0) > 0) { %>
                                                    <button class="btn-ic text-amber-500 hover:bg-amber-50" title="Reset Upvotes"
                                                        onclick="confirmResetVotes(<%= r.reply_id %>, <%= f.forum_id %>)">
                                                        <i class="fas fa-undo"></i>
                                                    </button>
                                                    <% } %>
                                                    <button class="btn-ic btn-del" title="Delete Reply"
                                                        onclick="confirmDeleteReply(<%= r.reply_id %>, <%= f.forum_id %>)">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                </div>
                                            </div>
                                        <% }) %>
                                        </div>
                                        <% } else { %>
                                        <p class="text-xs text-slate-400 italic">No replies yet.</p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                        </div><!-- /forumList -->
                    </div><!-- /pillar2 -->

                    <!-- ═══════════════════════════════════════════════
                         PILLAR 3 — ENGAGEMENT ANALYTICS
                    ═══════════════════════════════════════════════ -->
                    <div id="pillar3" class="re-pane p-6">

                        <!-- ═══════════════════════════════════════════════════════════
                             ANALYTICS OVERVIEW GRAPH & ALGORITHM
                             (Games vs. Learning Materials Engagement on Specific Date)
                        ════════════════════════════════════════════════════════════ -->
                        <div class="glass-card rounded-2xl border border-indigo-100 p-6 mb-8 shadow-xs transition hover:shadow-md">
                            
                            <!-- Header with Date Selection Toolbar -->
                            <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 pb-5 border-b border-indigo-50">
                                <div>
                                    <div class="flex items-center gap-2 mb-1">
                                        <div class="w-8 h-8 rounded-xl bg-gradient-to-tr from-cyan-500 to-indigo-600 text-white flex items-center justify-center text-sm shadow-xs">
                                            <i class="fas fa-chart-line"></i>
                                        </div>
                                        <h4 class="font-black text-indigo-950 text-base">Analytics Overview: Games vs. Learning Materials</h4>
                                        <span class="text-[10px] font-black uppercase tracking-wider bg-cyan-100/70 text-cyan-800 px-2.5 py-0.5 rounded-full border border-cyan-200">
                                            Dual-Modal Evaluation
                                        </span>
                                    </div>
                                    <p class="text-xs text-slate-500">
                                        Compare hourly student interactions between interactive arcade games and learning vault resources on any specific date.
                                    </p>
                                </div>

                                <!-- Date Selector Controls -->
                                <div class="flex flex-wrap items-center gap-2 bg-slate-50 p-1.5 rounded-2xl border border-slate-200">
                                    <div class="flex items-center gap-1.5 px-2">
                                        <i class="far fa-calendar-alt text-indigo-500 text-xs"></i>
                                        <label for="analyticsDateInput" class="text-xs font-bold text-slate-600">Select Date:</label>
                                    </div>
                                    <input type="date" id="analyticsDateInput" 
                                        class="bg-white border border-slate-200 text-slate-800 text-xs font-bold rounded-xl px-3 py-1.5 focus:outline-none focus:ring-2 focus:ring-indigo-500 shadow-2xs"
                                        onchange="onAnalyticsDateChange(this.value)">
                                    
                                    <button type="button" onclick="jumpToLatestAnalyticsDate()" title="Jump to date with most recent activity"
                                        class="px-2.5 py-1.5 rounded-xl bg-indigo-50 hover:bg-indigo-100 text-indigo-700 text-xs font-bold transition flex items-center gap-1 border border-indigo-100">
                                        <i class="fas fa-bolt text-[10px] text-amber-500"></i>
                                        <span>Latest Active</span>
                                    </button>
                                    <button type="button" onclick="setAnalyticsToday()" title="Set to Today"
                                        class="px-2.5 py-1.5 rounded-xl bg-white hover:bg-slate-100 text-slate-700 text-xs font-bold transition border border-slate-200">
                                        Today
                                    </button>
                                    <button type="button" onclick="refreshDateAnalytics()" title="Refresh Data"
                                        class="w-8 h-8 rounded-xl bg-white hover:bg-slate-100 text-slate-600 flex items-center justify-center transition border border-slate-200">
                                        <i id="btnRefreshAnalyticsIcon" class="fas fa-rotate text-xs"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Quick Date Jump Pills (dynamically populated) -->
                            <div class="flex items-center gap-2 pt-3 pb-1 overflow-x-auto no-scrollbar" id="analyticsQuickDatesWrap">
                                <span class="text-[11px] font-bold text-slate-400 whitespace-nowrap flex items-center gap-1">
                                    <i class="fas fa-history text-[10px]"></i> Active Dates:
                                </span>
                                <div id="analyticsQuickDatePills" class="flex items-center gap-1.5 flex-nowrap"></div>
                            </div>

                            <!-- Metric Cards Grid -->
                            <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 my-5">
                                
                                <!-- Card 1: Learning Materials -->
                                <div class="p-4 rounded-2xl bg-gradient-to-br from-cyan-50/70 to-blue-50/30 border border-cyan-100 shadow-2xs">
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="text-[10px] font-black uppercase tracking-wider text-cyan-800">Learning Materials</span>
                                        <div class="w-7 h-7 rounded-lg bg-cyan-100 text-cyan-700 flex items-center justify-center text-xs">
                                            <i class="fas fa-book-open"></i>
                                        </div>
                                    </div>
                                    <div class="flex items-baseline gap-2">
                                        <span id="statMatTotal" class="text-2xl font-black text-cyan-950">0</span>
                                        <span class="text-xs text-slate-500 font-semibold">interactions</span>
                                    </div>
                                    <div class="mt-2 pt-2 border-t border-cyan-100 flex items-center justify-between text-[11px] text-slate-500">
                                        <span><i class="fas fa-users text-cyan-500 mr-1"></i><span id="statMatStudents" class="font-bold text-slate-700">0</span> students</span>
                                        <span><span id="statMatViews" class="font-bold text-cyan-700">0</span> views &bull; <span id="statMatDownloads" class="font-bold text-blue-700">0</span> dl</span>
                                    </div>
                                </div>

                                <!-- Card 2: Games Activity -->
                                <div class="p-4 rounded-2xl bg-gradient-to-br from-indigo-50/70 to-purple-50/30 border border-indigo-100 shadow-2xs">
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="text-[10px] font-black uppercase tracking-wider text-indigo-800">Arcade Games</span>
                                        <div class="w-7 h-7 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center text-xs">
                                            <i class="fas fa-gamepad"></i>
                                        </div>
                                    </div>
                                    <div class="flex items-baseline gap-2">
                                        <span id="statGameTotal" class="text-2xl font-black text-indigo-950">0</span>
                                        <span class="text-xs text-slate-500 font-semibold">game sessions</span>
                                    </div>
                                    <div class="mt-2 pt-2 border-t border-indigo-100 flex items-center justify-between text-[11px] text-slate-500">
                                        <span><i class="fas fa-gamepad text-indigo-500 mr-1"></i><span id="statGamePlayers" class="font-bold text-slate-700">0</span> players</span>
                                        <span><span id="statGameCompleted" class="font-bold text-emerald-700">0</span> completed &bull; <span id="statGameSolo" class="font-bold text-indigo-700">0</span> solo</span>
                                    </div>
                                </div>

                                <!-- Card 3: Evaluated Engagement Leader -->
                                <div class="p-4 rounded-2xl bg-white border border-slate-200 shadow-2xs relative overflow-hidden">
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="text-[10px] font-black uppercase tracking-wider text-slate-500">Algorithm Verdict</span>
                                        <div id="statVerdictIcon" class="w-7 h-7 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center text-xs">
                                            <i class="fas fa-scale-balanced"></i>
                                        </div>
                                    </div>
                                    <p id="statVerdictBadge" class="text-sm font-black text-slate-800 truncate">Evaluating...</p>
                                    <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px]">
                                        <span class="text-slate-500">Share Ratio:</span>
                                        <span class="font-bold text-slate-700" id="statShareRatio">0% vs 0%</span>
                                    </div>
                                </div>

                                <!-- Card 4: Peak Activity Hour -->
                                <div class="p-4 rounded-2xl bg-gradient-to-br from-amber-50/60 to-orange-50/20 border border-amber-100 shadow-2xs">
                                    <div class="flex items-center justify-between mb-2">
                                        <span class="text-[10px] font-black uppercase tracking-wider text-amber-800">Peak Activity Hour</span>
                                        <div class="w-7 h-7 rounded-lg bg-amber-100 text-amber-700 flex items-center justify-center text-xs">
                                            <i class="fas fa-clock"></i>
                                        </div>
                                    </div>
                                    <div class="flex items-baseline gap-2">
                                        <span id="statPeakHour" class="text-base font-black text-slate-800">—</span>
                                    </div>
                                    <div class="mt-2 pt-2 border-t border-amber-100 flex items-center justify-between text-[11px] text-slate-500">
                                        <span>Combined Volume</span>
                                        <span id="statPeakCount" class="font-bold text-amber-700">0 actions</span>
                                    </div>
                                </div>

                            </div>

                            <!-- Main Graph & Split Proportion Visualization -->
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-stretch">
                                
                                <!-- Hourly Timeline Dual-Series Chart (8 Cols) -->
                                <div class="lg:col-span-8 p-4 rounded-2xl bg-white border border-slate-100 shadow-2xs flex flex-col justify-between">
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 mb-3">
                                        <div>
                                            <h5 class="text-xs font-black text-slate-800 flex items-center gap-1.5">
                                                <i class="fas fa-chart-column text-indigo-500"></i>
                                                <span>Hourly Interaction Timeline on <span id="chartDateLabel" class="text-indigo-600">—</span></span>
                                            </h5>
                                            <p class="text-[11px] text-slate-400">Distribution of learning material accesses vs game starts by hour of the day.</p>
                                        </div>
                                        <div class="flex items-center gap-3 text-[11px] font-bold">
                                            <span class="inline-flex items-center gap-1 text-cyan-700"><span class="w-2.5 h-2.5 rounded-sm bg-cyan-500 inline-block"></span> Materials</span>
                                            <span class="inline-flex items-center gap-1 text-indigo-700"><span class="w-2.5 h-2.5 rounded-sm bg-indigo-600 inline-block"></span> Games</span>
                                        </div>
                                    </div>
                                    <div class="relative w-full h-64">
                                        <canvas id="engagementComparisonChart"></canvas>
                                    </div>
                                </div>

                                <!-- Engagement Share & Summary Gauge Card (4 Cols) -->
                                <div class="lg:col-span-4 p-4 rounded-2xl bg-slate-50/70 border border-slate-200/80 flex flex-col justify-between">
                                    <div>
                                        <h5 class="text-xs font-black text-slate-800 mb-1 flex items-center gap-1.5">
                                            <i class="fas fa-pie-chart text-cyan-600"></i>
                                            <span>Engagement Balance Share</span>
                                        </h5>
                                        <p class="text-[11px] text-slate-500 mb-4">Relative weight of student focus on this day.</p>
                                        
                                        <!-- Visual Progress Split Bar -->
                                        <div class="w-full bg-slate-200 rounded-full h-3.5 flex overflow-hidden p-0.5 border border-slate-300/60 shadow-inner mb-2">
                                            <div id="barMatShare" class="bg-gradient-to-r from-cyan-400 to-cyan-500 h-full rounded-l-full transition-all duration-700" style="width: 50%"></div>
                                            <div id="barGameShare" class="bg-gradient-to-r from-indigo-500 to-indigo-600 h-full rounded-r-full transition-all duration-700" style="width: 50%"></div>
                                        </div>
                                        <div class="flex justify-between items-center text-xs font-black px-1 mb-4">
                                            <span class="text-cyan-700 flex items-center gap-1"><i class="fas fa-book text-[10px]"></i> Materials: <span id="labelMatPercent">50%</span></span>
                                            <span class="text-indigo-700 flex items-center gap-1"><i class="fas fa-gamepad text-[10px]"></i> Games: <span id="labelGamePercent">50%</span></span>
                                        </div>

                                        <!-- Quick Comparison Metrics -->
                                        <div class="space-y-2 text-xs">
                                            <div class="p-2.5 rounded-xl bg-white border border-slate-100 flex items-center justify-between">
                                                <span class="text-slate-500 text-[11px] font-semibold">Total Interactions:</span>
                                                <span id="quickTotalVol" class="font-black text-slate-800">0</span>
                                            </div>
                                            <div class="p-2.5 rounded-xl bg-white border border-slate-100 flex items-center justify-between">
                                                <span class="text-slate-500 text-[11px] font-semibold">Active Unique Learners:</span>
                                                <span id="quickTotalReach" class="font-black text-slate-800">0</span>
                                            </div>
                                            <div class="p-2.5 rounded-xl bg-white border border-slate-100 flex items-center justify-between">
                                                <span class="text-slate-500 text-[11px] font-semibold">Avg Intensity (actions/student):</span>
                                                <span id="quickIntensityRatio" class="font-black text-indigo-700">—</span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-4 pt-3 border-t border-slate-200">
                                        <p id="algorithmVerdictCallout" class="text-xs font-bold text-slate-700 leading-snug"></p>
                                    </div>
                                </div>

                            </div>

                        </div>

                        <!-- ═══════════════════════════════════════════════════════════
                             SECTION: ENGAGEMENT ANALYTICS LOGS & FEEDS
                        ════════════════════════════════════════════════════════════ -->
                        <div class="mb-4">
                            <h3 class="font-black text-indigo-900 text-lg mb-1">Engagement Analytics</h3>
                            <p class="text-xs text-slate-400 mb-6">Track who is actually studying and what they are consuming.</p>
                        </div>

                        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

                            <!-- Material Interaction Monitor (2/3 width) -->
                            <div class="lg:col-span-2 glass-card rounded-2xl border border-cyan-100 p-5 flex flex-col justify-between">
                                <div>
                                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                                        <div class="flex items-center gap-2">
                                            <p class="font-bold text-sm text-indigo-900 flex items-center gap-2">
                                                <i class="fas fa-hand-pointer text-cyan-500"></i> Material Interaction Log
                                            </p>
                                            <span class="text-[11px] font-bold text-indigo-700 bg-indigo-50 border border-indigo-100 px-2 py-0.5 rounded-full" id="interactionTotalBadge">
                                                <%= interactionLog.length %>
                                            </span>
                                        </div>
                                        <div class="relative">
                                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                            <input id="interactionSearch" type="text" placeholder="Search student or material…"
                                                class="fi pl-8 pr-7 py-1.5 text-xs w-full sm:w-56" oninput="filterInteractions()">
                                            <button id="btnInteractionSearchClear" type="button" onclick="clearInteractionSearch()"
                                                class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-300 hover:text-slate-600 text-xs">
                                                <i class="fas fa-times"></i>
                                            </button>
                                        </div>
                                    </div>
                                    <div class="table-scroll rounded-xl border border-cyan-50 min-h-[340px]">
                                        <table class="re-table w-full text-xs">
                                            <thead>
                                                <tr>
                                                    <th class="p-2.5 text-left">Student</th>
                                                    <th class="p-2.5 text-left hidden sm:table-cell">Material</th>
                                                    <th class="p-2.5 text-left">Type</th>
                                                    <th class="p-2.5 text-left hidden md:table-cell">Date &amp; Time</th>
                                                </tr>
                                            </thead>
                                            <tbody id="interactionTableBody">
                                            <% if (interactionLog.length === 0) { %>
                                                <tr id="interactionEmptyRow"><td colspan="4" class="p-8 text-center text-slate-400 italic">No interactions recorded yet.</td></tr>
                                            <% } %>
                                            <% interactionLog.forEach(function(i) { %>
                                                <tr class="interaction-row" data-search="<%= ((i.student_name || '') + ' ' + (i.material_title || '') + ' ' + (i.interaction_type || '')).toLowerCase() %>">
                                                    <td class="p-2.5 font-medium text-indigo-800 whitespace-nowrap">
                                                        <div class="flex items-center gap-2">
                                                            <div class="w-6 h-6 rounded-full bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-[10px] flex-shrink-0">
                                                                <%= (i.student_name || 'S').charAt(0).toUpperCase() %>
                                                            </div>
                                                            <span><%= i.student_name %></span>
                                                        </div>
                                                    </td>
                                                    <td class="p-2.5 text-slate-600 hidden sm:table-cell max-w-[160px] truncate" title="<%= i.material_title %>">
                                                        <%= i.material_title || '—' %>
                                                    </td>
                                                    <td class="p-2.5">
                                                        <span class="re-badge <%= i.interaction_type === 'viewed' ? 'bg-cyan-50 text-cyan-700 border border-cyan-100' : 'bg-violet-50 text-violet-700 border border-violet-100' %>">
                                                            <i class="fas <%= i.interaction_type === 'viewed' ? 'fa-eye' : 'fa-download' %> text-[8px]"></i>
                                                            <%= i.interaction_type %>
                                                        </span>
                                                    </td>
                                                    <td class="p-2.5 text-slate-400 hidden md:table-cell whitespace-nowrap">
                                                        <% if (i.interacted_at) { %>
                                                            <span class="font-semibold text-slate-700"><%= new Date(i.interacted_at).toLocaleDateString('en-US', {month:'short', day:'numeric', year:'numeric'}) %></span>
                                                            <span class="text-[10px] text-slate-400 ml-1 font-mono"><%= new Date(i.interacted_at).toLocaleTimeString('en-US', {hour:'2-digit', minute:'2-digit'}) %></span>
                                                        <% } else { %>
                                                            —
                                                        <% } %>
                                                    </td>
                                                </tr>
                                            <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                </div>

                                <!-- Pagination Controls -->
                                <div id="interactionPaginationWrap" class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-3.5 border-t border-slate-100 mt-3 text-xs">
                                    <div id="interactionPaginationInfo" class="text-slate-500 font-medium">
                                        Showing <span id="interactionStart" class="font-bold text-slate-800">0</span>–<span id="interactionEnd" class="font-bold text-slate-800">0</span> of <span id="interactionTotal" class="font-bold text-indigo-600"><%= interactionLog.length %></span> records
                                    </div>
                                    <div class="flex items-center gap-1.5" id="interactionPaginationNav">
                                        <button id="btnPrevInteractionPage" type="button" onclick="changeInteractionPage(-1)"
                                            class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 disabled:opacity-30 disabled:cursor-not-allowed transition font-bold flex items-center gap-1 shadow-2xs">
                                            <i class="fas fa-chevron-left text-[9px]"></i> <span>Prev</span>
                                        </button>
                                        <div id="interactionPageNumbers" class="flex items-center gap-1"></div>
                                        <button id="btnNextInteractionPage" type="button" onclick="changeInteractionPage(1)"
                                            class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 disabled:opacity-30 disabled:cursor-not-allowed transition font-bold flex items-center gap-1 shadow-2xs">
                                            <span>Next</span> <i class="fas fa-chevron-right text-[9px]"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- Game Interaction Log (1/3 width) -->
                            <div class="glass-card rounded-2xl border border-indigo-100 p-5 flex flex-col justify-between">
                                <div>
                                    <!-- Header with title, badge and search -->
                                    <div class="flex items-center justify-between gap-2 mb-3">
                                        <div class="flex items-center gap-2">
                                            <p class="font-bold text-sm text-indigo-900 flex items-center gap-2">
                                                <i class="fas fa-gamepad text-indigo-500"></i> Game Interaction Log
                                            </p>
                                            <span class="text-[11px] font-bold text-indigo-700 bg-indigo-50 border border-indigo-100 px-2 py-0.5 rounded-full" id="gameLogTotalBadge">
                                                <%= (typeof gameInteractionLog !== 'undefined' && gameInteractionLog) ? gameInteractionLog.length : 0 %>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Quick Search Input -->
                                    <div class="relative mb-3">
                                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                        <input id="gameLogSearch" type="text" placeholder="Search student, mode, kiosk…"
                                            class="fi pl-8 pr-7 py-1.5 text-xs w-full" oninput="filterGameLogs()">
                                        <button id="btnGameLogSearchClear" type="button" onclick="clearGameLogSearch()"
                                            class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-300 hover:text-slate-600 text-xs">
                                            <i class="fas fa-times"></i>
                                        </button>
                                    </div>

                                    <!-- Game Interaction Sessions Feed -->
                                    <div id="gameLogContainer" class="space-y-3 max-h-[380px] overflow-y-auto no-scrollbar pr-0.5">
                                    <% if (!locals.gameInteractionLog || gameInteractionLog.length === 0) { %>
                                        <div class="py-10 text-center">
                                            <div class="w-12 h-12 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-400 flex items-center justify-center mx-auto mb-3">
                                                <i class="fas fa-gamepad text-xl"></i>
                                            </div>
                                            <p class="text-xs font-semibold text-slate-600">No Arcade Sessions Yet</p>
                                            <p class="text-[11px] text-slate-400 mt-1">Student gameplay interactions on arcade kiosks will be logged here.</p>
                                        </div>
                                    <% } else { %>
                                        <% gameInteractionLog.forEach(function(session) { 
                                            const isVersus = (session.play_mode === 'Versus');
                                            const p1Name = session.student_name_p1 || 'Anonymous Student';
                                            const p2Name = session.student_name_p2 || 'Guest Challenger';
                                            const durationSec = session.total_duration_s || 0;
                                            const durStr = durationSec > 0 ? (Math.floor(durationSec / 60) + 'm ' + (durationSec % 60) + 's') : '—';
                                            const isCompleted = (session.session_status === 'Completed');
                                        %>
                                            <div class="game-log-item p-3 rounded-xl bg-slate-50/70 hover:bg-indigo-50/50 border border-slate-100 hover:border-indigo-200 transition-all duration-150"
                                                 data-student="<%= (p1Name + ' ' + (isVersus ? p2Name : '') + ' ' + (session.lrn_p1 || '') + ' ' + (session.assessment_title || '') + ' ' + (session.cabinet_id || '') + ' ' + session.play_mode).toLowerCase() %>">
                                                
                                                <!-- Top row: Student & Badges -->
                                                <div class="flex items-start justify-between gap-2 mb-2">
                                                    <div class="flex items-center gap-2.5 min-w-0">
                                                        <% if (isVersus) { %>
                                                            <!-- Dual Avatars for Versus -->
                                                            <div class="flex -space-x-2 flex-shrink-0">
                                                                <img src="/profile_uploads/<%= session.profile_pic_p1 || 'default_avatar.png' %>"
                                                                     class="w-7 h-7 rounded-full object-cover ring-2 ring-white shadow-2xs"
                                                                     alt="<%= p1Name %>" onerror="this.src='/profile_uploads/default_avatar.png'">
                                                                <img src="/profile_uploads/<%= session.profile_pic_p2 || 'default_avatar.png' %>"
                                                                     class="w-7 h-7 rounded-full object-cover ring-2 ring-white shadow-2xs"
                                                                     alt="<%= p2Name %>" onerror="this.src='/profile_uploads/default_avatar.png'">
                                                            </div>
                                                            <div class="min-w-0">
                                                                <p class="text-xs font-bold text-slate-800 truncate leading-snug">
                                                                    <%= p1Name %> <span class="text-amber-600 font-extrabold text-[10px]">vs</span> <%= p2Name %>
                                                                </p>
                                                                <p class="text-[10px] text-slate-400">Versus Match</p>
                                                            </div>
                                                        <% } else { %>
                                                            <!-- Solo Avatar -->
                                                            <img src="/profile_uploads/<%= session.profile_pic_p1 || 'default_avatar.png' %>"
                                                                 class="w-7 h-7 rounded-full object-cover ring-1 ring-indigo-200 flex-shrink-0 shadow-2xs"
                                                                 alt="<%= p1Name %>" onerror="this.src='/profile_uploads/default_avatar.png'">
                                                            <div class="min-w-0">
                                                                <p class="text-xs font-bold text-slate-800 truncate leading-snug">
                                                                    <%= p1Name %>
                                                                </p>
                                                                <% if (session.lrn_p1) { %>
                                                                    <p class="text-[10px] text-slate-400 font-mono">LRN: <%= session.lrn_p1 %></p>
                                                                <% } else { %>
                                                                    <p class="text-[10px] text-slate-400">Solo Session</p>
                                                                <% } %>
                                                            </div>
                                                        <% } %>
                                                    </div>

                                                    <!-- Mode & Status Badges -->
                                                    <div class="flex flex-col items-end gap-1 flex-shrink-0">
                                                        <span class="px-2 py-0.5 rounded-full text-[9px] font-extrabold <%= isVersus ? 'bg-amber-100 text-amber-700 border border-amber-200' : 'bg-indigo-100 text-indigo-700 border border-indigo-200' %>">
                                                            <i class="fas <%= isVersus ? 'fa-user-friends' : 'fa-gamepad' %> mr-0.5"></i><%= session.play_mode || 'Solo' %>
                                                        </span>
                                                        <span class="px-1.5 py-0.5 rounded text-[8.5px] font-bold <%= isCompleted ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-cyan-50 text-cyan-700 border border-cyan-200 animate-pulse' %>">
                                                            <i class="fas <%= isCompleted ? 'fa-check-circle' : 'fa-play' %> mr-0.5"></i><%= session.session_status || 'Completed' %>
                                                        </span>
                                                    </div>
                                                </div>

                                                <!-- Middle: Game Score, Level, & Assessment -->
                                                <div class="bg-white/80 rounded-lg p-2 border border-slate-100 text-[11px] mb-2 space-y-1">
                                                    <% if (session.assessment_title) { %>
                                                        <div class="flex items-center gap-1.5 text-indigo-900 font-semibold truncate">
                                                            <i class="fas fa-scroll text-indigo-400 text-[10px] flex-shrink-0"></i>
                                                            <span class="truncate"><%= session.assessment_title %></span>
                                                        </div>
                                                    <% } %>
                                                    <div class="flex items-center justify-between text-[10.5px] text-slate-600">
                                                        <% if (isVersus) { %>
                                                            <span>P1 Score: <strong class="text-slate-800"><%= session.final_score_p1 || 0 %></strong> &nbsp;|&nbsp; P2: <strong class="text-slate-800"><%= session.final_score_p2 || 0 %></strong></span>
                                                            <% if (session.winner) { %>
                                                                <span class="text-amber-700 font-bold"><i class="fas fa-trophy text-[9px] text-amber-500 mr-0.5"></i>Win: <%= session.winner %></span>
                                                            <% } %>
                                                        <% } else { %>
                                                            <span>Final Score: <strong class="text-slate-900 font-bold"><%= session.final_score_p1 || 0 %> pts</strong></span>
                                                            <span class="text-indigo-700 font-bold bg-indigo-50 px-1.5 py-0.2 rounded border border-indigo-100">Lvl <%= session.highest_level_reached || 1 %></span>
                                                        <% } %>
                                                    </div>
                                                </div>

                                                <!-- Bottom: Cabinet, Duration & Timestamp -->
                                                <div class="flex items-center justify-between text-[10px] text-slate-400">
                                                    <span class="flex items-center gap-1">
                                                        <i class="fas fa-desktop text-[9px] text-slate-400"></i>
                                                        <%= session.cabinet_id || 'Arcade Cabinet' %>
                                                        <% if (durationSec > 0) { %>
                                                            &bull; <i class="fas fa-stopwatch text-[9px] text-slate-400"></i> <%= durStr %>
                                                        <% } %>
                                                    </span>
                                                    <span title="<%= new Date(session.started_at).toLocaleString('en-PH') %>">
                                                        <%= new Date(session.started_at).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                                    </span>
                                                </div>
                                            </div>
                                        <% }) %>
                                    <% } %>
                                    </div>
                                    <div id="gameLogNoMatch" class="hidden py-8 text-center text-xs text-slate-400 italic">
                                        No matching game sessions found.
                                    </div>
                                </div>
                            </div>
                        </div><!-- /grid -->

                        <!-- Engagement Milestones — Student Progress & Recognition -->
                        <div class="mt-6 glass-card rounded-2xl border border-emerald-100 p-6">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 mb-4">
                                <div>
                                    <p class="font-bold text-base text-indigo-900 flex items-center gap-2">
                                        <i class="fas fa-medal text-emerald-500"></i> Engagement Milestones &amp; Interaction Recognition
                                    </p>
                                    <p class="text-xs text-slate-400 mt-0.5">
                                        Automated evaluation tracking student interaction percentages across learning materials and arcade games to identify weekly outstanding performers.
                                    </p>
                                </div>
                                <span class="px-3 py-1 rounded-full text-xs font-black bg-emerald-50 text-emerald-700 border border-emerald-200 self-start sm:self-auto flex items-center gap-1.5 shadow-2xs">
                                    <i class="fas fa-sparkles text-emerald-500"></i> Weekly Milestone Evaluation
                                </span>
                            </div>

                            <% 
                            const milestones = (typeof engagementMilestones !== 'undefined' && engagementMilestones) ? engagementMilestones : [];
                            const topStudent = (typeof topEngagedStudent !== 'undefined' && topEngagedStudent) ? topEngagedStudent : (milestones[0] || null);
                            %>

                            <!-- Outstanding Student of the Week Spotlight Card -->
                            <% if (topStudent && topStudent.highestPercent > 0) { %>
                                <div class="mb-6 rounded-2xl bg-gradient-to-r from-amber-500/10 via-indigo-500/10 to-emerald-500/10 border-2 border-amber-300/80 p-5 shadow-sm relative overflow-hidden">
                                    <!-- Background decorative star watermark -->
                                    <div class="absolute -right-4 -bottom-4 text-amber-200/20 text-9xl pointer-events-none select-none">
                                        <i class="fas fa-award"></i>
                                    </div>

                                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4 relative z-10">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-black bg-gradient-to-r from-amber-500 to-amber-600 text-white shadow-xs uppercase tracking-wider">
                                                <i class="fas fa-crown text-[11px]"></i> Outstanding Student of the Week
                                            </span>
                                            <span class="px-2.5 py-0.5 rounded-full text-xs font-extrabold bg-amber-100 text-amber-900 border border-amber-300">
                                                Peak Interaction: <%= topStudent.highestPercent %>%
                                            </span>
                                        </div>
                                        <span class="text-[11px] font-bold text-slate-400 flex items-center gap-1">
                                            <i class="fas fa-calendar-week text-slate-400"></i> Active Evaluation Window
                                        </span>
                                    </div>

                                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-4 relative z-10">
                                        <div class="relative flex-shrink-0">
                                            <img src="/profile_uploads/<%= topStudent.profile_pic || 'default_avatar.png' %>"
                                                 class="w-16 h-16 rounded-2xl object-cover ring-4 ring-amber-300 shadow-md"
                                                 alt="<%= topStudent.first_name %> <%= topStudent.last_name %>"
                                                 onerror="this.src='/profile_uploads/default_avatar.png'">
                                            <span class="absolute -top-1.5 -right-1.5 w-6 h-6 rounded-full bg-amber-500 text-white flex items-center justify-center text-xs shadow-xs">
                                                <i class="fas fa-star text-[10px]"></i>
                                            </span>
                                        </div>
                                        <div class="flex-1 min-w-0">
                                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1">
                                                <h4 class="text-base font-black text-indigo-950 truncate">
                                                    <%= topStudent.first_name %> <%= topStudent.last_name %>
                                                </h4>
                                                <% if (topStudent.lrn_number) { %>
                                                    <span class="text-[11px] font-mono text-slate-500 bg-white/70 px-2 py-0.5 rounded border border-slate-200 self-start sm:self-auto">
                                                        LRN: <%= topStudent.lrn_number %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="text-xs text-slate-500 mt-0.5">
                                                <%= topStudent.class_names || 'Active Student' %>
                                            </p>

                                            <!-- Formatted Outstanding Accolade Quote -->
                                            <div class="mt-3 p-3.5 rounded-xl bg-white/95 border border-amber-200/90 shadow-2xs">
                                                <p class="text-xs font-bold text-amber-950 flex items-start gap-2.5 leading-relaxed">
                                                    <i class="fas fa-quote-left text-amber-500 text-base mt-0.5 flex-shrink-0"></i>
                                                    <span><%= topStudent.milestoneMessage %></span>
                                                </p>
                                            </div>

                                            <!-- Metric Badges Row -->
                                            <div class="mt-3 flex flex-wrap items-center gap-2">
                                                <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-cyan-50 text-cyan-800 border border-cyan-200 flex items-center gap-1.5">
                                                    <i class="fas fa-book-open text-cyan-600"></i> Learning Materials: <strong><%= topStudent.matPercent %>%</strong> (<%= topStudent.mats_distinct %> unique materials)
                                                </span>
                                                <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-indigo-50 text-indigo-800 border border-indigo-200 flex items-center gap-1.5">
                                                    <i class="fas fa-gamepad text-indigo-600"></i> Arcade Games: <strong><%= topStudent.gamePercent %>%</strong> (<%= topStudent.games_total %> sessions)
                                                </span>
                                                <span class="px-2.5 py-1 rounded-lg text-[11px] font-bold bg-amber-50 text-amber-900 border border-amber-200 flex items-center gap-1.5">
                                                    <i class="fas fa-trophy text-amber-600"></i> Primary Channel: <strong><%= topStudent.dominantChannel === 'games' ? 'Arcade Games' : (topStudent.dominantChannel === 'materials' ? 'Learning Materials' : 'Equally Balanced') %></strong>
                                                </span>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            <% } %>

                            <!-- All Students Milestone Breakdown List -->
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <p class="text-xs font-black text-indigo-900 uppercase tracking-wider flex items-center gap-2">
                                        <i class="fas fa-users text-slate-400"></i> Student Interaction Breakdown
                                    </p>
                                    <span class="text-[11px] font-bold text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-full border border-slate-200">
                                        <%= milestones.length %> Students Evaluated
                                    </span>
                                </div>
                                <% if (milestones.length === 0) { %>
                                    <p class="text-xs text-slate-400 italic">No student interaction data recorded yet.</p>
                                <% } else { %>
                                    <div id="milestoneStudentsContainer" class="space-y-3.5">
                                    <% milestones.forEach(function(sp, idx) { 
                                        const placement = sp.placement || (idx + 1);
                                    %>
                                        <div class="milestone-student-card p-3.5 rounded-xl border <%= placement === 1 ? 'bg-amber-50/40 border-amber-200 ring-1 ring-amber-100' : 'bg-slate-50/60 border-slate-100' %> hover:border-indigo-200 transition" data-placement="<%= placement %>">
                                            <div class="flex items-start gap-3 mb-2.5">
                                                <!-- Placement Number Badge -->
                                                <div class="flex-shrink-0 mt-0.5">
                                                    <% if (placement === 1) { %>
                                                        <span class="w-7 h-7 rounded-xl bg-gradient-to-br from-amber-400 to-amber-600 text-white font-black text-xs flex items-center justify-center shadow-xs ring-2 ring-amber-200" title="Placement #1">
                                                            #1
                                                        </span>
                                                    <% } else if (placement === 2) { %>
                                                        <span class="w-7 h-7 rounded-xl bg-gradient-to-br from-slate-300 to-slate-500 text-white font-black text-xs flex items-center justify-center shadow-xs ring-2 ring-slate-200" title="Placement #2">
                                                            #2
                                                        </span>
                                                    <% } else if (placement === 3) { %>
                                                        <span class="w-7 h-7 rounded-xl bg-gradient-to-br from-amber-700 to-amber-900 text-white font-black text-xs flex items-center justify-center shadow-xs ring-2 ring-amber-200/50" title="Placement #3">
                                                            #3
                                                        </span>
                                                    <% } else { %>
                                                        <span class="w-7 h-7 rounded-xl bg-white text-slate-600 font-bold text-xs flex items-center justify-center border border-slate-200 shadow-2xs" title="Placement #<%= placement %>">
                                                            #<%= placement %>
                                                        </span>
                                                    <% } %>
                                                </div>

                                                <!-- Avatar -->
                                                <div class="relative flex-shrink-0">
                                                    <img src="/profile_uploads/<%= sp.profile_pic || 'default_avatar.png' %>"
                                                         class="w-10 h-10 rounded-full object-cover <%= placement === 1 ? 'ring-2 ring-amber-400' : 'ring-1 ring-slate-200' %>"
                                                         alt="<%= sp.first_name %>"
                                                         onerror="this.src='/profile_uploads/default_avatar.png'">
                                                    <% if (placement === 1) { %>
                                                        <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-amber-500 text-white flex items-center justify-center text-[9px] shadow-2xs">
                                                            <i class="fas fa-crown"></i>
                                                        </span>
                                                    <% } %>
                                                </div>

                                                <div class="flex-1 min-w-0">
                                                    <div class="flex items-center justify-between gap-2 mb-1">
                                                        <div class="flex items-center gap-2 truncate">
                                                            <p class="text-xs font-bold text-indigo-900 truncate">
                                                                <%= sp.first_name %> <%= sp.last_name %>
                                                            </p>
                                                            <% if (placement === 1) { %>
                                                                <span class="px-2 py-0.2 rounded-full text-[9px] font-black bg-amber-100 text-amber-800 border border-amber-300 flex-shrink-0">
                                                                    #1 Outstanding
                                                                </span>
                                                            <% } else if (sp.class_names) { %>
                                                                <span class="text-[10px] text-slate-400 truncate">
                                                                    &bull; <%= sp.class_names %>
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <span class="text-xs font-extrabold <%= placement === 1 ? 'text-amber-700' : (sp.highestPercent >= 50 ? 'text-indigo-600' : 'text-slate-600') %> flex-shrink-0">
                                                            <%= sp.highestPercent %>% Peak
                                                        </span>
                                                    </div>

                                                    <!-- Dual Progress Bars: Materials and Games -->
                                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
                                                        <!-- Materials Progress -->
                                                        <div class="bg-white/80 p-2 rounded-lg border border-slate-100">
                                                            <div class="flex items-center justify-between text-[10px] font-bold text-slate-600 mb-1">
                                                                <span class="flex items-center gap-1 text-cyan-700">
                                                                    <i class="fas fa-book-open text-[9px]"></i> Learning Materials (<%= sp.mats_distinct %> mats)
                                                                </span>
                                                                <span class="text-cyan-700"><%= sp.matPercent %>%</span>
                                                            </div>
                                                            <div class="prog-bar bg-slate-100">
                                                                <div class="h-full rounded-full bg-gradient-to-r from-cyan-400 to-cyan-500" style="width: <%= sp.matPercent %>%"></div>
                                                            </div>
                                                        </div>

                                                        <!-- Games Progress -->
                                                        <div class="bg-white/80 p-2 rounded-lg border border-slate-100">
                                                            <div class="flex items-center justify-between text-[10px] font-bold text-slate-600 mb-1">
                                                                <span class="flex items-center gap-1 text-indigo-700">
                                                                    <i class="fas fa-gamepad text-[9px]"></i> Arcade Games (<%= sp.games_total %> sessions)
                                                                </span>
                                                                <span class="text-indigo-700"><%= sp.gamePercent %>%</span>
                                                            </div>
                                                            <div class="prog-bar bg-slate-100">
                                                                <div class="h-full rounded-full bg-gradient-to-r from-indigo-500 to-violet-600" style="width: <%= sp.gamePercent %>%"></div>
                                                            </div>
                                                        </div>
                                                    </div>

                                                    <!-- Status & Recognition Message (Dynamic) -->
                                                    <div class="mt-2.5">
                                                        <p class="text-[11px] font-medium text-slate-700 bg-white/75 px-3 py-2 rounded-lg border border-slate-200/80 leading-relaxed flex items-start gap-2">
                                                            <i class="fas <%= placement === 1 ? 'fa-award text-amber-500' : (sp.highestPercent >= 50 ? 'fa-star text-indigo-500' : (sp.highestPercent > 0 ? 'fa-chart-line text-cyan-500' : 'fa-info-circle text-slate-400')) %> text-xs mt-0.5 flex-shrink-0"></i>
                                                            <span><%= sp.milestoneMessage %></span>
                                                        </p>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    <% }) %>
                                    </div>

                                    <!-- Pagination Controls (3 items per page) -->
                                    <div id="milestonePaginationWrap" class="flex flex-col sm:flex-row items-center justify-between gap-3 pt-4 border-t border-slate-100 mt-4 text-xs">
                                        <div id="milestonePaginationInfo" class="text-slate-500 font-medium">
                                            Showing <span id="milestoneStart" class="font-bold text-slate-800">1</span>–<span id="milestoneEnd" class="font-bold text-slate-800">3</span> of <span id="milestoneTotal" class="font-bold text-indigo-600"><%= milestones.length %></span> students
                                        </div>
                                        <div class="flex items-center gap-1.5" id="milestonePaginationNav">
                                            <button id="btnPrevMilestonePage" type="button" onclick="changeMilestonePage(-1)"
                                                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 disabled:opacity-30 disabled:cursor-not-allowed transition font-bold flex items-center gap-1 shadow-2xs">
                                                <i class="fas fa-chevron-left text-[9px]"></i> <span>Prev</span>
                                            </button>
                                            <div id="milestonePageNumbers" class="flex items-center gap-1"></div>
                                            <button id="btnNextMilestonePage" type="button" onclick="changeMilestonePage(1)"
                                                class="px-2.5 py-1.5 rounded-lg border border-slate-200 text-slate-600 hover:bg-slate-50 disabled:opacity-30 disabled:cursor-not-allowed transition font-bold flex items-center gap-1 shadow-2xs">
                                                <span>Next</span> <i class="fas fa-chevron-right text-[9px]"></i>
                                            </button>
                                        </div>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                    </div><!-- /pillar3 -->

                    <!-- ═══════════════════════════════════════════════
                         PILLAR 4 — PROGRESS & REWARDS
                         Hierarchical Gamification Architecture (General -> Specific)
                    ═══════════════════════════════════════════════ -->
                    <div id="pillar4" class="re-pane p-6">

                        <!-- Main Hub Header -->
                        <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4 mb-8 pb-6 border-b border-indigo-100/70">
                            <div>
                                <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-amber-50 border border-amber-200 text-amber-700 text-xs font-black uppercase tracking-wider mb-2">
                                    <i class="fas fa-sitemap text-amber-500"></i> Admin Analytics Architecture &bull; General to Specific
                                </div>
                                <h3 class="font-black text-indigo-950 text-xl md:text-2xl tracking-tight">Progress &amp; Rewards</h3>
                                <p class="text-xs md:text-sm text-slate-500 mt-1 max-w-2xl">
                                    Curriculum gamification hub displaying level mastery progression and game score leaderboards across subjects, classes, and individual learners.
                                </p>
                            </div>
                            <div class="flex flex-wrap items-center gap-2.5">
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-amber-500/10 border border-amber-200 text-amber-800 text-xs font-black shadow-xs">
                                    <i class="fas fa-layer-group text-amber-600"></i> Level Mastery Focused
                                </span>
                                <span class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-cyan-500/10 border border-cyan-200 text-cyan-800 text-xs font-black shadow-xs">
                                    <i class="fas fa-gamepad text-cyan-600"></i> Game Scores &amp; Sessions
                                </span>
                            </div>
                        </div>

                        <%
                            var totalSubjectsCount = subjectsOverview.length;
                            var totalClassesCount = classesBreakdown.length;
                            var totalCurriculumSessions = subjectsOverview.reduce(function(acc, s) { return acc + (Number(s.total_game_sessions) || 0); }, 0);
                            var curriculumTopLevel = subjectsOverview.reduce(function(max, s) { return Math.max(max, Number(s.highest_level_reached) || 1); }, 1);
                            var curriculumTopScore = subjectsOverview.reduce(function(max, s) { return Math.max(max, Number(s.highest_game_score) || 0); }, 0);
                            var totalLearnersEnrolled = studentGameLeaderboard.length;
                        %>

                        <div class="space-y-10">

                            <!-- ─────────────────────────────────────────────────────────────
                                 TIER 1 (GENERAL): OVERALL DATA & STATUS ACROSS ENROLLED SUBJECTS
                            ───────────────────────────────────────────────────────────── -->
                            <div class="rounded-3xl border border-indigo-100 bg-white/70 p-6 md:p-7 shadow-xs">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 mb-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-indigo-600 to-indigo-500 text-white font-black text-sm flex items-center justify-center shadow-md">
                                            1
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <h4 class="font-black text-indigo-950 text-base md:text-lg">Overall Subjects Data &amp; Status</h4>
                                                <span class="re-badge bg-indigo-50 text-indigo-700 border border-indigo-200">Tier 1 &bull; General</span>
                                            </div>
                                            <p class="text-xs text-slate-400 mt-0.5">Overall status and telemetry across all enrolled subjects as a whole.</p>
                                        </div>
                                    </div>
                                    <div class="text-left md:text-right">
                                        <span class="text-xs font-bold text-indigo-600 bg-indigo-50/80 px-3 py-1 rounded-xl border border-indigo-100">
                                            <%= totalSubjectsCount %> <%= totalSubjectsCount === 1 ? 'Subject' : 'Subjects' %> Enrolled
                                        </span>
                                    </div>
                                </div>

                                <!-- Overall KPI Summary Strip -->
                                <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-3.5 mb-6">
                                    <div class="p-4 rounded-2xl bg-indigo-50/50 border border-indigo-100">
                                        <p class="text-[10px] font-black uppercase tracking-wider text-indigo-400 mb-1">Subjects &amp; Classes</p>
                                        <p class="text-xl font-black text-indigo-950"><%= totalSubjectsCount %></p>
                                        <p class="text-[11px] text-slate-500 mt-0.5"><%= totalClassesCount %> assigned classes</p>
                                    </div>
                                    <div class="p-4 rounded-2xl bg-cyan-50/50 border border-cyan-100">
                                        <p class="text-[10px] font-black uppercase tracking-wider text-cyan-500 mb-1">Enrolled Learners</p>
                                        <p class="text-xl font-black text-cyan-950"><%= totalLearnersEnrolled %></p>
                                        <p class="text-[11px] text-slate-500 mt-0.5">Across all classes</p>
                                    </div>
                                    <div class="p-4 rounded-2xl bg-emerald-50/50 border border-emerald-100">
                                        <p class="text-[10px] font-black uppercase tracking-wider text-emerald-500 mb-1">Total Game Sessions</p>
                                        <p class="text-xl font-black text-emerald-950"><%= totalCurriculumSessions.toLocaleString() %></p>
                                        <p class="text-[11px] text-slate-500 mt-0.5">Gameplay sessions</p>
                                    </div>
                                    <div class="p-4 rounded-2xl bg-amber-50/60 border border-amber-200">
                                        <p class="text-[10px] font-black uppercase tracking-wider text-amber-600 mb-1">Top Level Reached</p>
                                        <p class="text-xl font-black text-amber-700 flex items-center gap-1.5">
                                            <i class="fas fa-crown text-amber-500 text-base"></i> Level <%= curriculumTopLevel %>
                                        </p>
                                        <p class="text-[11px] text-slate-500 mt-0.5">Highest level attained</p>
                                    </div>
                                    <div class="p-4 rounded-2xl bg-rose-50/50 border border-rose-100 col-span-2 sm:col-span-1">
                                        <p class="text-[10px] font-black uppercase tracking-wider text-rose-500 mb-1">Top Game Score</p>
                                        <p class="text-xl font-black text-rose-700 flex items-center gap-1.5">
                                            <i class="fas fa-star text-rose-400 text-sm"></i> <%= curriculumTopScore.toLocaleString() %>
                                        </p>
                                        <p class="text-[11px] text-slate-500 mt-0.5">High score recorded</p>
                                    </div>
                                </div>

                                <!-- Subject-by-Subject Status Cards -->
                                <% if (subjectsOverview.length === 0) { %>
                                    <div class="py-10 text-center text-slate-400 bg-slate-50/60 rounded-2xl border border-dashed border-slate-200">
                                        <i class="fas fa-book-open text-3xl mb-2 opacity-30"></i>
                                        <p class="font-bold text-xs">No enrolled subjects found.</p>
                                    </div>
                                <% } else { %>
                                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                        <% subjectsOverview.forEach(function(s) { %>
                                            <div class="p-5 rounded-2xl border border-slate-200/80 bg-white hover:border-indigo-200 hover:shadow-md transition">
                                                <div class="flex items-start justify-between gap-3 mb-4">
                                                    <div class="flex items-center gap-3">
                                                        <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-500 to-cyan-500 text-white flex items-center justify-center font-black text-sm shadow-xs">
                                                            <i class="fas fa-flask"></i>
                                                        </div>
                                                        <div>
                                                            <h5 class="font-extrabold text-indigo-950 text-sm"><%= s.subject_name %></h5>
                                                            <p class="text-xs font-semibold text-slate-400"><%= s.subject_code || 'CODE-N/A' %></p>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <% if (s.total_game_sessions > 0) { %>
                                                            <span class="re-badge bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                                <span class="live-dot mr-1"></span> Active Gamification
                                                            </span>
                                                        <% } else { %>
                                                            <span class="re-badge bg-slate-100 text-slate-500 border border-slate-200">
                                                                <i class="fas fa-pause text-[9px] mr-1"></i> No Sessions Yet
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                </div>

                                                <!-- Subject Stats Grid -->
                                                <div class="grid grid-cols-3 gap-2.5 pt-3 border-t border-slate-100 text-center">
                                                    <div class="p-2.5 rounded-xl bg-slate-50/70">
                                                        <p class="text-[10px] text-slate-400 font-bold uppercase">Classes / Students</p>
                                                        <p class="text-xs font-black text-indigo-950 mt-0.5"><%= s.class_count %> / <%= s.student_count %></p>
                                                    </div>
                                                    <div class="p-2.5 rounded-xl bg-slate-50/70">
                                                        <p class="text-[10px] text-slate-400 font-bold uppercase">Highest Level</p>
                                                        <p class="text-xs font-black text-amber-600 mt-0.5">
                                                            <i class="fas fa-crown text-[10px] text-amber-500 mr-0.5"></i> Level <%= s.highest_level_reached %>
                                                        </p>
                                                    </div>
                                                    <div class="p-2.5 rounded-xl bg-slate-50/70">
                                                        <p class="text-[10px] text-slate-400 font-bold uppercase">Top Game Score</p>
                                                        <p class="text-xs font-black text-indigo-700 mt-0.5">
                                                            <%= s.highest_game_score.toLocaleString() %> pts
                                                        </p>
                                                    </div>
                                                </div>

                                                <div class="flex items-center justify-between text-[11px] text-slate-500 mt-3.5 px-1">
                                                    <span>Game Sessions: <strong class="text-slate-800"><%= s.total_game_sessions %></strong></span>
                                                    <span>Active Players: <strong class="text-slate-800"><%= s.active_players_count %></strong></span>
                                                    <span>Avg Level: <strong class="text-amber-700">Level <%= s.avg_level_reached %></strong></span>
                                                </div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>


                            <!-- ─────────────────────────────────────────────────────────────
                                 TIER 2 (INTERMEDIATE): PER-CLASS BREAKDOWN UNDER SUBJECTS
                            ───────────────────────────────────────────────────────────── -->
                            <div class="rounded-3xl border border-cyan-100 bg-white/70 p-6 md:p-7 shadow-xs">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-cyan-600 to-cyan-500 text-white font-black text-sm flex items-center justify-center shadow-md">
                                            2
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <h4 class="font-black text-indigo-950 text-base md:text-lg">Data Broken Down Per Class Under Enrolled Subjects</h4>
                                                <span class="re-badge bg-cyan-50 text-cyan-700 border border-cyan-200">Tier 2 &bull; Class Breakdown</span>
                                            </div>
                                            <p class="text-xs text-slate-400 mt-0.5">Performance, highest level reached, and score progression for each class.</p>
                                        </div>
                                    </div>

                                    <!-- Filter Toolbar for Classes -->
                                    <div class="flex flex-wrap items-center gap-2">
                                        <div class="relative">
                                            <i class="fas fa-filter absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                            <select id="prClassSubjectFilter" onchange="filterClassesBreakdown()"
                                                class="fi pl-8 pr-8 py-2 text-xs rounded-xl bg-white border border-slate-200 text-slate-700 font-bold focus:border-cyan-500">
                                                <option value="ALL">All Enrolled Subjects</option>
                                                <% subjectsOverview.forEach(function(s) { %>
                                                    <option value="<%= s.subject_id %>"><%= s.subject_name %></option>
                                                <% }) %>
                                            </select>
                                        </div>
                                        <div class="relative">
                                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                            <input id="prClassSearchInput" type="text" placeholder="Search class or teacher…"
                                                oninput="filterClassesBreakdown()"
                                                class="fi pl-8 pr-3 py-2 text-xs rounded-xl bg-white border border-slate-200 text-slate-700 placeholder-slate-400 w-48 focus:border-cyan-500">
                                        </div>
                                    </div>
                                </div>

                                <% if (classesBreakdown.length === 0) { %>
                                    <div class="py-10 text-center text-slate-400 bg-slate-50/60 rounded-2xl border border-dashed border-slate-200">
                                        <i class="fas fa-chalkboard text-3xl mb-2 opacity-30"></i>
                                        <p class="font-bold text-xs">No classes found under enrolled subjects.</p>
                                    </div>
                                <% } else { %>
                                    <div id="prClassesGrid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
                                        <% classesBreakdown.forEach(function(c) { %>
                                            <div class="pr-class-card p-5 rounded-2xl border border-slate-200/80 bg-white hover:border-cyan-300 hover:shadow-md transition flex flex-col justify-between"
                                                 data-subject-id="<%= c.subject_id %>"
                                                 data-class-name="<%= (c.class_name || '').toLowerCase() %>"
                                                 data-teacher-name="<%= (c.teacher_name || '').toLowerCase() %>">
                                                
                                                <div>
                                                    <div class="flex items-start justify-between gap-2 mb-3">
                                                        <div>
                                                            <div class="flex items-center gap-2">
                                                                <h5 class="font-extrabold text-indigo-950 text-base"><%= c.class_name %></h5>
                                                                <span class="re-badge bg-cyan-50 text-cyan-700 border border-cyan-200 text-[9px]">
                                                                    Class
                                                                </span>
                                                            </div>
                                                            <p class="text-xs text-indigo-600 font-bold mt-0.5"><%= c.subject_name %></p>
                                                        </div>
                                                        <span class="px-2.5 py-1 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 text-xs font-black whitespace-nowrap shadow-xs">
                                                            <i class="fas fa-crown text-amber-500 text-[10px] mr-1"></i> Level <%= c.highest_level_reached %>
                                                        </span>
                                                    </div>

                                                    <p class="text-xs text-slate-500 flex items-center gap-1.5 mb-4">
                                                        <i class="fas fa-chalkboard-teacher text-slate-400 text-xs"></i>
                                                        <span>Teacher: <strong class="text-slate-700"><%= c.teacher_name || 'Unassigned' %></strong></span>
                                                    </p>

                                                    <!-- Class Metrics Mini-Grid -->
                                                    <div class="grid grid-cols-2 gap-2 p-3 rounded-xl bg-slate-50/80 border border-slate-100 text-xs mb-3">
                                                        <div>
                                                            <p class="text-[10px] uppercase font-bold text-slate-400">Enrolled Students</p>
                                                            <p class="font-black text-indigo-950 mt-0.5"><%= c.student_count %> learners</p>
                                                        </div>
                                                        <div>
                                                            <p class="text-[10px] uppercase font-bold text-slate-400">Active Players</p>
                                                            <p class="font-black text-cyan-800 mt-0.5"><%= c.active_players_count %> playing</p>
                                                        </div>
                                                        <div class="pt-2 border-t border-slate-200/60">
                                                            <p class="text-[10px] uppercase font-bold text-slate-400">Total Game Sessions</p>
                                                            <p class="font-black text-slate-800 mt-0.5"><%= c.total_game_sessions %> played</p>
                                                        </div>
                                                        <div class="pt-2 border-t border-slate-200/60">
                                                            <p class="text-[10px] uppercase font-bold text-slate-400">Top Game Score</p>
                                                            <p class="font-black text-emerald-700 mt-0.5"><%= c.highest_game_score.toLocaleString() %> pts</p>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Level Mastery Meter -->
                                                <div class="pt-3 border-t border-slate-100">
                                                    <div class="flex items-center justify-between text-xs mb-1.5">
                                                        <span class="text-[11px] font-bold text-slate-500">Class Average Level:</span>
                                                        <span class="text-xs font-black text-amber-700">Level <%= c.avg_level_reached %></span>
                                                    </div>
                                                    <div class="w-full bg-slate-100 h-2 rounded-full overflow-hidden">
                                                        <% var classLevelPct = Math.min(100, Math.round((c.avg_level_reached / Math.max(curriculumTopLevel, 10)) * 100)); %>
                                                        <div class="h-full bg-gradient-to-r from-cyan-400 to-indigo-500 rounded-full transition-all duration-500" style="width: <%= classLevelPct %>%;"></div>
                                                    </div>
                                                </div>

                                            </div>
                                        <% }) %>
                                    </div>
                                    <div id="prClassesNoMatch" class="hidden py-8 text-center text-slate-400 bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                        <i class="fas fa-search text-2xl mb-1 opacity-40"></i>
                                        <p class="text-xs font-bold">No classes match your filter criteria.</p>
                                    </div>
                                <% } %>
                            </div>


                            <!-- ─────────────────────────────────────────────────────────────
                                 TIER 3 (SPECIFIC): DETAILED STUDENT-SPECIFIC DATA & LEADERBOARD
                            ───────────────────────────────────────────────────────────── -->
                            <div class="rounded-3xl border border-amber-200/80 bg-white/70 p-6 md:p-7 shadow-xs">
                                <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                                    <div class="flex items-center gap-3">
                                        <div class="w-9 h-9 rounded-2xl bg-gradient-to-tr from-amber-500 to-orange-500 text-white font-black text-sm flex items-center justify-center shadow-md">
                                            3
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <h4 class="font-black text-indigo-950 text-base md:text-lg">Detailed Student-Specific Game Scores &amp; Level Leaderboard</h4>
                                                <span class="re-badge bg-amber-50 text-amber-700 border border-amber-200">Tier 3 &bull; Student Focus</span>
                                            </div>
                                            <p class="text-xs text-slate-400 mt-0.5">Individual student rankings focused on highest level reached and game scores. (EXP excluded).</p>
                                        </div>
                                    </div>

                                    <!-- Filter and Search Toolbar -->
                                    <div class="flex flex-wrap items-center gap-2">
                                        <div class="relative">
                                            <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                            <input id="prStudentSearchInput" type="text" placeholder="Search student name or LRN…"
                                                oninput="filterStudentLeaderboard()"
                                                class="fi pl-8 pr-3 py-2 text-xs rounded-xl bg-white border border-slate-200 text-slate-700 placeholder-slate-400 w-56 focus:border-amber-500">
                                        </div>
                                        <div class="relative">
                                            <i class="fas fa-sort-amount-down absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                            <select id="prStudentSortSelect" onchange="sortStudentLeaderboard()"
                                                class="fi pl-8 pr-8 py-2 text-xs rounded-xl bg-white border border-slate-200 text-slate-700 font-bold focus:border-amber-500">
                                                <option value="level">Sort: Highest Level Reached</option>
                                                <option value="score">Sort: Highest Game Score</option>
                                                <option value="cumulative">Sort: Cumulative Score</option>
                                                <option value="sessions">Sort: Most Game Sessions</option>
                                            </select>
                                        </div>
                                    </div>
                                </div>

                                <!-- Top 3 Podium Highlights -->
                                <% if (studentGameLeaderboard.length >= 3) { %>
                                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
                                        <!-- #2 Runner Up -->
                                        <% var s2 = studentGameLeaderboard[1]; %>
                                        <div class="order-2 md:order-1 p-5 rounded-2xl bg-gradient-to-b from-slate-50 to-white border border-slate-200 hover:shadow-md transition text-center relative overflow-hidden">
                                            <div class="absolute top-3 left-3 w-7 h-7 rounded-lg bg-slate-200 text-slate-700 font-black text-xs flex items-center justify-center">#2</div>
                                            <div class="w-16 h-16 mx-auto rounded-2xl p-0.5 bg-gradient-to-tr from-slate-300 to-slate-400 mb-2 shadow-sm">
                                                <img src="/profile_uploads/<%= s2.profile_pic || 'default_avatar.png' %>"
                                                     class="w-full h-full rounded-2xl object-cover bg-white"
                                                     onerror="this.src='/profile_uploads/default_avatar.png'">
                                            </div>
                                            <h5 class="font-extrabold text-indigo-950 text-sm truncate"><%= s2.first_name %> <%= s2.last_name %></h5>
                                            <p class="text-[11px] text-slate-400 truncate"><%= s2.class_names || 'General Class' %></p>
                                            
                                            <div class="mt-3 py-2 px-3 rounded-xl bg-slate-100/70 border border-slate-200 flex items-center justify-around">
                                                <div>
                                                    <p class="text-[9px] uppercase font-bold text-slate-400">Highest Level</p>
                                                    <p class="text-xs font-black text-indigo-950"><i class="fas fa-crown text-slate-400 text-[10px] mr-0.5"></i> Level <%= s2.highest_level_reached %></p>
                                                </div>
                                                <div class="h-6 w-px bg-slate-200"></div>
                                                <div>
                                                    <p class="text-[9px] uppercase font-bold text-slate-400">Top Score</p>
                                                    <p class="text-xs font-black text-indigo-700"><%= s2.highest_game_score.toLocaleString() %> pts</p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- #1 Champion -->
                                        <% var s1 = studentGameLeaderboard[0]; %>
                                        <div class="order-1 md:order-2 p-5 rounded-2xl bg-gradient-to-b from-amber-50/70 via-amber-50/30 to-white border-2 border-amber-300 hover:shadow-lg transition text-center relative overflow-hidden -translate-y-1">
                                            <div class="absolute top-3 left-3 w-8 h-8 rounded-xl bg-amber-400 text-white font-black text-sm flex items-center justify-center shadow-md">
                                                <i class="fas fa-crown text-xs"></i>
                                            </div>
                                            <span class="absolute top-3 right-3 re-badge bg-amber-100 text-amber-800 border border-amber-300">
                                                Champion
                                            </span>
                                            <div class="w-20 h-20 mx-auto rounded-2xl p-1 bg-gradient-to-tr from-amber-400 to-yellow-300 mb-2 shadow-md">
                                                <img src="/profile_uploads/<%= s1.profile_pic || 'default_avatar.png' %>"
                                                     class="w-full h-full rounded-2xl object-cover bg-white"
                                                     onerror="this.src='/profile_uploads/default_avatar.png'">
                                            </div>
                                            <h5 class="font-black text-indigo-950 text-base truncate"><%= s1.first_name %> <%= s1.last_name %></h5>
                                            <p class="text-xs text-amber-800 font-bold truncate"><%= s1.class_names || 'General Class' %></p>
                                            
                                            <div class="mt-3.5 py-2.5 px-3 rounded-xl bg-amber-100/60 border border-amber-200 flex items-center justify-around">
                                                <div>
                                                    <p class="text-[9px] uppercase font-black text-amber-700">Highest Level</p>
                                                    <p class="text-sm font-black text-amber-900"><i class="fas fa-crown text-amber-500 text-xs mr-1"></i> Level <%= s1.highest_level_reached %></p>
                                                </div>
                                                <div class="h-7 w-px bg-amber-300"></div>
                                                <div>
                                                    <p class="text-[9px] uppercase font-black text-amber-700">Top Score</p>
                                                    <p class="text-sm font-black text-amber-900"><%= s1.highest_game_score.toLocaleString() %> pts</p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- #3 Third Place -->
                                        <% var s3 = studentGameLeaderboard[2]; %>
                                        <div class="order-3 p-5 rounded-2xl bg-gradient-to-b from-orange-50/50 to-white border border-orange-200 hover:shadow-md transition text-center relative overflow-hidden">
                                            <div class="absolute top-3 left-3 w-7 h-7 rounded-lg bg-orange-200 text-orange-800 font-black text-xs flex items-center justify-center">#3</div>
                                            <div class="w-16 h-16 mx-auto rounded-2xl p-0.5 bg-gradient-to-tr from-orange-300 to-amber-500 mb-2 shadow-sm">
                                                <img src="/profile_uploads/<%= s3.profile_pic || 'default_avatar.png' %>"
                                                     class="w-full h-full rounded-2xl object-cover bg-white"
                                                     onerror="this.src='/profile_uploads/default_avatar.png'">
                                            </div>
                                            <h5 class="font-extrabold text-indigo-950 text-sm truncate"><%= s3.first_name %> <%= s3.last_name %></h5>
                                            <p class="text-[11px] text-slate-400 truncate"><%= s3.class_names || 'General Class' %></p>
                                            
                                            <div class="mt-3 py-2 px-3 rounded-xl bg-orange-50/70 border border-orange-200 flex items-center justify-around">
                                                <div>
                                                    <p class="text-[9px] uppercase font-bold text-orange-700">Highest Level</p>
                                                    <p class="text-xs font-black text-indigo-950"><i class="fas fa-crown text-orange-400 text-[10px] mr-0.5"></i> Level <%= s3.highest_level_reached %></p>
                                                </div>
                                                <div class="h-6 w-px bg-orange-200"></div>
                                                <div>
                                                    <p class="text-[9px] uppercase font-bold text-orange-700">Top Score</p>
                                                    <p class="text-xs font-black text-indigo-700"><%= s3.highest_game_score.toLocaleString() %> pts</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                <% } %>

                                <!-- Full Student Leaderboard Table -->
                                <div class="border border-slate-200 rounded-2xl overflow-hidden bg-white shadow-xs">
                                    <div class="overflow-x-auto">
                                        <table class="w-full text-left text-xs border-collapse">
                                            <thead class="bg-slate-50 text-[10px] font-black uppercase tracking-wider text-slate-500 border-b border-slate-200">
                                                <tr>
                                                    <th class="p-3.5 text-center w-14">Rank</th>
                                                    <th class="p-3.5">Student</th>
                                                    <th class="p-3.5">Enrolled Class &amp; Subject</th>
                                                    <th class="p-3.5 text-center">Highest Level Reached</th>
                                                    <th class="p-3.5 text-center">Top Game Score</th>
                                                    <th class="p-3.5 text-center">Cumulative Score</th>
                                                    <th class="p-3.5 text-center">Game Sessions</th>
                                                    <th class="p-3.5 text-right pr-4">Last Played</th>
                                                </tr>
                                            </thead>
                                            <tbody id="prStudentTableBody" class="divide-y divide-slate-100">
                                                <% if (studentGameLeaderboard.length === 0) { %>
                                                    <tr>
                                                        <td colspan="8" class="p-10 text-center text-slate-400">
                                                            <i class="fas fa-users-slash text-3xl mb-2 opacity-30"></i>
                                                            <p class="font-bold">No student records found.</p>
                                                        </td>
                                                    </tr>
                                                <% } %>
                                                <% studentGameLeaderboard.forEach(function(s, idx) { %>
                                                    <tr class="pr-student-row hover:bg-indigo-50/40 transition"
                                                        data-index="<%= idx %>"
                                                        data-user-id="<%= s.user_id %>"
                                                        data-name="<%= (s.first_name + ' ' + s.last_name).toLowerCase() %>"
                                                        data-lrn="<%= s.lrn_number || '' %>"
                                                        data-level="<%= s.highest_level_reached %>"
                                                        data-score="<%= s.highest_game_score %>"
                                                        data-cumulative="<%= s.cumulative_game_score %>"
                                                        data-sessions="<%= s.total_game_sessions %>">
                                                        
                                                        <!-- Rank -->
                                                        <td class="p-3.5 text-center">
                                                            <div class="pr-rank-badge w-7 h-7 mx-auto rounded-lg flex items-center justify-center font-black text-xs
                                                                <%= idx === 0 ? 'bg-amber-400 text-white shadow-xs' : idx === 1 ? 'bg-slate-300 text-slate-800' : idx === 2 ? 'bg-orange-300 text-orange-900' : 'bg-slate-100 text-slate-600' %>">
                                                                <%= idx + 1 %>
                                                            </div>
                                                        </td>

                                                        <!-- Student Info -->
                                                        <td class="p-3.5">
                                                            <div class="flex items-center gap-3">
                                                                <img src="/profile_uploads/<%= s.profile_pic || 'default_avatar.png' %>"
                                                                     class="w-9 h-9 rounded-xl object-cover bg-slate-100 border border-slate-200 flex-shrink-0"
                                                                     onerror="this.src='/profile_uploads/default_avatar.png'">
                                                                <div class="min-w-0">
                                                                    <p class="font-bold text-indigo-950 text-xs truncate">
                                                                        <%= s.first_name %> <%= s.last_name %>
                                                                    </p>
                                                                    <p class="text-[10px] text-slate-400 font-mono">LRN: <%= s.lrn_number || 'N/A' %></p>
                                                                </div>
                                                            </div>
                                                        </td>

                                                        <!-- Enrolled Class & Subject -->
                                                        <td class="p-3.5">
                                                            <div class="flex flex-col gap-0.5">
                                                                <span class="font-bold text-indigo-900 text-[11px] truncate"><%= s.class_names || 'Not Enrolled in Class' %></span>
                                                                <span class="text-[10px] text-slate-400 truncate"><%= s.subject_names || 'No Subject Assigned' %></span>
                                                            </div>
                                                        </td>

                                                        <!-- Highest Level Reached (EXP Replaced) -->
                                                        <td class="p-3.5 text-center">
                                                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-amber-500/10 border border-amber-200 text-amber-800 font-extrabold text-xs shadow-xs">
                                                                <i class="fas fa-crown text-amber-500 text-[10px]"></i>
                                                                Level <%= s.highest_level_reached %>
                                                            </span>
                                                        </td>

                                                        <!-- Top Game Score -->
                                                        <td class="p-3.5 text-center font-extrabold text-indigo-900">
                                                            <%= s.highest_game_score.toLocaleString() %> <span class="text-[10px] font-normal text-slate-400">pts</span>
                                                        </td>

                                                        <!-- Cumulative Score -->
                                                        <td class="p-3.5 text-center font-bold text-slate-700">
                                                            <%= s.cumulative_game_score.toLocaleString() %> <span class="text-[10px] font-normal text-slate-400">pts</span>
                                                        </td>

                                                        <!-- Sessions -->
                                                        <td class="p-3.5 text-center">
                                                            <span class="re-badge bg-cyan-50 text-cyan-800 border border-cyan-200">
                                                                <%= s.total_game_sessions %> <%= s.total_game_sessions === 1 ? 'session' : 'sessions' %>
                                                            </span>
                                                        </td>

                                                        <!-- Last Played -->
                                                        <td class="p-3.5 text-right pr-4 text-[11px] text-slate-500 whitespace-nowrap">
                                                            <% if (s.last_played_at) { %>
                                                                <%= new Date(s.last_played_at).toLocaleDateString('en-PH', {month:'short', day:'numeric', year:'numeric'}) %>
                                                            <% } else { %>
                                                                <span class="text-slate-300 italic">Never</span>
                                                            <% } %>
                                                        </td>

                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Student Leaderboard Pagination Controls -->
                                    <div id="prStudentPaginationWrap" class="p-3.5 bg-slate-50/70 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs">
                                        <p class="text-slate-500 font-medium">
                                            Showing <span id="prStudentStart" class="font-bold text-indigo-950">1</span> to <span id="prStudentEnd" class="font-bold text-indigo-950">10</span> of <span id="prStudentTotal" class="font-bold text-indigo-950"><%= studentGameLeaderboard.length %></span> students
                                        </p>
