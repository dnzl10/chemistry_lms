async function fetchDateEngagement(date) {
    var btnIcon = document.getElementById('btnRefreshAnalyticsIcon');
    if (btnIcon) btnIcon.classList.add('fa-spin');

    var url = '/admin/re/analytics/date-engagement' + (date ? ('?date=' + encodeURIComponent(date)) : '');
    try {
        var res = await fetch(url);
        var data = await res.json();
        if (!data.success) {
            showToast(data.message || 'Failed to load engagement analytics.', 'err');
            return;
        }

        currentAnalyticsDate = data.date;
        if (!latestAnalyticsDateFallback && data.availableDates && data.availableDates.length > 0) {
            latestAnalyticsDateFallback = data.availableDates[0];
        }

        // Update date input
        var dateInput = document.getElementById('analyticsDateInput');
        if (dateInput) dateInput.value = data.date;

        var dateLabel = document.getElementById('chartDateLabel');
        if (dateLabel) {
            var dObj = new Date(data.date + 'T00:00:00');
            dateLabel.textContent = isNaN(dObj.getTime()) ? data.date : dObj.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        // Render quick date pills
        renderQuickDatePills(data.availableDates, data.date);

        // Update stat cards
        var m = data.materials || {};
        var g = data.games || {};
        var algo = data.algorithm || {};

        document.getElementById('statMatTotal').textContent = m.total || 0;
        document.getElementById('statMatStudents').textContent = m.uniqueStudents || 0;
        document.getElementById('statMatViews').textContent = m.views || 0;
        document.getElementById('statMatDownloads').textContent = m.downloads || 0;

        document.getElementById('statGameTotal').textContent = g.total || 0;
        document.getElementById('statGamePlayers').textContent = g.uniqueStudents || 0;
        document.getElementById('statGameCompleted').textContent = g.completed || 0;
        document.getElementById('statGameSolo').textContent = g.solo || 0;

        // Peak hour calculation
        var peakHour = -1, peakCount = 0;
        for (var h = 0; h < 24; h++) {
            var hTotal = ((m.hourly && m.hourly[h]) || 0) + ((g.hourly && g.hourly[h]) || 0);
            if (hTotal > peakCount) {
                peakCount = hTotal;
                peakHour = h;
            }
        }
        var peakHourEl = document.getElementById('statPeakHour');
        var peakCountEl = document.getElementById('statPeakCount');
        if (peakHour >= 0 && peakCount > 0) {
            var ampm = peakHour >= 12 ? 'PM' : 'AM';
            var hour12 = peakHour % 12 === 0 ? 12 : peakHour % 12;
            peakHourEl.textContent = hour12 + ':00 ' + ampm;
            peakCountEl.textContent = peakCount + ' actions';
        } else {
            peakHourEl.textContent = 'None';
            peakCountEl.textContent = '0 actions';
        }

        // Verdict badge & card
        var verdictBadge = document.getElementById('statVerdictBadge');
        var verdictIcon = document.getElementById('statVerdictIcon');
        var shareRatio = document.getElementById('statShareRatio');
        var gameScore = algo.scores ? algo.scores.games : 0;
        var matScore = algo.scores ? algo.scores.materials : 0;

        if (verdictBadge) verdictBadge.textContent = algo.badgeText || 'Evaluating...';
        if (shareRatio) shareRatio.textContent = gameScore + '% Games vs ' + matScore + '% Materials';

        if (algo.higherEngagement === 'games') {
            if (verdictBadge) verdictBadge.className = 'text-sm font-black text-indigo-600 truncate';
            if (verdictIcon) verdictIcon.className = 'w-7 h-7 rounded-lg bg-indigo-100 text-indigo-600 flex items-center justify-center text-xs';
        } else if (algo.higherEngagement === 'materials') {
            if (verdictBadge) verdictBadge.className = 'text-sm font-black text-cyan-700 truncate';
            if (verdictIcon) verdictIcon.className = 'w-7 h-7 rounded-lg bg-cyan-100 text-cyan-600 flex items-center justify-center text-xs';
        } else {
            if (verdictBadge) verdictBadge.className = 'text-sm font-black text-slate-700 truncate';
            if (verdictIcon) verdictIcon.className = 'w-7 h-7 rounded-lg bg-slate-100 text-slate-600 flex items-center justify-center text-xs';
        }

        // Balance progress split bar
        var barMat = document.getElementById('barMatShare');
        var barGame = document.getElementById('barGameShare');
        var lblMat = document.getElementById('labelMatPercent');
        var lblGame = document.getElementById('labelGamePercent');

        if (matScore === 0 && gameScore === 0) {
            if (barMat) barMat.style.width = '50%';
            if (barGame) barGame.style.width = '50%';
            if (lblMat) lblMat.textContent = '0%';
            if (lblGame) lblGame.textContent = '0%';
        } else {
            if (barMat) barMat.style.width = matScore + '%';
            if (barGame) barGame.style.width = gameScore + '%';
            if (lblMat) lblMat.textContent = matScore + '%';
            if (lblGame) lblGame.textContent = gameScore + '%';
        }

        var quickVol = document.getElementById('quickTotalVol');
        if (quickVol) quickVol.textContent = ((m.total || 0) + (g.total || 0));
        var quickReach = document.getElementById('quickTotalReach');
        if (quickReach) quickReach.textContent = ((m.uniqueStudents || 0) + (g.uniqueStudents || 0)) + ' students';
        var intMat = (m.uniqueStudents > 0) ? ((m.total || 0) / m.uniqueStudents).toFixed(1) : '0';
        var intGame = (g.uniqueStudents > 0) ? ((g.total || 0) / g.uniqueStudents).toFixed(1) : '0';
        var quickInt = document.getElementById('quickIntensityRatio');
        if (quickInt) quickInt.textContent = 'M: ' + intMat + ' | G: ' + intGame;

        var calloutEl = document.getElementById('algorithmVerdictCallout');
        if (calloutEl) calloutEl.textContent = algo.summary || '';

        // Update Chart.js
        updateEngagementChart(m.hourly || [], g.hourly || [], data.date);

    } catch (err) {
        console.error('[Analytics Fetch Error]', err);
        showToast('Error retrieving date engagement data.', 'err');
    } finally {
        if (btnIcon) btnIcon.classList.remove('fa-spin');
    }
}

