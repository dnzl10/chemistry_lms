function renderQuickDatePills(dates, activeDate) {
    var container = document.getElementById('analyticsQuickDatePills');
    if (!container) return;
    container.innerHTML = '';
    if (!dates || dates.length === 0) {
        container.innerHTML = '<span class="text-[11px] text-slate-400 italic">No interaction history recorded yet.</span>';
        return;
    }
    dates.slice(0, 8).forEach(function(d) {
        var btn = document.createElement('button');
        btn.type = 'button';
        var isActive = (d === activeDate);
        btn.className = 'px-2 py-0.5 rounded-lg text-[11px] font-bold transition whitespace-nowrap ' +
            (isActive ? 'bg-indigo-600 text-white shadow-2xs' : 'bg-white hover:bg-slate-100 text-slate-600 border border-slate-200');
        btn.textContent = d;
        btn.onclick = function() {
            fetchDateEngagement(d);
        };
        container.appendChild(btn);
    });
}

