}

async function submitEditForum() {
    var id      = document.getElementById('editForumId').value;
    var title   = document.getElementById('editForumTitle').value.trim();
    var content = document.getElementById('editForumContent').value.trim();
    var pinned  = document.getElementById('editForumPinned').checked ? 1 : 0;
    var status  = document.getElementById('editForumStatus') ? document.getElementById('editForumStatus').value : 'unresolved';
    var topic_id= document.getElementById('editForumTopicId') ? document.getElementById('editForumTopicId').value : null;

