// 1. Filter Classes Breakdown (Tier 2)
function filterClassesBreakdown() {
    var subjectFilter = document.getElementById('prClassSubjectFilter');
    var searchInput = document.getElementById('prClassSearchInput');
    if (!subjectFilter || !searchInput) return;

    var selectedSubj = subjectFilter.value;
    var query = (searchInput.value || '').trim().toLowerCase();
    var cards = document.querySelectorAll('.pr-class-card');
    var visibleCount = 0;

    cards.forEach(function(card) {
        var cardSubj = card.getAttribute('data-subject-id');
        var className = card.getAttribute('data-class-name') || '';
        var teacherName = card.getAttribute('data-teacher-name') || '';

        var matchesSubject = (selectedSubj === 'ALL' || cardSubj === selectedSubj);
        var matchesQuery = (!query || className.includes(query) || teacherName.includes(query));

        if (matchesSubject && matchesQuery) {
            card.style.display = '';
            visibleCount++;
        } else {
            card.style.display = 'none';
        }
    });

    var noMatch = document.getElementById('prClassesNoMatch');
    if (noMatch) {
        noMatch.classList.toggle('hidden', visibleCount > 0);
    }
}

// 2. Student Leaderboard (Tier 3) Pagination, Search & Sorting
var prStudentPage = 1;
var PR_STUDENTS_PER_PAGE = 10;

function getMatchingStudentRows() {
    var searchInput = document.getElementById('prStudentSearchInput');
    var query = searchInput ? (searchInput.value || '').trim().toLowerCase() : '';
    var rows = Array.from(document.querySelectorAll('.pr-student-row'));

    return rows.filter(function(row) {
        if (!query) return true;
        var name = row.getAttribute('data-name') || '';
        var lrn = row.getAttribute('data-lrn') || '';
        return name.includes(query) || lrn.includes(query);
    });
}

function sortStudentLeaderboard() {
    var sortSelect = document.getElementById('prStudentSortSelect');
    var sortMode = sortSelect ? sortSelect.value : 'level';
    var tbody = document.getElementById('prStudentTableBody');
    if (!tbody) return;

    var rows = Array.from(document.querySelectorAll('.pr-student-row'));
    rows.sort(function(a, b) {
        var levelA = parseInt(a.getAttribute('data-level') || '0', 10);
        var levelB = parseInt(b.getAttribute('data-level') || '0', 10);
        var scoreA = parseInt(a.getAttribute('data-score') || '0', 10);
        var scoreB = parseInt(b.getAttribute('data-score') || '0', 10);
        var cumA = parseInt(a.getAttribute('data-cumulative') || '0', 10);
        var cumB = parseInt(b.getAttribute('data-cumulative') || '0', 10);
        var sessA = parseInt(a.getAttribute('data-sessions') || '0', 10);
        var sessB = parseInt(b.getAttribute('data-sessions') || '0', 10);

        if (sortMode === 'level') {
            if (levelB !== levelA) return levelB - levelA;
            if (scoreB !== scoreA) return scoreB - scoreA;
            return sessB - sessA;
        } else if (sortMode === 'score') {
            if (scoreB !== scoreA) return scoreB - scoreA;
            if (levelB !== levelA) return levelB - levelA;
            return sessB - sessA;
        } else if (sortMode === 'cumulative') {
            if (cumB !== cumA) return cumB - cumA;
            return levelB - levelA;
        } else if (sortMode === 'sessions') {
            if (sessB !== sessA) return sessB - sessA;
            return levelB - levelA;
        }
        return 0;
    });

    rows.forEach(function(row, idx) {
        tbody.appendChild(row);
        var badge = row.querySelector('.pr-rank-badge');
        if (badge) {
            badge.textContent = idx + 1;
            badge.className = 'pr-rank-badge w-7 h-7 mx-auto rounded-lg flex items-center justify-center font-black text-xs ' +
                (idx === 0 ? 'bg-amber-400 text-white shadow-xs' : idx === 1 ? 'bg-slate-300 text-slate-800' : idx === 2 ? 'bg-orange-300 text-orange-900' : 'bg-slate-100 text-slate-600');
        }
    });

    prStudentPage = 1;
    renderStudentLeaderboardPagination();
}

function filterStudentLeaderboard() {
    prStudentPage = 1;
    renderStudentLeaderboardPagination();
}

function renderStudentLeaderboardPagination() {
    var allRows = Array.from(document.querySelectorAll('.pr-student-row'));
    var matchingRows = getMatchingStudentRows();
    var total = matchingRows.length;
    var totalPages = Math.ceil(total / PR_STUDENTS_PER_PAGE) || 1;

    if (prStudentPage > totalPages) prStudentPage = totalPages;
    if (prStudentPage < 1) prStudentPage = 1;

    var startIndex = (prStudentPage - 1) * PR_STUDENTS_PER_PAGE;
    var endIndex = Math.min(startIndex + PR_STUDENTS_PER_PAGE, total);

    allRows.forEach(function(row) {
        row.style.display = 'none';
    });

    matchingRows.forEach(function(row, idx) {
        if (idx >= startIndex && idx < endIndex) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });

    var startEl = document.getElementById('prStudentStart');
    var endEl = document.getElementById('prStudentEnd');
    var totalEl = document.getElementById('prStudentTotal');
    if (startEl) startEl.textContent = total === 0 ? '0' : (startIndex + 1);
    if (endEl) endEl.textContent = total === 0 ? '0' : endIndex;
    if (totalEl) totalEl.textContent = total;

    var btnPrev = document.getElementById('btnPrevPrStudent');
    var btnNext = document.getElementById('btnNextPrStudent');
    if (btnPrev) btnPrev.disabled = (prStudentPage <= 1);
    if (btnNext) btnNext.disabled = (prStudentPage >= totalPages || total === 0);

    var numContainer = document.getElementById('prStudentPageNumbers');
    if (numContainer) {
        numContainer.innerHTML = '';
        var maxButtons = 5;
        var startPage = Math.max(1, prStudentPage - Math.floor(maxButtons / 2));
        var endPage = Math.min(totalPages, startPage + maxButtons - 1);
        if (endPage - startPage < maxButtons - 1) {
            startPage = Math.max(1, endPage - maxButtons + 1);
        }

        for (var p = startPage; p <= endPage; p++) {
            (function(page) {
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.textContent = page;
                var isActive = (page === prStudentPage);
                btn.className = 'w-7 h-7 rounded-lg text-xs font-bold transition flex items-center justify-center ' +
                    (isActive
                        ? 'bg-gradient-to-r from-amber-500 to-indigo-500 text-white shadow-xs pointer-events-none'
                        : 'border border-slate-200 text-slate-600 hover:bg-slate-50 hover:text-indigo-600');
                btn.onclick = function() {
                    prStudentPage = page;
                    renderStudentLeaderboardPagination();
                };
                numContainer.appendChild(btn);
            })(p);
        }
    }

    var wrap = document.getElementById('prStudentPaginationWrap');
    if (wrap) {
        wrap.style.display = (allRows.length === 0) ? 'none' : 'flex';
    }
}

function changeStudentLeaderboardPage(delta) {
    var matching = getMatchingStudentRows();
    var totalPages = Math.ceil(matching.length / PR_STUDENTS_PER_PAGE) || 1;
    var target = prStudentPage + delta;
    if (target >= 1 && target <= totalPages) {
        prStudentPage = target;
        renderStudentLeaderboardPagination();
    }
}

// Initializer
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
        renderStudentLeaderboardPagination();
    });
} else {
    renderStudentLeaderboardPagination();
}
</script>
