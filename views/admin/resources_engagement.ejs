async function submitAddMaterial() {
    var title   = document.getElementById('matTitle').value.trim();
    var topicId = document.getElementById('matTopicId').value;
    var type    = document.getElementById('matType').value;
    var locked  = document.getElementById('matLocked').checked ? 1 : 0;
    var btn     = document.getElementById('btnSubmitMaterial');
    var valid   = true;

    // Reset error states
    document.getElementById('errMatTitle').classList.add('hidden');
    document.getElementById('errMatTopic').classList.add('hidden');
    document.getElementById('errMatFile').classList.add('hidden');
    document.getElementById('matFileMismatchAlert').classList.add('hidden');
    var errUrl = document.getElementById('errMatUrl');
    if (errUrl) errUrl.classList.add('hidden');

    if (!title) {
        document.getElementById('errMatTitle').classList.remove('hidden');
        valid = false;
    }
    if (!topicId) {
        document.getElementById('errMatTopic').classList.remove('hidden');
        valid = false;
    }

    if (type === 'link') {
        var url = document.getElementById('matUrl').value.trim();
        if (!url || !/^https?:\/\/.+/i.test(url)) {
            if (errUrl) {
                errUrl.textContent = 'A valid web URL (starting with http:// or https://) is required.';
                errUrl.classList.remove('hidden');
            }
            valid = false;
        }
        if (!valid) return;

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> <span>Saving...</span>';
        }

        try {
            var res  = await fetch('/admin/re/materials', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ title: title, topic_id: topicId, material_type: type, file_path_or_url: url, is_locked: locked })
            });
            var data = await res.json();
            if (data.success) {
                showToast('Material link saved successfully!', 'ok');
                closeModal('modalAddMaterial');
                refreshAdminContent({ message: 'Updating Learning Vault...' });
            } else {
                showToast(data.message || 'Failed to save material.', 'err');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-upload text-xs"></i> <span>Upload</span>';
                }
            }
        } catch (_) {
            showToast('Network error while saving material link.', 'err');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-upload text-xs"></i> <span>Upload</span>';
            }
        }

    } else {
        var cfg = MAT_TYPE_CONFIGS[type];
        var fileInput = document.getElementById('matFile');
        var file = fileInput ? (fileInput.files && fileInput.files[0]) : null;

        if (!file) {
            var errFileEl = document.getElementById('errMatFile');
            if (errFileEl) {
                errFileEl.innerHTML = '<i class="fas fa-exclamation-circle"></i> <span>Please select a file to upload for ' + (cfg ? cfg.label : 'this type') + '.</span>';
                errFileEl.classList.remove('hidden');
            }
            valid = false;
        } else if (cfg) {
            var dotIdx = file.name.lastIndexOf('.');
            var ext = dotIdx !== -1 ? file.name.substring(dotIdx).toLowerCase() : '';
            if (!cfg.extensions.includes(ext)) {
                var mismatchAlert = document.getElementById('matFileMismatchAlert');
                var mismatchDesc  = document.getElementById('matFileMismatchDesc');
                if (mismatchDesc) {
                    mismatchDesc.innerHTML = 'You selected <strong>' + escapeMatHtml(cfg.label) + '</strong>, but uploaded <strong>' + escapeMatHtml(file.name) + '</strong> (' + (ext || 'no extension') + '). Allowed formats: <strong>' + cfg.extensions.join(', ') + '</strong>.';
                }
                if (mismatchAlert) mismatchAlert.classList.remove('hidden');
                showToast('Upload blocked: File type mismatch.', 'err');
                valid = false;
            }
        }

        if (!valid) return;

        if (btn) {
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> <span>Uploading...</span>';
        }

        var fd = new FormData();
        fd.append('title', title);
        fd.append('topic_id', topicId);
        fd.append('material_type', type);
        fd.append('is_locked', locked);
        fd.append('material_file', file);

        try {
            var res  = await fetch('/admin/re/materials', { method: 'POST', body: fd });
            var data = await res.json();
            if (data.success) {
                showToast('Material uploaded successfully!', 'ok');
                closeModal('modalAddMaterial');
                refreshAdminContent({ message: 'Updating Learning Vault...' });
            } else {
                showToast(data.message || 'Upload failed.', 'err');
                if (data.message && data.message.toLowerCase().includes('mismatch')) {
                    var mismatchAlert = document.getElementById('matFileMismatchAlert');
                    var mismatchDesc  = document.getElementById('matFileMismatchDesc');
                    if (mismatchDesc) mismatchDesc.innerHTML = escapeMatHtml(data.message);
                    if (mismatchAlert) mismatchAlert.classList.remove('hidden');
                }
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-upload text-xs"></i> <span>Upload</span>';
                }
            }
        } catch (_) {
            showToast('Network error while uploading material.', 'err');
            if (btn) {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-upload text-xs"></i> <span>Upload</span>';
            }
        }
    }
}

