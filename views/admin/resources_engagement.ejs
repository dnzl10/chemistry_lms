async function submitAddForum() {
    var title   = document.getElementById('forumTitle').value.trim();
    var topicId = document.getElementById('forumTopicId').value;
    var content = document.getElementById('forumContent').value.trim();
    var pinned  = document.getElementById('forumPinned').checked ? 1 : 0;
    var valid   = true;

    if (!title)   { document.getElementById('errForumTitle').classList.remove('hidden'); valid = false; }
    else            document.getElementById('errForumTitle').classList.add('hidden');
    if (!topicId) { document.getElementById('errForumTopic').classList.remove('hidden'); valid = false; }
    else            document.getElementById('errForumTopic').classList.add('hidden');
    if (!valid) return;

    try {
        var res  = await fetch('/admin/re/forums', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ title, topic_id:topicId, forum_content:content, is_pinned:pinned }) });
        var data = await res.json();
        if (data.success) {
            showToast('Forum board created!', 'ok');
            closeModal('modalAddForum');
            refreshAdminContent({ message: 'Creating forum board...' });
        } else showToast(data.message || 'Failed.', 'err');
    } catch(_) { showToast('Network error.', 'err'); }
}

function openEditForum(f) {
    document.getElementById('editForumId').value      = f.forum_id;
    document.getElementById('editForumTitle').value   = f.title || '';
    document.getElementById('editForumContent').value = f.forum_content || '';
    document.getElementById('editForumPinned').checked = !!f.is_pinned;
    if (document.getElementById('editForumStatus')) document.getElementById('editForumStatus').value = f.status || 'unresolved';
    if (document.getElementById('editForumTopicId')) document.getElementById('editForumTopicId').value = f.topic_id || '';
