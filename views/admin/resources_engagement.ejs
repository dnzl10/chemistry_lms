<!-- ════════════════════════════════════════════════════
     JAVASCRIPT
════════════════════════════════════════════════════ -->
<script>
// ─── Sidebar ───────────────────────────────────────────
function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('-translate-x-full');
    document.getElementById('sidebarOverlay').classList.toggle('hidden');
}

// ─── Tabs ──────────────────────────────────────────────
function switchTab(id, btn) {
    document.querySelectorAll('.re-pane').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.re-tab').forEach(b => b.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    btn.classList.add('active');
}


// ── Auto-activate tab from URL query param ──
    // Usage: /admin/resources_engagement?tab=pillar2  (Forum Moderation)
    (function() {
        const urlParams = new URLSearchParams(window.location.search);
        const targetTab = urlParams.get('tab');
        if (targetTab) {
            const targetPane = document.getElementById(targetTab);
            // re-tab buttons use onclick="switchTab('pillar2',this)"
            const targetBtn = document.querySelector(`[onclick="switchTab('${targetTab}',this)"]`);
            if (targetPane && targetBtn) {
                // Use the existing switchTab which handles .re-pane and .re-tab
                switchTab(targetTab, targetBtn);
                setTimeout(() => targetPane.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
            }
        }
    })();

// ─── Accordion ─────────────────────────────────────────
function toggleAccordion(btn) {
    const body = btn.nextElementSibling;
    body.classList.toggle('open');
    btn.classList.toggle('open');
}

// ─── Forum replies drill-down ──────────────────────────
function toggleForumReplies(fId) {
    const el  = document.getElementById('forumReplies' + fId);
    const ch  = document.getElementById('forumChevron' + fId);
    if (!el) return;
    el.classList.toggle('hidden');
    ch && ch.classList.toggle('rotate-180');
}

// ─── Modals ─────────────────────────────────────────────
function openModal(id) {
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
}
function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    document.body.style.overflow = '';
}
document.querySelectorAll('.re-modal').forEach(o => {
    o.addEventListener('click', function(e) { if (e.target === o) closeModal(o.id); });
});

// ─── Toast ──────────────────────────────────────────────
function showToast(msg, type) {
    type = type || 'info';
    const t = document.getElementById('reToast');
    const i = document.getElementById('reToastIcon');
    document.getElementById('reToastMsg').textContent = msg;
    var icons = { ok:'fa-check-circle', err:'fa-circle-xmark', warn:'fa-triangle-exclamation', info:'fa-circle-info' };
    i.className = 'fas ' + (icons[type] || 'fa-circle-info');
    t.className = 'show ' + type;
    setTimeout(function() { t.className = ''; }, 3600);
}

// ─── Generic confirm ────────────────────────────────────
function showConfirm(opts) {
    document.getElementById('reConfirmIcon').className = 'w-14 h-14 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl ' + (opts.iconBg || 'bg-red-50');
    document.getElementById('reConfirmIcon').innerHTML = '<i class="' + opts.icon + ' ' + (opts.iconColor || 'text-red-500') + '"></i>';
    document.getElementById('reConfirmTitle').textContent = opts.title || 'Confirm';
    document.getElementById('reConfirmDesc').textContent  = opts.desc  || '';
    var btn = document.getElementById('reConfirmBtn');
    btn.textContent = opts.btnLabel || 'Confirm';
    btn.className = 'px-5 py-2.5 rounded-xl text-white text-sm font-bold hover:opacity-90 transition shadow-md ' + (opts.btnColor || 'bg-red-600');
    btn.onclick = opts.onConfirm;
    openModal('modalConfirmRE');
}

// ─── Material type field toggle ──────────────────────────
function toggleMatTypeFields() {
    var type = document.getElementById('matType').value;
    var isLink = type === 'link';
    document.getElementById('matFileWrap').classList.toggle('hidden', isLink);
    document.getElementById('matUrlWrap').classList.toggle('hidden', !isLink);
}

function showMatFileName(input) {
    var lbl = document.getElementById('matFileLabel');
    if (input.files && input.files[0]) {
        lbl.textContent = 'Selected: ' + input.files[0].name;
        lbl.classList.remove('hidden');
    }
}

// ─── Material search filter ──────────────────────────────
function filterMaterials() {
    var q = document.getElementById('matSearch').value.toLowerCase().trim();
    document.querySelectorAll('.mat-item').forEach(function(card) {
        card.style.display = (!q || card.dataset.search.includes(q)) ? '' : 'none';
    });
}

// ─── Interaction log search ──────────────────────────────
function filterInteractions() {
    var q = document.getElementById('interactionSearch').value.toLowerCase().trim();
    document.querySelectorAll('.interaction-row').forEach(function(row) {
        row.style.display = (!q || row.dataset.search.includes(q)) ? '' : 'none';
    });
}

// ══════════════════════════════════════════════════
// SECTION 1: MATERIALS
// ══════════════════════════════════════════════════

async function submitAddMaterial() {
    var title   = document.getElementById('matTitle').value.trim();
    var topicId = document.getElementById('matTopicId').value;
    var type    = document.getElementById('matType').value;
    var locked  = document.getElementById('matLocked').checked ? 1 : 0;
    var valid   = true;

    if (!title)   { document.getElementById('errMatTitle').classList.remove('hidden'); valid = false; }
    else            document.getElementById('errMatTitle').classList.add('hidden');
    if (!topicId) { document.getElementById('errMatTopic').classList.remove('hidden'); valid = false; }
    else            document.getElementById('errMatTopic').classList.add('hidden');

    if (type === 'link') {
        var url = document.getElementById('matUrl').value.trim();
        if (!url) { document.getElementById('errMatUrl').classList.remove('hidden'); valid = false; }
        else        document.getElementById('errMatUrl').classList.add('hidden');
        if (!valid) return;

        try {
            var res  = await fetch('/admin/re/materials', { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ title, topic_id:topicId, material_type:type, file_path_or_url:url, is_locked:locked }) });
            var data = await res.json();
            if (data.success) { showToast('Material created!', 'ok'); closeModal('modalAddMaterial'); setTimeout(function(){ location.reload(); }, 1200); }
            else showToast(data.message || 'Failed.', 'err');
        } catch(_) { showToast('Network error.', 'err'); }

    } else {
        var file = document.getElementById('matFile').files[0];
        if (!file) { document.getElementById('errMatFile').classList.remove('hidden'); valid = false; }
        else         document.getElementById('errMatFile').classList.add('hidden');
        if (!valid) return;

        var fd = new FormData();
        fd.append('title', title);
        fd.append('topic_id', topicId);
        fd.append('material_type', type);
        fd.append('is_locked', locked);
        fd.append('material_file', file);

        try {
            var res  = await fetch('/admin/re/materials', { method:'POST', body:fd });
            var data = await res.json();
            if (data.success) { showToast('Material uploaded!', 'ok'); closeModal('modalAddMaterial'); setTimeout(function(){ location.reload(); }, 1200); }
            else showToast(data.message || 'Failed.', 'err');
        } catch(_) { showToast('Network error.', 'err'); }
    }
}

function openEditMaterial(m) {
    document.getElementById('editMatId').value      = m.material_id;
    document.getElementById('editMatTitle').value   = m.title || '';
    document.getElementById('editMatTopicId').value = m.topic_id || '';
    document.getElementById('editMatLocked').checked = !!m.is_locked;
    openModal('modalEditMaterial');
}

async function submitEditMaterial() {
    var id      = document.getElementById('editMatId').value;
    var title   = document.getElementById('editMatTitle').value.trim();
    var topicId = document.getElementById('editMatTopicId').value;
    var locked  = document.getElementById('editMatLocked').checked ? 1 : 0;
    if (!title) { showToast('Title is required.', 'warn'); return; }

    try {
        var res  = await fetch('/admin/re/materials/' + id, { method:'PUT', headers:{'Content-Type':'application/json'}, body:JSON.stringify({ title, topic_id:topicId, is_locked:locked }) });
        var data = await res.json();
        if (data.success) { showToast('Material updated!', 'ok'); closeModal('modalEditMaterial'); setTimeout(function(){ location.reload(); }, 1200); }
        else showToast(data.message || 'Failed.', 'err');
    } catch(_) { showToast('Network error.', 'err'); }
}

function toggleMatLock(id, currentLocked) {
    var newVal = currentLocked ? 0 : 1;
    var label  = currentLocked ? 'Unlock' : 'Lock';
    showConfirm({
        icon:'fas fa-lock', iconBg: currentLocked ? 'bg-emerald-50' : 'bg-amber-50',
        iconColor: currentLocked ? 'text-emerald-500' : 'text-amber-500',
        title: label + ' this material?',
        desc : currentLocked ? 'Students will be able to access this material.' : 'Students will no longer see this material.',
        btnLabel: label, btnColor: currentLocked ? 'bg-emerald-500' : 'bg-amber-500',
        onConfirm: async function() {
            closeModal('modalConfirmRE');
            try {
                var res  = await fetch('/admin/re/materials/' + id + '/toggle-lock', { method:'POST' });
                var data = await res.json();
                if (data.success) { showToast('Material ' + label.toLowerCase() + 'ed.', 'ok'); setTimeout(function(){ location.reload(); }, 1000); }
                else showToast(data.message || 'Failed.', 'err');
            } catch(_) { showToast('Network error.', 'err'); }
        }
    });
}

function confirmDeleteMaterial(id, name) {
    showConfirm({
        icon:'fas fa-trash', iconBg:'bg-red-50', iconColor:'text-red-500',
        title: 'Delete "' + name + '"?',
        desc : 'This permanently removes the file from the server and database. This cannot be undone.',
        btnLabel:'Delete', btnColor:'bg-red-600',
        onConfirm: async function() {
            closeModal('modalConfirmRE');
            try {
                var res  = await fetch('/admin/re/materials/' + id, { method:'DELETE' });
                var data = await res.json();
                if (data.success) { showToast('Material deleted.', 'ok'); setTimeout(function(){ location.reload(); }, 1200); }
                else showToast(data.message || 'Failed.', 'err');
            } catch(_) { showToast('Network error.', 'err'); }
        }
    });
}

