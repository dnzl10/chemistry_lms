<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .glass-card { background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); }

        /* Stat card hover */
        .stat-card { transition: transform 0.18s ease, box-shadow 0.18s ease; }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.10); }

        /* Alert pulse */
        .pulse-badge { animation: pulseRing 2s infinite; }
        @keyframes pulseRing {
            0%,100% { opacity:1; }
            50%      { opacity:0.45; }
        }

        /* Add this to your CSS for cleaner scrollbars */
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }

        /* Scrollable table containers */
        .table-scroll { max-height: 260px; overflow-y: auto; }
        .table-scroll::-webkit-scrollbar { width: 3px; }
        .table-scroll::-webkit-scrollbar-thumb { background: #c7d2fe; border-radius:2px; }

        /* Nav active state */
        .nav-active {
            background: linear-gradient(135deg, #06b6d4, #6366f1) !important;
            color: white !important;
            font-weight: 700;
            box-shadow: 0 4px 14px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }

        /* Section fade-in */
        .fade-in { animation: fadeUp 0.35s ease both; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }

        /* Live dot */
        .live-dot {
            width:8px; height:8px; border-radius:50%;
            background:#22c55e;
            box-shadow: 0 0 0 0 rgba(34,197,94,0.7);
            animation: livePulse 1.6s infinite;
            display:inline-block;
        }
        @keyframes livePulse {
            0%   { box-shadow: 0 0 0 0 rgba(34,197,94,0.7); }
            70%  { box-shadow: 0 0 0 7px rgba(34,197,94,0); }
            100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
        }
    </style>
</head>
<body class="text-slate-900">

<div class="flex min-h-screen relative overflow-x-hidden">

    <!-- Overlay (mobile) -->
    <div id="sidebarOverlay" onclick="toggleSidebar()"
         class="fixed inset-0 bg-cyan-900/50 z-40 hidden md:hidden"></div>

    <!-- ===================== SIDEBAR ===================== -->
    <aside id="sidebar"class="bg-indigo-950 text-white w-64 flex-shrink-0 flex flex-col z-50 fixed inset-y-0 left-0 -translate-x-full md:translate-x-0 h-screen border-r border-indigo-800/50">

        <div class="pt-8 pb-4 px-4 flex flex-col items-center text-center relative">
            <!-- Mobile close button -->
            <button onclick="toggleSidebar()" class="md:hidden text-indigo-300 hover:text-white absolute top-4 right-4">
                <i class="fas fa-times text-xl"></i>
            </button>

            <!-- Logo -->
            <img src="/assets/logo.png" alt="ChemArcade Logo" class="w-16 h-16 object-contain mb-3">

            <!-- Brand name -->
            <h1 class="text-xl font-black tracking-tighter text-cyan-400 uppercase italic leading-none">
                Elem<span class="text-white">enta</span>
            </h1>
            <p class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest mt-1">Admin Console</p>

            <!-- Divider -->
            <!-- <div class="w-full mt-5 border-t border-indigo-800/60"></div> -->
        </div>

        <nav class="flex-1 px-4 mt-4 space-y-6 overflow-y-auto no-scrollbar pb-6">

            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Main Interface</p>
                <div class="space-y-1">
                    <a href="/admin/dashboard"
                    class="nav-active flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white hover:bg-white/10 group">
                        <i class="fas fa-chart-pie w-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-bold tracking-tight text-sm">Main Dashboard</span>
                    </a>
                </div>
            </div>

            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Administrative</p>
                <div class="space-y-1">
                    <a href="/admin/user_access_control"
                    class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-users w-5 text-sky-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">User & Access Control</span>
                    </a>

                    <a href="/admin/academic_management"
                    class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-graduation-cap w-5 text-emerald-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Academic Management</span>
                    </a>
                </div>
            </div>

            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Learning Assets</p>
                <div class="space-y-1">
                    <a href="/admin/gaming_question_bank"
                    class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-gamepad w-5 text-amber-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Gaming & Q-Bank</span>
                    </a>

                    <a href="/admin/resources_engagement"
                    class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-lightbulb w-5 text-lime-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Resources & Engagement</span>
                    </a>
                </div>
            </div>

            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">System Health</p>
                <div class="space-y-1">
                    <a href="/admin/reports_monitoring"
                    class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-chart-line w-5 text-blue-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Reports & Monitoring</span>
                    </a>

                    <a href="/admin/system_audit"
                    class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-fingerprint w-5 text-indigo-300 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">System Audit</span>
                    </a>
                </div>
            </div>
            
        </nav>

        <div class="p-4 border-t border-indigo-800">
            <a href="/logout"
            class="flex items-center gap-3 p-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition group font-bold">
                <i class="fas fa-right-from-bracket w-5"></i> Log Out
            </a>
        </div>
    </aside>

    <!-- ===================== MAIN CONTENT ===================== -->
    <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- TOP HEADER -->
        <header class="h-20 bg-white/90 backdrop-blur-md border-b border-cyan-100 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-cyan-50 text-cyan-600 md:hidden">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <div>
                    <h2 class="text-lg font-bold text-indigo-900 uppercase tracking-tight">
                        Welcome, Admin <%= user.last_name %>!
                    </h2>
                    <p class="text-xs text-slate-400 hidden sm:block">
                        <i class="fas fa-circle text-green-400 text-[8px] mr-1"></i>
                        System operational &nbsp;·&nbsp; <%= new Date().toLocaleDateString('en-PH', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3 md:gap-6">
                <!-- Notification bell -->
                <div id="notifBellBtn" class="relative cursor-pointer p-2 hover:bg-cyan-50 rounded-full transition" onclick="toggleNotifPanel()">
                    <i class="far fa-bell text-xl text-cyan-600"></i>
                    <span id="notifDot" class="absolute top-2 right-2 flex h-2.5 w-2.5 hidden">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                    </span>
                    <span id="notifCount" class="absolute -top-0.5 -right-0.5 hidden bg-rose-500 text-white text-[9px] font-black rounded-full w-4 h-4 flex items-center justify-center"></span>
                </div>

                <!-- Admin profile -->
                <div class="flex items-center gap-3 pl-4 border-l border-cyan-100">
                    <div class="text-right hidden lg:block">
                        <p class="text-sm font-bold text-indigo-900"><%= user.first_name %> <%= user.last_name %></p>
                        <p class="text-[10px] uppercase font-black text-rose-500 tracking-widest">Administrator</p>
                    </div>
                    <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                         class="w-10 h-10 rounded-xl object-cover ring-2 ring-rose-400 shadow-sm">
                </div>
            </div>
        </header>

        <!-- SCROLLABLE CONTENT -->
        <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
            <div class="p-4 md:p-8 flex-1 fade-in">

                <!-- ══════════════════════════════════════════
                     SECTION 1 — KPI STAT CARDS
                ══════════════════════════════════════════ -->
                <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-4 mb-6">

                    <!-- Students -->
                    <div class="stat-card glass-card rounded-2xl p-4 border border-violet-100">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-violet-100 flex items-center justify-center">
                                <i class="fas fa-user-graduate text-violet-600"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-violet-400">Students</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= stats.totalStudents %></p>
                        <p class="text-xs text-slate-400 mt-1">Registered</p>
                    </div>

                    <!-- Teachers -->
                    <div class="stat-card glass-card rounded-2xl p-4 border border-cyan-100">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-cyan-100 flex items-center justify-center">
                                <i class="fas fa-chalkboard-user text-cyan-600"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-cyan-400">Teachers</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= stats.totalTeachers %></p>
                        <p class="text-xs text-slate-400 mt-1">Faculty</p>
                    </div>

                    <!-- Subjects -->
                    <div class="stat-card glass-card rounded-2xl p-4 border border-emerald-100">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
                                <i class="fas fa-book text-emerald-600"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400">Subjects</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= stats.totalSubjects %></p>
                        <p class="text-xs text-slate-400 mt-1">Courses</p>
                    </div>

                    <!-- Assessments -->
                    <div class="stat-card glass-card rounded-2xl p-4 border border-amber-100">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                                <i class="fas fa-clipboard-list text-amber-600"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-amber-400">Assessments</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= stats.totalAssessments %></p>
                        <p class="text-xs text-slate-400 mt-1">Total</p>
                    </div>

                    <!-- Questions -->
                    <div class="stat-card glass-card rounded-2xl p-4 border border-rose-100">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-rose-100 flex items-center justify-center">
                                <i class="fas fa-database text-rose-600"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-rose-400">Questions</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= stats.totalQuestions %></p>
                        <p class="text-xs text-slate-400 mt-1">In Bank</p>
                    </div>

                    <!-- Active SY -->
                    <div class="stat-card glass-card rounded-2xl p-4 border border-indigo-100">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center">
                                <i class="fas fa-calendar-alt text-indigo-600"></i>
                            </div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-indigo-400">School Year</span>
                        </div>
                        <p class="text-xl font-black text-indigo-900 leading-tight">
                            <%= activeSY ? activeSY.sy_range : 'None' %>
                        </p>
                        <p class="text-xs mt-1">
                            <% if (activeSY) { %>
                                <span class="text-green-500 font-bold"><i class="fas fa-circle text-[8px]"></i> Active</span>
                            <% } else { %>
                                <span class="text-slate-400">No active SY</span>
                            <% } %>
                        </p>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════
                     ROW 2 — Active SY Details + Alert Banner
                ══════════════════════════════════════════ -->
                <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mb-6">

                    <!-- Active SY Detail Card -->
                    <div class="glass-card rounded-2xl p-5 border border-cyan-100 flex flex-col gap-3">
                        <div class="flex items-center justify-between">
                            <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                <i class="fas fa-calendar-check text-cyan-500 mr-2"></i>Active School Year
                            </h3>
                            <a href="/admin/school-years"
                               class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline">
                                Manage →
                            </a>
                        </div>
                        <% if (activeSY) { %>
                        <div class="bg-gradient-to-r from-cyan-50 to-indigo-50 rounded-xl p-4 border border-cyan-100">
                            <p class="text-2xl font-black text-indigo-900"><%= activeSY.sy_range %></p>
                            <div class="mt-3 grid grid-cols-2 gap-2">
                                <div class="bg-white rounded-lg p-2 text-center border border-cyan-100">
                                    <p class="text-xl font-black text-indigo-900"><%= activeSY.classCount %></p>
                                    <p class="text-[10px] text-slate-400 uppercase font-bold">Classes</p>
                                </div>
                                <div class="bg-white rounded-lg p-2 text-center border border-cyan-100">
                                    <p class="text-xl font-black text-indigo-900"><%= activeSY.enrolledCount %></p>
                                    <p class="text-[10px] text-slate-400 uppercase font-bold">Enrolled</p>
                                </div>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="bg-amber-50 rounded-xl p-4 border border-amber-200 text-center">
                            <i class="fas fa-exclamation-triangle text-amber-400 text-2xl mb-2"></i>
                            <p class="text-sm font-bold text-amber-700">No active school year set.</p>
                            <a href="/admin/school-years" class="text-xs text-amber-600 underline mt-1 block">Set one now →</a>
                        </div>
                        <% } %>
                    </div>

                    <!-- Alerts & Attention — spans 2 cols -->
                    <div class="xl:col-span-2 glass-card rounded-2xl p-5 border border-rose-100">
                        <div class="flex items-center justify-between mb-3">
                            <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                <i class="fas fa-triangle-exclamation text-rose-500 mr-2"></i>Needs Attention
                            </h3>
                            <span class="bg-rose-100 text-rose-600 text-[10px] font-black px-2 py-1 rounded-full uppercase">
                                <%= alerts.total %> item<%= alerts.total !== 1 ? 's' : '' %>
                            </span>
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">

                            <!-- Expired Invitations -->
                            <div class="flex items-center gap-3 bg-rose-50 rounded-xl p-3 border border-rose-100">
                                <div class="w-9 h-9 rounded-lg bg-rose-100 flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-envelope-circle-check text-rose-500"></i>
                                </div>
                                <div>
                                    <p class="text-lg font-black text-rose-700"><%= alerts.expiredInvites %></p>
                                    <p class="text-[11px] text-slate-500 font-semibold">Expired Invitations</p>
                                </div>
                                <a href="/admin/user_access_control?tab=tab-invites" class="ml-auto text-rose-400 hover:text-rose-600 text-xs font-bold">View →</a>
                            </div>

                            <!-- Flagged Students -->
                            <div class="flex items-center gap-3 bg-amber-50 rounded-xl p-3 border border-amber-100">
                                <div class="w-9 h-9 rounded-lg bg-amber-100 flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-flag text-amber-500"></i>
                                </div>
                                <div>
                                    <p class="text-lg font-black text-amber-700"><%= alerts.flaggedStudents %></p>
                                    <p class="text-[11px] text-slate-500 font-semibold">Flagged Students</p>
                                </div>
                                <a href="/admin/user_access_control?tab=tab-flagged" class="ml-auto text-amber-400 hover:text-amber-600 text-xs font-bold">View →</a>
                            </div>

                            <!-- Locked Assessments Past Due -->
                            <div class="flex items-center gap-3 bg-violet-50 rounded-xl p-3 border border-violet-100">
                                <div class="w-9 h-9 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-lock text-violet-500"></i>
                                </div>
                                <div>
                                    <p class="text-lg font-black text-violet-700"><%= alerts.lockedPastDue %></p>
                                    <p class="text-[11px] text-slate-500 font-semibold">Locked & Past Due</p>
                                </div>
                                <a href="/admin/gaming_question_bank?tab=tab-assessments" class="ml-auto text-violet-400 hover:text-violet-600 text-xs font-bold">View →</a>
                            </div>

                            <!-- Overdue Calendar Events -->
                            <div class="flex items-center gap-3 bg-slate-50 rounded-xl p-3 border border-slate-200">
                                <div class="w-9 h-9 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-calendar-xmark text-slate-500"></i>
                                </div>
                                <div>
                                    <p class="text-lg font-black text-slate-700"><%= alerts.overdueDeadlines %></p>
                                    <p class="text-[11px] text-slate-500 font-semibold">Overdue Deadlines</p>
                                </div>
                                <a href="/admin/calendar" class="ml-auto text-slate-400 hover:text-slate-600 text-xs font-bold">View →</a>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════
                     ROW 3 — Live Arcade Monitor (full width)
                ══════════════════════════════════════════ -->
                <div class="glass-card rounded-2xl p-5 border border-green-100 mb-6">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm flex items-center gap-2">
                            <span class="live-dot"></span>
                            Live Arcade Monitor
                        </h3>
                        <div class="flex items-center gap-3">
                            <span class="bg-green-100 text-green-700 text-[10px] font-black px-3 py-1 rounded-full uppercase">
                                <%= activeSessions.length %> Active Session<%= activeSessions.length !== 1 ? 's' : '' %>
                            </span>
                            <span class="bg-fuchsia-100 text-fuchsia-700 text-[10px] font-black px-3 py-1 rounded-full uppercase">
                                <%= activeSessions.filter(s => s.player_mode === 'Duel').length %> Duels
                            </span>
                            <a href="/admin/arcade" class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline">
                                Full View →
                            </a>
                        </div>
                    </div>

                    <% if (activeSessions.length === 0) { %>
                    <div class="text-center py-8 text-slate-400">
                        <i class="fas fa-gamepad text-3xl mb-2 opacity-30"></i>
                        <p class="text-sm font-bold">No active arcade sessions right now.</p>
                    </div>
                    <% } else { %>
                    <div class="table-scroll">
                        <table class="w-full text-sm">
                            <thead class="sticky top-0 bg-white/80 backdrop-blur-sm">
                                <tr class="text-left text-[11px] font-black uppercase tracking-widest text-slate-400 border-b border-slate-100">
                                    <th class="pb-2 pr-4">Student</th>
                                    <th class="pb-2 pr-4">Assessment</th>
                                    <th class="pb-2 pr-4">Mode</th>
                                    <th class="pb-2 pr-4">Progress</th>
                                    <th class="pb-2 pr-4">Score</th>
                                    <th class="pb-2">Started</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-slate-50">
                                <% activeSessions.forEach(session => { %>
                                <tr class="hover:bg-cyan-50/40 transition">
                                    <td class="py-2 pr-4 font-semibold text-indigo-900">
                                        <%= session.student_name %>
                                    </td>
                                    <td class="py-2 pr-4 text-slate-600 max-w-[160px] truncate">
                                        <%= session.assessment_name %>
                                    </td>
                                    <td class="py-2 pr-4">
                                        <% if (session.player_mode === 'Duel') { %>
                                        <span class="bg-fuchsia-100 text-fuchsia-700 text-[10px] font-black px-2 py-0.5 rounded-full uppercase">⚔ Duel</span>
                                        <% } else { %>
                                        <span class="bg-sky-100 text-sky-700 text-[10px] font-black px-2 py-0.5 rounded-full uppercase">Solo</span>
                                        <% } %>
                                    </td>
                                    <td class="py-2 pr-4">
                                        <div class="flex items-center gap-2">
                                            <div class="w-20 bg-slate-100 rounded-full h-1.5">
                                                <div class="bg-gradient-to-r from-cyan-500 to-indigo-500 h-1.5 rounded-full"
                                                     style="width: <%= Math.min(100, (session.current_item_index / (session.total_items || 1)) * 100) %>%"></div>
                                            </div>
                                            <span class="text-xs text-slate-500">
                                                <%= session.current_item_index %>/<%= session.total_items || '?' %>
                                            </span>
                                        </div>
                                    </td>
                                    <td class="py-2 pr-4 font-black text-indigo-700">
                                        <%= session.accumulated_score %>
                                    </td>
                                    <td class="py-2 text-xs text-slate-400">
                                        <%= new Date(session.start_time).toLocaleTimeString('en-PH', {hour:'2-digit', minute:'2-digit'}) %>
                                    </td>
                                </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>
                    <% } %>
                </div>

                <!-- ══════════════════════════════════════════
                     ROW 4 — Assessment Chart + Top Students
                ══════════════════════════════════════════ -->
                <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mb-6">

                    <!-- Assessment Activity Chart (7 days) -->
                    <div class="xl:col-span-2 glass-card rounded-2xl p-5 border border-indigo-100">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                <i class="fas fa-chart-line text-indigo-500 mr-2"></i>Assessment Submissions
                            </h3>
                            <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Last 7 Days</span>
                        </div>
                        <div class="relative h-48">
                            <canvas id="submissionsChart"></canvas>
                        </div>
                        <!-- Type breakdown pills -->
                        <div class="flex flex-wrap gap-2 mt-3">
                            <% ['Pre-Test','Post-Test','Quiz','Competitive'].forEach((type, i) => { %>
                            <%
                                const colors = ['bg-cyan-100 text-cyan-700','bg-emerald-100 text-emerald-700','bg-amber-100 text-amber-700','bg-fuchsia-100 text-fuchsia-700'];
                                const counts = [chartData.preTestCount, chartData.postTestCount, chartData.quizCount, chartData.competitiveCount];
                            %>
                            <span class="<%= colors[i] %> text-[11px] font-bold px-3 py-1 rounded-full">
                                <%= type %>: <%= counts[i] %>
                            </span>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Top Students EXP Leaderboard -->
                    <div class="glass-card rounded-2xl p-5 border border-amber-100">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                <i class="fas fa-trophy text-amber-500 mr-2"></i>Top Students
                            </h3>
                            <a href="/admin/performance" class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline">All →</a>
                        </div>
                        <div class="space-y-2 table-scroll">
                            <% topStudents.forEach((student, index) => { %>
                            <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-amber-50/50 transition">
                                <span class="text-sm font-black w-5 text-center
                                    <%= index === 0 ? 'text-amber-500' : index === 1 ? 'text-slate-400' : index === 2 ? 'text-amber-700' : 'text-slate-300' %>">
                                    <%= index + 1 %>
                                </span>
                                <img src="/profile_uploads/<%= student.profile_pic || 'default_avatar.png' %>"
                                     class="w-8 h-8 rounded-lg object-cover border border-amber-200 flex-shrink-0">
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs font-bold text-indigo-900 truncate">
                                        <%= student.first_name %> <%= student.last_name %>
                                    </p>
                                    <p class="text-[10px] text-slate-400">Lvl <%= student.current_level %></p>
                                </div>
                                <div class="text-right flex-shrink-0">
                                    <p class="text-xs font-black text-amber-600"><%= student.total_exp.toLocaleString() %></p>
                                    <p class="text-[10px] text-slate-400">EXP</p>
                                </div>
                            </div>
                            <% }) %>
                            <% if (topStudents.length === 0) { %>
                            <p class="text-center text-slate-400 text-xs py-6">No student data yet.</p>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════
                     ROW 5 — Activity Logs + User Snapshot
                ══════════════════════════════════════════ -->
                <div class="grid grid-cols-1 xl:grid-cols-3 gap-6 mb-6 items-stretch">

                <!-- Recent Activity Logs (Takes 2/3 of space) -->
                <div class="xl:col-span-2 glass-card rounded-2xl p-5 border border-slate-200 flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                            <i class="fas fa-scroll text-slate-500 mr-2"></i>Recent Activity
                        </h3>
                        <a href="/admin/activity-logs" class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline">
                            Full Logs →
                        </a>
                    </div>
                    
                    <!-- Fixed height scroll area to prevent dead space -->
                    <div class="space-y-1 overflow-y-auto pr-2 custom-scrollbar flex-1" style="max-height: 450px;">
                        <% recentLogs.forEach(log => { %>
                            <% 
                                const roleColor = log.actor_role === 'Admin' ? 'bg-rose-100 text-rose-600' : 
                                                log.actor_role === 'Teacher' ? 'bg-blue-100 text-blue-600' : 
                                                'bg-emerald-100 text-emerald-600';
                            %>
                            <div class="flex items-center gap-4 p-3 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100">
                                <span class="<%= roleColor %> text-[9px] font-black px-2 py-1 rounded-md uppercase w-16 text-center flex-shrink-0">
                                    <%= log.actor_role %>
                                </span>
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs font-bold text-indigo-900 truncate">
                                        <%= log.actor_name || 'System' %> 
                                        <span class="font-normal text-slate-500 mx-1">/</span> 
                                        <span class="text-indigo-600"><%= log.action %></span>
                                    </p>
                                    <% if (log.description) { %>
                                        <p class="text-[10px] text-slate-400 truncate"><%= log.description %></p>
                                    <% } %>
                                </div>
                                <span class="text-[10px] text-slate-400 font-medium whitespace-nowrap bg-slate-100 px-2 py-1 rounded">
                                    <%= new Date(log.created_at).toLocaleString('en-PH', {month:'short', day:'numeric', hour:'2-digit', minute:'2-digit'}) %>
                                </span>
                            </div>
                        <% }) %>

                        <% if (recentLogs.length === 0) { %>
                            <div class="flex flex-col items-center justify-center h-full py-20 text-slate-400">
                                <i class="fas fa-inbox text-2xl mb-2 opacity-20"></i>
                                <p class="text-xs">No activity recorded yet.</p>
                            </div>
                        <% } %>
                    </div>
                </div>

                <!-- User Snapshot (Takes 1/3 of space) -->
                <div class="glass-card rounded-2xl p-5 border border-violet-100 flex flex-col">
                    <div class="flex items-center justify-between mb-4">
                        <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                            <i class="fas fa-users text-violet-500 mr-2"></i>User Snapshot
                        </h3>
                        <a href="/admin/user_access_control" class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline">
                            All →
                        </a>
                    </div>

                    <!-- Donut Chart Section -->
                    <div class="bg-slate-50/50 rounded-2xl p-4 mb-4 border border-slate-100">
                        <div class="relative h-32 mx-auto w-32 mb-4">
                            <canvas id="userDonutChart"></canvas>
                            <div class="absolute inset-0 flex flex-col items-center justify-center pointer-events-none">
                                <p class="text-xl font-black text-indigo-900">
                                    <%= stats.totalStudents + stats.totalTeachers + stats.totalAdmins %>
                                </p>
                                <p class="text-[9px] text-slate-400 font-bold uppercase">Total</p>
                            </div>
                        </div>
                        <div class="grid grid-cols-3 gap-2">
                            <div class="text-center border-r border-slate-200"><p class="text-xs font-black text-violet-600"><%= stats.totalStudents %></p><p class="text-[9px] text-slate-400 uppercase">Students</p></div>
                            <div class="text-center border-r border-slate-200"><p class="text-xs font-black text-cyan-600"><%= stats.totalTeachers %></p><p class="text-[9px] text-slate-400 uppercase">Teachers</p></div>
                            <div class="text-center"><p class="text-xs font-black text-rose-600"><%= stats.totalAdmins %></p><p class="text-[9px] text-slate-400 uppercase">Admins</p></div>
                        </div>
                    </div>

                    <!-- Pending invites (Compact) -->
                    <div class="bg-indigo-600 rounded-xl p-3 text-white flex items-center justify-between mb-4 shadow-sm shadow-indigo-200">
                        <div>
                            <p class="text-[10px] font-bold uppercase tracking-wider opacity-80">Pending Invites</p>
                            <p class="text-[9px] opacity-70">Awaiting registration</p>
                        </div>
                        <span class="text-2xl font-black"><%= stats.pendingInvites %></span>
                    </div>

                    <!-- Recent registrations (Scrollable to match height) -->
                    <div class="flex-1">
                        <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-3">Recent Joins</p>
                        <div class="space-y-3 overflow-y-auto pr-1" style="max-height: 140px;">
                            <% recentUsers.forEach(u => { %>
                                <div class="flex items-center gap-3 group">
                                    <img src="/profile_uploads/<%= u.profile_pic || 'default_avatar.png' %>"
                                        class="w-8 h-8 rounded-lg object-cover border border-violet-100 group-hover:border-violet-300 transition">
                                    <div class="flex-1 min-w-0">
                                        <p class="text-[11px] font-bold text-indigo-900 truncate leading-tight">
                                            <%= u.first_name %> <%= u.last_name %>
                                        </p>
                                        <p class="text-[9px] text-slate-400 font-medium"><%= u.role %></p>
                                    </div>
                                    <span class="text-[9px] font-bold text-slate-300">
                                        <%= new Date(u.created_at).toLocaleDateString('en-PH', {month:'short', day:'numeric'}) %>
                                    </span>
                                </div>
                            <% }) %>
                        </div>
                    </div>
                </div>
            </div>

                <!-- ══════════════════════════════════════════
                     ROW 6 — Upcoming Events + Forum + Duels
                ══════════════════════════════════════════ -->
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">

                    <!-- Upcoming Calendar Events -->
                    <div class="glass-card rounded-2xl p-5 border border-cyan-100">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                <i class="fas fa-calendar text-cyan-500 mr-2"></i>Upcoming Events
                            </h3>
                            <button onclick="openAllEventsModal()" class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline cursor-pointer bg-transparent border-0 p-0">All →</button>
                        </div>
                        <div class="space-y-2">
                            <% if (upcomingEvents.length === 0) { %>
                            <p class="text-xs text-slate-400 text-center py-4">No upcoming events.</p>
                            <% } %>
                            <% upcomingEvents.forEach(event => { %>
                            <%
                                const evtColor = {
                                    'Material' : 'bg-emerald-100 text-emerald-700',
                                    'Deadline' : 'bg-rose-100 text-rose-700',
                                    'Exam'     : 'bg-amber-100 text-amber-700',
                                    'Holiday'  : 'bg-sky-100 text-sky-700'
                                }[event.event_type] || 'bg-slate-100 text-slate-600';
                            %>
                            <div class="flex items-center gap-3 p-2.5 rounded-xl border border-slate-100 hover:bg-cyan-50/40 transition">
                                <span class="<%= evtColor %> text-[10px] font-black px-2 py-0.5 rounded-full uppercase flex-shrink-0">
                                    <%= event.event_type %>
                                </span>
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs font-bold text-indigo-900 truncate"><%= event.event_title %></p>
                                    <p class="text-[10px] text-slate-400 truncate"><%= event.subject_name || 'General' %></p>
                                </div>
                                <span class="text-[10px] text-slate-400 flex-shrink-0">
                                    <%= new Date(event.event_date).toLocaleDateString('en-PH', {month:'short', day:'numeric'}) %>
                                </span>
                            </div>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Forum Snapshot -->
                    <div class="glass-card rounded-2xl p-5 border border-orange-100">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                <i class="fas fa-comments text-orange-500 mr-2"></i>Forum Activity
                            </h3>
                            <a href="/admin/resources_engagement?tab=pillar2" class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline">All →</a>
                        </div>
                        <div class="grid grid-cols-2 gap-3 mb-4">
                            <div class="bg-orange-50 rounded-xl p-3 text-center border border-orange-100">
                                <p class="text-2xl font-black text-orange-700"><%= forumStats.totalTopics %></p>
                                <p class="text-[10px] text-slate-400 font-bold uppercase">Topics</p>
                            </div>
                            <div class="bg-amber-50 rounded-xl p-3 text-center border border-amber-100">
                                <p class="text-2xl font-black text-amber-700"><%= forumStats.totalReplies %></p>
                                <p class="text-[10px] text-slate-400 font-bold uppercase">Replies</p>
                            </div>
                        </div>
                        <% if (forumStats.latestReplies && forumStats.latestReplies.length > 0) { %>
                        <div class="space-y-2">
                            <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Latest Replies</p>
                            <% forumStats.latestReplies.forEach(reply => { %>
                            <div class="bg-slate-50 rounded-xl p-2.5 border border-slate-100">
                                <p class="text-[10px] font-black text-orange-600 truncate mb-0.5"><%= reply.forum_title %></p>
                                <p class="text-xs font-bold text-indigo-900 truncate"><%= reply.reply_content %></p>
                                <p class="text-[10px] text-slate-400 mt-0.5">
                                    by <%= reply.user_name %> ·
                                    <%= new Date(reply.created_at).toLocaleDateString('en-PH', {month:'short', day:'numeric'}) %>
                                </p>
                            </div>
                            <% }) %>
                        </div>
                        <% } %>
                    </div>

                    <!-- Competitive Match Summary -->
                    <div class="glass-card rounded-2xl p-5 border border-fuchsia-100">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                <i class="fas fa-swords text-fuchsia-500 mr-2"></i>Competitive Duels
                            </h3>
                            <a href="/admin/arcade" class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline">All →</a>
                        </div>
                        <div class="grid grid-cols-2 gap-3 mb-4">
                            <div class="bg-fuchsia-50 rounded-xl p-3 text-center border border-fuchsia-100">
                                <p class="text-2xl font-black text-fuchsia-700"><%= matchStats.totalMatches %></p>
                                <p class="text-[10px] text-slate-400 font-bold uppercase">All Time</p>
                            </div>
                            <div class="bg-indigo-50 rounded-xl p-3 text-center border border-indigo-100">
                                <p class="text-2xl font-black text-indigo-700"><%= matchStats.todayMatches %></p>
                                <p class="text-[10px] text-slate-400 font-bold uppercase">Today</p>
                            </div>
                        </div>
                        <% if (matchStats.topWinner) { %>
                        <div class="bg-gradient-to-r from-fuchsia-50 to-indigo-50 rounded-xl p-3 border border-fuchsia-100 flex items-center gap-3">
                            <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center">
                                <i class="fas fa-crown text-amber-500 text-sm"></i>
                            </div>
                            <div>
                                <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Top Winner</p>
                                <p class="text-xs font-bold text-indigo-900">
                                    <%= matchStats.topWinner.first_name %> <%= matchStats.topWinner.last_name %>
                                </p>
                                <p class="text-[10px] text-fuchsia-600"><%= matchStats.topWinner.win_count %> wins</p>
                            </div>
                        </div>
                        <% } %>
                    </div>
                </div>

                <div class="h-4"></div>
            </div><!-- end .p-4 -->

            <!-- FOOTER -->
            <footer class="bg-white border-t border-cyan-100 py-6 px-8 mt-auto w-full">
                <div class="flex flex-col md:flex-row justify-between items-center gap-2 max-w-[1600px] mx-auto">
                    <p class="text-[11px] text-indigo-400 font-black uppercase tracking-tight">
                        &copy; 2026 <span class="text-cyan-600">Chemistry Arcade</span> — Mabini College v2.5.0
                    </p>
                    <div class="flex gap-4">
                        <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest">Support Lab</a>
                        <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest border-l pl-4 border-indigo-100">Atomic Logs</a>
                    </div>
                </div>
            </footer>
        </div><!-- end overflow-y-auto -->
    </main>
</div><!-- end flex wrapper -->

<!-- ══════════════════════════════════════════
     ALL UPCOMING EVENTS MODAL
══════════════════════════════════════════ -->
<div id="allEventsModal" class="fixed inset-0 z-50 flex items-center justify-center p-4 hidden">
    <div class="absolute inset-0 bg-black/50 backdrop-blur-sm" onclick="closeAllEventsModal()"></div>
    <div class="relative bg-white rounded-2xl shadow-2xl w-full max-w-2xl max-h-[85vh] flex flex-col z-10">
        <!-- Modal Header -->
        <div class="flex items-center justify-between p-5 border-b border-slate-100 flex-shrink-0">
            <h3 class="font-black text-indigo-900 text-base flex items-center gap-2">
                <i class="fas fa-calendar text-cyan-500"></i>
                All Upcoming Events
                <span id="allEventsCount" class="bg-cyan-100 text-cyan-700 text-xs font-black px-2 py-0.5 rounded-full"></span>
            </h3>
            <button onclick="closeAllEventsModal()" class="w-8 h-8 rounded-lg bg-slate-100 hover:bg-slate-200 flex items-center justify-center transition">
                <i class="fas fa-times text-slate-500 text-sm"></i>
            </button>
        </div>
        <!-- Modal Body -->
        <div class="overflow-y-auto flex-1 p-5 space-y-3">
            <% if (typeof allUpcomingEvents !== 'undefined' && allUpcomingEvents.length > 0) { %>
            <% allUpcomingEvents.forEach(event => { %>
            <%
                const mEvtColor = {
                    'Material' : 'bg-emerald-100 text-emerald-700 border-emerald-200',
                    'Deadline' : 'bg-rose-100 text-rose-700 border-rose-200',
                    'Exam'     : 'bg-amber-100 text-amber-700 border-amber-200',
                    'Holiday'  : 'bg-sky-100 text-sky-700 border-sky-200'
                }[event.event_type] || 'bg-slate-100 text-slate-600 border-slate-200';
            %>
            <div class="rounded-xl border border-slate-100 p-4 hover:bg-slate-50 transition">
                <div class="flex items-start gap-3">
                    <span class="<%= mEvtColor %> text-[10px] font-black px-2 py-0.5 rounded-full uppercase flex-shrink-0 border mt-0.5">
                        <%= event.event_type %>
                    </span>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-bold text-indigo-900"><%= event.event_title %></p>
                        <p class="text-[11px] text-slate-500 mt-0.5">
                            <i class="fas fa-book-open mr-1"></i><%= event.subject_name || 'General' %>
                        </p>
                        <% if (event.event_description) { %>
                        <p class="text-xs text-slate-400 mt-1"><%= event.event_description %></p>
                        <% } %>
                        <div class="flex flex-wrap gap-3 mt-2">
                            <span class="text-[11px] text-slate-500 flex items-center gap-1">
                                <i class="fas fa-calendar-day text-cyan-400"></i>
                                <%= new Date(event.event_date).toLocaleDateString('en-PH', {year:'numeric', month:'long', day:'numeric'}) %>
                            </span>
                            <% if (event.event_location && event.event_location !== 'TBA') { %>
                            <span class="text-[11px] text-slate-500 flex items-center gap-1">
                                <i class="fas fa-location-dot text-rose-400"></i>
                                <%= event.event_location %>
                            </span>
                            <% } %>
                            <% if (event.duration_type === 'Minutes' && event.duration_minutes) { %>
                            <span class="text-[11px] text-slate-500 flex items-center gap-1">
                                <i class="fas fa-clock text-amber-400"></i>
                                <%= event.duration_minutes %> min
                            </span>
                            <% } %>
                            <% if (event.duration_type === 'DateRange' && event.start_date && event.end_date) { %>
                            <span class="text-[11px] text-slate-500 flex items-center gap-1">
                                <i class="fas fa-clock text-amber-400"></i>
                                <%= new Date(event.start_date).toLocaleDateString('en-PH', {month:'short', day:'numeric'}) %> –
                                <%= new Date(event.end_date).toLocaleDateString('en-PH', {month:'short', day:'numeric'}) %>
                            </span>
                            <% } %>
                            <% if (event.is_repeatable && event.repeat_cycle !== 'None') { %>
                            <span class="text-[11px] text-indigo-500 flex items-center gap-1">
                                <i class="fas fa-rotate"></i>
                                Repeats <%= event.repeat_cycle %>
                            </span>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
            <% }) %>
            <% } else { %>
            <div class="text-center py-12">
                <i class="fas fa-calendar-check text-3xl text-slate-200 mb-3"></i>
                <p class="text-sm text-slate-400">No upcoming events scheduled.</p>
            </div>
            <% } %>
        </div>
    </div>
</div>

<!-- ===================== SCRIPTS ===================== -->
<script>
    // Sidebar toggle
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.toggle('-translate-x-full');
        overlay.classList.toggle('hidden');
    }

    // ── Assessment Submissions Chart (7 days) ──
    const submissionsCtx = document.getElementById('submissionsChart').getContext('2d');
    new Chart(submissionsCtx, {
        type: 'bar',
        data: {
            labels: <%- JSON.stringify(chartData.labels) %>,
            datasets: [
                {
                    label: 'Submissions',
                    data: <%- JSON.stringify(chartData.counts) %>,
                    backgroundColor: 'rgba(99,102,241,0.15)',
                    borderColor: '#6366f1',
                    borderWidth: 2,
                    borderRadius: 8,
                    hoverBackgroundColor: 'rgba(99,102,241,0.30)',
                }
            ]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#1e1b4b',
                    titleColor: '#c7d2fe',
                    bodyColor: '#e0e7ff',
                    cornerRadius: 10,
                    padding: 10,
                    callbacks: {
                        title: (items) => items[0].label,
                        label: (item) => ` ${item.raw} submission${item.raw !== 1 ? 's' : ''}`
                    }
                }
            },
            scales: {
                x: {
                    grid: { display: false },
                    ticks: { font: { family: 'Plus Jakarta Sans', weight: '700', size: 10 }, color: '#94a3b8' }
                },
                y: {
                    beginAtZero: true,
                    grid: { color: 'rgba(0,0,0,0.04)' },
                    ticks: {
                        font: { family: 'Plus Jakarta Sans', size: 10 }, color: '#94a3b8',
                        stepSize: 1,
                        callback: (v) => Number.isInteger(v) ? v : ''
                    }
                }
            }
        }
    });

    // ── User Donut Chart ──
    const donutCtx = document.getElementById('userDonutChart').getContext('2d');
    new Chart(donutCtx, {
        type: 'doughnut',
        data: {
            labels: ['Students', 'Teachers', 'Admins'],
            datasets: [{
                data: [<%= stats.totalStudents %>, <%= stats.totalTeachers %>, <%= stats.totalAdmins %>],
                backgroundColor: ['#8b5cf6','#06b6d4','#f43f5e'],
                borderWidth: 0,
                hoverOffset: 4
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            cutout: '72%',
            plugins: {
                legend: { display: false },
                tooltip: {
                    backgroundColor: '#1e1b4b',
                    titleColor: '#c7d2fe',
                    bodyColor: '#e0e7ff',
                    cornerRadius: 10,
                    padding: 10
                }
            }
        }
    });

    // ── All Events Modal ──
    function openAllEventsModal() {
        const modal = document.getElementById('allEventsModal');
        const count = document.getElementById('allEventsCount');
        if (count) count.textContent = '<%= typeof allUpcomingEvents !== "undefined" ? allUpcomingEvents.length : 0 %> events';
        modal.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
    }
    function closeAllEventsModal() {
        document.getElementById('allEventsModal').classList.add('hidden');
        document.body.style.overflow = '';
    }
    // Close modal on Escape key
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') closeAllEventsModal();
    });
</script>
<!-- ═══════════════════════════════════════════════════════
     NOTIFICATION PANEL — Reusable across all admin pages
     Fetches from GET /admin/notifications on open.
═══════════════════════════════════════════════════════ -->

<!-- Backdrop -->
<div id="notifBackdrop" class="fixed inset-0 z-[998] hidden" onclick="closeNotifPanel()"></div>

<!-- Slide-in Panel -->
<div id="notifPanel"
     class="fixed top-0 right-0 h-full w-full max-w-sm z-[999] flex flex-col
            bg-white border-l border-cyan-100 shadow-2xl
            transform translate-x-full transition-transform duration-300 ease-in-out">

    <!-- Panel Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-cyan-100 bg-gradient-to-r from-indigo-950 to-indigo-900 flex-shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center">
                <i class="fas fa-bell text-cyan-400"></i>
            </div>
            <div>
                <p class="text-sm font-black text-white tracking-tight">Notifications</p>
                <p class="text-[10px] text-indigo-400 font-semibold" id="notifSubtitle">Loading…</p>
            </div>
        </div>
        <button onclick="closeNotifPanel()" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition">
            <i class="fas fa-times text-sm"></i>
        </button>
    </div>

    <!-- Category Tabs -->
    <div class="flex gap-0 border-b border-cyan-100 overflow-x-auto flex-shrink-0 bg-slate-50" id="notifTabs">
        <button class="notif-tab active px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-cyan-500 text-cyan-600 transition" data-tab="all">All</button>
        <button class="notif-tab px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition" data-tab="alerts">Alerts</button>
        <button class="notif-tab px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition" data-tab="activity">Activity</button>
        <button class="notif-tab px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition" data-tab="live">Live</button>
    </div>

    <!-- Scrollable Body -->
    <div id="notifBody" class="flex-1 overflow-y-auto p-4 space-y-3" style="scrollbar-width:thin;scrollbar-color:#e2e8f0 transparent;">
        <!-- Skeleton loader -->
        <div id="notifSkeleton" class="space-y-3">
            <% for(let i=0;i<5;i++) { %>
            <div class="animate-pulse flex gap-3 items-start">
                <div class="w-8 h-8 rounded-lg bg-slate-200 flex-shrink-0"></div>
                <div class="flex-1 space-y-1.5">
                    <div class="h-3 bg-slate-200 rounded w-3/4"></div>
                    <div class="h-2.5 bg-slate-100 rounded w-1/2"></div>
                </div>
            </div>
            <% } %>
        </div>
        <!-- Actual content injected by JS -->
        <div id="notifContent" class="hidden space-y-3"></div>
    </div>

    <!-- Panel Footer -->
    <div class="px-5 py-3 border-t border-cyan-100 bg-slate-50 flex items-center justify-between flex-shrink-0">
        <p class="text-[10px] text-slate-400 font-semibold">Auto-refreshes every 60s</p>
        <button onclick="loadNotifications()" class="text-[11px] font-black text-cyan-600 hover:text-cyan-800 flex items-center gap-1 transition">
            <i class="fas fa-rotate-right text-[10px]"></i> Refresh
        </button>
    </div>
</div>

<style>
    .notif-tab.active { border-bottom-color: #06b6d4 !important; color: #0891b2 !important; }
    .notif-item { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 10px 12px; display: flex; gap: 10px; align-items: flex-start; transition: border-color 0.15s, box-shadow 0.15s; }
    .notif-item:hover { border-color: #06b6d4; box-shadow: 0 4px 12px rgba(6,182,212,0.08); }
    .notif-icon { width: 32px; height: 32px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 13px; }
    .notif-title { font-size: 12px; font-weight: 700; color: #1e293b; line-height: 1.35; }
    .notif-sub { font-size: 10.5px; color: #64748b; margin-top: 1px; }
    .notif-time { font-size: 10px; color: #94a3b8; white-space: nowrap; margin-left: auto; padding-left: 6px; flex-shrink: 0; }
    .notif-section-label { font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: .07em; color: #94a3b8; padding: 4px 0 6px; }
    .notif-link { font-size: 10.5px; color: #06b6d4; font-weight: 700; text-decoration: none; cursor: pointer; }
    .notif-link:hover { color: #0891b2; }
</style>

<script>
(function() {
    let _notifData   = null;
    let _activeTab   = 'all';
    let _refreshTimer = null;

    function timeAgo(dateStr) {
        if (!dateStr) return '';
        const diff = (Date.now() - new Date(dateStr)) / 1000;
        if (diff < 60)   return 'just now';
        if (diff < 3600) return Math.floor(diff/60) + 'm ago';
        if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
        return Math.floor(diff/86400) + 'd ago';
    }

    function fmtDate(dateStr) {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' });
    }

    window.toggleNotifPanel = function() {
        const panel    = document.getElementById('notifPanel');
        const backdrop = document.getElementById('notifBackdrop');
        const isOpen   = !panel.classList.contains('translate-x-full');
        if (isOpen) { closeNotifPanel(); return; }
        panel.classList.remove('translate-x-full');
        backdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        loadNotifications();
        _refreshTimer = setInterval(loadNotifications, 60000);
    };

    window.closeNotifPanel = function() {
        document.getElementById('notifPanel').classList.add('translate-x-full');
        document.getElementById('notifBackdrop').classList.add('hidden');
        document.body.style.overflow = '';
        clearInterval(_refreshTimer);
    };

    window.loadNotifications = async function() {
        document.getElementById('notifSkeleton').classList.remove('hidden');
        document.getElementById('notifContent').classList.add('hidden');
        try {
            const res  = await fetch('/admin/notifications');
            const data = await res.json();
            if (!data.success) throw new Error(data.message);
            _notifData = data;
            updateBell(data.total);
            renderTab(_activeTab);
        } catch(e) {
            document.getElementById('notifContent').innerHTML =
                '<div class="py-10 text-center text-slate-400 text-xs">Failed to load notifications.</div>';
            document.getElementById('notifContent').classList.remove('hidden');
            document.getElementById('notifSkeleton').classList.add('hidden');
        }
    };

    function updateBell(count) {
        const dot   = document.getElementById('notifDot');
        const badge = document.getElementById('notifCount');
        if (count > 0) {
            dot.classList.remove('hidden');
            badge.textContent = count > 9 ? '9+' : count;
            badge.classList.remove('hidden');
        } else {
            dot.classList.add('hidden');
            badge.classList.add('hidden');
        }
        document.getElementById('notifSubtitle').textContent =
            count > 0 ? count + ' item' + (count !== 1 ? 's' : '') + ' need attention' : 'All clear';
    }

    function renderTab(tab) {
        _activeTab = tab;
        const d = _notifData;
        if (!d) return;

        let html = '';

        // ── ALL tab ──
        if (tab === 'all' || tab === 'alerts') {
            const alertItems = [
                ...d.expiredInvites.map(i => ({
                    icon: 'fas fa-envelope-circle-check', iconBg: 'bg-rose-50', iconColor: 'text-rose-500',
                    title: 'Expired Invitation',
                    sub: i.email + ' · ' + (i.role || 'Unknown role'),
                    time: fmtDate(i.expires_at),
                    link: '/admin/user_access_control', linkLabel: 'View UAC'
                })),
                ...d.flaggedStudents.map(s => ({
                    icon: 'fas fa-flag', iconBg: 'bg-amber-50', iconColor: 'text-amber-500',
                    title: 'Flagged Student',
                    sub: s.full_name + (s.assessment_name ? ' · ' + s.assessment_name : ''),
                    time: '',
                    link: '/admin/user_access_control', linkLabel: 'View Student'
                })),
                ...d.lockedPastDue.map(a => ({
                    icon: 'fas fa-lock', iconBg: 'bg-orange-50', iconColor: 'text-orange-500',
                    title: 'Assessment Past Due & Locked',
                    sub: a.assessment_name + ' · ' + (a.subject_name || ''),
                    time: fmtDate(a.due_date),
                    link: '/admin/gaming_question_bank', linkLabel: 'Manage'
                })),
                ...d.overdueDeadlines.map(e => ({
                    icon: 'fas fa-calendar-xmark', iconBg: 'bg-red-50', iconColor: 'text-red-500',
                    title: 'Overdue Deadline',
                    sub: e.event_title + (e.subject_name ? ' · ' + e.subject_name : ''),
                    time: fmtDate(e.event_date),
                    link: '/admin/academic_management', linkLabel: 'View'
                })),
                ...d.pendingQuestions.map(q => ({
                    icon: 'fas fa-robot', iconBg: 'bg-indigo-50', iconColor: 'text-indigo-500',
                    title: 'AI Question Awaiting Approval',
                    sub: q.question_text.substring(0, 55) + (q.question_text.length > 55 ? '…' : ''),
                    time: '#' + q.question_id,
                    link: '/admin/gaming_question_bank', linkLabel: 'Review'
                })),
            ];

            if (tab === 'alerts' || tab === 'all') {
                if (alertItems.length === 0) {
                    if (tab === 'alerts') html += emptyState('fa-shield-halved', 'No alerts', 'Everything looks good!');
                } else {
                    if (tab === 'all') html += '<div class="notif-section-label"><i class="fas fa-triangle-exclamation mr-1 text-rose-400"></i>Alerts Requiring Action</div>';
                    alertItems.forEach(item => { html += notifItem(item); });
                }
            }
        }

        // ── ACTIVITY tab (pending & new users) ──
        if (tab === 'activity' || tab === 'all') {
            const actItems = [
                ...d.pendingInvites.map(i => ({
                    icon: 'fas fa-paper-plane', iconBg: 'bg-cyan-50', iconColor: 'text-cyan-500',
                    title: 'Pending Invitation',
                    sub: i.email + ' · ' + (i.role || ''),
                    time: timeAgo(i.created_at),
                    link: '/admin/user_access_control', linkLabel: 'View'
                })),
                ...d.newUsers.map(u => ({
                    icon: 'fas fa-user-plus', iconBg: 'bg-emerald-50', iconColor: 'text-emerald-500',
                    title: 'New ' + u.role + ' Registered',
                    sub: u.full_name,
                    time: timeAgo(u.created_at),
                    link: '/admin/user_access_control', linkLabel: 'View Profile'
                })),
            ];

            if (tab === 'activity') {
                if (actItems.length === 0) html += emptyState('fa-clock-rotate-left', 'No recent activity', 'No new users or pending invites.');
                else actItems.forEach(item => { html += notifItem(item); });
            } else if (tab === 'all' && actItems.length > 0) {
                html += '<div class="notif-section-label mt-2"><i class="fas fa-bolt mr-1 text-cyan-400"></i>Recent Activity</div>';
                actItems.forEach(item => { html += notifItem(item); });
            }
        }

        // ── LIVE tab (active sessions) ──
        if (tab === 'live' || tab === 'all') {
            if (tab === 'live') {
                if (d.activeSessions.length === 0) {
                    html += emptyState('fa-gamepad', 'No live sessions', 'No students are playing right now.');
                } else {
                    d.activeSessions.forEach(s => {
                        html += notifItem({
                            icon: 'fas fa-gamepad', iconBg: 'bg-violet-50', iconColor: 'text-violet-500',
                            title: s.student_name + ' is playing',
                            sub: s.assessment_name + ' · ' + s.player_mode,
                            time: timeAgo(s.start_time),
                            link: null
                        });
                    });
                }
            } else if (tab === 'all' && d.activeSessions.length > 0) {
                html += '<div class="notif-section-label mt-2"><i class="fas fa-circle text-green-400 mr-1"></i>Live Sessions (' + d.activeSessions.length + ')</div>';
                d.activeSessions.slice(0, 3).forEach(s => {
                    html += notifItem({
                        icon: 'fas fa-gamepad', iconBg: 'bg-violet-50', iconColor: 'text-violet-500',
                        title: s.student_name + ' is playing',
                        sub: s.assessment_name + ' · ' + s.player_mode,
                        time: timeAgo(s.start_time),
                        link: null
                    });
                });
            }
        }

        if (tab === 'all' && html === '') {
            html = emptyState('fa-bell-slash', 'All clear!', 'No alerts or pending items.');
        }

        document.getElementById('notifContent').innerHTML = html;
        document.getElementById('notifContent').classList.remove('hidden');
        document.getElementById('notifSkeleton').classList.add('hidden');
    }

    function notifItem(item) {
        return '<div class="notif-item">' +
            '<div class="notif-icon ' + item.iconBg + ' ' + item.iconColor + '">' +
                '<i class="' + item.icon + '"></i>' +
            '</div>' +
            '<div class="flex-1 min-w-0">' +
                '<p class="notif-title">' + item.title + '</p>' +
                '<p class="notif-sub truncate">' + item.sub + '</p>' +
                (item.link ? '<a href="' + item.link + '" class="notif-link">' + item.linkLabel + ' →</a>' : '') +
            '</div>' +
            (item.time ? '<span class="notif-time">' + item.time + '</span>' : '') +
        '</div>';
    }

    function emptyState(icon, title, sub) {
        return '<div class="py-10 text-center">' +
            '<i class="fas ' + icon + ' text-3xl text-slate-200 mb-3 block"></i>' +
            '<p class="text-sm font-bold text-slate-400">' + title + '</p>' +
            '<p class="text-xs text-slate-300 mt-1">' + sub + '</p>' +
        '</div>';
    }

    // Tab switching
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.notif-tab').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.notif-tab').forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                renderTab(btn.dataset.tab);
            });
        });

        // Auto-poll bell count every 2 minutes even when panel is closed
        setInterval(async function() {
            try {
                const res  = await fetch('/admin/notifications');
                const data = await res.json();
                if (data.success) updateBell(data.total);
            } catch(_) {}
        }, 120000);
    });
})();
</script>

</body>
</html>
