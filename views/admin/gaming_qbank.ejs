                <div><label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Type *</label><select id="editAsmType" class="fi text-sm"><option value="Pre-Test">Pre-Test</option><option value="Post-Test">Post-Test</option><option value="Quiz">Quiz</option><option value="Competitive">Competitive</option></select></div>
