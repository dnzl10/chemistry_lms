let currentSteps = [];

function onStationChanged() {
    // Allows user to click 'Auto-Load Station Blueprint' if desired
}

function loadStationPreset() {
    const lvl = parseInt(document.getElementById('formLevel').value, 10) || 1;
    const preset = STATION_BLUEPRINTS[lvl] || STATION_BLUEPRINTS[1];
    document.getElementById('formPrompt').value = preset.prompt;
    currentSteps = JSON.parse(JSON.stringify(preset.steps));
    renderStepCards();
    recompileSummary();
    showToast(`Loaded Blueprint for Station ${lvl}`, 'info');
}

function addStep(type) {
    if (type === 'element') {
        currentSteps.push({
            type: 'pick_seq',
            label: 'Load reagents',
            answer: ['Na', 'Cl']
        });
    } else if (type === 'dial') {
        currentSteps.push({
            type: 'dial',
            label: 'Volume',
            target: 100.0,
            unit: ' mL',
            min: 0.0,
            max: 600.0,
            step: 10.0,
            tolerance: 0.0
        });
    } else if (type === 'choice') {
        currentSteps.push({
            type: 'choice',
            label: 'Select target substance/option',
            options: ['Option A', 'Option B', 'Option C'],
            answer: 'Option A'
        });
    }
    renderStepCards();
    recompileSummary();
}

function removeStep(idx) {
    currentSteps.splice(idx, 1);
    renderStepCards();
    recompileSummary();
}

function updateStepProp(idx, prop, val) {
    if (!currentSteps[idx]) return;
    currentSteps[idx][prop] = val;
    recompileSummary();
}

function handleChipInput(e, stepIdx) {
    if (e.key === 'Enter' || e.key === ',') {
        e.preventDefault();
        const symbol = e.target.value.trim();
        if (!symbol) return;
        const norm = symbol.charAt(0).toUpperCase() + symbol.slice(1).toLowerCase();
        if (!Array.isArray(currentSteps[stepIdx].answer)) {
            currentSteps[stepIdx].answer = [];
        }
        currentSteps[stepIdx].answer.push(norm);
        e.target.value = '';
        renderStepCards();
        recompileSummary();
    }
}

function removeElementChip(stepIdx, elIdx) {
    if (currentSteps[stepIdx] && Array.isArray(currentSteps[stepIdx].answer)) {
        currentSteps[stepIdx].answer.splice(elIdx, 1);
        renderStepCards();
        recompileSummary();
    }
}

function updateChoiceOption(stepIdx, optIdx, val) {
    if (currentSteps[stepIdx] && currentSteps[stepIdx].options) {
        const wasAns = (currentSteps[stepIdx].answer === currentSteps[stepIdx].options[optIdx]);
        currentSteps[stepIdx].options[optIdx] = val;
        if (wasAns) currentSteps[stepIdx].answer = val;
        recompileSummary();
    }
}

function addChoiceOption(stepIdx) {
    if (currentSteps[stepIdx]) {
        if (!currentSteps[stepIdx].options) currentSteps[stepIdx].options = [];
        currentSteps[stepIdx].options.push('New Choice');
        renderStepCards();
        recompileSummary();
    }
}

function removeChoiceOption(stepIdx, optIdx) {
    if (currentSteps[stepIdx] && currentSteps[stepIdx].options) {
        currentSteps[stepIdx].options.splice(optIdx, 1);
        renderStepCards();
        recompileSummary();
    }
}

function recompileSummary() {
    const parts = [];
    let summaryText = `${currentSteps.length} step${currentSteps.length === 1 ? '' : 's'}`;

    currentSteps.forEach(s => {
        if (s.type === 'pick_seq' || s.type === 'pick_set') {
            const arr = Array.isArray(s.answer) ? s.answer : [s.answer];
            if (arr.length > 0) parts.push(arr.join('+'));
        } else if (s.type === 'dial') {
            parts.push(`@ ${s.target}${s.unit || ''}`);
        } else if (s.type === 'choice') {
            if (s.answer) parts.push(`-> ${s.answer}`);
        }
    });

    const compiledAnswer = parts.join(' ').trim() || '(Configure steps above)';
    const ansEl = document.getElementById('previewAnswerText');
    const sumEl = document.getElementById('previewStepsSummary');
    if (ansEl) ansEl.textContent = compiledAnswer;
    if (sumEl) sumEl.textContent = summaryText;

    const formAns = document.getElementById('formAnswerText');
    const formSteps = document.getElementById('formStepsJson');
    if (formAns) formAns.value = compiledAnswer;
    if (formSteps) formSteps.value = JSON.stringify(currentSteps);
}

function renderStepCards() {
    const container = document.getElementById('stepCardsContainer');
    if (!container) return;
    if (currentSteps.length === 0) {
        container.innerHTML = `
            <div class="p-6 bg-slate-50 border border-dashed border-slate-200 rounded-2xl text-center text-slate-400 text-xs">
                <i class="fas fa-microscope text-2xl mb-1.5 block text-slate-300"></i>
                No laboratory steps configured. Click <strong>+ Element Slots</strong>, <strong>+ Measurement Dial</strong>, or <strong>Auto-Load Station Blueprint</strong> above.
            </div>
        `;
        return;
    }

    container.innerHTML = currentSteps.map((step, idx) => {
        const stepNum = idx + 1;
        if (step.type === 'pick_seq' || step.type === 'pick_set') {
            const isSeq = step.type === 'pick_seq';
            const elements = Array.isArray(step.answer) ? step.answer : (step.answer ? [step.answer] : []);
            const chipsHtml = elements.map((el, elIdx) => `
                <span class="el-chip">
                    <span>${el}</span>
                    <i class="fas fa-times btn-del-chip" onclick="removeElementChip(${idx}, ${elIdx})"></i>
                </span>
            `).join('');
            const slotBoxesHtml = elements.map(el => `[  ${el}  ]`).join('   ');

            return `
            <div class="bg-white p-4 rounded-2xl border border-cyan-200 shadow-xs space-y-3">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 rounded-lg bg-cyan-100 text-cyan-800 text-xs font-black flex items-center justify-center">${stepNum}</span>
                        <span class="text-xs font-black uppercase tracking-wider text-slate-700">Element Reagent Slots</span>
                        <span class="text-[10px] px-2 py-0.5 rounded-full font-bold ${isSeq ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-100 text-emerald-700'}">
                            ${isSeq ? 'Strict Sequence' : 'Any Order (Set)'}
                        </span>
                    </div>
                    <button type="button" onclick="removeStep(${idx})" class="text-slate-300 hover:text-rose-500 text-xs cursor-pointer">
                        <i class="fas fa-trash-can"></i>
                    </button>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Step Label / Action</label>
                        <input type="text" value="${step.label || 'Load reagents'}" oninput="updateStepProp(${idx}, 'label', this.value)" class="fi text-xs">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Input Order Rule</label>
                        <select onchange="updateStepProp(${idx}, 'type', this.value)" class="fi text-xs font-bold">
                            <option value="pick_seq" ${isSeq ? 'selected' : ''}>Sequential (Order Matters)</option>
                            <option value="pick_set" ${!isSeq ? 'selected' : ''}>Unordered (Any Order)</option>
                        </select>
                    </div>
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">
                        Target Element Formula (Type symbol & press Enter):
                    </label>
                    <div class="flex items-center gap-2 flex-wrap p-2 rounded-xl border border-slate-200 bg-slate-50 min-h-[44px]">
                        ${chipsHtml}
                        <input type="text" placeholder="+ Add Element (e.g. Na)" onkeydown="handleChipInput(event, ${idx})" class="text-xs font-mono font-bold bg-transparent outline-none text-cyan-900 w-32 px-1">
                    </div>
                </div>
                <div class="p-3 bg-slate-900 rounded-xl text-white font-mono text-xs flex items-center justify-between flex-wrap gap-2">
                    <span class="text-slate-400 text-[11px]">In-Game Arcade Display:</span>
                    <div class="text-cyan-400 font-extrabold tracking-widest">
                        SLOTS:   ${slotBoxesHtml || '[  ___  ]'}
                    </div>
                </div>
            </div>`;
        } else if (step.type === 'dial') {
            return `
            <div class="bg-white p-4 rounded-2xl border border-indigo-200 shadow-xs space-y-3">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-800 text-xs font-black flex items-center justify-center">${stepNum}</span>
                        <span class="text-xs font-black uppercase tracking-wider text-slate-700">Measurement Dial / Rotary Gauge</span>
                    </div>
                    <button type="button" onclick="removeStep(${idx})" class="text-slate-300 hover:text-rose-500 text-xs cursor-pointer">
                        <i class="fas fa-trash-can"></i>
                    </button>
                </div>
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                    <div class="col-span-2 sm:col-span-2">
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Parameter Label</label>
                        <input type="text" value="${step.label || 'Volume'}" oninput="updateStepProp(${idx}, 'label', this.value)" class="fi text-xs">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Target Reading</label>
                        <input type="number" step="any" value="${step.target || 100}" oninput="updateStepProp(${idx}, 'target', parseFloat(this.value)||0)" class="fi text-xs font-bold text-indigo-700">
                    </div>
                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Unit</label>
                        <input type="text" value="${step.unit || ' mL'}" oninput="updateStepProp(${idx}, 'unit', this.value)" class="fi text-xs font-mono">
                    </div>
                </div>
                <div class="grid grid-cols-3 gap-3 text-xs">
                    <div>
                        <label class="block text-[10px] text-slate-400 font-bold mb-1">Min Value</label>
                        <input type="number" value="${step.min || 0}" oninput="updateStepProp(${idx}, 'min', parseFloat(this.value)||0)" class="fi text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] text-slate-400 font-bold mb-1">Max Value</label>
                        <input type="number" value="${step.max || 600}" oninput="updateStepProp(${idx}, 'max', parseFloat(this.value)||0)" class="fi text-xs">
                    </div>
                    <div>
                        <label class="block text-[10px] text-slate-400 font-bold mb-1">Step Increments</label>
                        <input type="number" value="${step.step || 10}" oninput="updateStepProp(${idx}, 'step', parseFloat(this.value)||1)" class="fi text-xs">
                    </div>
                </div>
            </div>`;
        } else if (step.type === 'choice') {
            const options = Array.isArray(step.options) ? step.options : ['Option A', 'Option B'];
            const optsHtml = options.map((opt, optIdx) => `
                <div class="flex items-center gap-2">
                    <input type="radio" name="choice_ans_${idx}" ${step.answer === opt ? 'checked' : ''} onchange="updateStepProp(${idx}, 'answer', '${opt.replace(/'/g, "\\'")}')" class="text-cyan-600 cursor-pointer">
                    <input type="text" value="${opt}" oninput="updateChoiceOption(${idx}, ${optIdx}, this.value)" class="fi flex-1 text-xs">
                    <button type="button" onclick="removeChoiceOption(${idx}, ${optIdx})" class="text-slate-300 hover:text-rose-500 text-xs cursor-pointer"><i class="fas fa-times"></i></button>
                </div>
            `).join('');

            return `
            <div class="bg-white p-4 rounded-2xl border border-purple-200 shadow-xs space-y-3">
                <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 rounded-lg bg-purple-100 text-purple-800 text-xs font-black flex items-center justify-center">${stepNum}</span>
                        <span class="text-xs font-black uppercase tracking-wider text-slate-700">Multiple Choice Selection</span>
                    </div>
                    <button type="button" onclick="removeStep(${idx})" class="text-slate-300 hover:text-rose-500 text-xs cursor-pointer">
                        <i class="fas fa-trash-can"></i>
                    </button>
                </div>
                <div>
                    <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Prompt / Selection Label</label>
                    <input type="text" value="${step.label || 'Select option'}" oninput="updateStepProp(${idx}, 'label', this.value)" class="fi text-xs">
                </div>
                <div class="space-y-2">
                    <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Choices (Select radio for correct in-game answer):</label>
                    ${optsHtml}
                    <button type="button" onclick="addChoiceOption(${idx})" class="text-[11px] text-cyan-600 hover:text-cyan-800 font-bold mt-1 cursor-pointer">
                        + Add Another Option
                    </button>
                </div>
            </div>`;
        }
    }).join('');
}

function openAuthorModal(q) {
    if (q) {
        document.getElementById('authorModalTitle').textContent = `Edit Arcade Challenge #${q.question_code || ('Q' + q.question_id)}`;
        document.getElementById('formQid').value = q.question_id;
        document.getElementById('formLevel').value = q.level_number || 1;
        document.getElementById('formPrompt').value = q.prompt || '';
        document.getElementById('formDifficulty').value = q.difficulty || 'Average';
        document.getElementById('formPoints').value = q.points || 1;
        document.getElementById('formTimeLimit').value = q.time_limit_s || 90;
        document.getElementById('formTeacherId').value = q.teacher_id || '';
        document.getElementById('btnSubmitAuthor').innerHTML = '<i class="fas fa-check-circle mr-1.5"></i> Save &amp; Authorize Challenge';

        try {
            currentSteps = typeof q.steps_json === 'string' ? JSON.parse(q.steps_json) : (q.steps_json || []);
        } catch (e) {
            currentSteps = [{ type: 'pick_seq', label: 'Load reagents', answer: [(q.answer_text || 'Na')] }];
        }
        if (!Array.isArray(currentSteps) || currentSteps.length === 0) {
            currentSteps = [{ type: 'pick_seq', label: 'Load reagents', answer: [(q.answer_text || 'Na')] }];
        }
        renderStepCards();
        recompileSummary();
    } else {
        document.getElementById('authorModalTitle').textContent = 'Author Arcade Lab Challenge';
        document.getElementById('formQid').value = '';
        document.getElementById('formPrompt').value = '';
        document.getElementById('formDifficulty').value = 'Average';
        document.getElementById('formPoints').value = 1;
        document.getElementById('formTimeLimit').value = 90;
        document.getElementById('formTeacherId').value = '';
        document.getElementById('btnSubmitAuthor').innerHTML = '<i class="fas fa-check-circle mr-1.5"></i> Save &amp; Authorize Challenge';
        document.getElementById('formLevel').value = 1;
        loadStationPreset();
    }
    openModal('modalQuestion');
}

async function submitAuthorQuestion(e) {
    if (e && e.preventDefault) e.preventDefault();
    recompileSummary();

    const qid = document.getElementById('formQid').value;
    const prompt = document.getElementById('formPrompt').value.trim();
    const answerText = document.getElementById('formAnswerText').value.trim();
    const stepsJson = document.getElementById('formStepsJson').value;
    const levelNumber = parseInt(document.getElementById('formLevel').value, 10) || 1;
    const difficulty = document.getElementById('formDifficulty').value;
    const points = parseInt(document.getElementById('formPoints').value, 10) || 1;
    const timeLimit = parseFloat(document.getElementById('formTimeLimit').value) || 90;
    const teacherId = document.getElementById('formTeacherId').value || null;

    if (!prompt) {
        showToast('Please provide a challenge prompt.', 'error');
        return;
    }
    if (!currentSteps.length) {
        showToast('Please add at least one laboratory step.', 'error');
        return;
    }

    const payload = {
        level_number: levelNumber,
        prompt: prompt,
        answer_text: answerText || prompt,
        steps_json: stepsJson,
        difficulty: difficulty,
        points: points,
        time_limit_s: timeLimit,
        teacher_id: teacherId,
        verification_status: 'Approved' // Admin auto-approval
    };

    const url = qid ? `/admin/gqb/questions/${qid}` : '/admin/gqb/questions';
    const method = qid ? 'PUT' : 'POST';

    try {
        const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (data.success) {
            showToast(qid ? 'Arcade challenge updated & approved!' : 'Arcade challenge created & authorized!', 'success');
            closeModal('modalQuestion');
            refreshAdminContent({ message: 'Updating question bank...' });
        } else {
            showToast(data.message || 'Save failed.', 'error');
        }
    } catch (_) {
        showToast('Network error occurred.', 'error');
    }
}

