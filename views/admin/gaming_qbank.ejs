                <div><label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Timer Type</label><select id="asmTimerType" class="fi text-sm"><option value="Global">Global</option><option value="PerItem">Per Item</option></select></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div><label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Due Date (optional)</label><input type="datetime-local" id="asmDueDate" class="fi text-sm"></div>
                <div class="flex items-end pb-1">
                    <label class="flex items-center gap-3 cursor-pointer">
                        <div class="relative"><input type="checkbox" id="asmUnlocked" class="sr-only peer"><div class="w-10 h-5 bg-slate-200 peer-checked:bg-cyan-500 rounded-full transition"></div><div class="absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full transition peer-checked:translate-x-5"></div></div>
                        <span class="text-sm font-bold text-slate-700">Unlock for students</span>
                    </label>
                </div>
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <button onclick="closeModal('modalAddAssessment')" class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-50 transition">Cancel</button>
                <button onclick="submitAddAssessment()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-orange-500 text-white text-sm font-bold hover:opacity-90 transition shadow-md"><i class="fas fa-plus mr-1"></i> Create</button>
            </div>
        </div>
    </div>
</div>

