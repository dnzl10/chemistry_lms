            <div class="grid grid-cols-3 gap-3">
                <div><label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Total Items</label><input type="number" id="editAsmItems" min="1" max="200" class="fi text-sm"></div>
                <div><label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Duration (min)</label><input type="number" id="editAsmDuration" min="1" max="180" class="fi text-sm"></div>
                <div><label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Timer Type</label><select id="editAsmTimerType" class="fi text-sm"><option value="Global">Global</option><option value="PerItem">Per Item</option></select></div>
            </div>
            <div class="grid grid-cols-2 gap-3">
