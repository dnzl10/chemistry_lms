    const reason = prompt('Please enter a rejection reason or guidance for the teacher:') || '';
    if (!reason.trim()) return;
    fetch(`/admin/gqb/questions/${qid}/reject`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ rejection_reason: reason.trim() })
    })
    .then(r => r.json())
    .then(data => {
        if (data.success) {
            showToast('Question rejected with feedback sent to teacher.', 'info');
            refreshAdminContent({ message: 'Rejecting question...' });
        } else {
            showToast(data.message || 'Rejection failed.', 'error');
