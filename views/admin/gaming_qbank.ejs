function toggleSelectAllQuestions(masterCheck) {
    const isChecked = masterCheck.checked;
    document.querySelectorAll('.q-row').forEach(row => {
        if (row.style.display !== 'none') {
            const chk = row.querySelector('.q-row-check');
            if (chk) chk.checked = isChecked;
        }
    });
    updateQuestionBulkBar();
}

function updateQuestionBulkBar() {
    const checked = Array.from(document.querySelectorAll('.q-row-check:checked')).map(c => parseInt(c.value, 10));
    const bar = document.getElementById('qBulkActionBar');
    const cnt = document.getElementById('qBulkSelectedCount');
    if (!bar || !cnt) return;
    if (checked.length > 0) {
        bar.classList.remove('hidden');
        cnt.textContent = `${checked.length} challenge${checked.length === 1 ? '' : 's'} selected`;
    } else {
        bar.classList.add('hidden');
    }
}

