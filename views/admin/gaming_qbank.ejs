                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Assessment Name</label>
                    <input type="text" id="asmName" placeholder="Q1 Chemistry Pre-Test" maxlength="100" class="fi text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Type *</label>
