<!-- ════════ MODAL: ADD / EDIT QUESTION ════════ -->
<div id="modalQuestion" class="modal-overlay">
    <div class="modal-box modal-box-lg p-0">
        <div class="flex items-center justify-between p-6 border-b border-slate-100 sticky top-0 bg-white z-10 rounded-t-2xl">
            <h3 id="qModalTitle" class="font-black text-indigo-900 text-lg flex items-center gap-2"><i class="fas fa-atom text-cyan-500"></i> Question Editor</h3>
            <button onclick="closeModal('modalQuestion')" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-rose-100 text-slate-500 hover:text-rose-600 transition flex items-center justify-center"><i class="fas fa-times"></i></button>
        </div>
        <div class="p-6 space-y-5">
            <input type="hidden" id="qId">

            <!-- Note for admin -->
            <div class="p-3 bg-emerald-50 border border-emerald-200 rounded-xl text-xs text-emerald-700 font-semibold flex items-center gap-2">
                <i class="fas fa-shield-check text-emerald-500"></i>
                Questions created by you as Admin are <strong>automatically approved</strong> — no verification step needed.
            </div>

            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Question Text *</label>
                <textarea id="qText" rows="3" maxlength="1000" placeholder="Type the question here…" class="fi text-sm resize-none"></textarea>
                <p id="errQText" class="ferr">Question text is required.</p>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Instruction Override (optional)</label>
                <input type="text" id="qInstruction" maxlength="500" placeholder="Custom instruction shown to player…" class="fi text-sm">
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Topic *</label>
                    <select id="qTopicId" class="fi text-sm">
                        <option value="">— Select —</option>
                        <% topics.forEach(function(t) { %><option value="<%= t.topic_id %>"><%= t.topic_name %></option><% }) %>
                    </select>
                    <p id="errQTopic" class="ferr">Topic is required.</p>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Difficulty *</label>
                    <select id="qDifficulty" class="fi text-sm"><option value="Easy">Easy</option><option value="Average">Average</option><option value="Difficult">Difficult</option></select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Base EXP</label>
                    <input type="number" id="qBaseExp" min="10" max="9999" value="100" class="fi text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Time Limit (s)</label>
                    <input type="number" id="qTimeLimit" min="5" max="300" value="10" class="fi text-sm">
                </div>
            </div>
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Input Mode *</label>
                    <select id="qInputMode" class="fi text-sm" onchange="updateQModeFields()">
                        <option value="Standard">Standard (MCQ)</option>
                        <option value="Periodic_Single">Periodic — Single Element</option>
                        <option value="Periodic_Sequence">Periodic — Sequence (Formula)</option>
                        <option value="Numeric">Numeric</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Mechanic Type *</label>
                    <select id="qMechanicType" class="fi text-sm">
                        <option value="standard_mcq">standard_mcq</option><option value="weight_scale">weight_scale</option>
                        <option value="radar_scan">radar_scan</option><option value="conveyor_belt">conveyor_belt</option>
                        <option value="flick_sort">flick_sort</option><option value="shield_calibrate">shield_calibrate</option>
                        <option value="electric_link">electric_link</option><option value="cipher_crack">cipher_crack</option>
                    </select>
                </div>
            </div>
            <div class="flex items-center gap-4">
                <label class="flex items-center gap-3 cursor-pointer">
                    <div class="relative"><input type="checkbox" id="qMultipleAnswer" class="sr-only peer" onchange="updateQModeFields()"><div class="w-10 h-5 bg-slate-200 peer-checked:bg-cyan-500 rounded-full transition"></div><div class="absolute top-0.5 left-0.5 w-4 h-4 bg-white rounded-full transition peer-checked:translate-x-5"></div></div>
                    <span class="text-sm font-bold text-slate-700">Multiple Answers</span>
                </label>
                <div id="reqAnswersWrap" class="hidden flex items-center gap-2">
                    <label class="text-xs text-slate-500">Required:</label>
                    <input type="number" id="qRequiredAnswers" min="1" max="10" value="1" class="fi text-sm w-20">
                </div>
                <label class="flex items-center gap-2 cursor-pointer ml-auto">
                    <input type="checkbox" id="qIsAI" class="accent-violet-500">
                    <span class="text-xs font-bold text-violet-600">AI Generated</span>
                </label>
            </div>

            <!-- ── STANDARD MCQ ── -->
            <div id="modeStandard" class="mode-field visible">
                <div class="border-t border-slate-100 pt-4">
                    <p class="text-[10px] font-black uppercase tracking-widest text-sky-600 mb-3 flex items-center gap-1.5"><i class="fas fa-list-ul"></i> MCQ Options</p>
                    <div class="space-y-2">
                        <% ['A','B','C','D'].forEach(function(opt) { %>
                        <div class="flex items-center gap-3">
                            <span class="w-7 h-7 rounded-lg bg-indigo-50 border border-indigo-200 flex items-center justify-center text-xs font-black text-indigo-600 flex-shrink-0"><%= opt %></span>
                            <input type="text" id="qOption<%= opt %>" placeholder="Option <%= opt %>…" maxlength="255" class="fi text-sm">
                        </div>
                        <% }) %>
                    </div>
                    <div class="mt-3">
                        <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Correct Answer *</label>
                        <select id="qCorrectStd" class="fi text-sm"><option value="A">A</option><option value="B">B</option><option value="C">C</option><option value="D">D</option></select>
                        <p class="text-xs text-slate-400 mt-1">Correct answer must be A, B, C, or D — stored in <code class="bg-slate-100 px-1 rounded">question_bank.correct_answer</code></p>
                    </div>
                </div>
            </div>

            <!-- ── PERIODIC SINGLE ── -->
            <div id="modePeriodic" class="mode-field">
                <div class="border-t border-slate-100 pt-4">
                    <p class="text-[10px] font-black uppercase tracking-widest text-cyan-600 mb-3 flex items-center gap-1.5"><i class="fas fa-atom"></i> Single Element Answer</p>
                    <div class="p-3 bg-cyan-50 border border-cyan-200 rounded-xl text-xs text-cyan-700 font-semibold mb-3 flex items-center gap-2">
                        <i class="fas fa-info-circle"></i> The element answer is stored in the <strong>answer_sequences</strong> table (1 entry with subscript=1).
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Element Symbol *</label>
                        <input type="text" id="qCorrectPeriodic" placeholder="e.g., Au, H, Fe" maxlength="10" class="fi text-sm font-mono">
                        <p class="text-xs text-slate-400 mt-1">Must match a symbol in the Hardware Button Mappings table.</p>
                        <p id="errPeriodicSymbol" class="ferr">Symbol not found in button_mappings.</p>
                    </div>
                </div>
            </div>

            <!-- ── PERIODIC SEQUENCE ── -->
            <div id="modeSequence" class="mode-field">
                <div class="border-t border-slate-100 pt-4">
                    <p class="text-[10px] font-black uppercase tracking-widest text-cyan-600 mb-3 flex items-center gap-1.5"><i class="fas fa-flask"></i> Chemical Formula Builder</p>
                    <div class="p-3 bg-cyan-50 border border-cyan-200 rounded-xl text-xs text-cyan-700 font-semibold mb-3 flex items-center gap-2">
                        <i class="fas fa-info-circle"></i> All sequence entries are stored in the <strong>answer_sequences</strong> table ordered by sort_order.
                    </div>
                    <div class="formula-preview mb-4" id="formulaPreview">Preview will appear here…</div>
                    <div id="seqEntries" class="space-y-2 mb-3"></div>
                    <button type="button" onclick="addSeqEntry()" class="flex items-center gap-2 text-xs font-bold border border-indigo-300 text-indigo-600 bg-indigo-50 px-3 py-1.5 rounded-lg hover:bg-indigo-100 transition">
                        <i class="fas fa-plus"></i> Add Element
                    </button>
                    <p class="text-xs text-slate-400 mt-2">Each entry: element symbol + subscript. Drag rows to reorder.</p>
                </div>
            </div>

            <!-- ── NUMERIC ── -->
            <div id="modeNumeric" class="mode-field">
                <div class="border-t border-slate-100 pt-4">
                    <p class="text-[10px] font-black uppercase tracking-widest text-amber-600 mb-3 flex items-center gap-1.5"><i class="fas fa-hashtag"></i> Numeric Answer</p>
                    <div class="p-3 bg-amber-50 border border-amber-200 rounded-xl text-xs text-amber-700 font-semibold mb-3 flex items-center gap-2">
                        <i class="fas fa-info-circle"></i> Stored in <strong>question_bank.numeric_answer</strong> and <strong>numeric_tolerance</strong> columns.
                    </div>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Correct Answer (Number) *</label>
                            <input type="number" id="qCorrectNumeric" placeholder="e.g., 6.022e23" step="any" class="fi text-sm font-mono">
                            <p class="text-xs text-slate-400 mt-1">Pure number — integer or decimal.</p>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Tolerance (±)</label>
                            <input type="number" id="qNumericTolerance" placeholder="e.g., 0.01" step="any" min="0" class="fi text-sm font-mono">
                            <p class="text-xs text-slate-400 mt-1">Acceptable margin of error. Leave 0 for exact match.</p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <button onclick="closeModal('modalQuestion')" class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-50 transition">Cancel</button>
                <button onclick="submitQuestion()" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-cyan-500 to-indigo-500 text-white text-sm font-bold hover:opacity-90 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Save Question
                </button>
            </div>
        </div>
    </div>
</div>

