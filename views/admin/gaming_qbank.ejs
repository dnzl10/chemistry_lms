// ─── BULK IMPORT ───
let _bulkFile = null;
let _preflightRows = [];

function handleBulkDrop(e) {
    e.preventDefault();
    document.getElementById('bulkDropZone').classList.remove('dragover');
    const file = e.dataTransfer.files[0];
    if (file) setBulkFile(file);
}
function handleBulkSelect(input) { if (input.files[0]) setBulkFile(input.files[0]); }
function setBulkFile(file) {
    _bulkFile = file;
    document.getElementById('btnPreflightCheck').disabled = false;
    document.getElementById('btnImportQuestions').disabled = true;
    const prev = document.getElementById('bulkFilePreview');
    prev.classList.remove('hidden');
    prev.innerHTML = `
        <div class="flex items-center gap-3 p-3 glass-card rounded-xl border border-slate-100">
            <i class="fas fa-file-excel text-emerald-500 text-2xl"></i>
            <div><p class="font-bold text-sm text-slate-700">${file.name}</p><p class="text-xs text-slate-400">${(file.size/1024).toFixed(1)} KB</p></div>
            <span class="ml-auto text-xs font-bold text-emerald-600 border border-emerald-200 bg-emerald-50 px-2 py-1 rounded-lg">Ready</span>
        </div>`;
    // Reset preflight
    _preflightRows = [];
    document.getElementById('preflightResult').classList.add('hidden');
    document.getElementById('importLog').classList.add('hidden');
}

async function runPreflightCheck() {
    if (!_bulkFile) return;
    document.getElementById('btnPreflightCheck').disabled = true;
    document.getElementById('btnPreflightCheck').innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Scanning…';
    const fd = new FormData();
    fd.append('file', _bulkFile);
    document.getElementById('preflightResult').classList.remove('hidden');
    document.getElementById('preflightBody').innerHTML = `<tr><td colspan="6" class="p-4 text-center text-indigo-400 animate-pulse"><i class="fas fa-search mr-2"></i>Running checks…</td></tr>`;
    try {
        const res  = await fetch('/admin/gqb/questions/preflight',{method:'POST',body:fd});
        const data = await res.json();
        document.getElementById('btnPreflightCheck').disabled = false;
        document.getElementById('btnPreflightCheck').innerHTML = '<i class="fas fa-search mr-1"></i> Re-run Check';
        if (!data.success) {
            document.getElementById('preflightBody').innerHTML = `<tr><td colspan="6" class="p-4 text-rose-500 text-sm font-bold">${data.message}</td></tr>`;
            return;
        }
        _preflightRows = data.rows;
        const validCount = _preflightRows.filter(r => r.ok).length;
        const errCount   = _preflightRows.length - validCount;
        document.getElementById('btnImportQuestions').disabled = validCount === 0;

        // Summary bar
        const summary = document.getElementById('preflightSummary');
        summary.classList.remove('hidden');
        summary.innerHTML = `
            <span class="text-emerald-600"><i class="fas fa-check-circle mr-1"></i>${validCount} valid</span>
            <span class="text-rose-500"><i class="fas fa-times-circle mr-1"></i>${errCount} errors</span>
            <span class="text-slate-500">Total: ${_preflightRows.length} rows</span>
            ${validCount > 0 ? '<span class="text-indigo-600 ml-auto"><i class="fas fa-shield-check mr-1"></i>Valid rows will be auto-approved</span>' : ''}
        `;

        document.getElementById('preflightBody').innerHTML = _preflightRows.map((r, i) => `
            <tr class="${r.ok ? 'preflight-ok' : 'preflight-err'}">
                <td class="p-2 font-mono text-slate-500">${i+2}</td>
                <td class="p-2 text-slate-600">${(r.question_text||'').substring(0,40)}…</td>
                <td class="p-2 text-slate-500">${r.input_mode||'—'}</td>
                <td class="p-2 text-slate-500">${r.mechanic_type||'—'}</td>
                <td class="p-2">${r.ok
                    ? '<span class="text-emerald-600 font-bold text-[10px]"><i class="fas fa-check mr-1"></i>VALID</span>'
                    : '<span class="text-rose-500 font-bold text-[10px]"><i class="fas fa-times mr-1"></i>ERROR</span>'}</td>
                <td class="p-2 text-rose-500 text-[10px]">${r.error||''}</td>
            </tr>
        `).join('');
        showToast(`Pre-flight: ${validCount}/${_preflightRows.length} valid`, validCount === _preflightRows.length ? 'success' : 'warning');
    } catch(_) {
        document.getElementById('btnPreflightCheck').disabled = false;
        document.getElementById('btnPreflightCheck').innerHTML = '<i class="fas fa-search mr-1"></i> Run Pre-flight Check';
        showToast('Network error during pre-flight.','error');
    }
}

async function importQuestions() {
    if (!_bulkFile || !_preflightRows.length) return;
    const validCount = _preflightRows.filter(r => r.ok).length;
    const skipCount  = _preflightRows.length - validCount;
    showConfirm({
        icon:'fas fa-upload', iconBg:'bg-emerald-100', iconColor:'text-emerald-600',
        title:`Import ${validCount} Valid Question${validCount !== 1 ? 's' : ''}?`,
        desc:`${skipCount} error row${skipCount !== 1 ? 's' : ''} will be skipped. All imported questions will be auto-approved. This cannot be undone.`,
        btnLabel:'Yes, Import', btnColor:'bg-gradient-to-r from-cyan-500 to-indigo-500',
        onConfirm: async () => {
            closeModal('modalConfirm');
            const fd = new FormData();
            fd.append('file', _bulkFile);
            const log = document.getElementById('importLog');
            log.classList.remove('hidden');
            log.innerHTML = '<div class="text-cyan-400 animate-pulse">⏳ Importing questions…</div>';
            try {
                const res  = await fetch('/admin/gqb/questions/bulk-import',{method:'POST',body:fd});
                const data = await res.json();
                if (data.success) {
                    log.innerHTML = `
                        <div class="text-emerald-400 font-bold mb-2">✅ Import complete! All rows auto-approved.</div>
                        <div class="text-slate-400 mb-2">Created: <span class="text-white font-bold">${data.created}</span> &nbsp; Skipped: <span class="text-amber-400 font-bold">${data.skipped}</span> &nbsp; Errors: <span class="text-rose-400 font-bold">${data.errors}</span></div>
                        ${(data.log||[]).map(l=>`<div class="text-xs mt-0.5 ${l.ok?'text-slate-400':'text-rose-400'}">${l.msg}</div>`).join('')}
                    `;
                    showToast(`Imported ${data.created} question(s)!`,'success');
                    document.getElementById('btnImportQuestions').disabled = true;
                } else {
                    log.innerHTML = `<div class="text-rose-400">❌ ${data.message||'Import failed.'}</div>`;
                    showToast('Import failed.','error');
                }
            } catch(_) {
                log.innerHTML = '<div class="text-rose-400">❌ Network error.</div>';
                showToast('Network error.','error');
            }
        },
    });
}

function downloadQBTemplate() { window.location.href = '/admin/gqb/questions/template'; }

// ─── VERIFICATION ───
function switchVeriTab(tabId, btn) {
    document.querySelectorAll('.veri-tab-content').forEach(el => { el.classList.remove('veri-active'); el.classList.add('hidden'); });
    document.getElementById(tabId).classList.remove('hidden');
    document.getElementById(tabId).classList.add('veri-active');
    document.querySelectorAll('.veri-tab-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
}
function confirmApproveQuestion(qId, preview) {
    showConfirm({
        icon:'fas fa-check-circle', iconBg:'bg-emerald-100', iconColor:'text-emerald-600',
        title:'Approve Question?',
        desc:`"${preview}…" will be marked Approved and available for use in assessments.`,
        btnLabel:'Approve', btnColor:'bg-emerald-600',
        onConfirm: async () => {
            closeModal('modalConfirm');
            try {
                const res  = await fetch(`/admin/gqb/questions/${qId}/approve`,{method:'POST'});
                const data = await res.json();
                if (data.success) { showToast('Question approved!','success'); refreshAdminContent({ message: 'Approving question...' }); }
                else showToast(data.message||'Failed.','error');
            } catch(_) { showToast('Network error.','error'); }
        },
    });
}
function openRejectModal(qId, preview) {
    document.getElementById('rejectQuestionId').value = qId;
    document.getElementById('rejectQuestionPreview').textContent = `"${preview}…"`;
    document.getElementById('rejectReasonText').value = '';
    openModal('modalRejectQuestion');
}
async function submitReject() {
    const qId    = document.getElementById('rejectQuestionId').value;
    const reason = document.getElementById('rejectReasonText').value.trim();
    if (!reason) { document.getElementById('rejectReasonText').classList.add('invalid'); showToast('Please enter a rejection reason.','error'); return; }
    document.getElementById('rejectReasonText').classList.remove('invalid');
    try {
        const res  = await fetch(`/admin/gqb/questions/${qId}/reject`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({rejection_reason:reason})});
        const data = await res.json();
        if (data.success) { showToast('Question rejected.','warning'); closeModal('modalRejectQuestion'); refreshAdminContent({ message: 'Rejecting question...' }); }
        else showToast(data.message||'Failed.','error');
    } catch(_) { showToast('Network error.','error'); }
}

// ─── INIT ───
document.addEventListener('DOMContentLoaded', () => {
    if (typeof updateQModeFields === 'function') updateQModeFields();
});
</script>
<!-- ═══════════════════════════════════════════════════════
     NOTIFICATION PANEL — Reusable across all admin pages
     Fetches from GET /admin/notifications on open.
═══════════════════════════════════════════════════════ -->

<!-- Backdrop -->
<div id="notifBackdrop" class="fixed inset-0 z-[998] hidden" onclick="closeNotifPanel()"></div>

<!-- Slide-in Panel -->
<div id="notifPanel"
     class="fixed top-0 right-0 h-full w-full max-w-sm z-[999] flex flex-col
            bg-white border-l border-cyan-100 shadow-2xl
            transform translate-x-full transition-transform duration-300 ease-in-out">

    <!-- Panel Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-cyan-100 bg-gradient-to-r from-indigo-950 to-indigo-900 flex-shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center">
                <i class="fas fa-bell text-cyan-400"></i>
            </div>
            <div>
                <p class="text-sm font-black text-white tracking-tight">Notifications</p>
                <p class="text-[10px] text-indigo-400 font-semibold" id="notifSubtitle">Loading…</p>
            </div>
        </div>
        <button onclick="closeNotifPanel()" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition">
            <i class="fas fa-times text-sm"></i>
        </button>
    </div>

    <!-- Category Tabs -->
    <div class="flex gap-0 border-b border-cyan-100 overflow-x-auto flex-shrink-0 bg-slate-50" id="notifTabs">
        <button class="notif-tab active px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-cyan-500 text-cyan-600 transition" data-tab="all">All</button>
        <button class="notif-tab px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition" data-tab="alerts">Alerts</button>
        <button class="notif-tab px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition" data-tab="activity">Activity</button>
        <button class="notif-tab px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition" data-tab="live">Live</button>
    </div>

    <!-- Scrollable Body -->
    <div id="notifBody" class="flex-1 overflow-y-auto p-4 space-y-3" style="scrollbar-width:thin;scrollbar-color:#e2e8f0 transparent;">
        <!-- Skeleton loader -->
        <div id="notifSkeleton" class="space-y-3">
            <% for(let i=0;i<5;i++) { %>
            <div class="animate-pulse flex gap-3 items-start">
                <div class="w-8 h-8 rounded-lg bg-slate-200 flex-shrink-0"></div>
                <div class="flex-1 space-y-1.5">
                    <div class="h-3 bg-slate-200 rounded w-3/4"></div>
                    <div class="h-2.5 bg-slate-100 rounded w-1/2"></div>
                </div>
            </div>
            <% } %>
        </div>
        <!-- Actual content injected by JS -->
        <div id="notifContent" class="hidden space-y-3"></div>
    </div>

    <!-- Panel Footer -->
    <div class="px-5 py-3 border-t border-cyan-100 bg-slate-50 flex items-center justify-between flex-shrink-0">
        <p class="text-[10px] text-slate-400 font-semibold">Auto-refreshes every 60s</p>
        <button onclick="loadNotifications()" class="text-[11px] font-black text-cyan-600 hover:text-cyan-800 flex items-center gap-1 transition">
            <i class="fas fa-rotate-right text-[10px]"></i> Refresh
        </button>
    </div>
</div>

<style>
    .notif-tab.active { border-bottom-color: #06b6d4 !important; color: #0891b2 !important; }
    .notif-item { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 10px 12px; display: flex; gap: 10px; align-items: flex-start; transition: border-color 0.15s, box-shadow 0.15s; }
    .notif-item:hover { border-color: #06b6d4; box-shadow: 0 4px 12px rgba(6,182,212,0.08); }
    .notif-icon { width: 32px; height: 32px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 13px; }
    .notif-title { font-size: 12px; font-weight: 700; color: #1e293b; line-height: 1.35; }
    .notif-sub { font-size: 10.5px; color: #64748b; margin-top: 1px; }
    .notif-time { font-size: 10px; color: #94a3b8; white-space: nowrap; margin-left: auto; padding-left: 6px; flex-shrink: 0; }
    .notif-section-label { font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: .07em; color: #94a3b8; padding: 4px 0 6px; }
    .notif-link { font-size: 10.5px; color: #06b6d4; font-weight: 700; text-decoration: none; cursor: pointer; }
    .notif-link:hover { color: #0891b2; }
</style>

<script>
(function() {
    let _notifData   = null;
    let _activeTab   = 'all';
    let _refreshTimer = null;

    function timeAgo(dateStr) {
        if (!dateStr) return '';
        const diff = (Date.now() - new Date(dateStr)) / 1000;
        if (diff < 60)   return 'just now';
        if (diff < 3600) return Math.floor(diff/60) + 'm ago';
        if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
        return Math.floor(diff/86400) + 'd ago';
    }

    function fmtDate(dateStr) {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' });
    }

    window.toggleNotifPanel = function() {
        const panel    = document.getElementById('notifPanel');
        const backdrop = document.getElementById('notifBackdrop');
        const isOpen   = !panel.classList.contains('translate-x-full');
        if (isOpen) { closeNotifPanel(); return; }
        panel.classList.remove('translate-x-full');
        backdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        loadNotifications();
        _refreshTimer = setInterval(loadNotifications, 60000);
    };

    window.closeNotifPanel = function() {
        document.getElementById('notifPanel').classList.add('translate-x-full');
        document.getElementById('notifBackdrop').classList.add('hidden');
        document.body.style.overflow = '';
        clearInterval(_refreshTimer);
    };

    window.loadNotifications = async function() {
        document.getElementById('notifSkeleton').classList.remove('hidden');
        document.getElementById('notifContent').classList.add('hidden');
        try {
            const res  = await fetch('/admin/notifications');
            const data = await res.json();
            if (!data.success) throw new Error(data.message);
            _notifData = data;
            updateBell(data.total);
            renderTab(_activeTab);
        } catch(e) {
            document.getElementById('notifContent').innerHTML =
                '<div class="py-10 text-center text-slate-400 text-xs">Failed to load notifications.</div>';
            document.getElementById('notifContent').classList.remove('hidden');
            document.getElementById('notifSkeleton').classList.add('hidden');
        }
    };

    function updateBell(count) {
        const dot   = document.getElementById('notifDot');
        const badge = document.getElementById('notifCount');
        if (count > 0) {
            dot.classList.remove('hidden');
            badge.textContent = count > 9 ? '9+' : count;
            badge.classList.remove('hidden');
        } else {
            dot.classList.add('hidden');
            badge.classList.add('hidden');
        }
        document.getElementById('notifSubtitle').textContent =
            count > 0 ? count + ' item' + (count !== 1 ? 's' : '') + ' need attention' : 'All clear';
    }

    function renderTab(tab) {
        _activeTab = tab;
        const d = _notifData;
        if (!d) return;

        let html = '';

        // ── ALL tab ──
        if (tab === 'all' || tab === 'alerts') {
            const alertItems = [
                ...d.expiredInvites.map(i => ({
                    icon: 'fas fa-envelope-circle-check', iconBg: 'bg-rose-50', iconColor: 'text-rose-500',
                    title: 'Expired Invitation',
                    sub: i.email + ' · ' + (i.role || 'Unknown role'),
                    time: fmtDate(i.expires_at),
                    link: '/admin/user_access_control', linkLabel: 'View UAC'
                })),
                ...d.flaggedStudents.map(s => ({
                    icon: 'fas fa-flag', iconBg: 'bg-amber-50', iconColor: 'text-amber-500',
                    title: 'Flagged Student',
                    sub: s.full_name + (s.assessment_name ? ' · ' + s.assessment_name : ''),
                    time: '',
                    link: '/admin/user_access_control', linkLabel: 'View Student'
                })),
                ...d.lockedPastDue.map(a => ({
                    icon: 'fas fa-lock', iconBg: 'bg-orange-50', iconColor: 'text-orange-500',
                    title: 'Assessment Past Due & Locked',
                    sub: a.assessment_name + ' · ' + (a.subject_name || ''),
                    time: fmtDate(a.due_date),
                    link: '/admin/gaming_question_bank', linkLabel: 'Manage'
                })),
                ...d.overdueDeadlines.map(e => ({
                    icon: 'fas fa-calendar-xmark', iconBg: 'bg-red-50', iconColor: 'text-red-500',
                    title: 'Overdue Deadline',
                    sub: e.event_title + (e.subject_name ? ' · ' + e.subject_name : ''),
                    time: fmtDate(e.event_date),
                    link: '/admin/academic_management', linkLabel: 'View'
                })),
                ...d.pendingQuestions.map(q => ({
                    icon: 'fas fa-robot', iconBg: 'bg-indigo-50', iconColor: 'text-indigo-500',
                    title: 'AI Question Awaiting Approval',
                    sub: q.question_text.substring(0, 55) + (q.question_text.length > 55 ? '…' : ''),
                    time: timeAgo(q.created_at),
                    link: '/admin/gaming_question_bank', linkLabel: 'Review'
                })),
            ];

            if (tab === 'alerts' || tab === 'all') {
                if (alertItems.length === 0) {
                    if (tab === 'alerts') html += emptyState('fa-shield-halved', 'No alerts', 'Everything looks good!');
                } else {
                    if (tab === 'all') html += '<div class="notif-section-label"><i class="fas fa-triangle-exclamation mr-1 text-rose-400"></i>Alerts Requiring Action</div>';
                    alertItems.forEach(item => { html += notifItem(item); });
                }
            }
        }

        // ── ACTIVITY tab (pending & new users) ──
        if (tab === 'activity' || tab === 'all') {
            const actItems = [
                ...d.pendingInvites.map(i => ({
                    icon: 'fas fa-paper-plane', iconBg: 'bg-cyan-50', iconColor: 'text-cyan-500',
                    title: 'Pending Invitation',
                    sub: i.email + ' · ' + (i.role || ''),
                    time: timeAgo(i.created_at),
                    link: '/admin/user_access_control', linkLabel: 'View'
                })),
                ...d.newUsers.map(u => ({
                    icon: 'fas fa-user-plus', iconBg: 'bg-emerald-50', iconColor: 'text-emerald-500',
                    title: 'New ' + u.role + ' Registered',
                    sub: u.full_name,
                    time: timeAgo(u.created_at),
                    link: '/admin/user_access_control', linkLabel: 'View Profile'
                })),
            ];

            if (tab === 'activity') {
                if (actItems.length === 0) html += emptyState('fa-clock-rotate-left', 'No recent activity', 'No new users or pending invites.');
                else actItems.forEach(item => { html += notifItem(item); });
            } else if (tab === 'all' && actItems.length > 0) {
                html += '<div class="notif-section-label mt-2"><i class="fas fa-bolt mr-1 text-cyan-400"></i>Recent Activity</div>';
                actItems.forEach(item => { html += notifItem(item); });
            }
        }

        // ── LIVE tab (active sessions) ──
        if (tab === 'live' || tab === 'all') {
            if (tab === 'live') {
                if (d.activeSessions.length === 0) {
                    html += emptyState('fa-gamepad', 'No live sessions', 'No students are playing right now.');
                } else {
                    d.activeSessions.forEach(s => {
                        html += notifItem({
                            icon: 'fas fa-gamepad', iconBg: 'bg-violet-50', iconColor: 'text-violet-500',
                            title: s.student_name + ' is playing',
                            sub: s.assessment_name + ' · ' + s.player_mode,
                            time: timeAgo(s.start_time),
                            link: null
                        });
                    });
                }
            } else if (tab === 'all' && d.activeSessions.length > 0) {
                html += '<div class="notif-section-label mt-2"><i class="fas fa-circle text-green-400 mr-1"></i>Live Sessions (' + d.activeSessions.length + ')</div>';
                d.activeSessions.slice(0, 3).forEach(s => {
                    html += notifItem({
                        icon: 'fas fa-gamepad', iconBg: 'bg-violet-50', iconColor: 'text-violet-500',
                        title: s.student_name + ' is playing',
                        sub: s.assessment_name + ' · ' + s.player_mode,
                        time: timeAgo(s.start_time),
                        link: null
                    });
                });
            }
        }

        if (tab === 'all' && html === '') {
            html = emptyState('fa-bell-slash', 'All clear!', 'No alerts or pending items.');
        }

        document.getElementById('notifContent').innerHTML = html;
        document.getElementById('notifContent').classList.remove('hidden');
        document.getElementById('notifSkeleton').classList.add('hidden');
    }

    function notifItem(item) {
        return '<div class="notif-item">' +
            '<div class="notif-icon ' + item.iconBg + ' ' + item.iconColor + '">' +
                '<i class="' + item.icon + '"></i>' +
            '</div>' +
            '<div class="flex-1 min-w-0">' +
                '<p class="notif-title">' + item.title + '</p>' +
                '<p class="notif-sub truncate">' + item.sub + '</p>' +
                (item.link ? '<a href="' + item.link + '" class="notif-link">' + item.linkLabel + ' →</a>' : '') +
            '</div>' +
            (item.time ? '<span class="notif-time">' + item.time + '</span>' : '') +
        '</div>';
    }

    function emptyState(icon, title, sub) {
        return '<div class="py-10 text-center">' +
            '<i class="fas ' + icon + ' text-3xl text-slate-200 mb-3 block"></i>' +
            '<p class="text-sm font-bold text-slate-400">' + title + '</p>' +
            '<p class="text-xs text-slate-300 mt-1">' + sub + '</p>' +
        '</div>';
    }

    // Tab switching
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.notif-tab').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.notif-tab').forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                renderTab(btn.dataset.tab);
            });
        });

        // Auto-poll bell count every 2 minutes even when panel is closed
        setInterval(async function() {
            try {
                const res  = await fetch('/admin/notifications');
                const data = await res.json();
                if (data.success) updateBell(data.total);
            } catch(_) {}
        }, 120000);
    });
})();
</script>

