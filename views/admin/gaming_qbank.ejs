<!-- ════════ MODAL: CONFIRM (generic) ════════ -->
<div id="modalConfirm" class="modal-overlay">
    <div class="modal-box modal-box-sm p-8 text-center">
        <div id="confirmIcon" class="w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl"></div>
        <h3 id="confirmTitle" class="font-black text-slate-900 text-lg mb-2"></h3>
        <p  id="confirmDesc"  class="text-sm text-slate-500 mb-6 leading-relaxed"></p>
        <div id="confirmInputWrap" class="hidden mb-4">
            <p class="text-xs text-slate-500 mb-2">Type <span class="text-rose-500 font-bold font-mono">DELETE</span> to confirm:</p>
            <input type="text" id="confirmInput" class="fi text-sm text-center font-mono" placeholder="DELETE" oninput="checkConfirmInput()">
        </div>
        <div class="flex gap-3 justify-center">
            <button onclick="closeModal('modalConfirm')" class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-50 transition">Cancel</button>
            <button id="confirmBtn" class="px-5 py-2.5 rounded-xl text-white text-sm font-bold hover:opacity-90 transition shadow-md disabled:opacity-40 disabled:cursor-not-allowed">Confirm</button>
        </div>
    </div>
</div>

<!-- Toast -->
<div id="toast"><i id="toastIcon" class="fas"></i> <span id="toastMsg"></span></div>

<script>
// ─── SIDEBAR ───
function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('-translate-x-full');
    document.getElementById('sidebarOverlay').classList.toggle('hidden');
}

// ─── TABS ───
function switchTab(id, btn) {
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    btn.classList.add('active');
}


// ── Auto-activate tab from URL query param ──
    // Usage: /admin/gaming_question_bank?tab=tab-assessments
    (function() {
        const urlParams = new URLSearchParams(window.location.search);
        const targetTab = urlParams.get('tab');
        if (targetTab) {
            const targetContent = document.getElementById(targetTab);
            const targetBtn = document.querySelector(`[onclick="switchTab('${targetTab}',this)"]`);
            if (targetContent && targetBtn) {
                switchTab(targetTab, targetBtn);
                setTimeout(() => targetContent.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
            }
        }
    })();

// ─── MODALS ───
function openModal(id) { document.getElementById(id).classList.add('open'); document.body.style.overflow = 'hidden'; }
function closeModal(id) { document.getElementById(id).classList.remove('open'); document.body.style.overflow = ''; }
document.querySelectorAll('.modal-overlay').forEach(o => {
    o.addEventListener('click', e => { if (e.target === o) closeModal(o.id); });
});

// ─── TOAST ───
function showToast(msg, type = 'info') {
    const t = document.getElementById('toast');
    const i = document.getElementById('toastIcon');
    document.getElementById('toastMsg').textContent = msg;
    i.className = `fas ${type==='success'?'fa-check-circle':type==='error'?'fa-circle-xmark':type==='warning'?'fa-triangle-exclamation':'fa-circle-info'}`;
    t.className = `show ${type}`;
    setTimeout(() => { t.className = ''; }, 3600);
}

// ─── QUESTION FILTERS ───
const _qFilters = { difficulty: 'all', mode: 'all' };
function setQFilter(val, group, el) {
    _qFilters[group] = val;
    document.querySelectorAll(`.filter-pill[data-group="${group}"]`).forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    filterQuestions();
}
function filterQuestions() {
    const q = document.getElementById('qSearch').value.toLowerCase().trim();
    let n = 0;
    document.querySelectorAll('.q-row').forEach(r => {
        const show = (_qFilters.difficulty === 'all' || r.dataset.difficulty === _qFilters.difficulty) &&
                     (_qFilters.mode === 'all' || r.dataset.mode === _qFilters.mode) &&
                     (!q || r.dataset.search.includes(q));
        r.style.display = show ? '' : 'none';
        if (show) n++;
    });
    document.getElementById('qCountLabel').textContent = `Showing ${n} question(s)`;
}

// ─── HW FILTER ───
function filterPlayer(player, el) {
    document.querySelectorAll('.filter-pill').forEach(p => p.classList.remove('active'));
    el.classList.add('active');
    document.querySelectorAll('.hw-row').forEach(r => {
        r.style.display = (player === 0 || parseInt(r.dataset.player) === player) ? '' : 'none';
    });
}

// ─── CONFIRM MODAL ───
function showConfirm({ icon, iconBg, iconColor, title, desc, btnLabel, btnColor, requireTyping, onConfirm }) {
    const ic = document.getElementById('confirmIcon');
    ic.className = `w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl ${iconBg}`;
    ic.innerHTML = `<i class="${icon} ${iconColor}"></i>`;
    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmDesc').textContent  = desc;
    const inputWrap = document.getElementById('confirmInputWrap');
    const inputEl   = document.getElementById('confirmInput');
    const btn       = document.getElementById('confirmBtn');
    if (requireTyping) { inputWrap.classList.remove('hidden'); inputEl.value = ''; btn.disabled = true; }
    else { inputWrap.classList.add('hidden'); btn.disabled = false; }
    btn.textContent = btnLabel;
    btn.className   = `px-5 py-2.5 rounded-xl text-white text-sm font-bold hover:opacity-90 transition shadow-md disabled:opacity-40 disabled:cursor-not-allowed ${btnColor}`;
    btn.onclick     = onConfirm;
    openModal('modalConfirm');
}
function checkConfirmInput() {
    document.getElementById('confirmBtn').disabled = (document.getElementById('confirmInput').value !== 'DELETE');
}

// ─── ASSESSMENTS ───
function openEditAssessment(a) {
    document.getElementById('editAsmId').value        = a.assessment_id;
    document.getElementById('editAsmName').value      = a.assessment_name || '';
    document.getElementById('editAsmType').value      = a.assessment_type || 'Quiz';
    document.getElementById('editAsmTopicId').value   = a.topic_id || '';
    document.getElementById('editAsmItems').value     = a.total_items || 10;
    document.getElementById('editAsmDuration').value  = a.duration_minutes || 30;
    document.getElementById('editAsmTimerType').value = a.timer_type || 'Global';
    document.getElementById('editAsmUnlocked').checked = !!a.is_unlocked;
    document.getElementById('editAsmDueDate').value   = a.due_date ? new Date(a.due_date).toISOString().slice(0,16) : '';
    openModal('modalEditAssessment');
}
async function submitAddAssessment() {
    const topicId = document.getElementById('asmTopicId').value;
    if (!topicId) { document.getElementById('errAsmTopic').classList.add('show'); return; }
    document.getElementById('errAsmTopic').classList.remove('show');
    const payload = {
        assessment_name: document.getElementById('asmName').value.trim(),
        assessment_type: document.getElementById('asmType').value,
        topic_id       : parseInt(topicId),
        total_items    : parseInt(document.getElementById('asmItems').value) || 10,
        duration_minutes: parseInt(document.getElementById('asmDuration').value) || 30,
        timer_type     : document.getElementById('asmTimerType').value,
        is_unlocked    : document.getElementById('asmUnlocked').checked ? 1 : 0,
        due_date       : document.getElementById('asmDueDate').value || null,
    };
    showConfirm({
        icon:'fas fa-plus', iconBg:'bg-amber-100', iconColor:'text-amber-600',
        title:'Create Assessment?',
        desc:`This will create "${payload.assessment_name || 'a new assessment'}" linked to the selected topic.`,
        btnLabel:'Create', btnColor:'bg-amber-500',
        onConfirm: async () => {
            closeModal('modalConfirm');
            try {
                const res  = await fetch('/admin/gqb/assessments', {method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                const data = await res.json();
                if (data.success) { showToast('Assessment created!','success'); closeModal('modalAddAssessment'); setTimeout(() => location.reload(),1200); }
                else showToast(data.message||'Failed.','error');
            } catch(_) { showToast('Network error.','error'); }
        },
    });
}
async function submitEditAssessment() {
    const id = document.getElementById('editAsmId').value;
    const payload = {
        assessment_name: document.getElementById('editAsmName').value.trim(),
        assessment_type: document.getElementById('editAsmType').value,
        topic_id       : parseInt(document.getElementById('editAsmTopicId').value) || null,
        total_items    : parseInt(document.getElementById('editAsmItems').value) || 10,
        duration_minutes: parseInt(document.getElementById('editAsmDuration').value) || 30,
        timer_type     : document.getElementById('editAsmTimerType').value,
        is_unlocked    : document.getElementById('editAsmUnlocked').checked ? 1 : 0,
        due_date       : document.getElementById('editAsmDueDate').value || null,
    };
    showConfirm({
        icon:'fas fa-pen', iconBg:'bg-indigo-100', iconColor:'text-indigo-600',
        title:'Save Changes?', desc:'Update this assessment configuration.',
        btnLabel:'Save', btnColor:'bg-indigo-500',
        onConfirm: async () => {
            closeModal('modalConfirm');
            try {
                const res  = await fetch(`/admin/gqb/assessments/${id}`,{method:'PUT',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                const data = await res.json();
                if (data.success) { showToast('Assessment updated!','success'); closeModal('modalEditAssessment'); setTimeout(() => location.reload(),1200); }
                else showToast(data.message||'Failed.','error');
            } catch(_) { showToast('Network error.','error'); }
        },
    });
}
async function toggleLock(id, currentUnlocked) {
    const action = currentUnlocked ? 'Lock' : 'Unlock';
    showConfirm({
        icon: currentUnlocked ? 'fas fa-lock' : 'fas fa-lock-open',
        iconBg: currentUnlocked ? 'bg-rose-100' : 'bg-emerald-100',
        iconColor: currentUnlocked ? 'text-rose-500' : 'text-emerald-600',
        title:`${action} Assessment?`,
        desc: currentUnlocked ? 'Students will no longer access this assessment.' : 'Students will be able to start this assessment.',
        btnLabel:action, btnColor: currentUnlocked ? 'bg-rose-500' : 'bg-emerald-500',
        onConfirm: async () => {
            closeModal('modalConfirm');
            try {
                const res  = await fetch(`/admin/gqb/assessments/${id}/toggle-lock`,{method:'POST'});
                const data = await res.json();
                if (data.success) { showToast(`Assessment ${action.toLowerCase()}ed!`,'success'); setTimeout(() => location.reload(),1000); }
                else showToast(data.message||'Failed.','error');
            } catch(_) { showToast('Network error.','error'); }
        },
    });
}
function confirmDeleteAssessment(id, name) {
    showConfirm({
        icon:'fas fa-trash', iconBg:'bg-rose-100', iconColor:'text-rose-500',
        title:`Delete "${name}"?`,
        desc:'Permanently removes this assessment and all scores/responses. Questions in the bank are NOT deleted. Type DELETE to confirm.',
        btnLabel:'Delete Assessment', btnColor:'bg-rose-600', requireTyping:true,
        onConfirm: async () => {
            closeModal('modalConfirm');
            try {
                const res  = await fetch(`/admin/gqb/assessments/${id}`,{method:'DELETE'});
                const data = await res.json();
                if (data.success) { showToast('Assessment deleted.','success'); setTimeout(() => location.reload(),1200); }
                else showToast(data.message||'Failed.','error');
            } catch(_) { showToast('Network error.','error'); }
        },
    });
}

// ─── QUESTIONS ───
let seqEntries = [];

function updateQModeFields() {
    const mode = document.getElementById('qInputMode').value;
    document.getElementById('modeStandard').classList.toggle('visible', mode === 'Standard');
    document.getElementById('modePeriodic').classList.toggle('visible', mode === 'Periodic_Single');
    document.getElementById('modeSequence').classList.toggle('visible', mode === 'Periodic_Sequence');
    document.getElementById('modeNumeric').classList.toggle('visible', mode === 'Numeric');
    const isMulti = document.getElementById('qMultipleAnswer').checked;
    document.getElementById('reqAnswersWrap').classList.toggle('hidden', !isMulti);
}

function addSeqEntry() {
    const idx = seqEntries.length;
    seqEntries.push({ symbol: '', subscript: 1, sort_order: idx + 1 });
    renderSeqEntries();
}
function renderSeqEntries() {
    const c = document.getElementById('seqEntries');
    c.innerHTML = seqEntries.map((e, i) => `
        <div class="seq-row" data-idx="${i}">
            <span class="drag-handle text-slate-400"><i class="fas fa-grip-vertical"></i></span>
            <span class="text-xs text-slate-400 font-mono w-6">${i+1}.</span>
            <input type="text" value="${e.symbol}" placeholder="Symbol (e.g. H)" maxlength="10"
                class="fi text-sm font-mono w-24 font-black text-indigo-800"
                oninput="seqEntries[${i}].symbol=this.value;updateFormulaPreview()">
            <span class="text-xs text-slate-400">subscript:</span>
            <input type="number" value="${e.subscript}" min="1" max="99" class="fi text-sm font-mono w-16"
                oninput="seqEntries[${i}].subscript=parseInt(this.value)||1;updateFormulaPreview()">
            <button onclick="removeSeqEntry(${i})" class="btn-icon btn-delete ml-auto flex-shrink-0"><i class="fas fa-times"></i></button>
        </div>
    `).join('');
    updateFormulaPreview();
}
function removeSeqEntry(idx) {
    seqEntries.splice(idx, 1);
    seqEntries.forEach((e, i) => e.sort_order = i + 1);
    renderSeqEntries();
}
function updateFormulaPreview() {
    const preview = seqEntries.map(e => {
        if (!e.symbol) return '';
        const sub = e.subscript > 1 ? `<sub>${e.subscript}</sub>` : '';
        return `<span>${e.symbol}${sub}</span>`;
    }).join('');
    document.getElementById('formulaPreview').innerHTML = preview || 'Preview will appear here…';
}

function openAddQuestion() {
    document.getElementById('qId').value = '';
    document.getElementById('qModalTitle').innerHTML = '<i class="fas fa-plus text-cyan-500 mr-2"></i>Add Question';
    ['qText','qInstruction','qOptionA','qOptionB','qOptionC','qOptionD','qCorrectPeriodic','qCorrectNumeric','qNumericTolerance'].forEach(id => {
        const el = document.getElementById(id); if (el) el.value = '';
    });
    document.getElementById('qCorrectStd').value   = 'A';
    document.getElementById('qTopicId').value       = '';
    document.getElementById('qDifficulty').value    = 'Easy';
    document.getElementById('qBaseExp').value       = '100';
    document.getElementById('qTimeLimit').value     = '10';
    document.getElementById('qInputMode').value     = 'Standard';
    document.getElementById('qMechanicType').value  = 'standard_mcq';
    document.getElementById('qMultipleAnswer').checked = false;
    document.getElementById('qRequiredAnswers').value  = '1';
    document.getElementById('qIsAI').checked        = false;
    seqEntries = [];
    renderSeqEntries();
    updateQModeFields();
    openModal('modalQuestion');
}

function openEditQuestion(q) {
    document.getElementById('qId').value = q.question_id;
    document.getElementById('qModalTitle').innerHTML = '<i class="fas fa-pen text-cyan-500 mr-2"></i>Edit Question';
    document.getElementById('qText').value        = q.question_text || '';
    document.getElementById('qInstruction').value = q.instruction_override || '';
    document.getElementById('qTopicId').value     = q.topic_id || '';
    document.getElementById('qDifficulty').value  = q.difficulty || 'Easy';
    document.getElementById('qBaseExp').value     = q.base_exp || 100;
    document.getElementById('qTimeLimit').value   = q.time_limit || 10;
    document.getElementById('qInputMode').value   = q.input_mode || 'Standard';
    document.getElementById('qMechanicType').value= q.mechanic_type || 'standard_mcq';
    document.getElementById('qMultipleAnswer').checked = !!q.is_multiple_answer;
    document.getElementById('qRequiredAnswers').value  = q.required_answers_count || 1;
    document.getElementById('qIsAI').checked      = !!q.is_ai_generated;
    document.getElementById('qOptionA').value     = q.option_a || '';
    document.getElementById('qOptionB').value     = q.option_b || '';
    document.getElementById('qOptionC').value     = q.option_c || '';
    document.getElementById('qOptionD').value     = q.option_d || '';

    const mode = q.input_mode || 'Standard';
    if (mode === 'Standard') {
        document.getElementById('qCorrectStd').value = q.correct_answer || 'A';
    } else if (mode === 'Periodic_Single') {
        // Load from sequences (first entry)
        const firstSeq = (q.sequences || [])[0];
        document.getElementById('qCorrectPeriodic').value = firstSeq ? firstSeq.element_symbol : (q.correct_answer || '');
        seqEntries = [];
    } else if (mode === 'Numeric') {
        document.getElementById('qCorrectNumeric').value   = q.numeric_answer !== null && q.numeric_answer !== undefined ? q.numeric_answer : (q.correct_answer || '');
        document.getElementById('qNumericTolerance').value = q.numeric_tolerance || '0';
    } else if (mode === 'Periodic_Sequence') {
        seqEntries = (q.sequences || []).map((s, i) => ({
            symbol: s.element_symbol, subscript: s.subscript, sort_order: s.sort_order || i + 1
        }));
        renderSeqEntries();
    }
    updateQModeFields();
    openModal('modalQuestion');
}

async function submitQuestion() {
    const mode    = document.getElementById('qInputMode').value;
    const text    = document.getElementById('qText').value.trim();
    const topicId = document.getElementById('qTopicId').value;
    let valid = true;

    document.getElementById('errQText').classList.remove('show');
    document.getElementById('errQTopic').classList.remove('show');
    if (!text)    { document.getElementById('errQText').classList.add('show'); valid = false; }
    if (!topicId) { document.getElementById('errQTopic').classList.add('show'); valid = false; }
    if (!valid) return;

    let correct_answer    = null;
    let numeric_answer    = null;
    let numeric_tolerance = 0;
    let sequences         = [];

    if (mode === 'Standard') {
        correct_answer = document.getElementById('qCorrectStd').value;
    } else if (mode === 'Periodic_Single') {
        const sym = document.getElementById('qCorrectPeriodic').value.trim();
        if (!sym) { showToast('Element symbol is required.', 'error'); return; }
        sequences = [{ symbol: sym, subscript: 1 }];
    } else if (mode === 'Numeric') {
        const n = document.getElementById('qCorrectNumeric').value;
        if (n === '' || isNaN(Number(n))) { showToast('A valid number is required.', 'error'); return; }
        numeric_answer    = parseFloat(n);
        numeric_tolerance = parseFloat(document.getElementById('qNumericTolerance').value) || 0;
    } else if (mode === 'Periodic_Sequence') {
        if (seqEntries.length === 0) { showToast('Add at least one element.', 'error'); return; }
        if (seqEntries.find(e => !e.symbol.trim())) { showToast('All sequence entries need a symbol.', 'error'); return; }
        sequences = seqEntries;
    }

    const qId = document.getElementById('qId').value;
    const payload = {
        question_text      : text,
        instruction_override: document.getElementById('qInstruction').value.trim() || null,
        topic_id           : parseInt(topicId),
        difficulty         : document.getElementById('qDifficulty').value,
        base_exp           : parseInt(document.getElementById('qBaseExp').value) || 100,
        time_limit         : parseInt(document.getElementById('qTimeLimit').value) || 10,
        input_mode         : mode,
        mechanic_type      : document.getElementById('qMechanicType').value,
        is_multiple_answer : document.getElementById('qMultipleAnswer').checked ? 1 : 0,
        required_answers_count: parseInt(document.getElementById('qRequiredAnswers').value) || 1,
        is_ai_generated    : document.getElementById('qIsAI').checked ? 1 : 0,
        option_a           : document.getElementById('qOptionA').value.trim() || null,
        option_b           : document.getElementById('qOptionB').value.trim() || null,
        option_c           : document.getElementById('qOptionC').value.trim() || null,
        option_d           : document.getElementById('qOptionD').value.trim() || null,
        correct_answer,
        numeric_answer,
        numeric_tolerance,
        sequences,
    };

    // Simple yes/no confirm for admin-created questions
    showConfirm({
        icon: qId ? 'fas fa-pen' : 'fas fa-plus',
        iconBg: 'bg-indigo-100', iconColor: 'text-indigo-600',
        title: qId ? 'Save Changes?' : 'Add this Question?',
        desc : qId
            ? 'Confirm saving your changes to this question.'
            : 'This question will be added to the bank and auto-approved since you are an Admin.',
        btnLabel: qId ? 'Yes, Save' : 'Yes, Add Question', btnColor: 'bg-indigo-600',
        onConfirm: async () => {
            closeModal('modalConfirm');
            const url    = qId ? `/admin/gqb/questions/${qId}` : '/admin/gqb/questions';
            const method = qId ? 'PUT' : 'POST';
            try {
                const res  = await fetch(url,{method,headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
                const data = await res.json();
                if (data.success) {
                    if (data.symbolWarning) showToast(`⚠ Symbol not in button_mappings. Saved anyway.`,'warning');
                    else showToast(qId ? 'Question updated!' : 'Question added!','success');
                    closeModal('modalQuestion');
                    setTimeout(() => location.reload(), 1300);
                } else showToast(data.message||'Failed.','error');
            } catch(_) { showToast('Network error.','error'); }
        },
    });
}

