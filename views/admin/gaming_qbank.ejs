<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Gaming & Q-Bank | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .glass-card { background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); }
        .stat-card { transition: transform 0.18s ease, box-shadow 0.18s ease; }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.10); }
        .nav-active {
            background: linear-gradient(135deg, #06b6d4, #6366f1) !important;
            color: white !important; font-weight: 700;
            box-shadow: 0 4px 14px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }
        .fade-in { animation: fadeUp 0.35s ease both; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }

        /* Tab system */
        .tab-btn { transition: all 0.2s ease; }
        .tab-btn.active {
            background: linear-gradient(135deg,#06b6d4,#6366f1);
            color: white; box-shadow: 0 4px 14px rgba(99,102,241,0.35);
        }
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        /* Data table */
        .data-table th { background: #f8fafc; font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:#64748b; font-weight:700; }
        .data-table tr { transition: background 0.12s; }
        .data-table tbody tr:hover { background: #f0f9ff; }
        .data-table td { vertical-align: middle; }

        /* Modal */
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(15,23,42,0.6);
            backdrop-filter: blur(5px); z-index: 9000;
            display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; transition: opacity 0.22s ease;
            padding: 16px;
        }
        .modal-overlay.open { opacity: 1; pointer-events: all; }
        .modal-box {
            background: white; border-radius: 20px;
            box-shadow: 0 32px 80px rgba(0,0,0,0.22);
            width: 95%; max-width: 700px; max-height: 92vh;
            overflow-y: auto; transform: scale(0.96) translateY(12px);
            transition: transform 0.22s ease;
            scrollbar-width: thin; scrollbar-color: #c7d2fe transparent;
        }
        .modal-overlay.open .modal-box { transform: scale(1) translateY(0); }
        .modal-box::-webkit-scrollbar { width: 4px; }
        .modal-box::-webkit-scrollbar-thumb { background: #c7d2fe; border-radius: 4px; }
        .modal-box-sm { max-width: 460px; }
        .modal-box-lg { max-width: 860px; }

        /* Badges */
        .badge { display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:700; padding:2px 8px; border-radius:99px; text-transform:uppercase; letter-spacing:.04em; }
        .badge-easy      { background:#dcfce7; color:#166534; }
        .badge-average   { background:#fef9c3; color:#854d0e; }
        .badge-difficult { background:#fee2e2; color:#991b1b; }
        .badge-standard  { background:#dbeafe; color:#1e40af; }
        .badge-periodic  { background:#e0f2fe; color:#0c4a6e; }
        .badge-numeric   { background:#fef3c7; color:#92400e; }
        .badge-mechanic  { background:#ede9fe; color:#5b21b6; }
        .badge-pre       { background:#dbeafe; color:#1e40af; }
        .badge-post      { background:#d1fae5; color:#065f46; }
        .badge-quiz      { background:#fef3c7; color:#92400e; }
        .badge-competitive { background:#fce7f3; color:#9d174d; }
        .badge-approved  { background:#d1fae5; color:#065f46; }
        .badge-pending   { background:#fef3c7; color:#92400e; }
        .badge-rejected  { background:#fee2e2; color:#991b1b; }

        /* Form input */
        .fi {
            width:100%; padding:10px 14px; border-radius:12px;
            border:1.5px solid #e2e8f0; font-size:14px;
            background:white; font-family:inherit;
            transition: box-shadow 0.18s, border-color 0.18s;
        }
        .fi:focus { box-shadow:0 0 0 3px rgba(6,182,212,0.18); border-color:#06b6d4; outline:none; }
        .fi.invalid { border-color:#ef4444 !important; box-shadow:0 0 0 3px rgba(239,68,68,0.15) !important; }
        .fi option { background:white; }

        /* Field error text */
        .ferr { display:none; color:#ef4444; font-size:11px; font-weight:700; margin-top:3px; }
        .ferr.show { display:block; }

        /* Action icon buttons */
        .btn-icon { width:30px; height:30px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; transition:all .15s; font-size:12px; cursor:pointer; border:none; }
        .btn-icon:hover { transform:scale(1.12); }
        .btn-edit    { background:#e0f2fe; color:#0369a1; }
        .btn-delete  { background:#fee2e2; color:#dc2626; }
        .btn-view    { background:#ede9fe; color:#7c3aed; }
        .btn-link    { background:#d1fae5; color:#065f46; }
        .btn-lock    { background:#fef3c7; color:#d97706; }

        /* Table scroll */
        .table-wrap { overflow-x:auto; }
        .table-wrap::-webkit-scrollbar { height:3px; }
        .table-wrap::-webkit-scrollbar-thumb { background:#c7d2fe; border-radius:2px; }
        .tbl-scroll { max-height:340px; overflow-y:auto; }
        .tbl-scroll::-webkit-scrollbar { width:3px; }
        .tbl-scroll::-webkit-scrollbar-thumb { background:#c7d2fe; border-radius:2px; }

        /* Progress bar */
        .progress-bar  { height:4px; border-radius:2px; background:#e2e8f0; }
        .progress-fill { height:100%; border-radius:2px; background:linear-gradient(90deg,#06b6d4,#6366f1); }

        /* Toast */
        #toast {
            position:fixed; bottom:28px; right:28px; z-index:99999;
            padding:14px 22px; border-radius:14px; font-weight:700; font-size:14px;
            display:flex; align-items:center; gap:10px;
            box-shadow:0 8px 30px rgba(0,0,0,.18);
            transform:translateY(80px); opacity:0; pointer-events:none;
            transition:all .3s cubic-bezier(.34,1.56,.64,1); min-width:240px;
        }
        #toast.show    { transform:translateY(0); opacity:1; }
        #toast.success { background:#10b981; color:white; }
        #toast.error   { background:#ef4444; color:white; }
        #toast.info    { background:#6366f1; color:white; }
        #toast.warning { background:#f59e0b; color:white; }

        /* Filter pills */
        .filter-pill { cursor:pointer; padding:6px 14px; border-radius:8px; font-size:12px; font-weight:700; transition:all .15s; border:2px solid transparent; color:#64748b; }
        .filter-pill:hover { border-color:#c7d2fe; }
        .filter-pill.active { border-color:#6366f1; background:#eef2ff; color:#4338ca; }

        /* Drop zone */
        .drop-zone { border:2.5px dashed #c7d2fe; border-radius:16px; transition:all .2s; cursor:pointer; }
        .drop-zone.dragover { border-color:#6366f1; background:#eef2ff; }

        /* Preflight rows */
        .preflight-ok  { background:#f0fdf4; border-left:3px solid #10b981; }
        .preflight-err { background:#fff1f2; border-left:3px solid #ef4444; }

        /* Sequence builder */
        .seq-row { background:#f8fafc; border:1.5px solid #e2e8f0; border-radius:10px; padding:10px 14px; display:flex; align-items:center; gap:10px; }
        .drag-handle { cursor:grab; color:#94a3b8; }
        .drag-handle:active { cursor:grabbing; }

        /* Formula preview */
        .formula-preview {
            background:#eff6ff; border:1.5px solid #bfdbfe;
            border-radius:10px; padding:10px 16px; font-size:20px;
            min-height:48px; text-align:center; letter-spacing:2px;
            color:#1e40af; font-weight:700;
        }

        /* Mode field toggle */
        .mode-field { display:none; }
        .mode-field.visible { display:block; }

        /* Section label */
        .section-label {
            font-size:10px; font-weight:800; letter-spacing:.1em;
            text-transform:uppercase; color:#06b6d4;
            display:flex; align-items:center; gap:6px;
        }

        /* Veri sub-tabs */
        .veri-tab-content { display: none; }
        .veri-tab-content.veri-active { display: block; }

        /* Import log terminal */
        #importLog { font-family: monospace; }
    </style>
</head>
<body class="text-slate-900">
<div class="flex min-h-screen relative overflow-x-hidden">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-cyan-900/50 z-40 hidden md:hidden"></div>

    <!-- ══════════════════ SIDEBAR ══════════════════ -->
    <aside id="sidebar" class="bg-indigo-950 text-white w-64 flex-shrink-0 flex flex-col z-50 fixed inset-y-0 left-0 -translate-x-full md:translate-x-0 h-screen border-r border-indigo-800/50">
        <div class="pt-8 pb-4 px-4 flex flex-col items-center text-center relative">
            <!-- Mobile close button -->
            <button onclick="toggleSidebar()" class="md:hidden text-indigo-300 hover:text-white absolute top-4 right-4">
                <i class="fas fa-times text-xl"></i>
            </button>

            <!-- Logo -->
            <img src="/assets/logo.png" alt="ChemArcade Logo" class="w-16 h-16 object-contain mb-3">

            <!-- Brand name -->
            <h1 class="text-xl font-black tracking-tighter text-cyan-400 uppercase italic leading-none">
                Elem<span class="text-white">enta</span>
            </h1>
            <p class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest mt-1">Admin Console</p>

            <!-- Divider -->
            <!-- <div class="w-full mt-5 border-t border-indigo-800/60"></div> -->
        </div>
        <nav class="flex-1 px-4 mt-4 space-y-6 overflow-y-auto no-scrollbar pb-6">
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Main Interface</p>
                <a href="/admin/dashboard" class="flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white hover:bg-white/10 group">
                    <i class="fas fa-chart-pie w-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
                    <span class="font-bold tracking-tight text-sm">Main Dashboard</span>
                </a>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Administrative</p>
                <div class="space-y-1">
                    <a href="/admin/user_access_control" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-users w-5 text-sky-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">User & Access Control</span>
                    </a>
                    <a href="/admin/academic_management" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-graduation-cap w-5 text-emerald-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Academic Management</span>
                    </a>
                </div>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Learning Assets</p>
                <div class="space-y-1">
                    <a href="/admin/gaming_question_bank" class="nav-active flex items-center gap-3 p-3 rounded-xl transition group">
                        <i class="fas fa-gamepad w-5 text-amber-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Gaming & Q-Bank</span>
                    </a>
                    <a href="/admin/resources_engagement" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-lightbulb w-5 text-lime-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Resources & Engagement</span>
                    </a>
                </div>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">System Health</p>
                <div class="space-y-1">
                    <a href="/admin/reports_monitoring" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-chart-line w-5 text-blue-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Reports & Monitoring</span>
                    </a>
                    <a href="/admin/system_audit" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-fingerprint w-5 text-indigo-300 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">System Audit</span>
                    </a>
                </div>
            </div>
        </nav>
        <div class="p-4 border-t border-indigo-800">
            <a href="/logout" class="flex items-center gap-3 p-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition font-bold">
                <i class="fas fa-right-from-bracket w-5"></i> Log Out
            </a>
        </div>
    </aside>

    <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
    <main class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- Fixed header -->
        <header class="h-20 bg-white/90 backdrop-blur-md border-b border-cyan-100 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-cyan-50 text-cyan-600 md:hidden"><i class="fas fa-bars text-xl"></i></button>
                <div>
                    <h2 class="text-lg font-bold text-indigo-900 uppercase tracking-tight flex items-center gap-2">
                        <i class="fas fa-gamepad text-amber-500"></i> Gaming &amp; Q-Bank
                    </h2>
                    <p class="text-xs text-slate-400 hidden sm:block"><i class="fas fa-circle text-green-400 text-[8px] mr-1"></i>Assessments · Questions · Hardware · Remediation · Bulk Import</p>
                </div>
            </div>
            <div class="flex items-center gap-3 md:gap-6">
                <!-- Notification bell -->
                <div id="notifBellBtn" class="relative cursor-pointer p-2 hover:bg-cyan-50 rounded-full transition" onclick="toggleNotifPanel()">
                    <i class="far fa-bell text-xl text-cyan-600"></i>
                    <span id="notifDot" class="absolute top-2 right-2 flex h-2.5 w-2.5 hidden">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                    </span>
                    <span id="notifCount" class="absolute -top-0.5 -right-0.5 hidden bg-rose-500 text-white text-[9px] font-black rounded-full w-4 h-4 flex items-center justify-center"></span>
                </div>

                <!-- Admin profile -->
                <div class="flex items-center gap-3 pl-4 border-l border-cyan-100">
                    <div class="text-right hidden lg:block">
                        <p class="text-sm font-bold text-indigo-900"><%= user.first_name %> <%= user.last_name %></p>
                        <p class="text-[10px] uppercase font-black text-rose-500 tracking-widest">Administrator</p>
                    </div>
                    <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                         class="w-10 h-10 rounded-xl object-cover ring-2 ring-rose-400 shadow-sm">
                </div>
            </div>
        </header>

        <!-- Scrollable content -->
        <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
            <div class="p-4 md:p-8 flex-1 fade-in">

                <!-- ── KPI STAT CARDS ── -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="stat-card glass-card rounded-2xl p-5 border border-amber-100 shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center"><i class="fas fa-clipboard-list text-amber-600"></i></div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Assessments</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= gqStats.totalAssessments %></p>
                        <div class="progress-bar mt-3"><div class="progress-fill" style="width:100%;background:linear-gradient(90deg,#f59e0b,#fbbf24)"></div></div>
                    </div>
                    <div class="stat-card glass-card rounded-2xl p-5 border border-sky-100 shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-sky-100 flex items-center justify-center"><i class="fas fa-atom text-sky-600"></i></div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Questions</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= gqStats.totalQuestions %></p>
                        <div class="progress-bar mt-3"><div class="progress-fill" style="width:100%"></div></div>
                    </div>
                    <div class="stat-card glass-card rounded-2xl p-5 border border-violet-100 shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-violet-100 flex items-center justify-center"><i class="fas fa-microchip text-violet-600"></i></div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Pin Mappings</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= gqStats.totalMappings %></p>
                        <div class="progress-bar mt-3"><div class="progress-fill" style="width:100%;background:linear-gradient(90deg,#7c3aed,#8b5cf6)"></div></div>
                    </div>
                    <div class="stat-card glass-card rounded-2xl p-5 border border-emerald-100 shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center"><i class="fas fa-stethoscope text-emerald-600"></i></div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Remediation</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= gqStats.totalRemediation %></p>
                        <div class="progress-bar mt-3"><div class="progress-fill" style="width:100%;background:linear-gradient(90deg,#10b981,#34d399)"></div></div>
                    </div>
                </div>

                <!-- ── MAIN TABS ── -->
                <div class="glass-card rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                    <div class="flex items-center gap-2 p-4 border-b border-slate-100 flex-wrap">
                        <button class="tab-btn active flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchTab('tab-assessments',this)">
                            <i class="fas fa-clipboard-list text-amber-500"></i> Assessments
                        </button>
                        <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchTab('tab-questions',this)">
                            <i class="fas fa-atom text-sky-500"></i> Question Bank
                        </button>
                        <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchTab('tab-hardware',this)">
                            <i class="fas fa-microchip text-violet-500"></i> Hardware Mapper
                        </button>
                        <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchTab('tab-remediation',this)">
                            <i class="fas fa-stethoscope text-emerald-500"></i> Remediation
                        </button>
                        <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchTab('tab-bulk',this)">
                            <i class="fas fa-file-excel text-green-600"></i> Bulk Import
                        </button>
                        <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchTab('tab-verification',this)">
                            <i class="fas fa-shield-check text-indigo-500"></i> Verification
                            <% const pendingCount = pendingQuestions.filter(q => q.verification_status === 'Pending').length; %>
                            <% if (pendingCount > 0) { %>
                            <span class="ml-1 bg-amber-400 text-white text-[10px] font-black px-2 py-0.5 rounded-full"><%= pendingCount %></span>
                            <% } %>
                        </button>
                    </div>

                    <!-- ══ TAB 1 — ASSESSMENTS ══ -->
                    <div id="tab-assessments" class="tab-content active p-5">
                        <div class="flex flex-col md:flex-row gap-3 mb-5 justify-between items-start md:items-center">
                            <div>
                                <p class="font-black text-indigo-900 text-base">Assessment Registry</p>
                                <p class="text-xs text-slate-400 mt-0.5">Manage quiz/exam containers linked to topics and quarters.</p>
                            </div>
                            <button onclick="openModal('modalAddAssessment')"
                                class="flex items-center gap-2 bg-gradient-to-r from-amber-500 to-orange-500 text-white font-bold text-sm px-4 py-2.5 rounded-xl hover:opacity-90 transition shadow-md whitespace-nowrap">
                                <i class="fas fa-plus"></i> New Assessment
                            </button>
                        </div>
                        <div class="table-wrap rounded-xl border border-slate-100">
                            <table class="data-table w-full text-sm">
                                <thead>
                                    <tr class="border-b border-slate-100">
                                        <th class="p-3 text-left">Assessment</th>
                                        <th class="p-3 text-left hidden md:table-cell">Type</th>
                                        <th class="p-3 text-left hidden lg:table-cell">Topic</th>
                                        <th class="p-3 text-left hidden lg:table-cell">Timer</th>
                                        <th class="p-3 text-left hidden xl:table-cell">Items / Duration</th>
                                        <th class="p-3 text-left hidden md:table-cell">Status</th>
                                        <th class="p-3 text-left hidden md:table-cell">Due</th>
                                        <th class="p-3 text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                <% assessments.forEach(function(a) { %>
                                <tr class="border-b border-slate-50">
                                    <td class="p-3">
                                        <p class="font-bold text-slate-800 text-sm leading-tight"><%= a.assessment_name || '(Unnamed)' %></p>
                                        <p class="text-[10px] text-slate-400 font-mono">#<%= a.assessment_id %></p>
                                    </td>
                                    <td class="p-3 hidden md:table-cell">
                                        <span class="badge badge-<%= (a.assessment_type||'quiz').toLowerCase().replace('-','').replace(' ','') %>"><%= a.assessment_type %></span>
                                    </td>
                                    <td class="p-3 hidden lg:table-cell text-xs text-slate-500"><%= a.topic_name || '—' %></td>
                                    <td class="p-3 hidden lg:table-cell">
                                        <span class="text-xs font-bold <%= a.timer_type === 'PerItem' ? 'text-amber-600' : 'text-indigo-600' %>">
                                            <i class="fas fa-clock mr-1"></i><%= a.timer_type %>
                                        </span>
                                    </td>
                                    <td class="p-3 hidden xl:table-cell text-xs">
                                        <div class="text-slate-700"><%= a.total_items %> items</div>
                                        <div class="text-slate-400"><%= a.duration_minutes %> min</div>
                                    </td>
                                    <td class="p-3 hidden md:table-cell">
                                        <% if (a.is_unlocked) { %>
                                        <span class="text-xs font-bold text-emerald-600"><i class="fas fa-lock-open mr-1"></i>Unlocked</span>
                                        <% } else { %>
                                        <span class="text-xs font-bold text-rose-500"><i class="fas fa-lock mr-1"></i>Locked</span>
                                        <% } %>
                                    </td>
                                    <td class="p-3 hidden md:table-cell text-xs text-slate-400">
                                        <%= a.due_date ? new Date(a.due_date).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—' %>
                                    </td>
                                    <td class="p-3">
                                        <div class="flex items-center justify-center gap-1">
                                            <button class="btn-icon btn-edit" title="Edit" onclick='openEditAssessment(<%- JSON.stringify(a) %>)'><i class="fas fa-pen"></i></button>
                                            <button class="btn-icon btn-lock" title="Toggle Lock" onclick="toggleLock(<%= a.assessment_id %>, <%= a.is_unlocked ? 1 : 0 %>)">
                                                <i class="fas <%= a.is_unlocked ? 'fa-lock' : 'fa-lock-open' %>"></i>
                                            </button>
                                            <button class="btn-icon btn-delete" title="Delete" onclick="confirmDeleteAssessment(<%= a.assessment_id %>, '<%- (a.assessment_name||'').replace(/'/g, '\\x27') %>')"><i class="fas fa-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                </tbody>
                            </table>
                            <% if (assessments.length === 0) { %>
                            <div class="py-16 text-center text-slate-400">
                                <i class="fas fa-clipboard-list text-4xl mb-3 block opacity-30"></i>
                                <p class="font-bold">No assessments yet.</p>
                            </div>
                            <% } %>
                        </div>
                    </div>

                    <!-- ══ TAB 2 — QUESTION BANK ══ -->
                    <div id="tab-questions" class="tab-content p-5">
                        <div class="flex flex-col md:flex-row gap-3 mb-5">
                            <div class="relative flex-1">
                                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                                <input id="qSearch" type="text" placeholder="Search questions, topics…" class="fi pl-9" oninput="filterQuestions()">
                            </div>
                            <div class="flex items-center gap-2 flex-wrap">
                                <span onclick="setQFilter('all','difficulty',this)" class="filter-pill active" data-group="difficulty">All</span>
                                <span onclick="setQFilter('Easy','difficulty',this)" class="filter-pill" data-group="difficulty"><i class="fas fa-circle text-emerald-400 text-[8px] mr-1"></i>Easy</span>
                                <span onclick="setQFilter('Average','difficulty',this)" class="filter-pill" data-group="difficulty"><i class="fas fa-circle text-amber-400 text-[8px] mr-1"></i>Average</span>
                                <span onclick="setQFilter('Difficult','difficulty',this)" class="filter-pill" data-group="difficulty"><i class="fas fa-circle text-rose-400 text-[8px] mr-1"></i>Hard</span>
                            </div>
                            <div class="flex items-center gap-2 flex-wrap">
                                <span onclick="setQFilter('all','mode',this)" class="filter-pill active" data-group="mode">All Modes</span>
                                <span onclick="setQFilter('Standard','mode',this)" class="filter-pill" data-group="mode">Standard</span>
                                <span onclick="setQFilter('Periodic_Single','mode',this)" class="filter-pill" data-group="mode">Periodic</span>
                                <span onclick="setQFilter('Numeric','mode',this)" class="filter-pill" data-group="mode">Numeric</span>
                            </div>
                            <button onclick="openAddQuestion()"
                                class="flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-indigo-500 text-white font-bold text-sm px-4 py-2.5 rounded-xl hover:opacity-90 transition shadow-md whitespace-nowrap">
                                <i class="fas fa-plus"></i> New Question
                            </button>
                        </div>
                        <div class="table-wrap rounded-xl border border-slate-100">
                            <div class="tbl-scroll">
                            <table class="data-table w-full text-sm">
                                <thead>
                                    <tr class="border-b border-slate-100">
                                        <th class="p-3 text-left">Question</th>
                                        <th class="p-3 text-left hidden md:table-cell">Difficulty</th>
                                        <th class="p-3 text-left hidden lg:table-cell">Mode</th>
                                        <th class="p-3 text-left hidden lg:table-cell">Mechanic</th>
                                        <th class="p-3 text-left hidden xl:table-cell">Topic</th>
                                        <th class="p-3 text-left hidden md:table-cell">EXP</th>
                                        <th class="p-3 text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="questionTableBody">
                                <% questions.forEach(function(q) { %>
                                <tr class="q-row border-b border-slate-50"
                                    data-difficulty="<%= q.difficulty %>"
                                    data-mode="<%= q.input_mode %>"
                                    data-search="<%= (q.question_text+' '+(q.topic_name||'')).toLowerCase() %>">
                                    <td class="p-3" style="max-width:260px;">
                                        <p class="font-medium text-slate-700 text-xs leading-snug line-clamp-2"><%= q.question_text %></p>
                                        <div class="flex items-center gap-2 mt-1">
                                            <% if (q.is_ai_generated) { %><span class="text-[9px] font-bold text-violet-600 border border-violet-300 bg-violet-50 px-1.5 py-0.5 rounded-md">AI</span><% } %>
                                            <span class="text-[9px] text-slate-400 font-mono">#<%= q.question_id %></span>
                                        </div>
                                    </td>
                                    <td class="p-3 hidden md:table-cell"><span class="badge badge-<%= q.difficulty.toLowerCase() %>"><%= q.difficulty %></span></td>
                                    <td class="p-3 hidden lg:table-cell">
                                        <span class="badge badge-<%= q.input_mode === 'Standard' ? 'standard' : q.input_mode.startsWith('Periodic') ? 'periodic' : 'numeric' %>">
                                            <%= q.input_mode.replace(/_/g,' ') %>
                                        </span>
                                    </td>
                                    <td class="p-3 hidden lg:table-cell"><span class="badge badge-mechanic text-[9px]"><%= q.mechanic_type.replace(/_/g,' ') %></span></td>
                                    <td class="p-3 hidden xl:table-cell text-xs text-slate-400"><%= q.topic_name || '—' %></td>
                                    <td class="p-3 hidden md:table-cell"><span class="text-xs font-bold text-amber-600"><i class="fas fa-star mr-1 text-[9px]"></i><%= q.base_exp %></span></td>
                                    <td class="p-3">
                                        <div class="flex items-center justify-center gap-1">
                                            <button class="btn-icon btn-edit" title="Edit" onclick='openEditQuestion(<%- JSON.stringify(q) %>)'><i class="fas fa-pen"></i></button>
                                            <button class="btn-icon btn-link" title="Remediation" onclick="openRemModal(<%= q.question_id %>, '<%- (q.question_text||'').substring(0,40).replace(/'/g, '\\x27') %>')"><i class="fas fa-stethoscope"></i></button>
                                            <button class="btn-icon btn-delete" title="Delete" onclick="confirmDeleteQuestion(<%= q.question_id %>, '<%- (q.question_text||'').substring(0,30).replace(/'/g, '\\x27') %>')"><i class="fas fa-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                </tbody>
                            </table>
                            </div>
                            <% if (questions.length === 0) { %>
                            <div class="py-16 text-center text-slate-400"><i class="fas fa-atom text-4xl mb-3 block opacity-30"></i><p class="font-bold">No questions yet.</p></div>
                            <% } %>
                        </div>
                        <div class="mt-3 text-xs text-slate-400 px-1"><span id="qCountLabel">Showing <%= questions.length %> question(s)</span></div>
                    </div>

                    <!-- ══ TAB 3 — HARDWARE MAPPER ══ -->
                    <div id="tab-hardware" class="tab-content p-5">
                        <div class="flex flex-col md:flex-row gap-3 mb-5 justify-between items-start md:items-center">
                            <div>
                                <p class="font-black text-indigo-900 text-base">Arcade Hardware Mapper</p>
                                <p class="text-xs text-slate-400 mt-0.5">Configure GPIO pin → element symbol mappings for the physical arcade board.</p>
                            </div>
                            <button onclick="openModal('modalAddMapping')"
                                class="flex items-center gap-2 bg-gradient-to-r from-violet-600 to-indigo-500 text-white font-bold text-sm px-4 py-2.5 rounded-xl hover:opacity-90 transition shadow-md">
                                <i class="fas fa-plus"></i> Add Mapping
                            </button>
                        </div>
                        <div class="flex gap-3 mb-4">
                            <button onclick="filterPlayer(1,this)" class="filter-pill active">Player 1</button>
                            <button onclick="filterPlayer(2,this)" class="filter-pill">Player 2</button>
                            <button onclick="filterPlayer(0,this)" class="filter-pill">All</button>
                        </div>
                        <div class="table-wrap rounded-xl border border-slate-100">
                            <table class="data-table w-full text-sm">
                                <thead><tr class="border-b border-slate-100"><th class="p-3 text-left">GPIO Pin</th><th class="p-3 text-left">Element Symbol</th><th class="p-3 text-left">Player Side</th><th class="p-3 text-center">Actions</th></tr></thead>
                                <tbody id="hwTableBody">
                                <% buttonMappings.forEach(function(bm) { %>
                                <tr class="hw-row border-b border-slate-50" data-player="<%= bm.player_side %>">
                                    <td class="p-3"><span class="font-mono text-violet-700 font-bold text-sm">GPIO <%= bm.button_pin %></span></td>
                                    <td class="p-3"><span class="font-mono text-2xl font-black text-indigo-900"><%= bm.element_symbol %></span></td>
                                    <td class="p-3"><span class="badge badge-<%= bm.player_side === 1 ? 'pre' : 'post' %>">Player <%= bm.player_side %></span></td>
                                    <td class="p-3">
                                        <div class="flex items-center justify-center gap-1">
                                            <button class="btn-icon btn-edit" onclick='openEditMapping(<%- JSON.stringify(bm) %>)'><i class="fas fa-pen"></i></button>
                                            <button class="btn-icon btn-delete" onclick="confirmDeleteMapping(<%= bm.mapping_id %>, '<%= bm.element_symbol %>')"><i class="fas fa-trash"></i></button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                </tbody>
                            </table>
                            <% if (buttonMappings.length === 0) { %><div class="py-12 text-center text-slate-400"><i class="fas fa-microchip text-4xl mb-3 block opacity-30"></i><p class="font-bold">No pin mappings configured.</p></div><% } %>
                        </div>

                        <!-- Theme Switcher -->
                        <div class="mt-6 p-5 glass-card rounded-2xl border border-violet-100 shadow-sm">
                            <p class="font-black text-indigo-900 text-base mb-1 flex items-center gap-2"><i class="fas fa-palette text-violet-500"></i> Topic Theme Switcher</p>
                            <p class="text-xs text-slate-400 mb-4">Change the visual theme used during game sessions for a specific topic.</p>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Select Topic</label>
                                    <select id="themeTopicId" class="fi text-sm">
                                        <option value="">— Choose topic —</option>
                                        <% topics.forEach(function(t) { %><option value="<%= t.topic_id %>"><%= t.topic_name %> (Q<%= t.quarter_number %>)</option><% }) %>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Theme</label>
                                    <select id="themeId" class="fi text-sm">
                                        <option value="default_lab">default_lab</option>
                                        <option value="neon_reactor">neon_reactor</option>
                                        <option value="space_chem">space_chem</option>
                                        <option value="bio_hazard">bio_hazard</option>
                                        <option value="crystal_cave">crystal_cave</option>
                                    </select>
                                </div>
                                <div class="flex items-end">
                                    <button onclick="saveTheme()" class="w-full bg-gradient-to-r from-violet-600 to-indigo-500 text-white font-bold text-sm px-4 py-2.5 rounded-xl hover:opacity-90 transition shadow-md">
                                        <i class="fas fa-paint-brush mr-1"></i> Apply Theme
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ══ TAB 4 — REMEDIATION ══ -->
                    <div id="tab-remediation" class="tab-content p-5">
                        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                            <div>
                                <p class="font-black text-indigo-900 text-base mb-4 flex items-center gap-2"><i class="fas fa-stethoscope text-emerald-500"></i> Remediation Links</p>
                                <div class="table-wrap rounded-xl border border-slate-100">
                                    <div class="tbl-scroll">
                                    <table class="data-table w-full text-sm">
                                        <thead><tr class="border-b border-slate-100"><th class="p-3 text-left">Question</th><th class="p-3 text-left">Material / Advice</th><th class="p-3 text-center">Actions</th></tr></thead>
                                        <tbody>
                                        <% remediationList.forEach(function(r) { %>
                                        <tr class="border-b border-slate-50">
                                            <td class="p-3 text-xs text-slate-500" style="max-width:160px;">
                                                <p class="line-clamp-2"><%= (r.question_text||'').substring(0,60) %>…</p>
                                                <p class="text-[10px] text-slate-400 font-mono mt-0.5">#Q<%= r.question_id %></p>
                                            </td>
                                            <td class="p-3 text-xs">
                                                <% if (r.material_title) { %><p class="text-emerald-700 font-bold"><%= r.material_title %></p><% } %>
                                                <% if (r.advice_text) { %><p class="text-slate-500 mt-0.5 line-clamp-1"><%= r.advice_text.substring(0,50) %></p><% } %>
                                                <% if (r.link_url) { %><a href="<%= r.link_url %>" target="_blank" class="text-indigo-500 text-[10px] hover:underline"><i class="fas fa-link mr-1"></i>Link</a><% } %>
                                            </td>
                                            <td class="p-3">
                                                <div class="flex items-center justify-center gap-1">
                                                    <button class="btn-icon btn-edit" onclick='openEditRemediation(<%- JSON.stringify(r) %>)'><i class="fas fa-pen"></i></button>
                                                    <button class="btn-icon btn-delete" onclick="confirmDeleteRem(<%= r.rem_id %>)"><i class="fas fa-trash"></i></button>
                                                </div>
                                            </td>
                                        </tr>
                                        <% }) %>
                                        </tbody>
                                    </table>
                                    </div>
                                    <% if (remediationList.length === 0) { %><div class="py-10 text-center text-slate-400 text-sm">No remediation links yet.</div><% } %>
                                </div>
                            </div>
                            <div>
                                <p class="font-black text-indigo-900 text-base mb-4 flex items-center gap-2"><i class="fas fa-wave-square text-cyan-500"></i> Material Interaction Stream</p>
                                <div class="table-wrap rounded-xl border border-slate-100">
                                    <div class="tbl-scroll">
                                    <table class="data-table w-full text-sm">
                                        <thead><tr class="border-b border-slate-100"><th class="p-3 text-left">Student</th><th class="p-3 text-left">Material</th><th class="p-3 text-left">Type</th><th class="p-3 text-left">When</th></tr></thead>
                                        <tbody>
                                        <% interactionLog.forEach(function(il) { %>
                                        <tr class="border-b border-slate-50">
                                            <td class="p-3 text-xs text-slate-700"><%= il.student_name %></td>
                                            <td class="p-3 text-xs text-slate-500 max-w-[120px]"><p class="line-clamp-1"><%= il.material_title || '—' %></p></td>
                                            <td class="p-3"><span class="badge badge-<%= il.interaction_type === 'viewed' ? 'pre' : 'post' %>"><%= il.interaction_type %></span></td>
                                            <td class="p-3 text-[10px] text-slate-400">
                                                <%= new Date(il.interacted_at).toLocaleDateString('en-PH',{month:'short',day:'numeric'}) %><br>
                                                <%= new Date(il.interacted_at).toLocaleTimeString('en-PH',{hour:'2-digit',minute:'2-digit'}) %>
                                            </td>
                                        </tr>
                                        <% }) %>
                                        </tbody>
                                    </table>
                                    </div>
                                    <% if (interactionLog.length === 0) { %><div class="py-10 text-center text-slate-400 text-sm">No interactions yet.</div><% } %>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ══ TAB 5 — BULK IMPORT ══ -->
                    <div id="tab-bulk" class="tab-content p-5">

                        <!-- Info banner -->
                        <div class="mb-5 p-4 bg-indigo-50 border border-indigo-100 rounded-xl flex items-start gap-3">
                            <i class="fas fa-circle-info text-indigo-400 mt-0.5 text-lg"></i>
                            <div class="text-sm">
                                <p class="font-bold text-indigo-800">Admin Bulk Import — Auto-Approved</p>
                                <p class="text-indigo-500 mt-0.5 text-xs">Questions imported by an admin are automatically approved and skip the verification queue. Every row undergoes strict pre-flight validation before insertion.</p>
                            </div>
                        </div>

                        <!-- Validation matrix -->
                        <div class="mb-5 p-4 glass-card rounded-xl border border-slate-100 shadow-sm">
                            <p class="font-bold text-indigo-900 text-sm mb-3 flex items-center gap-2"><i class="fas fa-shield-check text-indigo-500"></i> Pre-flight Validation Checks</p>
                            <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
                                <div class="p-2.5 rounded-lg bg-sky-50 border border-sky-100"><span class="font-bold text-sky-700">Required columns:</span> <span class="text-slate-500">question_text, topic_id, difficulty, input_mode, mechanic_type — all must be present and non-empty</span></div>
                                <div class="p-2.5 rounded-lg bg-rose-50 border border-rose-100"><span class="font-bold text-rose-600">Duplicate check:</span> <span class="text-slate-500">Exact match vs existing DB questions AND within the file itself</span></div>
                                <div class="p-2.5 rounded-lg bg-indigo-50 border border-indigo-100"><span class="font-bold text-indigo-700">Standard MCQ:</span> <span class="text-slate-500">correct_answer must be A/B/C/D; all four options required</span></div>
                                <div class="p-2.5 rounded-lg bg-cyan-50 border border-cyan-100"><span class="font-bold text-cyan-700">Periodic_Single:</span> <span class="text-slate-500">element_symbol must exist in button_mappings</span></div>
                                <div class="p-2.5 rounded-lg bg-amber-50 border border-amber-100"><span class="font-bold text-amber-700">Numeric:</span> <span class="text-slate-500">numeric_answer required (number); numeric_tolerance optional</span></div>
                                <div class="p-2.5 rounded-lg bg-emerald-50 border border-emerald-100"><span class="font-bold text-emerald-700">Periodic_Sequence:</span> <span class="text-slate-500">sequence column format: H:2,O:1 (Symbol:Subscript pairs)</span></div>
                                <div class="p-2.5 rounded-lg bg-violet-50 border border-violet-100"><span class="font-bold text-violet-700">Enum check:</span> <span class="text-slate-500">difficulty, input_mode, mechanic_type must match valid values exactly</span></div>
                                <div class="p-2.5 rounded-lg bg-slate-50 border border-slate-100"><span class="font-bold text-slate-700">Topic ID:</span> <span class="text-slate-500">topic_id must exist in the topics table</span></div>
                            </div>
                        </div>

                        <!-- Upload zone -->
                        <div class="bg-emerald-50 border border-emerald-100 rounded-2xl p-5 mb-5">
                            <h3 class="font-black text-emerald-900 text-base mb-1 flex items-center gap-2"><i class="fas fa-file-excel text-emerald-500"></i> Upload Question Bank Excel</h3>
                            <p class="text-xs text-slate-500 mb-4">Download the template, fill in your questions, then upload. Only valid rows will be imported.</p>
                            <div id="bulkDropZone" class="drop-zone p-8 text-center mb-4"
                                 onclick="document.getElementById('bulkFile').click()"
                                 ondragover="event.preventDefault();this.classList.add('dragover')"
                                 ondragleave="this.classList.remove('dragover')"
                                 ondrop="handleBulkDrop(event)">
                                <i class="fas fa-file-excel text-5xl text-emerald-300 mb-3 block"></i>
                                <p class="font-bold text-emerald-700">Drop Excel file here or click to browse</p>
                                <p class="text-xs text-slate-400 mt-1">.xlsx / .xls · max 500 rows</p>
                            </div>
                            <input type="file" id="bulkFile" accept=".xlsx,.xls" class="hidden" onchange="handleBulkSelect(this)">
                            <div id="bulkFilePreview" class="hidden mb-4"></div>
                            <div class="flex items-center gap-3 flex-wrap">
                                <button onclick="downloadQBTemplate()"
                                    class="flex items-center gap-2 text-xs font-bold border border-emerald-300 text-emerald-700 px-4 py-2 rounded-xl hover:bg-emerald-100 transition">
                                    <i class="fas fa-download"></i> Download Template
                                </button>
                                <button id="btnPreflightCheck" disabled onclick="runPreflightCheck()"
                                    class="flex items-center gap-2 text-xs font-bold bg-amber-500 text-white px-4 py-2 rounded-xl hover:bg-amber-600 transition disabled:opacity-40 disabled:cursor-not-allowed">
                                    <i class="fas fa-search"></i> Run Pre-flight Check
                                </button>
                                <button id="btnImportQuestions" disabled onclick="importQuestions()"
                                    class="flex items-center gap-2 text-xs font-bold bg-gradient-to-r from-cyan-500 to-indigo-500 text-white px-4 py-2 rounded-xl hover:opacity-90 transition disabled:opacity-40 disabled:cursor-not-allowed shadow-md">
                                    <i class="fas fa-upload"></i> Import Valid Rows
                                </button>
                            </div>
                        </div>

                        <!-- Pre-flight results -->
                        <div id="preflightResult" class="hidden">
                            <p class="font-bold text-indigo-900 text-sm mb-3 flex items-center gap-2"><i class="fas fa-radar text-indigo-500"></i> Pre-flight Scan Results</p>
                            <div id="preflightSummary" class="hidden mb-3 p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs text-slate-700 flex gap-4 flex-wrap font-bold"></div>
                            <div class="table-wrap rounded-xl border border-slate-100">
                                <div class="tbl-scroll">
                                <table class="data-table w-full text-xs" id="preflightTable">
                                    <thead><tr class="border-b border-slate-100"><th class="p-2 text-left">Row</th><th class="p-2 text-left">Question (Short)</th><th class="p-2 text-left">Mode</th><th class="p-2 text-left">Mechanic</th><th class="p-2 text-left">Status</th><th class="p-2 text-left">Issue</th></tr></thead>
                                    <tbody id="preflightBody"></tbody>
                                </table>
                                </div>
                            </div>
                        </div>

                        <!-- Import log -->
                        <div id="importLog" class="hidden mt-4 bg-slate-900 rounded-2xl p-5 text-sm font-mono text-emerald-400 max-h-56 overflow-y-auto"></div>
                    </div>

                    <!-- ══ TAB 6 — VERIFICATION ══ -->
                    <div id="tab-verification" class="tab-content p-5 ">
                        <div class="flex flex-col md:flex-row gap-3 mb-5 justify-between items-start md:items-center">
                            <div>
                                <p class="font-black text-indigo-900 text-base">Question Verification Center</p>
                                <p class="text-xs text-slate-400 mt-0.5">Review teacher-submitted questions. Approve or reject with a reason. Admin-created questions are auto-approved.</p>
                            </div>
                        </div>
                        <div class="flex gap-2 mb-5 flex-wrap">
                            <button class="veri-tab-btn filter-pill active" onclick="switchVeriTab('veri-pending',this)">
                                <i class="fas fa-clock mr-1 text-amber-500"></i> Pending
                                <span class="ml-1 bg-amber-400 text-white text-[9px] font-black px-1.5 py-0.5 rounded-full"><%= pendingQuestions.filter(q => q.verification_status === 'Pending').length %></span>
                            </button>
                            <button class="veri-tab-btn filter-pill" onclick="switchVeriTab('veri-approved',this)">
                                <i class="fas fa-check-circle mr-1 text-emerald-500"></i> Approved
                                <span class="ml-1 bg-emerald-100 text-emerald-700 text-[9px] font-black px-1.5 py-0.5 rounded-full border border-emerald-200"><%= pendingQuestions.filter(q => q.verification_status === 'Approved').length %></span>
                            </button>
                            <button class="veri-tab-btn filter-pill" onclick="switchVeriTab('veri-rejected',this)">
                                <i class="fas fa-times-circle mr-1 text-rose-500"></i> Rejected
                                <span class="ml-1 bg-rose-100 text-rose-700 text-[9px] font-black px-1.5 py-0.5 rounded-full border border-rose-200"><%= pendingQuestions.filter(q => q.verification_status === 'Rejected').length %></span>
                            </button>
                        </div>

                        <!-- Pending -->
                        <div id="veri-pending" class="veri-tab-content veri-active">
                            <div class="table-wrap rounded-xl border border-amber-100">
                                <div class="tbl-scroll">
                                <table class="data-table w-full text-sm">
                                    <thead><tr class="border-b border-slate-100"><th class="p-3 text-left">Question</th><th class="p-3 text-left hidden md:table-cell">Topic</th><th class="p-3 text-left hidden lg:table-cell">Difficulty</th><th class="p-3 text-left hidden lg:table-cell">Mode</th><th class="p-3 text-left hidden md:table-cell">Submitted By</th><th class="p-3 text-center">Actions</th></tr></thead>
                                    <tbody>
                                    <% pendingQuestions.filter(q => q.verification_status === 'Pending').forEach(function(q) { %>
                                    <tr class="border-b border-slate-50">
                                        <td class="p-3" style="max-width:240px;"><p class="font-medium text-slate-700 text-xs line-clamp-2"><%= q.question_text %></p><span class="text-[9px] text-slate-400 font-mono">#<%= q.question_id %></span></td>
                                        <td class="p-3 hidden md:table-cell text-xs text-slate-400"><%= q.topic_name || '—' %></td>
                                        <td class="p-3 hidden lg:table-cell"><span class="badge badge-<%= q.difficulty.toLowerCase() %>"><%= q.difficulty %></span></td>
                                        <td class="p-3 hidden lg:table-cell"><span class="badge badge-<%= q.input_mode === 'Standard' ? 'standard' : q.input_mode.startsWith('Periodic') ? 'periodic' : 'numeric' %>"><%= q.input_mode.replace('_',' ') %></span></td>
                                        <td class="p-3 hidden md:table-cell text-xs text-slate-400"><%= q.teacher_name || '—' %></td>
                                        <td class="p-3">
                                            <div class="flex items-center justify-center gap-1">
                                                <button class="btn-icon btn-link" title="Approve" onclick="confirmApproveQuestion(<%= q.question_id %>, '<%- (q.question_text||'').substring(0,40).replace(/'/g, '\\x27') %>')"><i class="fas fa-check"></i></button>
                                                <button class="btn-icon btn-delete" title="Reject" onclick="openRejectModal(<%= q.question_id %>, '<%- (q.question_text||'').substring(0,40).replace(/'/g, '\\x27') %>')"><i class="fas fa-times"></i></button>
                                            </div>
                                        </td>
                                    </tr>
                                    <% }) %>
                                    </tbody>
                                </table>
                                </div>
                                <% if (pendingQuestions.filter(q => q.verification_status === 'Pending').length === 0) { %><div class="py-14 text-center text-slate-400"><i class="fas fa-check-double text-4xl mb-3 block opacity-30"></i><p class="font-bold text-emerald-600">No pending questions — all caught up!</p></div><% } %>
                            </div>
                        </div>

                        <!-- Approved -->
                        <div id="veri-approved" class="veri-tab-content hidden">
                            <div class="table-wrap rounded-xl border border-emerald-100">
                                <div class="tbl-scroll">
                                <table class="data-table w-full text-sm">
                                    <thead><tr class="border-b border-slate-100"><th class="p-3 text-left">Question</th><th class="p-3 text-left hidden md:table-cell">Topic</th><th class="p-3 text-left hidden lg:table-cell">Difficulty</th><th class="p-3 text-left hidden md:table-cell">Submitted By</th><th class="p-3 text-left hidden md:table-cell">Verified By</th><th class="p-3 text-left hidden lg:table-cell">Verified At</th></tr></thead>
                                    <tbody>
                                    <% pendingQuestions.filter(q => q.verification_status === 'Approved').forEach(function(q) { %>
                                    <tr class="border-b border-slate-50">
                                        <td class="p-3" style="max-width:220px;"><p class="font-medium text-slate-700 text-xs line-clamp-2"><%= q.question_text %></p><span class="text-[9px] text-slate-400 font-mono">#<%= q.question_id %></span></td>
                                        <td class="p-3 hidden md:table-cell text-xs text-slate-400"><%= q.topic_name || '—' %></td>
                                        <td class="p-3 hidden lg:table-cell"><span class="badge badge-<%= q.difficulty.toLowerCase() %>"><%= q.difficulty %></span></td>
                                        <td class="p-3 hidden md:table-cell text-xs text-slate-400"><%= q.teacher_name || '—' %></td>
                                        <td class="p-3 hidden md:table-cell"><span class="text-xs font-bold text-emerald-600"><i class="fas fa-shield-check mr-1"></i><%= q.verified_by_name || '—' %></span></td>
                                        <td class="p-3 hidden lg:table-cell text-xs text-slate-400"><%= q.verified_at ? new Date(q.verified_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—' %></td>
                                    </tr>
                                    <% }) %>
                                    </tbody>
                                </table>
                                </div>
                                <% if (pendingQuestions.filter(q => q.verification_status === 'Approved').length === 0) { %><div class="py-14 text-center text-slate-400"><i class="fas fa-check-circle text-4xl mb-3 block opacity-30"></i><p class="font-bold">No approved questions yet.</p></div><% } %>
                            </div>
                        </div>

                        <!-- Rejected -->
                        <div id="veri-rejected" class="veri-tab-content hidden">
                            <div class="table-wrap rounded-xl border border-rose-100">
                                <div class="tbl-scroll">
                                <table class="data-table w-full text-sm">
                                    <thead><tr class="border-b border-slate-100"><th class="p-3 text-left">Question</th><th class="p-3 text-left hidden md:table-cell">Topic</th><th class="p-3 text-left hidden md:table-cell">Submitted By</th><th class="p-3 text-left hidden md:table-cell">Verified By</th><th class="p-3 text-left">Rejection Reason</th></tr></thead>
                                    <tbody>
                                    <% pendingQuestions.filter(q => q.verification_status === 'Rejected').forEach(function(q) { %>
                                    <tr class="border-b border-slate-50">
                                        <td class="p-3" style="max-width:200px;"><p class="font-medium text-slate-700 text-xs line-clamp-2"><%= q.question_text %></p><span class="text-[9px] text-slate-400 font-mono">#<%= q.question_id %></span></td>
                                        <td class="p-3 hidden md:table-cell text-xs text-slate-400"><%= q.topic_name || '—' %></td>
                                        <td class="p-3 hidden md:table-cell text-xs text-slate-400"><%= q.teacher_name || '—' %></td>
                                        <td class="p-3 hidden md:table-cell"><span class="text-xs font-bold text-rose-500"><i class="fas fa-shield-check mr-1"></i><%= q.verified_by_name || '—' %></span></td>
                                        <td class="p-3" style="max-width:200px;"><p class="text-xs text-rose-600 line-clamp-3"><%= q.rejection_reason || '—' %></p></td>
                                    </tr>
                                    <% }) %>
                                    </tbody>
                                </table>
                                </div>
                                <% if (pendingQuestions.filter(q => q.verification_status === 'Rejected').length === 0) { %><div class="py-14 text-center text-slate-400"><i class="fas fa-times-circle text-4xl mb-3 block opacity-30"></i><p class="font-bold">No rejected questions.</p></div><% } %>
                            </div>
                        </div>
                    </div>

                </div><!-- /tabs card -->
            </div><!-- /p-8 -->

            <!-- Footer -->
            <footer class="bg-white border-t border-cyan-100 py-6 px-8 mt-auto w-full">
                <div class="flex flex-col md:flex-row justify-between items-center gap-2 max-w-[1600px] mx-auto">
                    <p class="text-[11px] text-indigo-400 font-black uppercase tracking-tight">&copy; 2026 <span class="text-cyan-600">Chemistry Arcade</span> — Mabini College v2.5.0</p>
                    <div class="flex gap-4">
                        <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest">Support Lab</a>
                        <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest border-l pl-4 border-indigo-100">Atomic Logs</a>
                    </div>
                </div>
            </footer>
        </div>
    </main>
</div>

