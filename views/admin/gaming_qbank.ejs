            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Topic *</label>
                <select id="asmTopicId" class="fi text-sm">
                    <option value="">— Select Topic —</option>
                    <% topics.forEach(function(t) { %><option value="<%= t.topic_id %>"><%= t.topic_name %> (Q<%= t.quarter_number %> — <%= t.subject_name %>)</option><% }) %>
