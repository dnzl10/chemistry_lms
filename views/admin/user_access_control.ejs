function toggleSubjectClasses(subjectId, selectAllCb) {
    const checkboxes = document.querySelectorAll(`.teacher-subj-cb-${subjectId}`);
    checkboxes.forEach(cb => {
        cb.checked = selectAllCb.checked;
    });
    updateTeacherHierarchySummary();
}

function toggleMasterAllTeacherClasses(masterCb) {
    const checkboxes = document.querySelectorAll('.teacher-class-cb');
    checkboxes.forEach(cb => {
        cb.checked = masterCb.checked;
    });
    updateTeacherHierarchySummary();
}

function updateTeacherHierarchySummary() {
    const allCbs = Array.from(document.querySelectorAll('.teacher-class-cb'));
    const selected = allCbs.filter(cb => cb.checked);
    const masterCb = document.getElementById('masterSelectAllTeacherClasses');
    const totalBadge = document.getElementById('teacherTotalSummaryBadge');
    const conflictNotice = document.getElementById('teacherClassesConflictNotice');
    const errClasses = document.getElementById('errInvTeacherClasses');

    if (errClasses && selected.length > 0) {
        errClasses.classList.remove('show');
    }

    // Calculate unique subjects selected
    const selectedSubjIds = new Set(selected.map(cb => cb.dataset.subjectId));

    if (totalBadge) {
        if (selected.length === 0) {
            totalBadge.textContent = '0 sections selected';
            totalBadge.className = 'text-[11px] font-bold text-slate-500 bg-slate-100 border border-slate-200 px-2.5 py-0.5 rounded-full';
        } else {
            totalBadge.textContent = `${selected.length} section${selected.length > 1 ? 's' : ''} across ${selectedSubjIds.size} subject${selectedSubjIds.size > 1 ? 's' : ''}`;
            totalBadge.className = 'text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full';
        }
    }

    // Update each subject group's Select All checkbox and counter badge
    if (_allSubjects && _allSubjects.length > 0) {
        _allSubjects.forEach(s => {
            const subjCbs = Array.from(document.querySelectorAll(`.teacher-subj-cb-${s.subject_id}`));
            const subjSel = subjCbs.filter(cb => cb.checked);
            const subjMaster = document.getElementById(`subjSelectAll_${s.subject_id}`);
            const subjBadge = document.getElementById(`subjBadge_${s.subject_id}`);

            if (subjBadge) {
                subjBadge.textContent = `${subjSel.length} / ${subjCbs.length} selected`;
                if (subjSel.length > 0) {
                    subjBadge.className = 'text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full';
                } else {
                    subjBadge.className = 'text-[10px] font-bold text-slate-500 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-full';
                }
            }

            if (subjMaster && subjCbs.length > 0) {
                subjMaster.checked = (subjSel.length === subjCbs.length);
                subjMaster.indeterminate = (subjSel.length > 0 && subjSel.length < subjCbs.length);
            }
        });
    }

    // Update Master Select All checkbox
    if (masterCb && allCbs.length > 0) {
        masterCb.checked = (selected.length === allCbs.length);
        masterCb.indeterminate = (selected.length > 0 && selected.length < allCbs.length);
    }

    // Check for conflicts
    const conflicted = selected.filter(cb => cb.dataset.hasTeacher === '1');
    if (conflictNotice) {
        if (conflicted.length > 0) {
            conflictNotice.classList.remove('hidden');
            conflictNotice.className = 'mt-2.5 p-2.5 rounded-xl text-xs border bg-amber-50 border-amber-300 text-amber-900 transition-all flex items-start gap-2';
            conflictNotice.innerHTML = `
                <i class="fas fa-triangle-exclamation text-amber-600 mt-0.5 text-sm shrink-0"></i>
                <div class="flex-1">
                    <p class="font-bold">${conflicted.length} selected section(s) currently have an assigned teacher:</p>
                    <ul class="list-disc list-inside mt-1 text-[11px] text-amber-800 space-y-0.5">
                        ${conflicted.map(cb => `<li><b>${cb.dataset.subjectName} — Section ${cb.dataset.className}</b>: Currently handled by <i>${cb.dataset.teacherName}</i></li>`).join('')}
                    </ul>
                    <p class="mt-1 text-[10px] text-amber-700">Inviting this teacher will prompt for confirmation to replace and reassign these sections.</p>
                </div>
            `;
        } else {
            conflictNotice.classList.add('hidden');
            conflictNotice.innerHTML = '';
        }
    }
}

// ─────────────────────────────────
// LIVE CLASS SELECTION & CAPACITY CHECK FOR INVITE MODAL
// ─────────────────────────────────
window._selectedClassIsBlocked = false;

function onInviteClassChanged(sel) {
    const banner = document.getElementById('invClassStatusBanner');
    const courseDisplay = document.getElementById('invCourseDisplay');
    const sectionHidden = document.getElementById('invSection');
    const syInput = document.getElementById('invSchoolYear');

    if (!sel || !sel.value) {
        banner.classList.add('hidden');
        courseDisplay.value = '';
        sectionHidden.value = '';
        window._selectedClassIsBlocked = false;
        return;
    }

    const opt = sel.options[sel.selectedIndex];
    const className   = opt.dataset.className || '';
    const subjectName = opt.dataset.subjectName || '';
    const subjectCode = opt.dataset.subjectCode || '';
    const rawCap      = opt.dataset.capacity;
    const enrolled    = parseInt(opt.dataset.enrolled || '0', 10);
    const startStr    = opt.dataset.start;
    const endStr      = opt.dataset.end;
    const syRange     = opt.dataset.syRange;

    sectionHidden.value = className;
    courseDisplay.value = `${subjectName} ${subjectCode ? '(' + subjectCode + ')' : ''}`.trim();
    if (syRange && syInput) syInput.value = syRange;

    banner.classList.remove('hidden');

    // 1. Capacity Check
    let cap = null;
    let isFull = false;
    if (rawCap !== '' && rawCap !== undefined && rawCap !== null) {
        cap = parseInt(rawCap, 10);
        if (enrolled >= cap) {
            isFull = true;
        }
    }

    if (isFull) {
        window._selectedClassIsBlocked = true;
        banner.className = 'mt-2 p-3 rounded-xl text-xs border bg-rose-50 border-rose-200 text-rose-800 transition-all';
        banner.innerHTML = `
            <div class="flex items-start gap-2.5">
                <i class="fas fa-ban text-rose-500 text-base mt-0.5"></i>
                <div>
                    <p class="font-bold">Class Full (Capacity: ${enrolled}/${cap} enrolled)</p>
                    <p class="text-[11px] text-rose-600 mt-0.5">This class has reached its maximum seat limit. You cannot enroll the invited student into this class.</p>
                </div>
            </div>
        `;
        return;
    }

    // 2. Timeline Bounds Check
    const now = new Date();
    if (startStr && now < new Date(startStr)) {
        window._selectedClassIsBlocked = true;
        banner.className = 'mt-2 p-3 rounded-xl text-xs border bg-amber-50 border-amber-200 text-amber-800 transition-all';
        banner.innerHTML = `
            <div class="flex items-start gap-2.5">
                <i class="fas fa-clock text-amber-500 text-base mt-0.5"></i>
                <div>
                    <p class="font-bold">Enrollment Not Started Yet</p>
                    <p class="text-[11px] text-amber-600 mt-0.5">Opens on ${new Date(startStr).toLocaleString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' })}.</p>
                </div>
            </div>
        `;
        return;
    }

    if (endStr && now > new Date(endStr)) {
        window._selectedClassIsBlocked = true;
        banner.className = 'mt-2 p-3 rounded-xl text-xs border bg-rose-50 border-rose-200 text-rose-800 transition-all';
        banner.innerHTML = `
            <div class="flex items-start gap-2.5">
                <i class="fas fa-calendar-xmark text-rose-500 text-base mt-0.5"></i>
                <div>
                    <p class="font-bold">Enrollment Period Closed</p>
                    <p class="text-[11px] text-rose-600 mt-0.5">Ended on ${new Date(endStr).toLocaleString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' })}.</p>
                </div>
            </div>
        `;
        return;
    }

    // 3. Valid & Open
    window._selectedClassIsBlocked = false;
    const isSem2 = opt.dataset.semester == 2 || (subjectName && subjectName.toLowerCase().includes('chemistry 2'));
    const passThreshold = (typeof _activeSY !== 'undefined' && _activeSY && _activeSY.passing_threshold) 
        ? _activeSY.passing_threshold 
        : (<%= (locals.selectedSY && locals.selectedSY.passing_threshold) || (locals.currentSY && locals.currentSY.passing_threshold) || (locals.activeSY && locals.activeSY.passing_threshold) || (locals.currentSchoolYear && locals.currentSchoolYear.passing_threshold) || 75 %>);
    const prereqNotice = isSem2 
        ? `<div class="mt-2 pt-2 border-t border-emerald-200/80 text-[11px] text-indigo-950 font-semibold"><i class="fas fa-shield-alt text-indigo-600 mr-1.5"></i><b>Prerequisite Rule:</b> Chemistry 2 requires that the student has completed and passed Chemistry 1 (Threshold: ${passThreshold}%) to be enrolled.</div>`
        : '';
    banner.className = 'mt-2 p-3 rounded-xl text-xs border bg-emerald-50 border-emerald-200 text-emerald-800 transition-all';
    banner.innerHTML = `
        <div class="flex items-start gap-2.5">
            <i class="fas fa-check-circle text-emerald-500 text-base mt-0.5"></i>
            <div>
                <p class="font-bold">Available for Auto-Enrollment (${enrolled}/${cap !== null ? cap : '∞'} seats filled)</p>
                <p class="text-[11px] text-emerald-700 mt-0.5">Student will be automatically enrolled in course <b>${subjectName}</b> and section <b>${className}</b> upon account activation.</p>
                ${prereqNotice}
            </div>
        </div>
    `;
}

// ─────────────────────────────────
// REQ#2 — SUBMIT INVITE
// No password is sent. POSTs to /admin/uac/invite.
// ─────────────────────────────────
async function submitInviteUser() {
    const fn    = document.getElementById('invFirstName');
    const ln    = document.getElementById('invLastName');
    const email = document.getElementById('invEmail');
    const role  = document.querySelector('input[name="inv_role"]:checked').value;
    let valid   = true;

    // Clear previous errors
    [fn, ln, email].forEach(el => el.classList.remove('invalid'));
    ['errInvFN','errInvLN','errInvEmail','errInvFacId','errInvTeacherSubject','errInvTeacherClasses'].forEach(id => {
        const el = document.getElementById(id);
        if (el) el.classList.remove('show');
    });

    if (!email.value.trim() || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value)) {
        email.classList.add('invalid');
        document.getElementById('errInvEmail').classList.add('show');
        valid = false;
    }

    // Student Validation
    if (role === 'Student') {
        const lrnEl = document.getElementById('invLRN');
        if (lrnEl.value && lrnEl.value.length !== 12) {
            lrnEl.classList.add('invalid');
            document.getElementById('errInvLRN').classList.add('show');
            valid = false;
        }

        const classSel = document.getElementById('invClassSelect');
        if (!classSel.value) {
            classSel.classList.add('invalid');
            showToast('Please select a class / section to enroll the student into.', 'error');
            valid = false;
        } else {
            classSel.classList.remove('invalid');
        }

        if (window._selectedClassIsBlocked) {
            showToast('Cannot proceed: Selected class is full or outside its enrollment period.', 'error');
            valid = false;
        }
    }

    // Teacher Validation
    let selectedClassIds = [];
    let selectedSubjectIds = [];
    let conflictedClasses = [];
    if (role === 'Teacher') {
        const fidEl = document.getElementById('invFacultyId');
        const fid = fidEl ? fidEl.value.trim() : '';
        if (!fid) {
            fidEl.classList.add('invalid');
            const errEl = document.getElementById('errInvFacId');
            if (errEl) {
                errEl.textContent = 'Faculty ID is required for teachers.';
                errEl.classList.add('show');
            }
            valid = false;
        }

        const selectedCbs = Array.from(document.querySelectorAll('.teacher-class-cb:checked'));
        if (selectedCbs.length === 0) {
            const errEl = document.getElementById('errInvTeacherClasses');
            if (errEl) errEl.classList.add('show');
            showToast('Please select at least one class/section for the teacher to handle.', 'warning');
            valid = false;
        } else {
            selectedClassIds = selectedCbs.map(cb => parseInt(cb.value, 10));
            selectedSubjectIds = [...new Set(selectedCbs.map(cb => parseInt(cb.dataset.subjectId, 10)))];
            conflictedClasses = selectedCbs.filter(cb => cb.dataset.hasTeacher === '1').map(cb => ({
                id: cb.value,
                className: cb.dataset.className,
                subjectName: cb.dataset.subjectName,
                teacherName: cb.dataset.teacherName
            }));
        }
    }

    if (!valid) return;

    // Check duplicate Faculty ID before proceeding
    if (role === 'Teacher') {
        const isFidDup = await checkInvFacIdDup();
        if (isFidDup) return;
    }

    // If teacher has conflicted classes, ask for confirmation
    if (role === 'Teacher' && conflictedClasses.length > 0) {
        const listItemsHtml = conflictedClasses.map(c => 
            `<li class="py-1 text-left"><b>${c.subjectName} — Section ${c.className}</b>: currently handled by <i>${c.teacherName}</i></li>`
        ).join('');

        if (window.Swal) {
            const result = await Swal.fire({
                title: 'Section Teacher Conflict',
                html: `
                    <div class="text-sm text-slate-600">
                        <p class="mb-2">The following selected section(s) already have an assigned teacher:</p>
                        <div class="max-h-36 overflow-y-auto bg-amber-50 border border-amber-200 rounded-xl p-3 my-2 text-xs text-amber-900">
                            <ul class="list-disc list-inside space-y-1">
                                ${listItemsHtml}
                            </ul>
                        </div>
                        <p class="text-xs text-slate-500 mt-2">
                            Proceeding will replace the current teacher assigned to these section(s) once the invitation is sent.
                        </p>
                    </div>
                `,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#059669',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="fas fa-check-circle mr-1"></i> Proceed & Replace',
                cancelButtonText: '<i class="fas fa-arrow-left mr-1"></i> Cancel & Review Selection',
                reverseButtons: true
            });

            if (!result.isConfirmed) {
                return; // User chose to cancel and review selections
            }
        } else {
            const listNames = conflictedClasses.map(c => `${c.className} (${c.teacherName})`).join(', ');
            const proceed = confirm(`The following section(s) already have an assigned teacher: ${listNames}. Proceeding will replace the current teacher. Do you want to proceed?`);
            if (!proceed) return;
        }
    }

    // Build payload — only role-relevant fields are included
    const payload = {
        role,
        email        : email.value.trim(),
        firstName    : fn.value.trim(),
        middleName   : document.getElementById('invMiddleName').value.trim(),
        lastName     : ln.value.trim(),
        suffix       : document.getElementById('invSuffix').value,
        sex          : document.getElementById('invSex').value,
        birthdate    : document.getElementById('invBirthdate').value,
        expiryHours  : document.getElementById('invExpiry').value || null,
        // Student
        classId      : role === 'Student' ? document.getElementById('invClassSelect').value          : null,
        lrn          : role === 'Student' ? document.getElementById('invLRN').value.trim()          : null,
        gradeLevel   : role === 'Student' ? document.getElementById('invGradeLevel').value           : null,
        section      : role === 'Student' ? document.getElementById('invSection').value.trim()       : null,
        strand       : role === 'Student' ? 'Academic Track'                                        : null,
        schoolYear   : role === 'Student' ? document.getElementById('invSchoolYear').value           : null,
        interests    : role === 'Student' ? document.getElementById('invInterests').value.trim()     : null,
        // Teacher
        facultyId    : role === 'Teacher' ? document.getElementById('invFacultyId').value.trim()    :
                       role === 'Admin'   ? document.getElementById('invAdminFacId').value.trim()   : null,
        department   : role === 'Teacher' ? document.getElementById('invDeptTeacher').value.trim()  :
                       role === 'Admin'   ? document.getElementById('invDeptAdmin').value.trim()    : null,
        teacherSubjectIds: role === 'Teacher' ? selectedSubjectIds : [],
        teacherClassIds  : role === 'Teacher' ? selectedClassIds   : []
    };

    try {
        const res  = await fetch('/admin/uac/invite', {
            method : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body   : JSON.stringify(payload),
        });
        const data = await res.json();
        if (data.success) {
            showToast(`Invitation sent to ${email.value}!`, 'success');
            closeModal('modalInviteUser');
            refreshAdminContent({ message: 'Sending invitation...' });
        } else if (data.duplicate) {
            showInvDup(data.message);
        } else {
            showToast(data.message || 'Failed to send invitation.', 'error');
        }
    } catch (_) {
        showToast('Network error. Please try again.', 'error');
    }
}

// ─────────────────────────────────
function openEditModal(u) {
    document.getElementById('editUserId').value    = u.user_id;
    document.getElementById('editUserRole').value  = u.role;
    document.getElementById('editDisplayName').textContent = `${u.first_name} ${u.last_name}`;
    document.getElementById('editDisplayRole').textContent = u.role;
    document.getElementById('editSubtitle').textContent    = `Editing: ${u.first_name} ${u.last_name} (${u.email})`;
    document.getElementById('editPreviewPic').src  = `/profile_uploads/${u.profile_pic || 'default_avatar.png'}`;

    // Helper to set value safely
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.value = val || ''; };

    set('editFirstName',      u.first_name);
    set('editMiddleName',     u.middle_name);
    set('editLastName',       u.last_name);
    set('editPhoneticFirst',  u.first_name_phonetic);
    set('editPhoneticMiddle', u.middle_name_phonetic);
    set('editPhoneticLast',   u.last_name_phonetic);
    set('editSuffix',         u.suffix);
    set('editAltName',        u.alternative_name);
    set('editSex',            u.sex);
    set('editBirthdate',      u.birthdate ? String(u.birthdate).slice(0,10) : '');
    set('editEmail',          u.email);
    set('editMobile',         u.mobile_number);
    set('editCity',           u.city_town);
    set('editAddress',        u.home_address);
    set('editBio',            u.self_description);
    set('editPicDesc',        u.pic_description);

    // REQ#3 — Show/hide sections based on role
    const isStudent = u.role === 'Student';
    const isStaff   = u.role === 'Teacher' || u.role === 'Admin';
    document.getElementById('editStudentSection').classList.toggle('hidden', !isStudent);
    document.getElementById('editStaffSection').classList.toggle('hidden',   !isStaff);

    if (isStudent) {
        set('editLRN',        u.lrn_number);
        set('editGradeLevel', u.grade_level);
        set('editSection',    u.section);
        set('editStrand',     u.strand);
        set('editInterests',  u.interests);
    }
    if (isStaff) {
        set('editFacultyId',  u.faculty_id);
        set('editDepartment', u.department);
        // Adjust staff section label colour
        const lbl = document.getElementById('editStaffLabel');
        lbl.className = `text-[10px] font-black uppercase tracking-widest mb-3 flex items-center gap-1.5 ${u.role === 'Admin' ? 'text-rose-500' : 'text-emerald-500'}`;
        lbl.innerHTML = `<i class="fas ${u.role==='Admin'?'fa-shield-halved':'fa-chalkboard-user'}"></i> ${u.role} Information`;
    }

    // Clear any previous validation state
    document.querySelectorAll('#editUserForm .ferr').forEach(e => e.classList.remove('show'));
    document.querySelectorAll('#editUserForm .fi').forEach(e => e.classList.remove('invalid'));

    openModal('modalEditUser');
}

// ─────────────────────────────────
// REQ#1 — SUBMIT EDIT USER
// Shows confirmation dialog first.
// ─────────────────────────────────
function submitEditUser(e) {
    e.preventDefault();
    let valid = true;
    const fn    = document.getElementById('editFirstName');
    const ln    = document.getElementById('editLastName');
    const email = document.getElementById('editEmail');
    const role  = document.getElementById('editUserRole').value;

    [fn, ln, email].forEach(el => el.classList.remove('invalid'));
    ['errEditFN','errEditLN','errEditEmail'].forEach(id => document.getElementById(id).classList.remove('show'));

    if (!fn.value.trim())    { fn.classList.add('invalid');    document.getElementById('errEditFN').classList.add('show');    valid = false; }
    if (!ln.value.trim())    { ln.classList.add('invalid');    document.getElementById('errEditLN').classList.add('show');    valid = false; }
    if (!email.value.trim()) { email.classList.add('invalid'); document.getElementById('errEditEmail').classList.add('show'); valid = false; }

    // REQ#4 — LRN validation in edit modal
    if (role === 'Student') {
        const lrnEl = document.getElementById('editLRN');
        if (lrnEl.value && lrnEl.value.length !== 12) {
            lrnEl.classList.add('invalid');
            document.getElementById('errEditLRN').classList.add('show');
            valid = false;
        }
    }
    if (!valid) return;

    // REQ#1 — Confirmation before save
    showConfirm({
        icon: 'fas fa-pen-to-square', iconBg: 'bg-emerald-100', iconColor: 'text-emerald-600',
        title: 'Save Changes?',
        desc : `You are about to update the profile of ${fn.value.trim()} ${ln.value.trim()}. This will immediately update their account.`,
        btnLabel: 'Yes, Save Changes', btnColor: 'bg-emerald-500',
        onConfirm: async () => {
            closeModal('modalConfirm');
            const userId = document.getElementById('editUserId').value;
            const fd = new FormData(document.getElementById('editUserForm'));
            try {
                const res  = await fetch(`/admin/uac/users/${userId}`, { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) {
                    showToast('User updated successfully!', 'success');
                    closeModal('modalEditUser');
                    refreshAdminContent({ message: 'Updating user profile...' });
                } else {
                    showToast(data.message || 'Failed to update user.', 'error');
                }
            } catch (_) {
                showToast('Network error.', 'error');
            }
        },
    });
}

