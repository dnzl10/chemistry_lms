                <button type="button" onclick="submitInviteUser()"
                    class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-cyan-500 text-white text-sm font-bold hover:opacity-90 transition shadow-md">
                    <i class="fas fa-paper-plane mr-1"></i> Send Invitation
                </button>
            </div>
        </div>
    </div>
</div>

<!-- ════════════════════════════════════════════════════
     MODAL: EDIT USER
     REQ#1 — Fully functional edit. Every field editable.
     REQ#3 — Student vs Teacher/Admin sections shown by JS.
