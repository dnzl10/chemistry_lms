// Quick invite form (inside tab-invites)
async function submitQuickInvite(e) {
    e.preventDefault();
    const email = document.getElementById('qiEmail').value.trim();
    const role  = document.getElementById('qiRole').value;
    const hours = document.getElementById('qiExpiry').value;
    try {
        const res  = await fetch('/admin/uac/invitations', {
            method : 'POST',
            headers: { 'Content-Type': 'application/json' },
            body   : JSON.stringify({ email, role, expiryHours: hours || null }),
        });
        const data = await res.json();
        if (data.success) {
            const link = `${window.location.origin}/setup-profile?token=${data.token}`;
            document.getElementById('qiLink').value = link;
            document.getElementById('qiLinkBox').classList.remove('hidden');
            showToast('Invite link generated!', 'success');
            refreshAdminContent({ message: 'Updating invitation list...' });
        } else {
            showToast(data.message || 'Failed to generate invite.', 'error');
        }
    } catch (_) {
        showToast('Network error.', 'error');
    }
}

function copyQiLink() {
    navigator.clipboard.writeText(document.getElementById('qiLink').value)
        .then(() => showToast('Link copied!', 'success'));
}

function copyTokenLink(token) {
    navigator.clipboard.writeText(`${window.location.origin}/setup-profile?token=${token}`)
        .then(() => showToast('Invite link copied!', 'success'));
}

// Revoke invitation — REQ#1 confirmation
function confirmRevokeInvite(invId, email) {
    showConfirm({
        icon: 'fas fa-ban', iconBg: 'bg-rose-100', iconColor: 'text-rose-500',
        title: `Revoke invite for "${email}"?`,
        desc : 'The invitation link will be deactivated. The recipient cannot use it to register.',
        btnLabel: 'Revoke Invite', btnColor: 'bg-rose-500',
        onConfirm: async () => {
            const res  = await fetch(`/admin/uac/invitations/${invId}`, { method: 'DELETE' });
            const data = await res.json();
            closeModal('modalConfirm');
            showToast(data.success ? 'Invitation revoked.' : (data.message || 'Failed.'),
                      data.success ? 'success' : 'error');
            if (data.success) refreshAdminContent({ message: 'Revoking invitation...' });
        },
    });
}

// Clean expired — REQ#1 confirmation
function confirmCleanExpired() {
    showConfirm({
        icon: 'fas fa-broom', iconBg: 'bg-slate-100', iconColor: 'text-slate-500',
        title: 'Clean Expired Invitations?',
        desc : 'All expired unused invitations will be permanently removed from the list.',
        btnLabel: 'Clean Now', btnColor: 'bg-slate-600',
        onConfirm: async () => {
            const res  = await fetch('/admin/uac/invitations/clean-expired', { method: 'DELETE' });
            const data = await res.json();
            closeModal('modalConfirm');
            showToast(data.success ? `Removed ${data.count} expired invite(s).` : 'Failed.',
                      data.success ? 'success' : 'error');
            if (data.success && data.count > 0) refreshAdminContent({ message: 'Cleaning expired invites...' });
        },
    });
}

