                        <button type="button" onclick="document.getElementById('editPicInput').click()" class="text-xs font-bold border border-slate-200 px-3 py-1.5 rounded-xl hover:bg-white transition"><i class="fas fa-camera mr-1"></i> Change Photo</button>
                    </div>
                </div>
                <div class="ml-auto">
                    <label class="block text-xs font-bold text-slate-600 mb-1 uppercase tracking-wider">Pic Alt Text</label>
