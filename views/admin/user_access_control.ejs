<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User & Access Control | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/xlsx@0.18.5/dist/xlsx.full.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/admin_spa_handler.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .glass-card { background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); }
        .stat-card { transition: transform 0.18s ease, box-shadow 0.18s ease; }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.10); }
        .nav-active {
            background: linear-gradient(135deg, #06b6d4, #6366f1) !important;
            color: white !important; font-weight: 700;
            box-shadow: 0 4px 14px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }
        .fade-in { animation: fadeUp 0.35s ease both; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }

        /* Tab system */
        .tab-btn { transition: all 0.2s ease; }
        .tab-btn.active {
            background: linear-gradient(135deg,#06b6d4,#6366f1);
            color: white; box-shadow: 0 4px 14px rgba(99,102,241,0.35);
        }
        .tab-content { display: none; }
        .tab-content.active { display: block; }

        /* Data table */
        .data-table th { background: #f8fafc; font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:#64748b; font-weight:700; }
        .data-table tr { transition: background 0.12s; }
        .data-table tbody tr:hover { background: #f0f9ff; }
        .data-table td { vertical-align: middle; }

        /* Modal */
        .modal-overlay {
            position: fixed; inset: 0; background: rgba(15,23,42,0.6);
            backdrop-filter: blur(5px); z-index: 9000;
            display: flex; align-items: center; justify-content: center;
            opacity: 0; pointer-events: none; transition: opacity 0.22s ease;
            padding: 16px;
        }
        .modal-overlay.open { opacity: 1; pointer-events: all; }
        .swal2-container { z-index: 100000 !important; }
        .modal-box {
            background: white; border-radius: 20px;
            box-shadow: 0 32px 80px rgba(0,0,0,0.22);
            width: 95%; max-width: 700px; max-height: 92vh;
            overflow-y: auto; transform: scale(0.96) translateY(12px);
            transition: transform 0.22s ease;
            scrollbar-width: thin; scrollbar-color: #c7d2fe transparent;
        }
        .modal-overlay.open .modal-box { transform: scale(1) translateY(0); }
        .modal-box::-webkit-scrollbar { width: 4px; }
        .modal-box::-webkit-scrollbar-thumb { background: #c7d2fe; border-radius: 4px; }
        .modal-box-sm { max-width: 460px; }
        .modal-box-lg { max-width: 820px; }

        /* Badges */
        .badge { display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:700; padding:2px 8px; border-radius:99px; text-transform:uppercase; letter-spacing:.04em; }
        .badge-student { background:#dbeafe; color:#1e40af; }
        .badge-teacher { background:#d1fae5; color:#065f46; }
        .badge-admin   { background:#fce7f3; color:#9d174d; }
        .badge-pending { background:#fef3c7; color:#92400e; }
        .badge-expired { background:#fee2e2; color:#991b1b; }

        /* Form input base style */
        .fi {
            width:100%; padding:10px 14px; border-radius:12px;
            border:1.5px solid #e2e8f0; font-size:14px;
            background:white; font-family:inherit;
            transition: box-shadow 0.18s, border-color 0.18s;
        }
        .fi:focus { box-shadow:0 0 0 3px rgba(6,182,212,0.18); border-color:#06b6d4; outline:none; }
        .fi.invalid { border-color:#ef4444 !important; box-shadow:0 0 0 3px rgba(239,68,68,0.15) !important; }

        /* Field error text */
        .ferr { display:none; color:#ef4444; font-size:11px; font-weight:700; margin-top:3px; }
        .ferr.show { display:block; }

        /* Role filter pills */
        .role-filter { cursor:pointer; padding:6px 14px; border-radius:8px; font-size:12px; font-weight:700; transition:all .15s; border:2px solid transparent; }
        .role-filter:hover { border-color:#c7d2fe; }
        .role-filter.rf-active { border-color:#6366f1; background:#eef2ff; color:#4338ca; }

        /* Action icon buttons */
        .btn-icon { width:30px; height:30px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; transition:all .15s; font-size:12px; cursor:pointer; border:none; }
        .btn-icon:hover { transform:scale(1.12); }
        .btn-edit     { background:#e0f2fe; color:#0369a1; }
        .btn-delete   { background:#fee2e2; color:#dc2626; }
        .btn-qr       { background:#ede9fe; color:#7c3aed; }
        .btn-google   { background:#fce7f3; color:#be185d; }
        .btn-flag     { background:#fef3c7; color:#d97706; }
        /* REQ#5 — Reset password button (green key icon) */
        .btn-resetpwd { background:#f0fdf4; color:#16a34a; }

        /* Table horizontal scroll */
        .table-wrap { overflow-x:auto; }
        .table-wrap::-webkit-scrollbar { height:3px; }
        .table-wrap::-webkit-scrollbar-thumb { background:#c7d2fe; border-radius:2px; }

        /* Progress bars for KPI cards */
        .progress-bar  { height:4px; border-radius:2px; background:#e2e8f0; }
        .progress-fill { height:100%; border-radius:2px; background:linear-gradient(90deg,#06b6d4,#6366f1); }

        /* Drop zones for bulk upload */
        .drop-zone { border:2.5px dashed #c7d2fe; border-radius:16px; transition:all .2s; cursor:pointer; }
        .drop-zone.dragover { border-color:#6366f1; background:#eef2ff; }

        /* Toast notification */
        #toast {
            position:fixed; bottom:28px; right:28px; z-index:99999;
            padding:14px 22px; border-radius:14px; font-weight:700; font-size:14px;
            display:flex; align-items:center; gap:10px;
            box-shadow:0 8px 30px rgba(0,0,0,.18);
            transform:translateY(80px); opacity:0; pointer-events:none;
            transition:all .3s cubic-bezier(.34,1.56,.64,1); min-width:240px;
        }
        #toast.show    { transform:translateY(0); opacity:1; }
        #toast.success { background:#10b981; color:white; }
        #toast.error   { background:#ef4444; color:white; }
        #toast.info    { background:#6366f1; color:white; }
        #toast.warning { background:#f59e0b; color:white; }

        /* Duplicate warning inside modals */
        .dup-banner { display:none; background:#fef3c7; border:1.5px solid #fde68a; border-radius:12px; padding:10px 14px; }
        .dup-banner.show { display:block; }

        /* REQ#3 — Role-based dynamic field sections */
        .role-section { display:none; }
        .role-section.visible { display:block; }

        /* Invite modal info note */
        .invite-note {
            background:#eef2ff; border-radius:10px; padding:10px 14px;
            font-size:12px; color:#4338ca; font-weight:600;
            display:flex; align-items:center; gap:8px;
        }
    </style>
</head>
<body class="text-slate-900">
<div class="flex min-h-screen relative overflow-x-hidden">

    <!-- Mobile sidebar overlay -->
    <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-cyan-900/50 z-40 hidden md:hidden"></div>

    <!-- ══════════════════ SIDEBAR ══════════════════ -->
    <aside id="sidebar" class="bg-indigo-950 text-white w-64 flex-shrink-0 flex flex-col z-50 fixed inset-y-0 left-0 -translate-x-full md:translate-x-0 h-screen border-r border-indigo-800/50">
        <div class="pt-8 pb-4 px-4 flex flex-col items-center text-center relative">
            <!-- Mobile close button -->
            <button onclick="toggleSidebar()" class="md:hidden text-indigo-300 hover:text-white absolute top-4 right-4">
                <i class="fas fa-times text-xl"></i>
            </button>

            <!-- Logo -->
            <img src="/assets/logo.png" alt="ChemArcade Logo" class="w-16 h-16 object-contain mb-3">

            <!-- Brand name -->
            <h1 class="text-xl font-black tracking-tighter text-cyan-400 uppercase italic leading-none">
                Elem<span class="text-white">enta</span>
            </h1>
            <p class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest mt-1">Admin Console</p>

            <!-- Divider -->
            <!-- <div class="w-full mt-5 border-t border-indigo-800/60"></div> -->
        </div>
        <nav class="flex-1 px-4 mt-4 space-y-6 overflow-y-auto no-scrollbar pb-6">
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Main Interface</p>
                <a href="/admin/dashboard" class="flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white hover:bg-white/10 group">
                    <i class="fas fa-chart-pie w-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
                    <span class="font-bold tracking-tight text-sm">Main Dashboard</span>
                </a>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Administrative</p>
                <div class="space-y-1">
                    <a href="/admin/user_access_control" class="nav-active flex items-center gap-3 p-3 rounded-xl transition group">
                        <i class="fas fa-users w-5 text-sky-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">User & Access Control</span>
                    </a>
                    <a href="/admin/academic_management" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-graduation-cap w-5 text-emerald-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Academic Management</span>
                    </a>
                </div>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Learning Assets</p>
                <div class="space-y-1">
                    <a href="/admin/gaming_question_bank" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-gamepad w-5 text-amber-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Gaming & Q-Bank</span>
                    </a>
                    <a href="/admin/resources_engagement" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-lightbulb w-5 text-lime-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Resources & Engagement</span>
                    </a>
                </div>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">System Health</p>
                <div class="space-y-1">
                    <a href="/admin/reports_monitoring" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-chart-line w-5 text-blue-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Reports & Monitoring</span>
                    </a>
                    <a href="/admin/system_audit" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-fingerprint w-5 text-indigo-300 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">System Audit</span>
                    </a>
                </div>
            </div>
        </nav>
        <div class="p-4 border-t border-indigo-800">
            <a href="/logout" class="flex items-center gap-3 p-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition font-bold">
                <i class="fas fa-right-from-bracket w-5"></i> Log Out
            </a>
        </div>
    </aside>

    <!-- ══════════════════ MAIN CONTENT ══════════════════ -->
    <main class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- Fixed top header -->
        <header class="h-20 bg-white/90 backdrop-blur-md border-b border-cyan-100 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-cyan-50 text-cyan-600 md:hidden"><i class="fas fa-bars text-xl"></i></button>
                <div>
                    <h2 class="text-lg font-bold text-indigo-900 uppercase tracking-tight">User &amp; Access Control</h2>
                    <p class="text-xs text-slate-400 hidden sm:block"><i class="fas fa-circle text-green-400 text-[8px] mr-1"></i>Manage users, invitations &amp; bulk registration</p>
                </div>
            </div>
            <div class="flex items-center gap-3 md:gap-5">
                <!-- Global School Year Context Selector -->
                <%- include('../partials/admin_sy_selector') %>
                <!-- Notification bell -->
                <div id="notifBellBtn" class="relative cursor-pointer p-2 hover:bg-cyan-50 rounded-full transition" onclick="toggleNotifPanel()">
                    <i class="far fa-bell text-xl text-cyan-600"></i>
                    <span id="notifDot" class="absolute top-2 right-2 flex h-2.5 w-2.5 hidden">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                    </span>
                    <span id="notifCount" class="absolute -top-0.5 -right-0.5 hidden bg-rose-500 text-white text-[9px] font-black rounded-full w-4 h-4 flex items-center justify-center"></span>
                </div>

                <!-- Admin profile -->
                <div class="flex items-center gap-3 pl-4 border-l border-cyan-100">
                    <div class="text-right hidden lg:block">
                        <p class="text-sm font-bold text-indigo-900"><%= user.first_name %> <%= user.last_name %></p>
                        <p class="text-[10px] uppercase font-black text-rose-500 tracking-widest">Administrator</p>
                    </div>
                    <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                         class="w-10 h-10 rounded-xl object-cover ring-2 ring-rose-400 shadow-sm">
                </div>
            </div>
        </header>

        <!-- Scrollable content area -->
        <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
            <div id="adminMainContent" class="p-4 md:p-8 flex-1 fade-in">

                <!-- School Year Alert Banner (Archive/Draft) -->
                <%- include('../partials/admin_sy_banner') %>

                <!-- ── KPI STAT CARDS ── -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                    <div class="stat-card glass-card rounded-2xl p-5 border border-sky-100 shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-sky-100 flex items-center justify-center"><i class="fas fa-user-graduate text-sky-600"></i></div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Students</span>
                        </div>
                        <div class="flex items-baseline justify-between">
                            <p class="text-3xl font-black text-indigo-900"><%= uacStats.totalStudents %></p>
                        </div>
                        <p class="text-[10px] text-emerald-600 font-bold mt-1">Enrolled in <%= locals.selectedSY ? selectedSY.sy_range : 'Current SY' %></p>
                        <div class="progress-bar mt-3"><div class="progress-fill" style="width:100%"></div></div>
                    </div>
                    <div class="stat-card glass-card rounded-2xl p-5 border border-emerald-100 shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center"><i class="fas fa-chalkboard-user text-emerald-600"></i></div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Teachers</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= uacStats.totalTeachers %></p>
                        <div class="progress-bar mt-3"><div class="progress-fill" style="width:100%;background:linear-gradient(90deg,#10b981,#34d399)"></div></div>
                    </div>
                    <div class="stat-card glass-card rounded-2xl p-5 border border-rose-100 shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-rose-100 flex items-center justify-center"><i class="fas fa-shield-halved text-rose-600"></i></div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Admins</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= uacStats.totalAdmins %></p>
                        <div class="progress-bar mt-3"><div class="progress-fill" style="width:100%;background:linear-gradient(90deg,#f43f5e,#fb7185)"></div></div>
                    </div>
                    <div class="stat-card glass-card rounded-2xl p-5 border border-amber-100 shadow-sm">
                        <div class="flex items-center justify-between mb-3">
                            <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center"><i class="fas fa-envelope-open-text text-amber-600"></i></div>
                            <span class="text-[10px] font-black uppercase tracking-widest text-slate-400">Pending Invites</span>
                        </div>
                        <p class="text-3xl font-black text-indigo-900"><%= uacStats.pendingInvites %></p>
                        <div class="progress-bar mt-3"><div class="progress-fill" style="width:100%;background:linear-gradient(90deg,#f59e0b,#fbbf24)"></div></div>
                    </div>
                </div>

                <!-- ── MAIN TABS ── -->
                <div class="glass-card rounded-2xl border border-slate-100 shadow-sm overflow-hidden">
                    <div class="flex items-center gap-2 p-4 border-b border-slate-100 flex-wrap">
                        <button class="tab-btn active flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchTab('tab-users',this)">
                            <i class="fas fa-users"></i> User Directory
                        </button>
                        <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchTab('tab-invites',this)">
                            <i class="fas fa-envelope"></i> Invitations
                            <% if (uacStats.pendingInvites > 0) { %>
                            <span class="ml-1 bg-amber-400 text-white text-[10px] font-black px-2 py-0.5 rounded-full"><%= uacStats.pendingInvites %></span>
                            <% } %>
                        </button>
                        <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchTab('tab-bulk',this)">
                            <i class="fas fa-file-excel"></i> Bulk Import
                        </button>

                    </div>

                    <!-- ══════════════════════════════
                         TAB 1 — USER DIRECTORY
                    ══════════════════════════════ -->
                    <div id="tab-users" class="tab-content active p-5">
                        <!-- Toolbar -->
                        <div class="flex flex-col md:flex-row gap-3 mb-5">
                            <div class="relative flex-1">
                                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm"></i>
                                <input id="userSearch" type="text" placeholder="Search by name, email, LRN, Faculty ID…"
                                    class="fi pl-9" oninput="filterUsers()">
                            </div>
                            <div class="flex items-center gap-2 flex-wrap">
                                <span onclick="setRoleFilter('All',this)" class="role-filter rf-active">All</span>
                                <span onclick="setRoleFilter('Student',this)" class="role-filter"><i class="fas fa-user-graduate mr-1 text-sky-500"></i>Students</span>
                                <span onclick="setRoleFilter('Teacher',this)" class="role-filter"><i class="fas fa-chalkboard-user mr-1 text-emerald-500"></i>Teachers</span>
                                <span onclick="setRoleFilter('Admin',this)" class="role-filter"><i class="fas fa-shield-halved mr-1 text-rose-500"></i>Admins</span>
                            </div>
                            <%#
                              REQ#2 — Button now opens invitation modal, NOT a direct-create modal.
                              Label changed to "Invite User" to reflect the flow.
                            %>
                            <button onclick="openInviteModal()"
                                class="flex items-center gap-2 bg-gradient-to-r from-cyan-500 to-indigo-500 text-white font-bold text-sm px-4 py-2.5 rounded-xl hover:opacity-90 transition shadow-md whitespace-nowrap">
                                <i class="fas fa-user-plus"></i> Invite User
                            </button>
                        </div>

                        <!-- User table -->
                        <div class="table-wrap rounded-xl border border-slate-100">
                            <table class="data-table w-full text-sm">
                                <thead>
                                    <tr class="border-b border-slate-100">
                                        <th class="p-3 text-left">User</th>
                                        <th class="p-3 text-left hidden md:table-cell">Role</th>
                                        <th class="p-3 text-left hidden lg:table-cell">Status</th>
                                        <th class="p-3 text-left hidden lg:table-cell">ID / LRN</th>
                                        <th class="p-3 text-left hidden xl:table-cell">Grade / Dept</th>
                                        <th class="p-3 text-left hidden md:table-cell">Google</th>
                                        <th class="p-3 text-left hidden lg:table-cell">Level / EXP</th>
                                        <th class="p-3 text-left hidden md:table-cell">Joined</th>
                                        <th class="p-3 text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="userTableBody">
                                    <% users.forEach(function(u) { %>
                                        <% 
                                            // 100% Sure Fix: I-construct ang search string sa labas ng attribute para safe
                                            const fullName = (u.first_name || '') + ' ' + (u.last_name || '');
                                            const searchData = (fullName + ' ' + (u.email || '') + ' ' + (u.lrn_number || '') + ' ' + (u.faculty_id || '')).toLowerCase();
                                        %>
                                        <tr class="border-b border-slate-50 user-row"
                                            data-role="<%= u.role %>"
                                            data-search="<%= searchData.replace(/"/g, '&quot;') %>">
                                            
                                            <td class="p-3">
                                                <div class="flex items-center gap-3">
                                                    <div class="relative flex-shrink-0">
                                                        <img src="/profile_uploads/<%= u.profile_pic || 'default_avatar.png' %>"
                                                            class="w-9 h-9 rounded-xl object-cover border-2 border-slate-100"
                                                            onerror="this.src='/profile_uploads/default_avatar.png'">
                                                        <% if (u.flagged_assessment_id) { %>
                                                            <span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-rose-500 rounded-full border-2 border-white" title="Flagged student"></span>
                                                        <% } %>
                                                    </div>
                                                    <div>
                                                        <p class="font-bold text-slate-800 leading-tight">
                                                            <%= u.first_name %> <%= u.middle_name ? u.middle_name[0]+'.' : '' %> <%= u.last_name %><%= u.suffix ? ', '+u.suffix : '' %>
                                                        </p>
                                                        <p class="text-xs text-slate-400"><%= u.email %></p>
                                                        <% if (u.alternative_name) { %>
                                                            <p class="text-[10px] text-indigo-400 italic">"<%= u.alternative_name %>"</p>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            </td>

                                            <td class="p-3 hidden md:table-cell">
                                                <span class="badge badge-<%= u.role ? u.role.toLowerCase() : 'user' %>"><%= u.role %></span>
                                            </td>

                                            <td class="p-3 hidden lg:table-cell">
                                                <% if (u.is_suspended) { %>
                                                    <span class="px-2 py-1 rounded-md text-[10px] font-bold bg-rose-100 text-rose-700 border border-rose-200">Suspended</span>
                                                <% } else if (!u.is_active) { %>
                                                    <span class="px-2 py-1 rounded-md text-[10px] font-bold bg-amber-100 text-amber-700 border border-amber-200">Inactive</span>
                                                <% } else { %>
                                                    <span class="px-2 py-1 rounded-md text-[10px] font-bold bg-emerald-100 text-emerald-700 border border-emerald-200">Active</span>
                                                <% } %>
                                            </td>

                                            <td class="p-3 hidden lg:table-cell text-xs text-slate-500 font-mono">
                                                <% if (u.lrn_number) { %><div><span class="text-slate-400">LRN:</span> <%= u.lrn_number %></div><% } %>
                                                <% if (u.faculty_id) { %><div><span class="text-slate-400">FID:</span> <%= u.faculty_id %></div><% } %>
                                                <% if (!u.lrn_number && !u.faculty_id) { %><span class="text-slate-300">—</span><% } %>
                                            </td>

                                            <td class="p-3 hidden xl:table-cell text-xs text-slate-500">
                                                <% if (u.role === 'Student') { %>
                                                    <% if (u.enrolled_count_sy > 0) { %>
                                                        <div class="inline-flex items-center gap-1 font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-lg text-[11px]" title="<%= u.enrolled_classes_sy %>">
                                                            <i class="fas fa-circle-check text-[9px] text-emerald-500"></i>
                                                            <span class="truncate max-w-[130px]"><%= u.enrolled_classes_sy %></span>
                                                        </div>
                                                        <% if (u.grade_level) { %><div class="text-slate-400 text-[10px] mt-0.5"><%= u.grade_level %></div><% } %>
                                                    <% } else { %>
                                                        <span class="text-slate-400 italic text-[11px]">Unassigned</span>
                                                    <% } %>
                                                <% } else { %>
                                                    <% if (u.grade_level) { %><div><%= u.grade_level %></div><% } %>
                                                    <% if (u.section) { %><div class="text-slate-400 text-[10px]"><%= u.section %></div><% } %>
                                                    <% if (u.department) { %><div class="text-slate-400 text-[10px]"><%= u.department %></div><% } %>
                                                <% } %>
                                            </td>

                                            <td class="p-3 hidden md:table-cell">
                                                <% if (u.google_id) { %>
                                                    <span class="flex items-center gap-1 text-xs font-bold text-emerald-600"><i class="fab fa-google"></i> Linked</span>
                                                <% } else { %><span class="text-slate-300">—</span><% } %>
                                            </td>

                                            <td class="p-3 hidden lg:table-cell text-xs">
                                                <% if (u.role === 'Student') { %>
                                                    <div class="font-bold text-indigo-700">Lv. <%= u.current_level || 1 %></div>
                                                    <div class="text-slate-400 text-[10px]"><%= (u.total_exp || 0).toLocaleString() %> EXP</div>
                                                <% } else { %><span class="text-slate-300">—</span><% } %>
                                            </td>

                                            <td class="p-3 hidden md:table-cell text-xs text-slate-400">
                                                <%= u.created_at ? new Date(u.created_at).toLocaleDateString('en-PH', {month:'short', day:'numeric', year:'numeric'}) : '---' %>
                                            </td>

                                            <td class="p-3">
                                                <div class="flex items-center justify-center gap-1 flex-wrap">
                                                    <%# EDIT BUTTON: Ginamit ang simple data-user-id para iwas quote errors %>
                                                    <button type="button" class="btn-icon btn-edit" title="Edit User"
                                                        data-user-data="<%- JSON.stringify(u).replace(/"/g, '&quot;') %>"
                                                        onclick="openEditModal(JSON.parse(this.getAttribute('data-user-data')))">
                                                        <i class="fas fa-pen"></i>
                                                    </button>

                                                    <button type="button" class="btn-icon btn-resetpwd" title="Reset Password"
                                                        onclick="confirmResetPassword('<%= u.user_id %>', '<%= fullName %>', '<%= u.email %>')">
                                                        <i class="fas fa-key"></i>
                                                    </button>

                                                    <button type="button" class="btn-icon btn-qr" title="Reset QR"
                                                        onclick="confirmResetQR('<%= u.user_id %>', '<%= fullName %>')">
                                                        <i class="fas fa-qrcode"></i>
                                                    </button>

                                                    <% if (u.google_id) { %>
                                                    <button type="button" class="btn-icon btn-google" title="Unlink Google"
                                                        onclick="confirmUnlinkGoogle('<%= u.user_id %>', '<%= fullName %>')">
                                                        <i class="fab fa-google"></i>
                                                    </button>
                                                    <% } %>

                                                    <% if (u.user_id !== user.user_id) { %>
                                                        <% if (u.is_suspended) { %>
                                                            <button type="button" class="btn-icon bg-emerald-50 text-emerald-600 hover:bg-emerald-100" title="Activate/Unsuspend User"
                                                                onclick="confirmToggleStatus('<%= u.user_id %>', '<%= fullName %>', 'activate_suspension')">
                                                                <i class="fas fa-user-check"></i>
                                                            </button>
                                                        <% } else if (!u.is_active) { %>
                                                            <button type="button" class="btn-icon bg-emerald-50 text-emerald-600 hover:bg-emerald-100" title="Activate Account"
                                                                onclick="confirmToggleStatus('<%= u.user_id %>', '<%= fullName %>', 'activate')">
                                                                <i class="fas fa-user-check"></i>
                                                            </button>
                                                        <% } else { %>
                                                            <button type="button" class="btn-icon bg-amber-50 text-amber-600 hover:bg-amber-100" title="Deactivate Account"
                                                                onclick="confirmToggleStatus('<%= u.user_id %>', '<%= fullName %>', 'deactivate')">
                                                                <i class="fas fa-user-lock"></i>
                                                            </button>
                                                            <button type="button" class="btn-icon bg-rose-50 text-rose-600 hover:bg-rose-100" title="Suspend User"
                                                                onclick="confirmToggleStatus('<%= u.user_id %>', '<%= fullName %>', 'suspend')">
                                                                <i class="fas fa-ban"></i>
                                                            </button>
                                                        <% } %>

                                                    <button type="button" class="btn-icon btn-delete" title="Delete"
                                                        onclick="confirmDelete('<%= u.user_id %>', '<%= fullName %>')">
                                                        <i class="fas fa-trash"></i>
                                                    </button>
                                                    <% } %>
                                                </div>
                                            </td>
                                        </tr>
                                    <% }) %>
                                        <tr id="userEmptyRow" class="<%= users.length === 0 ? '' : 'hidden' %>">
                                            <td colspan="9" class="p-0 border-0">
                                                <div class="py-16 px-4 text-center">
                                                    <div class="w-16 h-16 mx-auto mb-3.5 rounded-2xl bg-indigo-50/80 border border-indigo-100 flex items-center justify-center text-indigo-500 shadow-sm transition-all duration-300">
                                                        <i id="userEmptyIcon" class="fas <%= users.length === 0 ? 'fa-users' : 'fa-user-slash' %> text-2xl"></i>
                                                    </div>
                                                    <h4 class="text-base font-extrabold text-slate-800 mb-1" id="userEmptyTitle">
                                                        <%= users.length === 0 ? 'No confirmed users yet' : 'No matching users found' %>
                                                    </h4>
                                                    <p class="text-xs text-slate-400 max-w-md mx-auto mb-5 leading-relaxed" id="userEmptySubtitle">
                                                        <%= users.length === 0 ? 'Users will appear here once they accept their email invitation and set up their account.' : "We couldn't find any users matching your query. Try adjusting your search keywords or switching role filters." %>
                                                    </p>
                                                    <div class="flex items-center justify-center gap-2.5 flex-wrap">
                                                        <button type="button" id="userEmptyClearBtn" onclick="clearUserFilters()" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 transition shadow-sm <%= users.length === 0 ? 'hidden' : '' %>">
                                                            <i class="fas fa-rotate-left text-slate-400"></i> Clear Search & Filters
                                                        </button>
                                                        <button type="button" onclick="openInviteModal()" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-cyan-500 to-indigo-500 hover:opacity-90 shadow-md transition">
                                                            <i class="fas fa-user-plus"></i> Invite User
                                                        </button>
                                                        <button type="button" onclick="switchTab('tab-bulk', document.querySelector('[onclick*=\'tab-bulk\']'))" class="inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl text-xs font-bold text-slate-600 bg-slate-100 hover:bg-slate-200 transition shadow-sm">
                                                            <i class="fas fa-file-excel text-emerald-500"></i> Bulk Import
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                </tbody>
                            </table>
                        </div>
                        <div class="mt-3 flex items-center justify-between text-xs text-slate-400 px-1">
                            <span id="userCountLabel">Showing <%= users.length %> user(s)</span>
                        </div>
                    </div><!-- /tab-users -->

                    <!-- ══════════════════════════════
                         TAB 2 — INVITATIONS
                         REQ#7 — Router sends ONLY is_used=0 rows.
                         No "Used" badge logic needed here.
                    ══════════════════════════════ -->
                    <div id="tab-invites" class="tab-content p-5">

                        <div class="mb-5 p-4 bg-indigo-50 border border-indigo-100 rounded-xl flex items-start gap-3">
                            <i class="fas fa-circle-info text-indigo-400 mt-0.5 text-lg"></i>
                            <div class="text-sm">
                                <p class="font-bold text-indigo-800">Invitation-first user flow</p>
                                <p class="text-indigo-500 mt-0.5 text-xs">
                                    When you invite a user (manual or bulk), an email is sent with a secure link.
                                    The user must click it, connect their Google account, and set a password.
                                    Only then do they appear in the <strong>User Directory</strong> tab.
                                </p>
                            </div>
                        </div>

                        <!-- Quick invite form inside invitation tab -->
                        <div class="bg-gradient-to-br from-indigo-50 to-cyan-50 rounded-2xl border border-indigo-100 p-5 mb-6">
                            <h3 class="font-black text-indigo-900 text-base mb-4 flex items-center gap-2">
                                <i class="fas fa-paper-plane text-indigo-400"></i> Quick Invite
                            </h3>
                            <form id="quickInviteForm" onsubmit="submitQuickInvite(event)" class="grid grid-cols-1 md:grid-cols-3 gap-4">
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Gmail Address *</label>
                                    <input type="email" id="qiEmail" required placeholder="student@gmail.com" class="fi text-sm">
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Role</label>
                                    <select id="qiRole" class="fi text-sm">
                                        <option value="Student">Student</option>
                                        <option value="Teacher">Teacher</option>
                                        <option value="Admin">Admin</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Expires In</label>
                                    <select id="qiExpiry" class="fi text-sm">
                                        <option value="24">24 hours</option>
                                        <option value="72">3 days</option>
                                        <option value="168" selected>7 days</option>
                                        <option value="720">30 days</option>
                                        <option value="">Never</option>
                                    </select>
                                </div>
                                <div class="md:col-span-3 flex items-center gap-3">
                                    <button type="submit"
                                        class="flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-cyan-500 text-white font-bold text-sm px-5 py-2.5 rounded-xl hover:opacity-90 transition shadow-md">
                                        <i class="fas fa-link"></i> Generate Invite Link
                                    </button>
                                    <span class="text-xs text-slate-400">Token created instantly — copy the link to share manually or it is emailed automatically.</span>
                                </div>
                            </form>
                            <div id="qiLinkBox" class="hidden mt-4 p-4 bg-white rounded-xl border border-indigo-200">
                                <p class="text-xs font-bold text-indigo-700 mb-2 uppercase tracking-wider">
                                    <i class="fas fa-check-circle text-emerald-500 mr-1"></i> Invite Link Generated
                                </p>
                                <div class="flex items-center gap-2">
                                    <input id="qiLink" type="text" readonly class="flex-1 bg-slate-50 rounded-lg border border-slate-200 px-3 py-2 text-xs font-mono text-slate-600">
                                    <button onclick="copyQiLink()" class="text-xs font-bold bg-indigo-100 text-indigo-700 px-3 py-1.5 rounded-lg hover:bg-indigo-200 transition">
                                        <i class="fas fa-copy mr-1"></i> Copy
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
                            <h3 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-hourglass-half text-amber-400"></i> Pending Invitations
                            </h3>
                            <button onclick="confirmCleanExpired()"
                                class="flex items-center gap-1 text-xs font-bold text-rose-500 border border-rose-200 px-3 py-1.5 rounded-lg hover:bg-rose-50 transition">
                                <i class="fas fa-broom"></i> Clean Expired
                            </button>
                        </div>

                        <div class="table-wrap rounded-xl border border-slate-100">
                            <table class="data-table w-full text-sm">
                                <thead>
                                    <tr class="border-b border-slate-100">
                                        <th class="p-3 text-left">Email</th>
                                        <th class="p-3 text-left">Role</th>
                                        <th class="p-3 text-left hidden md:table-cell">Token (preview)</th>
                                        <th class="p-3 text-left">Status</th>
                                        <th class="p-3 text-left hidden md:table-cell">Expires</th>
                                        <th class="p-3 text-left hidden md:table-cell">Sent</th>
                                        <th class="p-3 text-center">Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                <%
                                  // REQ#7 — Router already filters is_used=0.
                                  // We only determine expired vs still-pending here.
                                  invitations.forEach(function(inv) {
                                    const expired = inv.expires_at && new Date(inv.expires_at) < new Date();
                                    const statusClass = expired ? 'badge-expired' : 'badge-pending';
                                    const statusLabel = expired ? 'Expired' : 'Pending';
                                %>
                                <tr class="border-b border-slate-50">
                                    <td class="p-3 font-medium text-slate-700"><%= inv.email %></td>
                                    <td class="p-3"><span class="badge badge-<%= inv.role.toLowerCase() %>"><%= inv.role %></span></td>
                                    <td class="p-3 hidden md:table-cell"><span class="font-mono text-xs text-slate-400"><%= inv.token.substring(0,16) %>…</span></td>
                                    <td class="p-3"><span class="badge <%= statusClass %>"><%= statusLabel %></span></td>
                                    <td class="p-3 hidden md:table-cell text-xs text-slate-400">
                                        <%= inv.expires_at ? new Date(inv.expires_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : 'Never' %>
                                    </td>
                                    <td class="p-3 hidden md:table-cell text-xs text-slate-400">
                                        <%= new Date(inv.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) %>
                                    </td>
                                    <td class="p-3">
                                        <div class="flex items-center justify-center gap-1.5">
                                            <button class="btn-icon btn-edit" title="Copy Link" onclick="copyTokenLink('<%= inv.token %>')">
                                                <i class="fas fa-copy"></i>
                                            </button>
                                            <button class="btn-icon btn-delete" title="Revoke Invitation"
                                                onclick="confirmRevokeInvite(<%= inv.invitation_id %>, '<%= inv.email.split(String.fromCharCode(39)).join(String.fromCharCode(92,39)) %>')">
                                                <i class="fas fa-ban"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }) %>
                                <% if (invitations.length === 0) { %>
                                    <tr>
                                        <td colspan="7" class="p-0 border-0">
                                            <div class="py-14 px-4 text-center">
                                                <div class="w-16 h-16 mx-auto mb-3.5 rounded-2xl bg-amber-50/80 border border-amber-100 flex items-center justify-center text-amber-500 shadow-sm">
                                                    <i class="fas fa-envelope-open-text text-2xl"></i>
                                                </div>
                                                <h4 class="text-base font-extrabold text-slate-800 mb-1">No pending invitations</h4>
                                                <p class="text-xs text-slate-400 max-w-md mx-auto mb-5 leading-relaxed">
                                                    All invited users have confirmed their accounts, or no pending invitation links are currently active.
                                                </p>
                                                <div class="flex items-center justify-center gap-2.5 flex-wrap">
                                                    <button type="button" onclick="document.getElementById('qiEmail')?.focus(); document.getElementById('qiEmail')?.scrollIntoView({ behavior: 'smooth', block: 'center' });" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold text-white bg-gradient-to-r from-amber-500 to-orange-500 hover:opacity-90 shadow-md transition">
                                                        <i class="fas fa-paper-plane"></i> Quick Send Invite
                                                    </button>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div><!-- /tab-invites -->

                    <!-- ══════════════════════════════
                         TAB 3 — BULK IMPORT
                    ══════════════════════════════ -->
                                        <div id="tab-bulk" class="tab-content p-5">
                        <!-- Informational Header Banner -->
                        <div class="mb-6 p-4 bg-gradient-to-r from-sky-50 to-indigo-50 border border-sky-200/70 rounded-2xl flex items-start gap-3 shadow-sm">
                            <div class="w-9 h-9 rounded-xl bg-sky-500/10 text-sky-600 flex items-center justify-center flex-shrink-0 text-base">
                                <i class="fas fa-shield-halved"></i>
                            </div>
                            <div class="text-xs">
                                <p class="font-extrabold text-sky-950 text-sm">Bulk Registration &amp; Strict Enrollment Verification</p>
                                <p class="text-slate-600 mt-1 leading-relaxed">
                                    Every imported student is verified against institutional enrollment rules before invitations are dispatched:
                                    <span class="font-bold text-sky-800">12-digit DepEd LRN validation</span>,
                                    <span class="font-bold text-sky-800">Current Active School Year enforcement</span>,
                                    <span class="font-bold text-sky-800">Enrollment Date Window check</span>, and
                                    <span class="font-bold text-sky-800">Class Max Capacity verification</span>.
                                    Duplicate sections across subjects are pinpointed by teacher name.
                                </p>
                            </div>
                        </div>

                        <!-- Role Selector Pill Toolbar -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between bg-white border border-slate-200/80 rounded-2xl p-2 mb-6 shadow-xs gap-2">
                            <div class="flex items-center gap-2">
                                <button type="button" id="btnBulkRoleStudent" onclick="switchBulkRole('student')"
                                    class="flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs transition bg-gradient-to-r from-sky-500 to-indigo-600 text-white shadow-sm">
                                    <i class="fas fa-user-graduate"></i> Student Bulk Import &amp; Enrollment
                                </button>
                                <button type="button" id="btnBulkRoleTeacher" onclick="switchBulkRole('teacher')"
                                    class="flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs text-slate-600 hover:text-emerald-700 hover:bg-emerald-50/60 transition">
                                    <i class="fas fa-chalkboard-user text-emerald-600"></i> Teacher Bulk Import &amp; Load Assignment
                                </button>
                            </div>
                            <span class="text-[11px] font-medium text-slate-400 mr-2">Switch workflow to manage bulk registrations</span>
                        </div>

                        <!-- ══ STUDENT BULK PANE ══ -->
                        <div id="bulkStudentPane">
                            <div class="bg-white rounded-2xl border border-sky-100 shadow-sm p-6">
                                <div class="flex flex-col sm:flex-row sm:items-center justify-between pb-4 mb-5 border-b border-slate-100 gap-3">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-sky-500 to-indigo-600 text-white flex items-center justify-center text-lg shadow-md shadow-sky-500/20">
                                            <i class="fas fa-user-graduate"></i>
                                        </div>
                                        <div>
                                            <h3 class="font-black text-sky-950 text-lg">Student Bulk Import &amp; Enrollment</h3>
                                            <p class="text-xs text-slate-500">Configure target class, download pre-filled templates, and verify batch enrollment</p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <button type="button" onclick="downloadStudentTemplate()"
                                            class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl text-xs font-bold bg-sky-50 text-sky-700 hover:bg-sky-100 border border-sky-200 transition shadow-sm">
                                            <i class="fas fa-file-excel text-emerald-600 text-sm"></i> Download Template (.xlsx)
                                        </button>
                                    </div>
                                </div>

                                <!-- Dynamic Section & Subject Toolbar -->
                                <div class="bg-slate-50/80 rounded-2xl border border-slate-200/80 p-5 mb-5">
                                    <div class="flex items-center justify-between mb-3">
                                        <div class="flex items-center gap-2">
                                            <span class="w-6 h-6 rounded-lg bg-sky-500 text-white text-[11px] font-black flex items-center justify-center">1</span>
                                            <span class="text-xs font-extrabold uppercase tracking-wider text-slate-700">Dynamic Section &amp; Teacher Assignment</span>
                                        </div>
                                        <span class="text-[11px] text-slate-400 font-medium">Selecting a section automatically binds the corresponding instructor</span>
                                    </div>

                                    <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
                                        <!-- Subject Selection -->
                                        <div>
                                            <label class="block text-[11px] font-black uppercase tracking-wider text-slate-600 mb-1.5" for="bulkBatchSubject">
                                                Subject <span class="text-rose-500">*</span>
                                            </label>
                                            <select id="bulkBatchSubject" class="fi text-xs font-semibold" onchange="onBatchSubjectChange()">
                                                <option value="">-- Select Subject First --</option>
                                                <% if (locals.subjectsList && subjectsList.length > 0) { %>
                                                    <% subjectsList.forEach(s => { %>
                                                        <option value="<%= s.subject_id %>" data-name="<%= s.subject_name %>">
                                                            <%= s.subject_name %> <%= s.subject_code ? '(' + s.subject_code + ')' : '' %>
                                                        </option>
                                                    <% }) %>
                                                <% } %>
                                            </select>
                                        </div>

                                        <!-- Section Selection (Filtered by Subject) -->
                                        <div>
                                            <label class="block text-[11px] font-black uppercase tracking-wider text-slate-600 mb-1.5" for="bulkBatchSection">
                                                Section <span class="text-rose-500">*</span>
                                            </label>
                                            <select id="bulkBatchSection" class="fi text-xs font-semibold disabled:bg-slate-100 disabled:text-slate-400 disabled:cursor-not-allowed" disabled onchange="onBatchSectionChange()">
                                                <option value="">-- Choose Subject to View Sections --</option>
                                            </select>
                                        </div>

                                        <!-- Auto-populated Teacher -->
                                        <div>
