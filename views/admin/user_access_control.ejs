// TOAST
// ─────────────────────────────────
function showToast(msg, type = 'info') {
    const t = document.getElementById('toast');
    const i = document.getElementById('toastIcon');
    document.getElementById('toastMsg').textContent = msg;
    i.className = `fas ${type==='success'?'fa-check-circle':type==='error'?'fa-circle-xmark':type==='warning'?'fa-triangle-exclamation':'fa-circle-info'}`;
    t.className = `show ${type}`;
    setTimeout(() => { t.className = ''; }, 3600);
}

// ─────────────────────────────────
// TABLE SEARCH + ROLE FILTER & EMPTY STATE
// ─────────────────────────────────
let _roleFilter = 'All';
function filterUsers() {
    const searchInput = document.getElementById('userSearch');
    const q = (searchInput?.value || '').toLowerCase().trim();
    const rows = document.querySelectorAll('.user-row');
    let n = 0;

    rows.forEach(r => {
        const show = (!q || r.dataset.search.includes(q)) &&
                     (_roleFilter === 'All' || r.dataset.role === _roleFilter);
        r.style.display = show ? '' : 'none';
        if (show) n++;
    });

    const countLabel = document.getElementById('userCountLabel');
    if (countLabel) countLabel.textContent = `Showing ${n} user(s)`;

    const emptyRow = document.getElementById('userEmptyRow');
    const emptyIcon = document.getElementById('userEmptyIcon');
    const emptyTitle = document.getElementById('userEmptyTitle');
    const emptySub = document.getElementById('userEmptySubtitle');
    const clearBtn = document.getElementById('userEmptyClearBtn');

    if (emptyRow) {
        if (n === 0) {
            emptyRow.classList.remove('hidden');
            if (rows.length === 0) {
                // No confirmed users at all in database
                if (emptyIcon) emptyIcon.className = 'fas fa-users text-2xl';
                if (emptyTitle) emptyTitle.textContent = 'No confirmed users yet';
                if (emptySub) emptySub.textContent = 'Users will appear here once they accept their email invitation and complete account setup.';
                if (clearBtn) clearBtn.classList.add('hidden');
            } else {
                // Search or role filter yielded 0 results
                if (emptyIcon) emptyIcon.className = 'fas fa-user-slash text-2xl';
                const roleLabel = _roleFilter === 'All' ? 'users' : `${_roleFilter.toLowerCase()}s`;
                const queryLabel = q ? ` matching "${q}"` : '';
                if (emptyTitle) emptyTitle.textContent = 'No matching users found';
                if (emptySub) emptySub.textContent = `No ${roleLabel} found${queryLabel}. Try adjusting your search query or resetting role filters.`;
                if (clearBtn) clearBtn.classList.remove('hidden');
            }
        } else {
            emptyRow.classList.add('hidden');
        }
    }
}

function setRoleFilter(role, el) {
    _roleFilter = role;
    document.querySelectorAll('.role-filter').forEach(r => r.classList.remove('rf-active'));
    if (el) el.classList.add('rf-active');
    filterUsers();
}

function clearUserFilters() {
    const input = document.getElementById('userSearch');
    if (input) input.value = '';
    const allRoleBtn = document.querySelector('.role-filter');
    if (allRoleBtn) {
        setRoleFilter('All', allRoleBtn);
    } else {
        _roleFilter = 'All';
        filterUsers();
    }
}

