// Check if email already registered or has pending invite
async function checkInvEmailDup() {
    const email = document.getElementById('invEmail').value.trim();
    if (!email) return;
    try {
        const res  = await fetch(`/admin/uac/check-dup?type=email&value=${encodeURIComponent(email)}`);
        const data = await res.json();
        if (data.exists) showInvDup(`"${email}" is already registered or has a pending invitation.`);
    } catch(_) {}
}

// Check LRN duplicate on blur (REQ#4 + REQ#6)
