window._allClasses = <%- JSON.stringify(locals.classesList || []) %>;
window._allSubjects = <%- JSON.stringify(locals.subjectsList || []) %>;
window._activeSY = <%- JSON.stringify(locals.currentSchoolYear || null) %>;
window._existingLrnsMap = <%- JSON.stringify(locals.existingLrnsMap || {}) %>;
window._pendingLrnsMap = <%- JSON.stringify(locals.pendingLrnsMap || {}) %>;
window._existingFacultyIdsMap = <%- JSON.stringify(locals.existingFacultyIdsMap || {}) %>;
window._pendingFacultyIdsMap = <%- JSON.stringify(locals.pendingFacultyIdsMap || {}) %>;

var _allClasses = window._allClasses;
var _allSubjects = window._allSubjects;
var _activeSY = window._activeSY;
var _existingLrnsMap = window._existingLrnsMap;
var _pendingLrnsMap = window._pendingLrnsMap;
var _existingFacultyIdsMap = window._existingFacultyIdsMap;
var _pendingFacultyIdsMap = window._pendingFacultyIdsMap;

var _bulkFiles = { student: null, teacher: null };
var _parsedStudentRows = [];
var _parsedTeacherRows = [];
var _batchDefaultTeacherClassIds = [];
var _activeTeacherEditingRow = -1;

function onBatchSubjectChange() {
    const subjectSelect = document.getElementById('bulkBatchSubject');
    const sectionSelect = document.getElementById('bulkBatchSection');
    const teacherInput  = document.getElementById('bulkBatchTeacher');
    const statusBanner  = document.getElementById('bulkClassStatusBanner');

    const subjectId = subjectSelect.value;
    sectionSelect.innerHTML = '<option value="">-- Choose Section --</option>';
    teacherInput.value = '';
    statusBanner.classList.add('hidden');

    if (!subjectId) {
        sectionSelect.disabled = true;
        return;
    }

    const matchingClasses = _allClasses.filter(c => String(c.subject_id) === String(subjectId));
    if (matchingClasses.length === 0) {
        sectionSelect.innerHTML = '<option value="">No sections found for this subject</option>';
        sectionSelect.disabled = true;
        return;
    }

    matchingClasses.forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.class_id;
        opt.dataset.className   = c.class_name;
        opt.dataset.subjectName = c.subject_name;
        opt.dataset.teacherName = c.teacher_name || '';
        opt.dataset.capacity    = c.max_capacity !== null && c.max_capacity !== undefined ? c.max_capacity : '';
        opt.dataset.enrolled    = c.enrolled_count_actual !== undefined ? c.enrolled_count_actual : (c.enrolled_count || 0);
        opt.dataset.start       = c.enrollment_start || '';
        opt.dataset.end         = c.enrollment_end || '';
        opt.dataset.syId        = c.sy_id || '';
        opt.dataset.syRange     = c.sy_range || '';
        opt.dataset.syActive    = c.sy_is_active ? '1' : '0';

        const capText = c.max_capacity !== null ? `${opt.dataset.enrolled}/${c.max_capacity}` : `${opt.dataset.enrolled}/∞`;
        opt.textContent = `${c.class_name} — Teacher: ${c.teacher_name || 'Unassigned'} [${capText}]`;
        sectionSelect.appendChild(opt);
    });

    sectionSelect.disabled = false;
}

function onBatchSectionChange() {
    const sectionSelect = document.getElementById('bulkBatchSection');
    const teacherInput  = document.getElementById('bulkBatchTeacher');
    const statusBanner  = document.getElementById('bulkClassStatusBanner');

    const selectedOpt = sectionSelect.options[sectionSelect.selectedIndex];
    if (!selectedOpt || !selectedOpt.value) {
        teacherInput.value = '';
        statusBanner.classList.add('hidden');
        return;
    }

    const teacherName = selectedOpt.dataset.teacherName || 'Unassigned';
    teacherInput.value = teacherName;

    // Build live status badge
    statusBanner.classList.remove('hidden');
    const cap = selectedOpt.dataset.capacity;
    const enrolled = parseInt(selectedOpt.dataset.enrolled || '0', 10);
    const start = selectedOpt.dataset.start;
    const end = selectedOpt.dataset.end;
    const isSyActive = selectedOpt.dataset.syActive === '1';
    const syRange = selectedOpt.dataset.syRange;

    const now = new Date();
    const isFull = cap !== '' && enrolled >= parseInt(cap, 10);
    const notStarted = start && now < new Date(start);
    const ended = end && now > new Date(end);

    statusBanner.innerHTML = `
        <div class="flex flex-wrap items-center gap-2 text-xs">
            <span class="font-bold ${isSyActive ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-rose-700 bg-rose-50 border-rose-200'} px-2.5 py-1 rounded-lg border">
                <i class="fas ${isSyActive ? 'fa-check-circle' : 'fa-times-circle'} mr-1"></i> SY: ${syRange || 'N/A'} ${isSyActive ? '(Active SY ✓)' : '(Inactive SY ✗)'}
            </span>
            <span class="font-bold ${!isFull ? 'text-indigo-700 bg-indigo-50 border-indigo-200' : 'text-rose-700 bg-rose-50 border-rose-200'} px-2.5 py-1 rounded-lg border">
                <i class="fas fa-users mr-1"></i> Capacity: ${enrolled}/${cap || '∞'} ${isFull ? '(FULL ✗)' : '(Seats Available ✓)'}
            </span>
            <span class="font-bold ${(!notStarted && !ended) ? 'text-emerald-700 bg-emerald-50 border-emerald-200' : 'text-rose-700 bg-rose-50 border-rose-200'} px-2.5 py-1 rounded-lg border">
                <i class="fas fa-calendar mr-1"></i> Window: ${(!notStarted && !ended) ? 'Open ✓' : (notStarted ? 'Not Started ✗' : 'Closed ✗')}
            </span>
        </div>`;
}

function applyBatchSelectionToAllRows() {
    const sectionSelect = document.getElementById('bulkBatchSection');
    const selectedOpt = sectionSelect ? sectionSelect.options[sectionSelect.selectedIndex] : null;

    if (!selectedOpt || !selectedOpt.value) {
        showToast('Please select a Subject and Section from the toolbar first.', 'warning');
        return;
    }

    const className   = selectedOpt.dataset.className;
    const subjectName = selectedOpt.dataset.subjectName;
    const teacherName = selectedOpt.dataset.teacherName || '';

    if (_parsedStudentRows.length === 0) {
        showToast(`Selection active: "${className}" (${subjectName} - ${teacherName}). Drop your Excel file to apply.`, 'info');
        return;
    }

    _parsedStudentRows.forEach(r => {
        r.subject = subjectName;
        r.section = className;
        r.teacher = teacherName;
        r.track   = 'Academic Track';
    });

    renderStudentPreviewTable();
    showToast(`Applied "${className}" (${subjectName}) across all ${_parsedStudentRows.length} rows!`, 'success');
}

function applyColumnToAll(colType) {
    if (_parsedStudentRows.length === 0) return;
    const firstRow = _parsedStudentRows[0];
    if (colType === 'subject') {
        const targetSubj = firstRow.subject;
        if (!targetSubj) { showToast('Row 1 has no subject selected.', 'warning'); return; }
        _parsedStudentRows.forEach(r => { r.subject = targetSubj; });
        showToast(`Applied subject "${targetSubj}" across all rows!`, 'success');
    } else if (colType === 'section') {
        const targetSec = firstRow.section;
        const targetSub = firstRow.subject;
        const targetTea = firstRow.teacher;
        if (!targetSec) { showToast('Row 1 has no section selected.', 'warning'); return; }
        _parsedStudentRows.forEach(r => {
            r.section = targetSec;
            if (targetSub) r.subject = targetSub;
            if (targetTea) r.teacher = targetTea;
        });
        showToast(`Applied section "${targetSec}" (Teacher: ${targetTea}) across all rows!`, 'success');
    }
    renderStudentPreviewTable();
}

function downloadStudentTemplate() {
    const sectionSelect = document.getElementById('bulkBatchSection');
    const selectedOpt = sectionSelect && sectionSelect.selectedIndex > 0 ? sectionSelect.options[sectionSelect.selectedIndex] : null;
    let url = '/admin/uac/bulk-template?type=student';
    if (selectedOpt && selectedOpt.value) {
        url += `&classId=${encodeURIComponent(selectedOpt.value)}&section=${encodeURIComponent(selectedOpt.dataset.className || '')}&subject=${encodeURIComponent(selectedOpt.dataset.subjectName || '')}&teacher=${encodeURIComponent(selectedOpt.dataset.teacherName || '')}`;
    }
    window.location.href = url;
}

function handleDrop(e, type) {
    e.preventDefault();
    const zoneId = type === 'student' ? 'dropZone' : 'dropZoneTeacher';
    const zone = document.getElementById(zoneId);
    if (zone) zone.classList.remove('dragover');
    const file = e.dataTransfer.files[0];
    if (file) setBulkFile(file, type);
}

function previewBulk(input, type) {
    if (input.files && input.files[0]) setBulkFile(input.files[0], type);
}

function setBulkFile(file, type) {
    _bulkFiles[type] = file;
    const prev = document.getElementById(`${type}Preview`);
    if (prev) {
        prev.classList.remove('hidden');
        prev.innerHTML = `
            <div class="flex items-center gap-3 p-3 bg-white rounded-xl border border-slate-200 shadow-sm">
                <i class="fas fa-file-excel text-emerald-500 text-2xl"></i>
                <div class="overflow-hidden">
                    <p class="font-bold text-xs text-slate-800 truncate">${file.name}</p>
                    <p class="text-[10px] text-slate-400">${(file.size/1024).toFixed(1)} KB · Ready to process</p>
                </div>
                <span class="ml-auto badge badge-pending">Ready</span>
            </div>`;
    }

    if (type === 'student') {
        parseAndPreviewStudentExcel(file);
    } else if (type === 'teacher') {
        parseAndPreviewTeacherExcel(file);
    }
}

function parseAndPreviewStudentExcel(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, { type: 'array' });
            const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
            const jsonRows = XLSX.utils.sheet_to_json(firstSheet, { defval: '' });

            if (!jsonRows || jsonRows.length === 0) {
                showToast('The uploaded spreadsheet contains no rows.', 'error');
                return;
            }

            // Read batch toolbar selection if set
            const sectionSelect = document.getElementById('bulkBatchSection');
            const selectedOpt = sectionSelect && sectionSelect.selectedIndex > 0 ? sectionSelect.options[sectionSelect.selectedIndex] : null;
            const defClass   = selectedOpt ? (selectedOpt.dataset.className || '') : '';
            const defSubject = selectedOpt ? (selectedOpt.dataset.subjectName || '') : '';
            const defTeacher = selectedOpt ? (selectedOpt.dataset.teacherName || '') : '';

            _parsedStudentRows = jsonRows.map((r, i) => {
                const row = {};
                for (const [k, v] of Object.entries(r)) {
                    const norm = String(k).replace('*', '').replace(/\(.*\)/, '').trim().toLowerCase().replace(/[\s-]+/g, '_');
                    row[norm] = String(v !== undefined && v !== null ? v : '').trim();
                }

                const rawLrn = (row.lrn_number || row.lrn || row.learner_reference_number || '').trim();
                return {
                    first_name  : row.first_name || '',
                    middle_name : row.middle_name || '',
                    last_name   : row.last_name || '',
                    suffix      : row.suffix || '',
                    email       : (row.email || '').toLowerCase().trim(),
                    lrn_number  : rawLrn,
                    grade_level : row.grade_level || 'Grade 11',
                    subject     : row.subject || row.subject_name || row.course || defSubject,
                    section     : row.section || row.class || defClass,
                    teacher     : row.teacher || row.teacher_name || row.instructor || defTeacher,
                    track       : row.track || row.strand || 'Academic Track',
                    sex         : row.sex || '',
                    birthdate   : row.birthdate || '',
                    mobile_number: row.mobile_number || '',
                    city_town   : row.city_town || '',
                    interests   : row.interests || '',
                };
            });

            renderStudentPreviewTable();
            document.getElementById('studentPreviewContainer').classList.remove('hidden');
            document.getElementById('submitStudentBulk').disabled = false;
            showToast(`Loaded ${_parsedStudentRows.length} student rows for review.`, 'success');

        } catch (err) {
            console.error('Error reading spreadsheet:', err);
            showToast('Failed to parse Excel file: ' + err.message, 'error');
        }
    };
    reader.readAsArrayBuffer(file);
}

function evaluateStudentRow(r, idx, allRows) {
    const rawLrn = String(r.lrn_number || '').trim();
    const cleanLrn = rawLrn.replace(/\D/g, '');
    const lrnLen = cleanLrn.length;
    const isLrnDigitsOnly = /^\d{12}$/.test(rawLrn);

    if (!r.email) return { ok: false, msg: 'Missing email', badgeClass: 'badge-expired' };
    if (!r.first_name || !r.last_name) return { ok: false, msg: 'Missing name', badgeClass: 'badge-expired' };
    if (!rawLrn) return { ok: false, msg: 'LRN required (12 digits)', badgeClass: 'badge-expired', isLrnMissing: true };
    if (!isLrnDigitsOnly) return { ok: false, msg: `LRN must be 12 digits (${lrnLen}/12)`, badgeClass: 'badge-expired', isLrnInvalid: true };

    // Strict LRN Uniqueness Check within Batch
    if (allRows && idx !== undefined) {
        const dupIdx = allRows.findIndex((other, oIdx) => oIdx !== idx && String(other.lrn_number || '').trim() === rawLrn);
        if (dupIdx !== -1) {
            return {
                ok: false,
                msg: `Duplicate LRN (matches Row #${dupIdx + 1})`,
                badgeClass: 'badge-expired',
                isLrnDup: true,
                dupRow: dupIdx + 1
            };
        }
    }

    // Strict LRN Uniqueness Check against Registered Users
    if (typeof _existingLrnsMap !== 'undefined' && _existingLrnsMap && _existingLrnsMap[cleanLrn]) {
        return {
            ok: false,
            msg: `Duplicate LRN: Already registered to "${_existingLrnsMap[cleanLrn]}"`,
            badgeClass: 'badge-expired',
            isLrnDup: true,
            isExistingUser: true
        };
    }

    // Strict LRN Uniqueness Check against Pending Invitations
    if (typeof _pendingLrnsMap !== 'undefined' && _pendingLrnsMap && _pendingLrnsMap[cleanLrn]) {
        return {
            ok: false,
            msg: `Duplicate LRN: Reserved in invite (${_pendingLrnsMap[cleanLrn]})`,
            badgeClass: 'badge-expired',
            isLrnDup: true,
            isPendingInvite: true
        };
    }

    if (!r.section) return { ok: false, msg: 'No section assigned', badgeClass: 'badge-pending' };

    // Find class match
    let matches = _allClasses.filter(c => c.class_name.toLowerCase().trim() === r.section.toLowerCase().trim());
    if (r.teacher) {
        const tNorm = r.teacher.toLowerCase().trim();
        const tMatches = matches.filter(c => (c.teacher_name || '').toLowerCase().includes(tNorm) || (c.teacher_last || '').toLowerCase() === tNorm);
        if (tMatches.length > 0) matches = tMatches;
    }
    if (r.subject) {
        const sNorm = r.subject.toLowerCase().trim();
        const sMatches = matches.filter(c => (c.subject_name || '').toLowerCase().includes(sNorm) || (c.subject_code || '').toLowerCase() === sNorm);
        if (sMatches.length > 0) matches = sMatches;
    }

    if (matches.length === 0) return { ok: false, msg: 'Section not found', badgeClass: 'badge-expired' };
    if (matches.length > 1) return { ok: false, msg: 'Ambiguous section (specify Teacher)', badgeClass: 'badge-pending' };

    const cls = matches[0];
    if (_activeSY && (cls.sy_id !== _activeSY.sy_id || !cls.sy_is_active)) {
        return { ok: false, msg: `Inactive SY (${cls.sy_range || 'Past/Future'})`, badgeClass: 'badge-expired' };
    }

    const now = new Date();
    if (cls.enrollment_start && now < new Date(cls.enrollment_start)) {
        return { ok: false, msg: 'Enrollment not started', badgeClass: 'badge-expired' };
    }
    if (cls.enrollment_end && now > new Date(cls.enrollment_end)) {
        return { ok: false, msg: 'Enrollment ended', badgeClass: 'badge-expired' };
    }

    const enrolled = parseInt(cls.enrolled_count_actual !== undefined ? cls.enrolled_count_actual : (cls.enrolled_count || 0), 10);
    if (cls.max_capacity !== null && cls.max_capacity !== undefined && enrolled >= cls.max_capacity) {
        return { ok: false, msg: `Capacity full (${enrolled}/${cls.max_capacity})`, badgeClass: 'badge-expired' };
    }

    return { ok: true, msg: 'Eligible ✓', badgeClass: 'badge-teacher', classObj: cls };
}

function renderStudentPreviewTable() {
    const tbody = document.getElementById('tblStudentPreviewBody');
    if (!tbody) return;

    let validCount = 0;
    let issueCount = 0;
    let dupLrnCount = 0;

    let html = '';
    _parsedStudentRows.forEach((r, idx) => {
        const evalResult = evaluateStudentRow(r, idx, _parsedStudentRows);
        if (evalResult.ok) validCount++; else issueCount++;
        if (evalResult.isLrnDup) dupLrnCount++;

        // Subject options
        let subjOptions = '<option value="">-- Choose Subject --</option>';
        _allSubjects.forEach(s => {
            const isSel = r.subject && (r.subject.toLowerCase() === s.subject_name.toLowerCase() || String(r.subject) === String(s.subject_id));
            subjOptions += `<option value="${s.subject_name}" ${isSel ? 'selected' : ''}>${s.subject_name}</option>`;
        });

        // Filter sections for this row based on chosen subject
        let secOptions = '<option value="">-- Choose Section --</option>';
        const rowClasses = r.subject 
            ? _allClasses.filter(c => c.subject_name.toLowerCase() === r.subject.toLowerCase() || String(c.subject_id) === String(r.subject))
            : _allClasses;

        rowClasses.forEach(c => {
            const isSel = r.section && r.section.toLowerCase() === c.class_name.toLowerCase() && (!r.teacher || (c.teacher_name || '').toLowerCase().includes(r.teacher.toLowerCase()));
            secOptions += `<option value="${c.class_name}" data-teacher="${c.teacher_name || ''}" data-subject="${c.subject_name}" ${isSel ? 'selected' : ''}>${c.class_name} (${c.subject_name} - ${c.teacher_name || 'Unassigned'})</option>`;
        });

        const rawLrn = String(r.lrn_number || '');
        const cleanLrn = rawLrn.replace(/\D/g, '');
        const lrnLen = cleanLrn.length;
        
        let lrnBorderClass = 'border-slate-300';
        let lrnStatusBadge = '';
        if (!rawLrn) {
            lrnBorderClass = 'border-rose-400 bg-rose-50 text-rose-700';
            lrnStatusBadge = '<span class="text-[10px] text-rose-500 font-extrabold ml-1">✗ Missing</span>';
        } else if (!/^\d{12}$/.test(rawLrn)) {
            lrnBorderClass = 'border-rose-400 bg-rose-50 text-rose-700';
            lrnStatusBadge = `<span class="text-[10px] text-rose-500 font-extrabold ml-1 animate-pulse">✗ ${lrnLen}/12d</span>`;
        } else if (evalResult.isLrnDup) {
            lrnBorderClass = 'border-rose-500 bg-rose-100 text-rose-900 font-black ring-2 ring-rose-400';
            lrnStatusBadge = `<span class="text-[10px] text-rose-700 font-black ml-1 whitespace-nowrap bg-rose-200 px-1.5 py-0.5 rounded shadow-sm"><i class="fas fa-triangle-exclamation mr-0.5"></i> Duplicate</span>`;
        } else {
            lrnBorderClass = 'border-emerald-300 bg-emerald-50/40 text-slate-800';
            lrnStatusBadge = '<span class="text-[10px] text-emerald-600 font-extrabold ml-1">✓ Unique</span>';
        }

        html += `
            <tr class="${!evalResult.ok ? 'bg-rose-50/40' : ''} hover:bg-slate-50 transition">
                <td class="p-3 text-center font-mono font-bold text-slate-400">${idx + 1}</td>
                <td class="p-3 font-bold text-slate-800">
                    <span class="block truncate max-w-[150px]">${r.first_name} ${r.last_name}</span>
                </td>
                <td class="p-3 text-slate-600">
                    <span class="block truncate max-w-[170px]">${r.email}</span>
                </td>
                <td class="p-3">
                    <div class="flex items-center">
                        <input type="text" value="${rawLrn}" maxlength="12"
                            oninput="onRowLrnChange(${idx}, this)"
                            placeholder="12-digit LRN"
                            class="fi text-xs font-mono py-1 px-2 w-28 ${lrnBorderClass}">
                        ${lrnStatusBadge}
                    </div>
                </td>
                <td class="p-3">
                    <select class="fi text-xs py-1 px-2 font-semibold" onchange="onRowSubjectChange(${idx}, this)">
                        ${subjOptions}
                    </select>
                </td>
                <td class="p-3">
                    <select class="fi text-xs py-1 px-2 font-semibold" onchange="onRowSectionChange(${idx}, this)">
                        ${secOptions}
                    </select>
                </td>
                <td class="p-3 text-slate-700 font-semibold text-xs">
                    <input type="text" readonly value="${r.teacher || 'Unassigned'}" class="fi text-xs py-1 px-2 bg-slate-100/80 font-bold border-transparent">
                </td>
                <td class="p-3">
                    <input type="text" readonly value="${r.track || 'Academic Track'}" class="fi text-xs py-1 px-2 bg-slate-100/80 font-bold border-transparent text-slate-600">
                </td>
                <td class="p-3 text-center">
                    <span class="badge ${evalResult.badgeClass} whitespace-nowrap">${evalResult.msg}</span>
                </td>
            </tr>`;
    });

    tbody.innerHTML = html;

    // Metrics Bar
    const metricsBar = document.getElementById('previewMetricsBar');
    if (metricsBar) {
        metricsBar.innerHTML = `
            <span class="badge text-[11px] font-black bg-slate-100 text-slate-700 px-3 py-1">Total: ${_parsedStudentRows.length}</span>
            <span class="badge text-[11px] font-black bg-emerald-100 text-emerald-800 px-3 py-1">✓ Ready: ${validCount}</span>
            ${issueCount > 0 ? `<span class="badge text-[11px] font-black bg-rose-100 text-rose-800 px-3 py-1 animate-pulse">⚠ Issues: ${issueCount}</span>` : ''}
            ${dupLrnCount > 0 ? `<span class="badge text-[11px] font-black bg-rose-200 text-rose-900 px-3 py-1 font-black animate-pulse"><i class="fas fa-triangle-exclamation mr-1 text-rose-600"></i> ${dupLrnCount} Duplicate LRN(s)</span>` : ''}
        `;
    }

    const summaryText = document.getElementById('previewSummaryText');
    if (summaryText) {
        summaryText.textContent = issueCount === 0
            ? `All ${_parsedStudentRows.length} students are eligible and ready for enrollment.`
            : `${issueCount} student(s) have validation issues (marked in red)${dupLrnCount > 0 ? ` including ${dupLrnCount} duplicate LRN(s)` : ''}. Fix errors before importing.`;
    }
}

function onRowSubjectChange(rowIdx, selectElem) {
    if (!_parsedStudentRows[rowIdx]) return;
    _parsedStudentRows[rowIdx].subject = selectElem.value;
    // Auto-select first matching section
    const matching = _allClasses.filter(c => c.subject_name.toLowerCase() === selectElem.value.toLowerCase());
    if (matching.length > 0) {
        _parsedStudentRows[rowIdx].section = matching[0].class_name;
        _parsedStudentRows[rowIdx].teacher = matching[0].teacher_name || '';
    } else {
        _parsedStudentRows[rowIdx].section = '';
        _parsedStudentRows[rowIdx].teacher = '';
    }
    renderStudentPreviewTable();
}

function onRowSectionChange(rowIdx, selectElem) {
    if (!_parsedStudentRows[rowIdx]) return;
    const selectedOpt = selectElem.options[selectElem.selectedIndex];
    _parsedStudentRows[rowIdx].section = selectElem.value;
    if (selectedOpt && selectedOpt.dataset) {
        _parsedStudentRows[rowIdx].teacher = selectedOpt.dataset.teacher || '';
        if (selectedOpt.dataset.subject) _parsedStudentRows[rowIdx].subject = selectedOpt.dataset.subject;
    }
    renderStudentPreviewTable();
}

function onRowLrnChange(rowIdx, inputElem) {
    if (!_parsedStudentRows[rowIdx]) return;
    _parsedStudentRows[rowIdx].lrn_number = inputElem.value.trim();
    renderStudentPreviewTable();
}

async function submitBulk(type) {
    const file = _bulkFiles[type];
    if (!file && (type === 'teacher' || _parsedStudentRows.length === 0)) {
        showToast('Please select an Excel file first.', 'warning');
        return;
    }

    const resultsContainer = document.getElementById('bulkResultsContainer');

    if (type === 'student' && _parsedStudentRows.length > 0) {
        // Pre-validate duplicate LRNs before submitting
        const lrnTracker = {};
        const dupRowsFound = [];
        _parsedStudentRows.forEach((r, idx) => {
            const rawLrn = String(r.lrn_number || '').trim();
            if (rawLrn) {
                if (lrnTracker[rawLrn]) {
                    dupRowsFound.push({ lrn: rawLrn, row1: lrnTracker[rawLrn], row2: idx + 1, name: `${r.first_name} ${r.last_name}` });
                } else {
                    lrnTracker[rawLrn] = idx + 1;
                }
            }
        });

        if (dupRowsFound.length > 0) {
            const dupListHtml = dupRowsFound.map(d => `<li>LRN <b>${d.lrn}</b> duplicated in Row #${d.row1} and Row #${d.row2} (${d.name})</li>`).join('');
            if (resultsContainer) {
                resultsContainer.classList.remove('hidden');
                resultsContainer.innerHTML = `
                    <div class="p-5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 shadow-sm">
                        <p class="font-black text-sm flex items-center gap-2"><i class="fas fa-triangle-exclamation text-rose-600 text-base"></i> Duplicate LRN Detected — Import Blocked</p>
                        <p class="text-xs text-rose-700 mt-1 mb-2">Each student must have a unique 12-digit LRN. Duplicate LRNs cannot be imported:</p>
                        <ul class="list-disc list-inside text-xs font-mono font-bold text-rose-800 bg-white p-3 rounded-xl border border-rose-200 space-y-1">
                            ${dupListHtml}
                        </ul>
                        <p class="text-[11px] text-rose-600 mt-2">Please correct the duplicate rows in the preview table or in your Excel file before submitting.</p>
                    </div>`;
            }
            showToast('Duplicate LRNs detected! Each student must have a unique LRN.', 'error');
            return;
        }
    }

    if (type === 'teacher' && _parsedTeacherRows.length > 0) {
        // 1. Pre-validate missing or duplicate Faculty IDs
        const fidTracker = {};
        const dupFidRows = [];
        let missingFidRows = 0;
        let missingClassRows = 0;
        const conflictedSectionsMap = {};

        const existingFids = (typeof _existingFacultyIdsMap !== 'undefined' && _existingFacultyIdsMap) ? _existingFacultyIdsMap : (window._existingFacultyIdsMap || {});
        const pendingFids  = (typeof _pendingFacultyIdsMap !== 'undefined' && _pendingFacultyIdsMap) ? _pendingFacultyIdsMap : (window._pendingFacultyIdsMap || {});

        _parsedTeacherRows.forEach((r, idx) => {
            const fid = String(r.faculty_id || '').trim();
            if (!fid) {
                missingFidRows++;
            } else if (fidTracker[fid]) {
                dupFidRows.push({ fid, row1: fidTracker[fid], row2: idx + 1, name: `${r.first_name} ${r.last_name}` });
            } else if (existingFids[fid]) {
                dupFidRows.push({ fid, row1: 'Active User', row2: idx + 1, name: `${r.first_name} ${r.last_name} (Used by ${existingFids[fid]})` });
            } else if (pendingFids[fid]) {
                dupFidRows.push({ fid, row1: 'Pending Invite', row2: idx + 1, name: `${r.first_name} ${r.last_name} (Reserved for ${pendingFids[fid]})` });
            } else {
                fidTracker[fid] = idx + 1;
            }

            if (!r.class_ids || r.class_ids.length === 0) {
                missingClassRows++;
            } else {
                r.class_ids.forEach(cid => {
                    const cls = _allClasses.find(c => c.class_id === cid);
                    if (cls && cls.teacher_id && cls.teacher_name && cls.teacher_name.trim()) {
                        conflictedSectionsMap[cid] = {
                            className: cls.class_name,
                            subjectName: cls.subject_name,
                            teacherName: cls.teacher_name.trim()
                        };
                    }
                });
            }
        });

        if (missingFidRows > 0 || dupFidRows.length > 0 || missingClassRows > 0) {
            let errorMsg = '';
            if (missingFidRows > 0) errorMsg += `<li>${missingFidRows} teacher(s) have missing Faculty IDs.</li>`;
            if (missingClassRows > 0) errorMsg += `<li>${missingClassRows} teacher(s) have no classes assigned.</li>`;
            dupFidRows.forEach(d => {
                errorMsg += `<li>Faculty ID <b>${d.fid}</b> is duplicate (Row #${d.row2} - ${d.name}).</li>`;
            });

            if (resultsContainer) {
                resultsContainer.classList.remove('hidden');
                resultsContainer.innerHTML = `
                    <div class="p-5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-900 shadow-sm">
                        <p class="font-black text-sm flex items-center gap-2"><i class="fas fa-triangle-exclamation text-rose-600 text-base"></i> Validation Errors — Import Blocked</p>
                        <ul class="list-disc list-inside text-xs font-bold text-rose-800 bg-white p-3 rounded-xl border border-rose-200 mt-2 space-y-1">
                            ${errorMsg}
                        </ul>
                    </div>`;
            }
            showToast('Please correct Faculty ID and Class assignment errors before proceeding.', 'error');
            return;
        }

        // 2. Pre-flight Section Teacher Conflict Check
        const conflictsList = Object.values(conflictedSectionsMap);
        if (conflictsList.length > 0) {
            const listHtml = conflictsList.map(c => `<li class="py-1 text-left"><b>${c.subjectName} — Section ${c.className}</b>: currently handled by <i>${c.teacherName}</i></li>`).join('');

            if (window.Swal) {
                const res = await Swal.fire({
                    title: 'Section Teacher Conflicts Detected',
                    html: `
                        <div class="text-sm text-slate-600">
                            <p class="mb-2">The following section(s) currently have an assigned teacher:</p>
                            <div class="max-h-40 overflow-y-auto bg-amber-50 border border-amber-200 rounded-xl p-3 my-2 text-xs text-amber-900">
                                <ul class="list-disc list-inside space-y-1">
                                    ${listHtml}
                                </ul>
                            </div>
                            <p class="text-xs text-slate-500 mt-2">
                                Proceeding with the import will replace these existing instructors and reassign the sections to the imported teachers.
                            </p>
                        </div>
                    `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#059669',
                    cancelButtonColor: '#64748b',
                    confirmButtonText: '<i class="fas fa-check-circle mr-1"></i> Proceed & Replace',
                    cancelButtonText: '<i class="fas fa-arrow-left mr-1"></i> Cancel & Review Selection',
                    reverseButtons: true
                });

                if (!res.isConfirmed) {
                    return; // User canceled
                }
            } else {
                const proceed = confirm(`${conflictsList.length} section(s) already have an assigned instructor. Proceeding will replace them. Continue?`);
                if (!proceed) return;
            }
        }
    }

    const fd = new FormData();
    if (file) fd.append('file', file);
    fd.append('type', type);

    if (type === 'student' && _parsedStudentRows.length > 0) {
        fd.append('students_json', JSON.stringify(_parsedStudentRows));
    } else if (type === 'teacher' && _parsedTeacherRows.length > 0) {
        fd.append('teachers_json', JSON.stringify(_parsedTeacherRows));
        if (typeof _batchDefaultTeacherClassIds !== 'undefined' && _batchDefaultTeacherClassIds && _batchDefaultTeacherClassIds.length > 0) {
            fd.append('default_classes', JSON.stringify(_batchDefaultTeacherClassIds));
        }
    }

    const log = document.getElementById('importLog');
    
    if (resultsContainer) {
        resultsContainer.classList.remove('hidden');
        resultsContainer.innerHTML = `
            <div class="p-6 rounded-2xl bg-sky-50 border border-sky-200 text-center animate-pulse">
                <i class="fas fa-spinner fa-spin text-3xl text-sky-600 mb-2"></i>
                <p class="font-bold text-sky-900 text-sm">${type === 'teacher' ? 'Processing teacher invitations & assigning teaching loads…' : 'Processing registration & enforcing enrollment rules…'}</p>
                <p class="text-xs text-sky-600 mt-1">${type === 'teacher' ? 'Verifying Faculty IDs, resolving sections, and dispatching invitation emails' : 'Verifying LRNs, capacity caps, timeframe validity, and dispatching invitation emails'}</p>
            </div>`;
    }

    const submitBtn = document.getElementById(type === 'student' ? 'submitStudentBulk' : 'submitTeacherBulk');
    if (submitBtn) submitBtn.disabled = true;

    try {
        const res  = await fetch('/admin/uac/bulk-import', { method: 'POST', body: fd });
        const data = await res.json();

        if (submitBtn) submitBtn.disabled = false;

        if (data.success) {
            renderBulkImportResults(data, type);
            showToast(`Processed ${data.created} invitation(s) successfully!`, 'success');
        } else {
            if (resultsContainer) {
                resultsContainer.innerHTML = `
                    <div class="p-5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800">
                        <p class="font-black text-sm flex items-center gap-2"><i class="fas fa-circle-xmark text-rose-600 text-base"></i> Bulk Import Failed</p>
                        <p class="text-xs mt-1.5">${data.message || 'An error occurred during bulk import.'}</p>
                    </div>`;
            }
            showToast(data.message || 'Import failed.', 'error');
        }
    } catch (err) {
        if (submitBtn) submitBtn.disabled = false;
        if (resultsContainer) {
            resultsContainer.innerHTML = `
                <div class="p-5 rounded-2xl bg-rose-50 border border-rose-200 text-rose-800">
                    <p class="font-black text-sm"><i class="fas fa-triangle-exclamation mr-1"></i> Network error during import</p>
                    <p class="text-xs mt-1">${err.message}</p>
                </div>`;
        }
        showToast('Network error occurred.', 'error');
    }
}

function renderBulkImportResults(data, type) {
    const container = document.getElementById('bulkResultsContainer');
    if (!container) return;

    const details = data.details || {};
    const passedRows = details.passedRows || [];
    const failedRows = details.failedRows || [];

    const isTeacher = (type === 'teacher');

    let html = `
        <div class="space-y-4">
            <!-- Summary Header -->
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
                <div class="p-4 rounded-xl bg-white border border-slate-200 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] font-black uppercase tracking-wider text-slate-400">Total Processed</p>
                        <p class="text-2xl font-black text-slate-800">${details.totalRows || (data.created + data.skipped + data.errors)}</p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-slate-100 flex items-center justify-center text-slate-600 font-black"><i class="fas fa-list"></i></div>
                </div>
                <div class="p-4 rounded-xl bg-emerald-50 border border-emerald-200 shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] font-black uppercase tracking-wider text-emerald-700">${isTeacher ? 'Assigned &amp; Invited' : 'Enrolled &amp; Invited'}</p>
                        <p class="text-2xl font-black text-emerald-800">${data.created}</p>
                    </div>
                    <div class="w-10 h-10 rounded-xl bg-emerald-200/50 flex items-center justify-center text-emerald-700 font-black"><i class="fas fa-check"></i></div>
                </div>
                <div class="p-4 rounded-xl ${failedRows.length > 0 ? 'bg-rose-50 border-rose-200' : 'bg-slate-50 border-slate-200'} shadow-sm flex items-center justify-between">
                    <div>
                        <p class="text-[11px] font-black uppercase tracking-wider ${failedRows.length > 0 ? 'text-rose-700' : 'text-slate-400'}">Blocked / Issues</p>
                        <p class="text-2xl font-black ${failedRows.length > 0 ? 'text-rose-800' : 'text-slate-400'}">${data.skipped + data.errors}</p>
                    </div>
                    <div class="w-10 h-10 rounded-xl ${failedRows.length > 0 ? 'bg-rose-200/50 text-rose-700' : 'bg-slate-200/50 text-slate-400'} flex items-center justify-center font-black">
                        <i class="fas fa-triangle-exclamation"></i>
                    </div>
                </div>
            </div>`;

    // If there are failures: EXPLICIT DETAILED ERROR MESSAGES
    if (failedRows.length > 0) {
        html += `
            <div class="p-5 rounded-2xl bg-rose-50 border border-rose-200 shadow-sm">
                <div class="flex items-center gap-2 mb-3 text-rose-900">
                    <i class="fas fa-circle-exclamation text-rose-600 text-lg"></i>
                    <h4 class="font-black text-sm">${isTeacher ? `Invitation Blocked for ${failedRows.length} Teacher(s) — Action Required` : `Registration Blocked for ${failedRows.length} Student(s) — Action Required`}</h4>
                </div>
                <p class="text-xs text-rose-700 mb-3">
                    ${isTeacher 
                        ? 'The following teachers could not be invited because teaching load assignment or Faculty ID verification failed. Please review the detailed reason for each teacher:' 
                        : 'The following students could not be registered because standard enrollment criteria or LRN requirements failed. Please review the detailed reason for each student:'}
                </p>
                <div class="border border-rose-200 rounded-xl overflow-hidden bg-white shadow-sm max-h-72 overflow-y-auto">
                    <table class="w-full text-left text-xs border-collapse">
                        <thead class="bg-rose-100/70 border-b border-rose-200 font-black text-rose-900 uppercase">
                            <tr>
                                <th class="p-2.5 w-12 text-center">Row</th>
                                <th class="p-2.5">${isTeacher ? 'Teacher / Email' : 'Student / Email'}</th>
                                <th class="p-2.5">${isTeacher ? 'Reason for Blocked Invitation' : 'Explicit Enrollment Error Reason'}</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-rose-100">
                            ${failedRows.map(f => `
                                <tr class="hover:bg-rose-50/50 transition">
                                    <td class="p-2.5 text-center font-bold text-rose-500 font-mono">${f.row}</td>
                                    <td class="p-2.5 font-bold text-slate-800">
                                        <span>${f.name}</span>
                                        <span class="block text-[11px] font-normal text-slate-500">${f.email}</span>
                                    </td>
                                    <td class="p-2.5 font-bold text-rose-700 leading-snug">
                                        <i class="fas fa-ban text-rose-500 mr-1 text-[11px]"></i> ${f.reason}
                                    </td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>
                </div>
            </div>`;
    }

    // If there are passed rows: Confirmed list
    if (passedRows.length > 0) {
        html += `
            <div class="p-5 rounded-2xl bg-emerald-50 border border-emerald-200 shadow-sm">
                <div class="flex items-center gap-2 mb-3 text-emerald-900">
                    <i class="fas fa-circle-check text-emerald-600 text-lg"></i>
                    <h4 class="font-black text-sm">${isTeacher ? `Successfully Assigned &amp; Invitations Sent (${passedRows.length})` : `Successfully Enrolled &amp; Invitations Sent (${passedRows.length})`}</h4>
                </div>
                <div class="border border-emerald-200 rounded-xl overflow-hidden bg-white shadow-sm max-h-60 overflow-y-auto">`;

        if (isTeacher) {
            html += `
                    <table class="w-full text-left text-xs border-collapse">
                        <thead class="bg-emerald-100/70 border-b border-emerald-200 font-black text-emerald-900 uppercase">
                            <tr>
                                <th class="p-2.5 w-12 text-center">#</th>
                                <th class="p-2.5">Teacher Name</th>
                                <th class="p-2.5">Faculty ID</th>
                                <th class="p-2.5">Department</th>
                                <th class="p-2.5">Assigned Classes / Teaching Load</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-emerald-100">
                            ${passedRows.map((p, idx) => `
                                <tr class="hover:bg-emerald-50/50 transition">
                                    <td class="p-2.5 text-center font-bold text-emerald-600 font-mono">${idx + 1}</td>
                                    <td class="p-2.5 font-bold text-slate-800">${p.name} <span class="text-[10px] text-slate-400 block">${p.email}</span></td>
                                    <td class="p-2.5 font-mono font-bold text-slate-700">${p.faculty_id || '—'}</td>
                                    <td class="p-2.5 font-bold text-teal-700">${p.department || 'Science Department'}</td>
                                    <td class="p-2.5 font-bold text-emerald-800">${p.assigned_load || '—'}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>`;
        } else {
            html += `
                    <table class="w-full text-left text-xs border-collapse">
                        <thead class="bg-emerald-100/70 border-b border-emerald-200 font-black text-emerald-900 uppercase">
                            <tr>
                                <th class="p-2.5 w-12 text-center">#</th>
                                <th class="p-2.5">Student Name</th>
                                <th class="p-2.5">LRN</th>
                                <th class="p-2.5">Section</th>
                                <th class="p-2.5">Subject</th>
                                <th class="p-2.5">Teacher</th>
                                <th class="p-2.5">Track</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-emerald-100">
                            ${passedRows.map((p, idx) => `
                                <tr class="hover:bg-emerald-50/50 transition">
                                    <td class="p-2.5 text-center font-bold text-emerald-600 font-mono">${idx + 1}</td>
                                    <td class="p-2.5 font-bold text-slate-800">${p.name} <span class="text-[10px] text-slate-400 block">${p.email}</span></td>
                                    <td class="p-2.5 font-mono font-bold text-slate-700">${p.lrn || '—'}</td>
                                    <td class="p-2.5 font-bold text-indigo-700">${p.section}</td>
                                    <td class="p-2.5 text-slate-700">${p.subject}</td>
                                    <td class="p-2.5 text-slate-700 font-medium">${p.teacher}</td>
                                    <td class="p-2.5 font-bold text-slate-600">${p.track}</td>
                                </tr>
                            `).join('')}
                        </tbody>
                    </table>`;
        }

        html += `
                </div>
            </div>`;
    }

    html += '</div>';
    container.innerHTML = html;
}

function downloadTemplate(type) {
    if (type === 'student') downloadStudentTemplate();
    else window.location.href = `/admin/uac/bulk-template?type=${type}`;
}
</script>

