function clearInvDup() {
    document.getElementById('invDupBanner').classList.remove('show');
}
function showInvDup(msg) {
    document.getElementById('invDupMsg').textContent = msg;
    document.getElementById('invDupBanner').classList.add('show');
}

// Check if email already registered or has pending invite
async function checkInvEmailDup() {
    const email = document.getElementById('invEmail').value.trim();
    if (!email) return;
    try {
        const res  = await fetch(`/admin/uac/check-dup?type=email&value=${encodeURIComponent(email)}`);
        const data = await res.json();
        if (data.exists) showInvDup(`"${email}" is already registered or has a pending invitation.`);
    } catch(_) {}
}

// Check LRN duplicate on blur (REQ#4 + REQ#6)
async function checkInvLRNDup() {
    const lrn = document.getElementById('invLRN').value.trim();
    if (!lrn || lrn.length !== 12) return;
    try {
        const res  = await fetch(`/admin/uac/check-dup?type=lrn&value=${encodeURIComponent(lrn)}`);
        const data = await res.json();
        if (data.exists) showInvDup(`LRN "${lrn}" is already used by another student.`);
    } catch(_) {}
}

// Check Faculty ID duplicate on blur / input
async function checkInvFacIdDup() {
    const fidEl = document.getElementById('invFacultyId');
    const errEl = document.getElementById('errInvFacId');
    const fid = fidEl ? fidEl.value.trim() : '';
    if (!fid) {
        if (fidEl) fidEl.classList.remove('invalid');
        if (errEl) errEl.classList.remove('show');
        return false;
    }
    try {
        const res  = await fetch(`/admin/uac/check-dup?type=faculty_id&value=${encodeURIComponent(fid)}`);
        const data = await res.json();
        if (data.exists) {
            showInvDup(`Faculty ID "${fid}" is already in use.`);
            if (fidEl) fidEl.classList.add('invalid');
            if (errEl) {
                errEl.textContent = `Faculty ID "${fid}" is already in use.`;
                errEl.classList.add('show');
            }
            return true;
        } else {
            if (fidEl) fidEl.classList.remove('invalid');
            if (errEl) errEl.classList.remove('show');
            return false;
        }
    } catch(_) {
        return false;
    }
}

// ─────────────────────────────────
// TEACHER SUBJECT & SECTIONS HIERARCHICAL SELECTION (OPTION 1)
// ─────────────────────────────────
function renderTeacherClassHierarchy() {
    const listContainer = document.getElementById('invTeacherHierarchyList');
    if (!listContainer) return;

    if (!_allSubjects || _allSubjects.length === 0) {
        listContainer.innerHTML = `
            <div class="py-6 text-center text-xs text-slate-400">
                <i class="fas fa-circle-exclamation mb-1 text-base block"></i>
                No subjects found in the system.
            </div>
        `;
        return;
    }

    let html = '';
    _allSubjects.forEach(s => {
        const subjectClasses = _allClasses.filter(c => String(c.subject_id) === String(s.subject_id));
        const totalInSubj = subjectClasses.length;

        let classesHtml = '';
        if (totalInSubj === 0) {
            classesHtml = `
                <div class="py-2.5 text-center text-[11px] text-slate-400 italic">
                    No classes currently registered taking this subject.
                </div>
            `;
        } else {
            subjectClasses.forEach(c => {
                const hasTeacher = !!(c.teacher_id && c.teacher_name && c.teacher_name.trim());
                const teacherBadge = hasTeacher
                    ? `<span class="inline-flex items-center gap-1 text-[10px] font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded">
                         <i class="fas fa-user-tie text-[9px]"></i> Current: ${c.teacher_name.trim()}
                       </span>`
                    : `<span class="inline-flex items-center gap-1 text-[10px] font-semibold text-slate-500 bg-slate-100 border border-slate-200 px-1.5 py-0.5 rounded">
                         <i class="fas fa-user-plus text-[9px]"></i> No Teacher Assigned
                       </span>`;

                classesHtml += `
                    <label class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-50 cursor-pointer transition select-none group border border-transparent hover:border-slate-200">
                        <div class="flex items-center gap-2.5">
                            <input type="checkbox"
                                   name="teacherClassCheckbox"
                                   value="${c.class_id}"
                                   data-class-id="${c.class_id}"
                                   data-class-name="${c.class_name}"
                                   data-subject-id="${s.subject_id}"
                                   data-subject-name="${s.subject_name}"
                                   data-has-teacher="${hasTeacher ? '1' : '0'}"
                                   data-teacher-name="${hasTeacher ? c.teacher_name.trim() : ''}"
                                   onchange="updateTeacherHierarchySummary()"
                                   class="teacher-class-cb teacher-subj-cb-${s.subject_id} w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300">
                            <div>
                                <span class="text-xs font-bold text-slate-800 group-hover:text-emerald-700 transition">
                                    ${c.class_name}
                                </span>
                                <span class="text-[11px] text-slate-400 ml-1">
                                    (${c.enrolled_count || 0}/${c.max_capacity !== null ? c.max_capacity : '∞'} students)
                                </span>
                            </div>
                        </div>
                        <div>
                            ${teacherBadge}
                        </div>
                    </label>
                `;
            });
        }

        html += `
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs transition hover:border-slate-300">
                <!-- Subject Group Header -->
                <div class="flex items-center justify-between px-3 py-2 bg-slate-50 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 rounded-md bg-emerald-100 text-emerald-700 flex items-center justify-center text-xs font-bold">
                            <i class="fas fa-book-bookmark text-[11px]"></i>
                        </span>
                        <div>
                            <span class="text-xs font-bold text-slate-800">${s.subject_name}</span>
                            ${s.subject_code ? `<span class="text-[10px] font-mono text-slate-400 ml-1">(${s.subject_code})</span>` : ''}
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <span id="subjBadge_${s.subject_id}" class="text-[10px] font-bold text-slate-500 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-full">
                            0 / ${totalInSubj} selected
                        </span>
                        ${totalInSubj > 0 ? `
                            <label class="flex items-center gap-1.5 cursor-pointer select-none text-[11px] font-bold text-slate-600 hover:text-emerald-700">
                                <input type="checkbox"
                                       id="subjSelectAll_${s.subject_id}"
