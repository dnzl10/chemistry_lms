<!-- ════════════════════════════════════════════════════
     MODAL: INVITE USER
     REQ#2 — No password field. Sends invitation email.
     REQ#3 — Dynamic role-based field sections.
     REQ#4 — LRN oninput validation.
════════════════════════════════════════════════════ -->
<div id="modalInviteUser" class="modal-overlay">
    <div class="modal-box p-0">
        <div class="flex items-center justify-between p-6 border-b border-slate-100 sticky top-0 bg-white z-10 rounded-t-2xl">
            <div>
                <%# REQ#2 — Title reflects invitation-first flow %>
                <h3 class="font-black text-indigo-900 text-lg flex items-center gap-2">
                    <i class="fas fa-paper-plane text-indigo-400"></i> Invite New User
                </h3>
                <p class="text-xs text-slate-400 mt-0.5">An invitation email will be sent. The user sets their own password after confirming.</p>
            </div>
            <button onclick="closeModal('modalInviteUser')" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-rose-100 text-slate-500 hover:text-rose-600 transition flex items-center justify-center"><i class="fas fa-times"></i></button>
        </div>

        <!-- Duplicate warning banner -->
        <div id="invDupBanner" class="dup-banner mx-6 mt-4">
            <p class="font-bold text-amber-800 text-sm flex items-center gap-2"><i class="fas fa-triangle-exclamation"></i> Duplicate Detected</p>
            <p id="invDupMsg" class="text-xs text-amber-700 mt-1"></p>
        </div>

        <div class="p-6 space-y-5">

            <!-- REQ#2 — No-password note -->
            <div class="invite-note">
                <i class="fas fa-lock-open text-indigo-500"></i>
                <span>No password required — the invited user will create their own after confirming via email and linking their Google account.</span>
            </div>

            <!-- REQ#3 — Role picker. onchange calls updateInviteRoleFields() -->
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-2 uppercase tracking-wider">Role *</label>
                <div class="grid grid-cols-3 gap-3">
                    <label class="cursor-pointer">
                        <input type="radio" name="inv_role" value="Student" class="peer sr-only" checked onchange="updateInviteRoleFields()">
                        <div class="peer-checked:ring-2 peer-checked:ring-sky-500 peer-checked:bg-sky-50 border border-slate-200 rounded-xl p-3 text-center transition">
                            <i class="fas fa-user-graduate text-sky-500 block mb-1 text-xl"></i>
                            <span class="text-xs font-bold text-slate-700">Student</span>
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="inv_role" value="Teacher" class="peer sr-only" onchange="updateInviteRoleFields()">
                        <div class="peer-checked:ring-2 peer-checked:ring-emerald-500 peer-checked:bg-emerald-50 border border-slate-200 rounded-xl p-3 text-center transition">
                            <i class="fas fa-chalkboard-user text-emerald-500 block mb-1 text-xl"></i>
                            <span class="text-xs font-bold text-slate-700">Teacher</span>
                        </div>
                    </label>
                    <label class="cursor-pointer">
                        <input type="radio" name="inv_role" value="Admin" class="peer sr-only" onchange="updateInviteRoleFields()">
                        <div class="peer-checked:ring-2 peer-checked:ring-rose-500 peer-checked:bg-rose-50 border border-slate-200 rounded-xl p-3 text-center transition">
                            <i class="fas fa-shield-halved text-rose-500 block mb-1 text-xl"></i>
                            <span class="text-xs font-bold text-slate-700">Admin</span>
                        </div>
                    </label>
                </div>
            </div>

            <!-- Name (always shown) -->
            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">First Name *</label>
                    <input type="text" id="invFirstName" placeholder="Juan" maxlength="100" class="fi text-sm">
                    <p id="errInvFN" class="ferr">Required.</p>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Middle Name</label>
                    <input type="text" id="invMiddleName" placeholder="Santos" maxlength="100" class="fi text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Last Name *</label>
                    <input type="text" id="invLastName" placeholder="Dela Cruz" maxlength="100" class="fi text-sm">
                    <p id="errInvLN" class="ferr">Required.</p>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Suffix</label>
                    <select id="invSuffix" class="fi text-sm">
                        <option value="">None</option>
                        <option value="Jr.">Jr.</option>
                        <option value="Sr.">Sr.</option>
                        <option value="II">II</option>
                        <option value="III">III</option>
                        <option value="IV">IV</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Sex</label>
                    <select id="invSex" class="fi text-sm">
                        <option value="">Prefer not to say</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Birthdate</label>
                    <input type="date" id="invBirthdate" class="fi text-sm">
                </div>
            </div>

            <!-- REQ#2 — Email only, NO password field -->
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Gmail Address *</label>
                <input type="email" id="invEmail" placeholder="juan@gmail.com" maxlength="255" class="fi text-sm"
                       oninput="clearInvDup()" onblur="checkInvEmailDup()">
                <p id="errInvEmail" class="ferr">A valid email address is required.</p>
            </div>

            <!-- REQ#3 — STUDENT-ONLY: shown when Student role selected -->
            <div id="invStudentSection" class="role-section visible">
                <div class="border-t border-slate-100 pt-4">
                    <p class="text-[10px] font-black uppercase tracking-widest text-sky-500 mb-3 flex items-center gap-1.5">
                        <i class="fas fa-user-graduate"></i> Student Information
                    </p>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">LRN Number</label>
                            <%#
                              REQ#4 — LRN validation:
                              oninput="validateLRN(this,'errInvLRN')" — strips non-digits, real-time counter
                              maxlength="12" — cannot type more than 12 chars
                              onblur="checkInvLRNDup()" — checks DB for existing LRN
                            %>
                            <input type="text" id="invLRN" placeholder="12-digit LRN" maxlength="12" class="fi text-sm font-mono"
                                   oninput="validateLRN(this,'errInvLRN')" onblur="checkInvLRNDup()">
                            <p id="errInvLRN" class="ferr">LRN must be exactly 12 digits (numbers only).</p>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Grade Level</label>
                            <select id="invGradeLevel" class="fi text-sm">
                                <option value="Grade 11">Grade 11</option>
                                <option value="Grade 12">Grade 12</option>
                            </select>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3 mt-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">
                                Section / Enrolled Class <span class="text-rose-500">*</span>
                            </label>
                            <select id="invClassSelect" class="fi text-sm font-semibold" onchange="onInviteClassChanged(this)">
                                <option value="">-- Choose Class / Section to Enroll --</option>
                                <% if (locals.classesList && classesList.length > 0) { %>
                                    <% classesList.forEach(c => { 
                                        const actualEnrolled = c.enrolled_count_actual !== undefined ? c.enrolled_count_actual : (c.enrolled_count || 0);
                                        const isFull = (c.max_capacity !== null && c.max_capacity !== undefined && actualEnrolled >= c.max_capacity);
                                    %>
                                        <option value="<%= c.class_id %>"
                                                data-class-id="<%= c.class_id %>"
                                                data-class-name="<%= c.class_name %>"
                                                data-subject-id="<%= c.subject_id %>"
                                                data-subject-name="<%= c.subject_name || 'Chemistry' %>"
                                                data-subject-code="<%= c.subject_code || '' %>"
                                                data-capacity="<%= c.max_capacity !== null ? c.max_capacity : '' %>"
                                                data-enrolled="<%= actualEnrolled %>"
                                                data-start="<%= c.enrollment_start ? new Date(c.enrollment_start).toISOString() : '' %>"
                                                data-end="<%= c.enrollment_end ? new Date(c.enrollment_end).toISOString() : '' %>"
                                                data-sy-id="<%= c.sy_id || '' %>"
                                                data-sy-range="<%= c.sy_range || '' %>"
                                                data-semester="<%= c.semester || 1 %>"
                                                <%= isFull ? 'class="text-rose-500 font-bold"' : '' %>>
                                            <%= c.class_name %> — <%= c.subject_name %> <%= c.subject_code ? `(${c.subject_code})` : '' %> [<%= actualEnrolled %>/<%= c.max_capacity !== null ? c.max_capacity : '∞' %>] <%= isFull ? '(FULL)' : '' %>
                                        </option>
                                    <% }) %>
                                <% } %>
                            </select>
                            <input type="hidden" id="invSection" value="">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Track</label>
                            <input type="text" id="invStrand" value="Academic Track" readonly class="fi text-sm bg-slate-50 text-slate-700 font-semibold cursor-not-allowed">
                        </div>
                    </div>

                    <!-- Live Capacity & Enrollment Window Status Indicator -->
                    <div id="invClassStatusBanner" class="hidden mt-2 p-2.5 rounded-xl text-xs border transition-all"></div>

                    <!-- Auto-detected School Year & Enrolled Course Info -->
                    <div class="grid grid-cols-2 gap-3 mt-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider flex items-center justify-between">
                                <span>School Year</span>
                                <span class="text-[9px] text-emerald-700 font-extrabold bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded-md">
                                    <i class="fas fa-magic"></i> Auto-Detected
                                </span>
                            </label>
                            <input type="text" id="invSchoolYear" 
                                   value="<%= locals.currentSchoolYear ? currentSchoolYear.sy_range : '2026-2027' %>" 
                                   data-sy-id="<%= locals.currentSchoolYear ? currentSchoolYear.sy_id : '1' %>"
                                   readonly class="fi text-sm bg-slate-50 text-slate-800 font-mono font-bold cursor-not-allowed">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Enrolled Course</label>
                            <input type="text" id="invCourseDisplay" placeholder="Auto-filled from class" readonly class="fi text-sm bg-slate-50 text-slate-600 italic">
                        </div>
                    </div>
                    <div class="mt-3">
                        <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Interests</label>
                        <textarea id="invInterests" rows="2" placeholder="Chemistry, Robotics…" maxlength="1000" class="fi text-sm resize-none"></textarea>
                    </div>
                </div>
            </div>

            <!-- REQ#3 — TEACHER-ONLY: hidden until Teacher selected -->
            <div id="invTeacherSection" class="role-section">
                <div class="border-t border-slate-100 pt-4">
                    <p class="text-[10px] font-black uppercase tracking-widest text-emerald-500 mb-3 flex items-center gap-1.5">
                        <i class="fas fa-chalkboard-user"></i> Teacher Information & Teaching Load
                    </p>
                    <div class="grid grid-cols-2 gap-3 mb-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">
                                Faculty ID <span class="text-rose-500">*</span>
                            </label>
                            <input type="text" id="invFacultyId" placeholder="FAC-001" maxlength="50" class="fi text-sm font-mono"
                                   onblur="checkInvFacIdDup()" oninput="clearInvDup(); checkInvFacIdDup()">
                            <p id="errInvFacId" class="ferr">Faculty ID is required and must be unique.</p>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Department</label>
                            <input type="text" id="invDeptTeacher" placeholder="Science Dept." maxlength="100" class="fi text-sm">
                        </div>
                    </div>

                    <!-- Hierarchical Subjects & Sections Assignment Container -->
                    <div id="invTeacherHierarchySection" class="mt-4">
                        <div class="flex items-center justify-between mb-2">
                            <label class="block text-xs font-bold text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                                <i class="fas fa-layer-group text-emerald-600"></i> Assigned Subjects & Classes <span class="text-rose-500">*</span>
                            </label>
                            <span id="teacherTotalSummaryBadge" class="text-[11px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-0.5 rounded-full">
                                0 sections selected
                            </span>
                        </div>

                        <!-- Master Toolbar: Select All across all subjects -->
                        <div class="flex items-center justify-between bg-slate-100/90 border border-slate-200 rounded-t-xl px-3.5 py-2.5 text-xs font-semibold text-slate-700">
                            <label class="flex items-center gap-2 cursor-pointer select-none">
                                <input type="checkbox" id="masterSelectAllTeacherClasses" onchange="toggleMasterAllTeacherClasses(this)"
                                       class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300">
                                <span class="font-bold text-xs text-slate-800">Select All (All Subjects & Classes)</span>
                            </label>
                            <button type="button" onclick="const cb = document.getElementById('masterSelectAllTeacherClasses'); cb.checked = !cb.checked; toggleMasterAllTeacherClasses(cb);"
                                    class="text-[11px] font-bold text-emerald-600 hover:text-emerald-700 hover:underline flex items-center gap-1">
                                <i class="fas fa-check-double text-[10px]"></i> Toggle All
                            </button>
                        </div>

                        <!-- Scrollable Hierarchical Subject Groups Container -->
                        <div id="invTeacherHierarchyList" class="max-h-60 overflow-y-auto border border-t-0 border-slate-200 rounded-b-xl p-2.5 space-y-2.5 bg-slate-50/50">
                            <!-- Populated dynamically via JS: grouped by Subject with accordion / cards -->
                        </div>
                        <p id="errInvTeacherClasses" class="ferr">Please assign at least one class/section to the teacher.</p>

                        <!-- Live Notice banner if any selected class has an existing teacher -->
                        <div id="teacherClassesConflictNotice" class="hidden mt-2.5 p-2.5 rounded-xl text-xs border transition-all"></div>
                    </div>
                </div>
            </div>

            <!-- REQ#3 — ADMIN-ONLY: hidden until Admin selected -->
            <div id="invAdminSection" class="role-section">
                <div class="border-t border-slate-100 pt-4">
                    <p class="text-[10px] font-black uppercase tracking-widest text-rose-500 mb-3 flex items-center gap-1.5">
                        <i class="fas fa-shield-halved"></i> Admin Information
                    </p>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Faculty ID</label>
                            <input type="text" id="invAdminFacId" placeholder="ADM-001" maxlength="50" class="fi text-sm font-mono">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Department</label>
                            <input type="text" id="invDeptAdmin" placeholder="Administration" maxlength="100" class="fi text-sm">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Invite expiry (all roles) -->
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Invitation Expires In</label>
                <select id="invExpiry" class="fi text-sm">
                    <option value="24">24 hours</option>
                    <option value="72">3 days</option>
                    <option value="168" selected>7 days</option>
                    <option value="720">30 days</option>
                    <option value="">Never</option>
                </select>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <button type="button" onclick="closeModal('modalInviteUser')"
