// ─────────────────────────────────
// TOGGLE USER STATUS (ACTIVATE / DEACTIVATE / SUSPEND)
// ─────────────────────────────────
async function confirmToggleStatus(id, name, actionType) {
    let title = "";
    let confirmText = "";
    let confirmBtnColor = "";
    let iconClass = "fas fa-user-check";
    let iconBg = "bg-emerald-100";
    let iconColor = "text-emerald-600";
    
    if (actionType === 'suspend') {
        title = "Suspend User?";
        confirmText = `Are you sure you want to completely suspend <b>${name}</b>? They will not be able to log in.`;
        confirmBtnColor = "bg-rose-600 hover:bg-rose-700";
        iconClass = "fas fa-ban";
        iconBg = "bg-rose-100";
        iconColor = "text-rose-600";
    } else if (actionType === 'deactivate') {
        title = "Deactivate User?";
        confirmText = `Are you sure you want to deactivate <b>${name}</b>?`;
        confirmBtnColor = "bg-amber-500 hover:bg-amber-600";
        iconClass = "fas fa-user-lock";
        iconBg = "bg-amber-100";
        iconColor = "text-amber-600";
    } else {
        title = "Activate User?";
        confirmText = `Are you sure you want to activate/unsuspend <b>${name}</b>?`;
        confirmBtnColor = "bg-emerald-600 hover:bg-emerald-700";
        iconClass = "fas fa-user-check";
        iconBg = "bg-emerald-100";
        iconColor = "text-emerald-600";
    }

    const executeAction = async () => {
        try {
            const res = await fetch(`/admin/users/${id}/toggle-status`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ action: actionType })
            });
            const data = await res.json();
            
            if (data.success) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        title: 'Success!',
                        text: data.message,
                        icon: 'success',
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => refreshAdminContent({ message: 'Updating user status...' }));
                } else {
                    showToast(data.message, 'success');
                    refreshAdminContent({ message: 'Updating user status...' });
                }
            } else {
                if (typeof Swal !== 'undefined') {
                    Swal.fire('Error', data.message || 'Action failed', 'error');
                } else {
                    showToast(data.message || 'Action failed', 'error');
                }
            }
        } catch (err) {
            if (typeof Swal !== 'undefined') {
                Swal.fire('Error', err.message, 'error');
            } else {
                showToast(err.message, 'error');
            }
        }
    };

    if (typeof Swal !== 'undefined') {
        const { isConfirmed } = await Swal.fire({
            title: title,
            html: confirmText,
            icon: actionType.includes('activate') ? 'info' : 'warning',
            showCancelButton: true,
            confirmButtonColor: 'transparent',
            cancelButtonColor: 'transparent',
            customClass: {
                confirmButton: `px-4 py-2 ${confirmBtnColor} text-white font-bold rounded-lg ml-2`,
                cancelButton: 'px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-800 font-bold rounded-lg',
                popup: 'rounded-2xl'
            },
            buttonsStyling: false
        });
        if (isConfirmed) {
            await executeAction();
        }
    } else {
        showConfirm({
            icon: iconClass, iconBg: iconBg, iconColor: iconColor,
            title: title,
            desc: confirmText.replace(/<[^>]+>/g, ''),
            btnLabel: actionType === 'suspend' ? 'Suspend User' : (actionType === 'deactivate' ? 'Deactivate User' : 'Activate User'),
            btnColor: actionType === 'suspend' ? 'bg-rose-600' : (actionType === 'deactivate' ? 'bg-amber-500' : 'bg-emerald-600'),
            onConfirm: async () => {
                closeModal('modalConfirm');
                await executeAction();
            }
        });
    }
}



