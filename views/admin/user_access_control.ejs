    </div>
</div>

<style>
    .notif-tab.active { border-bottom-color: #06b6d4 !important; color: #0891b2 !important; }
    .notif-item { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 10px 12px; display: flex; gap: 10px; align-items: flex-start; transition: border-color 0.15s, box-shadow 0.15s; }
    .notif-item:hover { border-color: #06b6d4; box-shadow: 0 4px 12px rgba(6,182,212,0.08); }
    .notif-icon { width: 32px; height: 32px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 13px; }
    .notif-title { font-size: 12px; font-weight: 700; color: #1e293b; line-height: 1.35; }
    .notif-sub { font-size: 10.5px; color: #64748b; margin-top: 1px; }
    .notif-time { font-size: 10px; color: #94a3b8; white-space: nowrap; margin-left: auto; padding-left: 6px; flex-shrink: 0; }
    .notif-section-label { font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: .07em; color: #94a3b8; padding: 4px 0 6px; }
    .notif-link { font-size: 10.5px; color: #06b6d4; font-weight: 700; text-decoration: none; cursor: pointer; }
    .notif-link:hover { color: #0891b2; }
</style>

<script>
(function() {
    let _notifData   = null;
    let _activeTab   = 'all';
    let _refreshTimer = null;

    function timeAgo(dateStr) {
        if (!dateStr) return '';
        const diff = (Date.now() - new Date(dateStr)) / 1000;
        if (diff < 60)   return 'just now';
        if (diff < 3600) return Math.floor(diff/60) + 'm ago';
        if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
        return Math.floor(diff/86400) + 'd ago';
    }

    function fmtDate(dateStr) {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' });
    }

    window.toggleNotifPanel = function() {
        const panel    = document.getElementById('notifPanel');
        const backdrop = document.getElementById('notifBackdrop');
        const isOpen   = !panel.classList.contains('translate-x-full');
        if (isOpen) { closeNotifPanel(); return; }
        panel.classList.remove('translate-x-full');
        backdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        loadNotifications();
        _refreshTimer = setInterval(loadNotifications, 60000);
    };

    window.closeNotifPanel = function() {
        document.getElementById('notifPanel').classList.add('translate-x-full');
        document.getElementById('notifBackdrop').classList.add('hidden');
        document.body.style.overflow = '';
        clearInterval(_refreshTimer);
    };

    window.loadNotifications = async function() {
        document.getElementById('notifSkeleton').classList.remove('hidden');
        document.getElementById('notifContent').classList.add('hidden');
        try {
            const res  = await fetch('/admin/notifications');
            const data = await res.json();
            if (!data.success) throw new Error(data.message);
            _notifData = data;
            updateBell(data.total);
            renderTab(_activeTab);
        } catch(e) {
            document.getElementById('notifContent').innerHTML =
                '<div class="py-10 text-center text-slate-400 text-xs">Failed to load notifications.</div>';
            document.getElementById('notifContent').classList.remove('hidden');
            document.getElementById('notifSkeleton').classList.add('hidden');
        }
    };

    function updateBell(count) {
        const dot   = document.getElementById('notifDot');
        const badge = document.getElementById('notifCount');
        if (count > 0) {
            dot.classList.remove('hidden');
            badge.textContent = count > 9 ? '9+' : count;
            badge.classList.remove('hidden');
        } else {
            dot.classList.add('hidden');
            badge.classList.add('hidden');
        }
        document.getElementById('notifSubtitle').textContent =
            count > 0 ? count + ' item' + (count !== 1 ? 's' : '') + ' need attention' : 'All clear';
    }

    function renderTab(tab) {
        _activeTab = tab;
        const d = _notifData;
        if (!d) return;

        let html = '';

        // ── ALL tab ──
        if (tab === 'all' || tab === 'alerts') {
            const alertItems = [
                ...d.expiredInvites.map(i => ({
                    icon: 'fas fa-envelope-circle-check', iconBg: 'bg-rose-50', iconColor: 'text-rose-500',
                    title: 'Expired Invitation',
                    sub: i.email + ' · ' + (i.role || 'Unknown role'),
                    time: fmtDate(i.expires_at),
                    link: '/admin/user_access_control', linkLabel: 'View UAC'
                })),
                ...d.flaggedStudents.map(s => ({
                    icon: 'fas fa-flag', iconBg: 'bg-amber-50', iconColor: 'text-amber-500',
                    title: 'Flagged Student',
                    sub: s.full_name + (s.assessment_name ? ' · ' + s.assessment_name : ''),
                    time: '',
                    link: '/admin/user_access_control', linkLabel: 'View Student'
                })),
                ...d.lockedPastDue.map(a => ({
                    icon: 'fas fa-lock', iconBg: 'bg-orange-50', iconColor: 'text-orange-500',
                    title: 'Assessment Past Due & Locked',
                    sub: a.assessment_name + ' · ' + (a.subject_name || ''),
                    time: fmtDate(a.due_date),
                    link: '/admin/gaming_question_bank', linkLabel: 'Manage'
                })),
                ...d.overdueDeadlines.map(e => ({
                    icon: 'fas fa-calendar-xmark', iconBg: 'bg-red-50', iconColor: 'text-red-500',
                    title: 'Overdue Deadline',
                    sub: e.event_title + (e.subject_name ? ' · ' + e.subject_name : ''),
                    time: fmtDate(e.event_date),
                    link: '/admin/academic_management', linkLabel: 'View'
                })),
                ...d.pendingQuestions.map(q => ({
                    icon: 'fas fa-robot', iconBg: 'bg-indigo-50', iconColor: 'text-indigo-500',
                    title: 'AI Question Awaiting Approval',
                    sub: q.question_text.substring(0, 55) + (q.question_text.length > 55 ? '…' : ''),
                    time: timeAgo(q.created_at),
                    link: '/admin/gaming_question_bank', linkLabel: 'Review'
                })),
            ];

            if (tab === 'alerts' || tab === 'all') {
                if (alertItems.length === 0) {
                    if (tab === 'alerts') html += emptyState('fa-shield-halved', 'No alerts', 'Everything looks good!');
                } else {
                    if (tab === 'all') html += '<div class="notif-section-label"><i class="fas fa-triangle-exclamation mr-1 text-rose-400"></i>Alerts Requiring Action</div>';
                    alertItems.forEach(item => { html += notifItem(item); });
                }
            }
        }

        // ── ACTIVITY tab (pending & new users) ──
        if (tab === 'activity' || tab === 'all') {
            const actItems = [
                ...d.pendingInvites.map(i => ({
                    icon: 'fas fa-paper-plane', iconBg: 'bg-cyan-50', iconColor: 'text-cyan-500',
                    title: 'Pending Invitation',
                    sub: i.email + ' · ' + (i.role || ''),
                    time: timeAgo(i.created_at),
                    link: '/admin/user_access_control', linkLabel: 'View'
                })),
                ...d.newUsers.map(u => ({
                    icon: 'fas fa-user-plus', iconBg: 'bg-emerald-50', iconColor: 'text-emerald-500',
                    title: 'New ' + u.role + ' Registered',
                    sub: u.full_name,
                    time: timeAgo(u.created_at),
                    link: '/admin/user_access_control', linkLabel: 'View Profile'
                })),
            ];

            if (tab === 'activity') {
                if (actItems.length === 0) html += emptyState('fa-clock-rotate-left', 'No recent activity', 'No new users or pending invites.');
                else actItems.forEach(item => { html += notifItem(item); });
            } else if (tab === 'all' && actItems.length > 0) {
                html += '<div class="notif-section-label mt-2"><i class="fas fa-bolt mr-1 text-cyan-400"></i>Recent Activity</div>';
                actItems.forEach(item => { html += notifItem(item); });
            }
        }

        // ── LIVE tab (active sessions) ──
        if (tab === 'live' || tab === 'all') {
            if (tab === 'live') {
                if (d.activeSessions.length === 0) {
                    html += emptyState('fa-gamepad', 'No live sessions', 'No students are playing right now.');
                } else {
                    d.activeSessions.forEach(s => {
                        html += notifItem({
                            icon: 'fas fa-gamepad', iconBg: 'bg-violet-50', iconColor: 'text-violet-500',
                            title: s.student_name + ' is playing',
                            sub: s.assessment_name + ' · ' + s.player_mode,
                            time: timeAgo(s.start_time),
                            link: null
                        });
                    });
                }
            } else if (tab === 'all' && d.activeSessions.length > 0) {
                html += '<div class="notif-section-label mt-2"><i class="fas fa-circle text-green-400 mr-1"></i>Live Sessions (' + d.activeSessions.length + ')</div>';
                d.activeSessions.slice(0, 3).forEach(s => {
                    html += notifItem({
                        icon: 'fas fa-gamepad', iconBg: 'bg-violet-50', iconColor: 'text-violet-500',
                        title: s.student_name + ' is playing',
                        sub: s.assessment_name + ' · ' + s.player_mode,
                        time: timeAgo(s.start_time),
                        link: null
                    });
                });
            }
        }

        if (tab === 'all' && html === '') {
            html = emptyState('fa-bell-slash', 'All clear!', 'No alerts or pending items.');
        }

        document.getElementById('notifContent').innerHTML = html;
        document.getElementById('notifContent').classList.remove('hidden');
        document.getElementById('notifSkeleton').classList.add('hidden');
    }

    function notifItem(item) {
        return '<div class="notif-item">' +
            '<div class="notif-icon ' + item.iconBg + ' ' + item.iconColor + '">' +
                '<i class="' + item.icon + '"></i>' +
            '</div>' +
            '<div class="flex-1 min-w-0">' +
                '<p class="notif-title">' + item.title + '</p>' +
                '<p class="notif-sub truncate">' + item.sub + '</p>' +
                (item.link ? '<a href="' + item.link + '" class="notif-link">' + item.linkLabel + ' →</a>' : '') +
            '</div>' +
            (item.time ? '<span class="notif-time">' + item.time + '</span>' : '') +
        '</div>';
    }

    function emptyState(icon, title, sub) {
        return '<div class="py-10 text-center">' +
            '<i class="fas ' + icon + ' text-3xl text-slate-200 mb-3 block"></i>' +
            '<p class="text-sm font-bold text-slate-400">' + title + '</p>' +
            '<p class="text-xs text-slate-300 mt-1">' + sub + '</p>' +
        '</div>';
    }

    // Tab switching
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.notif-tab').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.notif-tab').forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                renderTab(btn.dataset.tab);
            });
        });

        // Auto-poll bell count every 2 minutes even when panel is closed
        setInterval(async function() {
            try {
                const res  = await fetch('/admin/notifications');
                const data = await res.json();
                if (data.success) updateBell(data.total);
            } catch(_) {}
        }, 120000);
    });
})();


// ─────────────────────────────────
// TEACHER BULK IMPORT ENGINE
// ─────────────────────────────────
var _allClasses = window._allClasses || [];
var _allSubjects = window._allSubjects || [];
var _existingFacultyIdsMap = window._existingFacultyIdsMap || {};
var _pendingFacultyIdsMap = window._pendingFacultyIdsMap || {};
var _parsedTeacherRows = window._parsedTeacherRows || [];
var _batchDefaultTeacherClassIds = window._batchDefaultTeacherClassIds || [];
var _activeTeacherEditingRow = typeof window._activeTeacherEditingRow !== 'undefined' ? window._activeTeacherEditingRow : -1;

function switchBulkRole(role) {
    const studentPane = document.getElementById('bulkStudentPane');
    const teacherPane = document.getElementById('bulkTeacherPane');
    const btnStudent  = document.getElementById('btnBulkRoleStudent');
    const btnTeacher  = document.getElementById('btnBulkRoleTeacher');

    if (role === 'student') {
        studentPane.classList.remove('hidden');
        teacherPane.classList.add('hidden');
        btnStudent.className = 'flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs transition bg-gradient-to-r from-sky-500 to-indigo-600 text-white shadow-sm';
        btnTeacher.className = 'flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs text-slate-600 hover:text-emerald-700 hover:bg-emerald-50/60 transition';
    } else {
        studentPane.classList.add('hidden');
        teacherPane.classList.remove('hidden');
        btnTeacher.className = 'flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs transition bg-gradient-to-r from-emerald-600 to-teal-600 text-white shadow-sm';
        btnStudent.className = 'flex items-center gap-2 px-5 py-2.5 rounded-xl font-bold text-xs text-slate-600 hover:text-sky-700 hover:bg-sky-50/60 transition';
    }
}

function downloadTeacherTemplate() {
    window.location.href = '/admin/uac/bulk-template?type=teacher';
}

function parseAndPreviewTeacherExcel(file) {
    const reader = new FileReader();
    reader.onload = function(e) {
        try {
            const data = new Uint8Array(e.target.result);
            const workbook = XLSX.read(data, { type: 'array' });
            const firstSheet = workbook.Sheets[workbook.SheetNames[0]];
            const jsonRows = XLSX.utils.sheet_to_json(firstSheet, { defval: '' });

            if (!jsonRows || jsonRows.length === 0) {
                showToast('The uploaded teacher spreadsheet contains no rows.', 'error');
                return;
            }

            const defDept = (document.getElementById('bulkTeacherBatchDept').value || '').trim() || 'Science Department';

            _parsedTeacherRows = jsonRows.map((r, i) => {
                const row = {};
                for (const [k, v] of Object.entries(r)) {
                    const norm = String(k).replace('*', '').replace(/\(.*\)/, '').trim().toLowerCase().replace(/[\s-]+/g, '_');
                    row[norm] = String(v !== undefined && v !== null ? v : '').trim();
                }

                const rawFid = (row.faculty_id || row.facultyid || row.id || '').trim();

                // Parse assigned classes from text if provided
                const classIds = [];
                const rawClassesText = String(row.assigned_classes || row.classes || row.sections || row.subject || '').trim();
                const allClassesList = (typeof _allClasses !== 'undefined' && _allClasses) ? _allClasses : (window._allClasses || []);
                if (rawClassesText && allClassesList.length > 0) {
                    const subjectBlocks = rawClassesText.split(';').map(b => b.trim()).filter(Boolean);
                    subjectBlocks.forEach(block => {
                        if (block.includes(':')) {
                            const parts = block.split(':');
                            const subjPart = parts[0].trim().toLowerCase();
                            const secParts = parts[1].split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
                            secParts.forEach(secName => {
                                const match = allClassesList.find(c => 
                                    (c.subject_name.toLowerCase().includes(subjPart) || (c.subject_code && c.subject_code.toLowerCase().includes(subjPart))) &&
                                    c.class_name.toLowerCase().trim() === secName
                                ) || allClassesList.find(c => c.class_name.toLowerCase().trim() === secName);
                                if (match && !classIds.includes(match.class_id)) {
                                    classIds.push(match.class_id);
                                }
                            });
                        } else {
                            const secTokens = block.split(',').map(s => s.trim().toLowerCase()).filter(Boolean);
                            secTokens.forEach(secName => {
                                const numId = parseInt(secName, 10);
                                if (!isNaN(numId) && allClassesList.some(c => c.class_id === numId)) {
                                    if (!classIds.includes(numId)) classIds.push(numId);
                                    return;
                                }
                                const match = allClassesList.find(c => c.class_name.toLowerCase().trim() === secName);
                                if (match && !classIds.includes(match.class_id)) {
                                    classIds.push(match.class_id);
                                }
                            });
                        }
                    });
                }

                // If no class IDs parsed from Excel, apply batch default if configured
                if (classIds.length === 0 && _batchDefaultTeacherClassIds.length > 0) {
                    classIds.push(..._batchDefaultTeacherClassIds);
                }

                return {
                    first_name  : row.first_name || '',
                    middle_name : row.middle_name || '',
                    last_name   : row.last_name || '',
                    suffix      : row.suffix || '',
                    email       : (row.email || '').toLowerCase().trim(),
                    faculty_id  : rawFid,
                    department  : row.department || defDept,
                    class_ids   : classIds,
                    sex         : row.sex || '',
                    birthdate   : row.birthdate || '',
                    mobile_number: row.mobile_number || '',
                    city_town   : row.city_town || ''
                };
            });

            renderTeacherPreviewTable();
            document.getElementById('teacherPreviewContainer').classList.remove('hidden');
            document.getElementById('submitTeacherBulk').disabled = false;

        } catch (err) {
            console.error('[Parse Teacher Excel Error]', err);
            showToast('Failed to parse Excel file: ' + err.message, 'error');
        }
    };
    reader.readAsArrayBuffer(file);
}

function renderTeacherPreviewTable() {
    const tbody = document.getElementById('tblTeacherPreviewBody');
    if (!tbody) return;

    let validCount = 0;
    let conflictCount = 0;
    let fidErrorCount = 0;

    // Track duplicate faculty IDs within sheet
    const fidTracker = {};
    _parsedTeacherRows.forEach(r => {
        if (r.faculty_id) {
            fidTracker[r.faculty_id] = (fidTracker[r.faculty_id] || 0) + 1;
        }
    });

    let rowsHtml = '';
    _parsedTeacherRows.forEach((r, idx) => {
        const rowNum = idx + 1;
        const fid = String(r.faculty_id || '').trim();
        const email = String(r.email || '').trim();

        // 1. Faculty ID validation
        const existingFids = (typeof _existingFacultyIdsMap !== 'undefined' && _existingFacultyIdsMap) ? _existingFacultyIdsMap : (window._existingFacultyIdsMap || {});
        const pendingFids  = (typeof _pendingFacultyIdsMap !== 'undefined' && _pendingFacultyIdsMap) ? _pendingFacultyIdsMap : (window._pendingFacultyIdsMap || {});

        let fidStatus = { ok: true, msg: 'Valid', class: 'text-emerald-700 font-mono font-bold' };
        if (!fid) {
            fidStatus = { ok: false, msg: 'Missing Faculty ID', class: 'text-rose-600 font-bold' };
            fidErrorCount++;
        } else if (fidTracker[fid] > 1) {
            fidStatus = { ok: false, msg: 'Duplicate in Sheet', class: 'text-rose-600 font-mono font-bold' };
            fidErrorCount++;
        } else if (existingFids[fid]) {
            fidStatus = { ok: false, msg: `Used by ${existingFids[fid]}`, class: 'text-rose-600 font-mono font-bold' };
            fidErrorCount++;
        } else if (pendingFids[fid]) {
            fidStatus = { ok: false, msg: `Reserved for ${pendingFids[fid]}`, class: 'text-amber-700 font-mono font-bold' };
            fidErrorCount++;
        }

        // 2. Email format validation
        const emailOk = /^[^s@]+@[^s@]+.[^s@]+$/.test(email);

        // 3. Assigned classes chips & conflict check
        const assignedClasses = _allClasses.filter(c => r.class_ids && r.class_ids.includes(c.class_id));
        let loadChipsHtml = '';
        let rowHasConflict = false;
        let conflictDetails = [];

        if (assignedClasses.length === 0) {
            loadChipsHtml = `<span class="text-[11px] text-slate-400 italic">No classes assigned</span>`;
        } else {
            // Group by subject
            const bySubj = {};
            assignedClasses.forEach(c => {
                const sName = c.subject_name || 'General';
                if (!bySubj[sName]) bySubj[sName] = [];
                bySubj[sName].push(c);
            });

            loadChipsHtml = Object.entries(bySubj).map(([sName, clsList]) => {
                const secBadges = clsList.map(c => {
                    const hasTeacher = !!(c.teacher_id && c.teacher_name && c.teacher_name.trim());
                    if (hasTeacher) {
                        rowHasConflict = true;
                        conflictDetails.push(`${c.subject_name || sName} - ${c.class_name} (Current: ${c.teacher_name})`);
                    }
                    return `<span class="inline-block px-1.5 py-0.5 rounded text-[10px] font-bold ${hasTeacher ? 'bg-amber-100 text-amber-800 border border-amber-300' : 'bg-emerald-50 text-emerald-800 border border-emerald-200'}">${c.class_name}</span>`;
                }).join(' ');
                return `<div class="mb-1"><span class="font-extrabold text-[10px] text-slate-500 uppercase">${sName}:</span> ${secBadges}</div>`;
            }).join('');
        }

        // Conflict status display
        let conflictBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full"><i class="fas fa-check-circle"></i> Clear</span>`;
        if (assignedClasses.length === 0) {
            conflictBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-rose-600 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-full"><i class="fas fa-circle-exclamation"></i> No Load</span>`;
        } else if (rowHasConflict) {
            conflictCount++;
            conflictBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-amber-800 bg-amber-50 border border-amber-300 px-2 py-0.5 rounded-full" title="${conflictDetails.join(', ')}"><i class="fas fa-triangle-exclamation text-amber-600"></i> ${conflictDetails.length} Replaced</span>`;
        }

        // Overall row status
        const isRowValid = r.first_name && r.last_name && emailOk && fidStatus.ok && assignedClasses.length > 0;
        if (isRowValid) validCount++;

        let statusBadge = '';
        if (!isRowValid) {
            statusBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-rose-700 bg-rose-50 border border-rose-200 px-2.5 py-1 rounded-full"><i class="fas fa-ban"></i> Invalid</span>`;
        } else if (rowHasConflict) {
            statusBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-amber-800 bg-amber-50 border border-amber-300 px-2.5 py-1 rounded-full"><i class="fas fa-triangle-exclamation"></i> Ready (Conflict)</span>`;
        } else {
            statusBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-2.5 py-1 rounded-full"><i class="fas fa-check-circle"></i> Ready</span>`;
        }

        rowsHtml += `
            <tr class="hover:bg-slate-50 transition">
                <td class="p-3 text-center font-bold text-slate-400 text-xs">${rowNum}</td>
                <td class="p-3">
                    <p class="font-bold text-slate-800 text-xs">${r.first_name} ${r.last_name}</p>
                    ${r.middle_name ? `<p class="text-[10px] text-slate-400">Mid: ${r.middle_name}</p>` : ''}
                </td>
                <td class="p-3">
                    <p class="text-xs font-mono ${emailOk ? 'text-slate-700' : 'text-rose-600 font-bold'}">${email || '—'}</p>
                </td>
                <td class="p-3">
                    <span class="${fidStatus.class}">${fid || '—'}</span>
                    <p class="text-[10px] ${fidStatus.ok ? 'text-slate-400' : 'text-rose-600 font-semibold'}">${fidStatus.msg}</p>
                </td>
                <td class="p-3">
                    <input type="text" value="${r.department || 'Science Department'}" onchange="_parsedTeacherRows[${idx}].department = this.value"
                           class="w-full text-[11px] p-1 border border-slate-200 rounded font-semibold text-slate-700 bg-slate-50 focus:bg-white">
                </td>
                <td class="p-3">
                    <div class="flex items-center justify-between gap-2">
                        <div class="flex-1">${loadChipsHtml}</div>
                        <button type="button" onclick="openTeacherRowLoadModal(${idx})"
                                class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-emerald-50 text-emerald-700 hover:bg-emerald-100 border border-emerald-200 transition shrink-0">
                            <i class="fas fa-pen-to-square"></i> Edit
                        </button>
                    </div>
                </td>
                <td class="p-3">${conflictBadge}</td>
                <td class="p-3 text-center">${statusBadge}</td>
            </tr>
        `;
    });

    tbody.innerHTML = rowsHtml;

    // Update metrics bar
    const metricsBar = document.getElementById('teacherPreviewMetricsBar');
    if (metricsBar) {
        metricsBar.innerHTML = `
            <span class="text-[11px] font-extrabold px-2.5 py-1 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                Total: ${_parsedTeacherRows.length}
            </span>
            <span class="text-[11px] font-extrabold px-2.5 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">
                Valid: ${validCount}
            </span>
            ${conflictCount > 0 ? `
                <span class="text-[11px] font-extrabold px-2.5 py-1 rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                    Conflicts: ${conflictCount}
                </span>` : ''}
            ${fidErrorCount > 0 ? `
                <span class="text-[11px] font-extrabold px-2.5 py-1 rounded-full bg-rose-50 text-rose-700 border border-rose-200">
                    Faculty ID Issues: ${fidErrorCount}
                </span>` : ''}
        `;
    }

    const summaryText = document.getElementById('teacherPreviewSummaryText');
    if (summaryText) {
        summaryText.textContent = `Showing ${_parsedTeacherRows.length} teacher row(s) · ${validCount} ready to dispatch`;
    }
}

// ─────────────────────────────────
// ROW-LEVEL & BATCH DEFAULT TEACHING LOAD MODAL
// ─────────────────────────────────
function openTeacherRowLoadModal(rowIdx) {
    _activeTeacherEditingRow = rowIdx;
    const titleEl = document.getElementById('modalTeacherRowLoadTitle');
    const subtitleEl = document.getElementById('modalTeacherRowLoadSubtitle');

    let currentSelectedIds = [];
    if (rowIdx === -1) {
        // Batch default
        titleEl.textContent = 'Configure Batch Default Teaching Load';
        subtitleEl.textContent = 'Select default subjects & sections to apply across all imported teachers';
        currentSelectedIds = [..._batchDefaultTeacherClassIds];
    } else {
        const teacher = _parsedTeacherRows[rowIdx];
        titleEl.textContent = `Teaching Load: ${teacher.first_name} ${teacher.last_name}`;
        subtitleEl.textContent = `Faculty ID: ${teacher.faculty_id || 'Not set'} · ${teacher.email}`;
        currentSelectedIds = Array.isArray(teacher.class_ids) ? [...teacher.class_ids] : [];
    }

    renderModalRowHierarchy(currentSelectedIds);
    openModal('modalTeacherRowLoad');
}

function renderModalRowHierarchy(selectedIds) {
    const listContainer = document.getElementById('modalTeacherRowHierarchyList');
    if (!listContainer) return;

    if (!_allSubjects || _allSubjects.length === 0) {
        listContainer.innerHTML = `<div class="py-4 text-center text-xs text-slate-400">No subjects found.</div>`;
        return;
    }

    let html = '';
    _allSubjects.forEach(s => {
        const subjectClasses = _allClasses.filter(c => String(c.subject_id) === String(s.subject_id));
        const totalInSubj = subjectClasses.length;

        let classesHtml = '';
        if (totalInSubj === 0) {
            classesHtml = `<div class="py-2 text-center text-[11px] text-slate-400 italic">No classes in this subject.</div>`;
        } else {
            subjectClasses.forEach(c => {
                const isChecked = selectedIds.includes(c.class_id);
                const hasTeacher = !!(c.teacher_id && c.teacher_name && c.teacher_name.trim());
                const teacherBadge = hasTeacher
                    ? `<span class="inline-flex items-center gap-1 text-[10px] font-semibold text-amber-700 bg-amber-50 border border-amber-200 px-1.5 py-0.5 rounded">Current: ${c.teacher_name.trim()}</span>`
                    : `<span class="inline-flex items-center gap-1 text-[10px] font-semibold text-slate-500 bg-slate-100 border border-slate-200 px-1.5 py-0.5 rounded">No Teacher</span>`;

                classesHtml += `
                    <label class="flex items-center justify-between p-2 rounded-lg hover:bg-slate-50 cursor-pointer transition select-none group border border-transparent hover:border-slate-200">
                        <div class="flex items-center gap-2.5">
                            <input type="checkbox"
                                   value="${c.class_id}"
                                   data-subject-id="${s.subject_id}"
                                   ${isChecked ? 'checked' : ''}
                                   onchange="updateModalRowHierarchySummary()"
                                   class="modal-row-cb modal-row-subj-${s.subject_id} w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300">
                            <div>
                                <span class="text-xs font-bold text-slate-800 group-hover:text-emerald-700 transition">${c.class_name}</span>
                                <span class="text-[11px] text-slate-400 ml-1">(${c.enrolled_count || 0}/${c.max_capacity !== null ? c.max_capacity : '∞'})</span>
                            </div>
                        </div>
                        <div>${teacherBadge}</div>
                    </label>
                `;
            });
        }

        html += `
            <div class="bg-white border border-slate-200 rounded-xl overflow-hidden shadow-xs">
                <div class="flex items-center justify-between px-3 py-2 bg-slate-50 border-b border-slate-100">
                    <div class="flex items-center gap-2">
                        <span class="w-5 h-5 rounded bg-emerald-100 text-emerald-700 flex items-center justify-center text-[10px] font-bold">
                            <i class="fas fa-book"></i>
                        </span>
                        <span class="text-xs font-bold text-slate-800">${s.subject_name}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <span id="modalRowSubjBadge_${s.subject_id}" class="text-[10px] font-bold text-slate-500 bg-slate-100 border border-slate-200 px-2 py-0.5 rounded-full">
                            0 / ${totalInSubj} selected
                        </span>
                        ${totalInSubj > 0 ? `
                            <label class="flex items-center gap-1 cursor-pointer select-none text-[11px] font-bold text-slate-600 hover:text-emerald-700">
                                <input type="checkbox" id="modalRowSubjSelect_${s.subject_id}" onchange="toggleModalRowSubjectClasses(${s.subject_id}, this)"
                                       class="w-3.5 h-3.5 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300">
                                <span>Select All</span>
                            </label>
                        ` : ''}
                    </div>
                </div>
                <div class="p-2 space-y-1 divide-y divide-slate-50">
                    ${classesHtml}
                </div>
            </div>
        `;
    });

    listContainer.innerHTML = html;
    updateModalRowHierarchySummary();
}

function toggleModalRowSubjectClasses(subjId, selectAllCb) {
    const checkboxes = document.querySelectorAll(`.modal-row-subj-${subjId}`);
    checkboxes.forEach(cb => cb.checked = selectAllCb.checked);
    updateModalRowHierarchySummary();
}

function toggleModalRowMasterAll(masterCb) {
    const checkboxes = document.querySelectorAll('.modal-row-cb');
    checkboxes.forEach(cb => cb.checked = masterCb.checked);
    updateModalRowHierarchySummary();
}

function updateModalRowHierarchySummary() {
    const allCbs = Array.from(document.querySelectorAll('.modal-row-cb'));
    const selected = allCbs.filter(cb => cb.checked);
    const masterCb = document.getElementById('modalRowMasterSelectAll');
    const badge = document.getElementById('modalTeacherRowBadge');

    if (badge) {
        badge.textContent = `${selected.length} section${selected.length === 1 ? '' : 's'} selected`;
    }

    if (masterCb && allCbs.length > 0) {
        masterCb.checked = (selected.length === allCbs.length);
        masterCb.indeterminate = (selected.length > 0 && selected.length < allCbs.length);
    }

    if (_allSubjects && _allSubjects.length > 0) {
        _allSubjects.forEach(s => {
            const subjCbs = Array.from(document.querySelectorAll(`.modal-row-subj-${s.subject_id}`));
            const subjSel = subjCbs.filter(cb => cb.checked);
            const subjMaster = document.getElementById(`modalRowSubjSelect_${s.subject_id}`);
            const subjBadge = document.getElementById(`modalRowSubjBadge_${s.subject_id}`);

            if (subjBadge) {
                subjBadge.textContent = `${subjSel.length} / ${subjCbs.length} selected`;
            }
            if (subjMaster && subjCbs.length > 0) {
                subjMaster.checked = (subjSel.length === subjCbs.length);
                subjMaster.indeterminate = (subjSel.length > 0 && subjSel.length < subjCbs.length);
            }
        });
    }
}

function saveTeacherRowLoad() {
    const selectedCbs = Array.from(document.querySelectorAll('.modal-row-cb:checked'));
    const selectedClassIds = selectedCbs.map(cb => parseInt(cb.value, 10));

    if (_activeTeacherEditingRow === -1) {
        // Saving batch default
        _batchDefaultTeacherClassIds = selectedClassIds;
        const display = document.getElementById('bulkTeacherBatchLoadDisplay');
        if (display) {
            display.textContent = selectedClassIds.length > 0
                ? `${selectedClassIds.length} default class${selectedClassIds.length > 1 ? 'es' : ''} configured`
                : 'None selected (Click to set)';
        }
        showToast('Default teaching load updated!', 'info');
    } else if (_activeTeacherEditingRow >= 0 && _parsedTeacherRows[_activeTeacherEditingRow]) {
        _parsedTeacherRows[_activeTeacherEditingRow].class_ids = selectedClassIds;
        renderTeacherPreviewTable();
        showToast('Teacher load updated!', 'success');
    }

    closeModal('modalTeacherRowLoad');
}

function applyTeacherBatchLoadToAll() {
    if (_batchDefaultTeacherClassIds.length === 0) {
        showToast('Please configure a default teaching load first.', 'warning');
        openTeacherRowLoadModal(-1);
        return;
    }

    const defDept = (document.getElementById('bulkTeacherBatchDept').value || '').trim();

    _parsedTeacherRows.forEach(r => {
        r.class_ids = [..._batchDefaultTeacherClassIds];
        if (defDept) r.department = defDept;
    });

    renderTeacherPreviewTable();
    showToast(`Applied teaching load to all ${_parsedTeacherRows.length} teacher(s)!`, 'success');
}

</script>

