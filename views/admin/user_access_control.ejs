                </div>
            </div>

            <!-- Name -->
            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">First Name *</label>
                    <input type="text" name="first_name" id="editFirstName" required maxlength="100" class="fi text-sm">
                    <p id="errEditFN" class="ferr">Required.</p>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Middle Name</label>
                    <input type="text" name="middle_name" id="editMiddleName" maxlength="100" class="fi text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Last Name *</label>
                    <input type="text" name="last_name" id="editLastName" required maxlength="100" class="fi text-sm">
                    <p id="errEditLN" class="ferr">Required.</p>
                </div>
            </div>

            <!-- Phonetics + suffix -->
            <div class="grid grid-cols-4 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Phonetic First</label>
                    <input type="text" name="first_name_phonetic" id="editPhoneticFirst" maxlength="100" class="fi text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Phonetic Middle</label>
                    <input type="text" name="middle_name_phonetic" id="editPhoneticMiddle" maxlength="100" class="fi text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Phonetic Last</label>
                    <input type="text" name="last_name_phonetic" id="editPhoneticLast" maxlength="100" class="fi text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Suffix</label>
                    <select name="suffix" id="editSuffix" class="fi text-sm">
                        <option value="">None</option>
                        <option value="Jr.">Jr.</option>
                        <option value="Sr.">Sr.</option>
                        <option value="II">II</option>
                        <option value="III">III</option>
                        <option value="IV">IV</option>
                    </select>
                </div>
            </div>

            <div class="grid grid-cols-3 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Alternative Name</label>
                    <input type="text" name="alternative_name" id="editAltName" maxlength="100" class="fi text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Sex</label>
                    <select name="sex" id="editSex" class="fi text-sm">
                        <option value="">Prefer not to say</option>
                        <option value="Male">Male</option>
                        <option value="Female">Female</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Birthdate</label>
                    <input type="date" name="birthdate" id="editBirthdate" class="fi text-sm">
                </div>
            </div>

            <!-- Email & mobile -->
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Email *</label>
                    <input type="email" name="email" id="editEmail" required maxlength="255" class="fi text-sm">
                    <p id="errEditEmail" class="ferr">Valid email required.</p>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Mobile Number</label>
                    <input type="text" name="mobile_number" id="editMobile" maxlength="20" class="fi text-sm">
                </div>
            </div>

            <!-- REQ#3 — STUDENT fields in edit modal (shown/hidden by JS) -->
            <div id="editStudentSection">
                <div class="border-t border-slate-100 pt-4">
                    <p class="text-[10px] font-black uppercase tracking-widest text-sky-500 mb-3 flex items-center gap-1.5">
                        <i class="fas fa-user-graduate"></i> Student Information
                    </p>
                    <div class="grid grid-cols-3 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">LRN Number</label>
                            <%# REQ#4 — Same LRN validation in edit modal %>
                            <input type="text" name="lrn_number" id="editLRN" maxlength="12" class="fi text-sm font-mono"
                                   oninput="validateLRN(this,'errEditLRN')">
                            <p id="errEditLRN" class="ferr">LRN must be exactly 12 digits (numbers only).</p>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Grade Level</label>
                            <select name="grade_level" id="editGradeLevel" class="fi text-sm">
                                <option value="Grade 11">Grade 11</option>
                                <option value="Grade 12">Grade 12</option>
                                <option value="N/A">N/A</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Section</label>
                            <input type="text" name="section" id="editSection" maxlength="50" class="fi text-sm">
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-3 mt-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Strand</label>
                            <input type="text" name="strand" id="editStrand" maxlength="100" class="fi text-sm">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Interests</label>
                            <input type="text" name="interests" id="editInterests" maxlength="1000" class="fi text-sm">
                        </div>
                    </div>
                </div>
            </div>

            <!-- REQ#3 — TEACHER/ADMIN fields in edit modal -->
            <div id="editStaffSection" class="hidden">
                <div class="border-t border-slate-100 pt-4">
                    <p id="editStaffLabel" class="text-[10px] font-black uppercase tracking-widest text-emerald-500 mb-3 flex items-center gap-1.5">
                        <i class="fas fa-chalkboard-user"></i> Staff Information
                    </p>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Faculty ID</label>
                            <input type="text" name="faculty_id" id="editFacultyId" maxlength="50" class="fi text-sm font-mono">
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Department</label>
                            <input type="text" name="department" id="editDepartment" maxlength="100" class="fi text-sm">
                        </div>
                    </div>
                </div>
            </div>

            <!-- Common fields -->
            <div class="grid grid-cols-2 gap-3">
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">City / Town</label>
                    <input type="text" name="city_town" id="editCity" maxlength="100" class="fi text-sm">
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Home Address</label>
                    <input type="text" name="home_address" id="editAddress" maxlength="500" class="fi text-sm">
                </div>
            </div>
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Self Description / Bio</label>
                <textarea name="self_description" id="editBio" rows="2" maxlength="500" class="fi text-sm resize-none"></textarea>
            </div>

            <div class="flex justify-end gap-3 pt-2">
                <button type="button" onclick="closeModal('modalEditUser')"
                    class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-50 transition">Cancel</button>
                <button type="submit"
                    class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-white text-sm font-bold hover:opacity-90 transition shadow-md">
                    <i class="fas fa-save mr-1"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

