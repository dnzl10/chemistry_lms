// ─────────────────────────────────
// REQ#4 — LRN REAL-TIME VALIDATION
// Strips non-digits as user types.
// Shows error message if not 0 or exactly 12.
// Used in BOTH invite and edit modals.
// ─────────────────────────────────
function validateLRN(input, errId) {
    // Strip any non-digit character immediately
    const digits = input.value.replace(/\D/g, '');
    input.value  = digits; // update the input to digits only
    const errEl  = document.getElementById(errId);
    if (digits.length > 0 && digits.length !== 12) {
        input.classList.add('invalid');
        errEl.textContent = `LRN must be exactly 12 digits (${digits.length}/12 entered).`;
        errEl.classList.add('show');
    } else {
        input.classList.remove('invalid');
        errEl.classList.remove('show');
    }
}

