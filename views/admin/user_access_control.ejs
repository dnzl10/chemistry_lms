<!-- ════════════════════════════════════════════════════
     JAVASCRIPT
════════════════════════════════════════════════════ -->
<script>
// ─────────────────────────────────
// GLOBAL SERVER DATA
// ─────────────────────────────────
// Server data globals referenced from top of script

// ─────────────────────────────────
// SIDEBAR
// ─────────────────────────────────
function toggleSidebar() {
    document.getElementById('sidebar').classList.toggle('-translate-x-full');
    document.getElementById('sidebarOverlay').classList.toggle('hidden');
}

// ─────────────────────────────────
// TABS
// ─────────────────────────────────
function switchTab(id, btn) {
    document.querySelectorAll('.tab-content').forEach(t => t.classList.remove('active'));
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(id).classList.add('active');
    btn.classList.add('active');
}

// ── Auto-activate tab from URL query param ──
// Usage: /admin/user_access_control?tab=tab-invites
//        /admin/user_access_control?tab=tab-flagged
    (function() {
        const urlParams = new URLSearchParams(window.location.search);
        const targetTab = urlParams.get('tab');
        if (targetTab) {
            const targetContent = document.getElementById(targetTab);
            const targetBtn = document.querySelector(`[onclick="switchTab('${targetTab}',this)"]`);
            if (targetContent && targetBtn) {
                switchTab(targetTab, targetBtn);
                // Smooth scroll to the tab section
                setTimeout(() => targetContent.scrollIntoView({ behavior: 'smooth', block: 'start' }), 100);
            }
        }
    })();

// ─────────────────────────────────
// MODAL STACK & DYNAMIC Z-INDEX MANAGER
// Always ensures the most recently opened modal sits on top.
// ─────────────────────────────────
const _baseModalZIndex = 9000;
let _topModalZIndex = 9000;
window._openModalStack = [];

function openModal(id) {
    const el = document.getElementById(id);
    if (!el) return;

    // Increment and assign higher z-index so the newly opened modal is always on top
    _topModalZIndex += 20;
    el.style.zIndex = _topModalZIndex;

    // Display modal
    el.classList.add('open');

    // Track modal in open stack (move to top if already present)
    const existingIdx = window._openModalStack.indexOf(id);
    if (existingIdx !== -1) {
        window._openModalStack.splice(existingIdx, 1);
    }
    window._openModalStack.push(id);

    // Prevent background scrolling
    document.body.style.overflow = 'hidden';
}

function closeModal(id) {
    if (!id && window._openModalStack.length > 0) {
        id = window._openModalStack[window._openModalStack.length - 1];
    }
    const el = document.getElementById(id);
    if (el) {
        el.classList.remove('open');
        setTimeout(() => {
            if (!el.classList.contains('open')) {
                el.style.zIndex = '';
            }
        }, 240);
    }

    if (id) {
        const idx = window._openModalStack.indexOf(id);
        if (idx !== -1) {
            window._openModalStack.splice(idx, 1);
        }
    }

    // Only restore body scrolling if all modals are closed
    if (window._openModalStack.length === 0) {
        document.body.style.overflow = '';
        _topModalZIndex = _baseModalZIndex;
    } else {
        document.body.style.overflow = 'hidden';
        // Ensure remaining top modal stays prominently on top
        const remainingTopId = window._openModalStack[window._openModalStack.length - 1];
        const remainingTopEl = document.getElementById(remainingTopId);
        if (remainingTopEl) {
            remainingTopEl.style.zIndex = _topModalZIndex;
        }
    }
}

// Close top modal when clicking backdrop
document.querySelectorAll('.modal-overlay').forEach(o => {
    o.addEventListener('click', e => {
        if (e.target === o) {
            // Close the clicked overlay
            closeModal(o.id);
        }
    });
});

// Close top modal on Escape key
document.addEventListener('keydown', e => {
    if (e.key === 'Escape' && window._openModalStack && window._openModalStack.length > 0) {
        const topModalId = window._openModalStack[window._openModalStack.length - 1];
        closeModal(topModalId);
    }
});

// Lock body scrolling whenever any modal is still active in stack
const _modalBodyObserver = new MutationObserver(() => {
    if (window._openModalStack && window._openModalStack.length > 0) {
        if (document.body.style.overflow !== 'hidden') {
            document.body.style.overflow = 'hidden';
        }
    }
});
_modalBodyObserver.observe(document.body, { attributes: true, attributeFilter: ['style', 'class'] });

