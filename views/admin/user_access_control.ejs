function updateInviteRoleFields() {
    const role = document.querySelector('input[name="inv_role"]:checked').value;
    // Hide all three sections
    document.getElementById('invStudentSection').classList.remove('visible');
    document.getElementById('invTeacherSection').classList.remove('visible');
    document.getElementById('invAdminSection').classList.remove('visible');
    // Show only the relevant one
    if (role === 'Student') document.getElementById('invStudentSection').classList.add('visible');
    if (role === 'Teacher') {
        document.getElementById('invTeacherSection').classList.add('visible');
        renderTeacherClassHierarchy();
    }
    if (role === 'Admin')   document.getElementById('invAdminSection').classList.add('visible');
    clearInvDup();
}
// Run on page load so Student is shown by default
updateInviteRoleFields();

