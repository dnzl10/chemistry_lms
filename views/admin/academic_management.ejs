// ─── Toggle Class Students Dropdown ──────────────────────────────────────────
async function toggleClassStudents(classId, headerEl, forceReload = false) {
    const container = document.getElementById(`students-class-${classId}`);
    const chevron   = document.getElementById(`chevron-class-${classId}`);

    const isOpen = !container.classList.contains('hidden');
    if (isOpen && !forceReload) {
        container.classList.add('hidden');
        if (chevron) chevron.style.transform = 'rotate(0deg)';
        return;
    }

    container.classList.remove('hidden');
    if (chevron) chevron.style.transform = 'rotate(180deg)';

    if (container.dataset.loaded === 'true' && !forceReload) return;

    container.innerHTML = `
        <div class="p-4 text-center text-slate-400 text-xs">
            <i class="fas fa-spinner fa-spin mr-1.5 text-indigo-500"></i> Loading enrolled students &amp; timeframe status...
        </div>`;

    try {
        const res  = await fetch(`/admin/am/classes/${classId}/students`);
        const data = await res.json();
        container.dataset.loaded = 'true';

        if (!data.success) {
            container.innerHTML = `<p class="text-center text-rose-500 text-xs py-4">${data.message || 'Failed to load students.'}</p>`;
            return;
        }

        const students = data.students || [];
        const clsInfo  = data.classInfo || {};
        _classStudentsCache[classId] = students;
        _classInfoCache[classId]     = { ...clsInfo, isEnrollmentOpen: data.isEnrollmentOpen, timeframeStatus: data.timeframeStatus, timeframeMessage: data.timeframeMessage };
        _selectedStudents[classId]   = new Set();

        // Update badge count in card header
        const countBadge = document.getElementById(`class-count-badge-${classId}`);
        if (countBadge) countBadge.textContent = `${students.length} students`;

        // Timeframe Pill Badge
        let timeframeBadge = '';
        if (data.timeframeStatus === 'open') {
            timeframeBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-emerald-50 text-emerald-800 border border-emerald-200 shadow-xs"><i class="fas fa-circle-check text-emerald-500"></i> ${data.timeframeMessage}</span>`;
        } else if (data.timeframeStatus === 'closed') {
            timeframeBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-rose-50 text-rose-800 border border-rose-200 shadow-xs" title="Un-enrolling outside active timeframe requires confirmation"><i class="fas fa-triangle-exclamation text-rose-500"></i> ${data.timeframeMessage}</span>`;
        } else if (data.timeframeStatus === 'not_started') {
            timeframeBadge = `<span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[11px] font-bold bg-amber-50 text-amber-800 border border-amber-300 shadow-xs"><i class="fas fa-clock text-amber-500"></i> ${data.timeframeMessage}</span>`;
        }

        if (students.length === 0) {
            container.innerHTML = `
                <div class="p-6 text-center">
                    <div class="flex items-center justify-between mb-3 border-b border-slate-100 pb-2">
                        <span class="text-[11px] font-black uppercase tracking-wider text-slate-400">0 Enrolled Students</span>
                        ${timeframeBadge}
                    </div>
                    <div class="py-4 text-slate-400">
                        <i class="fas fa-user-slash text-2xl mb-2 block opacity-30"></i>
                        <p class="text-xs font-bold">No students currently enrolled in this section.</p>
                        <p class="text-[11px] text-slate-400 mt-1">Use Bulk Student Enrollment to officially assign students to this section.</p>
                        <div class="mt-3">
                            <button onclick="quickEnrollForClass(${classId})" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 transition shadow-xs">
                                <i class="fas fa-user-plus"></i> Enroll Students
                            </button>
                        </div>
                    </div>
                </div>`;
            return;
        }

        container.innerHTML = `
            <div class="p-3.5 space-y-3">
                <!-- Roster Toolbar -->
                <div class="flex flex-wrap items-center justify-between gap-2.5 bg-slate-50/80 p-2.5 rounded-xl border border-slate-200/80">
                    <div class="flex items-center gap-3">
                        <label class="flex items-center gap-2 cursor-pointer text-xs font-bold text-slate-700 select-none">
                            <input type="checkbox" id="select-all-${classId}" class="rounded text-indigo-600 focus:ring-indigo-500 w-4 h-4 cursor-pointer"
                                   onchange="onStudentSelectAllChange(${classId}, this)">
                            <span>Select All</span>
                        </label>
                        <span class="text-slate-300">|</span>
                        <span class="text-[11px] font-extrabold uppercase tracking-wider text-slate-500">${students.length} Enrolled</span>
                        ${timeframeBadge}
                    </div>

                    <!-- Batch Action Buttons -->
                    <div class="flex items-center gap-2 ml-auto">
                        <span id="sel-count-${classId}" class="hidden text-xs font-bold text-indigo-700 bg-indigo-50 px-2 py-1 rounded-lg border border-indigo-200">
                            0 selected
                        </span>
                        <button id="btn-bulk-unenroll-${classId}" onclick="handleBulkUnenroll(${classId})"
                                class="hidden items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 shadow-xs transition">
                            <i class="fas fa-user-minus"></i> Un-enroll Selected
                        </button>
                        <button id="btn-bulk-migrate-${classId}" onclick="handleBulkMigrate(${classId})"
                                class="hidden items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 shadow-xs transition">
                            <i class="fas fa-right-left"></i> Migrate Selected
                        </button>
                        <button onclick="quickEnrollForClass(${classId})"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl text-xs font-bold bg-indigo-50 hover:bg-indigo-100 text-indigo-700 border border-indigo-200 shadow-xs transition">
                            <i class="fas fa-user-plus"></i> Enroll Students
                        </button>
                        <button onclick="handleMigrateEntireClass(${classId})"
                                class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-xl text-xs font-black bg-gradient-to-r from-teal-500 to-emerald-600 hover:from-teal-600 hover:to-emerald-700 text-white shadow-sm transition">
                            <i class="fas fa-arrow-right-arrow-left"></i> Migrate Entire Class
                        </button>
                    </div>
                </div>

                <!-- Students Roster List -->
                <div class="space-y-1.5 max-h-96 overflow-y-auto pr-1">
                    ${students.map((s, i) => `
                        <div class="flex items-center gap-3 p-2.5 rounded-xl bg-white border border-slate-100 hover:border-indigo-100 hover:bg-indigo-50/20 transition group">
                            <input type="checkbox" class="student-cb-${classId} rounded text-indigo-600 focus:ring-indigo-500 w-4 h-4 cursor-pointer"
                                   value="${s.user_id}" onchange="onStudentSelectChange(${classId})">
                            <span class="text-[10px] font-black text-slate-300 w-5 text-right font-mono">${i + 1}</span>
                            <img src="/profile_uploads/${s.profile_pic || 'default_avatar.png'}"
                                 class="w-8 h-8 rounded-xl object-cover border border-slate-200 flex-shrink-0 shadow-xs">
                            <div class="flex-1 min-w-0">
                                <div class="flex items-center gap-2">
                                    <p class="text-xs font-bold text-slate-800 truncate">${s.last_name}, ${s.first_name}</p>
                                    <span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-violet-50 text-violet-700 border border-violet-200 shadow-xs flex-shrink-0">
                                        Lv.${s.current_level}
                                    </span>
                                </div>
                                <p class="text-[11px] text-slate-400 truncate font-mono">${s.lrn_number ? 'LRN: ' + s.lrn_number : s.email}</p>
                            </div>
                            
                            <!-- Individual Action Buttons -->
                            <div class="flex items-center gap-1.5 opacity-90 group-hover:opacity-100 transition">
                                <button onclick="handleSingleMigrate(${classId}, ${s.user_id})"
                                        class="px-2.5 py-1 rounded-lg text-[11px] font-bold text-indigo-600 bg-indigo-50/60 hover:bg-indigo-100 hover:text-indigo-800 border border-indigo-200/60 transition flex items-center gap-1"
                                        title="Migrate this student">
                                    <i class="fas fa-right-left text-[10px]"></i> Migrate
                                </button>
                                <button onclick="handleSingleUnenroll(${classId}, ${s.user_id})"
                                        class="px-2.5 py-1 rounded-lg text-[11px] font-bold text-rose-600 bg-rose-50/60 hover:bg-rose-100 hover:text-rose-800 border border-rose-200/60 transition flex items-center gap-1"
                                        title="Un-enroll this student">
                                    <i class="fas fa-user-minus text-[10px]"></i> Un-enroll
                                </button>
                            </div>
                        </div>
                    `).join('')}
                </div>
            </div>`;

    } catch (err) {
        console.error('[AM Class Students Error]', err);
        container.innerHTML = `<p class="text-center text-rose-500 text-xs py-4">Failed to load students: ${err.message}</p>`;
    }
}

// ─── Quick Bulk Enrollment Shortcut ──────────────────────────────────────────
function quickEnrollForClass(classId) {
    openModal('modalBulkEnroll');
    const selEl = document.getElementById('bulkEnrollClassId');
    if (selEl) {
        selEl.value = classId;
        if (typeof onBulkEnrollClassChanged === 'function') {
            onBulkEnrollClassChanged(selEl);
        }
    }
}

// ─── Student Checkbox Selection Handlers ─────────────────────────────────────
function onStudentSelectAllChange(classId, masterCb) {
    const cbs = document.querySelectorAll(`.student-cb-${classId}`);
    const sel = _selectedStudents[classId] || new Set();
    sel.clear();
    cbs.forEach(cb => {
        cb.checked = masterCb.checked;
        if (masterCb.checked) sel.add(parseInt(cb.value, 10));
    });
    _selectedStudents[classId] = sel;
    updateBatchToolbar(classId);
}

function onStudentSelectChange(classId) {
    const cbs = document.querySelectorAll(`.student-cb-${classId}`);
    const masterCb = document.getElementById(`select-all-${classId}`);
    const sel = new Set();
    let checkedCount = 0;
    cbs.forEach(cb => {
        if (cb.checked) {
            checkedCount++;
            sel.add(parseInt(cb.value, 10));
        }
    });
    _selectedStudents[classId] = sel;
    if (masterCb) {
        masterCb.checked = (checkedCount === cbs.length && cbs.length > 0);
        masterCb.indeterminate = (checkedCount > 0 && checkedCount < cbs.length);
    }
    updateBatchToolbar(classId);
}

function updateBatchToolbar(classId) {
    const sel = _selectedStudents[classId] || new Set();
    const count = sel.size;
    const badge = document.getElementById(`sel-count-${classId}`);
    const btnUnenroll = document.getElementById(`btn-bulk-unenroll-${classId}`);
    const btnMigrate  = document.getElementById(`btn-bulk-migrate-${classId}`);

    if (count > 0) {
        if (badge) {
            badge.textContent = `${count} selected`;
            badge.classList.remove('hidden');
        }
        if (btnUnenroll) {
            btnUnenroll.classList.remove('hidden');
            btnUnenroll.classList.add('inline-flex');
            btnUnenroll.innerHTML = `<i class="fas fa-user-minus"></i> Un-enroll Selected (${count})`;
        }
        if (btnMigrate) {
            btnMigrate.classList.remove('hidden');
            btnMigrate.classList.add('inline-flex');
            btnMigrate.innerHTML = `<i class="fas fa-right-left"></i> Migrate Selected (${count})`;
        }
    } else {
        if (badge) badge.classList.add('hidden');
        if (btnUnenroll) {
            btnUnenroll.classList.add('hidden');
            btnUnenroll.classList.remove('inline-flex');
        }
        if (btnMigrate) {
            btnMigrate.classList.add('hidden');
            btnMigrate.classList.remove('inline-flex');
        }
    }
}

// ─── UN-ENROLL LOGIC (TIMEFRAME VERIFICATION & PROMPTS) ──────────────────────
async function handleSingleUnenroll(classId, studentId) {
    promptUnenroll(classId, [studentId]);
}

async function handleBulkUnenroll(classId) {
    const sel = _selectedStudents[classId] || new Set();
    if (sel.size === 0) {
        showToast('Please select at least one student to un-enroll.', 'warning');
        return;
    }
    promptUnenroll(classId, Array.from(sel));
}

async function promptUnenroll(classId, studentIds) {
    const clsInfo = _classInfoCache[classId] || {};
    const students = _classStudentsCache[classId] || [];

    const selectedStudentNames = studentIds.map(id => {
        const s = students.find(st => st.user_id === id);
        return s ? `${s.first_name} ${s.last_name}` : `Student #${id}`;
    });

    const isOutsideTimeframe = (clsInfo.isEnrollmentOpen === false) || (clsInfo.timeframeStatus === 'closed' || clsInfo.timeframeStatus === 'not_started');

    // Case 1: Outside Timeframe Warning
    if (isOutsideTimeframe) {
        const warnHtml = `
            <div class="text-left text-xs text-slate-600 space-y-2.5">
                <div class="p-3 bg-amber-50 rounded-xl border border-amber-200 text-amber-900">
                    <p class="font-bold flex items-center gap-1.5"><i class="fas fa-triangle-exclamation text-amber-600 text-sm"></i> Inactive Enrollment Timeframe Detected</p>
                    <p class="text-[11px] mt-1 text-amber-800 leading-snug">${clsInfo.timeframeMessage || 'The designated enrollment timeframe for this section has closed or not started yet.'}</p>
                </div>
                <div class="p-3 bg-slate-50 rounded-xl border border-slate-200">
                    <p class="font-bold text-slate-800">Target Section: <span class="text-indigo-600">${clsInfo.class_name}</span> (${clsInfo.subject_name || 'Subject'})</p>
                    <p class="font-bold text-slate-800 mt-1">Students to Un-enroll (${studentIds.length}):</p>
                    <p class="text-[11px] text-slate-600 font-medium max-h-20 overflow-y-auto mt-0.5">${selectedStudentNames.join(', ')}</p>
                </div>
                <p class="text-rose-700 font-bold text-[11px]">
                    <i class="fas fa-circle-exclamation mr-1"></i> Warning: Un-enrolling outside designated timeframe may disrupt learning records, grades, and arcade assessments.
                </p>
                <p class="text-slate-700 font-bold pt-1">
                    Are you sure you want to proceed and override this timeframe restriction?
                </p>
            </div>`;

        if (window.Swal) {
            const res = await Swal.fire({
                title: 'Confirm Un-enrollment Outside Timeframe',
                html: warnHtml,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#e11d48',
                cancelButtonColor: '#64748b',
                confirmButtonText: '<i class="fas fa-exclamation-triangle mr-1"></i> Proceed &amp; Un-enroll Anyway',
                cancelButtonText: 'Cancel &amp; Abort',
                reverseButtons: true
            });
            if (!res.isConfirmed) return;
            await executeUnenroll(classId, studentIds, true);
        } else {
            const proceed = confirm(`WARNING: Section "${clsInfo.class_name}" enrollment window is inactive (${clsInfo.timeframeMessage}). Un-enroll ${studentIds.length} student(s) anyway?`);
            if (!proceed) return;
            await executeUnenroll(classId, studentIds, true);
        }
        return;
    }

    // Case 2: Standard Inside Timeframe Confirmation
    const studentListSnippet = selectedStudentNames.length > 5 
        ? selectedStudentNames.slice(0, 5).join(', ') + ` + ${selectedStudentNames.length - 5} more`
        : selectedStudentNames.join(', ');

    if (window.Swal) {
        const res = await Swal.fire({
            title: 'Confirm Student Un-enrollment',
            html: `
                <div class="text-left text-xs text-slate-600 space-y-2">
                    <p class="text-slate-700">Are you sure you want to un-enroll the following student(s) from <b>${clsInfo.class_name}</b>?</p>
                    <div class="p-2.5 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-800 text-[11px] max-h-24 overflow-y-auto">
                        ${studentListSnippet}
                    </div>
                    <p class="text-slate-500 text-[11px]">This will revoke their access to this section. Their historical arcade achievements will remain in the database.</p>
                </div>`,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#e11d48',
            cancelButtonColor: '#64748b',
            confirmButtonText: 'Yes, Un-enroll',
            cancelButtonText: 'Cancel',
            reverseButtons: true
        });
        if (!res.isConfirmed) return;
        await executeUnenroll(classId, studentIds, false);
    } else {
        const proceed = confirm(`Are you sure you want to un-enroll ${studentIds.length} student(s) from "${clsInfo.class_name}"?`);
        if (!proceed) return;
        await executeUnenroll(classId, studentIds, false);
    }
}

async function executeUnenroll(classId, studentIds, force) {
    try {
        const res = await fetch(`/admin/am/classes/${classId}/unenroll`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ student_ids: studentIds, force })
        });
        const data = await res.json();

        if (data.success) {
            showToast(data.message, 'success');
            // Refresh class roster
            await toggleClassStudents(classId, null, true);
        } else {
            showToast(data.message || 'Failed to un-enroll student(s).', 'error');
        }
    } catch (err) {
        showToast('Error during un-enrollment: ' + err.message, 'error');
    }
}

// ─── MIGRATE / TRANSITION STUDENTS LOGIC ──────────────────────────────────────
function handleSingleMigrate(classId, studentId) {
    openMigrateModal(classId, [studentId], false);
}

function handleBulkMigrate(classId) {
    const sel = _selectedStudents[classId] || new Set();
    if (sel.size === 0) {
        showToast('Please select at least one student to migrate.', 'warning');
        return;
    }
    openMigrateModal(classId, Array.from(sel), false);
}

function handleMigrateEntireClass(classId) {
    const students = _classStudentsCache[classId] || [];
    if (students.length === 0) {
        showToast('No students available in this class to migrate.', 'warning');
        return;
    }
    const allIds = students.map(s => s.user_id);
    openMigrateModal(classId, allIds, true);
}

async function openMigrateModal(sourceClassId, studentIds, isEntireClass) {
    _migrateSourceClassId = sourceClassId;
    _migrateStudentIds    = studentIds;

    const sourceCls = _classInfoCache[sourceClassId] || {};
    const students  = _classStudentsCache[sourceClassId] || [];

    // Header & subtitle
    document.getElementById('migrateSourceClassDisplay').textContent = `${sourceCls.subject_name || 'Subject'} — Section ${sourceCls.class_name || 'Class'}` + (sourceCls.teacher_name ? ` (Teacher: ${sourceCls.teacher_name})` : '');
    document.getElementById('migrateStudentCountBadge').textContent = isEntireClass
        ? `Entire Class (${studentIds.length} Students)`
        : `${studentIds.length} Student${studentIds.length > 1 ? 's' : ''} Selected`;

    // Render Preview Chips
    const previewContainer = document.getElementById('migrateSelectedStudentsPreview');
    const selectedList = students.filter(s => studentIds.includes(s.user_id));
    previewContainer.innerHTML = selectedList.map(s => `
        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-slate-200 text-xs font-bold text-slate-800 shadow-2xs">
            <img src="/profile_uploads/${s.profile_pic || 'default_avatar.png'}" class="w-4 h-4 rounded-full object-cover">
            ${s.first_name} ${s.last_name}
        </span>
    `).join('');

    // Fetch Targets
    const subSelect = document.getElementById('migrateTargetSubject');
    const clsSelect = document.getElementById('migrateTargetClass');
    const btnExecute = document.getElementById('btnExecuteMigrate');
    const verifBox = document.getElementById('migrateVerificationBox');

    subSelect.innerHTML = '<option value="">Loading subjects...</option>';
    clsSelect.innerHTML = '<option value="">— Select Subject First —</option>';
    clsSelect.disabled = true;
    btnExecute.disabled = true;
    verifBox.classList.add('hidden');

    openModal('modalMigrateStudents');

    try {
        const res = await fetch(`/admin/am/migrate/targets?source_class_id=${sourceClassId}`);
        const data = await res.json();
        if (!data.success) {
            subSelect.innerHTML = '<option value="">Failed to load subjects</option>';
            return;
        }

        _migrateSubjects = data.subjects || [];
        _migrateClasses  = data.classes || [];

        subSelect.innerHTML = '<option value="">— Select Target Subject —</option>' +
            _migrateSubjects.map(s => `<option value="${s.subject_id}">${s.subject_name} (${s.subject_code || 'No code'})</option>`).join('');

    } catch (err) {
        subSelect.innerHTML = '<option value="">Network error loading subjects</option>';
    }
}

function onMigrateSubjectChange() {
    const subSelect = document.getElementById('migrateTargetSubject');
    const clsSelect = document.getElementById('migrateTargetClass');
    const btnExecute = document.getElementById('btnExecuteMigrate');
    const verifBox   = document.getElementById('migrateVerificationBox');

    const subjectId = parseInt(subSelect.value, 10);
    clsSelect.innerHTML = '<option value="">— Select Target Section —</option>';
    btnExecute.disabled = true;
    verifBox.classList.add('hidden');

    if (isNaN(subjectId)) {
        clsSelect.disabled = true;
        return;
    }

    const filteredClasses = _migrateClasses.filter(c => c.subject_id === subjectId);
    if (filteredClasses.length === 0) {
        clsSelect.innerHTML = '<option value="">No classes found for this subject</option>';
        clsSelect.disabled = true;
        return;
    }

    clsSelect.disabled = false;
    filteredClasses.forEach(c => {
        const capText = c.max_capacity ? `${c.current_enrolled}/${c.max_capacity} enrolled` : `${c.current_enrolled} enrolled`;
        const teacherText = c.teacher_name ? ` · ${c.teacher_name}` : '';
        const opt = document.createElement('option');
        opt.value = c.class_id;
        opt.textContent = `${c.class_name} (${capText}${teacherText})`;
        clsSelect.appendChild(opt);
    });
}

async function onMigrateTargetClassChange() {
    const clsSelect = document.getElementById('migrateTargetClass');
    const targetClassId = parseInt(clsSelect.value, 10);
    const verifBox = document.getElementById('migrateVerificationBox');
    const btnExecute = document.getElementById('btnExecuteMigrate');

    if (isNaN(targetClassId)) {
        verifBox.classList.add('hidden');
        btnExecute.disabled = true;
        return;
    }

    verifBox.classList.remove('hidden');
    verifBox.className = 'p-4 rounded-2xl border border-indigo-200 bg-indigo-50/30 text-xs shadow-sm space-y-2';
    verifBox.innerHTML = '<p class="text-indigo-700 font-bold flex items-center gap-1.5"><i class="fas fa-spinner fa-spin"></i> Verifying capacity, enrollment timeframe, and duplicate enrollments...</p>';

    try {
        const res = await fetch(`/admin/am/classes/${_migrateSourceClassId}/migrate/preview`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ target_class_id: targetClassId, student_ids: _migrateStudentIds })
        });
        const data = await res.json();
        if (!data.success) {
            verifBox.className = 'p-4 rounded-2xl border border-rose-200 bg-rose-50 text-rose-800 text-xs shadow-sm';
            verifBox.innerHTML = `<p class="font-bold"><i class="fas fa-circle-xmark mr-1"></i> ${data.message}</p>`;
            btnExecute.disabled = true;
            return;
        }

        const tc = data.targetClass;
        let checksHtml = '';

        // Timeframe Check
        if (data.isOutsideTimeframe) {
            checksHtml += `
                <div class="flex items-start gap-2 text-rose-800 bg-rose-50 p-2.5 rounded-xl border border-rose-200">
                    <i class="fas fa-triangle-exclamation text-rose-600 mt-0.5"></i>
                    <div>
                        <span class="font-black">Enrollment Timeframe Notice:</span>
                        <span class="block text-[11px]">${data.timeframeMessage}. Migrating will require confirmation.</span>
                    </div>
                </div>`;
        } else {
            checksHtml += `
                <div class="flex items-center gap-2 text-emerald-800 bg-emerald-50 p-2 rounded-xl border border-emerald-200">
                    <i class="fas fa-circle-check text-emerald-600"></i>
                    <span class="font-bold">Enrollment Timeframe Active (${data.timeframeMessage})</span>
                </div>`;
        }

        // Capacity Check
        if (data.willExceedCapacity) {
            checksHtml += `
                <div class="flex items-start gap-2 text-amber-900 bg-amber-50 p-2.5 rounded-xl border border-amber-200">
                    <i class="fas fa-users-slash text-amber-600 mt-0.5"></i>
                    <div>
                        <span class="font-black">Capacity Cap Notice:</span>
                        <span class="block text-[11px]">Target capacity is ${data.maxCapacity}. Adding ${data.newEnrollmentCount} new student(s) to current ${data.currentEnrolled} results in ${data.projectedEnrolled}/${data.maxCapacity} (Exceeds capacity cap).</span>
                    </div>
                </div>`;
        } else if (data.maxCapacity) {
            checksHtml += `
                <div class="flex items-center gap-2 text-indigo-900 bg-indigo-50/70 p-2 rounded-xl border border-indigo-200">
                    <i class="fas fa-users text-indigo-600"></i>
                    <span class="font-bold">Projected Capacity: ${data.projectedEnrolled} / ${data.maxCapacity} enrolled (Within limit)</span>
                </div>`;
        }

        // Duplicates check
        if (data.alreadyEnrolledCount > 0) {
            checksHtml += `
                <div class="flex items-start gap-2 text-sky-900 bg-sky-50 p-2.5 rounded-xl border border-sky-200">
                    <i class="fas fa-circle-info text-sky-600 mt-0.5"></i>
                    <div>
                        <span class="font-black">${data.alreadyEnrolledCount} Student(s) Already Enrolled:</span>
                        <span class="block text-[11px]">These students are already members of this target section and will be retained without duplicate rows.</span>
                    </div>
                </div>`;
        }

        verifBox.className = 'p-4 rounded-2xl border border-slate-200 bg-white text-xs shadow-sm space-y-2.5';
        verifBox.innerHTML = `
            <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                <span class="font-black uppercase tracking-wider text-slate-400 text-[10px]">Pre-Flight System Verification</span>
                <span class="font-bold text-slate-600 text-[11px]">Target: ${tc.subject_name} — ${tc.class_name} (${tc.teacher_name || 'No Teacher'})</span>
            </div>
            ${checksHtml}
        `;

        btnExecute.disabled = false;

    } catch (err) {
        verifBox.className = 'p-4 rounded-2xl border border-rose-200 bg-rose-50 text-rose-800 text-xs shadow-sm';
        verifBox.innerHTML = `<p class="font-bold"><i class="fas fa-triangle-exclamation mr-1"></i> Preview error: ${err.message}</p>`;
        btnExecute.disabled = true;
    }
}

async function confirmAndExecuteMigration() {
    const targetClassId = parseInt(document.getElementById('migrateTargetClass').value, 10);
    if (isNaN(targetClassId)) {
        showToast('Please select a target class first.', 'warning');
        return;
    }

    const actionModeEl = document.querySelector('input[name="migrateActionMode"]:checked');
    const removeFromSource = actionModeEl ? (actionModeEl.value === 'transfer') : false;

    const sourceDisplay = document.getElementById('migrateSourceClassDisplay').textContent;
    const targetClassSelect = document.getElementById('migrateTargetClass');
    const targetDisplay = targetClassSelect.options[targetClassSelect.selectedIndex].textContent;

    const modeText = removeFromSource
        ? '<b class="text-rose-600">Transfer &amp; Move</b> (Students will be removed from current section)'
        : '<b class="text-indigo-600">Advance Course</b> (Students will keep completed prerequisite history)';

    const confirmHtml = `
        <div class="text-left text-xs text-slate-600 space-y-2.5">
            <p class="font-bold text-slate-800 text-sm">Review Migration Details:</p>
            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl space-y-1.5">
                <p><b>Total Students:</b> <span class="text-indigo-700 font-bold">${_migrateStudentIds.length} student(s)</span></p>
                <p><b>From:</b> ${sourceDisplay}</p>
                <p><b>To:</b> ${targetDisplay}</p>
                <p><b>Mode:</b> ${modeText}</p>
            </div>
            <p class="text-[11px] text-slate-500">All target section enrollments, syllabus access, and learning progress tracking will be automatically updated.</p>
        </div>`;

    if (window.Swal) {
        const res = await Swal.fire({
            title: 'Execute Student Migration?',
            html: confirmHtml,
            icon: 'question',
            showCancelButton: true,
            confirmButtonColor: '#4f46e5',
            cancelButtonColor: '#64748b',
            confirmButtonText: '<i class="fas fa-right-left mr-1"></i> Confirm &amp; Execute Migration',
            cancelButtonText: 'Cancel &amp; Review',
            reverseButtons: true
        });
        if (!res.isConfirmed) return;
    } else {
        const proceed = confirm(`Migrate ${_migrateStudentIds.length} student(s) to ${targetDisplay}?`);
        if (!proceed) return;
    }

    try {
        const res = await fetch(`/admin/am/classes/${_migrateSourceClassId}/migrate`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                target_class_id: targetClassId,
                student_ids: _migrateStudentIds,
                remove_from_source: removeFromSource,
                force: true
            })
        });
        const data = await res.json();

        if (data.success) {
            closeModal('modalMigrateStudents');
            showToast(data.message, 'success');
            // Refresh source class roster
            await toggleClassStudents(_migrateSourceClassId, null, true);
            // Also refresh overall classes list to update counts
            await loadClasses();
        } else {
            showToast(data.message || 'Migration failed.', 'error');
        }
    } catch (err) {
        showToast('Error during migration: ' + err.message, 'error');
    }
}

// ─── Progress ─────────────────────────────────────────────────────────────────
async function loadProgress() {
    if (!activeDrillSubjectId) return;
    const classId   = document.getElementById('progressClassFilter').value;
    const container = document.getElementById('progressContainer');
    container.innerHTML = `<div class="text-center py-6"><i class="fas fa-spinner fa-spin text-cyan-300 text-xl"></i></div>`;
    try {
        const curSyId = new URLSearchParams(window.location.search).get('sy_id');
        let url = `/admin/am/subjects/${activeDrillSubjectId}/progress?class_id=${encodeURIComponent(classId || '')}`;
        if (curSyId) url += `&sy_id=${encodeURIComponent(curSyId)}`;
        const res  = await fetch(url);
        const data = await res.json();
        if (!data.success || !data.progress || !data.progress.length) {
            container.innerHTML = `<div class="text-center py-10 text-slate-400"><i class="fas fa-chart-bar text-3xl mb-2 block opacity-30"></i><p class="font-bold text-sm">No progress data yet.</p></div>`;
            return;
        }
        container.innerHTML = `<div class="space-y-3">` + data.progress.map(p => `
            <div class="flex items-center gap-4 p-3 bg-slate-50 rounded-xl border border-slate-100">
                <img src="/profile_uploads/${p.profile_pic || 'default_avatar.png'}" class="w-9 h-9 rounded-xl object-cover border-2 border-slate-200" onerror="this.src='/profile_uploads/default_avatar.png'">
                <div class="flex-1 min-w-0">
                    <p class="font-bold text-slate-800 text-sm truncate">${p.first_name} ${p.last_name}</p>
                    <div class="flex items-center gap-2 mt-1">
                        <div class="progress-bar flex-1"><div class="progress-fill" style="width:${p.progress_percent}%"></div></div>
                        <span class="text-xs font-black text-indigo-700 w-10 text-right">${p.progress_percent}%</span>
                    </div>
                </div>
                <span class="text-xs text-slate-400 hidden md:block">${p.last_accessed ? new Date(p.last_accessed).toLocaleDateString('en-PH',{month:'short',day:'numeric'}) : '—'}</span>
            </div>`).join('') + `</div>`;
    } catch { container.innerHTML = `<p class="text-rose-500 text-sm">Failed to load progress.</p>`; }
}

// Global cache for announcements preview
window._academicAnnouncements = {};

// ─── Announcements ────────────────────────────────────────────────────────────
async function loadAnnouncements() {
    if (!activeDrillSubjectId) return;
    const container = document.getElementById('announcementsContainer');
    container.innerHTML = `<div class="text-center py-6"><i class="fas fa-spinner fa-spin text-amber-300 text-xl"></i></div>`;
    try {
        const curSyId = new URLSearchParams(window.location.search).get('sy_id');
        const res  = await fetch(`/admin/am/subjects/${activeDrillSubjectId}/announcements${curSyId ? '?sy_id=' + encodeURIComponent(curSyId) : ''}`);
        const data = await res.json();
        if (!data.success || !data.announcements || !data.announcements.length) {
            container.innerHTML = `<div class="text-center py-10 text-slate-400"><i class="fas fa-bullhorn text-3xl mb-2 block opacity-30"></i><p class="font-bold text-sm">No announcements yet.</p></div>`;
            return;
        }
        window._academicAnnouncements = {};
        data.announcements.forEach(a => { window._academicAnnouncements[a.announcement_id] = a; });

        container.innerHTML = `<div class="space-y-3">` + data.announcements.map(a => `
            <div class="p-4 rounded-xl border ${a.is_critical ? 'border-rose-300 bg-rose-50/70' : (a.is_priority ? 'border-amber-200 bg-amber-50/50' : 'border-slate-100 bg-white')}">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex-1">
                        <div class="flex items-center gap-2 mb-1 flex-wrap">
                            ${a.is_critical ? `<span class="px-2 py-0.5 rounded-full bg-rose-600 text-white text-[9px] font-black uppercase tracking-wider"><i class="fas fa-triangle-exclamation"></i> Emergency Alert</span>` : ''}
                            ${a.is_priority && !a.is_critical ? `<span class="badge badge-locked text-[9px]">Priority</span>` : ''}
                            ${a.due_date ? `<span class="px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 text-[9px] font-bold"><i class="fas fa-clock mr-1"></i>Due ${new Date(a.due_date).toLocaleDateString('en-US', {month:'short', day:'numeric'})}</span>` : ''}
                        </div>
                        <p class="font-black text-slate-800 text-sm">${a.title}</p>
                        <p class="text-xs text-slate-600 mt-1 line-clamp-2 leading-relaxed">${a.content}</p>
                        
                        <div class="flex items-center gap-4 mt-2 text-[10px] text-slate-400 font-bold flex-wrap">
                            <span><i class="fas fa-calendar-alt mr-1"></i>${new Date(a.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})}</span>
                            <span><i class="fas fa-bullhorn text-indigo-500 mr-1"></i>${a.scope === 'global' ? 'Campus-Wide Broadcast' : (a.class_name ? a.class_name : 'Subject-Wide')}</span>
                            ${a.attachment_url ? `<span class="text-cyan-600"><i class="fas fa-paperclip mr-1"></i>Attached Proof</span>` : ''}
                        </div>
                    </div>
                    <div class="flex items-center gap-1 flex-shrink-0">
                        <button class="btn-icon text-cyan-600 hover:bg-cyan-50" title="Preview Announcement & Proof" onclick="openAnnouncementPreview(window._academicAnnouncements[${a.announcement_id}])">
                            <i class="fas fa-eye"></i>
                        </button>
                        <button class="btn-icon btn-delete flex-shrink-0" onclick="confirmDeleteAnnouncement(${a.announcement_id},'${(a.title || '').replace(/'/g,"\\'")}')">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>`).join('') + `</div>`;
    } catch (e) {
        console.error('[loadAnnouncements Error]:', e);
        container.innerHTML = `<p class="text-rose-500 text-sm">Failed to load announcements.</p>`;
    }
}

function openAddAnnouncement() {
    document.getElementById('addAnnSubjectId').value = activeDrillSubjectId;
    openModal('modalAddAnnouncement');
}
async function submitAddAnnouncement(e) {
    e.preventDefault();
    const fd = new FormData(document.getElementById('addAnnouncementForm'));
    const classVal = fd.get('class_id');
    const isGlobal = classVal === '__GLOBAL__';

    const endpoint = isGlobal ? '/admin/api/broadcast/global' : '/admin/am/announcements';
    fd.set('teacher_id', '<%- JSON.stringify(user.user_id) %>');
    if (!isGlobal) {
        fd.set('subject_id', activeDrillSubjectId);
    }
    const curSyId = new URLSearchParams(window.location.search).get('sy_id');
    if (curSyId) {
        fd.set('sy_id', curSyId);
    }
    if (!fd.has('is_priority')) fd.set('is_priority', '0');
    if (!fd.has('is_critical')) fd.set('is_critical', '0');
    if (!fd.has('forward_webhook')) fd.set('forward_webhook', '0');

    try {
        const res = await fetch(endpoint, { method: 'POST', body: fd });
        const data = await res.json();
        if (data.success) {
            showToast(isGlobal ? 'Global Broadcast published!' : 'Announcement posted!', 'success');
            closeModal('modalAddAnnouncement');
            document.getElementById('addAnnouncementForm').reset();
            loadAnnouncements();
        } else {
            showToast(data.message || 'Failed.', 'error');
        }
    } catch (err) {
        showToast('Failed to post announcement: ' + err.message, 'error');
    }
}

function confirmDeleteAnnouncement(annId, title) {
    showConfirm({
        icon:'fa-trash', iconBg:'bg-rose-100', iconColor:'text-rose-600',
        title:`Delete "${title}"?`,
        desc:'This announcement will be permanently removed.',
        btnLabel:'Delete', btnColor:'bg-rose-500',
        onConfirm: async () => {
            const data = await apiDelete(`/admin/am/announcements/${annId}`);
            closeModal('modalConfirm');
            if (data.success) { showToast('Deleted.', 'success'); loadAnnouncements(); }
            else showToast(data.message || 'Failed.', 'error');
        }
    });
}



// ─── Bulk Import ──────────────────────────────────────────────────────────────
function handleBulkDrop(e, type) {
    e.preventDefault();
    const file = e.dataTransfer.files[0];
    if (!file) return;
    if (type === 'subject') { bulkSubjectFile = file; showBulkPreview(file,'subjectBulkPreview'); document.getElementById('btnSubmitSubjectBulk').disabled = false; }
    if (type === 'enroll')  { bulkEnrollFile  = file; showBulkPreview(file,'enrollBulkPreview');  document.getElementById('btnSubmitEnrollBulk').disabled  = false; }
}
function previewBulkSubject(input) {
    bulkSubjectFile = input.files[0];
    if (bulkSubjectFile) { showBulkPreview(bulkSubjectFile,'subjectBulkPreview'); document.getElementById('btnSubmitSubjectBulk').disabled = false; }
}
function previewEnrollFile(input) {
    bulkEnrollFile = input.files[0];
    if (bulkEnrollFile) { showBulkPreview(bulkEnrollFile,'enrollBulkPreview'); document.getElementById('btnSubmitEnrollBulk').disabled = false; }
}
function showBulkPreview(file, previewId) {
    const el = document.getElementById(previewId);
    el.classList.remove('hidden');
    el.innerHTML = `<div class="flex items-center gap-3 p-3 bg-white rounded-xl border border-slate-100"><i class="fas fa-file-excel text-emerald-500 text-2xl"></i><div><p class="font-bold text-sm text-slate-700">${file.name}</p><p class="text-xs text-slate-400">${(file.size/1024).toFixed(1)} KB</p></div><span class="ml-auto badge badge-active">Ready</span></div>`;
}

async function submitBulkSubjects() {
    if (!bulkSubjectFile) return;
    const fd  = new FormData(); fd.append('file', bulkSubjectFile);
    const log = document.getElementById('subjectBulkLog');
    log.classList.remove('hidden'); log.innerHTML = `<div class="text-cyan-400">⏳ Importing subjects…</div>`;
    const res  = await fetch('/admin/am/bulk-subjects', { method:'POST', body:fd });
    const data = await res.json();
    if (data.success) {
        log.innerHTML = `<div class="text-emerald-400 font-bold mb-1">✅ Done! Created: ${data.created} · Skipped: ${data.skipped} · Errors: ${data.errors}</div>${(data.log||[]).map(l=>`<div class="text-xs mt-0.5 ${l.ok?'text-slate-400':'text-rose-400'}">${l.msg}</div>`).join('')}`;
        showToast(`Imported ${data.created} subject(s)!`, 'success');
    } else { log.innerHTML = `<div class="text-rose-400">❌ ${data.message}</div>`; showToast('Import failed.', 'error'); }
}

function onBulkEnrollClassChanged(sel) {
    const banner = document.getElementById('bulkEnrollClassStatusBanner');
    const submitBtn = document.getElementById('btnSubmitEnrollBulk');
    if (!banner) return;
    if (!sel || !sel.value) {
        banner.className = 'hidden';
        banner.innerHTML = '';
        return;
    }
    const opt = sel.options[sel.selectedIndex];
    const isClosed = opt.dataset.closed === '1';
    const isUpcoming = opt.dataset.upcoming === '1';
    const startStr = opt.dataset.start;
    const endStr = opt.dataset.end;

    banner.classList.remove('hidden');
    if (isClosed) {
        banner.className = 'mt-2 p-3 rounded-xl text-xs border bg-rose-50 border-rose-200 text-rose-800 transition-all';
        const formattedEnd = endStr ? new Date(endStr).toLocaleString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'ended';
        banner.innerHTML = `<div class="flex items-start gap-2.5"><i class="fas fa-calendar-xmark text-rose-500 text-base mt-0.5"></i><div><p class="font-bold">Enrollment Period Closed</p><p class="text-[11px] text-rose-600 mt-0.5">Enrollment for this class ended on ${formattedEnd}. Students cannot be enrolled after the enrollment period has closed.</p></div></div>`;
        if (submitBtn) submitBtn.disabled = true;
    } else if (isUpcoming) {
        banner.className = 'mt-2 p-3 rounded-xl text-xs border bg-amber-50 border-amber-200 text-amber-800 transition-all';
        const formattedStart = startStr ? new Date(startStr).toLocaleString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'upcoming';
        banner.innerHTML = `<div class="flex items-start gap-2.5"><i class="fas fa-clock text-amber-500 text-base mt-0.5"></i><div><p class="font-bold">Enrollment Not Started Yet</p><p class="text-[11px] text-amber-600 mt-0.5">Enrollment for this class opens on ${formattedStart}. Students cannot be enrolled until enrollment opens.</p></div></div>`;
        if (submitBtn) submitBtn.disabled = true;
    } else {
        banner.className = 'mt-2 p-3 rounded-xl text-xs border bg-emerald-50 border-emerald-200 text-emerald-800 transition-all';
        const formattedEnd = endStr ? new Date(endStr).toLocaleString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Ongoing';
        const isSem2 = opt.dataset.semester == 2;
        const passThreshold = <%= (locals.selectedSY && locals.selectedSY.passing_threshold) || (locals.activeSY && locals.activeSY.passing_threshold) || (locals.currentSY && locals.currentSY.passing_threshold) || 75 %>;
        const prereqPill = isSem2
            ? `<div class="mt-2 pt-2 border-t border-emerald-200/80 text-[11px] text-indigo-950 font-semibold"><i class="fas fa-shield-alt text-indigo-600 mr-1.5"></i><b>Chemistry 1 Prerequisite Active:</b> Students must have taken and passed Chemistry 1 (Threshold: ${passThreshold}%) to be enrolled into this section. Ineligible students will be skipped automatically.</div>`
            : '';
        banner.innerHTML = `<div class="flex items-start gap-2.5"><i class="fas fa-circle-check text-emerald-500 text-base mt-0.5"></i><div><p class="font-bold">Enrollment Open</p><p class="text-[11px] text-emerald-700 mt-0.5">Enrollment window is active (Closes on ${formattedEnd}).</p>${prereqPill}</div></div>`;
        if (submitBtn && bulkEnrollFile) submitBtn.disabled = false;
    }
}

async function submitBulkEnroll() {
    const selEl = document.getElementById('bulkEnrollClassId');
    const classId = selEl ? selEl.value : null;
    if (!classId) { showToast('Please select a target class first.', 'error'); return; }
    const selectedOpt = selEl.options[selEl.selectedIndex];
    if (selectedOpt && (selectedOpt.dataset.closed === '1' || selectedOpt.dataset.upcoming === '1')) {
        showToast('Enrollment for this class is closed or not open yet. Students cannot be enrolled.', 'error');
        return;
    }
    if (!bulkEnrollFile) { showToast('Please upload an enrollment file first.', 'error'); return; }
    const fd  = new FormData(); fd.append('file', bulkEnrollFile); fd.append('class_id', classId);
    const log = document.getElementById('enrollBulkLog');
    log.classList.remove('hidden'); log.innerHTML = `<div class="text-cyan-400">⏳ Enrolling students…</div>`;
    const res  = await fetch('/admin/am/bulk-enroll', { method:'POST', body:fd });
    const data = await res.json();
    if (data.success) {
        log.innerHTML = `<div class="text-emerald-400 font-bold mb-1">✅ Done! Enrolled: ${data.enrolled} · Skipped: ${data.skipped} · Errors: ${data.errors}</div>${(data.log||[]).map(l=>`<div class="text-xs mt-0.5 ${l.ok?'text-slate-400':'text-rose-400'}">${l.msg}</div>`).join('')}`;
        showToast(`Enrolled ${data.enrolled} student(s)!`, 'success'); loadClasses();
    } else { log.innerHTML = `<div class="text-rose-400">❌ ${data.message}</div>`; showToast(data.message || 'Enrollment failed.', 'error'); }
}

function downloadAcademicTemplate(type) {
    window.location.href = `/admin/am/bulk-template?type=${type}`;
}
</script>
<!-- ═══════════════════════════════════════════════════════
     NOTIFICATION PANEL — Reusable across all admin pages
     Fetches from GET /admin/notifications on open.
═══════════════════════════════════════════════════════ -->

<!-- Backdrop -->
<div id="notifBackdrop" class="fixed inset-0 z-[998] hidden" onclick="closeNotifPanel()"></div>

<!-- Slide-in Panel -->
<div id="notifPanel"
     class="fixed top-0 right-0 h-full w-full max-w-sm z-[999] flex flex-col
            bg-white border-l border-cyan-100 shadow-2xl
            transform translate-x-full transition-transform duration-300 ease-in-out">

    <!-- Panel Header -->
    <div class="flex items-center justify-between px-5 py-4 border-b border-cyan-100 bg-gradient-to-r from-indigo-950 to-indigo-900 flex-shrink-0">
        <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center">
                <i class="fas fa-bell text-cyan-400"></i>
            </div>
            <div>
                <p class="text-sm font-black text-white tracking-tight">Notifications</p>
                <p class="text-[10px] text-indigo-400 font-semibold" id="notifSubtitle">Loading…</p>
            </div>
        </div>
        <button onclick="closeNotifPanel()" class="w-8 h-8 rounded-lg bg-white/10 hover:bg-white/20 flex items-center justify-center text-white transition">
            <i class="fas fa-times text-sm"></i>
        </button>
    </div>

    <!-- Category Tabs -->
    <div class="flex gap-0 border-b border-cyan-100 overflow-x-auto flex-shrink-0 bg-slate-50" id="notifTabs">
        <button class="notif-tab active px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-cyan-500 text-cyan-600 transition" data-tab="all">All</button>
        <button class="notif-tab px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition" data-tab="alerts">Alerts</button>
        <button class="notif-tab px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition" data-tab="activity">Activity</button>
        <button class="notif-tab px-4 py-2.5 text-[11px] font-black uppercase tracking-wider whitespace-nowrap border-b-2 border-transparent text-slate-400 hover:text-slate-600 transition" data-tab="live">Live</button>
    </div>

    <!-- Scrollable Body -->
    <div id="notifBody" class="flex-1 overflow-y-auto p-4 space-y-3" style="scrollbar-width:thin;scrollbar-color:#e2e8f0 transparent;">
        <!-- Skeleton loader -->
        <div id="notifSkeleton" class="space-y-3">
            <% for(let i=0;i<5;i++) { %>
            <div class="animate-pulse flex gap-3 items-start">
                <div class="w-8 h-8 rounded-lg bg-slate-200 flex-shrink-0"></div>
                <div class="flex-1 space-y-1.5">
                    <div class="h-3 bg-slate-200 rounded w-3/4"></div>
                    <div class="h-2.5 bg-slate-100 rounded w-1/2"></div>
                </div>
            </div>
            <% } %>
        </div>
        <!-- Actual content injected by JS -->
        <div id="notifContent" class="hidden space-y-3"></div>
    </div>

    <!-- Panel Footer -->
    <div class="px-5 py-3 border-t border-cyan-100 bg-slate-50 flex items-center justify-between flex-shrink-0">
        <p class="text-[10px] text-slate-400 font-semibold">Auto-refreshes every 60s</p>
        <button onclick="loadNotifications()" class="text-[11px] font-black text-cyan-600 hover:text-cyan-800 flex items-center gap-1 transition">
            <i class="fas fa-rotate-right text-[10px]"></i> Refresh
        </button>
    </div>
</div>

<style>
    .notif-tab.active { border-bottom-color: #06b6d4 !important; color: #0891b2 !important; }
    .notif-item { background: white; border: 1px solid #e2e8f0; border-radius: 12px; padding: 10px 12px; display: flex; gap: 10px; align-items: flex-start; transition: border-color 0.15s, box-shadow 0.15s; }
    .notif-item:hover { border-color: #06b6d4; box-shadow: 0 4px 12px rgba(6,182,212,0.08); }
    .notif-icon { width: 32px; height: 32px; border-radius: 9px; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 13px; }
    .notif-title { font-size: 12px; font-weight: 700; color: #1e293b; line-height: 1.35; }
    .notif-sub { font-size: 10.5px; color: #64748b; margin-top: 1px; }
    .notif-time { font-size: 10px; color: #94a3b8; white-space: nowrap; margin-left: auto; padding-left: 6px; flex-shrink: 0; }
    .notif-section-label { font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: .07em; color: #94a3b8; padding: 4px 0 6px; }
    .notif-link { font-size: 10.5px; color: #06b6d4; font-weight: 700; text-decoration: none; cursor: pointer; }
    .notif-link:hover { color: #0891b2; }
</style>

<script>
(function() {
    let _notifData   = null;
    let _activeTab   = 'all';
    let _refreshTimer = null;

    function timeAgo(dateStr) {
        if (!dateStr) return '';
        const diff = (Date.now() - new Date(dateStr)) / 1000;
        if (diff < 60)   return 'just now';
        if (diff < 3600) return Math.floor(diff/60) + 'm ago';
        if (diff < 86400) return Math.floor(diff/3600) + 'h ago';
        return Math.floor(diff/86400) + 'd ago';
    }

    function fmtDate(dateStr) {
        if (!dateStr) return '—';
        return new Date(dateStr).toLocaleDateString('en-PH', { month:'short', day:'numeric', year:'numeric' });
    }

    window.toggleNotifPanel = function() {
        const panel    = document.getElementById('notifPanel');
        const backdrop = document.getElementById('notifBackdrop');
        const isOpen   = !panel.classList.contains('translate-x-full');
        if (isOpen) { closeNotifPanel(); return; }
        panel.classList.remove('translate-x-full');
        backdrop.classList.remove('hidden');
        document.body.style.overflow = 'hidden';
        loadNotifications();
        _refreshTimer = setInterval(loadNotifications, 60000);
    };

    window.closeNotifPanel = function() {
        document.getElementById('notifPanel').classList.add('translate-x-full');
        document.getElementById('notifBackdrop').classList.add('hidden');
        document.body.style.overflow = '';
        clearInterval(_refreshTimer);
    };

    window.loadNotifications = async function() {
        document.getElementById('notifSkeleton').classList.remove('hidden');
        document.getElementById('notifContent').classList.add('hidden');
        try {
            const res  = await fetch('/admin/notifications');
            const data = await res.json();
            if (!data.success) throw new Error(data.message);
            _notifData = data;
            updateBell(data.total);
            renderTab(_activeTab);
        } catch(e) {
            document.getElementById('notifContent').innerHTML =
                '<div class="py-10 text-center text-slate-400 text-xs">Failed to load notifications.</div>';
            document.getElementById('notifContent').classList.remove('hidden');
            document.getElementById('notifSkeleton').classList.add('hidden');
        }
    };

    function updateBell(count) {
        const dot   = document.getElementById('notifDot');
        const badge = document.getElementById('notifCount');
        if (count > 0) {
            dot.classList.remove('hidden');
            badge.textContent = count > 9 ? '9+' : count;
            badge.classList.remove('hidden');
        } else {
            dot.classList.add('hidden');
            badge.classList.add('hidden');
        }
        document.getElementById('notifSubtitle').textContent =
            count > 0 ? count + ' item' + (count !== 1 ? 's' : '') + ' need attention' : 'All clear';
    }

    function renderTab(tab) {
        _activeTab = tab;
        const d = _notifData;
        if (!d) return;

        let html = '';

        // ── ALL tab ──
        if (tab === 'all' || tab === 'alerts') {
            const alertItems = [
                ...d.expiredInvites.map(i => ({
                    icon: 'fas fa-envelope-circle-check', iconBg: 'bg-rose-50', iconColor: 'text-rose-500',
                    title: 'Expired Invitation',
                    sub: i.email + ' · ' + (i.role || 'Unknown role'),
                    time: fmtDate(i.expires_at),
                    link: '/admin/user_access_control', linkLabel: 'View UAC'
                })),
                ...d.flaggedStudents.map(s => ({
                    icon: 'fas fa-flag', iconBg: 'bg-amber-50', iconColor: 'text-amber-500',
                    title: 'Flagged Student',
                    sub: s.full_name + (s.assessment_name ? ' · ' + s.assessment_name : ''),
                    time: '',
                    link: '/admin/user_access_control', linkLabel: 'View Student'
                })),
                ...d.lockedPastDue.map(a => ({
                    icon: 'fas fa-lock', iconBg: 'bg-orange-50', iconColor: 'text-orange-500',
                    title: 'Assessment Past Due & Locked',
                    sub: a.assessment_name + ' · ' + (a.subject_name || ''),
                    time: fmtDate(a.due_date),
                    link: '/admin/gaming_question_bank', linkLabel: 'Manage'
                })),
                ...d.overdueDeadlines.map(e => ({
                    icon: 'fas fa-calendar-xmark', iconBg: 'bg-red-50', iconColor: 'text-red-500',
                    title: 'Overdue Deadline',
                    sub: e.event_title + (e.subject_name ? ' · ' + e.subject_name : ''),
                    time: fmtDate(e.event_date),
                    link: '/admin/academic_management', linkLabel: 'View'
                })),
                ...d.pendingQuestions.map(q => ({
                    icon: 'fas fa-robot', iconBg: 'bg-indigo-50', iconColor: 'text-indigo-500',
                    title: 'AI Question Awaiting Approval',
                    sub: q.question_text.substring(0, 55) + (q.question_text.length > 55 ? '…' : ''),
                    time: timeAgo(q.created_at),
                    link: '/admin/gaming_question_bank', linkLabel: 'Review'
                })),
            ];

            if (tab === 'alerts' || tab === 'all') {
                if (alertItems.length === 0) {
                    if (tab === 'alerts') html += emptyState('fa-shield-halved', 'No alerts', 'Everything looks good!');
                } else {
                    if (tab === 'all') html += '<div class="notif-section-label"><i class="fas fa-triangle-exclamation mr-1 text-rose-400"></i>Alerts Requiring Action</div>';
                    alertItems.forEach(item => { html += notifItem(item); });
                }
            }
        }

        // ── ACTIVITY tab (pending & new users) ──
        if (tab === 'activity' || tab === 'all') {
            const actItems = [
                ...d.pendingInvites.map(i => ({
                    icon: 'fas fa-paper-plane', iconBg: 'bg-cyan-50', iconColor: 'text-cyan-500',
                    title: 'Pending Invitation',
                    sub: i.email + ' · ' + (i.role || ''),
                    time: timeAgo(i.created_at),
                    link: '/admin/user_access_control', linkLabel: 'View'
                })),
                ...d.newUsers.map(u => ({
                    icon: 'fas fa-user-plus', iconBg: 'bg-emerald-50', iconColor: 'text-emerald-500',
                    title: 'New ' + u.role + ' Registered',
                    sub: u.full_name,
                    time: timeAgo(u.created_at),
                    link: '/admin/user_access_control', linkLabel: 'View Profile'
                })),
            ];

            if (tab === 'activity') {
                if (actItems.length === 0) html += emptyState('fa-clock-rotate-left', 'No recent activity', 'No new users or pending invites.');
                else actItems.forEach(item => { html += notifItem(item); });
            } else if (tab === 'all' && actItems.length > 0) {
                html += '<div class="notif-section-label mt-2"><i class="fas fa-bolt mr-1 text-cyan-400"></i>Recent Activity</div>';
                actItems.forEach(item => { html += notifItem(item); });
            }
        }

        // ── LIVE tab (active sessions) ──
        if (tab === 'live' || tab === 'all') {
            if (tab === 'live') {
                if (d.activeSessions.length === 0) {
                    html += emptyState('fa-gamepad', 'No live sessions', 'No students are playing right now.');
                } else {
                    d.activeSessions.forEach(s => {
                        html += notifItem({
                            icon: 'fas fa-gamepad', iconBg: 'bg-violet-50', iconColor: 'text-violet-500',
                            title: s.student_name + ' is playing',
                            sub: s.assessment_name + ' · ' + s.player_mode,
                            time: timeAgo(s.start_time),
                            link: null
                        });
                    });
                }
            } else if (tab === 'all' && d.activeSessions.length > 0) {
                html += '<div class="notif-section-label mt-2"><i class="fas fa-circle text-green-400 mr-1"></i>Live Sessions (' + d.activeSessions.length + ')</div>';
                d.activeSessions.slice(0, 3).forEach(s => {
                    html += notifItem({
                        icon: 'fas fa-gamepad', iconBg: 'bg-violet-50', iconColor: 'text-violet-500',
                        title: s.student_name + ' is playing',
                        sub: s.assessment_name + ' · ' + s.player_mode,
                        time: timeAgo(s.start_time),
                        link: null
                    });
                });
            }
        }

        if (tab === 'all' && html === '') {
            html = emptyState('fa-bell-slash', 'All clear!', 'No alerts or pending items.');
        }

        document.getElementById('notifContent').innerHTML = html;
        document.getElementById('notifContent').classList.remove('hidden');
        document.getElementById('notifSkeleton').classList.add('hidden');
    }

    function notifItem(item) {
        return '<div class="notif-item">' +
            '<div class="notif-icon ' + item.iconBg + ' ' + item.iconColor + '">' +
                '<i class="' + item.icon + '"></i>' +
            '</div>' +
            '<div class="flex-1 min-w-0">' +
                '<p class="notif-title">' + item.title + '</p>' +
                '<p class="notif-sub truncate">' + item.sub + '</p>' +
                (item.link ? '<a href="' + item.link + '" class="notif-link">' + item.linkLabel + ' →</a>' : '') +
            '</div>' +
            (item.time ? '<span class="notif-time">' + item.time + '</span>' : '') +
        '</div>';
    }

    function emptyState(icon, title, sub) {
        return '<div class="py-10 text-center">' +
            '<i class="fas ' + icon + ' text-3xl text-slate-200 mb-3 block"></i>' +
            '<p class="text-sm font-bold text-slate-400">' + title + '</p>' +
            '<p class="text-xs text-slate-300 mt-1">' + sub + '</p>' +
        '</div>';
    }

    // Tab switching
    document.addEventListener('DOMContentLoaded', function() {
        document.querySelectorAll('.notif-tab').forEach(function(btn) {
            btn.addEventListener('click', function() {
                document.querySelectorAll('.notif-tab').forEach(function(b) { b.classList.remove('active'); });
                btn.classList.add('active');
                renderTab(btn.dataset.tab);
            });
        });

        // Auto-poll bell count every 2 minutes even when panel is closed
        setInterval(async function() {
            try {
                const res  = await fetch('/admin/notifications');
                const data = await res.json();
                if (data.success) updateBell(data.total);
            } catch(_) {}
        }, 120000);
    });
})();
</script>

