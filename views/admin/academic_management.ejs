                ═══════════════════════════════════ -->
                <div id="drillPanel" class="hidden">

                    <!-- Drill Header -->
                    <div class="glass-card rounded-2xl border border-indigo-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between flex-wrap gap-3">
