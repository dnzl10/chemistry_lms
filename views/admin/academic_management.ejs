async function loadQuarters() {
    window.loadQuarters = loadQuarters;
    if (!activeDrillSubjectId) return;
    const container = document.getElementById('quartersContainer');
    container.innerHTML = `<div class="text-center py-8"><i class="fas fa-spinner fa-spin text-indigo-300 text-2xl"></i></div>`;
    try {
        const curSyId = (typeof window.getAdminCurrentSY === 'function' ? window.getAdminCurrentSY() : null) || new URLSearchParams(window.location.search).get('sy_id');
        const syParam = curSyId ? `?sy_id=${encodeURIComponent(curSyId)}` : '';
        const res  = await fetch(`/admin/am/subjects/${activeDrillSubjectId}/quarters${syParam}`);
        const data = await res.json();
        if (!data.success) { container.innerHTML = `<p class="text-rose-500 text-sm">${data.message}</p>`; return; }
        const quarters = data.quarters;
        if (quarters.length === 0) {
            container.innerHTML = `<div class="text-center py-10 text-slate-400"><i class="fas fa-layer-group text-3xl mb-2 block opacity-30"></i><p class="font-bold text-sm">No quarters yet. Add the first one.</p></div>`;
            return;
        }
        container.innerHTML = quarters.map(q => `
            <div class="border border-slate-100 rounded-2xl overflow-hidden mb-4">
                <div class="flex items-center justify-between p-4 bg-gradient-to-r from-indigo-50 to-cyan-50">
                    <div class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-indigo-500 text-white flex items-center justify-center font-black text-sm">Q${q.quarter_number}</div>
                        <span class="font-black text-slate-800">Quarter ${q.quarter_number}</span>
                        <span class="badge ${q.is_locked ? 'badge-locked' : 'badge-unlocked'}">${q.is_locked ? 'Locked' : 'Unlocked'}</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <button class="btn-icon ${q.is_locked ? 'btn-unlock' : 'btn-lock'}" title="${q.is_locked ? 'Unlock' : 'Lock'}" onclick="toggleQuarterLock(${q.quarter_id}, ${q.is_locked})">
                            <i class="fas ${q.is_locked ? 'fa-lock-open' : 'fa-lock'}"></i>
                        </button>
                        <button class="btn-icon btn-add" title="Add Topic" onclick="openAddTopic(${q.quarter_id})">
                            <i class="fas fa-plus"></i>
                        </button>
                        <button class="btn-icon btn-delete" title="Delete Quarter" onclick="confirmDeleteQuarter(${q.quarter_id}, ${q.quarter_number})">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
                <div class="p-4 space-y-2" id="topics-${q.quarter_id}">
                    ${(q.topics || []).length === 0
                        ? `<p class="text-xs text-slate-400 text-center py-3">No topics. Add one above.</p>`
                        : (q.topics || []).map(t => `
                            <div class="topic-row flex items-center justify-between p-3 bg-white rounded-xl border border-slate-100 gap-2"
                                data-topic-id="${t.topic_id}"
                                data-is-locked="${t.is_locked ? '1' : '0'}"
                                data-auto-unlock-at="${t.auto_unlock_at || ''}"
                                data-auto-lock-at="${t.auto_lock_at || ''}">
                                <div class="flex items-center gap-2.5 flex-wrap min-w-0">
                                    <span class="badge ${t.is_locked ? 'badge-locked' : 'badge-unlocked'} text-[9px]">${t.is_locked ? '🔒' : '🔓'}</span>
                                    <span class="text-sm font-bold text-slate-700 break-words">${escapeHtml(t.topic_name)}</span>
                                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200">
                                        <i class="fas fa-folder-open mr-0.5"></i>${(t.materials || []).length} ${(t.materials || []).length === 1 ? 'Material' : 'Materials'}
                                    </span>
                                    ${t.auto_unlock_at ? `
                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200" title="Scheduled Auto-Unlock">
                                            <i class="fas fa-clock mr-0.5"></i>Unlocks: ${new Date(t.auto_unlock_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
                                        </span>
                                    ` : ''}
                                    ${t.auto_lock_at ? `
                                        <span class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 border border-rose-200" title="Scheduled Auto-Lock">
                                            <i class="fas fa-hourglass-end mr-0.5"></i>Locks: ${new Date(t.auto_lock_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' })}
                                        </span>
                                    ` : ''}
                                </div>
                                <div class="flex items-center gap-1 flex-shrink-0">
                                    <button class="btn-icon ${t.is_locked ? 'btn-unlock' : 'btn-lock'}" onclick="toggleTopicLock(${t.topic_id}, ${t.is_locked})">
                                        <i class="fas ${t.is_locked ? 'fa-lock-open' : 'fa-lock'}"></i>
