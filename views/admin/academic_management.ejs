<!-- ALL / PAST SCHOOL YEARS MODAL -->
<div id="modalAllSY" class="modal-overlay">
    <div class="modal-box max-w-lg w-full p-0 overflow-hidden rounded-2xl shadow-xl">
        <div class="flex items-center justify-between p-6 border-b border-slate-100 bg-white">
            <div>
                <h3 class="font-black text-indigo-900 text-lg">All School Years</h3>
                <p class="text-xs text-slate-400 mt-0.5">Full institutional archive sorted latest to oldest</p>
            </div>
            <button onclick="closeModal('modalAllSY')" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-rose-100 text-slate-500 hover:text-rose-600 transition flex items-center justify-center">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-6 space-y-2.5 max-h-[60vh] overflow-y-auto bg-slate-50">
            <% if (typeof pastSchoolYears !== 'undefined') { %>
            <% pastSchoolYears.forEach(function(sy) { %>
            <div class="flex items-center justify-between p-3 rounded-xl border border-slate-200 bg-white shadow-xs">
                <div class="flex items-center gap-2">
                    <% if (sy.status === 'Current' || sy.is_active) { %>
                    <span class="badge badge-active flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>Current</span>
                    <% } else if (sy.status === 'Draft') { %>
                    <span class="badge" style="background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;">Draft</span>
                    <% } else { %>
                    <span class="badge badge-inactive">Archive</span>
                    <% } %>
                    <span class="text-sm font-bold text-slate-700"><%= sy.sy_range %></span>
                    <% if (sy.sy_code) { %><span class="text-[10px] font-mono text-indigo-600 font-bold bg-indigo-50 px-1.5 py-0.5 rounded"><%= sy.sy_code %></span><% } %>
                    <span class="text-[10px] text-slate-400">
                        Added <%= new Date(sy.created_at).toLocaleDateString('en-PH', {year:'numeric', month:'short', day:'numeric'}) %>
                    </span>
                </div>
                <div class="flex items-center gap-1">
                    <% if (!sy.is_active) { %>
                    <button class="btn-icon btn-unlock" title="Activate this SY"
                        onclick="confirmActivateSY(<%= sy.sy_id %>, '<%= sy.sy_range %>')">
                        <i class="fas fa-toggle-off"></i>
                    </button>
                    <% } else { %>
                    <button class="btn-icon" style="cursor:default;opacity:0.4;" title="Currently active" disabled>
                        <i class="fas fa-toggle-on text-emerald-500"></i>
                    </button>
                    <% } %>
                    <button class="btn-icon btn-edit" title="Edit SY"
                        onclick="openEditSY(<%= JSON.stringify(sy) %>)">
                        <i class="fas fa-pen"></i>
                    </button>
                    <% if (!sy.is_active) { %>
                    <button class="btn-icon btn-delete" title="Delete SY"
                        onclick="confirmDeleteSY(<%= sy.sy_id %>, '<%= sy.sy_range %>')">
                        <i class="fas fa-trash"></i>
                    </button>
                    <% } %>
                </div>
            </div>
            <% }) %>
            <% } %>
        </div>
    </div>
</div>

<!-- STUDENT COHORT LIFECYCLE MANAGEMENT MODAL -->
<div id="modalStudentLifecycle" class="modal-overlay">
    <div class="modal-box p-0 max-w-2xl w-full flex flex-col max-h-[92vh] overflow-hidden rounded-3xl shadow-2xl">
