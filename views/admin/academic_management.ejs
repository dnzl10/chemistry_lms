function handleQuarterTopicVideoPreview(idx) {
    const card = document.querySelector(`.quarter-topic-card[data-index="${idx}"]`);
    if (!card) return;
    const input = card.querySelector('.q-topic-video');
    const clearBtn = card.querySelector('.q-topic-video-clear');
    const container = document.getElementById(`qTopicPreview_${idx}`);
    const badge = document.getElementById(`qTopicBadge_${idx}`);
    const wrapper = document.getElementById(`qTopicWrapper_${idx}`);
    if (!input || !container || !wrapper) return;

    const val = input.value.trim();
    if (clearBtn) {
        if (val) clearBtn.classList.remove('hidden');
        else clearBtn.classList.add('hidden');
    }

    if (!val) {
        container.classList.add('hidden');
        wrapper.innerHTML = '';
        return;
    }

    const info = parseVideoEmbedInfo(val);
    if (!info) {
        container.classList.remove('hidden');
        if (badge) {
            badge.className = 'text-[11px] text-amber-600 bg-amber-50 px-2 py-0.5 rounded-md border border-amber-200 font-semibold flex items-center gap-1';
            badge.innerHTML = '<i class="fas fa-exclamation-circle"></i> Invalid URL';
        }
        wrapper.innerHTML = `
            <div class="text-center p-4 text-slate-400">
                <i class="fas fa-video-slash text-2xl text-slate-300 mb-1 block"></i>
                <p class="text-xs font-semibold text-slate-500">Unrecognized video URL</p>
                <p class="text-[10px] text-slate-400 mt-0.5">Please provide a valid YouTube, Vimeo, or direct video (.mp4) link.</p>
            </div>
        `;
        return;
    }

    container.classList.remove('hidden');
    if (badge) {
        badge.className = 'text-[11px] text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-md border border-emerald-200 font-semibold flex items-center gap-1';
        badge.innerHTML = `<i class="fas fa-check-circle"></i> ${info.platform} Ready`;
    }

    if (info.type === 'iframe') {
        wrapper.innerHTML = `
            <iframe src="${info.src}" class="w-full h-full border-0 rounded-lg" 
                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" 
                allowfullscreen referrerpolicy="strict-origin-when-cross-origin"></iframe>
        `;
    } else if (info.type === 'video') {
        wrapper.innerHTML = `
            <video src="${info.src}" controls class="w-full h-full object-contain rounded-lg bg-black">
                Your browser does not support the video tag.
            </video>
        `;
    } else {
        wrapper.innerHTML = `
            <iframe src="${info.src}" class="w-full h-full border-0 rounded-lg" allowfullscreen sandbox="allow-scripts allow-same-origin allow-presentation"></iframe>
        `;
    }
}

