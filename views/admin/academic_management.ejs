                            <label class="block text-[10px] font-bold text-slate-500 mb-1 uppercase">Enrollment Closes</label>
                            <input type="datetime-local" id="addSem2EnrollEnd" name="sem2_enrollment_end" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white">
                        </div>
                    </div>
                </div>

                <!-- Prerequisite Enforcement Section -->
                <div class="bg-white rounded-2xl p-5 border border-slate-200 space-y-4 shadow-sm">
                    <div class="flex items-center justify-between pb-3 border-b border-slate-100">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-shield-halved text-indigo-600 text-lg"></i>
