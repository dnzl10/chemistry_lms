                        <option value="2">Semester 2</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">Course Access Code (Institutional Placement)</label>
                    <input type="text" name="enrollment_code" readonly placeholder="N/A (Managed via Admin Roster Enrollment)"
                        class="search-input w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm bg-slate-50 font-mono text-slate-500 cursor-not-allowed">
                    <p class="text-[10px] text-slate-400 mt-1">Direct student code self-enrollment has been decommissioned. Section placements are managed centrally by Admin.</p>
