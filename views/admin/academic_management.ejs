function isAddQuarterDirty() {
    syncQuarterTopicsFromDOM();
    if (quarterTopicsList.length > 1) return true;
    const t = quarterTopicsList[0];
    if (!t) return false;
    return !!(
        (t.topic_name && t.topic_name.trim()) ||
        (t.topic_description && t.topic_description.trim()) ||
        (t.topic_objectives && t.topic_objectives.trim()) ||
        (t.video_url && t.video_url.trim())
    );
}

async function requestCloseAddQuarter() {
    if (isAddQuarterDirty()) {
        const result = await Swal.fire({
            title: 'Discard unsaved changes?',
            text: 'You have unsaved quarter and topic details. If you exit now, your entered information will be lost.',
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#ef4444',
            cancelButtonColor: '#64748b',
            confirmButtonText: '<i class="fas fa-trash-can mr-1"></i> Discard and Exit',
            cancelButtonText: 'Stay and Continue Editing',
            reverseButtons: true,
            focusCancel: true
        });
        if (result.isConfirmed) {
            forceCloseAddQuarter();
        }
    } else {
        forceCloseAddQuarter();
    }
}

function forceCloseAddQuarter() {
    closeModal('modalAddQuarter');
    const form = document.getElementById('addQuarterForm');
    if (form) form.reset();
    quarterTopicsList = [];
    const container = document.getElementById('quarterTopicsContainer');
    if (container) container.innerHTML = '';
}

async function handleQuarterSubmitAttempt(e) {
    if (e) e.preventDefault();
    syncQuarterTopicsFromDOM();

    if (!quarterTopicsList || quarterTopicsList.length === 0) {
        showToast('Please add at least one topic for this quarter.', 'error');
        return;
    }

    for (let i = 0; i < quarterTopicsList.length; i++) {
        const t = quarterTopicsList[i];
        const num = i + 1;
        const card = document.querySelector(`.quarter-topic-card[data-index="${i}"]`);

        if (!t.topic_name || !t.topic_name.trim()) {
            showToast(`Topic #${num} is missing a Topic Name.`, 'error');
            if (card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                card.querySelector('.q-topic-name')?.focus();
            }
            return;
        }
        if (!t.topic_description || !t.topic_description.trim()) {
            showToast(`Topic #${num} is missing a Topic Description.`, 'error');
            if (card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                card.querySelector('.q-topic-desc')?.focus();
            }
            return;
        }
        if (!t.topic_objectives || !t.topic_objectives.trim()) {
            showToast(`Topic #${num} is missing Objectives.`, 'error');
            if (card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                card.querySelector('.q-topic-obj')?.focus();
            }
            return;
        }
        if (!t.video_url || !t.video_url.trim()) {
            showToast(`Topic #${num} is missing a Video URL.`, 'error');
            if (card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                card.querySelector('.q-topic-video')?.focus();
            }
            return;
        }
        const parsed = parseVideoEmbedInfo(t.video_url.trim());
        if (!parsed) {
            showToast(`Topic #${num} has an invalid or unrecognized video URL.`, 'error');
            if (card) {
                card.scrollIntoView({ behavior: 'smooth', block: 'center' });
                card.querySelector('.q-topic-video')?.focus();
            }
            return;
        }
    }

    const quarterNum = document.getElementById('addQuarterNumber').value;
    const topicCount = quarterTopicsList.length;

    const confirmSave = await Swal.fire({
        title: `Save Quarter ${quarterNum}?`,
        html: `You are about to create <b>Quarter ${quarterNum}</b> with <b>${topicCount} topic${topicCount > 1 ? 's' : ''}</b>.<br><span class="text-xs text-slate-500 mt-1 inline-block">These topics will be immediately assigned to this quarter.</span>`,
        icon: 'question',
        showCancelButton: true,
        confirmButtonColor: '#4f46e5',
        cancelButtonColor: '#64748b',
        confirmButtonText: '<i class="fas fa-check mr-1"></i> Yes, Save Quarter',
        cancelButtonText: 'Review Again',
        reverseButtons: true,
        focusConfirm: true
    });

    if (!confirmSave.isConfirmed) return;

    try {
        const payload = {
            quarter_number: parseInt(quarterNum, 10),
            topics: quarterTopicsList.map(t => ({
                topic_name: t.topic_name.trim(),
                topic_description: t.topic_description.trim(),
                topic_objectives: t.topic_objectives.trim(),
                video_url: t.video_url.trim()
            }))
        };

        const res = await fetch(`/admin/am/subjects/${activeDrillSubjectId}/quarters`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();

        if (data.success) {
            showToast(data.message || `Quarter ${quarterNum} created with ${topicCount} topic(s)!`, 'success');
            forceCloseAddQuarter();
            loadQuarters();
        } else {
            Swal.fire({
                icon: 'error',
                title: 'Creation Failed',
                text: data.message || 'Unable to create quarter and topics. Please try again.',
                confirmButtonColor: '#4f46e5'
            });
        }
    } catch (err) {
        console.error('Error saving quarter and topics:', err);
        showToast('Network or server error while creating quarter.', 'error');
    }
}

