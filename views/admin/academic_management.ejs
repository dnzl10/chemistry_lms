// ─── SY Input Validator (client-side preview) ─────────────────────────────
function validateSYInput(input) {
    const errorEl = document.getElementById('addSYError');
    const val     = input.value.trim();
    const currentYear = new Date().getFullYear();

    // Clear if empty
    if (!val) { errorEl.classList.add('hidden'); errorEl.textContent = ''; return; }

    // Block non-numeric characters (allow only digits and dash)
    if (/[^0-9\-]/.test(val)) {
        errorEl.textContent = '⛔ Letters and special characters are not allowed. Numbers only.';
        errorEl.classList.remove('hidden'); return;
    }

    // Once full length, do deep checks
    if (val.length === 9) {
        const match = val.match(/^(\d{4})-(\d{4})$/);
        if (!match) { errorEl.textContent = '⛔ Format must be YYYY-YYYY (e.g. 2026-2027).'; errorEl.classList.remove('hidden'); return; }

        const start = parseInt(match[1]);
        const end   = parseInt(match[2]);

        if (end !== start + 1) {
            errorEl.textContent = `⛔ End year must be exactly one year after start year.`;
            errorEl.classList.remove('hidden'); return;
        }
        if (start < currentYear) {
            errorEl.textContent = `⛔ "${val}" is a past school year. You cannot add past SYs.`;
            errorEl.classList.remove('hidden'); return;
        }
        if (start > currentYear) {
            errorEl.textContent = `⛔ You can only add the current SY: ${currentYear}-${currentYear + 1}.`;
            errorEl.classList.remove('hidden'); return;
        }

        // All good
        errorEl.textContent = `✅ Valid school year!`;
        errorEl.classList.remove('hidden');
        errorEl.style.color = '#16a34a';
        return;
    }

    errorEl.classList.add('hidden');
    errorEl.style.color = '';
}

