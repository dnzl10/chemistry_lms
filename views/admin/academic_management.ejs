    else showToast(data.message || 'Failed.', 'error');
}

function confirmDeleteMapping(mappingId) {
    showConfirm({
        icon:'fa-trash', iconBg:'bg-rose-100', iconColor:'text-rose-600',
        title:'Delete this mapping?',
        desc:'The hardware button mapping will be permanently removed.',
        btnLabel:'Delete', btnColor:'bg-rose-500',
        onConfirm: async () => {
            const data = await apiDelete(`/admin/am/button-mappings/${mappingId}`);
            closeModal('modalConfirm');
            if (data.success) { showToast('Deleted.', 'success'); loadMappings(); }
            else showToast(data.message || 'Failed.', 'error');
