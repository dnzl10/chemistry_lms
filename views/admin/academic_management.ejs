                        <label class="flex items-start gap-3 cursor-pointer p-3 rounded-xl bg-white border border-slate-200 hover:border-emerald-300 transition">
                            <input type="checkbox" id="addRolloverMaterials" name="rollover_materials" value="1" disabled class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300 mt-0.5">
                            <div>
                                <span class="text-xs font-bold text-slate-800 block">Retain Learning Materials / Handouts <span class="text-[10px] text-emerald-600 font-bold bg-emerald-50 px-2 py-0.2 rounded-full ml-1">Recommended</span></span>
                                <span class="text-[11px] text-slate-500 leading-snug block">Keeps lecture slides, module files, reading PDFs, and reference links accessible for Chemistry 1 &amp; 2.</span>
                            </div>
                        </label>

                        <label class="flex items-start gap-3 cursor-pointer p-3 rounded-xl bg-white border border-slate-200 hover:border-emerald-300 transition">
                            <input type="checkbox" id="addRolloverAssessments" name="rollover_assessments" value="1" disabled class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 mt-0.5">
                            <div>
                                <span class="text-xs font-bold text-slate-800 block">Retain Assessments &amp; Quizzes <span class="text-[10px] text-slate-400 font-bold bg-slate-100 px-2 py-0.2 rounded-full ml-1">Disabled by default</span></span>
                                <span class="text-[11px] text-slate-500 leading-snug block">Kept unchecked to exclude previous exams, student submissions, and scores so assessment rosters remain clean.</span>
                            </div>
                        </label>

                        <label class="flex items-start gap-3 cursor-pointer p-3 rounded-xl bg-white border border-slate-200 hover:border-emerald-300 transition">
                            <input type="checkbox" id="addRolloverQB" name="rollover_question_bank" value="1" disabled class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500 border-slate-300 mt-0.5">
                            <div>
                                <span class="text-xs font-bold text-slate-800 block">Retain Question Bank as Drafts <span class="text-[10px] text-indigo-600 font-bold bg-indigo-50 px-2 py-0.2 rounded-full ml-1">Optional</span></span>
                                <span class="text-[11px] text-slate-500 leading-snug block">Copies questions into internal question banks so instructors can easily pull items when building new quizzes.</span>
                            </div>
