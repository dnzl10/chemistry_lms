function confirmDeleteMatch(matchId) {
    showConfirm({
        icon:'fa-trash', iconBg:'bg-rose-100', iconColor:'text-rose-600',
        title:'Delete this match record?',
        desc:'This competitive match record will be permanently removed.',
        btnLabel:'Delete', btnColor:'bg-rose-500',
        onConfirm: async () => {
            const data = await apiDelete(`/admin/am/matches/${matchId}`);
            closeModal('modalConfirm');
            if (data.success) { showToast('Match deleted.', 'success'); loadMatches(); }
            else showToast(data.message || 'Failed.', 'error');
        }
