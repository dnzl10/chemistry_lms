                    <i class="fas fa-edit"></i>
                </div>
                <div>
                    <h3 class="font-black text-white text-lg leading-tight" id="editSYModalTitle">Edit School Year</h3>
                    <p class="text-xs text-indigo-200" id="editSYModalSubtitle">Update institutional timeline, quarterly dates, and prerequisite policies</p>
                </div>
            </div>
            <button onclick="closeModal('modalEditSY')" class="w-9 h-9 rounded-xl bg-white/10 hover:bg-rose-500/80 text-white/80 hover:text-white transition flex items-center justify-center">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- 3-Step Tab Navigation Bar for Editing -->
        <div class="bg-slate-50 border-b border-slate-200 px-6 py-2.5 flex items-center justify-between gap-2 overflow-x-auto shrink-0">
            <button type="button" onclick="switchEditSYTab(1)" id="tabEditBtn1" class="edit-sy-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-black transition text-indigo-700 bg-white shadow-sm border border-slate-200">
                <span class="w-5 h-5 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px]">1</span>
                <span>General Details</span>
