                            <option value="">-- No Rollover (Start Completely Fresh) --</option>
                            <% if (typeof pastSchoolYears !== 'undefined') { %>
                            <% pastSchoolYears.forEach(function(sy) { %>
                                <option value="<%= sy.sy_id %>"><%= sy.sy_range %> <% if (sy.sy_code) { %>(<%= sy.sy_code %>)<% } %> <% if (sy.status === 'Current' || sy.is_active) { %>[Current Active]<% } else if (sy.status === 'Draft') { %>[Draft]<% } else { %>[Archive]<% } %></option>
                            <% }) %>
                            <% } %>
