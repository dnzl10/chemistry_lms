// ─── Add Quarter with Topics State & Functions ──────────────────────────────
let quarterTopicsList = [];

function escapeHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

function initQuarterTopics() {
    quarterTopicsList = [
        { topic_name: '', topic_description: '', topic_objectives: '', video_url: '' }
    ];
    renderQuarterTopicsCards();
}

function openAddQuarter() {
    document.getElementById('addQuarterSubjectId').value = activeDrillSubjectId;
    const numSel = document.getElementById('addQuarterNumber');
    if (numSel) numSel.value = '1';
    initQuarterTopics();
    openModal('modalAddQuarter');
}

function syncQuarterTopicsFromDOM() {
    const cards = document.querySelectorAll('.quarter-topic-card');
    if (cards.length > 0) {
        quarterTopicsList = Array.from(cards).map(card => ({
            topic_name: card.querySelector('.q-topic-name')?.value || '',
            topic_description: card.querySelector('.q-topic-desc')?.value || '',
            topic_objectives: card.querySelector('.q-topic-obj')?.value || '',
            video_url: card.querySelector('.q-topic-video')?.value || ''
        }));
    }
    if (quarterTopicsList.length === 0) {
        quarterTopicsList = [{ topic_name: '', topic_description: '', topic_objectives: '', video_url: '' }];
    }
}

function renderQuarterTopicsCards() {
    const container = document.getElementById('quarterTopicsContainer');
    if (!container) return;

    container.innerHTML = quarterTopicsList.map((t, idx) => `
        <div class="quarter-topic-card p-4 rounded-2xl border border-slate-200 bg-white relative transition shadow-sm hover:border-indigo-300" data-index="${idx}">
            <div class="flex items-center justify-between pb-3 mb-3 border-b border-slate-100">
                <div class="flex items-center gap-2">
                    <span class="w-6 h-6 rounded-lg bg-indigo-600 text-white text-xs font-black flex items-center justify-center shadow-sm">
                        ${idx + 1}
                    </span>
                    <span class="text-xs font-black text-slate-800 tracking-wide uppercase">Topic #${idx + 1}</span>
                    ${idx === 0 ? '<span class="text-[10px] font-bold text-indigo-700 bg-indigo-50 px-2 py-0.5 rounded-full border border-indigo-100">Required</span>' : ''}
                </div>
                ${quarterTopicsList.length > 1 ? `
                    <button type="button" onclick="removeQuarterTopicCard(${idx})" class="text-xs font-bold text-rose-500 hover:text-rose-700 hover:bg-rose-50 px-2.5 py-1 rounded-lg transition flex items-center gap-1.5" title="Remove Topic">
                        <i class="fas fa-trash-can"></i> Remove
                    </button>
                ` : `
