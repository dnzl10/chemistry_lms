                    <i class="fas fa-user-graduate"></i>
                </div>
                <div>
                    <h3 class="font-black text-white text-lg leading-tight">Student Cohort Lifecycle Management</h3>
                    <p class="text-xs text-indigo-200">Year-end Chemistry cohort archival, session revocation, and dormancy protection</p>
                </div>
            </div>
            <button onclick="closeModal('modalStudentLifecycle')" class="w-9 h-9 rounded-xl bg-white/10 hover:bg-rose-500/80 text-white/80 hover:text-white transition flex items-center justify-center">
