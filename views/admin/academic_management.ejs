async function openEditSY(sy) {
    const syId = sy.sy_id;
    document.getElementById('editSYId').value = syId;
    document.getElementById('editSYModalTitle').textContent = `Edit School Year: ${sy.sy_range}`;

    // Reset edit tab to 1
    switchEditSYTab(1);
    openModal('modalEditSY');

    // Fetch full record to populate all date fields
    try {
        const res = await fetch(`/admin/am/school-years/${syId}`);
        const result = await res.json();
        if (result.success && result.schoolYear) {
            const data = result.schoolYear;
            document.getElementById('editSYRange').value = data.sy_range || '';
            document.getElementById('editSYCode').value  = data.sy_code || '';
            
            // Canonical status resolution: Current, Draft, Archive
            let resolvedStatus = data.status || 'Draft';
            if (resolvedStatus === 'Active' || data.is_active) resolvedStatus = 'Current';
            if (resolvedStatus === 'Archived') resolvedStatus = 'Archive';
            document.getElementById('editSYStatus').value = resolvedStatus;
            document.getElementById('editSYIsActive').checked = (resolvedStatus === 'Current' || !!data.is_active);

            const formatDate = d => d ? new Date(d).toISOString().split('T')[0] : '';
            const formatDateTime = d => {
                if (!d) return '';
                const dt = new Date(d);
                const pad = n => String(n).padStart(2, '0');
                return `${dt.getFullYear()}-${pad(dt.getMonth() + 1)}-${pad(dt.getDate())}T${pad(dt.getHours())}:${pad(dt.getMinutes())}`;
            };

            document.getElementById('editSYStartDate').value = formatDate(data.start_date);
            document.getElementById('editSYEndDate').value   = formatDate(data.end_date);

            document.getElementById('editSem1Start').value = formatDate(data.sem1_start_date);
            document.getElementById('editSem1End').value   = formatDate(data.sem1_end_date);
            document.getElementById('editQ1Start').value    = formatDate(data.q1_start_date);
            document.getElementById('editQ1End').value      = formatDate(data.q1_end_date);
            document.getElementById('editQ1Deadline').value = formatDateTime(data.q1_grade_deadline);
            document.getElementById('editQ2Start').value    = formatDate(data.q2_start_date);
            document.getElementById('editQ2End').value      = formatDate(data.q2_end_date);
            document.getElementById('editQ2Deadline').value = formatDateTime(data.q2_grade_deadline);

            document.getElementById('editSem2Start').value = formatDate(data.sem2_start_date);
            document.getElementById('editSem2End').value   = formatDate(data.sem2_end_date);
            document.getElementById('editQ3Start').value    = formatDate(data.q3_start_date);
            document.getElementById('editQ3End').value      = formatDate(data.q3_end_date);
            document.getElementById('editQ3Deadline').value = formatDateTime(data.q3_grade_deadline);
            document.getElementById('editQ4Start').value    = formatDate(data.q4_start_date);
            document.getElementById('editQ4End').value      = formatDate(data.q4_end_date);
            document.getElementById('editQ4Deadline').value = formatDateTime(data.q4_grade_deadline);

            document.getElementById('editSem1EnrollStart').value = formatDateTime(data.sem1_enrollment_start);
            document.getElementById('editSem1EnrollEnd').value   = formatDateTime(data.sem1_enrollment_end);
            document.getElementById('editSem2EnrollStart').value = formatDateTime(data.sem2_enrollment_start);
            document.getElementById('editSem2EnrollEnd').value   = formatDateTime(data.sem2_enrollment_end);

            document.getElementById('editEnforcePrereq').checked = (Number(data.enforce_prerequisite) === 1);
            document.getElementById('editPassingThreshold').value = data.passing_threshold || 75.00;
        }
    } catch (err) {
        console.error('Failed to load SY details:', err);
    }
}

