                            placeholder="Brief summary of concepts covered..." required>${escapeHtml(t.topic_description)}</textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1">
                            Learning Objectives (1 per line for bullets) <span class="text-rose-500">*</span>
                        </label>
                        <textarea rows="3" class="q-topic-obj topic-autofit-field w-full px-3.5 py-2 rounded-xl border border-slate-200 text-xs bg-slate-50/50 focus:bg-white focus:ring-2 focus:ring-indigo-500/20 focus:border-indigo-500 transition outline-none text-slate-800"
                            data-min-height="72" data-max-height="260" oninput="autoResizeTopicField(this)" style="resize:none; overflow-y:hidden; min-height:72px;"
                            placeholder="• Explain atomic models&#10;• Identify subatomic particles..." required>${escapeHtml(t.topic_objectives)}</textarea>
                    </div>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-700 mb-1">
