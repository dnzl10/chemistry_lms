                                <i class="fas fa-school text-rose-400"></i> Classes Under This Subject
                            </h4>
                            <div class="flex gap-2">
                                <button onclick="openAddClass()"
                                    class="flex items-center gap-2 bg-rose-100 text-rose-700 font-bold text-xs px-3 py-2 rounded-xl hover:bg-rose-200 transition">
                                    <i class="fas fa-plus"></i> Add Class
                                </button>
                                <button onclick="openModal('modalBulkEnroll')"
                                    class="flex items-center gap-2 border border-rose-200 text-rose-600 font-bold text-xs px-3 py-2 rounded-xl hover:bg-rose-50 transition">
                                    <i class="fas fa-file-excel"></i> Bulk Enroll
                                </button>
                            </div>
                        </div>
                        <div id="classesContainer">
                            <div class="text-center py-8 text-slate-400 text-sm">Select a subject to view classes.</div>
                        </div>
                    </div>

                    <!-- ── DRILL TAB: PROGRESS ── -->
                    <div id="dt-progress" class="tab-pane glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                            <h4 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-chart-bar text-cyan-400"></i> Student Progress Tracker
                            </h4>
