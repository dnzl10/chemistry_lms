// ─── SY Input Validator & Smart Auto-Fill ─────────────────────────────────
function validateSYInput(input) {
    const errorEl = document.getElementById('addSYError');
    const val     = input.value.trim();
    const currentYear = new Date().getFullYear();

    if (!val) { errorEl.classList.add('hidden'); errorEl.textContent = ''; return; }

    if (/[^0-9\-]/.test(val)) {
        errorEl.textContent = '⛔ Letters and special characters are not allowed in Range. Numbers only.';
        errorEl.classList.remove('hidden'); return;
    }

    if (val.length === 9) {
        const match = val.match(/^(\d{4})-(\d{4})$/);
        if (!match) {
            errorEl.textContent = '⛔ Format must be YYYY-YYYY (e.g. 2026-2027).';
            errorEl.classList.remove('hidden'); return;
        }

        const start = parseInt(match[1]);
        const end   = parseInt(match[2]);

        if (end !== start + 1) {
            errorEl.textContent = `⛔ End year must be exactly one year after start year.`;
            errorEl.classList.remove('hidden'); return;
        }

        // Auto-suggest code if empty
        const codeInput = document.getElementById('addSYCode');
        if (codeInput && !codeInput.value) {
            codeInput.value = `SY${String(start).slice(2)}-${String(end).slice(2)}`;
        }

        // Auto-suggest standard Philippine academic calendar dates if empty
        const startInput = document.getElementById('addSYStartDate');
        const endInput   = document.getElementById('addSYEndDate');
        if (startInput && !startInput.value) startInput.value = `${start}-08-24`;
        if (endInput   && !endInput.value)   endInput.value   = `${end}-05-28`;

        const s1Start = document.getElementById('addSem1Start');
        const s1End   = document.getElementById('addSem1End');
        if (s1Start && !s1Start.value) s1Start.value = `${start}-08-24`;
        if (s1End   && !s1End.value)   s1End.value   = `${start}-12-18`;

        const q1Start = document.getElementById('addQ1Start');
        const q1End   = document.getElementById('addQ1End');
        const q1Dead  = document.getElementById('addQ1Deadline');
        if (q1Start && !q1Start.value) q1Start.value = `${start}-08-24`;
        if (q1End   && !q1End.value)   q1End.value   = `${start}-10-23`;
        if (q1Dead  && !q1Dead.value)  q1Dead.value  = `${start}-10-30T23:59`;

        const q2Start = document.getElementById('addQ2Start');
        const q2End   = document.getElementById('addQ2End');
        const q2Dead  = document.getElementById('addQ2Deadline');
        if (q2Start && !q2Start.value) q2Start.value = `${start}-10-26`;
        if (q2End   && !q2End.value)   q2End.value   = `${start}-12-18`;
        if (q2Dead  && !q2Dead.value)  q2Dead.value  = `${end}-01-08T23:59`;

        const s2Start = document.getElementById('addSem2Start');
        const s2End   = document.getElementById('addSem2End');
        if (s2Start && !s2Start.value) s2Start.value = `${end}-01-11`;
        if (s2End   && !s2End.value)   s2End.value   = `${end}-05-28`;

        const q3Start = document.getElementById('addQ3Start');
        const q3End   = document.getElementById('addQ3End');
        const q3Dead  = document.getElementById('addQ3Deadline');
        if (q3Start && !q3Start.value) q3Start.value = `${end}-01-11`;
        if (q3End   && !q3End.value)   q3End.value   = `${end}-03-19`;
        if (q3Dead  && !q3Dead.value)  q3Dead.value  = `${end}-03-26T23:59`;

        const q4Start = document.getElementById('addQ4Start');
        const q4End   = document.getElementById('addQ4End');
        const q4Dead  = document.getElementById('addQ4Deadline');
        if (q4Start && !q4Start.value) q4Start.value = `${end}-03-22`;
        if (q4End   && !q4End.value)   q4End.value   = `${end}-05-28`;
        if (q4Dead  && !q4Dead.value)  q4Dead.value  = `${end}-06-04T23:59`;

        const s1EnrollStart = document.getElementById('addSem1EnrollStart');
        const s1EnrollEnd   = document.getElementById('addSem1EnrollEnd');
        if (s1EnrollStart && !s1EnrollStart.value) s1EnrollStart.value = `${start}-08-01T08:00`;
        if (s1EnrollEnd   && !s1EnrollEnd.value)   s1EnrollEnd.value   = `${start}-09-15T23:59`;

        const s2EnrollStart = document.getElementById('addSem2EnrollStart');
        const s2EnrollEnd   = document.getElementById('addSem2EnrollEnd');
        if (s2EnrollStart && !s2EnrollStart.value) s2EnrollStart.value = `${end}-01-04T08:00`;
        if (s2EnrollEnd   && !s2EnrollEnd.value)   s2EnrollEnd.value   = `${end}-01-29T23:59`;

        // If future year, suggest Draft status
        const statusSelect = document.getElementById('addSYStatus');
        const activeCb = document.getElementById('addSYIsActive');
        if (start > currentYear && statusSelect) {
            statusSelect.value = 'Draft';
            if (activeCb) activeCb.checked = false;
            errorEl.textContent = `ℹ️ Upcoming School Year: Pre-configured in Draft mode.`;
            errorEl.style.color = '#0284c7';
            errorEl.classList.remove('hidden');
            return;
        }

        errorEl.textContent = `✅ Valid school year range! Timeline auto-suggested.`;
        errorEl.classList.remove('hidden');
        errorEl.style.color = '#16a34a';
        return;
    }

    errorEl.classList.add('hidden');
    errorEl.style.color = '';
}

