                                </button>
                                <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchDrillTab('dt-progress', this)">
                                    <i class="fas fa-chart-bar"></i> Progress
                                </button>
                                <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchDrillTab('dt-announcements', this)">
                                    <i class="fas fa-bullhorn"></i> Announcements
                                </button>
                                <button class="tab-btn btn-arcade flex items-center gap-2 px-4 py-2 rounded-xl text-sm" onclick="switchDrillTab('dt-arcade', this)">
                                    <i class="fas fa-gamepad"></i> Arcade Config
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- ── DRILL TAB: CURRICULUM ── -->
                    <div id="dt-curriculum" class="tab-pane active glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-sitemap text-indigo-400"></i> Quarters & Topics
                            </h4>
