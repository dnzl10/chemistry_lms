                            <div>
                                <span class="text-xs font-bold text-slate-800 block">Archive &amp; Deactivate Outgoing Chemistry Cohort <span class="text-[10px] text-emerald-600 font-bold bg-emerald-50 px-2 py-0.5 rounded-full ml-1">Security Standard</span></span>
                                <span class="text-[11px] text-slate-500 leading-snug block">Automatically deactivates accounts of students completing General Chemistry 1 &amp; 2 upon activating this new School Year. Former students cannot access the platform during Grade 12 while all their transcripts, marks, and records remain 100% preserved.</span>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- Modal Footer Controls -->
            <div class="flex items-center justify-between pt-5 border-t border-slate-200 shrink-0">
