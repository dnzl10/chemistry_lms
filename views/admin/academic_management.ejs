            return;
        }
        container.innerHTML = `<div class="space-y-3">` + data.announcements.map(a => `
            <div class="p-4 rounded-xl border ${a.is_priority ? 'border-rose-200 bg-rose-50' : 'border-slate-100 bg-white'}">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex-1">
                        ${a.is_priority ? `<span class="badge badge-locked text-[9px] mb-1">Priority</span>` : ''}
                        <p class="font-black text-slate-800 text-sm">${a.title}</p>
                        <p class="text-xs text-slate-500 mt-1 line-clamp-2">${a.content}</p>
                        <p class="text-[10px] text-slate-400 mt-1">${new Date(a.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})}</p>
                    </div>
                    <button class="btn-icon btn-delete flex-shrink-0" onclick="confirmDeleteAnnouncement(${a.announcement_id},'${a.title.replace(/'/g,"\\'")}')">
                        <i class="fas fa-trash"></i>
                    </button>
                </div>
            </div>`).join('') + `</div>`;
    } catch { container.innerHTML = `<p class="text-rose-500 text-sm">Failed to load announcements.</p>`; }
}

function openAddAnnouncement() {
    document.getElementById('addAnnSubjectId').value = activeDrillSubjectId;
    openModal('modalAddAnnouncement');
}
async function submitAddAnnouncement(e) {
    e.preventDefault();
    const fd   = new FormData(document.getElementById('addAnnouncementForm'));
    const data = await apiPost('/admin/am/announcements', {
        title:      fd.get('title'),
        content:    fd.get('content'),
        class_id:   fd.get('class_id') || null,
        subject_id: activeDrillSubjectId,
        is_priority: fd.get('is_priority') ? 1 : 0,
        teacher_id: <%- JSON.stringify(user.user_id) %>
    });
    if (data.success) { showToast('Announcement posted!', 'success'); closeModal('modalAddAnnouncement'); loadAnnouncements(); }
    else showToast(data.message || 'Failed.', 'error');
}

function confirmDeleteAnnouncement(annId, title) {
    showConfirm({
        icon:'fa-trash', iconBg:'bg-rose-100', iconColor:'text-rose-600',
        title:`Delete "${title}"?`,
        desc:'This announcement will be permanently removed.',
        btnLabel:'Delete', btnColor:'bg-rose-500',
        onConfirm: async () => {
            const data = await apiDelete(`/admin/am/announcements/${annId}`);
            closeModal('modalConfirm');
            if (data.success) { showToast('Deleted.', 'success'); loadAnnouncements(); }
            else showToast(data.message || 'Failed.', 'error');
        }
    });
}

// ─── Arcade Data ──────────────────────────────────────────────────────────────
async function loadArcadeData() {
    loadLeaderboard();
    loadMatches();
    loadMappings();
}

async function loadLeaderboard() {
    if (!activeDrillSubjectId) return;
    const container = document.getElementById('leaderboardContainer');
    container.innerHTML = `<div class="text-center py-4"><i class="fas fa-spinner fa-spin text-yellow-300 text-xl"></i></div>`;
    try {
        const res  = await fetch(`/admin/am/subjects/${activeDrillSubjectId}/leaderboard`);
        const data = await res.json();
        if (!data.success || !data.history.length) {
            container.innerHTML = `<p class="text-slate-400 text-sm text-center py-4">No leaderboard snapshots yet.</p>`;
            return;
        }
        container.innerHTML = `
            <div class="table-wrap rounded-xl border border-slate-100">
                <table class="data-table w-full text-sm">
                    <thead><tr class="border-b border-slate-100">
                        <th class="p-3 text-left">Rank</th><th class="p-3 text-left">Student</th>
                        <th class="p-3 text-left">EXP Snapshot</th><th class="p-3 text-left hidden md:table-cell">Date</th>
                        <th class="p-3 text-center">Actions</th>
                    </tr></thead>
                    <tbody>
                    ${data.history.map(h => `
                        <tr class="border-b border-slate-50">
                            <td class="p-3 font-black text-indigo-700">#${h.rank_achieved}</td>
                            <td class="p-3 font-bold text-slate-800">${h.student_name}</td>
                            <td class="p-3 font-mono text-sm text-slate-600">${h.total_exp_snapshot.toLocaleString()}</td>
                            <td class="p-3 hidden md:table-cell text-xs text-slate-400">${new Date(h.awarded_date).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})}</td>
                            <td class="p-3 text-center">
                                <button class="btn-icon btn-delete" onclick="confirmDeleteLB(${h.history_id})"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>`).join('')}
                    </tbody>
                </table>
            </div>`;
    } catch { container.innerHTML = `<p class="text-rose-500 text-sm">Failed to load leaderboard.</p>`; }
}

function confirmDeleteLB(histId) {
    showConfirm({
        icon:'fa-trash', iconBg:'bg-rose-100', iconColor:'text-rose-600',
        title:'Delete Leaderboard Entry?',
        desc:'This snapshot record will be permanently deleted.',
        btnLabel:'Delete', btnColor:'bg-rose-500',
        onConfirm: async () => {
            const data = await apiDelete(`/admin/am/leaderboard/${histId}`);
            closeModal('modalConfirm');
            if (data.success) { showToast('Entry deleted.', 'success'); loadLeaderboard(); }
            else showToast(data.message || 'Failed.', 'error');
        }
    });
}

async function loadMatches() {
    if (!activeDrillSubjectId) return;
    const container = document.getElementById('matchesContainer');
    container.innerHTML = `<div class="text-center py-4"><i class="fas fa-spinner fa-spin text-rose-300 text-xl"></i></div>`;
    try {
        const res  = await fetch(`/admin/am/subjects/${activeDrillSubjectId}/matches`);
        const data = await res.json();
        if (!data.success || !data.matches.length) {
            container.innerHTML = `<p class="text-slate-400 text-sm text-center py-4">No competitive matches recorded yet.</p>`;
            return;
        }
        container.innerHTML = `
            <div class="table-wrap rounded-xl border border-slate-100">
                <table class="data-table w-full text-sm">
                    <thead><tr class="border-b border-slate-100">
                        <th class="p-3 text-left">Player 1</th><th class="p-3 text-left">Player 2</th>
                        <th class="p-3 text-left hidden md:table-cell">Score</th><th class="p-3 text-left">Winner</th>
                        <th class="p-3 text-left hidden md:table-cell">Date</th><th class="p-3 text-center">Actions</th>
                    </tr></thead>
                    <tbody>
                    ${data.matches.map(m => `
                        <tr class="border-b border-slate-50">
                            <td class="p-3 font-bold text-slate-700">${m.p1_name}</td>
                            <td class="p-3 font-bold text-slate-700">${m.p2_name}</td>
                            <td class="p-3 hidden md:table-cell text-xs font-mono text-slate-500">${m.p1_score} – ${m.p2_score}</td>
                            <td class="p-3"><span class="badge badge-active">${m.winner_name || '—'}</span></td>
                            <td class="p-3 hidden md:table-cell text-xs text-slate-400">${new Date(m.match_date).toLocaleDateString('en-PH',{month:'short',day:'numeric'})}</td>
                            <td class="p-3 text-center">
                                <button class="btn-icon btn-delete" onclick="confirmDeleteMatch(${m.match_id})"><i class="fas fa-trash"></i></button>
