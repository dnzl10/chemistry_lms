<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Academic Management | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="/js/admin_spa_handler.js"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        .swal2-container { z-index: 100000 !important; }
    </style>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .glass-card { background: rgba(255,255,255,0.92); backdrop-filter: blur(10px); }
        .stat-card { transition: transform 0.18s ease, box-shadow 0.18s ease; }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.10); }
        .nav-active {
            background: linear-gradient(135deg, #06b6d4, #6366f1) !important;
            color: white !important; font-weight: 700;
            box-shadow: 0 4px 14px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }
        .fade-in { animation: fadeUp 0.35s ease both; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }

        /* Tab system */
        .tab-btn { transition: all 0.2s ease; }
        .tab-btn.active { background: linear-gradient(135deg,#06b6d4,#6366f1); color:white; box-shadow:0 4px 14px rgba(99,102,241,0.35); }
        .tab-pane { display:none; }
        .tab-pane.active { display:block; }

        /* Modal */
        .modal-overlay {
            position:fixed; inset:0; background:rgba(15,23,42,0.55);
            backdrop-filter:blur(4px); z-index:9000;
            display:flex; align-items:center; justify-content:center;
            opacity:0; pointer-events:none; transition:opacity 0.22s ease;
        }
        .modal-overlay.open { opacity:1; pointer-events:all; }
        .modal-box {
            background:white; border-radius:20px;
            box-shadow:0 32px 80px rgba(0,0,0,0.22);
            width:95%; max-width:680px; max-height:90vh;
            overflow-y:auto; transform:scale(0.96) translateY(12px);
            transition:transform 0.22s ease;
        }
        .modal-overlay.open .modal-box { transform:scale(1) translateY(0); }
        .modal-box-sm { max-width:440px; }
        .modal-box-lg { max-width:860px; }

        /* Badge */
        .badge { display:inline-flex; align-items:center; gap:4px; font-size:11px; font-weight:700; padding:2px 8px; border-radius:99px; text-transform:uppercase; letter-spacing:.04em; }
        .badge-locked   { background:#fee2e2; color:#991b1b; }
        .badge-unlocked { background:#d1fae5; color:#065f46; }
        .badge-active   { background:#dbeafe; color:#1e40af; }
        .badge-inactive { background:#f1f5f9; color:#64748b; }

        /* Search */
        .search-input { transition:box-shadow 0.18s, border-color 0.18s; }
        .search-input:focus { box-shadow:0 0 0 3px rgba(6,182,212,0.18); border-color:#06b6d4; outline:none; }

        /* Table */
        .data-table th { background:#f8fafc; font-size:11px; text-transform:uppercase; letter-spacing:.05em; color:#64748b; font-weight:700; }
        .data-table tbody tr:hover { background:#f0f9ff; }
        .data-table td { vertical-align:middle; }
        .table-wrap { overflow-x:auto; }
        .table-wrap::-webkit-scrollbar { height:3px; }
        .table-wrap::-webkit-scrollbar-thumb { background:#c7d2fe; border-radius:2px; }

        /* Action buttons */
        .btn-icon { width:30px; height:30px; border-radius:8px; display:inline-flex; align-items:center; justify-content:center; transition:all 0.15s; font-size:12px; cursor:pointer; border:none; }
        .btn-icon:hover { transform:scale(1.12); }
        .btn-edit   { background:#e0f2fe; color:#0369a1; }
        .btn-delete { background:#fee2e2; color:#dc2626; }
        .btn-lock   { background:#fef3c7; color:#d97706; }
        .btn-unlock { background:#d1fae5; color:#059669; }
        .btn-view   { background:#ede9fe; color:#7c3aed; }
        .btn-add    { background:#dbeafe; color:#1d4ed8; }

        /* Subject card grid */
        .subject-card {
            background:white; border-radius:16px; border:1.5px solid #e2e8f0;
            transition:all 0.2s ease; cursor:pointer; overflow:hidden;
        }
        .subject-card:hover { border-color:#6366f1; box-shadow:0 8px 24px rgba(99,102,241,0.15); transform:translateY(-2px); }
        .subject-card.selected { border-color:#6366f1; box-shadow:0 0 0 3px rgba(99,102,241,0.2); }

        /* Drill-down panel */
        #drillPanel { transition: all 0.3s ease; }

        /* Progress bar */
        .progress-bar { height:6px; border-radius:3px; background:#e2e8f0; }
        .progress-fill { height:100%; border-radius:3px; background:linear-gradient(90deg,#06b6d4,#6366f1); transition:width 0.5s ease; }

        /* Glitch effect on arcade buttons */
        .btn-arcade {
            position:relative; overflow:hidden;
            background:linear-gradient(135deg,#f59e0b,#ef4444);
            color:white; font-weight:700; border:none; cursor:pointer;
            transition:all 0.2s;
        }
        .btn-arcade:hover { animation:glitch 0.3s infinite; }
        @keyframes glitch {
            0%   { transform:translate(0); }
            20%  { transform:translate(-2px,1px); filter:hue-rotate(10deg); }
            40%  { transform:translate(2px,-1px); }
            60%  { transform:translate(-1px,2px); filter:hue-rotate(-10deg); }
            80%  { transform:translate(1px,-2px); }
            100% { transform:translate(0); }
        }

        /* Breadcrumb */
        .breadcrumb span { font-size:12px; font-weight:700; color:#94a3b8; }
        .breadcrumb span.active { color:#6366f1; }
        .breadcrumb i { font-size:10px; color:#cbd5e1; margin:0 4px; }

        /* Drop zone */
        .drop-zone {
            border:2.5px dashed #c7d2fe; border-radius:16px;
            transition:all 0.2s ease; cursor:pointer;
        }
        .drop-zone.dragover { border-color:#6366f1; background:#eef2ff; }

        /* Toast */
        #toast {
            position:fixed; bottom:28px; right:28px; z-index:99999;
            padding:14px 22px; border-radius:14px; font-weight:700; font-size:14px;
            display:flex; align-items:center; gap:10px;
            box-shadow:0 8px 30px rgba(0,0,0,0.18);
            transform:translateY(80px); opacity:0; pointer-events:none;
            transition:all 0.3s cubic-bezier(.34,1.56,.64,1);
        }
        #toast.show { transform:translateY(0); opacity:1; }
        #toast.success { background:#10b981; color:white; }
        #toast.error   { background:#ef4444; color:white; }
        #toast.info    { background:#6366f1; color:white; }

        /* Topic nested indent */
        .topic-row { border-left:3px solid #e0f2fe; margin-left:12px; }

        /* SY card */
        .sy-card-active { border:2px solid #22c55e; background:linear-gradient(135deg,#f0fdf4,#dcfce7); }
        .sy-card-inactive { border:2px solid #e2e8f0; background:white; }
    </style>
</head>
<body class="text-slate-900">

<div class="flex min-h-screen relative overflow-x-hidden">

    <div id="sidebarOverlay" onclick="toggleSidebar()"
         class="fixed inset-0 bg-cyan-900/50 z-40 hidden md:hidden"></div>

    <!-- ===================== SIDEBAR ===================== -->
    <aside id="sidebar" class="bg-indigo-950 text-white w-64 flex-shrink-0 flex flex-col z-50 fixed inset-y-0 left-0 -translate-x-full md:translate-x-0 h-screen border-r border-indigo-800/50">
        <div class="pt-8 pb-4 px-4 flex flex-col items-center text-center relative">
            <!-- Mobile close button -->
            <button onclick="toggleSidebar()" class="md:hidden text-indigo-300 hover:text-white absolute top-4 right-4">
                <i class="fas fa-times text-xl"></i>
            </button>

            <!-- Logo -->
            <img src="/assets/logo.png" alt="ChemArcade Logo" class="w-16 h-16 object-contain mb-3">

            <!-- Brand name -->
            <h1 class="text-xl font-black tracking-tighter text-cyan-400 uppercase italic leading-none">
                Elem<span class="text-white">enta</span>
            </h1>
            <p class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest mt-1">Admin Console</p>

            <!-- Divider -->
            <!-- <div class="w-full mt-5 border-t border-indigo-800/60"></div> -->
        </div>
        <nav class="flex-1 px-4 mt-4 space-y-6 overflow-y-auto no-scrollbar pb-6">
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Main Interface</p>
                <div class="space-y-1">
                    <a href="/admin/dashboard" class="flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white hover:bg-white/10 group">
                        <i class="fas fa-chart-pie w-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-bold tracking-tight text-sm">Main Dashboard</span>
                    </a>
                </div>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Administrative</p>
                <div class="space-y-1">
                    <a href="/admin/user_access_control" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-users w-5 text-sky-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">User & Access Control</span>
                    </a>
                    <a href="/admin/academic_management" class="nav-active flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-graduation-cap w-5 text-emerald-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Academic Management</span>
                    </a>
                </div>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">Learning Assets</p>
                <div class="space-y-1">
                    <a href="/admin/gaming_question_bank" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-gamepad w-5 text-amber-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Gaming & Q-Bank</span>
                    </a>
                    <a href="/admin/resources_engagement" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-lightbulb w-5 text-lime-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Resources & Engagement</span>
                    </a>
                    <a href="/admin/simulation-quizzes" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-flask-vial w-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Simulation Quizzes</span>
                    </a>
                </div>
            </div>
            <div>
                <p class="text-[10px] font-black uppercase tracking-widest text-indigo-500 px-3 mb-2 opacity-70">System Health</p>
                <div class="space-y-1">
                    <a href="/admin/reports_monitoring" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-chart-line w-5 text-blue-400 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">Reports & Monitoring</span>
                    </a>
                    <a href="/admin/system_audit" class="flex items-center gap-3 p-3 rounded-xl hover:bg-white/10 transition text-indigo-200 hover:text-white group">
                        <i class="fas fa-fingerprint w-5 text-indigo-300 group-hover:scale-110 transition-transform"></i>
                        <span class="font-semibold text-sm">System Audit</span>
                    </a>
                </div>
            </div>
        </nav>
        <div class="p-4 border-t border-indigo-800">
            <a href="/logout" class="flex items-center gap-3 p-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition group font-bold">
                <i class="fas fa-right-from-bracket w-5"></i> Log Out
            </a>
        </div>
    </aside>

    <!-- ===================== MAIN CONTENT ===================== -->
    <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- TOP HEADER -->
        <header class="h-20 bg-white/90 backdrop-blur-md border-b border-cyan-100 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-cyan-50 text-cyan-600 md:hidden">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <div>
                    <h2 class="text-lg font-bold text-indigo-900 uppercase tracking-tight">
                        <i class="fas fa-graduation-cap text-emerald-400"></i>
                        Academic Management
                    </h2>
                    <p class="text-xs text-slate-400 hidden sm:block">
                        <i class="fas fa-circle text-green-400 text-[8px] mr-1"></i>
                        Manage subjects, curriculum, classes &amp; academic structure
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3 md:gap-5">
                <!-- Global School Year Context Selector -->
                <%- include('../partials/admin_sy_selector') %>
                <!-- Notification bell -->
                <div id="notifBellBtn" class="relative cursor-pointer p-2 hover:bg-cyan-50 rounded-full transition" onclick="toggleNotifPanel()">
                    <i class="far fa-bell text-xl text-cyan-600"></i>
                    <span id="notifDot" class="absolute top-2 right-2 flex h-2.5 w-2.5 hidden">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                    </span>
                    <span id="notifCount" class="absolute -top-0.5 -right-0.5 hidden bg-rose-500 text-white text-[9px] font-black rounded-full w-4 h-4 flex items-center justify-center"></span>
                </div>

                <!-- Admin profile -->
                <div class="flex items-center gap-3 pl-4 border-l border-cyan-100">
                    <div class="text-right hidden lg:block">
                        <p class="text-sm font-bold text-indigo-900"><%= user.first_name %> <%= user.last_name %></p>
                        <p class="text-[10px] uppercase font-black text-rose-500 tracking-widest">Administrator</p>
                    </div>
                    <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                         class="w-10 h-10 rounded-xl object-cover ring-2 ring-rose-400 shadow-sm">
                </div>
            </div>
        </header>

        <!-- SCROLLABLE CONTENT -->
        <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
            <div id="adminMainContent" class="p-4 md:p-8 flex-1 fade-in">

                <!-- School Year Alert Banner (Archive/Draft) -->
                <%- include('../partials/admin_sy_banner') %>

                <!-- ── BREADCRUMB ── -->
                <div class="breadcrumb flex items-center mb-5" id="breadcrumb">
                    <span class="active">Academic</span>
                    <i class="fas fa-chevron-right"></i>
                    <span id="bc-subject">—</span>
                    <i class="fas fa-chevron-right" id="bc-arrow2" style="display:none"></i>
                    <span id="bc-quarter" style="display:none"></span>
                    <i class="fas fa-chevron-right" id="bc-arrow3" style="display:none"></i>
                    <span id="bc-topic" style="display:none"></span>
                </div>

                <!-- ═══════════════════════════════════
                     SECTION A: SCHOOL YEAR + KPI STATS
                ═══════════════════════════════════ -->
                <div class="grid grid-cols-1 lg:grid-cols-3 gap-5 mb-7">

                    <!-- School Year Card -->
                    <div class="glass-card rounded-2xl border border-emerald-100 shadow-sm p-5">
                        <div class="flex items-center justify-between mb-4">
                            <h3 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-calendar-alt text-emerald-500"></i> School Year
                            </h3>
                            <button onclick="openModal('modalAddSY')"
                                class="text-xs font-bold bg-emerald-100 text-emerald-700 px-3 py-1.5 rounded-lg hover:bg-emerald-200 transition">
                                <i class="fas fa-plus mr-1"></i> Add SY
                            </button>
                        </div>
                        <% if (activeSY) { %>
                        <div class="sy-card-active rounded-xl p-4 mb-3 border border-emerald-200 bg-gradient-to-br from-emerald-50/70 to-white shadow-sm">
                            <div class="flex items-center justify-between mb-1">
                                <div class="flex items-center gap-2">
                                    <span class="w-2.5 h-2.5 bg-emerald-500 rounded-full animate-pulse"></span>
                                    <span class="text-xs font-black text-emerald-700 uppercase tracking-wider">Current</span>
                                    <% if (activeSY.sy_code) { %>
                                    <span class="text-[10px] font-black bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-md uppercase"><%= activeSY.sy_code %></span>
                                    <% } %>
                                </div>
                                <span class="text-[11px] font-bold text-slate-500">
                                    <% if (activeSY.start_date && activeSY.end_date) { %>
                                    <%= new Date(activeSY.start_date).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) %> – <%= new Date(activeSY.end_date).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) %>
                                    <% } %>
                                </span>
                            </div>
                            <p class="text-2xl font-black text-slate-800 mt-1"><%= activeSY.sy_range %></p>
                            <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 mt-2">
                                <span><i class="fas fa-chalkboard text-emerald-600 mr-1"></i><%= activeSY.classCount %> class(es)</span>
                                <span>•</span>
                                <span><i class="fas fa-user-graduate text-emerald-600 mr-1"></i><%= activeSY.enrolledCount %> enrolled</span>
                                <% if (activeSY.enforce_prerequisite) { %>
                                <span>•</span>
                                <span class="text-emerald-700 font-bold" title="Prerequisite Enforced for Chem 2"><i class="fas fa-shield-alt mr-1"></i>Chem 1 &ge; <%= activeSY.passing_threshold %>% Req</span>
                                <% } %>
                            </div>
                        </div>
                        <% } else { %>
                        <div class="bg-amber-50 border border-amber-200 rounded-xl p-4 mb-3 text-center">
                            <i class="fas fa-exclamation-triangle text-amber-400 text-2xl mb-1"></i>
                            <p class="text-xs font-bold text-amber-600">No active school year set!</p>
                        </div>
                        <% } %>
                        <div class="space-y-2">
                        <% schoolYears.forEach(function(sy) { %>
                            <div class="flex items-center justify-between p-2.5 rounded-xl border border-slate-100 bg-slate-50">
                                <div class="flex items-center gap-2">
                                    <% if (sy.status === 'Current' || sy.is_active) { %>
                                    <span class="badge badge-active flex items-center gap-1.5"><span class="w-1.5 h-1.5 bg-emerald-500 rounded-full animate-pulse"></span>Current</span>
                                    <% } else if (sy.status === 'Draft') { %>
                                    <span class="badge" style="background:#e0f2fe;color:#0369a1;border:1px solid #bae6fd;">Draft</span>
                                    <% } else { %>
                                    <span class="badge badge-inactive">Archive</span>
                                    <% } %>
                                    <span class="text-sm font-bold text-slate-700"><%= sy.sy_range %></span>
                                    <% if (sy.sy_code) { %><span class="text-[10px] font-mono text-indigo-500 font-bold">(<%= sy.sy_code %>)</span><% } %>
                                </div>
                                <div class="flex items-center gap-1">
                                    <% if (!sy.is_active) { %>
                                    <button class="btn-icon btn-unlock" title="Activate this SY"
                                        onclick="confirmActivateSY(<%= sy.sy_id %>, '<%= sy.sy_range %>')">
                                        <i class="fas fa-toggle-off"></i>
                                    </button>
                                    <% } %>
                                    <button class="btn-icon btn-edit" title="Edit SY"
                                        onclick="openEditSY(<%= JSON.stringify(sy) %>)">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <% if (!sy.is_active) { %>
                                    <button class="btn-icon btn-delete" title="Delete SY"
                                        onclick="confirmDeleteSY(<%= sy.sy_id %>, '<%= sy.sy_range %>')">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                    <% } %>
                                </div>
                            </div>
                        <% }) %>
                        </div>
                        <!-- View All Past School Years -->
                        <button onclick="openModal('modalAllSY')"
                            class="mt-3 w-full text-center text-[11px] font-bold text-indigo-500 hover:text-indigo-700 hover:underline transition">
                            <i class="fas fa-history mr-1"></i> View All School Years
                        </button>

                        <!-- Student Cohort & Lifecycle Action -->
                        <button onclick="openStudentLifecycleModal()"
                            class="mt-2 w-full flex items-center justify-center gap-2 py-2 px-3 rounded-xl bg-gradient-to-r from-indigo-50 to-cyan-50 hover:from-indigo-100 hover:to-cyan-100 text-indigo-700 font-bold text-xs transition border border-indigo-200/80 shadow-xs">
                            <i class="fas fa-user-graduate text-indigo-600"></i> Student Cohort Lifecycle
                        </button>
                    </div>

                    <!-- KPI Stats (2 cols) -->
                    <div class="lg:col-span-2 grid grid-cols-2 md:grid-cols-4 gap-4">
                        <div class="stat-card glass-card rounded-2xl p-5 border border-indigo-100 shadow-sm">
                            <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center mb-3">
                                <i class="fas fa-book text-indigo-600"></i>
                            </div>
                            <p class="text-3xl font-black text-indigo-900"><%= amStats.totalSubjects %></p>
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mt-1">Subjects</p>
                        </div>
                        <div class="stat-card glass-card rounded-2xl p-5 border border-cyan-100 shadow-sm">
                            <div class="w-10 h-10 rounded-xl bg-cyan-100 flex items-center justify-center mb-3">
                                <i class="fas fa-layer-group text-cyan-600"></i>
                            </div>
                            <p class="text-3xl font-black text-indigo-900"><%= amStats.totalQuarters %></p>
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mt-1">Quarters</p>
                        </div>
                        <div class="stat-card glass-card rounded-2xl p-5 border border-emerald-100 shadow-sm">
                            <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center mb-3">
                                <i class="fas fa-tags text-emerald-600"></i>
                            </div>
                            <p class="text-3xl font-black text-indigo-900"><%= amStats.totalTopics %></p>
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mt-1">Topics</p>
                        </div>
                        <div class="stat-card glass-card rounded-2xl p-5 border border-rose-100 shadow-sm">
                            <div class="w-10 h-10 rounded-xl bg-rose-100 flex items-center justify-center mb-3">
                                <i class="fas fa-school text-rose-600"></i>
                            </div>
                            <p class="text-3xl font-black text-indigo-900"><%= amStats.totalClasses %></p>
                            <p class="text-[10px] font-black uppercase tracking-widest text-slate-400 mt-1">Classes</p>
                        </div>
                    </div>
                </div>

                <!-- ═══════════════════════════════════
                     SECTION B: SUBJECT GRID
                ═══════════════════════════════════ -->
                <div class="glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-6">
                    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 mb-5">
                        <h3 class="font-black text-slate-800 text-base flex items-center gap-2">
                            <i class="fas fa-th text-indigo-400"></i> Subject Directory
                        </h3>
                        <div class="flex items-center gap-3 flex-wrap">
                            <div class="relative">
                                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                <input id="subjectSearch" type="text" placeholder="Search subjects…"
                                    class="search-input pl-8 pr-3 py-2 rounded-xl border border-slate-200 text-sm font-medium bg-white w-48"
                                    oninput="filterSubjects()">
                            </div>
                            <select id="semesterFilter" class="search-input px-3 py-2 rounded-xl border border-slate-200 text-sm font-medium bg-white" onchange="filterSubjects()">
                                <option value="">All Semesters</option>
                                <option value="1">Semester 1</option>
                                <option value="2">Semester 2</option>
                            </select>
                            <button onclick="openModal('modalAddSubject')"
                                class="flex items-center gap-2 bg-gradient-to-r from-indigo-500 to-cyan-500 text-white font-bold text-sm px-4 py-2 rounded-xl hover:opacity-90 transition shadow-md">
                                <i class="fas fa-plus"></i> Add Subject
                            </button>
                            <button onclick="openModal('modalBulkSubject')"
                                class="flex items-center gap-2 border border-indigo-200 text-indigo-600 font-bold text-sm px-4 py-2 rounded-xl hover:bg-indigo-50 transition">
                                <i class="fas fa-file-excel"></i> Bulk Import
                            </button>
                        </div>
                    </div>

                    <!-- Subject Cards Grid -->
                    <div id="subjectGrid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4">
                    <% subjects.forEach(function(s) { %>
                        <div class="subject-card p-4"
                             data-id="<%= s.subject_id %>"
                             data-name="<%= s.subject_name.toLowerCase() %>"
                             data-semester="<%= s.semester %>"
                             onclick="drillIntoSubject(<%= s.subject_id %>, '<%= s.subject_name.replace(/'/g,"\\'"  ) %>')">
                            <div class="flex items-start justify-between mb-3">
                                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 to-cyan-500 flex items-center justify-center flex-shrink-0">
                                    <i class="fas fa-atom text-white text-sm"></i>
                                </div>
                                <div class="flex gap-1" onclick="event.stopPropagation()">
                                    <button class="btn-icon btn-edit" title="Edit Subject"
                                        data-subject="<%= JSON.stringify(s) %>"
                                        onclick="openEditSubject(JSON.parse(this.dataset.subject))">
                                        <i class="fas fa-pen"></i>
                                    </button>
                                    <button class="btn-icon btn-delete" title="Delete Subject"
                                        onclick="confirmDeleteSubject(<%= s.subject_id %>, '<%= s.subject_name.replace(/'/g,"\\'") %>', <%= s.quarterCount || 0 %>, <%= s.topicCount || 0 %>)">
                                        <i class="fas fa-trash"></i>
                                    </button>
                                </div>
                            </div>
                            <p class="font-black text-slate-800 text-sm leading-tight mb-1"><%= s.subject_name %></p>
                            <p class="text-[10px] font-mono text-slate-400 mb-2"><%= s.subject_code || '—' %></p>
                            <div class="flex items-center gap-2 flex-wrap">
                                <span class="badge badge-active">Sem <%= s.semester %></span>
                                <span class="text-[10px] text-slate-400 font-medium"><%= s.quarterCount || 0 %> quarters</span>
                            </div>
                            <p class="text-xs text-indigo-500 font-bold mt-2">Click to manage →</p>
                        </div>
                    <% }) %>
                    <% if (subjects.length === 0) { %>
                        <div class="col-span-full py-16 text-center text-slate-400">
                            <i class="fas fa-book-open text-4xl mb-3 block opacity-30"></i>
                            <p class="font-bold">No subjects yet. Add your first subject.</p>
                        </div>
                    <% } %>
                    </div>
                </div>

                <!-- ═══════════════════════════════════
                     SECTION C: DRILL-DOWN PANEL
                     Appears when a subject is selected
                ═══════════════════════════════════ -->
                <div id="drillPanel" class="hidden">

                    <!-- Drill Header -->
                    <div class="glass-card rounded-2xl border border-indigo-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between flex-wrap gap-3">
                            <div class="flex items-center gap-3">
                                <button onclick="closeDrill()"
                                    class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-rose-100 text-slate-500 hover:text-rose-600 transition flex items-center justify-center">
                                    <i class="fas fa-arrow-left"></i>
                                </button>
                                <div>
                                    <p class="text-xs text-slate-400 font-bold uppercase tracking-wider">Currently Managing</p>
                                    <h3 id="drillTitle" class="font-black text-indigo-900 text-lg"></h3>
                                </div>
                            </div>
                            <!-- Drill Tab Bar -->
                            <div class="flex items-center gap-2 flex-wrap">
                                <button class="tab-btn active flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchDrillTab('dt-curriculum', this)">
                                    <i class="fas fa-sitemap"></i> Curriculum
                                </button>
                                <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchDrillTab('dt-classes', this)">
                                    <i class="fas fa-school"></i> Classes
                                </button>
                                <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchDrillTab('dt-progress', this)">
                                    <i class="fas fa-chart-bar"></i> Progress
                                </button>
                                <button class="tab-btn flex items-center gap-2 px-4 py-2 rounded-xl font-bold text-sm text-slate-600" onclick="switchDrillTab('dt-announcements', this)">
                                    <i class="fas fa-bullhorn"></i> Announcements
                                </button>
                                <button class="tab-btn btn-arcade flex items-center gap-2 px-4 py-2 rounded-xl text-sm" onclick="switchDrillTab('dt-arcade', this)">
                                    <i class="fas fa-gamepad"></i> Arcade Config
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- ── DRILL TAB: CURRICULUM ── -->
                    <div id="dt-curriculum" class="tab-pane active glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between mb-4">
                            <h4 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-sitemap text-indigo-400"></i> Quarters & Topics
                            </h4>
                            <button id="btnAddQuarter" onclick="openAddQuarter()"
                                class="flex items-center gap-2 bg-indigo-100 text-indigo-700 font-bold text-xs px-3 py-2 rounded-xl hover:bg-indigo-200 transition">
                                <i class="fas fa-plus"></i> Add Quarter
                            </button>
                        </div>

                        <div id="quartersContainer" class="space-y-4">
                            <div class="text-center py-10 text-slate-400">
                                <i class="fas fa-spinner fa-spin text-2xl mb-2 block text-indigo-300"></i>
                                <p class="text-sm font-medium">Select a subject to load quarters.</p>
                            </div>
                        </div>
                    </div>

                    <!-- ── DRILL TAB: CLASSES ── -->
                    <div id="dt-classes" class="tab-pane glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                            <h4 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-school text-rose-400"></i> Classes Under This Subject
                            </h4>
                            <div class="flex gap-2">
                                <button onclick="openAddClass()"
                                    class="flex items-center gap-2 bg-rose-100 text-rose-700 font-bold text-xs px-3 py-2 rounded-xl hover:bg-rose-200 transition">
                                    <i class="fas fa-plus"></i> Add Class
                                </button>
                                <button onclick="openModal('modalBulkEnroll')"
                                    class="flex items-center gap-2 border border-rose-200 text-rose-600 font-bold text-xs px-3 py-2 rounded-xl hover:bg-rose-50 transition">
                                    <i class="fas fa-file-excel"></i> Bulk Enroll
                                </button>
                            </div>
                        </div>
                        <div id="classesContainer">
                            <div class="text-center py-8 text-slate-400 text-sm">Select a subject to view classes.</div>
                        </div>
                    </div>

                    <!-- ── DRILL TAB: PROGRESS ── -->
                    <div id="dt-progress" class="tab-pane glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                            <h4 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-chart-bar text-cyan-400"></i> Student Progress Tracker
                            </h4>
                            <div class="flex gap-2">
                                <select id="progressClassFilter" class="search-input px-3 py-2 rounded-xl border border-slate-200 text-sm bg-white" onchange="loadProgress()">
                                    <option value="">All Classes</option>
                                </select>
                            </div>
                        </div>
                        <div id="progressContainer">
                            <div class="text-center py-8 text-slate-400 text-sm">Select a subject to view student progress.</div>
                        </div>
                    </div>

                    <!-- ── DRILL TAB: ANNOUNCEMENTS ── -->
                    <div id="dt-announcements" class="tab-pane glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                            <h4 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-bullhorn text-amber-400"></i> Announcements
                            </h4>
                            <button onclick="openAddAnnouncement()"
                                class="flex items-center gap-2 bg-amber-100 text-amber-700 font-bold text-xs px-3 py-2 rounded-xl hover:bg-amber-200 transition">
                                <i class="fas fa-plus"></i> New Announcement
                            </button>
                        </div>
                        <div id="announcementsContainer">
                            <div class="text-center py-8 text-slate-400 text-sm">Select a subject to view announcements.</div>
                        </div>
                    </div>

                    <!-- ── DRILL TAB: ARCADE CONFIG ── -->
                    <div id="dt-arcade" class="tab-pane glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                            <h4 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-gamepad text-amber-400"></i> Arcade & Gamification Config
                            </h4>
                        </div>

                        <!-- Leaderboard History -->
                        <div class="mb-6">
                            <div class="flex items-center justify-between mb-3">
                                <p class="font-bold text-slate-700 flex items-center gap-2">
                                    <i class="fas fa-trophy text-yellow-500"></i> Leaderboard Snapshots
                                </p>
                            </div>
                            <div id="leaderboardContainer">
                                <div class="text-center py-6 text-slate-400 text-sm">Select a subject to load leaderboard data.</div>
                            </div>
                        </div>

                    </div>

                </div><!-- end drillPanel -->

            </div><!-- end p-4 -->

            <!-- FOOTER -->
            <footer class="bg-white border-t border-cyan-100 py-6 px-8 mt-auto w-full">
                <div class="flex flex-col md:flex-row justify-between items-center gap-2 max-w-[1600px] mx-auto">
                    <p class="text-[11px] text-indigo-400 font-black uppercase tracking-tight">
                        &copy; 2026 <span class="text-cyan-600">Chemistry Arcade</span> — Mabini College v2.5.0
                    </p>
                    <div class="flex gap-4">
                        <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest">Support Lab</a>
                        <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest border-l pl-4 border-indigo-100">Atomic Logs</a>
                    </div>
                </div>
            </footer>
        </div>
    </main>
</div>

<!-- ═══════════════════════════════════════════════
     MODALS
═══════════════════════════════════════════════ -->

<!-- ADD SCHOOL YEAR (4-SECTION COMPREHENSIVE MODAL) -->
<div id="modalAddSY" class="modal-overlay">
    <div class="modal-box max-w-4xl w-full p-0 flex flex-col max-h-[92vh] overflow-hidden rounded-3xl shadow-2xl">
        <!-- Modal Header -->
        <div class="flex items-center justify-between px-6 py-4 border-b border-slate-100 bg-gradient-to-r from-indigo-900 to-slate-900 text-white shrink-0">
            <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center text-emerald-400 text-lg">
                    <i class="fas fa-calendar-plus"></i>
                </div>
                <div>
                    <h3 class="font-black text-white text-lg leading-tight">Add School Year</h3>
                    <p class="text-xs text-indigo-200">Institutional timeline, semestral quarters, enrollment windows &amp; rollover</p>
                </div>
            </div>
            <button onclick="closeModal('modalAddSY')" class="w-9 h-9 rounded-xl bg-white/10 hover:bg-rose-500/80 text-white/80 hover:text-white transition flex items-center justify-center">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- 4-Step Tab Navigation Bar -->
        <div class="bg-slate-50 border-b border-slate-200 px-6 py-2.5 flex items-center justify-between gap-2 overflow-x-auto shrink-0">
            <button type="button" onclick="switchAddSYTab(1)" id="tabAddBtn1" class="add-sy-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-black transition text-indigo-700 bg-white shadow-sm border border-slate-200">
                <span class="w-5 h-5 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px]">1</span>
                <span>General Details</span>
            </button>
            <i class="fas fa-chevron-right text-slate-300 text-[10px]"></i>
            <button type="button" onclick="switchAddSYTab(2)" id="tabAddBtn2" class="add-sy-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold transition text-slate-500 hover:text-slate-800">
                <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px]">2</span>
                <span>Timeline (2 Sem × 2 Qtr)</span>
            </button>
            <i class="fas fa-chevron-right text-slate-300 text-[10px]"></i>
            <button type="button" onclick="switchAddSYTab(3)" id="tabAddBtn3" class="add-sy-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold transition text-slate-500 hover:text-slate-800">
                <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px]">3</span>
                <span>Enrollment &amp; Prerequisite</span>
            </button>
            <i class="fas fa-chevron-right text-slate-300 text-[10px]"></i>
            <button type="button" onclick="switchAddSYTab(4)" id="tabAddBtn4" class="add-sy-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold transition text-slate-500 hover:text-slate-800">
                <span class="w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px]">4</span>
                <span>Content Rollover</span>
            </button>
        </div>

        <!-- Form Body (Scrollable) -->
        <form id="addSYForm" onsubmit="submitAddSY(event)" class="p-6 overflow-y-auto space-y-6 flex-1 bg-white">
            
            <!-- ═════════ TAB 1: GENERAL DETAILS ═════════ -->
            <div id="tabAddPane1" class="add-sy-pane space-y-5">
                <div class="bg-indigo-50/60 rounded-2xl p-4 border border-indigo-100 flex items-start gap-3">
                    <i class="fas fa-info-circle text-indigo-600 mt-0.5 text-base"></i>
                    <div class="text-xs text-indigo-950 leading-relaxed">
                        <span class="font-bold">Institutional School Year Context:</span> Set the overall academic year label, valid date range, and deployment status. You can configure upcoming school years in advance as a <span class="font-bold text-sky-700">Draft</span> without disrupting the currently active academic term.
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Academic Year Range *</label>
                        <input type="text" id="addSYInput" name="sy_range" required
                            placeholder="e.g. <%= new Date().getFullYear() %>-<%= new Date().getFullYear() + 1 %>"
                            maxlength="9" pattern="\d{4}-\d{4}"
                            oninput="validateSYInput(this)"
                            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-indigo-500 bg-white">
                        <p class="text-[11px] text-slate-400 mt-1">Format: YYYY-YYYY · e.g., 2026-2027</p>
                        <p id="addSYError" class="text-[11px] text-rose-500 font-bold mt-1 hidden"></p>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Academic Year Code / Label</label>
                        <input type="text" id="addSYCode" name="sy_code" placeholder="e.g. SY26-27" maxlength="20"
                            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm font-mono focus:ring-2 focus:ring-indigo-500 bg-white">
                        <p class="text-[11px] text-slate-400 mt-1">Short identifier used in transcript tags &amp; cards</p>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Overall Opening Date</label>
                        <input type="date" id="addSYStartDate" name="start_date"
                            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 bg-white">
                        <p class="text-[11px] text-slate-400 mt-1">Official start of the academic year (e.g. Aug 24)</p>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">Overall Closing Date</label>
                        <input type="date" id="addSYEndDate" name="end_date"
                            class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm focus:ring-2 focus:ring-indigo-500 bg-white">
                        <p class="text-[11px] text-slate-400 mt-1">Official end of the academic year (e.g. May 28)</p>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5 uppercase tracking-wider">School Year Status *</label>
                        <select id="addSYStatus" name="status" onchange="syncAddSYStatus(this.value)" class="w-full px-3.5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-800 focus:ring-2 focus:ring-indigo-500 bg-white">
                            <option value="Draft" selected>Draft (Preparation Mode / Inactive)</option>
                            <option value="Current">Current (Official Running School Year)</option>
                            <option value="Archive">Archive (Historical / Closed)</option>
                        </select>
                        <p class="text-[11px] text-slate-400 mt-1">Selecting Current automatically activates this school year across all portals</p>
                    </div>

                    <div class="flex items-center pt-5">
                        <label class="flex items-center gap-3 cursor-pointer p-3 rounded-xl border border-slate-200 hover:bg-slate-50 transition w-full">
                            <input type="checkbox" id="addSYIsActive" name="is_active" value="1" onchange="syncAddSYActive(this.checked)" class="w-4 h-4 rounded text-emerald-600 focus:ring-emerald-500 border-slate-300">
                            <div>
                                <span class="text-xs font-bold text-slate-800 block">Set as Active School Year</span>
                                <span class="text-[10px] text-slate-500">Makes this the current live academic context across the portal</span>
                            </div>
                        </label>
                    </div>
                </div>
            </div>

            <!-- ═════════ TAB 2: SEMESTRAL & QUARTERLY TIMELINE ═════════ -->
            <div id="tabAddPane2" class="add-sy-pane space-y-6 hidden">
                <div class="bg-amber-50/70 rounded-2xl p-4 border border-amber-200/80 flex items-start gap-3">
                    <i class="fas fa-stream text-amber-600 mt-0.5 text-base"></i>
                    <div class="text-xs text-amber-950 leading-relaxed">
                        <span class="font-bold">Preset Institutional Structure:</span> The curriculum framework is permanently structured into <span class="font-bold">2 Semesters</span> with <span class="font-bold">2 Quarters</span> each (Sem 1: Chemistry 1, Q1 &amp; Q2; Sem 2: Chemistry 2, Q3 &amp; Q4). Encode the period dates and instructor grade encoding deadlines below.
                    </div>
                </div>

                <!-- 1st Semester Section -->
                <div class="bg-slate-50 rounded-2xl p-5 border border-slate-200 space-y-4">
                    <div class="flex items-center justify-between pb-2 border-b border-slate-200">
                        <div class="flex items-center gap-2">
                            <span class="w-6 h-6 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-xs font-black">S1</span>
                            <h4 class="text-sm font-black text-indigo-900">1st Semester (Chemistry 1)</h4>
                        </div>
                        <span class="text-[10px] font-bold uppercase tracking-wider text-indigo-600 bg-indigo-100 px-2.5 py-0.5 rounded-full">Subject: Chemistry 1</span>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1 uppercase">Semester 1 Start Date</label>
                            <input type="date" id="addSem1Start" name="sem1_start_date" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-600 mb-1 uppercase">Semester 1 End Date</label>
                            <input type="date" id="addSem1End" name="sem1_end_date" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white">
                        </div>
                    </div>

                    <!-- Q1 & Q2 Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 pt-2">
                        <!-- Quarter 1 -->
                        <div class="bg-white p-4 rounded-xl border border-slate-200 space-y-3">
                            <div class="flex items-center justify-between">
                                <span class="text-xs font-black text-slate-800"><i class="fas fa-bookmark text-indigo-500 mr-1.5"></i>Quarter 1 Range</span>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                <div>
                                    <label class="block text-[10px] font-bold text-slate-500 mb-1 uppercase">Q1 Start</label>
                                    <input type="date" id="addQ1Start" name="q1_start_date" class="w-full px-2.5 py-1.5 rounded-lg border border-slate-200 text-xs bg-slate-50">
                                </div>
