                            <label class="block text-[10px] font-bold text-slate-500 mb-1 uppercase">Enrollment Opens</label>
                            <input type="datetime-local" id="addSem1EnrollStart" name="sem1_enrollment_start" class="w-full px-3 py-2 rounded-xl border border-slate-200 text-xs bg-white">
                        </div>
