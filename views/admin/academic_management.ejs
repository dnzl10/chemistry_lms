<!-- ===================== SCRIPTS ===================== -->
<script>
// ─── State ───────────────────────────────────────────────────────────────────
let activeDrillSubjectId   = null;
let activeDrillSubjectName = '';
let bulkSubjectFile        = null;
let bulkEnrollFile         = null;

// ─── Sidebar ─────────────────────────────────────────────────────────────────
function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    sb.classList.toggle('-translate-x-full');
    ov.classList.toggle('hidden');
}

// ─── Modal helpers ────────────────────────────────────────────────────────────
function openModal(id) {
    document.getElementById(id).classList.add('open');
    document.body.style.overflow = 'hidden';
    if (id === 'modalAddSY') {
        const form = document.getElementById('addSYForm');
        if (form) form.reset();
        switchAddSYTab(1);
        onSourceSYChange('');
    }
}
function closeModal(id) {
    document.getElementById(id).classList.remove('open');
    document.body.style.overflow = '';
}
document.querySelectorAll('.modal-overlay').forEach(o => {
    o.addEventListener('click', function(e) {
        if (e.target === this) {
            if (this.id === 'modalAddQuarter') {
                requestCloseAddQuarter();
            } else {
                closeModal(this.id);
            }
        }
    });
});
document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape' || e.key === 'Esc') {
        const qm = document.getElementById('modalAddQuarter');
        if (qm && qm.classList.contains('open')) {
            requestCloseAddQuarter();
        }
    }
});

// ─── Toast ────────────────────────────────────────────────────────────────────
function showToast(msg, type = 'info') {
    const t = document.getElementById('toast');
    document.getElementById('toastMsg').textContent = msg;
    t.className = `show ${type}`;
    document.getElementById('toastIcon').className = `fas ${type==='success'?'fa-check-circle':type==='error'?'fa-circle-xmark':'fa-circle-info'}`;
    setTimeout(() => { t.className = ''; }, 3500);
}

// ─── Confirm modal ────────────────────────────────────────────────────────────
function showConfirm({ icon, iconBg, iconColor, title, desc, btnLabel, btnColor, onConfirm }) {
    const el = document.getElementById('confirmIcon');
    el.className = `w-16 h-16 rounded-2xl flex items-center justify-center mx-auto mb-4 text-2xl ${iconBg}`;
    el.innerHTML = `<i class="fas ${icon} ${iconColor}"></i>`;
    document.getElementById('confirmTitle').textContent = title;
    document.getElementById('confirmDesc').textContent  = desc;
    const btn = document.getElementById('confirmBtn');
    btn.textContent = btnLabel;
    btn.className   = `px-5 py-2.5 rounded-xl text-white text-sm font-bold hover:opacity-90 transition shadow-md ${btnColor}`;
    btn.onclick     = onConfirm;
    openModal('modalConfirm');
}

// ─── Subject filter ───────────────────────────────────────────────────────────
function filterSubjects() {
    const q   = document.getElementById('subjectSearch').value.toLowerCase();
    const sem = document.getElementById('semesterFilter').value;
    document.querySelectorAll('.subject-card').forEach(card => {
        const nameMatch = !q || card.dataset.name.includes(q);
        const semMatch  = !sem || card.dataset.semester === sem;
        card.style.display = (nameMatch && semMatch) ? '' : 'none';
    });
}

// ─── Drill-down ───────────────────────────────────────────────────────────────
function drillIntoSubject(subjectId, subjectName) {
    activeDrillSubjectId   = subjectId;
    activeDrillSubjectName = subjectName;

    // Breadcrumb
    document.getElementById('bc-subject').textContent      = subjectName;
    document.getElementById('bc-subject').classList.add('active');

    // Highlight selected card
    document.querySelectorAll('.subject-card').forEach(c => c.classList.remove('selected'));
    const card = document.querySelector(`.subject-card[data-id="${subjectId}"]`);
    if (card) card.classList.add('selected');

    // Show drill panel
    document.getElementById('drillPanel').classList.remove('hidden');
    document.getElementById('drillTitle').textContent = subjectName;

    // Scroll to panel
    document.getElementById('drillPanel').scrollIntoView({ behavior: 'smooth', block: 'start' });

    // Load default tab data
    loadQuarters();
    loadClasses();
}

function closeDrill() {
    activeDrillSubjectId = null;
    document.getElementById('drillPanel').classList.add('hidden');
    document.querySelectorAll('.subject-card').forEach(c => c.classList.remove('selected'));
    document.getElementById('bc-subject').textContent = '—';
    document.getElementById('bc-subject').classList.remove('active');
}

// ─── Tab switching ────────────────────────────────────────────────────────────
function switchDrillTab(tabId, btn) {
    document.querySelectorAll('#drillPanel .tab-pane').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('#drillPanel .tab-btn').forEach(b => b.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
    btn.classList.add('active');

    // Lazy load tab data
    if (tabId === 'dt-progress')       loadProgress();
    if (tabId === 'dt-announcements')  loadAnnouncements();
}

// ─── API helpers ──────────────────────────────────────────────────────────────
async function apiPost(url, body) {
    const res  = await fetch(url, { method:'POST', headers:{'Content-Type':'application/json'}, body:JSON.stringify(body) });
    return res.json();
}
async function apiDelete(url) {
    const res = await fetch(url, { method:'DELETE' });
    return res.json();
}

// ─── School Year (Comprehensive Modal Management) ─────────────────────────
let currentAddSYTab = 1;
function switchAddSYTab(tabNum) {
    currentAddSYTab = tabNum;
    for (let i = 1; i <= 4; i++) {
        const pane = document.getElementById(`tabAddPane${i}`);
        const btn  = document.getElementById(`tabAddBtn${i}`);
        if (pane) pane.classList.toggle('hidden', i !== tabNum);
        if (btn) {
            if (i === tabNum) {
                btn.className = 'add-sy-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-black transition text-indigo-700 bg-white shadow-sm border border-slate-200';
                btn.querySelector('span:first-child').className = 'w-5 h-5 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px]';
            } else {
                btn.className = 'add-sy-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold transition text-slate-500 hover:text-slate-800';
                btn.querySelector('span:first-child').className = 'w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px]';
            }
        }
    }

    const indicator = document.getElementById('addSYStepIndicator');
    if (indicator) indicator.textContent = `Step ${tabNum} of 4`;

    const prevBtn   = document.getElementById('btnAddSYPrev');
    const nextBtn   = document.getElementById('btnAddSYNext');
    const submitBtn = document.getElementById('btnAddSYSubmit');

    if (prevBtn)   prevBtn.classList.toggle('hidden', tabNum === 1);
    if (nextBtn)   nextBtn.classList.toggle('hidden', tabNum === 4);
    if (submitBtn) submitBtn.classList.toggle('hidden', tabNum !== 4);
}

function nextAddSYTab() {
    if (currentAddSYTab < 4) switchAddSYTab(currentAddSYTab + 1);
}
function prevAddSYTab() {
    if (currentAddSYTab > 1) switchAddSYTab(currentAddSYTab - 1);
}

let currentEditSYTab = 1;
function switchEditSYTab(tabNum) {
    currentEditSYTab = tabNum;
    for (let i = 1; i <= 3; i++) {
        const pane = document.getElementById(`tabEditPane${i}`);
        const btn  = document.getElementById(`tabEditBtn${i}`);
        if (pane) pane.classList.toggle('hidden', i !== tabNum);
        if (btn) {
            if (i === tabNum) {
                btn.className = 'edit-sy-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-black transition text-indigo-700 bg-white shadow-sm border border-slate-200';
                btn.querySelector('span:first-child').className = 'w-5 h-5 rounded-full bg-indigo-600 text-white flex items-center justify-center text-[10px]';
            } else {
                btn.className = 'edit-sy-tab-btn flex items-center gap-2 px-3 py-1.5 rounded-xl text-xs font-bold transition text-slate-500 hover:text-slate-800';
                btn.querySelector('span:first-child').className = 'w-5 h-5 rounded-full bg-slate-200 text-slate-600 flex items-center justify-center text-[10px]';
            }
        }
    }
}

async function onSourceSYChange(sourceId) {
    const box = document.getElementById('rolloverPreviewBox');
    const retentionSec = document.getElementById('rolloverRetentionControlsSection');
    const visSec = document.getElementById('rolloverVisibilitySection');
    const chkMaterials = document.getElementById('addRolloverMaterials');
    const chkAssessments = document.getElementById('addRolloverAssessments');
    const chkQB = document.getElementById('addRolloverQB');
    const selVisibility = document.getElementById('addRolloverVisibility');

    if (!sourceId) {
        if (box) box.classList.add('hidden');
        // Uncheck all retention options and lock
        if (chkMaterials) { chkMaterials.checked = false; chkMaterials.disabled = true; }
        if (chkAssessments) { chkAssessments.checked = false; chkAssessments.disabled = true; }
        if (chkQB) { chkQB.checked = false; chkQB.disabled = true; }
        // Lock Default Rollover Visibility dropdown
        if (selVisibility) { selVisibility.disabled = true; }
        // Visually indicate locked / not applicable state
        if (retentionSec) retentionSec.classList.add('opacity-40', 'pointer-events-none');
        if (visSec) visSec.classList.add('opacity-40', 'pointer-events-none');
        return;
    }

    // Preceding cohort selected -> unlock controls
    if (chkMaterials) { chkMaterials.disabled = false; chkMaterials.checked = true; }
    if (chkAssessments) { chkAssessments.disabled = false; chkAssessments.checked = false; }
    if (chkQB) { chkQB.disabled = false; chkQB.checked = false; }
    if (selVisibility) { selVisibility.disabled = false; }
    if (retentionSec) retentionSec.classList.remove('opacity-40', 'pointer-events-none');
    if (visSec) visSec.classList.remove('opacity-40', 'pointer-events-none');

    if (box) {
        box.classList.remove('hidden');
        document.getElementById('rolloverPreviewStatus').textContent = 'Analyzing...';
        try {
            const res = await fetch(`/admin/am/school-years/${sourceId}/rollover-preview`);
            const data = await res.json();
            if (data.success) {
                document.getElementById('rolloverPreviewStatus').textContent = 'Ready to Rollover';
                document.getElementById('prevClassCount').textContent = `${data.classesCount} section(s)`;
                document.getElementById('prevMatCount').textContent = `${data.materialsCount} material(s)`;
                document.getElementById('prevQBCount').textContent = `${data.questionBankCount} items`;
            } else {
                document.getElementById('rolloverPreviewStatus').textContent = 'Preview unavailable';
            }
        } catch (e) {
            console.error('Failed to preview rollover:', e);
            document.getElementById('rolloverPreviewStatus').textContent = 'Error loading preview';
        }
    }
}

// ─── School Year Status & Active Dynamic Auto-Sync ─────────────────────────
function syncAddSYStatus(statusVal) {
    const activeCb = document.getElementById('addSYIsActive');
    if (!activeCb) return;
    if (statusVal === 'Current') {
        activeCb.checked = true;
    } else {
        activeCb.checked = false;
    }
}

function syncAddSYActive(isChecked) {
    const statusSelect = document.getElementById('addSYStatus');
    if (!statusSelect) return;
    if (isChecked) {
        statusSelect.value = 'Current';
    } else if (statusSelect.value === 'Current') {
        statusSelect.value = 'Draft';
    }
}

function syncEditSYStatus(statusVal) {
    const activeCb = document.getElementById('editSYIsActive');
    if (!activeCb) return;
    if (statusVal === 'Current') {
        activeCb.checked = true;
    } else {
        activeCb.checked = false;
    }
}

function syncEditSYActive(isChecked) {
    const statusSelect = document.getElementById('editSYStatus');
    if (!statusSelect) return;
    if (isChecked) {
        statusSelect.value = 'Current';
    } else if (statusSelect.value === 'Current') {
        statusSelect.value = 'Draft';
    }
}

async function submitAddSY(e) {
    e.preventDefault();
    const form = document.getElementById('addSYForm');
    const fd   = new FormData(form);
    const payload = Object.fromEntries(fd.entries());

    // Checkbox normalization & canonical status
    payload.status = document.getElementById('addSYStatus').value;
    payload.is_active = document.getElementById('addSYIsActive').checked ? 1 : 0;
    if (payload.status === 'Current') payload.is_active = 1;
    if (payload.is_active === 1) payload.status = 'Current';

    payload.enforce_prerequisite = document.getElementById('addEnforcePrereq').checked ? 1 : 0;
    if (!payload.source_sy_id) {
        payload.rollover_materials = 0;
        payload.rollover_assessments = 0;
        payload.rollover_question_bank = 0;
        payload.rollover_announcements = 0;
        payload.default_rollover_visibility = 'visible';
    } else {
        payload.rollover_materials = document.getElementById('addRolloverMaterials').checked ? 1 : 0;
        payload.rollover_assessments = document.getElementById('addRolloverAssessments').checked ? 1 : 0;
        payload.rollover_question_bank = document.getElementById('addRolloverQB').checked ? 1 : 0;
        payload.rollover_announcements = 0; // Announcements & forums are cohort-specific and permanently non-reusable
    }

    payload.archive_outgoing_cohort = document.getElementById('addArchiveOutgoingCohort')?.checked ? 1 : 0;

    const data = await apiPost('/admin/am/school-years', payload);
    if (data.success) {
        showToast(data.message || 'School year created successfully!', 'success');
        closeModal('modalAddSY');
        form.reset();
        switchAddSYTab(1);
        refreshAdminContent({ message: 'Updating academic management...' });
    } else {
        showToast(data.message || 'Failed to create school year.', 'error');
    }
}

// ─── Student Cohort Lifecycle Management ─────────────────────────────────────
async function openStudentLifecycleModal() {
    openModal('modalStudentLifecycle');
    await loadLifecycleCohortSummary();
}

async function loadLifecycleCohortSummary() {
    const icon = document.getElementById('lifecycleRefreshIcon');
    if (icon) icon.classList.add('animate-spin');

    try {
        const res = await fetch('/admin/lifecycle/cohort-summary');
        const data = await res.json();
        if (data.success && data.summary) {
            const s = data.summary;
            const activeCohortCount = s.activeCohortCount ?? s.outgoingCohortActive ?? 0;
            document.getElementById('lifecycleActiveCohort').textContent = activeCohortCount;
            document.getElementById('lifecycleDormant').textContent = s.dormantUnenrolled ?? 0;
            document.getElementById('lifecycleArchived').textContent = s.totalArchived ?? 0;

            // Update button states
            const btnArch = document.getElementById('btnArchiveOutgoingCohort');
            if (btnArch) btnArch.disabled = (activeCohortCount === 0);

            const btnDorm = document.getElementById('btnEnforceDormancy');
            if (btnDorm) btnDorm.disabled = (s.dormantUnenrolled === 0);
        }
    } catch (err) {
        console.error('[Cohort Summary Error]', err);
        showToast('Failed to load cohort breakdown.', 'error');
    } finally {
        if (icon) icon.classList.remove('animate-spin');
    }
}

function executeArchiveOutgoingCohort() {
    showConfirm({
        icon: 'fa-user-lock', iconBg: 'bg-rose-100', iconColor: 'text-rose-600',
        title: 'Archive Outgoing Chemistry Cohort?',
        desc: 'This will deactivate all student accounts completing Chemistry to eliminate unauthorized access during Grade 12. All coursework, grades, transcripts, and simulation scores are preserved permanently. Proceed?',
        btnLabel: 'Yes, Archive Outgoing Cohort', btnColor: 'bg-rose-600',
        onConfirm: async () => {
            closeModal('modalConfirm');
            const logEl = document.getElementById('lifecycleActionLog');
            if (logEl) {
                logEl.classList.remove('hidden');
                logEl.innerHTML = '⏳ Archiving outgoing Chemistry cohort...';
            }
            try {
