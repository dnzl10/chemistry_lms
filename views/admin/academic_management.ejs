// ─── Classes ──────────────────────────────────────────────────────────────────
async function loadClasses() {
    if (!activeDrillSubjectId) return;
    const container = document.getElementById('classesContainer');
    container.innerHTML = `<div class="text-center py-8"><i class="fas fa-spinner fa-spin text-rose-300 text-2xl"></i></div>`;
    try {
        const curSyId = new URLSearchParams(window.location.search).get('sy_id');
        const res  = await fetch(`/admin/am/subjects/${activeDrillSubjectId}/classes${curSyId ? '?sy_id=' + curSyId : ''}`);
        const data = await res.json();
        if (!data.success) { container.innerHTML = `<p class="text-rose-500 text-sm">${data.message}</p>`; return; }
        const classes = data.classes;

        // Populate bulk enroll dropdown with enrollment window awareness
        const sel = document.getElementById('bulkEnrollClassId');
        const now = new Date();
        sel.innerHTML = '<option value="">— Select Class —</option>' + classes.map(c => {
            let label = c.class_name;
            let statusSuffix = '';
            let isClosed = false;
            let isUpcoming = false;
            if (c.enrollment_end && now > new Date(c.enrollment_end)) {
                isClosed = true;
                const endStr = new Date(c.enrollment_end).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' });
                statusSuffix = ` [Closed on ${endStr}]`;
            } else if (c.enrollment_start && now < new Date(c.enrollment_start)) {
                isUpcoming = true;
                const startStr = new Date(c.enrollment_start).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' });
                statusSuffix = ` [Opens on ${startStr}]`;
            }
            const disabledAttr = (isClosed || isUpcoming) ? 'disabled style="color: #ef4444; font-weight: 600;"' : '';
            return `<option value="${c.class_id}" ${disabledAttr} data-closed="${isClosed ? '1' : '0'}" data-upcoming="${isUpcoming ? '1' : '0'}" data-semester="${c.semester || 1}" data-start="${c.enrollment_start ? new Date(c.enrollment_start).toISOString() : ''}" data-end="${c.enrollment_end ? new Date(c.enrollment_end).toISOString() : ''}">${label}${statusSuffix}</option>`;
        }).join('');
        if (typeof onBulkEnrollClassChanged === 'function') onBulkEnrollClassChanged(sel);

        // Populate announcement class filter
        const annSel = document.getElementById('annClassTarget');
        annSel.innerHTML = '<option value="">All Classes (Subject-wide)</option>' + classes.map(c => `<option value="${c.class_id}">${c.class_name}</option>`).join('');

        // Populate progress class filter
        const progSel = document.getElementById('progressClassFilter');
        progSel.innerHTML = '<option value="">All Classes</option>' + classes.map(c => `<option value="${c.class_id}">${c.class_name}</option>`).join('');

        if (classes.length === 0) {
            container.innerHTML = `<div class="text-center py-10 text-slate-400"><i class="fas fa-school text-3xl mb-2 block opacity-30"></i><p class="font-bold text-sm">No classes yet for this subject.</p></div>`;
            return;
        }
        // Show active SY notice
        const syNotice = data.activeSY
            ? `<p class="text-[11px] text-emerald-600 font-bold mb-3"><i class="fas fa-circle-check mr-1"></i>Showing classes under active SY: ${data.activeSY.sy_range}. To view past classes, activate that school year.</p>`
            : `<p class="text-[11px] text-amber-600 font-bold mb-3"><i class="fas fa-exclamation-triangle mr-1"></i>No active school year. Activate a school year to see classes.</p>`;

        container.innerHTML = syNotice + `
            <div class="space-y-2">
            ${classes.map(c => `
                <div class="rounded-xl border border-slate-100 bg-slate-50 overflow-hidden">
                    <!-- Class Row Header -->
                    <div class="flex items-center gap-3 p-3 cursor-pointer hover:bg-slate-100 transition"
                         onclick="toggleClassStudents(${c.class_id}, this)">
                        <div class="w-8 h-8 rounded-lg bg-gradient-to-br from-indigo-500 to-cyan-500 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-chalkboard text-white text-xs"></i>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="font-bold text-slate-800 text-sm">${c.class_name}</p>
                            <p class="text-[11px] text-slate-400">${c.teacher_name || 'No teacher assigned'} · ${c.sy_range || '—'}</p>
                        </div>
                        <span class="badge badge-active text-xs" id="class-count-badge-${c.class_id}">${c.student_count || 0} students</span>
                        <div class="flex items-center gap-1" onclick="event.stopPropagation()">
                            <button class="btn-icon" style="color: #64748b; background: #f8fafc; border: 1px solid #e2e8f0; width: 32px; height: 32px; border-radius: 8px; font-size: 12px; transition: all 0.2s;" title="Enrollment Config" onmouseover="this.style.color='#4f46e5'; this.style.backgroundColor='#e0e7ff'" onmouseout="this.style.color='#64748b'; this.style.backgroundColor='#f8fafc'" onclick="openClassConfigModal(${c.class_id}, '${c.class_name.replace(/'/g,"\\'")}')"><i class="fas fa-cog"></i></button>
                            <button class="btn-icon btn-edit" title="Edit" onclick="editClassModal(${JSON.stringify(c).replace(/"/g,'&quot;')})"><i class="fas fa-pen"></i></button>
                            <button class="btn-icon btn-delete" title="Delete" onclick="confirmDeleteClass(${c.class_id},'${c.class_name.replace(/'/g,"\\'")}',${c.student_count||0})"><i class="fas fa-trash"></i></button>
                        </div>
                        <i class="fas fa-chevron-down text-slate-300 text-xs transition-transform" id="chevron-class-${c.class_id}"></i>
                    </div>
                    <!-- Expandable Students List -->
                    <div id="students-class-${c.class_id}" class="hidden border-t border-slate-100 bg-white">
                        <div class="p-3 text-center text-slate-400 text-xs" id="students-loading-${c.class_id}">
                            <i class="fas fa-spinner fa-spin mr-1"></i> Loading students...
                        </div>
                    </div>
                </div>`).join('')}
            </div>`;
    } catch { container.innerHTML = `<p class="text-rose-500 text-sm">Failed to load classes.</p>`; }
}

function openAddClass() {
    document.getElementById('addClassForm').reset();
    delete document.getElementById('addClassForm').dataset.editId;
    document.getElementById('addClassSubjectId').value = activeDrillSubjectId;
    document.getElementById('modalAddClassTitle').textContent = 'Add Class';
    document.querySelector('#addClassForm button[type="submit"]').innerHTML = '<i class="fas fa-plus mr-1"></i> Create Class';
    openModal('modalAddClass');
}

async function submitAddClass(e) {
    e.preventDefault();
    const form = document.getElementById('addClassForm');
    const fd   = new FormData(form);
    const editId = form.dataset.editId;
    
    const payload = {
        class_name: fd.get('class_name'),
        teacher_id: fd.get('teacher_id'),
        sy_id:      fd.get('sy_id'),
        subject_id: activeDrillSubjectId
    };

    const url = editId ? `/admin/am/classes/${editId}` : '/admin/am/classes';
    const data = await apiPost(url, payload);
    
    if (data.success) { 
        showToast(editId ? 'Class updated!' : 'Class created!', 'success'); 
        closeModal('modalAddClass'); 
        loadClasses(); 
    } else {
        showToast(data.message || 'Failed.', 'error');
    }
}

function editClassModal(c) {
    document.getElementById('addClassForm').reset();
    document.getElementById('addClassSubjectId').value = activeDrillSubjectId;
    document.querySelector('#addClassForm [name="class_name"]').value  = c.class_name;
    document.querySelector('#addClassForm [name="teacher_id"]').value  = c.teacher_id || '';
    document.querySelector('#addClassForm [name="sy_id"]').value       = c.sy_id || '';
    document.getElementById('addClassForm').dataset.editId = c.class_id;
    document.getElementById('modalAddClassTitle').textContent = 'Edit Class';
    document.querySelector('#addClassForm button[type="submit"]').innerHTML = '<i class="fas fa-save mr-1"></i> Update Class';
    openModal('modalAddClass');
}

function confirmDeleteClass(classId, name, count) {
    showConfirm({
        icon:'fa-trash', iconBg:'bg-rose-100', iconColor:'text-rose-600',
        title:`Delete class "${name}"?`,
        desc:`${count} enrolled student(s) will be unenrolled. This cannot be undone.`,
        btnLabel:'Delete Class', btnColor:'bg-rose-500',
        onConfirm: async () => {
            const data = await apiDelete(`/admin/am/classes/${classId}`);
            closeModal('modalConfirm');
            if (data.success) { showToast('Class deleted.', 'success'); loadClasses(); }
            else showToast(data.message || 'Failed.', 'error');
        }
    });
}

// ─── Enrollment Config Modals & Logic ──────────────────────────────────────────
async function openClassConfigModal(classId, className) {
    document.getElementById('config_class_id').value = classId;
    document.getElementById('modalClassConfigTitle').textContent = className + ' Settings';
    document.getElementById('modalClassConfigSubtitle').textContent = 'Loading...';
    document.getElementById('whitelistTableAdmin').innerHTML = '<tr><td colspan="4" class="p-8 text-center text-slate-400 font-medium"><i class="fas fa-spinner fa-spin mr-2"></i>Loading whitelist...</td></tr>';
    openModal('modalClassConfig');

    try {
        const res = await fetch(`/admin/am/classes/${classId}/config`);
        const data = await res.json();
        if (data.success) {
            document.getElementById('modalClassConfigSubtitle').textContent = 'Loaded securely';
            
            // Populate Settings
            const set = data.settings;
            const startEl = document.getElementById('config_start');
            const endEl   = document.getElementById('config_end');
            if (startEl) startEl.value = set.enrollment_start ? new Date(set.enrollment_start).toISOString().slice(0, 16) : '';
            if (endEl)   endEl.value   = set.enrollment_end ? new Date(set.enrollment_end).toISOString().slice(0, 16) : '';
            document.getElementById('config_cap').value   = set.max_capacity !== null ? set.max_capacity : '';
            document.getElementById('config_cap').min     = set.enrolled_count || 0;
            document.getElementById('config_enrolled_txt').textContent = `Current enrolled: ${set.enrolled_count || 0}`;

            // Populate Whitelist
            const wl = data.whitelists || [];
            let wlHtml = '';
            if (wl.length === 0) {
                wlHtml = '<tr><td colspan="4" class="p-8 text-center text-slate-400 font-medium">No whitelisted students yet.</td></tr>';
            } else {
                wlHtml = wl.map(w => `
                    <tr class="hover:bg-slate-50/50">
                        <td class="p-3 font-bold text-slate-700">${w.email}</td>
                        <td class="p-3 text-slate-500">${w.student_name || '—'}</td>
                        <td class="p-3 text-center">
                            ${w.status === 'ENROLLED' ? '<span class="px-2 py-1 bg-emerald-100 text-emerald-700 border border-emerald-200 rounded-md text-[10px] font-bold">Enrolled</span>' : '<span class="px-2 py-1 bg-amber-100 text-amber-700 border border-amber-200 rounded-md text-[10px] font-bold">Pending</span>'}
                        </td>
                        <td class="p-3 text-center">
                            <button onclick="removeWhitelistAdmin(${classId}, '${w.email}')" class="w-8 h-8 rounded-lg text-rose-500 hover:bg-rose-50 hover:text-rose-700 transition" title="Remove"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                `).join('');
            }
            document.getElementById('whitelistTableAdmin').innerHTML = wlHtml;
        } else {
            document.getElementById('modalClassConfigSubtitle').textContent = 'Failed to load';
            showToast(data.message, 'error');
        }
    } catch (e) {
        document.getElementById('modalClassConfigSubtitle').textContent = 'Error';
        showToast('Error loading configs', 'error');
    }
}

async function saveEnrollSettingsAdmin() {
    const classId = document.getElementById('config_class_id').value;
    const startEl = document.getElementById('config_start');
    const endEl   = document.getElementById('config_end');
    const cap = document.getElementById('config_cap').value;

    const res = await apiPost(`/admin/am/classes/${classId}/settings`, {
        enrollment_start: startEl ? startEl.value : null,
        enrollment_end: endEl ? endEl.value : null,
        max_capacity: cap
    });
    
    if (res.success) {
        showToast('Settings saved!', 'success');
        openClassConfigModal(classId, document.getElementById('modalClassConfigTitle').textContent.replace(' Settings', ''));
    } else {
        showToast(res.message, 'error');
    }
}

async function uploadWhitelistAdmin() {
    const classId = document.getElementById('config_class_id').value;
    const fileInput = document.getElementById('whitelistFileAdmin');
    const expireInput = document.getElementById('wl_expire_csv_admin').value;
    
    if (!fileInput.files.length) return showToast('Please select a file first.', 'error');
    if (!expireInput) return showToast('Please select an expiration date.', 'error');
    
    const formData = new FormData();
    formData.append('file', fileInput.files[0]);
    formData.append('expirationDate', expireInput);

    try {
        const res = await fetch(`/admin/am/classes/${classId}/whitelist/upload`, { method: 'POST', body: formData });
        const data = await res.json();
        if (data.success) {
            showToast(data.message, 'success');
            if (data.invalidEmails && data.invalidEmails.length > 0) {
                alert("WARNING: The following emails were skipped because they are not registered users:\n\n" + data.invalidEmails.join("\n"));
            }
            fileInput.value = '';
            document.getElementById('wl_expire_csv_admin').value = '';
            openClassConfigModal(classId, document.getElementById('modalClassConfigTitle').textContent.replace(' Settings', ''));
        } else {
            showToast(data.message, 'error');
        }
    } catch(e) {
        showToast('Upload failed', 'error');
    }
}

async function addWhitelistAdmin() {
    const classId = document.getElementById('config_class_id').value;
    const email = document.getElementById('wl_email_admin').value;
    const name = document.getElementById('wl_name_admin').value;
    const expirationDate = document.getElementById('wl_expire_manual_admin').value;
    
    if (!email) return showToast('Email is required.', 'error');
    if (!expirationDate) return showToast('Expiration date is required.', 'error');

    const res = await apiPost(`/admin/am/classes/${classId}/whitelist/add`, { email, student_name: name, expirationDate });
    if (res.success) {
        showToast(res.message, 'success');
        document.getElementById('wl_email_admin').value = '';
        document.getElementById('wl_name_admin').value = '';
        document.getElementById('wl_expire_manual_admin').value = '';
        openClassConfigModal(classId, document.getElementById('modalClassConfigTitle').textContent.replace(' Settings', ''));
    } else {
        showToast(res.message, 'error');
    }
}

async function removeWhitelistAdmin(classId, email) {
    showConfirm({
        icon: 'fa-trash', iconBg: 'bg-rose-100', iconColor: 'text-rose-600',
        title: 'Remove Student?',
        desc: `Are you sure you want to remove ${email} from the whitelist?`,
        btnLabel: 'Yes, remove', btnColor: 'bg-rose-500',
        onConfirm: async () => {
            // we will use fetch for DELETE since apiDelete sends JSON body in a way that might not work with some setups, but apiDelete is standard. Let's use apiDelete with a JSON body
            const res = await fetch(`/admin/am/classes/${classId}/whitelist/remove`, {
                method: 'DELETE',
                headers: {'Content-Type': 'application/json'},
                body: JSON.stringify({email})
            });
            const data = await res.json();
            closeModal('modalConfirm');
            if (data.success) {
                showToast(data.message, 'success');
                openClassConfigModal(classId, document.getElementById('modalClassConfigTitle').textContent.replace(' Settings', ''));
            } else {
                showToast(data.message, 'error');
            }
        }
    });
}

// ─── Class Students Roster & Actions Cache ─────────────────────────────────────
const _classStudentsCache = {};
const _classInfoCache     = {};
const _selectedStudents   = {};

