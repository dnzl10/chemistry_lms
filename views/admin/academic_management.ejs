    quarterTopicsList.push({ topic_name: '', topic_description: '', topic_objectives: '', video_url: '' });
    renderQuarterTopicsCards();
    setTimeout(() => {
        const container = document.getElementById('quarterTopicsContainer');
        if (container && container.lastElementChild) {
            container.lastElementChild.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            container.lastElementChild.querySelector('.q-topic-name')?.focus();
        }
    }, 50);
}

function removeQuarterTopicCard(idx) {
    syncQuarterTopicsFromDOM();
    if (quarterTopicsList.length <= 1) {
        showToast('A quarter must contain at least one topic.', 'error');
        return;
    }
    quarterTopicsList.splice(idx, 1);
