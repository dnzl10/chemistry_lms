                                    <span class="block text-slate-400 text-[10px]">Learning Files:</span>
                                    <span id="prevMatCount" class="font-bold text-slate-800">0</span>
                                </div>
                                <div class="bg-white p-2 rounded-lg border border-slate-200">
                                    <span class="block text-slate-400 text-[10px]">Question Items:</span>
                                    <span id="prevQBCount" class="font-bold text-slate-800">0</span>
                                </div>
                            </div>
                            <p class="text-[10px] text-emerald-700 italic"><i class="fas fa-check mr-1"></i>All student submissions, previous scores, and announcements will start fresh (0 records).</p>
                        </div>
                    </div>

                    <div id="rolloverRetentionControlsSection" class="bg-slate-50 p-5 rounded-2xl border border-slate-200 space-y-3 transition-opacity duration-200 opacity-40 pointer-events-none">
