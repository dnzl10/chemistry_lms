async function submitAddMapping(e) {
    e.preventDefault();
    const fd   = new FormData(document.getElementById('addMappingForm'));
    const data = await apiPost('/admin/am/button-mappings', { button_pin: fd.get('button_pin'), element_symbol: fd.get('element_symbol'), player_side: fd.get('player_side') });
