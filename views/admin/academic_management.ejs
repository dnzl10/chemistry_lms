            <!-- Lifecycle Actions -->
            <div class="space-y-4">
                <span class="text-xs font-black uppercase tracking-wider text-slate-500 block">Governance Actions</span>

                <!-- Action 1: Archive Outgoing Cohort -->
                <div class="p-4 rounded-2xl border border-rose-100 bg-rose-50/30 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3">
                    <div class="space-y-0.5">
                        <h4 class="text-xs font-black text-slate-800 flex items-center gap-1.5">
                            <i class="fas fa-user-lock text-rose-500"></i> Archive Outgoing Chemistry Cohort (End of School Year)
                        </h4>
                        <p class="text-[11px] text-slate-500">
                            Deactivates accounts of students who completed Chemistry to eliminate unauthorized access during Grade 12. Transcripts, scores, quiz marks, and simulation records are 100% preserved.
