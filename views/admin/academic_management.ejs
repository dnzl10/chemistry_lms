                                <p class="text-sm font-medium">Select a subject to load quarters.</p>
                            </div>
                        </div>
                    </div>

                    <!-- ── DRILL TAB: CLASSES ── -->
                    <div id="dt-classes" class="tab-pane glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
