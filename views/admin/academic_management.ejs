<!-- ADD SCHOOL YEAR -->
<div id="modalAddSY" class="modal-overlay">
    <div class="modal-box modal-box-sm p-0">
        <div class="flex items-center justify-between p-6 border-b border-slate-100">
            <div><h3 class="font-black text-indigo-900 text-lg">Add School Year</h3></div>
            <button onclick="closeModal('modalAddSY')" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-rose-100 text-slate-500 hover:text-rose-600 transition flex items-center justify-center"><i class="fas fa-times"></i></button>
        </div>
        <form id="addSYForm" onsubmit="submitAddSY(event)" class="p-6 space-y-4">
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">SY Range *</label>
                <input type="text" id="addSYInput" name="sy_range" required
                    placeholder="e.g. <%= new Date().getFullYear() %>-<%= new Date().getFullYear() + 1 %>"
                    maxlength="9" pattern="\d{4}-\d{4}"
                    oninput="validateSYInput(this)"
                    class="search-input w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm bg-white font-mono">
                <p class="text-[10px] text-slate-400 mt-1">
                    Format: YYYY-YYYY · Numbers only · Only current year's SY is allowed
                    (<%= new Date().getFullYear() %>-<%= new Date().getFullYear() + 1 %>)
                </p>
                <p id="addSYError" class="text-[11px] text-rose-500 font-bold mt-1 hidden"></p>
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <button type="button" onclick="closeModal('modalAddSY')" class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-50 transition">Cancel</button>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-emerald-500 to-cyan-500 text-white text-sm font-bold hover:opacity-90 transition shadow-md"><i class="fas fa-plus mr-1"></i> Add</button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT SCHOOL YEAR -->
<div id="modalEditSY" class="modal-overlay">
    <div class="modal-box modal-box-sm p-0">
        <div class="flex items-center justify-between p-6 border-b border-slate-100">
            <div><h3 class="font-black text-indigo-900 text-lg">Edit School Year</h3></div>
            <button onclick="closeModal('modalEditSY')" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-rose-100 text-slate-500 hover:text-rose-600 transition flex items-center justify-center"><i class="fas fa-times"></i></button>
        </div>
        <form id="editSYForm" onsubmit="submitEditSY(event)" class="p-6 space-y-4">
            <input type="hidden" id="editSYId">
            <div>
                <label class="block text-xs font-bold text-slate-600 mb-1.5 uppercase tracking-wider">SY Range *</label>
                <input type="text" id="editSYRange" name="sy_range" required maxlength="9"
                    class="search-input w-full px-3 py-2.5 rounded-xl border border-slate-200 text-sm bg-white font-mono">
            </div>
            <div class="flex justify-end gap-3 pt-2">
                <button type="button" onclick="closeModal('modalEditSY')" class="px-5 py-2.5 rounded-xl border border-slate-200 text-sm font-bold text-slate-600 hover:bg-slate-50 transition">Cancel</button>
                <button type="submit" class="px-5 py-2.5 rounded-xl bg-gradient-to-r from-indigo-500 to-cyan-500 text-white text-sm font-bold hover:opacity-90 transition shadow-md"><i class="fas fa-save mr-1"></i> Save</button>
            </div>
        </form>
    </div>
</div>


<!-- ALL / PAST SCHOOL YEARS MODAL -->
<div id="modalAllSY" class="modal-overlay">
    <div class="modal-box modal-box-sm p-0">
        <div class="flex items-center justify-between p-6 border-b border-slate-100">
            <div>
                <h3 class="font-black text-indigo-900 text-lg">All School Years</h3>
                <p class="text-xs text-slate-400 mt-0.5">Sorted from latest to oldest</p>
            </div>
            <button onclick="closeModal('modalAllSY')" class="w-9 h-9 rounded-xl bg-slate-100 hover:bg-rose-100 text-slate-500 hover:text-rose-600 transition flex items-center justify-center">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="p-6 space-y-2 max-h-[60vh] overflow-y-auto">
            <% if (typeof pastSchoolYears !== 'undefined') { %>
            <% pastSchoolYears.forEach(function(sy) { %>
            <div class="flex items-center justify-between p-3 rounded-xl border border-slate-100 bg-slate-50">
                <div class="flex items-center gap-2">
                    <% if (sy.is_active) { %>
                    <span class="badge badge-active">Active</span>
                    <% } else { %>
                    <span class="badge badge-inactive">Inactive</span>
                    <% } %>
                    <span class="text-sm font-bold text-slate-700"><%= sy.sy_range %></span>
                    <span class="text-[10px] text-slate-400">
                        Added <%= new Date(sy.created_at).toLocaleDateString('en-PH', {year:'numeric', month:'short', day:'numeric'}) %>
                    </span>
                </div>
                <div class="flex items-center gap-1">
                    <% if (!sy.is_active) { %>
                    <button class="btn-icon btn-unlock" title="Activate this SY"
                        onclick="confirmActivateSY(<%= sy.sy_id %>, '<%= sy.sy_range %>')">
                        <i class="fas fa-toggle-off"></i>
                    </button>
                    <% } else { %>
                    <button class="btn-icon" style="cursor:default;opacity:0.4;" title="Currently active" disabled>
                        <i class="fas fa-toggle-on text-emerald-500"></i>
                    </button>
                    <% } %>
                    <button class="btn-icon btn-edit" title="Edit SY"
                        onclick="openEditSY(<%= JSON.stringify(sy) %>)">
                        <i class="fas fa-pen"></i>
                    </button>
                    <% if (!sy.is_active) { %>
                    <button class="btn-icon btn-delete" title="Delete SY"
                        onclick="confirmDeleteSY(<%= sy.sy_id %>, '<%= sy.sy_range %>')">
                        <i class="fas fa-trash"></i>
                    </button>
                    <% } %>
                </div>
            </div>
            <% }) %>
            <% } %>
        </div>
    </div>
</div>

