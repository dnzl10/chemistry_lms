                                </select>
                            </div>
                        </div>
                        <div id="progressContainer">
                            <div class="text-center py-8 text-slate-400 text-sm">Select a subject to view student progress.</div>
                        </div>
                    </div>

                    <!-- ── DRILL TAB: ANNOUNCEMENTS ── -->
                    <div id="dt-announcements" class="tab-pane glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                            <h4 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-bullhorn text-amber-400"></i> Announcements
                            </h4>
                            <button onclick="openAddAnnouncement()"
                                class="flex items-center gap-2 bg-amber-100 text-amber-700 font-bold text-xs px-3 py-2 rounded-xl hover:bg-amber-200 transition">
                                <i class="fas fa-plus"></i> New Announcement
                            </button>
                        </div>
                        <div id="announcementsContainer">
                            <div class="text-center py-8 text-slate-400 text-sm">Select a subject to view announcements.</div>
                        </div>
                    </div>

                    <!-- ── DRILL TAB: ARCADE CONFIG ── -->
                    <div id="dt-arcade" class="tab-pane glass-card rounded-2xl border border-slate-100 shadow-sm p-5 mb-5">
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                            <h4 class="font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-gamepad text-amber-400"></i> Arcade & Gamification Config
                            </h4>
                        </div>

                        <!-- Leaderboard History -->
                        <div class="mb-6">
                            <div class="flex items-center justify-between mb-3">
                                <p class="font-bold text-slate-700 flex items-center gap-2">
                                    <i class="fas fa-trophy text-yellow-500"></i> Leaderboard Snapshots
                                </p>
                            </div>
                            <div id="leaderboardContainer">
                                <div class="text-center py-6 text-slate-400 text-sm">Select a subject to load leaderboard data.</div>
                            </div>
                        </div>

                        <!-- Competitive Matches -->
                        <div class="mb-6">
                            <div class="flex items-center justify-between mb-3">
                                <p class="font-bold text-slate-700 flex items-center gap-2">
                                    <i class="fas fa-swords text-rose-500"></i> Competitive Match History
                                </p>
                            </div>
                            <div id="matchesContainer">
                                <div class="text-center py-6 text-slate-400 text-sm">Select a subject to load match history.</div>
                            </div>
                        </div>

                        <!-- Hardware Button Mapping -->
                        <div>
                            <div class="flex items-center justify-between mb-3">
                                <p class="font-bold text-slate-700 flex items-center gap-2">
                                    <i class="fas fa-microchip text-indigo-500"></i> Hardware Button Mapping
                                </p>
                                <button onclick="openModal('modalAddMapping')"
                                    class="btn-arcade flex items-center gap-2 text-xs font-bold px-4 py-2 rounded-xl">
                                    <i class="fas fa-plus"></i> Add Mapping
                                </button>
                            </div>
                            <div id="mappingContainer">
                                <div class="text-center py-6 text-slate-400 text-sm">Loading hardware mappings…</div>
                            </div>
                        </div>
                    </div>

                </div><!-- end drillPanel -->

            </div><!-- end p-4 -->

            <!-- FOOTER -->
            <footer class="bg-white border-t border-cyan-100 py-6 px-8 mt-auto w-full">
                <div class="flex flex-col md:flex-row justify-between items-center gap-2 max-w-[1600px] mx-auto">
                    <p class="text-[11px] text-indigo-400 font-black uppercase tracking-tight">
                        &copy; 2026 <span class="text-cyan-600">Chemistry Arcade</span> — Mabini College v2.5.0
