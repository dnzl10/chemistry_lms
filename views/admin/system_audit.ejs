                        <button type="button" onclick="cleanupOrphanStorage()" class="px-4 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs rounded-xl shadow-md shadow-rose-200 flex items-center gap-2 transition">
                            <i class="fas fa-broom"></i>
                            <span>Purge Orphan Files</span>
