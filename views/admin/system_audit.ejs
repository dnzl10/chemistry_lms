                                    </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr><td colspan="5" class="text-center py-8 text-slate-300">
                                        <p class="font-bold text-slate-400">No material interactions logged.</p>
                                    </td></tr>
                                <% } %>
                            </tbody>
