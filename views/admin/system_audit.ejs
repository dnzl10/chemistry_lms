            <footer class="bg-white border-t border-cyan-100 py-6 px-8 mt-auto w-full">
                <div class="flex flex-col md:flex-row justify-between items-center gap-2 max-w-[1600px] mx-auto">
                    <p class="text-[11px] text-indigo-400 font-black uppercase tracking-tight">
                        &copy; 2026 <span class="text-cyan-600">Chemistry Arcade</span> — Mabini College v2.5.0
                    </p>
                    <div class="flex gap-4">
                        <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest">Support Lab</a>
                        <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest border-l pl-4 border-indigo-100">Atomic Logs</a>
                    </div>
                </div>
            </footer>
        </div><!-- end overflow-y-auto -->
    </main>
</div><!-- end flex wrapper -->

<!-- ===================== SCRIPTS ===================== -->
<script>
    // Sidebar toggle
    function toggleSidebar() {
        const sidebar = document.getElementById('sidebar');
        const overlay = document.getElementById('sidebarOverlay');
        sidebar.classList.toggle('-translate-x-full');
        overlay.classList.toggle('hidden');
    }

    // ── Audit Activity Chart (14 days) ──
    let auditChartInstance = null;
    function initAuditActivityChart() {
        const canvas = document.getElementById('auditActivityChart');
        if (!canvas) return;

        if (auditChartInstance) {
            auditChartInstance.destroy();
            auditChartInstance = null;
        }

        const auditCtx = canvas.getContext('2d');
        const chartData = <%- JSON.stringify(typeof activityChart !== 'undefined' && activityChart ? activityChart : { labels: [], adminCounts: [], teacherCounts: [], studentCounts: [] }) %>;

        auditChartInstance = new Chart(auditCtx, {
            type: 'bar',
            data: {
                labels: chartData.labels || [],
                datasets: [
                    {
                        label: 'Admin',
                        data: chartData.adminCounts || [],
                        backgroundColor: 'rgba(244,63,94,0.70)',
                        borderColor: '#f43f5e',
                        borderWidth: 1.5,
                        borderRadius: 6,
                    },
                    {
                        label: 'Teacher',
                        data: chartData.teacherCounts || [],
                        backgroundColor: 'rgba(6,182,212,0.70)',
                        borderColor: '#06b6d4',
                        borderWidth: 1.5,
                        borderRadius: 6,
                    },
                    {
                        label: 'Student',
                        data: chartData.studentCounts || [],
                        backgroundColor: 'rgba(34,197,94,0.70)',
                        borderColor: '#22c55e',
                        borderWidth: 1.5,
                        borderRadius: 6,
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: {
                        display: true,
                        position: 'top',
                        labels: { font: { family: 'Plus Jakarta Sans', size: 10, weight: '700' }, color: '#64748b', boxWidth: 10 }
                    },
                    tooltip: {
                        backgroundColor: '#1e1b4b',
                        titleColor: '#c7d2fe',
                        bodyColor: '#e0e7ff',
                        cornerRadius: 10,
                        padding: 10,
                    }
                },
                scales: {
                    x: {
                        stacked: false,
                        grid: { display: false },
                        ticks: { font: { family: 'Plus Jakarta Sans', weight: '700', size: 9 }, color: '#94a3b8' }
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: 'rgba(0,0,0,0.04)' },
                        ticks: {
                            font: { family: 'Plus Jakarta Sans', size: 9 }, color: '#94a3b8',
                            stepSize: 1,
                            callback: (v) => Number.isInteger(v) ? v : ''
                        }
                    }
                }
            }
        });
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initAuditActivityChart);
    } else {
        initAuditActivityChart();
    }
    window.addEventListener('adminContentRefreshed', initAuditActivityChart);

    // ── TABS MANAGEMENT (SYSTEM ACTIONS, RECEIPTS & STORAGE) ─────────────────
    window.switchTab = function(tabName) {
        // Update tab styling
        document.querySelectorAll('.audit-tab').forEach(el => {
            el.classList.remove('active', 'text-indigo-600');
            el.classList.add('text-slate-500');
        });
        const activeBtn = document.getElementById('btn-tab-' + tabName);
        if (activeBtn) {
            activeBtn.classList.add('active', 'text-indigo-600');
            activeBtn.classList.remove('text-slate-500');
        }

        // Toggle content visibility
        document.getElementById('tab-system').classList.toggle('hidden', tabName !== 'system');
        if (tabName === 'system') {
            if (auditChartInstance) {
                auditChartInstance.resize();
            } else {
                initAuditActivityChart();
            }
        }
        const tabReceipts = document.getElementById('tab-receipts');
        if (tabReceipts) {
            tabReceipts.classList.toggle('hidden', tabName !== 'receipts');
            if (tabName === 'receipts') {
                loadRecentReceipts();
            }
        }
        const tabStorage = document.getElementById('tab-storage');
        if (tabStorage) {
            tabStorage.classList.toggle('hidden', tabName !== 'storage');
            if (tabName === 'storage') {
                loadStorageAudit();
            }
        }
    };

    // ── STORAGE & DELIVERABLES AUDIT HANDLERS ────────────────────────────────
    window.loadStorageAudit = async function() {
        const tbody = document.getElementById('storageOrphansTableBody');
        if (tbody) tbody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-slate-400"><i class="fas fa-spinner fa-spin mr-1"></i> Reconciling server filesystems with database records...</td></tr>';

        try {
            const res = await fetch('/admin/api/storage/audit');
            const data = await res.json();
            if (!data.success) throw new Error(data.error || 'Audit scan failed');

            const s = data.summary;
            const setVal = (id, val) => {
                const el = document.getElementById(id);
                if (el) el.textContent = val;
            };

            setVal('storageDeliverablesSize', s.deliverables.sizeMB + ' MB');
            setVal('storageDeliverablesCount', s.deliverables.count + ' files');

            setVal('storageTemplatesSize', s.templates.sizeMB + ' MB');
            setVal('storageTemplatesCount', s.templates.count + ' files');

            setVal('storageSamplesSize', s.samples.sizeMB + ' MB');
            setVal('storageSamplesCount', s.samples.count + ' files');

            setVal('storageAudioSize', s.audioNotes.sizeMB + ' MB');
            setVal('storageAudioCount', s.audioNotes.count + ' files');

            setVal('storageOrphansSize', s.orphans.sizeMB + ' MB');
            setVal('storageOrphansCount', s.orphans.count + ' orphans');

            if (!tbody) return;

            if (!data.orphans || data.orphans.length === 0) {
                tbody.innerHTML = '<tr><td colspan="4" class="py-8 text-center text-emerald-600 font-bold text-xs"><i class="fas fa-circle-check text-base mr-1"></i> Excellent! Zero unreferenced orphan files detected on disk.</td></tr>';
                return;
            }

            tbody.innerHTML = data.orphans.map(o => `
                <tr class="hover:bg-slate-50 transition">
                    <td class="py-3 px-4 text-xs font-mono font-bold text-slate-800">${o.filename}</td>
                    <td class="py-3 px-4 text-xs text-slate-500 font-mono">${o.dir}</td>
                    <td class="py-3 px-4 text-xs font-bold text-slate-600">${(o.size / 1024).toFixed(1)} KB</td>
                    <td class="py-3 px-4 text-xs">
                        <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-100 text-rose-700">
                            <i class="fas fa-triangle-exclamation"></i> Unreferenced
                        </span>
                    </td>
                </tr>
            `).join('');

        } catch (err) {
            console.error('Storage Audit Error:', err);
            if (tbody) tbody.innerHTML = `<tr><td colspan="4" class="py-6 text-center text-rose-500 font-bold text-xs"><i class="fas fa-circle-exclamation mr-1"></i> ${err.message}</td></tr>`;
        }
    };

    window.cleanupOrphanStorage = async function() {
        if (!confirm('Are you sure you want to permanently delete all unreferenced orphan files from the server? This operation will free disk space and is logged in the system audit.')) {
            return;
        }

        try {
            const res = await fetch('/admin/api/storage/cleanup-orphans', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const data = await res.json();
            if (data.success) {
                alert(`Orphan Cleanup Completed Successfully!\n\nDeleted Files: ${data.cleanedCount}\nFreed Disk Space: ${data.freedMB} MB`);
                loadStorageAudit();
            } else {
                alert('Cleanup failed: ' + (data.error || 'Server error'));
            }
        } catch (err) {
            console.error('Cleanup Error:', err);
            alert('Error during orphan cleanup: ' + err.message);
        }
    };

    // ── RECEIPT AUDIT & CAMPUS GRACE BUFFER HANDLERS ─────────────────────────
    window.saveCampusGraceBuffer = async function() {
        const inp = document.getElementById('campusGraceBufferInput');
        const minutes = parseInt(inp ? inp.value : 5) || 5;
        const feedback = document.getElementById('graceBufferFeedback');

        try {
            const res = await fetch('/admin/api/settings/grace-buffer', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ grace_period_minutes: minutes })
            });
            const data = await res.json();
            if (data.success) {
                if (feedback) {
                    feedback.className = 'mt-3 text-xs font-bold text-emerald-700 bg-emerald-100/80 p-3 rounded-xl border border-emerald-200 block';
                    feedback.innerHTML = `<i class="fas fa-check-circle mr-1"></i> ${data.message}`;
                    setTimeout(() => feedback.classList.add('hidden'), 5000);
                }
            } else {
                alert(data.error || 'Failed to update campus grace buffer.');
            }
        } catch (err) {
            console.error(err);
            alert('Error updating grace buffer policy.');
        }
    };

    window.lookupReceiptByHash = async function() {
        const inp = document.getElementById('adminReceiptSearchHash');
        const hash = inp ? inp.value.trim() : '';
        const container = document.getElementById('receiptLookupResult');
        if (!hash) {
            alert('Please enter a SHA-256 hash or receipt fingerprint.');
            return;
        }

        container.classList.remove('hidden');
        container.className = 'p-4 rounded-2xl border text-xs bg-slate-50 border-slate-200 text-slate-600 block';
        container.innerHTML = '<i class="fas fa-spinner fa-spin mr-2"></i> Verifying cryptographic hash against audit ledger...';

        try {
            const res = await fetch(`/admin/api/receipts/verify/${encodeURIComponent(hash)}`);
            const data = await res.json();

            if (data.success && data.verified && data.receipt) {
                const r = data.receipt;
                const verifiedTime = new Date(r.server_timestamp).toLocaleString('en-PH', {
                    month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit', second: '2-digit'
                });
                container.className = 'p-4 rounded-2xl border text-xs bg-emerald-50 border-emerald-200 text-emerald-900 block space-y-2';
                container.innerHTML = `
                    <div class="flex items-center justify-between">
                        <span class="inline-flex items-center gap-1.5 font-black text-emerald-700 uppercase tracking-wider text-[11px]">
                            <i class="fas fa-circle-check text-emerald-600 text-sm"></i> Cryptographically Verified Valid
                        </span>
                        <span class="text-[10px] text-emerald-600 font-mono">ID: ${r.receipt_id}</span>
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-2 text-slate-700 pt-1">
                        <div><strong>Student:</strong> ${r.first_name || ''} ${r.last_name || ''} (${r.email || 'N/A'})</div>
                        <div><strong>Assessment:</strong> ${r.assessment_name || 'N/A'}</div>
                        <div><strong>Submitted:</strong> ${verifiedTime}</div>
                        <div><strong>Grace Window:</strong> ${r.grace_minutes_used ? `<span class="text-amber-600 font-bold">${r.grace_minutes_used} min buffer used</span>` : '<span class="text-emerald-600 font-semibold">On-Time Submission</span>'}</div>
                    </div>
                    <div class="pt-1 font-mono text-[10px] break-all text-slate-500 bg-white/70 p-2 rounded-xl border border-emerald-100">
                        <strong>Fingerprint:</strong> ${r.sha256_hash}
                    </div>
                `;
            } else {
                container.className = 'p-4 rounded-2xl border text-xs bg-rose-50 border-rose-200 text-rose-800 block';
                container.innerHTML = `
                    <div class="flex items-center gap-2">
                        <i class="fas fa-circle-xmark text-rose-600 text-base"></i>
                        <div>
                            <span class="font-black uppercase tracking-wider text-[11px]">Verification Failed / Non-Existent Record</span>
                            <p class="text-[11px] text-rose-600 mt-0.5">${data.message || 'No submission record matches this SHA-256 fingerprint in the institutional ledger.'}</p>
                        </div>
                    </div>
                `;
            }
        } catch (err) {
            console.error(err);
            container.className = 'p-4 rounded-2xl border text-xs bg-rose-50 border-rose-200 text-rose-800 block';
            container.innerHTML = `<i class="fas fa-triangle-exclamation text-rose-600 mr-2"></i> Network error connecting to verification service.`;
        }
    };

    window.loadRecentReceipts = async function() {
        const tbody = document.getElementById('recentReceiptsTableBody');
        if (!tbody) return;

        try {
            const res = await fetch('/admin/api/receipts/recent');
            const data = await res.json();

            if (!data.success || !data.receipts || data.receipts.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" class="py-6 text-center text-slate-400 font-bold">No digital submission receipts recorded yet.</td></tr>';
                return;
            }

            tbody.innerHTML = data.receipts.map(r => {
                const dateStr = new Date(r.server_timestamp).toLocaleString('en-PH', {
                    month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit'
                });
                const shortHash = r.sha256_hash ? r.sha256_hash.substring(0, 16) + '...' : 'N/A';
                return `
                    <tr class="hover:bg-slate-50 transition">
                        <td class="py-2.5 px-3 font-mono font-bold text-slate-500 text-[10px]">${r.receipt_id}</td>
                        <td class="py-2.5 px-3 font-bold text-slate-800">${r.first_name || ''} ${r.last_name || ''}</td>
                        <td class="py-2.5 px-3 text-slate-600">${r.assessment_name || 'Assignment'}</td>
                        <td class="py-2.5 px-3 font-mono text-[11px] text-indigo-600 font-semibold" title="${r.sha256_hash}">${shortHash}</td>
                        <td class="py-2.5 px-3 text-slate-500 whitespace-nowrap">${dateStr}</td>
                        <td class="py-2.5 px-3 text-center">
                            <button type="button" onclick="document.getElementById('adminReceiptSearchHash').value='${r.sha256_hash}'; lookupReceiptByHash();" class="px-2.5 py-1 rounded-lg text-[10px] font-black bg-indigo-50 hover:bg-indigo-100 text-indigo-600 transition">
                                <i class="fas fa-check-double"></i> Verify
                            </button>
                        </td>
                    </tr>
                `;
            }).join('');
        } catch (err) {
            console.error('[loadRecentReceipts]', err);
            tbody.innerHTML = '<tr><td colspan="6" class="py-4 text-center text-rose-500 font-bold">Failed to load recent receipts.</td></tr>';
        }
    };
</script>

