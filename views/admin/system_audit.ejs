                    <div class="flex items-center gap-3.5">
                        <div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-500 to-purple-600 text-white flex items-center justify-center font-black text-xl shadow-lg shadow-indigo-100">
                            <i class="fas fa-hard-drive"></i>
                        </div>
                        <div>
                            <h3 class="font-black text-indigo-950 text-base">Storage Ecosystem &amp; Deliverables Audit</h3>
