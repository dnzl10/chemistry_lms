                        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block mb-1">Student Deliverables</span>
                        <p class="text-2xl font-black text-indigo-950" id="storageDeliverablesSize">--</p>
                        <span class="text-[11px] font-bold text-slate-500" id="storageDeliverablesCount">-- files</span>
                    </div>

                    <!-- Templates -->
                    <div class="stat-card glass-card rounded-2xl p-4 border border-slate-100 shadow-sm">
                        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block mb-1">Format Templates</span>
                        <p class="text-2xl font-black text-teal-700" id="storageTemplatesSize">--</p>
                        <span class="text-[11px] font-bold text-slate-500" id="storageTemplatesCount">-- files</span>
                    </div>

                    <!-- Exemplars -->
                    <div class="stat-card glass-card rounded-2xl p-4 border border-slate-100 shadow-sm">
                        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block mb-1">Teacher Samples</span>
                        <p class="text-2xl font-black text-indigo-700" id="storageSamplesSize">--</p>
                        <span class="text-[11px] font-bold text-slate-500" id="storageSamplesCount">-- files</span>
                    </div>

                    <!-- Audio Notes -->
                    <div class="stat-card glass-card rounded-2xl p-4 border border-slate-100 shadow-sm">
                        <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 block mb-1">Voice Feedback</span>
                        <p class="text-2xl font-black text-purple-700" id="storageAudioSize">--</p>
                        <span class="text-[11px] font-bold text-slate-500" id="storageAudioCount">-- files</span>
                    </div>

                    <!-- Orphan Files -->
                    <div class="stat-card glass-card rounded-2xl p-4 border border-rose-200 bg-rose-50/40 shadow-sm">
                        <span class="text-[10px] font-black uppercase tracking-wider text-rose-600 block mb-1">Unreferenced Orphans</span>
                        <p class="text-2xl font-black text-rose-700" id="storageOrphansSize">--</p>
                        <span class="text-[11px] font-bold text-rose-600" id="storageOrphansCount">-- orphans</span>
                    </div>
                </div>

                <!-- Orphan Reconcile Inspection Table -->
                <div class="glass-card rounded-2xl border border-slate-100 shadow-sm overflow-hidden p-6 space-y-4">
                    <div class="flex items-center justify-between flex-wrap gap-2">
                        <div>
                            <h4 class="font-black text-indigo-950 text-sm">Orphan Storage Audit &amp; File Integrity Log</h4>
                            <p class="text-xs text-slate-400 font-medium">Files physically present on server without active database association</p>
                        </div>
                    </div>

                    <div class="overflow-x-auto rounded-xl border border-slate-100">
                        <table class="w-full text-left text-xs">
                            <thead class="bg-slate-50 text-slate-500 font-black uppercase text-[10px] tracking-wider border-b border-slate-100">
                                <tr>
                                    <th class="py-3 px-4">Filename</th>
                                    <th class="py-3 px-4">Relative Directory</th>
                                    <th class="py-3 px-4">Disk Size</th>
                                    <th class="py-3 px-4">Integrity Status</th>
                                </tr>
