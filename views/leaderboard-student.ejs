                                                <th class="py-3.5 px-4">Coursework Mastery</th>
                                                <th class="py-3.5 px-4">Cumulative Precision</th>
                                                <th class="py-3.5 px-4">Cumulative Score</th>
                                                <th class="py-3.5 px-4 text-right">Assessments Taken</th>
                                            <% } else { %>
                                                <th class="py-3.5 px-4">Mastery Badge</th>
                                                <th class="py-3.5 px-4">Accuracy Rate</th>
                                                <th class="py-3.5 px-4">Arcade Score</th>
                                                <th class="py-3.5 px-4 text-right">Execution Streak</th>
                                            <% } %>
                                        </tr>
                                    </thead>
                                    <tbody class="divide-y divide-slate-100">
