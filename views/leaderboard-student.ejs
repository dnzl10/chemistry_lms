                                                            <span>&bull;</span>
                                                            <span class="flex items-center gap-1 text-slate-500">
                                                                <i class="far fa-clock text-[9px]"></i>
                                                                <span><%= performer.formatted_started_at %></span> &rarr;
                                                                <span><%= performer.formatted_ended_at %></span>
                                                                <span class="px-1.5 py-0.2 bg-slate-100 rounded text-[9px] font-bold text-slate-700"><%= performer.formatted_duration %><%= isCumulativeScope ? ' Total' : '' %></span>
                                                            </span>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Score / Wins Telemetry (Right Column) -->
                                                <div class="text-right shrink-0 flex sm:flex-col items-end justify-between sm:justify-center border-t sm:border-t-0 pt-2 sm:pt-0 border-slate-100">
                                                    <% if (assessmentMode === 'dual') { %>
                                                        <p class="font-black text-purple-700 text-sm flex items-center justify-end gap-1">
                                                            <i class="fas fa-trophy text-amber-500 mr-0.5"></i>
                                                            <span><%= performer.wins %> WINS</span>
                                                        </p>
                                                        <p class="text-[10px] text-slate-400 font-bold"><%= performer.wins %>W - <%= performer.losses %>L &middot; <%= performer.win_rate %>% Win</p>
