                                                        <img src="<%= threeRankWindow.myEntry.displayAvatar || myDisplayAvatar %>" class="w-14 h-14 rounded-2xl object-cover ring-2 <%= isGhostMode ? 'ring-amber-400 shadow-amber-500/20' : 'ring-indigo-500 shadow-sm' %>">
                                                        <span class="absolute -bottom-1 -right-1 px-1.5 py-0.2 <%= isGhostMode ? 'bg-amber-500 text-slate-950 font-black' : 'bg-indigo-600 text-white font-black' %> rounded text-[8px]">
                                                            <%= isGhostMode ? 'GHOST' : 'YOU' %>
                                                        </span>
                                                    </div>
                                                    <div>
                                                        <div class="flex items-center gap-2 flex-wrap">
                                                            <p class="font-black text-slate-900 text-base"><%= threeRankWindow.myEntry.gamertag %></p>
                                                            <span class="px-2.5 py-0.5 rounded text-[10px] font-black uppercase <%= threeRankWindow.myEntry.tier.badgeBg %>" title="<%= isCumulativeScope ? 'Coursework Precision Tier (Cumulative Portfolio)' : 'Run Precision Tier (Match Attempt)' %>">
                                                                <i class="fas <%= threeRankWindow.myEntry.tier.icon %> mr-1"></i>
                                                                <%= threeRankWindow.myEntry.tier.name %> <%= isCumulativeScope ? '(Coursework)' : '(Run)' %>
                                                            </span>
                                                            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase bg-indigo-100 text-indigo-800 border border-indigo-300">
                                                                <i class="fas fa-layer-group text-[9px]"></i> Lvl <%= threeRankWindow.myEntry.highest_level_reached %>
                                                            </span>
                                                            <% if (isCumulativeScope && threeRankWindow.myEntry.assessments_completed > 0) { %>
                                                                <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase bg-emerald-100 text-emerald-800 border border-emerald-300" title="Total Formal Assessments Completed">
                                                                    <i class="fas fa-clipboard-check text-[9px]"></i> <%= threeRankWindow.myEntry.assessments_completed %> <%= threeRankWindow.myEntry.assessments_completed === 1 ? 'Assessment' : 'Assessments' %>
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <p class="text-[10px] text-indigo-700 mt-1 flex items-center gap-1.5 flex-wrap">
                                                            <i class="far fa-clock text-[9px]"></i>
                                                            <span><%= threeRankWindow.myEntry.formatted_started_at %> &rarr; <%= threeRankWindow.myEntry.formatted_ended_at %></span>
                                                            <span class="px-1.5 py-0.2 bg-indigo-100 text-indigo-900 rounded text-[9px] font-bold"><%= threeRankWindow.myEntry.formatted_duration %><%= isCumulativeScope ? ' Total' : '' %></span>
                                                        </p>
                                                    </div>
                                                </div>
                                                
                                                <div class="text-right flex sm:flex-col items-end justify-between sm:justify-center border-t sm:border-t-0 pt-3 sm:pt-0 border-indigo-100">
                                                    <% if (assessmentMode === 'dual') { %>
                                                        <p class="text-lg font-black text-purple-900"><i class="fas fa-trophy text-amber-500 mr-1"></i><%= threeRankWindow.myEntry.wins %> <span class="text-xs text-purple-600">WINS</span></p>
                                                        <p class="text-[10px] text-slate-500 font-bold"><%= threeRankWindow.myEntry.losses %> Losses &middot; <%= threeRankWindow.myEntry.win_rate %>% Win Rate</p>
                                                        <div class="mt-1.5">
                                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black bg-purple-100 text-purple-800 border border-purple-200 shadow-xs">
                                                                🎯 Target to Podium: +<%= threeRankWindow.pointsToPodium %> win<%= threeRankWindow.pointsToPodium > 1 ? 's' : '' %> to overtake #3!
                                                            </span>
                                                        </div>
                                                    <% } else { %>
                                                        <p class="text-xl font-black text-indigo-900"><%= threeRankWindow.myEntry.best_score_total %> <span class="text-xs text-indigo-500">PTS</span></p>
                                                        <p class="text-[10px] text-slate-500 font-bold"><%= isCumulativeScope ? 'Cumulative Precision:' : 'Accuracy:' %> <%= Number(threeRankWindow.myEntry.accuracy_pct).toFixed(0) %>% &middot; Rank #<%= threeRankWindow.myEntry.rank %> of <%= leaderboardRows.length %></p>
                                                        <div class="mt-1.5">
                                                            <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-[10px] font-black bg-cyan-100 text-cyan-800 border border-cyan-200 shadow-xs">
                                                                🎯 Target to Podium: +<%= threeRankWindow.pointsToPodium %> pts to overtake #3!
                                                            </span>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </div>
                                    <% } else if (threeRankWindow.isMyEntryInTopThree) { %>
