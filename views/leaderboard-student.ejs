    <!-- ================= CLIENT JAVASCRIPT ================= -->
    <script>
        // --- Tab Switching Logic (Standings / Element Heatmap / Machine Stats) ---
        function showTab(tabId) {
            // 1. Hide all tab content panes
            const panes = document.querySelectorAll('.tab-content');
            panes.forEach(p => p.classList.add('hidden'));

            // 2. Reveal target pane
            const targetPane = document.getElementById(tabId);
            if (targetPane) {
                targetPane.classList.remove('hidden');
            }

            // 3. Reset all tab buttons to default inactive style
            const tabBtns = document.querySelectorAll('.tab-btn');
            tabBtns.forEach(btn => {
                btn.className = 'tab-btn px-4 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition';
            });

            // 4. Highlight active tab button
            const activeBtn = document.getElementById('tabBtn-' + tabId) || document.querySelector(`.tab-btn[onclick*="${tabId}"]`);
            if (activeBtn) {
                activeBtn.className = 'tab-btn active-tab px-4 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-xs transition';
            }

            // 5. Update browser hash state without triggering page jump
            try {
                if (window.history && window.history.replaceState) {
                    window.history.replaceState(null, null, '#' + tabId);
                }
            } catch (e) {}
        }

        // Auto-activate tab from URL hash on load
        document.addEventListener('DOMContentLoaded', () => {
            const currentHash = window.location.hash.replace('#', '');
            if (currentHash && ['standingsContent', 'mastery', 'machines'].includes(currentHash)) {
                showTab(currentHash);
            }
        });

        // --- State variables for Ghost Mode ---
        let currentGhostAvatar = "<%= ghostAvatar || 'ghost_avatar_1.svg' %>";
        let currentGhostName = "<%= ghostName || '' %>";
        const isGhostActive = <%= isGhostMode ? 'true' : 'false' %>;

        function handleGhostModeClick() {
            if (isGhostActive) {
                openGhostDeactivateModal();
            } else {
                openGhostConfigModal();
            }
        }

        // Backward compatibility
        function toggleGhostMode() {
            handleGhostModeClick();
        }

        function openGhostConfigModal() {
            const modal = document.getElementById('ghostConfigModal');
            if (!modal) return;

            // If ghost name input is empty, prefill with current or generate a random one
            const input = document.getElementById('ghostNameInput');
            if (input) {
                input.value = currentGhostName || getRandomGhostName();
            }

            // Highlight selected avatar
            selectGhostAvatar(currentGhostAvatar || 'ghost_avatar_1.svg');

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.querySelector('.modal-card').classList.remove('scale-95');
            }, 10);
        }

        function closeGhostConfigModal() {
            const modal = document.getElementById('ghostConfigModal');
            if (!modal) return;
            modal.classList.add('opacity-0');
            modal.querySelector('.modal-card').classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 250);
        }

        function selectGhostAvatar(avatarFile) {
            currentGhostAvatar = avatarFile;
            document.querySelectorAll('.ghost-avatar-card').forEach(card => {
                card.classList.remove('border-amber-400', 'bg-amber-400/10', 'ring-2', 'ring-amber-400/40');
                card.classList.add('border-white/10');
                const badge = card.querySelector('.avatar-selected-badge');
                if (badge) badge.classList.add('hidden');
            });

            const selectedCard = document.getElementById('avatarOption_' + avatarFile);
            if (selectedCard) {
                selectedCard.classList.remove('border-white/10');
                selectedCard.classList.add('border-amber-400', 'bg-amber-400/10', 'ring-2', 'ring-amber-400/40');
                const badge = selectedCard.querySelector('.avatar-selected-badge');
                if (badge) badge.classList.remove('hidden');
            }
        }

        function getRandomGhostName() {
            const adjectives = ['Quantum', 'Neon', 'Shadow', 'Cyber', 'Atomic', 'Spectral', 'Stealth', 'Hyper', 'Orbital', 'Ionic'];
            const nouns = ['Chemist', 'Alchemist', 'Specter', 'Phantom', 'Catalyst', 'Reagent', 'Electron', 'Isotope', 'Proton', 'Matrix'];
            const randomAdj = adjectives[Math.floor(Math.random() * adjectives.length)];
            const randomNoun = nouns[Math.floor(Math.random() * nouns.length)];
            const randomNum = Math.floor(100 + Math.random() * 900);
            return `${randomAdj}${randomNoun}_${randomNum}`;
        }

        function rollRandomGhostName() {
            const input = document.getElementById('ghostNameInput');
            if (input) {
                input.value = getRandomGhostName();
            }
        }

        function proceedToConfirmGhostMode() {
            const input = document.getElementById('ghostNameInput');
            let chosenName = (input ? input.value : '').trim();
            if (!chosenName) {
                chosenName = getRandomGhostName();
                if (input) input.value = chosenName;
            }
            currentGhostName = chosenName;

            // Populate confirmation preview
            const previewAvatar = document.getElementById('confirmPreviewAvatar');
            if (previewAvatar) {
                previewAvatar.src = currentGhostAvatar.startsWith('/') ? currentGhostAvatar : '/images/ghost_avatars/' + currentGhostAvatar;
            }
            const previewName = document.getElementById('confirmPreviewName');
            if (previewName) {
                previewName.textContent = currentGhostName;
            }

            // Close config modal, open confirm modal
            closeGhostConfigModal();
            setTimeout(() => {
                openGhostConfirmModal();
            }, 260);
        }

        function openGhostConfirmModal() {
            const modal = document.getElementById('ghostConfirmModal');
            if (!modal) return;
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.querySelector('.modal-card').classList.remove('scale-95');
            }, 10);
        }

        function closeGhostConfirmModal() {
            const modal = document.getElementById('ghostConfirmModal');
            if (!modal) return;
            modal.classList.add('opacity-0');
            modal.querySelector('.modal-card').classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 250);
        }

        function backToGhostConfig() {
            closeGhostConfirmModal();
            setTimeout(() => {
                openGhostConfigModal();
            }, 260);
        }

        async function confirmSaveGhostMode() {
            const btn = document.getElementById('btnConfirmSaveGhost');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Saving...';
            }

            try {
                const res = await fetch('/student/api/set-ghost-mode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        enabled: true,
                        ghost_name: currentGhostName,
                        ghost_avatar: currentGhostAvatar
                    })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Could not activate Ghost Mode: ' + (data.error || 'Server error'));
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-check"></i> <span>Confirm & Activate Ghost Mode</span>';
                    }
                }
            } catch (err) {
                console.error(err);
                alert('Connection error while activating Ghost Mode.');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-check"></i> <span>Confirm & Activate Ghost Mode</span>';
                }
            }
        }

        function openGhostDeactivateModal() {
            const modal = document.getElementById('ghostDeactivateModal');
            if (!modal) return;
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.querySelector('.modal-card').classList.remove('scale-95');
            }, 10);
        }

        function closeGhostDeactivateModal() {
            const modal = document.getElementById('ghostDeactivateModal');
            if (!modal) return;
            modal.classList.add('opacity-0');
            modal.querySelector('.modal-card').classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 250);
        }

        async function confirmDeactivateGhostMode() {
            const btn = document.getElementById('btnConfirmDeactivateGhost');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Turning OFF...';
            }

            try {
                const res = await fetch('/student/api/set-ghost-mode', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ enabled: false })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Could not disable Ghost Mode: ' + (data.error || 'Server error'));
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = 'Turn OFF';
                    }
                }
            } catch (err) {
                console.error(err);
                alert('Connection error while turning off Ghost Mode.');
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = 'Turn OFF';
                }
            }
        }

        // --- Privacy: Gamertag Prompt ---
        async function promptUpdateGamertag() {
            const currentTag = "<%= user.alternative_name || '' %>";
            const newTag = prompt("Enter your public Arcade Gamertag / Codename (e.g. ArgonKnight_42):", currentTag);
            if (!newTag || newTag.trim() === currentTag) return;

            try {
                const res = await fetch('/student/api/update-gamertag', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ gamertag: newTag.trim() })
                });
                const data = await res.json();
                if (data.success) {
                    window.location.reload();
                } else {
                    alert('Error updating gamertag: ' + (data.error || 'Server error'));
                }
            } catch (err) {
                console.error(err);
            }
        }

        // --- Post-Assessment Analytics Modal ---
        async function openSessionDiagnostic(sessionId) {
            const modal = document.getElementById('sessionDiagnosticModal');
            const listEl = document.getElementById('diagnosticDeficitsList');
            const subTitle = document.getElementById('diagnosticSubtitle');
            const remediationContainer = document.getElementById('diagnosticRemediationLinks');

            listEl.innerHTML = '<div class="text-center py-6 text-slate-400 text-xs"><i class="fas fa-spinner fa-spin mr-1"></i> Analyzing session telemetry...</div>';
            if (remediationContainer) {
                remediationContainer.innerHTML = '<span class="text-xs text-slate-400 inline-flex items-center gap-1.5 py-1.5"><i class="fas fa-spinner fa-spin text-indigo-500"></i> Locating curricular resources...</span>';
            }

            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.querySelector('.modal-card').classList.remove('scale-95');
            }, 10);

            try {
                const res = await fetch('/student/api/session-diagnostic/' + sessionId);
                const data = await res.json();
                if (!data.success) {
                    listEl.innerHTML = '<p class="text-sm text-slate-400 text-center py-4">Diagnostic data unavailable for this session.</p>';
                    if (remediationContainer) {
                        remediationContainer.innerHTML = '<a href="/subjects" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white text-indigo-600 shadow-2xs hover:bg-indigo-600 hover:text-white transition inline-flex items-center gap-1.5"><i class="fas fa-book-open"></i> Review Curricular Module</a>';
                    }
                    return;
                }

                const topicName = data.session.topic_name || data.session.level_topic || 'Curricular Module';
                const subjectId = data.session.subject_id;
                const topicId = data.session.topic_id;

                let topicTargetUrl = '/subjects';
                if (subjectId) {
                    topicTargetUrl = `/subjects/open/${subjectId}?tab=resources`;
                    if (topicId) {
                        topicTargetUrl += `&topic_id=${topicId}#topic-${topicId}`;
                    }
                }

                subTitle.textContent = `${topicName} · Wall Duration: ${data.session.total_duration_s || 60}s`;

                // Render Actionable Remediation Buttons leading to Resources under the specific topic
                if (remediationContainer) {
                    if (subjectId) {
                        remediationContainer.innerHTML = `
                            <a href="${topicTargetUrl}" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 text-white shadow-sm hover:bg-indigo-700 transition inline-flex items-center gap-1.5">
                                <i class="fas fa-folder-open"></i> Review Curricular Module: ${topicName} (Resources)
                            </a>
                            <a href="/subjects/open/${subjectId}" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white text-indigo-600 border border-indigo-200 shadow-2xs hover:bg-indigo-50 transition inline-flex items-center gap-1.5">
                                <i class="fas fa-layer-group"></i> Open Subject Overview
                            </a>
                        `;
                    } else {
                        remediationContainer.innerHTML = `
                            <a href="/subjects" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white text-indigo-600 shadow-2xs hover:bg-indigo-600 hover:text-white transition inline-flex items-center gap-1.5">
                                <i class="fas fa-book-open"></i> Review Curricular Module
                            </a>
                        `;
                    }
                }

                if (!data.conceptDeficits || data.conceptDeficits.length === 0) {
                    listEl.innerHTML = `
                        <div class="p-4 rounded-xl bg-emerald-50 text-emerald-800 text-xs font-bold flex items-center gap-2">
                            <i class="fas fa-circle-check text-emerald-500 text-base"></i>
                            <span>Zero critical deficits identified in this run! 100% precision maintained.</span>
                        </div>
                    `;
                } else {
                    listEl.innerHTML = data.conceptDeficits.map(d => `
                        <div class="p-3 rounded-xl border border-rose-100 bg-rose-50/50 flex items-start justify-between gap-3 text-xs">
                            <div class="space-y-1">
                                <div class="flex items-center gap-1.5">
                                    <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase bg-rose-200 text-rose-800">Flagged Deficit</span>
                                    <span class="font-bold text-slate-800">${d.question_snapshot || 'Chemical calculation task'}</span>
                                </div>
                                <p class="text-slate-500 text-[11px]">Given answer: <b class="text-rose-600">${d.player_answer || 'Timeout'}</b> &middot; Correct formula: <b class="text-emerald-700">${d.correct_answer}</b></p>
                            </div>
                            <div class="flex items-center gap-1.5 flex-shrink-0">
                                <a href="${topicTargetUrl}" class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white text-indigo-600 shadow-2xs hover:bg-indigo-50 flex-shrink-0 inline-flex items-center gap-1">
                                    <i class="fas fa-folder-open text-indigo-500"></i> Topic Resources
                                </a>
                                ${d.material_id ? `
                                    <a href="/material_uploads/${d.material_id}" class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white text-indigo-600 shadow-2xs hover:bg-indigo-50 flex-shrink-0 inline-flex items-center gap-1">
                                        <i class="fas fa-book-open"></i> Slide Deck
                                    </a>
                                ` : ''}
                            </div>
                        </div>
                    `).join('');
                }
            } catch (err) {
                listEl.innerHTML = '<p class="text-xs text-rose-500 text-center py-4">Error loading diagnostic telemetry.</p>';
                if (remediationContainer) {
                    remediationContainer.innerHTML = '<a href="/subjects" class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-white text-indigo-600 shadow-2xs hover:bg-indigo-600 hover:text-white transition inline-flex items-center gap-1.5"><i class="fas fa-book-open"></i> Review Curricular Module</a>';
                }
            }
        }

        function closeSessionDiagnostic() {
            const modal = document.getElementById('sessionDiagnosticModal');
            modal.classList.add('opacity-0');
            modal.querySelector('.modal-card').classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 250);
        }

        // --- Cadet Dossier Modal Logic ---
        let radarChartInstance = null;
        const studentRadarData = <%- JSON.stringify(arcadeStats.radar || {}) %>;

        function openCadetDossierModal() {
            const modal = document.getElementById('cadetDossierModal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                modal.classList.remove('opacity-0');
                modal.querySelector('.modal-content-card').classList.remove('scale-95');
                initRadarChart();
            }, 10);
        }

        function closeCadetDossierModal() {
            const modal = document.getElementById('cadetDossierModal');
            modal.classList.add('opacity-0');
            modal.querySelector('.modal-content-card').classList.add('scale-95');
            setTimeout(() => modal.classList.add('hidden'), 250);
        }

        function initRadarChart() {
            const canvas = document.getElementById('cadetRadarChart');
            if (!canvas) return;
            if (radarChartInstance) radarChartInstance.destroy();

            const ctx = canvas.getContext('2d');
            radarChartInstance = new Chart(ctx, {
                type: 'radar',
                data: {
                    labels: ['Remembering', 'Understanding', 'Applying', 'Analyzing', 'Lab Precision'],
                    datasets: [{
                        label: 'Mastery Level (%)',
                        data: [
                            studentRadarData.remembering ?? 0,
                            studentRadarData.understanding ?? 0,
                            studentRadarData.applying ?? 0,
                            studentRadarData.analyzing ?? 0,
                            studentRadarData.precision ?? 0
                        ],
                        backgroundColor: 'rgba(6, 182, 212, 0.25)',
                        borderColor: '#06b6d4',
                        borderWidth: 2.5,
                        pointBackgroundColor: '#4f46e5',
                        pointBorderColor: '#ffffff',
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        r: {
                            angleLines: { color: 'rgba(226, 232, 240, 0.8)' },
                            grid: { color: 'rgba(226, 232, 240, 0.8)' },
                            pointLabels: {
                                font: { family: 'Plus Jakarta Sans', size: 10, weight: '700' },
                                color: '#475569'
                            },
                            min: 0,
                            max: 100,
                            suggestedMin: 0,
                            suggestedMax: 100,
                            ticks: {
                                display: true,
                                stepSize: 20,
                                backdropColor: 'transparent',
                                color: '#94a3b8',
                                font: { size: 9, weight: '600' }
                            }
                        }
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function(context) {
                                    const axis = context.label;
                                    let sub = '';
                                    let isAttempted = true;
                                    if (axis === 'Remembering') {
                                        sub = ' (Recall Fluency & Stability)';
                                        isAttempted = Boolean(studentRadarData.rememberingDetails?.attempted ?? (studentRadarData.rememberingDetails?.total > 0));
                                    } else if (axis === 'Understanding') {
                                        sub = ' (Conceptual Durability EMA)';
                                        isAttempted = Boolean(studentRadarData.understandingDetails?.attempted ?? (studentRadarData.understandingDetails?.total > 0));
                                    } else if (axis === 'Applying') {
                                        sub = ' (70/30 Procedural Reliability)';
                                        isAttempted = Boolean(studentRadarData.applyingDetails?.attempted ?? (studentRadarData.applyingDetails?.total > 0));
                                    } else if (axis === 'Analyzing') {
                                        sub = ' (Diagnostic Resilience)';
                                        isAttempted = Boolean(studentRadarData.analyzingDetails?.attempted ?? (studentRadarData.analyzingDetails?.total > 0));
                                    } else if (axis === 'Lab Precision') {
                                        sub = ' (Composite Laboratory Mastery)';
                                        isAttempted = Boolean(studentRadarData.precisionDetails?.attempted ?? (studentRadarData.precisionDetails?.total > 0));
                                    }
                                    if (!isAttempted) {
                                        return ` ${axis}: Unassessed (0 items recorded)`;
                                    }
                                    return ` ${axis}: ${context.raw}%${sub}`;
                                }
                            }
                        }
                    }
                }
            });
        }

        // Standard User Menu Toggle
        function toggleUserMenu(e) {
            if (e) e.stopPropagation();
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('userMenuBtn');
            if (!dropdown) return;
            const isExpanded = !dropdown.classList.contains('hidden');
            dropdown.classList.toggle('hidden');
            if (btn) btn.setAttribute('aria-expanded', !isExpanded);
        }

        window.addEventListener('click', function(e) {
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('userMenuBtn');
            if (dropdown && !dropdown.classList.contains('hidden')) {
                if (!dropdown.contains(e.target) && (!btn || !btn.contains(e.target))) {
                    dropdown.classList.add('hidden');
                    if (btn) btn.setAttribute('aria-expanded', 'false');
                }
            }
        });

        function toggleNotifications() {
            const panel = document.getElementById('notification-panel');
            const overlay = document.getElementById('notification-overlay');

            if (!panel || !overlay) return;

            if (panel.classList.contains('translate-x-full')) {
                panel.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.add('opacity-100'), 10);
                if (window.NotificationHub) {
                    NotificationHub.loadNotifications('notification-list', false);
                }
            } else {
                panel.classList.add('translate-x-full');
                overlay.classList.remove('opacity-100');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }
    </script>
    <script src="/js/notificationHub.js"></script>
</body>
</html>