                                                        <% if (performer.isMe) { %>
                                                            <span class="absolute -bottom-1 -right-1 px-1.5 py-0.2 <%= isGhostMode ? 'bg-amber-500 text-slate-950 font-black' : 'bg-indigo-600 text-white font-black' %> rounded text-[8px] shadow-xs">
                                                                <%= isGhostMode ? 'GHOST' : 'YOU' %>
                                                            </span>
