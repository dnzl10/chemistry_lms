                                            <div class="flex items-center justify-between mb-2">
                                                <h4 class="text-xs font-black text-slate-700 uppercase tracking-wider flex items-center gap-1.5">
                                                    <i class="fas fa-bullseye text-indigo-500"></i>
                                                    <span>Your Current Standing & Target to Podium</span>
                                                </h4>
                                                <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=<%= assessmentType %>&assessment_id=<%= selectedAssessmentId %>&view_window=full&sort=<%= sortMode %>" 
                                                   class="text-[11px] font-bold text-indigo-600 hover:text-indigo-800">
                                                    View in Full Standings &rarr;
                                                </a>
                                            </div>

                                            <div class="relative flex flex-col sm:flex-row sm:items-center justify-between p-5 rounded-2xl bg-gradient-to-r from-blue-50/90 via-indigo-50/90 to-cyan-50/90 border-2 <%= isGhostMode ? 'border-amber-400/80' : 'border-indigo-400' %> shadow-md gap-4">
                                                <div class="flex items-center gap-4">
                                                    <div class="w-10 text-center font-black <%= isGhostMode ? 'text-amber-600' : 'text-indigo-700' %> text-lg">
                                                        #<%= threeRankWindow.myEntry.rank %>
                                                    </div>
