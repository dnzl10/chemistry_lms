    <!-- ================= 7. CADET DOSSIER INTERACTIVE MODAL ================= -->
    <div id="cadetDossierModal" class="hidden opacity-0 transition-opacity duration-200 fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-5 bg-slate-900/60 backdrop-blur-sm overflow-y-auto">
