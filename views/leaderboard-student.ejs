                                                    <% } else { %>
                                                        <p class="font-black text-slate-800 text-base">
                                                            <span><%= performer.best_score_total %></span>
                                                            <span class="text-[10px] text-slate-400 font-bold">PTS</span>
                                                        </p>
                                                        <p class="text-[10px] text-slate-500 font-bold">
                                                            <%= isCumulativeScope ? 'Cumulative Precision:' : 'Accuracy:' %> <span class="text-cyan-700"><%= Number(performer.accuracy_pct).toFixed(0) %>%</span>
                                                        </p>
                                                        <% if (isCumulativeScope) { %>
                                                            <p class="text-[10px] text-emerald-600 font-bold">
                                                                <i class="fas fa-layer-group mr-0.5"></i><%= performer.assessments_completed %> <%= performer.assessments_completed === 1 ? 'Test' : 'Tests' %> Counted
                                                            </p>
                                                        <% } else { %>
                                                            <p class="text-[10px] text-amber-600 font-bold">
                                                                <i class="fas fa-fire mr-0.5"></i><%= performer.max_combo %>x Combo
                                                            </p>
                                                        <% } %>
                                                    <% } %>
                                                </div>
                                            </div>

                                        <% } else { %>
                                            <!-- Unclaimed Podium Position Placeholder -->
                                            <div class="flex flex-col sm:flex-row sm:items-center justify-between p-4 rounded-2xl border-2 border-dashed border-slate-200 bg-slate-50/50 gap-3">
                                                <div class="flex items-center gap-3.5">
                                                    <span class="w-10 text-center font-black text-slate-300 text-sm">#<%= rankNum %></span>
                                                    <div class="w-12 h-12 rounded-xl bg-slate-100 border border-slate-200 flex items-center justify-center text-slate-400">
                                                        <i class="fas fa-award text-lg opacity-40"></i>
                                                    </div>
                                                    <div>
                                                        <p class="font-bold text-slate-500 text-sm">Unclaimed Podium Position #<%= rankNum %></p>
                                                        <p class="text-[11px] text-slate-400">Complete a session in the Elementa Arcade to claim the <%= rankNum === 2 ? 'Silver' : 'Bronze' %> medal!</p>
                                                    </div>
                                                </div>
                                                <div class="text-right">
                                                    <span class="px-2.5 py-1 rounded-lg text-[10px] font-bold bg-slate-200/60 text-slate-500 border border-slate-300/50">
                                                        Open Podium Slot
                                                    </span>
                                                </div>
                                            </div>
                                        <% } %>
                                    <% } %>

                                    <!-- Actionable Viewer Anchor Section -->
                                    <% if (!threeRankWindow.isMyEntryInTopThree && threeRankWindow.myEntry) { %>
