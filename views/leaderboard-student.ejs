                                                                <i class="fas <%= performer.tier.icon %> mr-1"></i><%= performer.tier.name %> <%= isCumulativeScope ? '(Coursework)' : '(Run)' %>
                                                            </span>

                                                            <!-- Level Reached Badge -->
                                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-black uppercase bg-indigo-50 text-indigo-700 border border-indigo-200">
                                                                <i class="fas fa-layer-group text-[8px]"></i> Lvl <%= performer.highest_level_reached %>
                                                            </span>

                                                            <% if (isCumulativeScope && performer.assessments_completed > 0) { %>
