                                            <%= arcadeStats.radar.analyzingDetails.correct %>/<%= arcadeStats.radar.analyzingDetails.total %> items
                                        <% } else { %>
                                            <span class="bg-slate-100 text-slate-400 px-1.5 py-0.5 rounded text-[9px] font-semibold">Unassessed</span>
