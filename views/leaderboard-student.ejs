                                        <% for (let s = 1; s <= 3; s++) { %>
                                            <i class="<%= s <= d.stars ? 'fas fa-star text-amber-400' : 'far fa-star text-slate-300' %>"></i>
                                        <% } %>
                                    </span>
                                </div>
                                <p class="font-bold text-xs text-slate-800 line-clamp-1" title="<%= d.topicName %>"><%= d.topicName %></p>
                                
                                <div class="mt-2.5 pt-2 border-t border-slate-100 flex items-center justify-between text-[10px]">
                                    <% if (d.played && d.totalItems > 0) { %>
                                        <div>
                                            <span class="text-slate-400">Score:</span>
                                            <b class="text-slate-800 font-black"><%= d.totalGainedScore %>/<%= d.totalItems %></b>
                                            <span class="<%= d.scorePct >= 85 ? 'text-emerald-600' : (d.scorePct >= 60 ? 'text-indigo-600' : (d.totalGainedScore > 0 ? 'text-amber-600' : 'text-slate-400')) %> font-bold ml-0.5">(<%= d.scorePct %>%)</span>
                                        </div>
                                    <% } else if (d.played) { %>
                                        <div>
                                            <span class="text-slate-400">Score:</span>
                                            <b class="text-slate-800 font-black"><%= d.totalGainedScore %> pts</b>
                                        </div>
                                    <% } else { %>
                                        <span class="text-slate-400 italic">Not Attempted</span>
                                    <% } %>

                                    <span class="text-slate-400 flex items-center gap-1 font-medium">
                                        <i class="far fa-clock text-[9px]"></i> <%= d.fastestDuration %>
                                    </span>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <!-- Section 3: Mistake Diagnostic & Instant Topic Review -->
                <div>
                    <div class="flex items-center justify-between mb-3">
                        <h4 class="text-xs font-black uppercase tracking-widest text-slate-400">Mistake Diagnostic & Instant Topic Review</h4>
                        <span class="text-xs text-slate-400">Recent Errors in Lab Workstations</span>
                    </div>

                    <% if (!arcadeStats.mistakes || arcadeStats.mistakes.length === 0) { %>
                        <div class="p-6 text-center bg-slate-50 rounded-2xl border border-slate-100">
                            <p class="text-sm font-bold text-emerald-600"><i class="fas fa-check-circle mr-1"></i> No recent errors recorded. Excellent lab precision!</p>
                        </div>
                    <% } else { %>
                        <div class="space-y-2.5 max-h-60 overflow-y-auto pr-1">
                            <% arcadeStats.mistakes.forEach(m => { 
                                const targetSubjectId = m.matched_subject_id || (m.level_number >= 8 ? 3 : 1);
                                const targetTopicId = m.matched_topic_id || 3;
                                const reviewTopicUrl = `/subjects/open/${targetSubjectId}?topic_id=${targetTopicId}&tab=resources#topic-${targetTopicId}`;
                            %>
                                <div class="p-3.5 rounded-2xl bg-white border border-rose-100 shadow-xs flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                                    <div class="space-y-1">
                                        <div class="flex items-center gap-2">
                                            <span class="px-2 py-0.5 rounded text-[10px] font-black uppercase bg-rose-50 text-rose-600 border border-rose-200">
                                                <%= m.failure_type || (m.is_timeout ? 'Timeout' : 'Mistake') %>
                                            </span>
                                            <span class="text-xs font-bold text-slate-500">Level <%= m.level_number %>: <%= m.level_topic %></span>
                                        </div>
                                        <p class="text-xs text-slate-700 font-medium">Question: "<%= m.question_snapshot || 'Chemical customer order' %>"</p>
                                        <p class="text-[11px] text-slate-500">
                                            Your Answer: <span class="font-bold text-rose-500"><%= m.player_answer || 'None / Timeout' %></span> &middot; Expected: <span class="font-bold text-emerald-600"><%= m.correct_answer %></span>
                                        </p>
                                    </div>
                                    <div class="flex-shrink-0 flex items-center gap-2">
