<%
    var user = locals.user || {};
    var myClasses = locals.myClasses || [];
    var myAssessments = locals.myAssessments || [];
    var curricularTopics = locals.curricularTopics || [];
    var cohortScope = locals.cohortScope || 'all';
    var activeClassId = locals.activeClassId || '';
    var topicScope = locals.topicScope || 'all';
    var assessmentMode = locals.assessmentMode || 'solo';
    var assessmentType = locals.assessmentType || 'all';
    var viewWindow = locals.viewWindow || 'three_rank';
    var sortMode = locals.sortMode || (assessmentMode === 'dual' ? 'wins' : 'best');
    var selectedAssessmentId = locals.selectedAssessmentId || '';
    var isCumulativeScope = locals.isCumulativeScope !== undefined ? locals.isCumulativeScope : (assessmentMode !== 'dual' && !selectedAssessmentId);
    var isGhostMode = Boolean(locals.isGhostMode);
    var ghostName = locals.ghostName || user.ghost_name || '';
    var ghostAvatar = locals.ghostAvatar || user.ghost_avatar || 'ghost_avatar_1.svg';
    var myDisplayAvatar = isGhostMode 
        ? (ghostAvatar.startsWith('/') ? ghostAvatar : '/images/ghost_avatars/' + ghostAvatar)
        : (user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png');
    var myDisplayName = isGhostMode
        ? (ghostName || 'Anonymous Chemist')
        : (user.alternative_name || (user.first_name + ' ' + user.last_name));
    var cohortMedian = locals.cohortMedian || 0;
    var leaderboardRows = locals.leaderboardRows || [];
    var threeRankWindow = locals.threeRankWindow || null;
    var heatMatch = locals.heatMatch || null;
    var arenaLeaderboard = locals.arenaLeaderboard || [];
    var matchHistory = locals.matchHistory || [];
    var topicMasteryRings = locals.topicMasteryRings || [];
    var growthDeltaBoard = locals.growthDeltaBoard || [];
    var periodicGrid = locals.periodicGrid || [];
    var strugglingElements = locals.strugglingElements || [];
    var clickSourceBreakdown = locals.clickSourceBreakdown || [];
    var machineStats = locals.machineStats || [];
    var arcadeStats = (locals && locals.arcadeStats) || (typeof arcadeStats !== 'undefined' ? arcadeStats : null) || {
        cadetLevel: user.current_level || 1,
        totalExp: user.total_exp || 0,
        totalMaxExp: 52100,
        progressPct: 0,
        levelTitle: 'Cadet',
        globalRank: locals.myRank || 'N/A',
        precision: 85,
        bestLevel: 1,
        bestScore: 0,
        totalRuns: 0,
        avgResponseTime: '45.0',
        chemicalTier: { name: 'Alkali Earth', color: 'emerald', icon: 'fa-atom', badgeBg: 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30' },
        cohortMedian: cohortMedian,
        medianDeltaPct: 0,
        benchmarkDialPct: 0,
        radar: { remembering: 75, understanding: 70, applying: 65, analyzing: 60, precision: 80 },
        districtProgress: [],
        mistakes: []
    };
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Chemistry Arcade Leaderboard & Cadet Dossier | Elementa</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap');
        
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        


        .noble-glow {
            box-shadow: 0 0 25px rgba(6, 182, 212, 0.25);
            border-color: rgba(6, 182, 212, 0.4);
        }
        .transition-glow {
            box-shadow: 0 0 25px rgba(245, 158, 11, 0.25);
            border-color: rgba(245, 158, 11, 0.4);
        }
        .alkali-glow {
            box-shadow: 0 0 25px rgba(16, 185, 129, 0.25);
            border-color: rgba(16, 185, 129, 0.4);
        }

        /* Benchmark dial gradient indicator */
        .benchmark-needle {
            transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
    </style>

    <!-- Standardized Student Navigation & Responsive Styles -->
    <%- include('partials/student-nav-styles') %>
</head>
<body class="bg-slate-50 text-slate-900 min-h-screen">

    <div class="flex min-h-screen relative overflow-x-hidden">
        <!-- Standardized Student Sidebar Partial -->
        <%- include('partials/student-sidebar', { activeNav: 'leaderboards' }) %>

        <!-- Main Content Surface -->
        <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 transition-all duration-300">
            <!-- Header bar -->
            <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 sticky top-0 z-40">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    <div>
                        <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight flex items-center gap-2">
                            <i class="fas fa-trophy text-amber-500"></i>
                            <span>Chemistry Arcade Leaderboard</span>
                        </h1>
                        <p class="text-xs text-slate-600 hidden sm:block font-medium">
                            <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                            Cognitive Mastery &nbsp;·&nbsp; <%= new Date().toLocaleDateString('en-PH', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3 md:gap-6">
                    <!-- Messages Navigation Button (Entry point to message-student view) -->
                    <a href="/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                        <i class="far fa-comment-dots text-xl"></i>
                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Messages
                        </span>
                    </a>

                    <!-- Notification Button with keyboard-accessible tooltip -->
                    <button type="button" onclick="toggleNotifications()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                        <i class="far fa-bell text-xl text-slate-700"></i>
                        <span class="absolute top-2 right-2 flex h-2.5 w-2.5 notif-badge hidden" aria-hidden="true">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500 border-2 border-white"></span>
                        </span>
                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Notifications
                        </span>
                    </button>
                    
                    <!-- User Profile Dropdown -->
                    <div class="relative">
                        <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                            <div class="text-right hidden lg:block">
                                <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.alternative_name || (user.first_name + ' ' + user.last_name) %></p>
                                <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none">
                                    <%= user.role %> &middot; <%= arcadeStats.chemicalTier ? arcadeStats.chemicalTier.name : 'Cadet' %>
                                </p>
                            </div>
                            <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100">
                            <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                        </button>

                        <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                            <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                                <p class="text-sm font-bold text-slate-800"><%= user.first_name %></p>
                                <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role %></p>
                            </div>
                            <a href="/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                                <i class="far fa-user w-5 text-center"></i> View Profile
                            </a>
                            <button onclick="promptUpdateGamertag()" class="w-full text-left flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-cyan-50 hover:text-cyan-600 transition">
                                <i class="fas fa-pen-nib w-5 text-center"></i> Edit Gamertag
                            </button>
                            <hr class="my-2 border-slate-100">
                            <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                                <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <div class="p-4 md:px-8 py-8 space-y-8">

                <!-- ================= 1. PERSISTENT "MY STATUS" & BENCHMARK DIAL HERO BAR ================= -->
                <!-- Meets LeaderboardReview.md Section 4.A & Section 3.A/C -->
                <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white p-6 md:p-8 shadow-2xl border border-indigo-500/30">
                    <div class="absolute -right-16 -bottom-16 w-80 h-80 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>
                    <div class="absolute left-1/4 -top-16 w-64 h-64 bg-indigo-500/10 rounded-full blur-3xl pointer-events-none"></div>

                    <div class="relative z-10 flex flex-col xl:flex-row xl:items-center justify-between gap-6">
                        
                        <!-- Left: Student Cadet Identity & Privacy Controls -->
                        <div class="flex items-start sm:items-center gap-5">
                            <div class="relative flex-shrink-0">
                                <img id="heroCadetAvatar" src="<%= myDisplayAvatar %>" class="w-18 h-18 sm:w-20 sm:h-20 rounded-2xl object-cover ring-4 <%= isGhostMode ? 'ring-amber-400/70 shadow-amber-500/20' : 'ring-cyan-500/40' %> shadow-xl transition-all duration-300">
                                <span class="absolute -bottom-2 -right-2 px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider <%= isGhostMode ? 'bg-gradient-to-r from-amber-400 to-orange-500 text-slate-950' : 'bg-gradient-to-r from-cyan-400 to-blue-500 text-slate-950' %> shadow">
                                    <%= isGhostMode ? 'GHOST' : 'Lv. ' + (arcadeStats.cadetLevel || 1) + ' / 12' %>
                                </span>
                            </div>
                            <div class="space-y-1.5">
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase tracking-widest <%= arcadeStats.chemicalTier ? arcadeStats.chemicalTier.badgeBg : 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30' %>" title="Lifetime Precision Tier based on cumulative laboratory accuracy">
                                        <i class="fas <%= arcadeStats.chemicalTier ? arcadeStats.chemicalTier.icon : 'fa-atom' %> mr-1"></i>
                                        <%= arcadeStats.chemicalTier ? arcadeStats.chemicalTier.name : 'Alkali Earth' %> Tier (Career)
                                    </span>
                                    <span class="px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase tracking-widest bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                                        <%= arcadeStats.levelTitle || 'Cadet' %>
                                    </span>
                                    <span class="text-xs text-indigo-300 font-semibold"><%= arcadeStats.globalRank !== 'N/A' ? 'Rank #' + arcadeStats.globalRank : 'Unranked' %> of <%= totalCount %> <%= totalCount === 1 ? 'Student' : 'Students' %></span>
                                    <% if (isGhostMode) { %>
                                        <span class="px-2 py-0.5 rounded-md text-[9px] font-black uppercase tracking-wider bg-amber-400/20 text-amber-300 border border-amber-400/40 flex items-center gap-1">
                                            <i class="fas fa-mask"></i> Incognito Active
                                        </span>
                                    <% } %>
                                </div>

                                <div class="flex items-center gap-2">
                                    <h2 class="text-xl md:text-2xl font-black tracking-tight text-white flex items-center gap-2">
                                        <span id="displayGamertag"><%= myDisplayName %></span>
                                    </h2>
                                    <% if (isGhostMode) { %>
                                        <button onclick="openGhostConfigModal()" title="Customize anonymous persona" class="text-amber-300 hover:text-amber-200 text-xs transition px-2 py-0.5 bg-amber-400/15 hover:bg-amber-400/25 border border-amber-400/30 rounded-lg flex items-center gap-1">
                                            <i class="fas fa-paint-brush text-[10px]"></i>
                                            <span class="text-[10px] font-bold">Edit Persona</span>
                                        </button>
                                    <% } else { %>
                                        <button onclick="promptUpdateGamertag()" title="Change arcade handle" class="text-indigo-400 hover:text-cyan-300 text-xs transition p-1">
                                            <i class="fas fa-edit"></i>
                                        </button>
                                    <% } %>
                                </div>

                                <div class="flex items-center gap-3 text-xs text-indigo-200/80 flex-wrap">
                                    <span>Track: <b class="text-white"><%= isGhostMode ? 'Classified' : (user.strand || 'STEM') %></b></span>
                                    <span>&middot;</span>
                                    <span>Section: <b class="text-white"><%= isGhostMode ? 'Incognito' : (user.section || 'General') %></b></span>
                                    <span>&middot;</span>
                                    <!-- Incognito Ghost Mode Toggle Button -->
                                    <button id="ghostToggleBtn" onclick="handleGhostModeClick()" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black transition <%= isGhostMode ? 'bg-amber-400/20 text-amber-300 border border-amber-400/50 hover:bg-amber-400/30 shadow-xs shadow-amber-400/20' : 'bg-white/10 text-indigo-300 hover:bg-white/20' %>">
                                        <i class="fas <%= isGhostMode ? 'fa-ghost animate-pulse text-amber-300' : 'fa-eye' %>"></i>
                                        <span>Ghost Mode: <b><%= isGhostMode ? 'ON' : 'OFF' %></b></span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- Center: Benchmark Dial relative to Cohort Median (omits raw baseline low scores) -->
                        <div class="bg-slate-950/50 backdrop-blur-md p-4 rounded-2xl border border-white/10 flex flex-col sm:flex-row items-center gap-5 flex-shrink-0">
                            <!-- Visual Dial Semicircle Meter -->
                            <div class="flex items-center gap-3">
                                <div class="relative w-16 h-16 flex items-center justify-center">
                                    <svg class="w-16 h-16 transform -rotate-90">
                                        <circle cx="32" cy="32" r="26" stroke="rgba(255,255,255,0.1)" stroke-width="6" fill="transparent"/>
                                        <circle cx="32" cy="32" r="26" 
                                            stroke="<%= (arcadeStats.bestScore || 0) === 0 ? '#475569' : (arcadeStats.medianDeltaPct > 0 ? '#10b981' : (arcadeStats.medianDeltaPct === 0 ? '#06b6d4' : '#f59e0b')) %>" 
                                            stroke-width="6" 
                                            stroke-dasharray="163" 
                                            stroke-dashoffset="<%= Math.max(10, 163 - ((arcadeStats.benchmarkDialPct || 0) * 1.63)) %>" 
                                            stroke-linecap="round" fill="transparent"/>
                                    </svg>
                                    <div class="absolute inset-0 flex flex-col items-center justify-center text-center">
                                        <% if ((arcadeStats.bestScore || 0) === 0) { %>
                                            <span class="text-[11px] font-black text-slate-400">0</span>
                                            <span class="text-[8px] font-bold text-slate-500 uppercase">RUNS</span>
                                        <% } else if (arcadeStats.medianDeltaPct > 0) { %>
                                            <span class="text-xs font-black text-emerald-400">+<%= arcadeStats.medianDeltaPct %>%</span>
                                            <span class="text-[8px] font-bold text-slate-400 uppercase">DIAL</span>
                                        <% } else if (arcadeStats.medianDeltaPct === 0) { %>
                                            <span class="text-xs font-black text-cyan-400">MED</span>
                                            <span class="text-[8px] font-bold text-slate-400 uppercase">DIAL</span>
                                        <% } else { %>
                                            <span class="text-xs font-black text-amber-400"><%= arcadeStats.medianDeltaPct %>%</span>
                                            <span class="text-[8px] font-bold text-slate-400 uppercase">DIAL</span>
                                        <% } %>
                                    </div>
                                </div>
                                <div>
                                    <p class="text-[10px] font-bold uppercase tracking-wider text-indigo-300">Benchmark Dial</p>
                                    <% if ((arcadeStats.bestScore || 0) === 0) { %>
                                        <p class="text-sm font-black text-slate-400">No Runs Yet</p>
                                        <p class="text-[10px] text-slate-400">Cohort Median: <%= cohortMedian %> pts</p>
                                    <% } else if (arcadeStats.medianDeltaPct > 0) { %>
                                        <p class="text-sm font-black text-emerald-400">+<%= arcadeStats.medianDeltaPct %>% Above Median</p>
                                        <p class="text-[10px] text-slate-400">vs Cohort Median (<%= cohortMedian %> pts)</p>
                                    <% } else if (arcadeStats.medianDeltaPct === 0) { %>
                                        <p class="text-sm font-black text-cyan-400">At Cohort Median</p>
                                        <p class="text-[10px] text-slate-400">Matches <%= cohortMedian %> pts benchmark</p>
                                    <% } else { %>
                                        <p class="text-sm font-black text-amber-400"><%= Math.abs(arcadeStats.medianDeltaPct) %>% Below Median</p>
                                        <p class="text-[10px] text-slate-400">vs Cohort Median (<%= cohortMedian %> pts)</p>
                                    <% } %>
                                    <p class="text-[9px] text-indigo-300/80 font-semibold mt-0.5">Lab Precision: <b class="text-white"><%= arcadeStats.precision %>%</b></p>
                                </div>
                            </div>

                            <div class="h-10 w-px bg-white/10 hidden sm:block"></div>

                            <!-- Topic Mastery Rings Preview -->
                            <div class="flex items-center gap-2">
                                <% (topicMasteryRings || []).slice(0, 3).forEach(ring => { %>
                                    <div class="flex flex-col items-center" title="<%= ring.name %>: <%= ring.percent %>% mastery (<%= ring.status %>)">
                                        <div class="w-9 h-9 rounded-full flex items-center justify-center border-2" style="border-color: <%= ring.color %>; background: rgba(13, 26, 46, 0.6);">
                                            <i class="fas <%= ring.icon %> text-xs" style="color: <%= ring.color %>;"></i>
                                        </div>
                                        <span class="text-[9px] font-bold mt-1 text-slate-300"><%= ring.percent %>%</span>
                                    </div>
                                <% }) %>
                            </div>
                        </div>

                        <!-- Right: Cadet Dossier CTA -->
                        <div class="flex-shrink-0">
                            <button onclick="openCadetDossierModal()" class="w-full xl:w-auto px-6 py-3.5 rounded-2xl font-black text-sm bg-gradient-to-r from-cyan-400 via-teal-400 to-indigo-500 text-slate-950 shadow-lg shadow-cyan-500/25 hover:shadow-cyan-500/40 hover:scale-[1.02] active:scale-[0.98] transition flex items-center justify-center gap-2.5">
                                <i class="fas fa-id-badge text-base"></i>
                                <span>Cadet Cognitive Dossier</span>
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ================= 2. GLOBAL NAVIGATION & 3-DIMENSIONAL CONTROL TOOLBAR ================= -->
                <!-- Meets LeaderboardReview.md Section 1: Cohort Scope, Topic Scope & Assessment Mode -->
                <div class="bg-white p-4 rounded-3xl border border-slate-100 shadow-sm space-y-4">
                    
                    <!-- Dimension A & C: Cohort Scope & Assessment Mode Selection -->
                    <div class="flex flex-col lg:flex-row items-stretch lg:items-center justify-between gap-4">
                        
                        <!-- Dimension A: Cohort Scope (My Class Section vs All Sections) -->
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 mr-1">Cohort Scope:</span>
                            <div class="inline-flex bg-slate-100 p-1 rounded-2xl">
                                <a href="?cohort_scope=all&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=<%= assessmentType %>&assessment_id=<%= selectedAssessmentId %>&view_window=<%= viewWindow %>&sort=<%= sortMode %>" 
                                   class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition <%= cohortScope === 'all' ? 'bg-white text-indigo-600 shadow-xs' : 'text-slate-500 hover:text-slate-900' %>">
                                    <i class="fas fa-globe mr-1 text-[11px]"></i> All Sections (Grade-Level)
                                </a>
                                <a href="?cohort_scope=class&class_id=<%= activeClassId || (myClasses[0] ? myClasses[0].class_id : '') %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=<%= assessmentType %>&assessment_id=<%= selectedAssessmentId %>&view_window=<%= viewWindow %>&sort=<%= sortMode %>" 
                                   class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition <%= cohortScope === 'class' ? 'bg-white text-indigo-600 shadow-xs' : 'text-slate-500 hover:text-slate-900' %>">
                                    <i class="fas fa-users mr-1 text-[11px]"></i> My Class Section
                                </a>
                            </div>

                            <% if (cohortScope === 'class' && myClasses.length > 0) { %>
                                <form method="GET" action="/leaderboards" class="inline-flex items-center">
                                    <input type="hidden" name="cohort_scope" value="class">
                                    <input type="hidden" name="mode" value="<%= assessmentMode %>">
                                    <input type="hidden" name="topic_scope" value="<%= topicScope %>">
                                    <input type="hidden" name="assessment_type" value="<%= assessmentType %>">
                                    <input type="hidden" name="assessment_id" value="<%= selectedAssessmentId %>">
                                    <input type="hidden" name="view_window" value="<%= viewWindow %>">
                                    <input type="hidden" name="sort" value="<%= sortMode %>">
                                    <select name="class_id" onchange="this.form.submit()" class="text-xs font-bold bg-slate-100 border-none rounded-xl px-3 py-2 text-slate-700 focus:ring-2 focus:ring-indigo-500">
                                        <% myClasses.forEach(c => { %>
                                            <option value="<%= c.class_id %>" <%= String(activeClassId) === String(c.class_id) ? 'selected' : '' %>><%= c.class_name %></option>
                                        <% }) %>
                                    </select>
                                </form>
                            <% } %>
                        </div>

                        <!-- Dimension C: Assessment Mode Selection (Solo vs Dual) -->
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 mr-1">Assessment Mode:</span>
                            <div class="inline-flex bg-slate-100 p-1 rounded-2xl">
                                <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=solo&topic_scope=<%= topicScope %>&assessment_type=<%= assessmentType %>&assessment_id=&view_window=<%= viewWindow %>&sort=best" 
                                   class="px-4 py-1.5 rounded-xl text-xs font-bold transition <%= assessmentMode === 'solo' ? 'bg-blue-600 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
                                    <i class="fas fa-user mr-1.5"></i> Solo Mode (High Score & Precision)
                                </a>
                                <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=dual&topic_scope=<%= topicScope %>&assessment_type=<%= assessmentType %>&assessment_id=&view_window=<%= viewWindow %>&sort=wins" 
                                   class="px-4 py-1.5 rounded-xl text-xs font-bold transition <%= assessmentMode === 'dual' ? 'bg-purple-600 text-white shadow-xs' : 'text-slate-600 hover:text-slate-900' %>">
                                    <i class="fas fa-user-ninja mr-1.5"></i> Dual Mode (Most Wins 1v1)
                                </a>
                            </div>
                        </div>

                    </div>

                    <!-- Dimension B: Curricular Topic Scope Pills -->
                    <div class="border-t border-slate-100 pt-3">
                        <div class="flex items-center gap-2 overflow-x-auto no-scrollbar pb-1">
                            <span class="text-[10px] font-black uppercase tracking-wider text-slate-400 mr-1 flex-shrink-0">Curricular Topic:</span>
                            <% (curricularTopics || []).forEach(top => { %>
                                <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= top.id %>&assessment_type=<%= assessmentType %>&assessment_id=&view_window=<%= viewWindow %>&sort=<%= sortMode %>"
                                   class="px-3.5 py-1 rounded-xl text-xs font-bold whitespace-nowrap transition <%= topicScope === top.id ? 'bg-indigo-50 text-indigo-700 border border-indigo-200 shadow-2xs' : 'bg-slate-50 text-slate-600 hover:bg-slate-100 border border-transparent' %>">
                                    <% if (top.subject && top.id !== 'all') { %>
                                        <span class="text-[9px] text-indigo-400 font-semibold mr-1">[<%= top.subject %>]</span>
                                    <% } %>
                                    <%= top.name %>
                                </a>
                            <% }) %>
                        </div>
                    </div>

                    <!-- Dimension D: Assessment Categorized Dropdown Filter (Pre-Test, Post-Test, Quiz) -->
                    <div class="border-t border-slate-100 pt-3 flex flex-col md:flex-row md:items-center justify-between gap-3">
                        <form method="GET" action="/leaderboards" class="flex flex-wrap items-center gap-3 w-full">
                            <input type="hidden" name="cohort_scope" value="<%= cohortScope %>">
                            <input type="hidden" name="class_id" value="<%= activeClassId %>">
                            <input type="hidden" name="mode" value="<%= assessmentMode %>">
                            <input type="hidden" name="topic_scope" value="<%= topicScope %>">
                            <input type="hidden" name="assessment_type" value="<%= assessmentType %>">
                            <input type="hidden" name="view_window" value="<%= viewWindow %>">
                            <input type="hidden" name="sort" value="<%= sortMode %>">

                            <div class="flex items-center gap-2">
                                <span class="text-[10px] font-black uppercase tracking-wider text-slate-400">Type:</span>
                                <div class="inline-flex bg-slate-100 p-0.5 rounded-xl text-xs font-bold">
                                    <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=all&assessment_id=&view_window=<%= viewWindow %>&sort=<%= sortMode %>"
                                       class="px-2.5 py-1 rounded-lg transition <%= assessmentType === 'all' ? 'bg-white text-indigo-600 shadow-2xs' : 'text-slate-600 hover:text-slate-900' %>">
                                       All
                                    </a>
                                    <% if (assessmentMode === 'dual') { %>
                                        <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=Competitive&assessment_id=&view_window=<%= viewWindow %>&sort=<%= sortMode %>"
                                           class="px-2.5 py-1 rounded-lg transition <%= assessmentType === 'Competitive' ? 'bg-white text-purple-600 shadow-2xs' : 'text-slate-600 hover:text-slate-900' %>">
                                           Competitive Duel
                                        </a>
                                    <% } else { %>
                                        <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=Pre-Test&assessment_id=&view_window=<%= viewWindow %>&sort=<%= sortMode %>"
                                           class="px-2.5 py-1 rounded-lg transition <%= assessmentType === 'Pre-Test' ? 'bg-white text-indigo-600 shadow-2xs' : 'text-slate-600 hover:text-slate-900' %>">
                                           Pre-Test
                                        </a>
                                        <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=Post-Test&assessment_id=&view_window=<%= viewWindow %>&sort=<%= sortMode %>"
                                           class="px-2.5 py-1 rounded-lg transition <%= assessmentType === 'Post-Test' ? 'bg-white text-indigo-600 shadow-2xs' : 'text-slate-600 hover:text-slate-900' %>">
                                           Post-Test
                                        </a>
                                        <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=Quiz&assessment_id=&view_window=<%= viewWindow %>&sort=<%= sortMode %>"
                                           class="px-2.5 py-1 rounded-lg transition <%= assessmentType === 'Quiz' ? 'bg-white text-indigo-600 shadow-2xs' : 'text-slate-600 hover:text-slate-900' %>">
                                           Quiz
                                        </a>
                                    <% } %>
                                </div>
                            </div>

                            <div class="flex items-center gap-2 flex-1 min-w-[260px]">
                                <label class="text-[10px] font-black uppercase tracking-wider text-slate-400 whitespace-nowrap">Assessment:</label>
                                <select name="assessment_id" onchange="this.form.submit()" class="w-full text-xs font-bold border border-slate-200 rounded-xl px-3 py-1.5 text-slate-700 bg-white focus:ring-2 focus:ring-indigo-500">
                                    <option value="">
                                        All <%= assessmentMode === 'dual' ? 'Dual' : 'Solo' %> Assessments (<%= assessmentType === 'all' ? (assessmentMode === 'dual' ? 'Competitive Duels' : 'Pre-Test, Post-Test, Quiz') : assessmentType %>)
                                    </option>
                                    <% if (myAssessments.length === 0) { %>
                                        <option value="" disabled>No <%= assessmentMode === 'dual' ? 'Dual ' : 'Solo ' %>assessments found for this topic & type</option>
                                    <% } %>
                                    <% 
                                        var preTests = (myAssessments || []).filter(a => a.assessment_type === 'Pre-Test');
                                        var postTests = (myAssessments || []).filter(a => a.assessment_type === 'Post-Test');
                                        var quizzes = (myAssessments || []).filter(a => a.assessment_type === 'Quiz');
                                        var compTests = (myAssessments || []).filter(a => a.assessment_type === 'Competitive');
                                    %>
                                    <% if (preTests.length > 0) { %>
                                        <optgroup label="📋 Pre-Tests">
                                            <% preTests.forEach(a => { %>
                                                <option value="<%= a.assessment_id %>" <%= String(selectedAssessmentId) === String(a.assessment_id) ? 'selected' : '' %>>
                                                    [Pre-Test] <%= a.assessment_name %> (<%= a.topic_name %>)
                                                </option>
                                            <% }) %>
                                        </optgroup>
                                    <% } %>
                                    <% if (postTests.length > 0) { %>
                                        <optgroup label="🎯 Post-Tests">
                                            <% postTests.forEach(a => { %>
                                                <option value="<%= a.assessment_id %>" <%= String(selectedAssessmentId) === String(a.assessment_id) ? 'selected' : '' %>>
                                                    [Post-Test] <%= a.assessment_name %> (<%= a.topic_name %>)
                                                </option>
                                            <% }) %>
                                        </optgroup>
                                    <% } %>
                                    <% if (quizzes.length > 0) { %>
                                        <optgroup label="⚡ Quizzes">
                                            <% quizzes.forEach(a => { %>
                                                <option value="<%= a.assessment_id %>" <%= String(selectedAssessmentId) === String(a.assessment_id) ? 'selected' : '' %>>
                                                    [Quiz] <%= a.assessment_name %> (<%= a.topic_name %>)
                                                </option>
                                            <% }) %>
                                        </optgroup>
                                    <% } %>
                                    <% if (compTests.length > 0) { %>
                                        <optgroup label="⚔️ Competitive Duels">
                                            <% compTests.forEach(a => { %>
                                                <option value="<%= a.assessment_id %>" <%= String(selectedAssessmentId) === String(a.assessment_id) ? 'selected' : '' %>>
                                                    [Competitive] <%= a.assessment_name %> (<%= a.topic_name %>)
                                                </option>
                                            <% }) %>
                                        </optgroup>
                                    <% } %>
                                </select>
                            </div>
                        </form>
                    </div>

                    <!-- Framing View Switcher: Three-Rank Window vs Full Board vs Most Improved -->
                    <div class="border-t border-slate-100 pt-3 flex flex-wrap items-center justify-between gap-3">
                        <div class="flex items-center gap-1.5 bg-slate-100 p-1 rounded-2xl">
                            <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=<%= assessmentType %>&assessment_id=<%= selectedAssessmentId %>&view_window=three_rank&sort=<%= sortMode %>"
                               class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition <%= viewWindow === 'three_rank' ? 'bg-white text-indigo-600 shadow-xs' : 'text-slate-500 hover:text-slate-900' %>">
                                <i class="fas fa-crosshairs mr-1"></i> Three-Rank Window
                            </a>
                            <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=<%= assessmentType %>&assessment_id=<%= selectedAssessmentId %>&view_window=full&sort=<%= sortMode %>"
                               class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition <%= viewWindow === 'full' ? 'bg-white text-indigo-600 shadow-xs' : 'text-slate-500 hover:text-slate-900' %>">
                                <i class="fas fa-list-ol mr-1"></i> Full Standings
                            </a>
                            <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=<%= assessmentType %>&assessment_id=<%= selectedAssessmentId %>&view_window=growth&sort=growth"
                               class="px-3.5 py-1.5 rounded-xl text-xs font-bold transition <%= viewWindow === 'growth' ? 'bg-white text-emerald-600 shadow-xs' : 'text-slate-500 hover:text-slate-900' %>">
                                <i class="fas fa-arrow-trend-up mr-1"></i> Most Improved
                            </a>
                        </div>

                        <!-- Secondary Tab Toggles (Leaderboard / Heatmap / Machines) -->
                        <div class="flex items-center gap-1 ml-auto">
                            <button type="button" onclick="showTab('standingsContent')" id="tabBtn-standingsContent" class="tab-btn active-tab px-4 py-1.5 rounded-xl text-xs font-bold bg-blue-600 text-white shadow-xs transition">Standings</button>
                            <button type="button" onclick="showTab('mastery')" id="tabBtn-mastery" class="tab-btn px-4 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition">Element Heatmap</button>
                            <button type="button" onclick="showTab('machines')" id="tabBtn-machines" class="tab-btn px-4 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-600 border border-slate-200 hover:bg-slate-50 transition">Machine Stats</button>
                        </div>
                    </div>
                </div>

                <!-- ================= 3. LEADERBOARD DISPLAY SURFACES ================= -->
                <div id="standingsContent" class="tab-content space-y-6">

                    <!-- ================= DUAL MODE: FEATURED HEAT MATCH / GREAT MATCH SHOWDOWN ================= -->
                    <% if (assessmentMode === 'dual' && heatMatch) { %>
                        <div class="relative overflow-hidden rounded-3xl bg-gradient-to-r from-purple-950 via-slate-900 to-indigo-950 p-6 md:p-8 text-white shadow-2xl border-2 border-purple-500/40 space-y-6">
                            <div class="absolute -right-12 -top-12 w-64 h-64 bg-rose-500/10 rounded-full blur-3xl pointer-events-none"></div>
                            <div class="absolute -left-12 -bottom-12 w-64 h-64 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

                            <div class="relative z-10 flex flex-col md:flex-row md:items-center justify-between gap-4 border-b border-white/10 pb-4">
                                <div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-wider bg-rose-500/20 text-rose-300 border border-rose-500/40 animate-pulse">
                                            <i class="fas fa-fire-flame-curved text-amber-400"></i>
                                            <span>HEAT MATCH / GREAT MATCH SHOWDOWN</span>
                                        </span>
                                        <span class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                                            Dual 1v1 Clash
                                        </span>
                                    </div>
                                    <h3 class="text-xl md:text-2xl font-black text-white mt-1.5 tracking-tight flex items-center gap-2">
                                        <span><%= heatMatch.assessment_name || 'Dual Arena Showdown' %></span>
                                    </h3>
                                    <p class="text-xs text-purple-200/80 mt-0.5">
                                        Closest, highest-intensity match on record with a razor-thin <%= heatMatch.score_diff %>-point margin!
                                    </p>
                                </div>
                                <div class="flex items-center gap-3 bg-white/5 backdrop-blur-md px-4 py-2 rounded-2xl border border-white/10 text-xs">
                                    <div>
                                        <span class="text-[9px] uppercase font-bold text-slate-400 block">Clash Duration</span>
                                        <span class="font-black text-cyan-300"><i class="far fa-clock mr-1"></i><%= heatMatch.formatted_duration %></span>
                                    </div>
                                    <div class="h-6 w-px bg-white/10"></div>
                                    <div>
                                        <span class="text-[9px] uppercase font-bold text-slate-400 block">Level Tier</span>
                                        <span class="font-black text-amber-300"><i class="fas fa-layer-group mr-1"></i>Lvl <%= heatMatch.highest_level_reached %></span>
                                    </div>
                                </div>
                            </div>

                            <!-- The Two Players Head-to-Head Display -->
                            <div class="relative z-10 grid grid-cols-1 md:grid-cols-2 gap-4 items-center">
                                <!-- Player 1 Card -->
                                <div class="relative p-5 rounded-2xl bg-slate-900/80 border <%= heatMatch.winner === 'P1' ? 'border-amber-400/60 shadow-lg shadow-amber-500/10' : 'border-white/10' %> flex items-center justify-between">
                                    <div class="flex items-center gap-4">
                                        <div class="relative">
                                            <img src="<%= heatMatch.p1_avatar || (heatMatch.p1_pic ? '/profile_uploads/' + heatMatch.p1_pic : '/profile_uploads/default_avatar.png') %>" class="w-14 h-14 rounded-2xl object-cover ring-2 <%= heatMatch.p1_is_ghost ? 'ring-amber-400' : (heatMatch.winner === 'P1' && (heatMatch.final_score_p1 > 0 || heatMatch.final_score_p2 > 0) ? 'ring-amber-400' : 'ring-white/20') %>">
                                            <% if (heatMatch.winner === 'P1' && (heatMatch.final_score_p1 > 0 || heatMatch.final_score_p2 > 0)) { %>
                                                <span class="absolute -top-2 -left-2 w-6 h-6 rounded-full bg-amber-400 text-slate-950 font-black text-xs flex items-center justify-center shadow">👑</span>
                                            <% } %>
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <p class="font-black text-white text-sm"><%= heatMatch.p1_name %></p>
                                                <% if (heatMatch.final_score_p1 === 0 && heatMatch.final_score_p2 === 0) { %>
                                                    <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase bg-rose-500/20 text-rose-300 border border-rose-500/30">
                                                        FAILED
                                                    </span>
                                                <% } else { %>
                                                    <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase <%= heatMatch.winner === 'P1' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-slate-700 text-slate-300' %>">
                                                        <%= heatMatch.winner === 'P1' ? 'VICTORY' : (heatMatch.winner === 'Tie' ? 'DRAW' : 'DEFEAT') %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="text-[10px] text-slate-400"><%= heatMatch.p1_section || 'General' %> &middot; Player 1</p>
                                            <p class="text-[10px] text-indigo-300 mt-1"><i class="far fa-calendar-alt mr-1"></i><%= heatMatch.formatted_started_at %></p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-2xl font-black text-cyan-400"><%= heatMatch.final_score_p1 %> <span class="text-xs text-slate-400 font-bold">PTS</span></p>
                                    </div>
                                </div>

                                <!-- Player 2 Card -->
                                <div class="relative p-5 rounded-2xl bg-slate-900/80 border <%= heatMatch.winner === 'P2' && (heatMatch.final_score_p1 > 0 || heatMatch.final_score_p2 > 0) ? 'border-amber-400/60 shadow-lg shadow-amber-500/10' : 'border-white/10' %> flex items-center justify-between">
                                    <div class="flex items-center gap-4">
                                        <div class="relative">
                                            <img src="<%= heatMatch.p2_avatar || (heatMatch.p2_pic ? '/profile_uploads/' + heatMatch.p2_pic : '/profile_uploads/default_avatar.png') %>" class="w-14 h-14 rounded-2xl object-cover ring-2 <%= heatMatch.p2_is_ghost ? 'ring-amber-400' : (heatMatch.winner === 'P2' && (heatMatch.final_score_p1 > 0 || heatMatch.final_score_p2 > 0) ? 'ring-amber-400' : 'ring-white/20') %>">
                                            <% if (heatMatch.winner === 'P2' && (heatMatch.final_score_p1 > 0 || heatMatch.final_score_p2 > 0)) { %>
                                                <span class="absolute -top-2 -left-2 w-6 h-6 rounded-full bg-amber-400 text-slate-950 font-black text-xs flex items-center justify-center shadow">👑</span>
                                            <% } %>
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <p class="font-black text-white text-sm"><%= heatMatch.p2_name %></p>
                                                <% if (heatMatch.final_score_p1 === 0 && heatMatch.final_score_p2 === 0) { %>
                                                    <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase bg-rose-500/20 text-rose-300 border border-rose-500/30">
                                                        FAILED
                                                    </span>
                                                <% } else { %>
                                                    <span class="px-2 py-0.5 rounded text-[9px] font-black uppercase <%= heatMatch.winner === 'P2' ? 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' : 'bg-slate-700 text-slate-300' %>">
                                                        <%= heatMatch.winner === 'P2' ? 'VICTORY' : (heatMatch.winner === 'Tie' ? 'DRAW' : 'DEFEAT') %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="text-[10px] text-slate-400"><%= heatMatch.p2_section || 'General' %> &middot; Player 2</p>
                                            <p class="text-[10px] text-indigo-300 mt-1"><i class="far fa-calendar-alt mr-1"></i><%= heatMatch.formatted_ended_at %></p>
                                        </div>
                                    </div>
                                    <div class="text-right">
                                        <p class="text-2xl font-black text-cyan-400"><%= heatMatch.final_score_p2 %> <span class="text-xs text-slate-400 font-bold">PTS</span></p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% } else if (assessmentMode === 'dual' && selectedAssessmentId) { %>
                        <!-- Awaiting Duel Banner when assessment is selected but no 1v1 match played yet -->
                        <div class="p-6 rounded-3xl bg-gradient-to-r from-purple-900/20 via-slate-900/30 to-indigo-900/20 border border-purple-500/20 text-center space-y-2">
                            <div class="w-12 h-12 rounded-2xl bg-purple-500/20 text-purple-400 flex items-center justify-center mx-auto text-xl">
                                <i class="fas fa-gamepad"></i>
                            </div>
                            <h4 class="font-black text-slate-800 text-sm">Awaiting First Heat Match Showdown</h4>
                            <p class="text-xs text-slate-500 max-w-md mx-auto">No 1v1 dual match has been completed yet for this specific assessment. Challenge a classmate in the arcade kiosk to establish the record!</p>
                        </div>
                    <% } %>

                    <!-- SURFACE 1: THE THREE-RANK WINDOW -->
                    <% if (viewWindow === 'three_rank') { %>
                        <div class="bg-gradient-to-b from-white to-slate-50 p-6 md:p-8 rounded-3xl border border-slate-200 shadow-sm space-y-6">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
                                <div>
                                    <h3 class="text-base font-black text-slate-800 flex items-center gap-2">
                                        <i class="fas fa-trophy text-amber-500"></i>
                                        <span>Podium Showcase: Top 3 Exceptional Performers</span>
                                    </h3>
                                    <p class="text-xs text-slate-500">
                                        <%= assessmentMode === 'dual' 
                                            ? 'Highlighting the top 3 competitive duel commanders with the highest battle wins and combat mastery.' 
                                            : (isCumulativeScope 
                                                ? 'Highlighting the top 3 exceptional performers with the highest cumulative scores across coursework assessments.' 
                                                : 'Highlighting the top 3 exceptional performers with the highest scores, precision, and efficiency for this assessment scope.') %>
                                    </p>
                                </div>
                                <a href="?cohort_scope=<%= cohortScope %>&class_id=<%= activeClassId %>&mode=<%= assessmentMode %>&topic_scope=<%= topicScope %>&assessment_type=<%= assessmentType %>&assessment_id=<%= selectedAssessmentId %>&view_window=full&sort=<%= sortMode %>" 
                                   class="text-xs font-bold text-indigo-600 hover:text-indigo-800 inline-flex items-center gap-1.5 self-start sm:self-auto">
                                    <span>View Full Cohort Standings (<%= leaderboardRows.length %> <%= leaderboardRows.length === 1 ? 'Student' : 'Students' %>)</span>
                                    <i class="fas fa-arrow-right text-[10px]"></i>
                                </a>
                            </div>

                            <% if (leaderboardRows.length === 0) { %>
                                <div class="py-12 px-6 text-center max-w-md mx-auto">
                                    <div class="w-16 h-16 rounded-3xl bg-indigo-50 border border-indigo-100 flex items-center justify-center mx-auto mb-4 text-indigo-500 shadow-sm">
                                        <i class="fas fa-filter-circle-xmark text-2xl"></i>
                                    </div>
                                    <h4 class="font-black text-slate-800 text-base mb-1">No Assessment Records Found</h4>
                                    <p class="text-xs text-slate-500 leading-relaxed mb-4">
                                        No students in this cohort have completed sessions under the selected <%= assessmentMode === 'dual' ? 'Dual (1v1 Versus)' : 'Solo' %> assessment filter yet.
                                    </p>
                                    <a href="?cohort_scope=all&class_id=&mode=<%= assessmentMode %>&topic_scope=all&assessment_type=all&view_window=three_rank&sort=<%= sortMode %>" 
                                       class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-slate-100 text-slate-700 hover:bg-slate-200 transition">
                                        <i class="fas fa-rotate-left"></i> Reset Filter Scope
                                    </a>
                                </div>
                            <% } else { %>
                                <div class="space-y-4 max-w-3xl mx-auto">
                                    
                                    <!-- Render Top 3 Positions (#1, #2, #3) -->
                                    <% for (let podiumIdx = 0; podiumIdx < 3; podiumIdx++) { %>
                                        <% const performer = (threeRankWindow.topThree && threeRankWindow.topThree[podiumIdx]) ? threeRankWindow.topThree[podiumIdx] : null; %>
                                        <% const rankNum = podiumIdx + 1; %>

                                        <% if (performer) { %>
                                            <% 
                                                // Dynamic podium card styling based on rank
                                                let cardBorder = 'border-slate-200 bg-white shadow-2xs';
                                                let rankBadgeClass = 'bg-slate-100 text-slate-700 border-slate-300';
                                                let medalIcon = 'fa-medal text-slate-400';
                                                let podiumTitle = '2nd Place · Silver Podium';

                                                if (rankNum === 1) {
                                                    cardBorder = 'border-amber-300 bg-gradient-to-r from-amber-50/70 via-white to-amber-50/30 shadow-sm';
                                                    rankBadgeClass = 'bg-amber-100 text-amber-800 border-amber-300';
                                                    medalIcon = 'fa-crown text-amber-500';
                                                    podiumTitle = '1st Place · Gold Podium';
                                                } else if (rankNum === 3) {
                                                    cardBorder = 'border-amber-900/15 bg-white shadow-2xs';
                                                    rankBadgeClass = 'bg-amber-800/10 text-amber-900 border-amber-700/30';
