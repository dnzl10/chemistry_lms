                                                        <div class="flex items-center gap-2">
                                                            <div class="w-14 bg-slate-100 rounded-full h-1.5">
                                                                <div class="bg-purple-500 h-1.5 rounded-full" style="width: <%= row.win_rate %>%"></div>
                                                            </div>
                                                            <span class="text-xs font-bold text-purple-700"><%= row.win_rate %>%</span>
                                                        </div>
                                                    </td>

                                                    <!-- Dual Mode: Arena Rating / MMR -->
                                                    <td class="py-3 px-4 text-right whitespace-nowrap font-black text-purple-600 text-xs">
                                                        <%= row.arena_elo || 1200 %> <span class="text-[10px] text-slate-400">MMR</span>
                                                    </td>
                                                <% } else if (isCumulativeScope) { %>
                                                    <!-- Solo Cumulative Mode: Chemical Phase Tier Mastery Badge -->
                                                    <td class="py-3 px-4 whitespace-nowrap">
                                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase <%= row.tier.badgeBg %>" title="Coursework Cumulative Mastery Tier">
                                                            <i class="fas <%= row.tier.icon %>"></i>
                                                            <span><%= row.tier.name %> (Coursework)</span>
                                                        </span>
                                                    </td>

                                                    <!-- Solo Cumulative Mode: Accuracy Rate -->
                                                    <td class="py-3 px-4 whitespace-nowrap">
                                                        <div class="flex items-center gap-2">
                                                            <div class="w-16 bg-slate-100 rounded-full h-1.5">
                                                                <div class="bg-cyan-500 h-1.5 rounded-full" style="width: <%= row.accuracy_pct %>%"></div>
                                                            </div>
                                                            <span class="text-xs font-bold text-slate-700"><%= Number(row.accuracy_pct).toFixed(1) %>%</span>
                                                        </div>
                                                    </td>

                                                    <!-- Solo Cumulative Mode: Score -->
                                                    <td class="py-3 px-4 whitespace-nowrap font-black text-slate-800 text-sm">
                                                        <%= row.best_score_total %> <span class="text-[10px] text-slate-400 font-bold">PTS</span>
                                                    </td>

                                                    <!-- Solo Cumulative Mode: Assessments Completed -->
                                                    <td class="py-3 px-4 text-right whitespace-nowrap">
                                                        <span class="inline-flex items-center gap-1 text-xs font-black text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full border border-emerald-200" title="Completed Formal Assessments Count">
                                                            <i class="fas fa-clipboard-check text-emerald-600"></i> <%= row.assessments_completed %> <%= row.assessments_completed === 1 ? 'Test' : 'Tests' %>
                                                        </span>
                                                    </td>
                                                <% } else { %>
                                                    <!-- Solo Single Run Mode: Chemical Phase Tier Mastery Badge -->
                                                    <td class="py-3 px-4 whitespace-nowrap">
                                                        <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-md text-[10px] font-black uppercase <%= row.tier.badgeBg %>" title="Run Mastery Tier (Single Assessment Attempt)">
                                                            <i class="fas <%= row.tier.icon %>"></i>
                                                            <span><%= row.tier.name %> (Run)</span>
                                                        </span>
                                                    </td>

                                                    <!-- Solo Single Run Mode: Accuracy Rate -->
                                                    <td class="py-3 px-4 whitespace-nowrap">
                                                        <div class="flex items-center gap-2">
                                                            <div class="w-16 bg-slate-100 rounded-full h-1.5">
                                                                <div class="bg-cyan-500 h-1.5 rounded-full" style="width: <%= row.accuracy_pct %>%"></div>
                                                            </div>
                                                            <span class="text-xs font-bold text-slate-700"><%= Number(row.accuracy_pct).toFixed(1) %>%</span>
                                                        </div>
                                                    </td>

                                                    <!-- Solo Single Run Mode: Score -->
                                                    <td class="py-3 px-4 whitespace-nowrap font-black text-slate-800 text-sm">
                                                        <%= row.best_score_total %> <span class="text-[10px] text-slate-400 font-bold">PTS</span>
                                                    </td>

                                                    <!-- Solo Single Run Mode: Max Combo -->
                                                    <td class="py-3 px-4 text-right whitespace-nowrap">
                                                        <span class="inline-flex items-center gap-1 text-xs font-black text-amber-500 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200">
                                                            <i class="fas fa-fire"></i> <%= row.max_combo %>x
                                                        </span>
                                                    </td>
                                                <% } %>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                    <!-- SURFACE 3: MOST IMPROVED (GROWTH DELTA BOARD) -->
                    <% } else if (viewWindow === 'growth') { %>
                        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6 space-y-6">
                            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-slate-100 pb-4">
                                <div>
                                    <h3 class="text-base font-black text-emerald-700 flex items-center gap-2">
                                        <i class="fas fa-arrow-trend-up text-emerald-500"></i>
                                        <span>Most Improved: Chronological Growth Velocity</span>
                                    </h3>
                                    <p class="text-xs text-slate-500">
                                        <%= assessmentMode === 'dual' 
                                            ? 'Spotlighting 1v1 battle commanders demonstrating exceptional win progression and combat mastery.' 
                                            : 'Spotlighting authentic learning gains from Pre-Test to Post-Test and chronological session score movement.' %>
                                    </p>
                                </div>
                                <span class="text-xs text-emerald-700 font-black bg-emerald-50 px-3 py-1 rounded-full border border-emerald-200 self-start sm:self-auto flex items-center gap-1.5 shadow-2xs">
                                    <i class="fas fa-certificate text-emerald-500 text-[10px]"></i>
                                    <span>Verified Chronological Progression</span>
                                </span>
                            </div>

                            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                <% if (growthDeltaBoard.length === 0) { %>
                                    <div class="col-span-full p-8 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                        <div class="w-12 h-12 rounded-2xl bg-white flex items-center justify-center mx-auto mb-3 text-slate-400 border border-slate-100 shadow-2xs">
                                            <i class="fas fa-arrow-trend-up text-lg text-emerald-500"></i>
                                        </div>
                                        <p class="font-bold text-slate-700 text-xs mb-1">No Multi-Attempt Velocity Trajectories Found</p>
                                        <p class="text-[11px] text-slate-400 max-w-md mx-auto leading-relaxed">
                                            Students must complete multiple sessions or both Pre and Post tests under this <%= assessmentMode === 'dual' ? 'Dual (1v1 Versus)' : 'Solo' %> filter for the system to detect positive growth velocity.
                                        </p>
                                    </div>
                                <% } %>
                                <% growthDeltaBoard.forEach((item, idx) => { %>
                                    <div class="relative p-4 rounded-2xl border <%= item.isMe ? 'border-indigo-300 ring-2 ring-indigo-400 bg-gradient-to-r from-indigo-50/70 via-emerald-50/40 to-white shadow-sm' : 'border-emerald-100 bg-gradient-to-r from-emerald-50/50 to-white hover:border-emerald-200 transition shadow-2xs' %> flex items-center justify-between gap-3">
                                        <div class="flex items-center gap-3.5">
                                            <span class="w-7 h-7 rounded-full <%= idx === 0 ? 'bg-amber-500 text-slate-950 font-black' : (idx === 1 ? 'bg-slate-400 text-white font-bold' : (idx === 2 ? 'bg-amber-700 text-white font-bold' : 'bg-emerald-600 text-white font-black')) %> text-xs flex items-center justify-center shrink-0 shadow-xs">
                                                #<%= idx + 1 %>
                                            </span>
                                            <div class="relative shrink-0">
                                                <img src="<%= item.displayAvatar || (item.profile_pic ? '/profile_uploads/' + item.profile_pic : '/profile_uploads/default_avatar.png') %>" 
                                                     class="w-11 h-11 rounded-xl object-cover ring-2 <%= item.is_ghost_mode ? 'ring-amber-400/60' : (item.isMe ? 'ring-indigo-400' : 'ring-emerald-200') %>">
                                                <% if (item.isMe) { %>
                                                    <span class="absolute -bottom-1 -right-1 px-1 py-0.2 <%= item.is_ghost_mode ? 'bg-amber-500 text-slate-950' : 'bg-indigo-600 text-white' %> rounded text-[7px] font-black">
                                                        <%= item.is_ghost_mode ? 'GHOST' : 'YOU' %>
                                                    </span>
                                                <% } %>
                                            </div>
                                            <div>
                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                    <p class="font-bold text-xs text-slate-800"><%= item.gamertag %></p>
                                                    <% if (item.is_ghost_mode) { %>
                                                        <span class="text-[9px] font-black text-amber-800 bg-amber-100 border border-amber-300 px-1.5 py-0.2 rounded flex items-center gap-0.5">
                                                            <i class="fas fa-ghost text-[8px]"></i> Ghost
                                                        </span>
                                                    <% } %>
                                                    <% if (item.isMe) { %>
                                                        <span class="text-[9px] font-black <%= item.is_ghost_mode ? 'text-amber-800 bg-amber-200/80 border border-amber-300' : 'text-indigo-700 bg-indigo-100 border border-indigo-200' %> px-1.5 py-0.2 rounded">
                                                            <%= item.is_ghost_mode ? '(You - Anonymous)' : '(You)' %>
                                                        </span>
                                                    <% } %>
                                                    
                                                    <!-- Improvement Type Badge -->
                                                    <% if (item.improvement_type === 'Pre-to-Post Gain') { %>
                                                        <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-emerald-100 text-emerald-800 border border-emerald-300">
                                                            <i class="fas fa-graduation-cap text-[8px]"></i> Pre &rarr; Post Gain
                                                        </span>
                                                    <% } else if (item.improvement_type === '1v1 Battle Mastery') { %>
                                                        <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-purple-100 text-purple-800 border border-purple-300">
                                                            <i class="fas fa-trophy text-[8px]"></i> Battle Velocity
                                                        </span>
                                                    <% } else { %>
                                                        <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-cyan-100 text-cyan-800 border border-cyan-300">
                                                            <i class="fas fa-bolt text-[8px]"></i> Session Velocity
                                                        </span>
                                                    <% } %>

                                                    <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[9px] font-black uppercase bg-indigo-50 text-indigo-700 border border-indigo-200">
                                                        Lvl <%= item.highest_level_reached %>
                                                    </span>
                                                </div>

                                                <!-- Score Progression & Timing -->
                                                <div class="flex items-center gap-2 mt-1 flex-wrap text-[10px]">
                                                    <% if (assessmentMode !== 'dual') { %>
                                                        <span class="px-1.5 py-0.2 rounded bg-slate-100 text-slate-600 font-bold flex items-center gap-1">
                                                            <span>Baseline: <%= item.initial_score %> PTS</span>
                                                            <i class="fas fa-arrow-right text-[8px] text-slate-400"></i>
                                                            <span class="text-emerald-700 font-black"><%= item.current_score %> PTS</span>
                                                        </span>
                                                        <span class="font-black text-emerald-600">(+<%= item.delta_pct %>%)</span>
                                                    <% } %>
                                                    <span class="text-slate-400">
                                                        <i class="far fa-clock text-[8px]"></i> <%= item.formatted_duration %> &middot; <%= item.formatted_started_at %>
                                                    </span>
                                                    <span class="text-slate-400">&middot; <%= item.attempts_count %> Attempt<%= item.attempts_count > 1 ? 's' : '' %></span>
                                                </div>
                                            </div>
                                        </div>
                                        <div class="text-right shrink-0">
                                            <% if (assessmentMode === 'dual') { %>
                                                <p class="text-base font-black text-purple-600 flex items-center justify-end gap-1">
                                                    <i class="fas fa-trophy text-amber-500 mr-0.5"></i>
                                                    <span><%= item.wins %> Wins</span>
                                                </p>
                                                <p class="text-[10px] text-slate-400 font-bold"><%= item.win_rate %>% Win Rate</p>
                                            <% } else { %>
                                                <p class="text-base font-black text-emerald-600">+<%= item.growth_delta %> PTS</p>
                                                <p class="text-[10px] text-slate-400 font-bold"><%= item.improvement_type %></p>
                                            <% } %>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                    <!-- ================= DUAL MODE: 1v1 COMPETITIVE MATCH HISTORY AUDIT LOG ================= -->
                    <% if (assessmentMode === 'dual') { %>
                        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6">
                            <div class="flex items-center justify-between mb-4">
                                <div>
                                    <h4 class="font-black text-slate-800 text-sm flex items-center gap-2">
                                        <i class="fas fa-history text-indigo-500"></i>
                                        <span>Recent 1v1 Competitive Match History</span>
                                    </h4>
                                    <p class="text-xs text-slate-400">Audit log of dual matches. Click any row to inspect post-assessment diagnostic & concept heatmap.</p>
                                </div>
                                <span class="text-xs text-indigo-600 font-bold">Latest 10 Sessions</span>
                            </div>

                            <div class="space-y-2.5">
                                <% if (matchHistory.length === 0) { %>
                                    <p class="text-sm text-slate-400 text-center py-6 bg-slate-50 rounded-2xl">No recent duel matches logged. Challenge a classmate in the arcade kiosk!</p>
                                <% } %>
                                <% matchHistory.forEach(m => { %>
                                    <div onclick="openSessionDiagnostic(<%= m.session_id %>)" class="flex flex-col sm:flex-row sm:items-center justify-between p-3.5 rounded-2xl border border-slate-100 bg-slate-50 hover:bg-white hover:shadow-sm cursor-pointer transition gap-3">
                                        <div class="flex items-center gap-3">
                                            <span class="px-2.5 py-1 rounded-xl text-[10px] font-black uppercase <%= m.outcome === 'VICTORY' ? 'bg-emerald-100 text-emerald-700' : (m.outcome === 'FAILED' ? 'bg-rose-100 text-rose-800 border border-rose-200' : (m.outcome === 'TIE' ? 'bg-slate-200 text-slate-700' : 'bg-rose-100 text-rose-700')) %>">
                                                <%= m.outcome %>
                                            </span>
                                            <div>
                                                <p class="font-bold text-xs text-slate-800">vs <%= m.opponentGamertag %></p>
                                                <p class="text-[10px] text-slate-400">
                                                    <%= m.topic_name %> &middot; <%= m.formatted_started_at %>
                                                    <span class="ml-1 px-1.5 py-0.2 rounded bg-indigo-50 text-indigo-600 font-bold">Lvl <%= m.highest_level_reached %></span>
                                                </p>
                                            </div>
                                        </div>
                                        <div class="flex items-center gap-4">
                                            <div class="text-right">
                                                <p class="font-black text-xs text-slate-700"><%= m.final_score_p1 %> - <%= m.final_score_p2 %></p>
                                                <p class="text-[10px] text-slate-400"><%= m.formatted_duration %> wall clock</p>
                                            </div>
                                            <button class="px-3 py-1 rounded-xl text-[11px] font-bold bg-indigo-50 text-indigo-600 hover:bg-indigo-100 transition">
                                                <i class="fas fa-chart-pie mr-1"></i> Analytics
                                            </button>
                                        </div>
                                    </div>
                                <% }) %>
                            </div>
                        </div>
                    <% } %>

                </div>

                <!-- ================= 4. PERIODIC TABLE MASTERY HEATMAP ================= -->
                <div id="mastery" class="tab-content hidden space-y-6">
                    <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6">
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                            <div>
                                <h3 class="font-black text-slate-800 text-base">Periodic Table Chemical Mastery Heatmap</h3>
                                <p class="text-xs text-slate-400">
                                    <%= isCumulativeScope 
                                        ? 'Micro-telemetry from terminal keypads mapping memory precision across active coursework assessments.' 
                                        : 'Micro-telemetry from terminal keypads mapping memory precision for this selected assessment.' %>
                                </p>
                            </div>
                            <div class="flex items-center gap-3 text-[10px] font-bold text-slate-400">
                                <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-emerald-400 inline-block"></span> Strong (&ge;80%)</span>
                                <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-amber-400 inline-block"></span> Shaky (50-79%)</span>
                                <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-rose-400 inline-block"></span> Weak (&lt;50%)</span>
                                <span class="flex items-center gap-1"><span class="w-3 h-3 rounded bg-slate-200 inline-block"></span> Untried</span>
                            </div>
                        </div>
                        <div class="grid overflow-x-auto no-scrollbar p-2" style="grid-template-columns: repeat(18, minmax(30px, 1fr)); gap: 4px;">
                            <% periodicGrid.forEach(el => {
                                let colorClass = 'bg-slate-100 text-slate-400';
                                if (el.total_answered > 0) {
                                    if (el.accuracy_pct >= 80) colorClass = 'bg-emerald-400 text-white';
                                    else if (el.accuracy_pct >= 50) colorClass = 'bg-amber-400 text-white';
                                    else colorClass = 'bg-rose-400 text-white';
                                }
                            %>
                            <div class="<%= colorClass %> rounded-lg aspect-square flex flex-col items-center justify-center text-[10px] font-black cursor-default transition hover:scale-110 shadow-2xs"
                                 style="grid-column: <%= el.group_col %>; grid-row: <%= el.period_row %>;"
                                 title="<%= el.element_name %> — <%= el.total_answered %> attempts<%= el.total_answered > 0 ? ', ' + Number(el.accuracy_pct).toFixed(0) + '% accuracy' : '' %>">
                                <%= el.element_symbol %>
                            </div>
                            <% }) %>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <!-- Card 1: Elements Targeted for Study Focus -->
                        <div class="bg-white rounded-3xl border border-rose-100 shadow-sm p-6 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="w-6 h-6 rounded-lg bg-rose-50 border border-rose-200 text-rose-500 flex items-center justify-center text-xs">
                                        <i class="fas fa-bullseye"></i>
                                    </span>
                                    <h3 class="font-black text-slate-800 text-sm">Study Focus Areas</h3>
                                </div>
                                <p class="text-[11px] text-slate-400 mb-4">Chemical elements with frequent incorrect entries or timeouts requiring review.</p>
                                
                                <% if (!strugglingElements || strugglingElements.length === 0) { %>
                                    <div class="py-6 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                        <i class="fas fa-check-circle text-emerald-500 text-lg mb-1"></i>
                                        <p class="text-xs font-bold text-slate-700">Zero Struggling Elements</p>
                                        <p class="text-[10px] text-slate-400">All element entries are within mastery tolerance!</p>
                                    </div>
                                <% } else { %>
                                    <div class="space-y-2">
                                        <% strugglingElements.forEach(el => { %>
                                            <div class="flex items-center justify-between p-2.5 rounded-xl bg-rose-50/50 border border-rose-100">
                                                <div class="flex items-center gap-2.5">
                                                    <span class="w-8 h-8 rounded-lg bg-rose-500 text-white font-black text-xs flex items-center justify-center shrink-0">
                                                        <%= el.element_symbol %>
                                                    </span>
                                                    <div>
                                                        <p class="font-bold text-slate-800 text-xs"><%= el.element_name || el.element_symbol %></p>
                                                        <p class="text-[10px] text-slate-500"><%= el.wrong_count %> misfire<%= el.wrong_count > 1 ? 's' : '' %> of <%= el.total_answered %> entries</p>
                                                    </div>
                                                </div>
                                                <span class="font-black text-rose-600 text-xs bg-rose-100/80 px-2 py-0.5 rounded-md border border-rose-200">
                                                    <%= Number(el.miss_rate).toFixed(0) %>% Error
                                                </span>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Card 2: Elements with High Familiarity & Mastery -->
                        <div class="bg-white rounded-3xl border border-emerald-100 shadow-sm p-6 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="w-6 h-6 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-600 flex items-center justify-center text-xs">
                                        <i class="fas fa-certificate"></i>
                                    </span>
                                    <h3 class="font-black text-slate-800 text-sm">Familiarity & Mastery</h3>
                                </div>
                                <p class="text-[11px] text-slate-400 mb-4">Chemical elements consistently identified correctly (&ge;80% precision).</p>
                                
                                <% const masteredList = (typeof masteredElements !== 'undefined' && masteredElements) ? masteredElements : []; %>
                                <% if (masteredList.length === 0) { %>
                                    <div class="py-6 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                        <i class="fas fa-flask text-slate-400 text-lg mb-1"></i>
                                        <p class="text-xs font-bold text-slate-700">Awaiting Mastery Records</p>
                                        <p class="text-[10px] text-slate-400">Complete more chemical questions to establish mastery!</p>
                                    </div>
                                <% } else { %>
                                    <div class="space-y-2">
                                        <% masteredList.forEach(el => { %>
                                            <div class="flex items-center justify-between p-2.5 rounded-xl bg-emerald-50/50 border border-emerald-100">
                                                <div class="flex items-center gap-2.5">
                                                    <span class="w-8 h-8 rounded-lg bg-emerald-600 text-white font-black text-xs flex items-center justify-center shrink-0">
                                                        <%= el.element_symbol %>
                                                    </span>
                                                    <div>
                                                        <p class="font-bold text-slate-800 text-xs"><%= el.element_name || el.element_symbol %></p>
                                                        <p class="text-[10px] text-slate-500"><%= el.correct_count %> correct of <%= el.total_answered %> entries</p>
                                                    </div>
                                                </div>
                                                <span class="font-black text-emerald-700 text-xs bg-emerald-100 px-2 py-0.5 rounded-md border border-emerald-200">
                                                    <%= Number(el.accuracy_pct).toFixed(0) %>% Precision
                                                </span>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% } %>
                            </div>
                        </div>

                        <!-- Card 3: Click Origin Breakdown -->
                        <div class="bg-white rounded-3xl border border-slate-100 shadow-sm p-6 flex flex-col justify-between">
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="w-6 h-6 rounded-lg bg-indigo-50 border border-indigo-200 text-indigo-600 flex items-center justify-center text-xs">
                                        <i class="fas fa-keyboard"></i>
                                    </span>
                                    <h3 class="font-black text-slate-800 text-sm">Terminal Input Origin</h3>
                                </div>
                                <p class="text-[11px] text-slate-400 mb-4">Breakdown of terminal physical keypad vs on-screen palette inputs.</p>
                                
                                <% if (clickSourceBreakdown.length === 0) { %>
                                    <div class="py-6 text-center bg-slate-50 rounded-2xl border border-dashed border-slate-200">
                                        <i class="fas fa-terminal text-slate-400 text-lg mb-1"></i>
                                        <p class="text-xs font-bold text-slate-700">No Terminal Inputs Logged</p>
                                        <p class="text-[10px] text-slate-400">Play in the kiosk to record input origins.</p>
                                    </div>
                                <% } else {
                                    const totalClicks = clickSourceBreakdown.reduce((sum, c) => sum + Number(c.count), 0);
                                %>
                                <div class="space-y-3 pt-2">
                                    <% clickSourceBreakdown.forEach(c => {
                                        const pct = totalClicks > 0 ? (c.count / totalClicks) * 100 : 0;
                                    %>
                                    <div>
                                        <div class="flex justify-between text-xs font-bold text-slate-600 mb-1">
                                            <span><%= c.click_source %></span>
