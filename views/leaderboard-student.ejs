                                                                <% if (row.isMe) { %><span class="text-[9px] font-black <%= row.is_ghost_mode ? 'text-amber-800 bg-amber-200/80' : 'text-indigo-600 bg-indigo-100' %> px-1.5 py-0.2 rounded"><%= row.is_ghost_mode ? '(You - Anonymous)' : '(You)' %></span><% } %>
