                        'Chemical Mixing Station': 'fa-flask-vial text-emerald-500',
                        'Isotope Modifier': 'fa-atom text-purple-500',
                        'Atom Builder': 'fa-cubes text-amber-500',
                        PeriodicTableTerminal: 'fa-table-cells text-indigo-500',
                        UnitConversionConsole: 'fa-right-left text-cyan-500',
                        AtomicStructureAnalyzer: 'fa-atom text-purple-500',
                        ElectronConfigWorkstation: 'fa-bolt text-yellow-500'
                    };
                    %>
