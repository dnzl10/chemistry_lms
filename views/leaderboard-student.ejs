                                               class="px-3.5 py-1.5 rounded-xl text-xs font-bold bg-indigo-600 text-white hover:bg-indigo-700 shadow-sm transition whitespace-nowrap">
                                                <i class="fas fa-list-ol mr-1"></i> View All <%= leaderboardRows.length %> Standings
                                            </a>
                                        </div>
                                    <% } %>

                                </div>
                            <% } %>
                        </div>

