                                                <span>👑</span>
                                                <span>Outstanding Mastery! You are currently in 1st Place on the podium for this assessment scope.</span>
                                            <% } else { %>
                                                <span>🌟</span>
                                                <span>Podium Contender! You currently hold Rank #<%= threeRankWindow.myEntry.rank %>. Target to 1st Place: +<%= threeRankWindow.pointsToPodium %> <%= assessmentMode === 'dual' ? 'win' + (threeRankWindow.pointsToPodium > 1 ? 's' : '') : 'pts' %> to take the crown!</span>
                                            <% } %>
                                        </div>
                                    <% } else if (!threeRankWindow.myEntry && leaderboardRows.length > 0) { %>
                                        <!-- Case 3: Viewing student hasn't taken this assessment yet -->
                                        <div class="mt-4 p-4 rounded-2xl bg-indigo-50/70 border border-indigo-200 flex flex-col sm:flex-row items-center justify-between gap-3 text-center sm:text-left">
                                            <div class="flex items-center gap-3">
                                                <div class="w-10 h-10 rounded-xl bg-indigo-100 text-indigo-600 flex items-center justify-center font-bold text-lg">
                                                    <i class="fas fa-gamepad"></i>
                                                </div>
                                                <div>
                                                    <p class="font-bold text-indigo-950 text-xs">You Haven't Taken This Assessment Yet</p>
