                                                        <div>
                                                            <p class="font-bold text-slate-800 text-xs flex items-center gap-1.5 flex-wrap">
                                                                <span><%= row.gamertag %></span>
                                                                <% if (row.is_ghost_mode) { %>
                                                                    <span class="text-[9px] font-black text-amber-800 bg-amber-100 border border-amber-300 px-1.5 py-0.2 rounded flex items-center gap-0.5">
                                                                        <i class="fas fa-ghost text-[8px]"></i> Ghost
