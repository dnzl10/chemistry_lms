                                                                    <i class="fas fa-clipboard-check text-[8px]"></i> <%= performer.assessments_completed %> <%= performer.assessments_completed === 1 ? 'Assessment' : 'Assessments' %>
                                                                </span>
                                                            <% } %>
                                                        </div>

                                                        <!-- Timing Telemetry & Section -->
                                                        <div class="text-[10px] text-slate-400 mt-1 flex items-center gap-2 flex-wrap">
