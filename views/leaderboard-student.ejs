                                        </div>
                                        <div class="w-full bg-slate-100 rounded-full h-2">
                                            <div class="bg-emerald-500 h-2 rounded-full" style="width: <%= m.accuracy_pct %>%"></div>
                                        </div>
                                    </div>
                                    <div>
                                        <div class="flex justify-between text-xs font-bold text-slate-600 mb-1">
                                            <span>Timeout Rate</span>
                                            <span class="text-rose-500 font-black"><%= Number(m.timeout_rate_pct).toFixed(0) %>%</span>
                                        </div>
                                        <div class="w-full bg-slate-100 rounded-full h-2">
                                            <div class="bg-rose-500 h-2 rounded-full" style="width: <%= m.timeout_rate_pct %>%"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="pt-4 mt-4 border-t border-slate-100 space-y-1.5 text-xs">
                                <div class="flex justify-between">
                                    <span class="text-slate-400 font-bold">Avg Response Latency</span>
                                    <span class="font-black text-slate-700"><%= m.avg_response_time_s ? Number(m.avg_response_time_s).toFixed(1) + 's' : 'N/A' %></span>
                                </div>
                                <div class="flex justify-between">
                                    <span class="text-slate-400 font-bold">Total Attempts</span>
                                    <span class="font-black text-slate-800"><%= m.total_attempts %></span>
                                </div>
                            </div>
                        </div>
                    <% }) %>
                </div>

            </div> <!-- end main container -->

            <!-- Notification Drawer -->
            <div id="notification-overlay" onclick="toggleNotifications()" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[60] hidden transition-opacity duration-300 opacity-0"></div>
            <div id="notification-panel" class="fixed top-0 right-0 h-screen w-80 md:w-96 bg-white shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-200 flex flex-col">
                <div class="p-5 border-b flex justify-between items-center bg-blue-600 text-white flex-shrink-0">
                    <div>
                        <h2 class="text-lg font-bold flex items-center gap-2">
                            <i class="far fa-bell"></i> Notifications
                        </h2>
                        <p id="notifSubtitle" class="text-[11px] text-blue-200 font-medium">Activity updates</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="NotificationHub.markAllRead('notification-list')" title="Mark all as read" class="hover:bg-blue-700 text-blue-100 hover:text-white p-2 rounded-lg transition text-xs font-bold flex items-center gap-1">
                            <i class="fas fa-check-double text-sm"></i>
                        </button>
