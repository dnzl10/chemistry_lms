        // Toggle Off-Canvas / Collapsible Detail Panel
        function toggleConversationInfo(force) {
            const panel = document.getElementById('chatInfoPanel');
            const backdrop = document.getElementById('infoPanelBackdrop');
            const btn = document.getElementById('convoInfoBtn');
            if (!panel) return;

            if (typeof force === 'boolean') {
                isInfoPanelOpen = force;
            } else {
                isInfoPanelOpen = !isInfoPanelOpen;
            }

            if (isInfoPanelOpen) {
                panel.classList.remove('hidden');
                panel.classList.add('flex');
                if (backdrop) backdrop.classList.remove('hidden');
                if (btn) btn.classList.add('text-cyan-600', 'bg-cyan-50', 'ring-2', 'ring-cyan-500/20');
                updateConversationInfoPanel();
            } else {
                panel.classList.add('hidden');
                panel.classList.remove('flex');
                if (backdrop) backdrop.classList.add('hidden');
                if (btn) btn.classList.remove('text-cyan-600', 'bg-cyan-50', 'ring-2', 'ring-cyan-500/20');
            }
        }

        // 1. Participant Presence Calculator
        function getPresenceInfo(partner, messages) {
            if (!partner) {
                return { isOnline: false, text: 'Offline', dotClass: 'bg-slate-300', badgeClass: 'bg-slate-100 text-slate-600 border-slate-200' };
            }

            // Determine latest activity from partner's messages or convo timestamp
            let latestTs = null;
            if (Array.isArray(messages) && messages.length > 0) {
                for (let i = messages.length - 1; i >= 0; i--) {
                    if (messages[i].sender_id === partner.user_id && messages[i].sent_at) {
                        latestTs = messages[i].sent_at;
                        break;
                    }
                }
            }
            if (!latestTs && partner.sent_at) {
                latestTs = partner.sent_at;
            }

            if (!latestTs) {
                return { isOnline: false, text: 'Offline', dotClass: 'bg-slate-300', badgeClass: 'bg-slate-100 text-slate-600 border-slate-200' };
            }

            const d = new Date(latestTs);
            const now = new Date();
            const diffMin = Math.floor((now - d) / 60000);

            if (diffMin < 5) {
                return {
                    isOnline: true,
                    text: 'Active now',
                    dotClass: 'bg-emerald-500 ring-2 ring-emerald-300 animate-pulse',
                    badgeClass: 'bg-emerald-50 text-emerald-700 border-emerald-200'
                };
            } else if (diffMin < 60) {
                return {
                    isOnline: false,
                    text: `Active ${diffMin}m ago`,
                    dotClass: 'bg-emerald-400',
                    badgeClass: 'bg-cyan-50 text-cyan-800 border-cyan-200'
                };
            } else if (diffMin < 1440) {
                const diffHrs = Math.floor(diffMin / 60);
                return {
                    isOnline: false,
                    text: `Active ${diffHrs}h ago`,
                    dotClass: 'bg-slate-400',
                    badgeClass: 'bg-slate-100 text-slate-700 border-slate-200'
                };
            } else {
                const diffDays = Math.floor(diffMin / 1440);
                return {
                    isOnline: false,
                    text: diffDays === 1 ? 'Active yesterday' : `Active ${diffDays}d ago`,
                    dotClass: 'bg-slate-300',
                    badgeClass: 'bg-slate-100 text-slate-600 border-slate-200'
                };
            }
        }

        // Master update routine for Conversation Info Panel
        function updateConversationInfoPanel() {
            if (!currentPartner) return;

            // Chat Info: Participant Profile
            const partnerName = `${currentPartner.first_name || ''} ${currentPartner.last_name || ''}`.trim() || currentPartner.other_name || 'Participant';
            const nameEl = document.getElementById('infoPanelName');
            if (nameEl) nameEl.textContent = partnerName;

            const avatarEl = document.getElementById('infoPanelAvatar');
            if (avatarEl) {
                avatarEl.src = currentPartner.profile_pic ? '/profile_uploads/' + currentPartner.profile_pic : '/profile_uploads/default_avatar.png';
            }

            const isAdviser = (currentPartner.contact_type === 'adviser' || currentPartner.role === 'teacher');
            const roleBadgeEl = document.getElementById('infoPanelRoleBadge');
            if (roleBadgeEl) {
                roleBadgeEl.textContent = isAdviser ? 'Instructor / Course Adviser' : 'Student';
                roleBadgeEl.className = isAdviser
                    ? 'text-[10px] font-black uppercase px-2.5 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200'
                    : 'text-[10px] font-black uppercase px-2.5 py-0.5 rounded-md bg-cyan-50 text-cyan-700 border border-cyan-200';
            }

            // Real-time presence badge & dots
            const presence = getPresenceInfo(currentPartner, currentMessages);
            const statusDot = document.getElementById('infoPanelStatusDot');
            if (statusDot) {
                statusDot.className = `absolute -bottom-1 -right-1 w-4 h-4 rounded-full border-2 border-white shadow-xs ${presence.dotClass}`;
            }
            const headerDot = document.getElementById('partnerOnlineStatus');
            if (headerDot) {
                headerDot.className = `absolute -bottom-0.5 -right-0.5 w-3 h-3 rounded-full border-2 border-white ${presence.isOnline ? 'bg-emerald-500 animate-pulse' : 'bg-slate-300'}`;
            }
            const presenceBadge = document.getElementById('infoPanelPresenceBadge');
            const presenceText = document.getElementById('infoPanelPresenceText');
            if (presenceBadge && presenceText) {
                presenceText.textContent = presence.text;
                presenceBadge.className = `inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold border ${presence.badgeClass}`;
            }

            // Enrolled Section / Cohort
            const cohortEl = document.getElementById('infoPanelCohort');
            if (cohortEl) {
                let cohort = currentPartner.section || currentPartner.other_section || '';
                if (currentPartner.grade_level) {
                    cohort = (cohort ? `${currentPartner.grade_level} - ${cohort}` : currentPartner.grade_level);
                }
                if (!cohort && isAdviser) {
                    cohort = currentPartner.department || currentPartner.other_department || 'Faculty / Academic Adviser';
                }
                if (!cohort && currentPartner.shared_classes) {
                    cohort = currentPartner.shared_classes;
                }
                cohortEl.textContent = cohort || 'Standard Academic Cohort';
            }

            const sharedClassesEl = document.getElementById('infoPanelSharedClasses');
            if (sharedClassesEl) {
                sharedClassesEl.textContent = currentPartner.shared_classes || currentPartner.shared_subjects || 'Enrolled Course Subject';
            }

            // Refresh search in active chat if query exists
            if (inChatSearchQuery.trim()) {
                handleInChatSearch(inChatSearchQuery);
            }

            // Render Pinned Messages
            renderPinnedMessages();

            // Render Shared Repository
            renderSharedContent();

            // Sync Read Receipts Toggle UI
            syncReadReceiptsSettingUI();
        }

        // 2. Conversation Search
        function handleInChatSearch(query) {
            inChatSearchQuery = query || '';
            const clearBtn = document.getElementById('clearInChatSearchBtn');
            const countBox = document.getElementById('inChatResultsCount');
            const countText = document.getElementById('inChatResultsText');
            const resultsContainer = document.getElementById('inChatSearchResults');

            if (!resultsContainer) return;

            if (clearBtn) {
                if (inChatSearchQuery.trim().length > 0) {
                    clearBtn.classList.remove('hidden');
                } else {
                    clearBtn.classList.add('hidden');
                }
            }

            if (!inChatSearchQuery.trim()) {
                if (countBox) countBox.classList.add('hidden');
                resultsContainer.innerHTML = '';
                return;
            }

            const q = inChatSearchQuery.toLowerCase();
            const matches = currentMessages.filter(m => (m.message_text || '').toLowerCase().includes(q));

            if (countBox && countText) {
                countBox.classList.remove('hidden');
                countText.textContent = `${matches.length} message${matches.length === 1 ? '' : 's'} found`;
            }

            if (matches.length === 0) {
                resultsContainer.innerHTML = `
                    <div class="p-3 text-center text-slate-400 text-xs">
                        <p class="font-medium">No matching messages</p>
                        <p class="text-[10px] mt-0.5">Try searching with different keywords</p>
                    </div>
                `;
                return;
            }

            let html = '';
            matches.slice(-15).reverse().forEach(m => {
                const isMine = (m.sender_id === CURRENT_USER_ID);
                const senderName = isMine ? 'You' : (currentPartner?.first_name || 'Partner');
                const timeStr = formatTimestamp(m.sent_at);
                const cleanText = formatMessagePreview(m.message_text);
                
                const regex = new RegExp(`(${escapeRegExp(inChatSearchQuery)})`, 'gi');
                const highlighted = escapeHtml(cleanText).replace(regex, '<mark class="bg-amber-200 text-amber-900 rounded-xs px-0.5 font-bold">$1</mark>');

                html += `
                    <div onclick="jumpToMessage(${m.message_id})" class="p-2.5 rounded-xl bg-slate-50 hover:bg-cyan-50 border border-slate-200/70 hover:border-cyan-200 transition cursor-pointer text-left group">
                        <div class="flex items-center justify-between text-[10px] text-slate-400 font-bold mb-1">
                            <span class="${isMine ? 'text-cyan-700 font-black' : 'text-slate-700'}">${senderName}</span>
                            <span>${timeStr}</span>
                        </div>
                        <p class="text-xs text-slate-700 leading-snug line-clamp-2">${highlighted}</p>
                    </div>
                `;
            });
            resultsContainer.innerHTML = html;
        }

        function clearInChatSearch() {
            const input = document.getElementById('inChatSearchInput');
            if (input) input.value = '';
            handleInChatSearch('');
        }

        function escapeRegExp(string) {
            return string.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        }

        function jumpToMessage(messageId) {
            const el = document.getElementById(`msg-${messageId}`);
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                el.classList.add('ring-2', 'ring-amber-400', 'bg-amber-50/70', 'rounded-2xl', 'p-1');
                setTimeout(() => {
                    el.classList.remove('ring-2', 'ring-amber-400', 'bg-amber-50/70', 'p-1');
                }, 2200);

                if (window.innerWidth < 768) {
                    toggleConversationInfo(false);
                }
            } else {
                console.warn('[JUMP] Message element not rendered in stream:', messageId);
            }
        }

        // 3. Pinned Messages Storage & Management
        function getPinnedStorageKey() {
            return `elementa_pinned_${CURRENT_USER_ID}_${currentPartnerId || 0}`;
        }

        function getPinnedMessageIds() {
            if (!currentPartnerId) return [];
            try {
                const stored = localStorage.getItem(getPinnedStorageKey());
                return stored ? JSON.parse(stored) : [];
            } catch (e) {
                return [];
            }
        }

        function savePinnedMessageIds(ids) {
            if (!currentPartnerId) return;
            try {
                localStorage.setItem(getPinnedStorageKey(), JSON.stringify(ids));
            } catch (e) {
                console.error('[PINNED STORAGE ERROR]', e);
            }
        }

        function isMessagePinned(messageId) {
            const ids = getPinnedMessageIds();
            return ids.includes(Number(messageId));
        }

        function togglePinMessage(messageId) {
            const mId = Number(messageId);
            let ids = getPinnedMessageIds();
            if (ids.includes(mId)) {
                ids = ids.filter(id => id !== mId);
            } else {
                ids.push(mId);
            }
            savePinnedMessageIds(ids);
            renderPinnedMessages();
            renderMessages(currentMessages, false);
        }

        function unpinMessage(messageId) {
            const mId = Number(messageId);
            let ids = getPinnedMessageIds();
            ids = ids.filter(id => id !== mId);
            savePinnedMessageIds(ids);
            renderPinnedMessages();
            renderMessages(currentMessages, false);
        }

        function renderPinnedMessages() {
            const container = document.getElementById('pinnedMessagesContainer');
            const badge = document.getElementById('pinnedCountBadge');
            if (!container) return;

            const pinnedIds = getPinnedMessageIds();
            const pinnedMsgs = currentMessages.filter(m => pinnedIds.includes(Number(m.message_id)));

            if (badge) badge.textContent = pinnedMsgs.length;

            if (pinnedMsgs.length === 0) {
                container.innerHTML = `
                    <div class="p-4 rounded-xl bg-slate-50/80 border border-dashed border-slate-200 text-center text-slate-400 text-xs">
                        <i class="fas fa-thumbtack text-slate-300 text-base mb-1"></i>
                        <p class="font-medium">No pinned messages</p>
                        <p class="text-[10px] text-slate-400 mt-0.5">Hover on any message bubble and click the pin icon to curate messages here.</p>
                    </div>
                `;
                return;
            }

            let html = '';
            pinnedMsgs.forEach(m => {
                const isMine = (m.sender_id === CURRENT_USER_ID);
                const senderName = isMine ? 'You' : (currentPartner?.first_name || 'Partner');
                const timeStr = formatTimestamp(m.sent_at);
                const preview = formatMessagePreview(m.message_text);

                html += `
                    <div class="p-2.5 rounded-xl bg-amber-50/60 border border-amber-200/70 text-left text-xs transition group">
                        <div class="flex items-center justify-between text-[10px] text-amber-800 font-bold mb-1">
                            <span class="flex items-center gap-1">
                                <i class="fas fa-thumbtack text-[9px] text-amber-500"></i>
                                <span>${senderName}</span>
                            </span>
                            <div class="flex items-center gap-1.5">
                                <span>${timeStr}</span>
                                <button type="button" onclick="unpinMessage(${m.message_id})" title="Unpin message" class="p-1 text-slate-400 hover:text-rose-600 transition cursor-pointer">
                                    <i class="fas fa-times text-[10px]"></i>
                                </button>
                            </div>
                        </div>
                        <p class="text-slate-800 leading-snug line-clamp-2">${escapeHtml(preview)}</p>
                        <div class="mt-2 flex items-center justify-end">
                            <button type="button" onclick="jumpToMessage(${m.message_id})" class="text-[10px] font-bold text-amber-700 hover:text-amber-900 underline flex items-center gap-1 cursor-pointer">
                                <span>Jump to message</span>
                                <i class="fas fa-arrow-right text-[8px]"></i>
                            </button>
                        </div>
                    </div>
                `;
            });
            container.innerHTML = html;
        }

        // 4. Shared Repository (Media, Files, Links)
        function switchSharedContentTab(tab) {
            activeSharedTab = tab;
            const btnMedia = document.getElementById('sharedTabMediaBtn');
            const btnFiles = document.getElementById('sharedTabFilesBtn');
            const btnLinks = document.getElementById('sharedTabLinksBtn');

            const paneMedia = document.getElementById('sharedMediaPane');
            const paneFiles = document.getElementById('sharedFilesPane');
            const paneLinks = document.getElementById('sharedLinksPane');

            [btnMedia, btnFiles, btnLinks].forEach(b => {
                if (b) {
                    b.className = 'flex-1 py-1.5 text-center rounded-lg text-slate-500 hover:text-slate-700 transition cursor-pointer';
                }
            });
            [paneMedia, paneFiles, paneLinks].forEach(p => {
                if (p) p.classList.add('hidden');
            });

            if (tab === 'media') {
                if (btnMedia) btnMedia.className = 'flex-1 py-1.5 text-center rounded-lg bg-white shadow-2xs text-cyan-700 transition cursor-pointer';
                if (paneMedia) paneMedia.classList.remove('hidden');
            } else if (tab === 'files') {
                if (btnFiles) btnFiles.className = 'flex-1 py-1.5 text-center rounded-lg bg-white shadow-2xs text-cyan-700 transition cursor-pointer';
                if (paneFiles) paneFiles.classList.remove('hidden');
            } else if (tab === 'links') {
                if (btnLinks) btnLinks.className = 'flex-1 py-1.5 text-center rounded-lg bg-white shadow-2xs text-cyan-700 transition cursor-pointer';
                if (paneLinks) paneLinks.classList.remove('hidden');
            }
        }

        function renderSharedContent() {
            const mediaGrid = document.getElementById('sharedMediaGrid');
            const mediaEmpty = document.getElementById('sharedMediaEmpty');
            const mediaCountEl = document.getElementById('sharedMediaCount');

            const filesList = document.getElementById('sharedFilesList');
            const filesEmpty = document.getElementById('sharedFilesEmpty');
            const filesCountEl = document.getElementById('sharedFilesCount');

            const linksList = document.getElementById('sharedLinksList');
            const linksEmpty = document.getElementById('sharedLinksEmpty');
            const linksCountEl = document.getElementById('sharedLinksCount');

            const mediaItems = [];
            const fileItems = [];
            const linkItems = [];

            const urlRegex = /(https?:\/\/[^\s]+)/g;

            currentMessages.forEach(msg => {
                const text = msg.message_text || '';
                if (text.includes('||')) {
                    const parts = text.split('||');
                    const fileUrl = parts[0];
                    const fileName = parts[1] || 'Attachment';
                    const isImg = /\.(jpg|jpeg|png|gif|webp)$/i.test(fileName) || /\.(jpg|jpeg|png|gif|webp)$/i.test(fileUrl);
                    if (isImg) {
                        mediaItems.push({ url: fileUrl, name: fileName, sent_at: msg.sent_at, message_id: msg.message_id });
                    } else {
                        fileItems.push({ url: fileUrl, name: fileName, sent_at: msg.sent_at, message_id: msg.message_id });
                    }
                } else {
                    const matches = text.match(urlRegex);
                    if (matches) {
                        matches.forEach(u => {
                            linkItems.push({ url: u, sent_at: msg.sent_at, message_id: msg.message_id });
                        });
                    }
                }
            });

            if (mediaCountEl) mediaCountEl.textContent = mediaItems.length;
            if (filesCountEl) filesCountEl.textContent = fileItems.length;
            if (linksCountEl) linksCountEl.textContent = linkItems.length;

            // Render Media
            if (mediaGrid && mediaEmpty) {
                if (mediaItems.length === 0) {
                    mediaGrid.innerHTML = '';
                    mediaEmpty.classList.remove('hidden');
                } else {
                    mediaEmpty.classList.add('hidden');
                    let html = '';
                    mediaItems.slice(-12).reverse().forEach(item => {
                        html += `
                            <div class="relative group rounded-xl overflow-hidden aspect-square bg-slate-100 border border-slate-200 cursor-pointer" onclick="window.open('${escapeHtml(item.url)}', '_blank')">
                                <img src="${escapeHtml(item.url)}" alt="${escapeHtml(item.name)}" class="w-full h-full object-cover group-hover:scale-105 transition duration-300">
                                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition flex items-center justify-center text-white text-xs gap-1">
                                    <i class="fas fa-expand"></i>
                                </div>
                            </div>
                        `;
                    });
                    mediaGrid.innerHTML = html;
                }
            }

            // Render Files
            if (filesList && filesEmpty) {
                if (fileItems.length === 0) {
                    filesList.innerHTML = '';
                    filesEmpty.classList.remove('hidden');
                } else {
                    filesEmpty.classList.add('hidden');
                    let html = '';
                    fileItems.slice(-15).reverse().forEach(item => {
                        const iconHtml = getFileIcon(item.name);
                        const timeStr = formatTimestamp(item.sent_at);
                        html += `
                            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-2.5 hover:bg-slate-100 transition">
                                <div class="w-8 h-8 rounded-lg bg-white shadow-2xs flex items-center justify-center shrink-0">
                                    ${iconHtml}
                                </div>
                                <div class="min-w-0 flex-1">
                                    <p class="text-xs font-bold text-slate-800 truncate">${escapeHtml(item.name)}</p>
                                    <p class="text-[10px] text-slate-400 font-medium">${timeStr}</p>
                                </div>
                                <a href="${escapeHtml(item.url)}" download target="_blank" class="p-2 rounded-lg bg-white hover:bg-cyan-50 hover:text-cyan-600 text-slate-500 shadow-2xs border border-slate-200 transition cursor-pointer" title="Download">
                                    <i class="fas fa-download text-xs"></i>
                                </a>
                            </div>
                        `;
                    });
                    filesList.innerHTML = html;
                }
            }

            // Render Links
            if (linksList && linksEmpty) {
                if (linkItems.length === 0) {
                    linksList.innerHTML = '';
                    linksEmpty.classList.remove('hidden');
                } else {
                    linksEmpty.classList.add('hidden');
                    let html = '';
                    linkItems.slice(-15).reverse().forEach(item => {
                        const timeStr = formatTimestamp(item.sent_at);
                        let domain = item.url;
                        try {
                            domain = new URL(item.url).hostname;
                        } catch (e) {}

                        html += `
                            <div class="p-2.5 rounded-xl bg-slate-50 border border-slate-200 flex items-center gap-2.5 hover:bg-slate-100 transition">
                                <div class="w-8 h-8 rounded-lg bg-white shadow-2xs flex items-center justify-center shrink-0 text-cyan-600 text-xs">
                                    <i class="fas fa-link"></i>
                                </div>
                                <div class="min-w-0 flex-1">
                                    <a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="text-xs font-bold text-cyan-700 hover:text-cyan-800 hover:underline truncate block">
                                        ${escapeHtml(item.url)}
                                    </a>
                                    <p class="text-[10px] text-slate-400 font-medium flex items-center gap-1.5 mt-0.5">
                                        <span>${escapeHtml(domain)}</span>
                                        <span>•</span>
                                        <span>${timeStr}</span>
                                    </p>
                                </div>
                                <a href="${escapeHtml(item.url)}" target="_blank" rel="noopener noreferrer" class="p-2 rounded-lg bg-white hover:bg-cyan-50 hover:text-cyan-600 text-slate-500 shadow-2xs border border-slate-200 transition" title="Open Link">
                                    <i class="fas fa-arrow-up-right-from-square text-xs"></i>
                                </a>
                            </div>
                        `;
                    });
                    linksList.innerHTML = html;
                }
            }
        }

        // 5. Read Receipts Privacy Setting (Reciprocal Privacy)
        function isReadReceiptsEnabled() {
            return localStorage.getItem('elementa_read_receipts_enabled') !== 'false';
        }

        function toggleReadReceiptsPrivacy(enabled) {
            localStorage.setItem('elementa_read_receipts_enabled', enabled ? 'true' : 'false');
            syncReadReceiptsSettingUI();
            // Re-render messages to reflect privacy setting on checkmarks
            renderMessages(currentMessages, false);

            // If turned on and thread active, catch up read status
            if (enabled && currentPartnerId) {
                fetch('/api/student/messaging/read', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ partner_id: currentPartnerId })
                }).catch(() => {});
            }
        }

        function syncReadReceiptsSettingUI() {
            const toggle = document.getElementById('readReceiptsToggle');
            const statusText = document.getElementById('readReceiptsStatusText');
            const enabled = isReadReceiptsEnabled();

            if (toggle) toggle.checked = enabled;
            if (statusText) {
                if (enabled) {
                    statusText.className = 'font-bold text-cyan-600 flex items-center gap-1';
                    statusText.innerHTML = `<i class="fas fa-check-double text-[10px]"></i><span>Active & Visible</span>`;
                } else {
                    statusText.className = 'font-bold text-slate-400 flex items-center gap-1';
                    statusText.innerHTML = `<i class="fas fa-eye-slash text-[10px]"></i><span>Private & Hidden</span>`;
                }
            }
        }

        // Render Access Denied Warning
        function renderAccessDenied(errorMessage) {
            const stream = document.getElementById('messageStream');
            if (!stream) return;
            stream.innerHTML = `
                <div class="py-16 px-6 text-center max-w-md mx-auto">
                    <div class="w-14 h-14 rounded-2xl bg-rose-50 border border-rose-200 text-rose-600 flex items-center justify-center mx-auto mb-3 text-xl">
                        <i class="fas fa-lock"></i>
                    </div>
                    <h4 class="text-sm font-black text-slate-800 mb-1">Access Restricted</h4>
                    <p class="text-xs text-slate-500 mb-4">${escapeHtml(errorMessage)}</p>
                    <button type="button" onclick="switchMessagingTab('directory')" class="px-4 py-2 bg-slate-100 hover:bg-slate-200 rounded-xl text-xs font-bold text-slate-700 transition">Browse Authorized Classmates</button>
                </div>
            `;
        }

        // Render Message Bubbles
        function renderMessages(messages, forceScroll = false) {
            const stream = document.getElementById('messageStream');
            if (!stream) return;

            if (messages.length === 0) {
                stream.innerHTML = `
                    <div class="py-16 px-6 text-center text-slate-400">
                        <div class="w-12 h-12 rounded-2xl bg-white border border-slate-200/80 shadow-2xs flex items-center justify-center mx-auto mb-3 text-cyan-600">
                            <i class="far fa-paper-plane text-lg"></i>
                        </div>
                        <p class="text-xs font-bold text-slate-700">No Messages Yet</p>
                        <p class="text-[11px] text-slate-400 mt-1">Send a greeting to start your conversation with ${escapeHtml(document.getElementById('partnerHeaderName').textContent)}.</p>
                    </div>
                `;
                return;
            }

            const streamWasNearBottom = (stream.scrollHeight - stream.scrollTop - stream.clientHeight) < 120;
            const readReceiptsActive = isReadReceiptsEnabled();

            let html = '';
            let lastDateLabel = null;

            messages.forEach(msg => {
                const isMine = (msg.sender_id === CURRENT_USER_ID);
                const isPinned = isMessagePinned(msg.message_id);
                const dateLabel = formatDayDivider(msg.sent_at);

                if (dateLabel !== lastDateLabel) {
                    html += `
                        <div class="flex items-center justify-center my-3">
                            <span class="px-3 py-1 rounded-full bg-slate-200/70 text-slate-600 text-[10px] font-bold uppercase tracking-wider shadow-2xs">
                                ${dateLabel}
                            </span>
                        </div>
                    `;
                    lastDateLabel = dateLabel;
                }

                const timeStr = formatTimeOnly(msg.sent_at);
                const bubbleContent = formatMessageBubbleContent(msg.message_text, isMine);

                if (isMine) {
                    html += `
                        <div id="msg-${msg.message_id}" class="group relative flex flex-col items-end msg-bubble-animate transition-all duration-300">
                            ${isPinned ? `
                                <div class="flex items-center gap-1 text-[10px] text-amber-600 font-bold mb-0.5 mr-1">
                                    <i class="fas fa-thumbtack text-[9px] text-amber-500"></i>
                                    <span>Pinned</span>
                                </div>
                            ` : ''}
                            <div class="relative flex items-center gap-1.5 flex-row-reverse">
                                <div class="max-w-[85%] sm:max-w-md px-4 py-2.5 rounded-2xl rounded-br-xs bg-gradient-to-r from-cyan-600 to-blue-600 text-white shadow-xs text-xs sm:text-sm leading-relaxed break-words">
                                    ${bubbleContent}
                                </div>
                                <button type="button" onclick="togglePinMessage(${msg.message_id})" title="${isPinned ? 'Unpin message' : 'Pin message'}" 
                                        class="p-1.5 text-slate-400 hover:text-amber-500 rounded-lg hover:bg-slate-100 transition cursor-pointer text-xs ${isPinned ? 'opacity-100 text-amber-500' : 'opacity-0 group-hover:opacity-100'}">
                                    <i class="fas fa-thumbtack"></i>
                                </button>
                            </div>
                            <div class="flex items-center gap-1.5 mt-1 mr-1 text-[10px] text-slate-400 font-medium">
                                <span>${timeStr}</span>
                                ${readReceiptsActive 
                                    ? `<i class="fas ${msg.is_read ? 'fa-check-double text-cyan-600' : 'fa-check text-slate-400'} text-[9px]" title="${msg.is_read ? 'Read' : 'Delivered'}"></i>`
                                    : `<i class="fas fa-check text-slate-400 text-[9px]" title="Delivered"></i>`
                                }
                            </div>
                        </div>
                    `;
                } else {
                    html += `
                        <div id="msg-${msg.message_id}" class="group relative flex items-start gap-2.5 max-w-[85%] sm:max-w-md msg-bubble-animate transition-all duration-300">
                            <img src="${currentPartner?.profile_pic ? '/profile_uploads/' + currentPartner.profile_pic : '/profile_uploads/default_avatar.png'}" 
                                 alt="Avatar" 
                                 class="w-8 h-8 rounded-xl object-cover ring-1 ring-slate-200 shrink-0 mt-0.5"
                                 onerror="this.src='/profile_uploads/default_avatar.png'">
                            <div class="flex flex-col min-w-0">
                                ${isPinned ? `
                                    <div class="flex items-center gap-1 text-[10px] text-amber-600 font-bold mb-0.5 ml-1">
                                        <i class="fas fa-thumbtack text-[9px] text-amber-500"></i>
                                        <span>Pinned</span>
                                    </div>
                                ` : ''}
                                <div class="flex items-center gap-1.5">
                                    <div class="px-4 py-2.5 rounded-2xl rounded-bl-xs bg-white border border-slate-200/90 text-slate-800 shadow-xs text-xs sm:text-sm leading-relaxed break-words">
                                        ${bubbleContent}
                                    </div>
                                    <button type="button" onclick="togglePinMessage(${msg.message_id})" title="${isPinned ? 'Unpin message' : 'Pin message'}" 
                                            class="p-1.5 text-slate-400 hover:text-amber-500 rounded-lg hover:bg-slate-100 transition cursor-pointer text-xs ${isPinned ? 'opacity-100 text-amber-500' : 'opacity-0 group-hover:opacity-100'}">
                                        <i class="fas fa-thumbtack"></i>
                                    </button>
                                </div>
                                <span class="text-[10px] text-slate-400 mt-1 ml-1 font-medium">${timeStr}</span>
                            </div>
                        </div>
                    `;
                }
            });

            stream.innerHTML = html;

            if (forceScroll || streamWasNearBottom) {
                setTimeout(() => {
                    stream.scrollTop = stream.scrollHeight;
                }, 50);
            }
        }

        // 6. Send Message Handler
        async function handleSendMessage(e) {
            e.preventDefault();
            if (!currentPartnerId || isSending) return;

            const input = document.getElementById('messageInput');
            const text = (input?.value || '').trim();
            if (!text) return;

            const sendBtn = document.getElementById('sendBtn');
            isSending = true;
            if (sendBtn) {
                sendBtn.disabled = true;
                sendBtn.innerHTML = `<span>Sending...</span><i class="fas fa-circle-notch fa-spin text-xs"></i>`;
            }
            input.value = '';

            // Optimistic Message Append
            const optimisticMsg = {
                message_id: 'temp-' + Date.now(),
                sender_id: CURRENT_USER_ID,
                receiver_id: currentPartnerId,
                message_text: text,
                sent_at: new Date().toISOString(),
                is_read: 0
            };
            currentMessages.push(optimisticMsg);
            renderMessages(currentMessages, true);

            try {
                const res = await fetch('/api/messages', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        receiver_id: currentPartnerId,
                        message_text: text
                    })
                });

                if (res.status === 403) {
                    const data = await res.json();
                    alert(data.error || 'Access restricted by class enrollment boundary.');
                    currentMessages = currentMessages.filter(m => m.message_id !== optimisticMsg.message_id);
                    renderMessages(currentMessages, true);
                    return;
                }

                if (!res.ok) throw new Error('Failed to send message');

                const data = await res.json();
                if (data.success && data.message_id) {
                    optimisticMsg.message_id = data.message_id;
                    if (data.sent_at) {
                        optimisticMsg.sent_at = data.sent_at;
                        lastPollTimestamp = data.sent_at;
                    }
                }

                // Refresh conversation previews in sidebar
                fetchConversations();

            } catch (err) {
                console.error('[SEND MESSAGE ERROR]', err);
                alert('Failed to deliver message. Please check your connection.');
            } finally {
                isSending = false;
                if (sendBtn) {
                    sendBtn.disabled = false;
                    sendBtn.innerHTML = `<span>Send</span><i class="fas fa-paper-plane text-xs"></i>`;
                }
                input?.focus();
            }
        }

        // 6b. Attachment Upload Handlers
        function triggerFileUpload() {
            if (!currentPartnerId || isSending) return;
            document.getElementById('chatFileInput')?.click();
        }

        async function handleFileSelected(event) {
            const file = event.target.files && event.target.files[0];
            if (!file || !currentPartnerId || isSending) return;

            // Reset input so the user can re-select the same file if needed
            event.target.value = '';

            // 25MB file size limit check
            if (file.size > 25 * 1024 * 1024) {
                alert('Attachment exceeds the 25MB limit. Please choose a smaller file.');
                return;
            }

            const banner = document.getElementById('uploadingBanner');
            if (banner) banner.classList.remove('hidden');

            isSending = true;
            const formData = new FormData();
            formData.append('receiver_id', currentPartnerId);
            formData.append('file', file);

            try {
                const res = await fetch('/api/student/messaging/upload', {
                    method: 'POST',
                    body: formData
                });

                if (res.status === 403) {
                    const data = await res.json();
                    alert(data.error || 'Access restricted by class enrollment boundary.');
                    return;
                }

                if (!res.ok) throw new Error('Upload failed');

                const data = await res.json();
                if (data.success) {
                    currentMessages.push({
                        message_id: data.message_id,
                        sender_id: CURRENT_USER_ID,
                        receiver_id: currentPartnerId,
                        message_text: data.message_text,
                        sent_at: data.sent_at || new Date().toISOString(),
                        is_read: 0
                    });
                    if (data.sent_at) {
                        lastPollTimestamp = data.sent_at;
                    }
                    renderMessages(currentMessages, true);
                    fetchConversations();
                }
            } catch (err) {
                console.error('[ATTACHMENT UPLOAD ERROR]', err);
                alert('Failed to upload file attachment. Please try again.');
            } finally {
                isSending = false;
                if (banner) banner.classList.add('hidden');
            }
        }

        // 7. Format Helpers & Utility Functions
        function getFileIcon(fileName) {
            const ext = (fileName || '').split('.').pop().toLowerCase();
            switch (ext) {
                case 'pdf': return '<i class="fas fa-file-pdf text-rose-500 text-lg shrink-0"></i>';
                case 'doc':
                case 'docx': return '<i class="fas fa-file-word text-blue-500 text-lg shrink-0"></i>';
                case 'xls':
                case 'xlsx': return '<i class="fas fa-file-excel text-emerald-500 text-lg shrink-0"></i>';
                case 'ppt':
                case 'pptx': return '<i class="fas fa-file-powerpoint text-amber-500 text-lg shrink-0"></i>';
                case 'zip':
                case 'rar':
                case '7z': return '<i class="fas fa-file-zipper text-purple-500 text-lg shrink-0"></i>';
                case 'txt':
                case 'md': return '<i class="fas fa-file-lines text-slate-500 text-lg shrink-0"></i>';
                case 'mp3':
                case 'wav':
                case 'm4a': return '<i class="fas fa-file-audio text-teal-500 text-lg shrink-0"></i>';
                case 'mp4':
                case 'mov': return '<i class="fas fa-file-video text-indigo-500 text-lg shrink-0"></i>';
                default: return '<i class="fas fa-file-lines text-slate-400 text-lg shrink-0"></i>';
            }
        }

        function formatMessagePreview(text) {
            if (!text) return 'No messages yet';
            if (text.includes('||')) {
                const parts = text.split('||');
                return '📎 File: ' + (parts[1] || 'Attachment');
            }
            return text;
        }

        function formatMessageBubbleContent(text, isMine) {
            if (!text) return '';
            // Attachment format: url||filename
            if (text.includes('||')) {
                const parts = text.split('||');
                const fileUrl = parts[0];
                const fileName = parts[1] || 'Attachment';
                const isImage = /\.(jpg|jpeg|png|gif|webp)$/i.test(fileName) || /\.(jpg|jpeg|png|gif|webp)$/i.test(fileUrl);

                if (isImage) {
                    return `
                        <div class="rounded-xl overflow-hidden mb-1.5 border ${isMine ? 'border-cyan-400/40' : 'border-slate-200'}">
                            <img src="${escapeHtml(fileUrl)}" alt="${escapeHtml(fileName)}" class="max-h-56 w-auto object-cover cursor-pointer hover:opacity-95 transition" onclick="window.open('${escapeHtml(fileUrl)}', '_blank')">
                        </div>
                        <a href="${escapeHtml(fileUrl)}" target="_blank" rel="noopener noreferrer" class="text-[11px] underline font-bold flex items-center gap-1.5 ${isMine ? 'text-cyan-100 hover:text-white' : 'text-cyan-600 hover:text-cyan-800'}">
                            <i class="fas fa-arrow-up-right-from-square text-[9px]"></i>
                            <span class="truncate">${escapeHtml(fileName)}</span>
                        </a>
                    `;
                } else {
                    const iconHtml = getFileIcon(fileName);
                    return `
                        <div class="flex items-center gap-3 p-2.5 rounded-xl ${isMine ? 'bg-cyan-800/40 border border-cyan-400/30' : 'bg-slate-50 border border-slate-200'} transition">
                            <div class="w-9 h-9 rounded-lg ${isMine ? 'bg-cyan-950/60' : 'bg-white shadow-2xs'} flex items-center justify-center shrink-0">
                                ${iconHtml}
                            </div>
                            <div class="min-w-0 flex-1">
                                <p class="text-xs font-bold truncate ${isMine ? 'text-white' : 'text-slate-800'}">${escapeHtml(fileName)}</p>
                                <p class="text-[10px] ${isMine ? 'text-cyan-200' : 'text-slate-400'} font-medium">Attachment</p>
                            </div>
                            <a href="${escapeHtml(fileUrl)}" target="_blank" download class="p-2 rounded-lg ${isMine ? 'bg-cyan-600/80 hover:bg-cyan-600 text-white' : 'bg-slate-100 hover:bg-slate-200 text-slate-700'} transition cursor-pointer" title="Download ${escapeHtml(fileName)}">
                                <i class="fas fa-download text-xs"></i>
                            </a>
                        </div>
                    `;
                }
            }

            // Auto-link URLs
            const urlRegex = /(https?:\/\/[^\s]+)/g;
            return escapeHtml(text).replace(urlRegex, function(url) {
                return `<a href="${url}" target="_blank" rel="noopener noreferrer" class="underline font-semibold ${isMine ? 'text-cyan-100 hover:text-white' : 'text-cyan-600 hover:text-cyan-800'}">${url}</a>`;
            });
        }

        function formatTimestamp(isoStr) {
            if (!isoStr) return '';
            const d = new Date(isoStr);
            if (isNaN(d.getTime())) return '';
            const now = new Date();
            const diffMin = Math.floor((now - d) / 60000);

            if (diffMin < 1) return 'Just now';
            if (diffMin < 60) return diffMin + 'm ago';
            const diffHrs = Math.floor(diffMin / 60);
            if (diffHrs < 24 && now.getDate() === d.getDate()) return diffHrs + 'h ago';
            if (diffHrs < 48) return 'Yesterday';
            return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }

        function formatTimeOnly(isoStr) {
            if (!isoStr) return '';
            const d = new Date(isoStr);
            if (isNaN(d.getTime())) return '';
            return d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
        }

        function formatDayDivider(isoStr) {
            if (!isoStr) return 'Recent';
            const d = new Date(isoStr);
            if (isNaN(d.getTime())) return 'Recent';
            const now = new Date();

            if (now.toDateString() === d.toDateString()) return 'Today';
            const yesterday = new Date();
            yesterday.setDate(now.getDate() - 1);
            if (yesterday.toDateString() === d.toDateString()) return 'Yesterday';

            return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
        }

        function escapeHtml(str) {
            if (!str) return '';
            return String(str)
                .replace(/&/g, '&amp;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/"/g, '&quot;')
                .replace(/'/g, '&#039;');
        }

        function clearContactSearch() {
            const searchInput = document.getElementById('contactSearchInput');
            const clearBtn = document.getElementById('clearSearchBtn');
            if (searchInput) searchInput.value = '';
            if (clearBtn) clearBtn.classList.add('hidden');
            searchQuery = '';
            if (activeTab === 'conversations') {
                renderConversations();
            } else {
                fetchContacts();
            }
        }

        // 8. Event Listeners & Search / Filter Bindings
        document.addEventListener('DOMContentLoaded', () => {
            // Initial Fetch
            fetchConversations();
            fetchContacts();

            // Search Input Listener
            const searchInput = document.getElementById('contactSearchInput');
            const clearBtn = document.getElementById('clearSearchBtn');
            if (searchInput) {
                searchInput.addEventListener('input', (e) => {
                    searchQuery = e.target.value;
                    if (clearBtn) {
                        if (searchQuery.trim().length > 0) {
                            clearBtn.classList.remove('hidden');
                        } else {
                            clearBtn.classList.add('hidden');
                        }
                    }
                    clearTimeout(searchDebounceTimer);
                    searchDebounceTimer = setTimeout(() => {
                        if (activeTab === 'conversations') {
                            renderConversations();
                        } else {
                            fetchContacts();
                        }
                    }, 250);
                });
            }

            // Subject Filter Pills
            const pills = document.querySelectorAll('.subject-filter-chip');
            pills.forEach(pill => {
                pill.addEventListener('click', function() {
                    pills.forEach(p => {
                        p.classList.remove('active', 'bg-cyan-600', 'text-white');
                        p.classList.add('bg-slate-100', 'text-slate-600');
                    });
                    this.classList.add('active', 'bg-cyan-600', 'text-white');
                    this.classList.remove('bg-slate-100', 'text-slate-600');

                    selectedSubjectId = this.dataset.subjectId || '';
                    if (selectedSubjectId && activeTab === 'conversations') {
                        switchMessagingTab('directory');
                    } else if (activeTab === 'directory') {
                        fetchContacts();
                    }
                });
            });

            // Check URL parameters for direct partner open (?userId=123)
            const urlParams = new URLSearchParams(window.location.search);
            const targetUserId = parseInt(urlParams.get('userId'), 10);
            if (!isNaN(targetUserId)) {
                // Poll contacts or directly open thread
                fetch(`/api/student/messaging/contacts?q=`).then(r => r.json()).then(data => {
                    const match = (data.contacts || []).find(c => c.user_id === targetUserId);
                    if (match) {
                        openChatThread(match);
                    } else {
                        // Fallback: try opening with generic info
                        openChatThread({ user_id: targetUserId, first_name: 'Contact', last_name: '#' + targetUserId, role: 'user' });
                    }
                }).catch(() => {});
            }

            // Scroll Listener to dismiss floating new messages badge when user scrolls down
            const stream = document.getElementById('messageStream');
            if (stream) {
                stream.addEventListener('scroll', () => {
                    const isNearBottom = (stream.scrollHeight - stream.scrollTop - stream.clientHeight) < 60;
                    if (isNearBottom) {
                        const badge = document.getElementById('newMessagesBadge');
                        if (badge) badge.classList.add('hidden');
                    }
                });
            }

            // Real-Time Polling Engine
            startPolling();

            // Visibility API: adjust polling when inactive
            document.addEventListener('visibilitychange', () => {
                if (document.hidden) {
                    stopPolling();
                    pollingTimer = setInterval(tickPolling, 15000);
                } else {
                    stopPolling();
                    startPolling();
                    tickPolling(); // Immediate poll on tab refocus
                }
            });
        });

        function startPolling() {
            stopPolling();
            pollingTimer = setInterval(tickPolling, 2500);
        }

        function stopPolling() {
            if (pollingTimer) {
                clearInterval(pollingTimer);
                pollingTimer = null;
            }
        }

        function tickPolling() {
            if (currentPartnerId) {
                pollDeltaMessages();
            }
            fetchConversations();
        }
    </script>
</body>
</html>
