<!DOCTYPE html>
<html lang="en" class="h-full bg-slate-900/5">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Elementa · Messages &amp; Consultations</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome 6 Pro CDN -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    <!-- Google Fonts: Inter -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', system-ui, -apple-system, sans-serif;
        }
        /* Custom scrollbar styling for chat message streams */
        .chat-scrollbar::-webkit-scrollbar {
            width: 5px;
        }
        .chat-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }
        .chat-scrollbar::-webkit-scrollbar-thumb {
            background: rgba(148, 163, 184, 0.35);
            border-radius: 9999px;
        }
        .chat-scrollbar::-webkit-scrollbar-thumb:hover {
            background: rgba(148, 163, 184, 0.6);
        }
        /* Active thread item highlighting */
        .convo-item.is-active-convo {
            background: rgba(6, 182, 212, 0.08) !important;
            border-left: 3px solid #06b6d4;
        }
        /* Message bubble animations */
        @keyframes messageAppear {
            from {
                opacity: 0;
                transform: translateY(6px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        .msg-bubble-animate {
            animation: messageAppear 0.18s cubic-bezier(0.4, 0, 0.2, 1) forwards;
        }

        /* Messaging Full-Width Workspace Layout: zero sidebar offsets */
        #mainContent {
            margin-left: 0 !important;
            width: 100% !important;
        }
        header {
            left: 0 !important;
            right: 0 !important;
        }
    </style>
</head>
<body class="h-full overflow-hidden flex flex-col text-slate-800">

    <!-- Main Content Area (Full Screen Messaging Workspace) -->
    <div id="mainContent" class="flex-1 flex flex-col min-w-0 h-full w-full">
        <!-- Header -->
        <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 z-30 transition-all duration-300">
            <div class="flex items-center gap-4">
                <!-- Dedicated Back Button to Return to Previous Student Page -->
                <button type="button" 
                        onclick="handleNavigationBack()" 
                        id="backNavBtn" 
                        aria-label="Go back to previous page" 
                        title="Go back to previous page" 
                        class="p-2.5 rounded-xl hover:bg-slate-100 text-slate-600 hover:text-indigo-950 border border-slate-200/80 shadow-2xs hover:shadow-xs transition focus-visible:ring-2 focus-visible:ring-cyan-500 flex items-center justify-center cursor-pointer group">
                    <i class="fas fa-arrow-left text-lg text-slate-600 group-hover:text-indigo-950 group-hover:-translate-x-0.5 transition-all"></i>
                </button>
                <div class="flex items-center gap-3">
                    <div class="relative w-10 h-10 rounded-2xl bg-cyan-500/10 text-cyan-600 flex items-center justify-center border border-cyan-500/20 shadow-xs">
                        <i class="far fa-comment-dots text-lg"></i>
                        <span class="absolute -top-1.5 -right-1.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                            <span class="msg-badge-count">0</span>
                        </span>
                    </div>
                    <div>
                        <h1 class="text-lg md:text-xl font-black text-indigo-950 uppercase tracking-tight">
                            Messages
                        </h1>
                        <p class="text-xs text-slate-500 hidden sm:block font-medium">
                            Consult with course advisers &amp; collaborate with enrolled classmates
                        </p>
                    </div>
                </div>
            </div>

            <div class="flex items-center gap-3 md:gap-6">
                <!-- Notification Bell Button -->
                <button type="button" onclick="toggleNotifications()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                    <i class="far fa-bell text-xl text-slate-700"></i>
                    <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center notif-badge hidden" aria-hidden="true">
                        <span class="notif-badge-count">0</span>
                    </span>
                    <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                        Notifications
                    </span>
                </button>

                <!-- User Profile Summary -->
                <div class="flex items-center gap-3 pl-4 border-l border-slate-200">
                    <div class="text-right hidden sm:block">
                        <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                        <p class="text-xs uppercase font-bold text-slate-500 tracking-wider leading-none"><%= user.role %></p>
                    </div>
                    <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" 
                         alt="<%= user.first_name %>'s avatar" 
                         class="w-10 h-10 rounded-xl object-cover ring-2 ring-cyan-100"
                         onerror="this.src='/profile_uploads/default_avatar.png'">
                </div>
            </div>
        </header>

        <!-- Messenger Workspace Container -->
        <div class="flex-1 flex overflow-hidden mt-20 bg-slate-100/60 relative">
            <!-- Left Pane: Contact Directory & Recent Conversations -->
            <aside id="chatSidebar" class="w-full md:w-80 lg:w-96 bg-white border-r border-slate-200/80 flex flex-col z-10 shrink-0 h-full">
                <!-- Directory Search & Header -->
                <div class="p-4 border-b border-slate-100">
                    <div class="relative">
                        <i class="fas fa-search absolute left-3.5 top-3 text-slate-400 text-xs"></i>
                        <input type="text" id="contactSearchInput" placeholder="Search classmates or advisers..." 
                               class="w-full pl-9 pr-8 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:bg-white transition"
                               autocomplete="off">
                        <button type="button" id="clearSearchBtn" onclick="clearContactSearch()" class="hidden absolute right-2.5 top-2.5 text-slate-400 hover:text-slate-600 text-xs cursor-pointer" aria-label="Clear search">
                            <i class="fas fa-times-circle"></i>
                        </button>
                    </div>
                    <!-- Enrolled Subject Filter Chips -->
                    <% if (typeof subjects !== 'undefined' && subjects.length > 0) { %>
                        <div id="subjectFilterPills" class="flex items-center gap-1.5 overflow-x-auto no-scrollbar mt-3 pt-0.5">
                            <button type="button" class="subject-filter-chip active px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-cyan-600 text-white shadow-xs shrink-0 transition cursor-pointer" data-subject-id="">
                                All
                            </button>
                            <% subjects.forEach(sub => { %>
                                <button type="button" class="subject-filter-chip px-3 py-1 rounded-full text-[11px] font-bold uppercase tracking-wider bg-slate-100 text-slate-600 hover:bg-slate-200 hover:text-slate-800 shrink-0 transition cursor-pointer" data-subject-id="<%= sub.subject_id %>">
                                    <%= sub.subject_code %>
                                </button>
                            <% }) %>
                        </div>
                    <% } %>
                </div>

                <!-- Navigation Tabs (Recent Conversations vs. Class Directory) -->
                <div class="flex border-b border-slate-100 text-xs font-bold text-slate-500 shrink-0 bg-slate-50/50">
                    <button id="tabConversations" onclick="switchMessagingTab('conversations')" class="flex-1 py-3 text-center border-b-2 border-cyan-500 text-cyan-600 font-black transition flex items-center justify-center gap-2 cursor-pointer">
                        <i class="far fa-comments text-xs"></i>
                        <span>Recent</span>
                        <span id="totalUnreadBadge" class="hidden px-1.5 py-0.2 rounded-full bg-rose-500 text-white text-[10px] font-black"></span>
                    </button>
                    <button id="tabDirectory" onclick="switchMessagingTab('directory')" class="flex-1 py-3 text-center border-b-2 border-transparent hover:text-slate-700 transition flex items-center justify-center gap-1.5 cursor-pointer">
                        <i class="far fa-address-book text-xs"></i>
                        <span>Class Directory</span>
                    </button>
                </div>

                <!-- Scrollable List Container -->
                <div id="conversationsContainer" class="flex-1 overflow-y-auto chat-scrollbar divide-y divide-slate-100">
                    <div class="p-8 text-center text-slate-400 text-xs">
                        <i class="fas fa-circle-notch fa-spin text-xl text-cyan-500 mb-2"></i>
                        <p>Loading conversation threads...</p>
                    </div>
                </div>
            </aside>

            <!-- Right Pane: Active Chat Conversation Stream -->
            <main id="chatMain" class="flex-1 flex flex-col bg-slate-50/50 h-full min-w-0 relative">
                <!-- Default Placeholder Empty State -->
                <div id="noChatSelected" class="flex-1 flex flex-col items-center justify-center p-8 text-center">
                    <div class="w-16 h-16 rounded-3xl bg-cyan-500/10 text-cyan-600 flex items-center justify-center mb-4 text-2xl shadow-sm border border-cyan-500/20">
                        <i class="far fa-comments"></i>
                    </div>
                    <h3 class="text-base font-black text-slate-800 mb-1">Your Communications Center</h3>
                    <p class="text-xs text-slate-500 max-w-sm mb-4">
                        Select an ongoing thread or choose a verified peer or course adviser from your enrolled classes to start communicating.
                    </p>
                    <button type="button" onclick="switchMessagingTab('directory')" class="px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white font-bold text-xs shadow-sm transition flex items-center gap-2 cursor-pointer">
                        <i class="fas fa-address-book"></i>
                        <span>Browse Class Directory</span>
                    </button>
                </div>

                <!-- Active Chat Thread Container (Revealed when active) -->
                <div id="activeChatContainer" class="flex-1 flex flex-col h-full min-w-0 hidden relative overflow-hidden">
                    <!-- Partner Header Bar -->
                    <header id="chatPartnerHeader" class="h-16 px-4 md:px-6 bg-white border-b border-slate-200/80 flex items-center justify-between shadow-2xs z-10 shrink-0">
                        <div class="flex items-center gap-3 min-w-0">
                            <!-- Mobile Back Button -->
                            <button id="mobileBackBtn" onclick="closeActiveChatMobile()" class="md:hidden p-2 text-slate-500 hover:text-slate-800 -ml-1 rounded-lg hover:bg-slate-100 transition cursor-pointer" aria-label="Back to conversations list">
                                <i class="fas fa-arrow-left text-base"></i>
                            </button>
                            <div class="relative shrink-0">
                                <img id="partnerHeaderAvatar" src="/profile_uploads/default_avatar.png" alt="Partner Avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-slate-100" onerror="this.src='/profile_uploads/default_avatar.png'">
                                <span id="partnerOnlineStatus" class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 rounded-full border-2 border-white"></span>
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-2">
                                    <h3 id="partnerHeaderName" class="text-sm font-black text-slate-800 leading-snug truncate">Partner Name</h3>
                                    <span id="partnerHeaderRoleBadge" class="text-[9px] font-black uppercase px-2 py-0.5 rounded-md bg-indigo-50 text-indigo-700 border border-indigo-100">Classmate</span>
                                </div>
                                <div class="flex items-center gap-1.5 mt-0.5">
                                    <i class="fas fa-graduation-cap text-[10px] text-slate-400"></i>
                                    <span id="partnerHeaderSharedClasses" class="text-[11px] font-semibold text-slate-400 truncate max-w-xs">Shared Classes</span>
                                </div>
                            </div>
                        </div>

                        <!-- Thread Actions: Dedicated Conversation Information Button -->
                        <div class="flex items-center gap-2">
                            <button type="button" id="convoInfoBtn" onclick="toggleConversationInfo()" title="Conversation Details & Settings" aria-label="Conversation Details & Settings" class="p-2.5 text-slate-500 hover:text-cyan-600 hover:bg-slate-100 rounded-xl transition cursor-pointer flex items-center justify-center">
                                <i class="fas fa-circle-info text-base"></i>
                            </button>
                        </div>
                    </header>

                    <!-- Main Chat Body: Stream/Composer on left + Collapsible Info Panel on right -->
                    <div class="flex-1 flex min-w-0 h-[calc(100%-4rem)] relative overflow-hidden">
                        
                        <!-- Left Chat Stream Column -->
                        <div class="flex-1 flex flex-col min-w-0 h-full relative">
                            <!-- Scrollable Message Stream -->
                            <div id="messageStream" class="flex-1 overflow-y-auto chat-scrollbar p-4 md:p-6 space-y-3 bg-slate-50/70">
                                <div class="p-8 text-center text-slate-400 text-xs">
                                    <i class="fas fa-circle-notch fa-spin text-xl text-cyan-500 mb-2"></i>
                                    <p>Loading messages...</p>
                                </div>
                            </div>

                            <!-- Floating New Messages Below Button -->
                            <button type="button" id="newMessagesBadge" onclick="scrollToStreamBottom()" class="hidden absolute bottom-20 left-1/2 -translate-x-1/2 px-3.5 py-1.5 bg-cyan-600 hover:bg-cyan-700 text-white rounded-full shadow-lg text-xs font-bold cursor-pointer transition flex items-center gap-1.5 z-20">
                                <i class="fas fa-arrow-down text-[10px]"></i>
                                <span>New messages below</span>
                            </button>

                            <!-- Message Composer -->
                            <footer class="bg-white border-t border-slate-200/80 shrink-0">
                                <!-- Uploading Attachment Banner -->
                                <div id="uploadingBanner" class="hidden px-4 py-2 bg-cyan-50/80 border-b border-cyan-100 flex items-center justify-between text-xs font-semibold text-cyan-800 animate-pulse">
                                    <div class="flex items-center gap-2">
                                        <i class="fas fa-circle-notch fa-spin text-cyan-600"></i>
                                        <span>Uploading attachment...</span>
                                    </div>
                                    <span class="text-[11px] text-cyan-600 font-medium">Please wait</span>
                                </div>

                                <form id="messageForm" onsubmit="handleSendMessage(event)" class="p-3 md:p-4 flex items-center gap-2 sm:gap-3">
                                    <button type="button" id="attachBtn" onclick="triggerFileUpload()" title="Attach file or image" class="p-2.5 text-slate-400 hover:text-cyan-600 hover:bg-slate-100 rounded-xl transition cursor-pointer">
                                        <i class="fas fa-paperclip text-sm"></i>
                                    </button>
                                    <input type="file" id="chatFileInput" class="hidden" onchange="handleFileSelected(event)">
                                    <input type="text" id="messageInput" placeholder="Write a message..." autocomplete="off"
                                           class="flex-1 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs sm:text-sm focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:bg-white transition">
                                    <button type="submit" id="sendBtn" class="px-5 py-2.5 bg-gradient-to-r from-cyan-500 to-blue-600 hover:from-cyan-600 hover:to-blue-700 text-white font-bold rounded-xl text-xs transition shadow-md flex items-center gap-1.5 cursor-pointer disabled:opacity-50">
                                        <span>Send</span>
                                        <i class="fas fa-paper-plane text-xs"></i>
                                    </button>
                                </form>
                            </footer>
                        </div>

                        <!-- Mobile Backdrop for off-canvas drawer -->
                        <div id="infoPanelBackdrop" onclick="toggleConversationInfo(false)" class="hidden fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-30 transition-opacity md:hidden"></div>

                        <!-- Right Detail Panel (Collapsible on Desktop, Off-Canvas Drawer on Mobile) -->
                        <aside id="chatInfoPanel" class="hidden w-80 lg:w-96 bg-white border-l border-slate-200/80 h-full shrink-0 flex-col overflow-y-auto chat-scrollbar z-40 fixed inset-y-0 right-0 md:static md:z-10 shadow-2xl md:shadow-none transition-all duration-300">
                            <!-- Panel Header -->
                            <div class="p-4 border-b border-slate-100 flex items-center justify-between shrink-0 sticky top-0 bg-white/95 backdrop-blur-xs z-10">
                                <div class="flex items-center gap-2">
                                    <div class="w-8 h-8 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center text-sm font-bold border border-cyan-100">
                                        <i class="fas fa-circle-info"></i>
                                    </div>
                                    <h4 class="text-xs font-black uppercase text-slate-800 tracking-wider">Conversation Info</h4>
                                </div>
                                <button type="button" onclick="toggleConversationInfo(false)" title="Close details panel" class="p-1.5 text-slate-400 hover:text-slate-700 hover:bg-slate-100 rounded-lg transition cursor-pointer">
                                    <i class="fas fa-xmark text-sm"></i>
                                </button>
                            </div>

                            <div class="p-4 md:p-5 space-y-6">
                                <!-- 1. Chat Info: Participant Profile Details -->
                                <section id="convoProfileSection" class="flex flex-col items-center text-center">
                                    <div class="relative mb-3">
                                        <img id="infoPanelAvatar" src="/profile_uploads/default_avatar.png" alt="Participant Avatar" 
                                             class="w-20 h-20 rounded-2xl object-cover ring-4 ring-cyan-500/10 shadow-md" 
                                             onerror="this.src='/profile_uploads/default_avatar.png'">
                                        <span id="infoPanelStatusDot" class="absolute -bottom-1 -right-1 w-4 h-4 bg-emerald-500 rounded-full border-2 border-white shadow-xs"></span>
                                    </div>
                                    <h3 id="infoPanelName" class="text-base font-black text-slate-800 leading-snug">Participant Name</h3>
                                    
                                    <div class="mt-1.5 flex items-center gap-1.5 justify-center flex-wrap">
                                        <span id="infoPanelRoleBadge" class="text-[10px] font-black uppercase px-2.5 py-0.5 rounded-md bg-cyan-50 text-cyan-700 border border-cyan-200">Classmate</span>
                                    </div>

                                    <!-- Real-time Presence Status -->
                                    <div id="infoPanelPresenceContainer" class="mt-2.5">
                                        <span id="infoPanelPresenceBadge" class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">
                                            <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
                                            <span id="infoPanelPresenceText">Active now</span>
                                        </span>
                                    </div>

                                    <!-- Enrolled Section or Academic Cohort Card -->
                                    <div class="w-full mt-4 p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 text-left space-y-2.5">
                                        <div class="flex items-start gap-2.5">
                                            <div class="w-7 h-7 rounded-lg bg-white border border-slate-200/70 flex items-center justify-center shrink-0 text-cyan-600 text-xs shadow-2xs">
                                                <i class="fas fa-users-rectangle"></i>
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Section / Cohort</p>
                                                <p id="infoPanelCohort" class="text-xs font-bold text-slate-800 mt-0.5 truncate">Section A</p>
                                            </div>
                                        </div>
                                        <div class="flex items-start gap-2.5 pt-2 border-t border-slate-200/60">
                                            <div class="w-7 h-7 rounded-lg bg-white border border-slate-200/70 flex items-center justify-center shrink-0 text-cyan-600 text-xs shadow-2xs">
                                                <i class="fas fa-graduation-cap"></i>
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Shared Classes</p>
                                                <p id="infoPanelSharedClasses" class="text-xs font-semibold text-slate-700 mt-0.5 leading-relaxed">Enrolled Classes</p>
                                            </div>
                                        </div>
                                    </div>
                                </section>

                                <!-- 2. Conversation Search: Integrated Search Bar -->
                                <section class="pt-2 border-t border-slate-100">
                                    <div class="flex items-center justify-between mb-2">
                                        <h5 class="text-xs font-black uppercase text-slate-600 tracking-wider flex items-center gap-1.5">
                                            <i class="fas fa-magnifying-glass text-cyan-600 text-xs"></i>
                                            <span>Search in Conversation</span>
                                        </h5>
                                    </div>
                                    <div class="relative">
                                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                        <input type="text" id="inChatSearchInput" placeholder="Query past messages..." oninput="handleInChatSearch(this.value)" autocomplete="off"
                                               class="w-full pl-8 pr-8 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:bg-white transition">
                                        <button type="button" id="clearInChatSearchBtn" onclick="clearInChatSearch()" class="hidden absolute right-2.5 top-1/2 -translate-y-1/2 text-slate-400 hover:text-slate-600 cursor-pointer">
                                            <i class="fas fa-xmark text-xs"></i>
                                        </button>
                                    </div>
                                    <!-- Search Matches Status -->
                                    <div id="inChatResultsCount" class="hidden mt-2 text-[11px] font-bold text-slate-500 flex items-center justify-between">
                                        <span id="inChatResultsText">0 messages found</span>
                                    </div>
                                    <div id="inChatSearchResults" class="mt-2 space-y-1.5 max-h-48 overflow-y-auto chat-scrollbar"></div>
                                </section>

                                <!-- 3. Pinned Messages Section -->
                                <section class="pt-2 border-t border-slate-100">
                                    <div class="flex items-center justify-between mb-2">
                                        <h5 class="text-xs font-black uppercase text-slate-600 tracking-wider flex items-center gap-1.5">
                                            <i class="fas fa-thumbtack text-amber-500 text-xs"></i>
                                            <span>Pinned Messages</span>
                                        </h5>
                                        <span id="pinnedCountBadge" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">0</span>
                                    </div>
                                    <div id="pinnedMessagesContainer" class="space-y-2 max-h-56 overflow-y-auto chat-scrollbar">
                                        <div class="p-4 rounded-xl bg-slate-50/80 border border-dashed border-slate-200 text-center text-slate-400 text-xs">
                                            <i class="fas fa-thumbtack text-slate-300 text-base mb-1"></i>
                                            <p class="font-medium">No pinned messages</p>
                                            <p class="text-[10px] text-slate-400 mt-0.5">Hover on any message bubble and click the pin icon to curate messages here.</p>
                                        </div>
                                    </div>
                                </section>

                                <!-- 4. Shared Media, Files, and Links -->
                                <section class="pt-2 border-t border-slate-100">
                                    <div class="flex items-center justify-between mb-2.5">
                                        <h5 class="text-xs font-black uppercase text-slate-600 tracking-wider flex items-center gap-1.5">
                                            <i class="fas fa-folder-open text-blue-500 text-xs"></i>
                                            <span>Shared Repository</span>
                                        </h5>
                                    </div>
                                    <!-- Repository Category Pills -->
                                    <div class="flex items-center p-1 bg-slate-100 rounded-xl text-[11px] font-bold gap-1 mb-3">
                                        <button type="button" id="sharedTabMediaBtn" onclick="switchSharedContentTab('media')" 
                                                class="flex-1 py-1.5 text-center rounded-lg bg-white shadow-2xs text-cyan-700 transition cursor-pointer">
                                            Media (<span id="sharedMediaCount">0</span>)
                                        </button>
                                        <button type="button" id="sharedTabFilesBtn" onclick="switchSharedContentTab('files')" 
                                                class="flex-1 py-1.5 text-center rounded-lg text-slate-500 hover:text-slate-700 transition cursor-pointer">
                                            Files (<span id="sharedFilesCount">0</span>)
                                        </button>
                                        <button type="button" id="sharedTabLinksBtn" onclick="switchSharedContentTab('links')" 
                                                class="flex-1 py-1.5 text-center rounded-lg text-slate-500 hover:text-slate-700 transition cursor-pointer">
                                            Links (<span id="sharedLinksCount">0</span>)
                                        </button>
                                    </div>

                                    <!-- Category Panes -->
                                    <div id="sharedMediaPane" class="max-h-60 overflow-y-auto chat-scrollbar">
                                        <div class="grid grid-cols-3 gap-2" id="sharedMediaGrid"></div>
                                        <div id="sharedMediaEmpty" class="hidden p-4 rounded-xl bg-slate-50/80 border border-dashed border-slate-200 text-center text-slate-400 text-xs">
                                            <i class="fas fa-photo-film text-slate-300 text-base mb-1"></i>
                                            <p class="font-medium">No media shared</p>
                                        </div>
                                    </div>
                                    <div id="sharedFilesPane" class="hidden space-y-2 max-h-60 overflow-y-auto chat-scrollbar">
                                        <div id="sharedFilesList" class="space-y-2"></div>
                                        <div id="sharedFilesEmpty" class="hidden p-4 rounded-xl bg-slate-50/80 border border-dashed border-slate-200 text-center text-slate-400 text-xs">
                                            <i class="fas fa-file-circle-question text-slate-300 text-base mb-1"></i>
                                            <p class="font-medium">No files attached</p>
                                        </div>
                                    </div>
                                    <div id="sharedLinksPane" class="hidden space-y-2 max-h-60 overflow-y-auto chat-scrollbar">
                                        <div id="sharedLinksList" class="space-y-2"></div>
                                        <div id="sharedLinksEmpty" class="hidden p-4 rounded-xl bg-slate-50/80 border border-dashed border-slate-200 text-center text-slate-400 text-xs">
                                            <i class="fas fa-link text-slate-300 text-base mb-1"></i>
                                            <p class="font-medium">No external links shared</p>
                                        </div>
                                    </div>
                                </section>

                                <!-- 5. Read Receipts Privacy Setting -->
                                <section class="pt-2 border-t border-slate-100 pb-4">
                                    <div class="flex items-center justify-between mb-2">
                                        <h5 class="text-xs font-black uppercase text-slate-600 tracking-wider flex items-center gap-1.5">
                                            <i class="fas fa-user-shield text-indigo-600 text-xs"></i>
                                            <span>Privacy Settings</span>
                                        </h5>
                                    </div>
                                    <div class="p-3.5 rounded-2xl bg-slate-50 border border-slate-200/80 space-y-3">
                                        <div class="flex items-center justify-between gap-3">
                                            <div class="min-w-0 flex-1">
                                                <label for="readReceiptsToggle" class="text-xs font-bold text-slate-800 cursor-pointer block">Show read receipts</label>
                                                <p class="text-[10px] text-slate-500 mt-0.5 leading-snug">
                                                    When off, chat members will not be able to see when you have read their messages, and reciprocally, you will not see read receipts from other members.
                                                </p>
                                            </div>
                                            <label class="relative inline-flex items-center cursor-pointer shrink-0">
                                                <input type="checkbox" id="readReceiptsToggle" onchange="toggleReadReceiptsPrivacy(this.checked)" class="sr-only peer" checked>
                                                <div class="w-11 h-6 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-5 after:w-5 after:transition-all peer-checked:bg-cyan-600"></div>
                                            </label>
                                        </div>
                                        <div class="pt-2 border-t border-slate-200/60 flex items-center justify-between text-[11px]">
                                            <span class="text-slate-400 font-medium">Receipts Status</span>
                                            <span id="readReceiptsStatusText" class="font-bold text-cyan-600 flex items-center gap-1">
                                                <i class="fas fa-check-double text-[10px]"></i>
                                                <span>Active & Visible</span>
                                            </span>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </aside>
                    </div>
                </div>
            </main>
        </div>
    </div>

    <!-- Notification Drawer -->
    <div id="notification-overlay" onclick="toggleNotifications()" class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[60] hidden transition-opacity duration-300 opacity-0"></div>
    <aside id="notification-drawer" class="fixed top-0 right-0 h-full w-full max-w-md bg-white shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 ease-in-out flex flex-col">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between bg-blue-600 text-white">
            <h2 class="text-lg font-bold flex items-center gap-2">
                <i class="far fa-bell"></i> Notifications
            </h2>
            <div class="flex items-center gap-2">
                <button onclick="NotificationHub.markAllRead('notification-list')" title="Mark all as read" class="hover:bg-blue-700 text-blue-100 hover:text-white p-2 rounded-lg transition text-xs font-bold flex items-center gap-1">
                    <i class="fas fa-check-double"></i> Mark all read
                </button>
                <button onclick="toggleNotifications()" class="hover:bg-blue-700 p-2 rounded-lg transition">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
        </div>
        <div id="notification-list" class="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-50">
            <div class="text-center py-20 text-slate-400">
                <p class="text-sm font-bold">Loading updates...</p>
            </div>
        </div>
    </aside>

    <!-- Notification Hub -->
    <script src="/js/notificationHub.js"></script>
    <script>
        function toggleNotifications() {
            const drawer = document.getElementById('notification-drawer');
            const overlay = document.getElementById('notification-overlay');
            if (!drawer || !overlay) return;
            const isOpen = !drawer.classList.contains('translate-x-full');
            if (isOpen) {
                drawer.classList.add('translate-x-full');
                overlay.classList.remove('opacity-100');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            } else {
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.add('opacity-100'), 10);
                drawer.classList.remove('translate-x-full');
                if (window.NotificationHub) {
                    NotificationHub.loadNotifications('notification-list', false);
                }
            }
        }
    </script>

    <!-- Client-Side Messaging Engine & Controller -->
    <script>
        // ========================================================
        // Navigation Back Controller
        // Navigates student directly back to their previous page or dashboard
        // ========================================================
        function handleNavigationBack() {
            if (document.referrer && document.referrer.indexOf(window.location.origin) !== -1) {
                window.history.back();
            } else if (window.history.length > 1) {
                window.history.back();
            } else {
                window.location.href = '/dashboard';
            }
        }

        // ========================================================
        // In-App Student Messenger Client Controller
        // ========================================================
        const CURRENT_USER_ID = <%= user.user_id %>;
        let activeTab = 'conversations'; // 'conversations' | 'directory'
        let selectedSubjectId = '';
        let searchQuery = '';
        let currentPartnerId = null;
        let currentPartner = null;
        let conversationsList = [];
        let contactsList = [];
        let currentMessages = [];
        let lastPollTimestamp = null;
        let isSending = false;
        let isPolling = false;
        let pollingTimer = null;
        let searchDebounceTimer = null;
        let isLoadingContacts = false;
        let contactsRequestId = 0;
        let isInfoPanelOpen = false;
        let activeSharedTab = 'media';
        let inChatSearchQuery = '';

        // 1. Tab Switching
        function switchMessagingTab(tab) {
            activeTab = tab;
            const tabConvoBtn = document.getElementById('tabConversations');
            const tabDirBtn = document.getElementById('tabDirectory');

            if (tab === 'conversations') {
                tabConvoBtn.className = "flex-1 py-3 text-center border-b-2 border-cyan-500 text-cyan-600 font-black transition flex items-center justify-center gap-1.5 cursor-pointer";
                tabDirBtn.className = "flex-1 py-3 text-center border-b-2 border-transparent hover:text-slate-700 transition flex items-center justify-center gap-1.5 cursor-pointer";
                renderConversations();
            } else {
                tabDirBtn.className = "flex-1 py-3 text-center border-b-2 border-cyan-500 text-cyan-600 font-black transition flex items-center justify-center gap-1.5 cursor-pointer";
                tabConvoBtn.className = "flex-1 py-3 text-center border-b-2 border-transparent hover:text-slate-700 transition flex items-center justify-center gap-1.5 cursor-pointer";
                
                // If we already have contacts cached and no active query, render immediately
                if (contactsList.length > 0 && !searchQuery && !selectedSubjectId) {
                    renderDirectory();
                }
                fetchContacts(false);
            }
        }

        // 2. Fetch Active Conversations
        async function fetchConversations() {
            try {
                const res = await fetch('/api/conversations');
                if (!res.ok) throw new Error('Failed to load conversations');
                conversationsList = await res.json();
                if (activeTab === 'conversations') {
                    renderConversations();
                }
            } catch (err) {
                console.error('[CONVERSATIONS FETCH ERROR]', err);
            }
        }

        // Render Conversations in Left Pane
        function renderConversations() {
            const container = document.getElementById('conversationsContainer');
            if (!container) return;

            // Calculate and display total unread messages count on the Recent tab
            const totalUnread = conversationsList.reduce((acc, c) => acc + (parseInt(c.unread, 10) || 0), 0);
            const totalBadge = document.getElementById('totalUnreadBadge');
            if (totalBadge) {
                if (totalUnread > 0) {
                    totalBadge.textContent = totalUnread > 99 ? '99+' : totalUnread;
                    totalBadge.classList.remove('hidden');
                } else {
                    totalBadge.classList.add('hidden');
                }
            }

            let filtered = conversationsList;
            if (searchQuery.trim().length > 0) {
                const q = searchQuery.toLowerCase();
                filtered = filtered.filter(c => (c.other_name || '').toLowerCase().includes(q));
            }

            if (filtered.length === 0) {
                container.innerHTML = `
                    <div class="py-12 px-6 text-center text-slate-400">
                        <div class="w-12 h-12 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-3 text-slate-400">
                            <i class="fas fa-inbox text-lg"></i>
                        </div>
                        <p class="text-xs font-bold text-slate-600">No Conversations Found</p>
                        <p class="text-[11px] text-slate-400 mt-1">Start chatting by browsing your class directory.</p>
                        <button type="button" onclick="switchMessagingTab('directory')" class="mt-3 text-xs font-bold text-cyan-600 hover:text-cyan-700 underline cursor-pointer">Browse Classmates</button>
                    </div>
                `;
                return;
            }

            let html = '';
            filtered.forEach(convo => {
                const isActive = (convo.other_user_id === currentPartnerId);
                const hasUnread = (convo.unread && convo.unread > 0);
                const isAdviser = (convo.contact_type === 'adviser' || convo.other_role === 'teacher' || convo.other_role === 'Teacher');
                const roleBadge = isAdviser 
                    ? `<span class="text-[9px] font-black uppercase px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">Adviser</span>`
                    : `<span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-slate-100 text-slate-600">Peer</span>`;
                
                const timeStr = formatTimestamp(convo.sent_at);

                html += `
                    <div class="convo-item p-3.5 hover:bg-slate-50 transition cursor-pointer flex items-center gap-3 ${isActive ? 'is-active-convo' : ''}"
                         onclick="selectConversationFromList(${convo.other_user_id})">
                        <div class="relative shrink-0">
                            <img src="${convo.other_pic ? '/profile_uploads/' + convo.other_pic : '/profile_uploads/default_avatar.png'}"
                                 alt="${escapeHtml(convo.other_name)}"
                                 class="w-11 h-11 rounded-xl object-cover ring-2 ring-slate-100"
                                 onerror="this.src='/profile_uploads/default_avatar.png'">
                            ${hasUnread ? `<span class="absolute -top-1 -right-1 w-3.5 h-3.5 bg-rose-500 rounded-full border-2 border-white animate-pulse"></span>` : ''}
                        </div>
                        <div class="min-w-0 flex-1">
                            <div class="flex items-center justify-between gap-1 mb-1">
                                <div class="flex items-center gap-1.5 truncate">
                                    <h4 class="text-xs font-black text-slate-800 truncate">${escapeHtml(convo.other_name)}</h4>
                                    ${roleBadge}
                                </div>
                                <span class="text-[10px] text-slate-400 shrink-0 font-medium">${timeStr}</span>
                            </div>
                            <div class="flex items-center justify-between gap-2">
                                <p class="text-xs ${hasUnread ? 'font-bold text-slate-900' : 'text-slate-500'} truncate">
                                    ${escapeHtml(formatMessagePreview(convo.last_message))}
                                </p>
                                ${hasUnread ? `<span class="px-1.5 py-0.5 rounded-full bg-cyan-600 text-white font-bold text-[10px] shrink-0">${convo.unread}</span>` : ''}
                            </div>
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        // 3. Fetch Authorized Contacts Directory
        async function fetchContacts(forceShowLoader = false) {
            const reqId = ++contactsRequestId;
            const container = document.getElementById('conversationsContainer');

            // Show loading indicator if on directory tab and either empty, forced, or filtering
            if (container && activeTab === 'directory' && (contactsList.length === 0 || forceShowLoader || searchQuery || selectedSubjectId)) {
                container.innerHTML = `
                    <div class="p-8 text-center text-slate-400 text-xs">
                        <i class="fas fa-circle-notch fa-spin text-xl text-cyan-500 mb-2"></i>
                        <p>Loading class directory...</p>
                    </div>
                `;
            }

            isLoadingContacts = true;
            try {
                let url = `/api/student/messaging/contacts?q=${encodeURIComponent(searchQuery)}`;
                if (selectedSubjectId) {
                    url += `&subject_id=${encodeURIComponent(selectedSubjectId)}`;
                }

                const res = await fetch(url);
                if (reqId !== contactsRequestId) return; // Discard stale response

                if (!res.ok) {
                    throw new Error(`Failed to load contacts (HTTP ${res.status})`);
                }

                const data = await res.json();
                if (reqId !== contactsRequestId) return;

                contactsList = Array.isArray(data.contacts) ? data.contacts : [];

                if (activeTab === 'directory') {
                    renderDirectory();
                }
            } catch (err) {
                if (reqId !== contactsRequestId) return;
                console.error('[CONTACTS FETCH ERROR]', err);

                // Render retry UI on failure instead of leaving indefinite loader
                if (activeTab === 'directory' && container) {
                    container.innerHTML = `
                        <div class="py-12 px-6 text-center text-slate-400">
                            <div class="w-12 h-12 rounded-2xl bg-rose-50 border border-rose-200 flex items-center justify-center mx-auto mb-3 text-rose-500">
                                <i class="fas fa-exclamation-triangle text-lg"></i>
                            </div>
                            <p class="text-xs font-bold text-slate-700">Unable to Load Class Directory</p>
                            <p class="text-[11px] text-slate-400 mt-1 max-w-xs mx-auto">There was an issue fetching your enrolled peers and instructors.</p>
                            <button type="button" onclick="fetchContacts(true)" class="mt-4 px-3.5 py-1.5 bg-cyan-600 hover:bg-cyan-700 text-white rounded-xl text-xs font-bold transition shadow-xs inline-flex items-center gap-1.5 cursor-pointer">
                                <i class="fas fa-rotate-right text-[10px]"></i>
                                <span>Try Again</span>
                            </button>
                        </div>
                    `;
                }
            } finally {
                if (reqId === contactsRequestId) {
                    isLoadingContacts = false;
                }
            }
        }

        // Render Class Directory in Left Pane
        function renderDirectory() {
            const container = document.getElementById('conversationsContainer');
            if (!container) return;

            if (contactsList.length === 0) {
                const isFiltered = (searchQuery.trim().length > 0) || Boolean(selectedSubjectId);
                const title = isFiltered ? 'No Matching Peers or Advisers' : 'No Enrolled Peers or Advisers Found';
                const subtext = isFiltered
                    ? 'Try clearing your search query or selecting a different enrolled subject filter.'
                    : 'Enrollment boundaries restrict directory discovery strictly to your active classes.';

                container.innerHTML = `
                    <div class="py-12 px-6 text-center text-slate-400">
                        <div class="w-12 h-12 rounded-2xl bg-slate-100 flex items-center justify-center mx-auto mb-3 text-slate-400">
                            <i class="fas fa-user-slash text-lg"></i>
                        </div>
                        <p class="text-xs font-bold text-slate-600">${escapeHtml(title)}</p>
                        <p class="text-[11px] text-slate-400 mt-1 max-w-xs mx-auto">${escapeHtml(subtext)}</p>
                        ${isFiltered ? `
                            <button type="button" onclick="resetDirectoryFilters()" class="mt-3 text-xs font-bold text-cyan-600 hover:text-cyan-700 underline cursor-pointer">
                                Reset Filters
                            </button>
                        ` : ''}
                    </div>
                `;
                return;
            }

            let html = '';
            contactsList.forEach(contact => {
                const isAdviser = (contact.contact_type === 'adviser' || contact.role === 'teacher' || contact.role === 'Teacher');
                const fullName = `${contact.first_name || ''} ${contact.last_name || ''}`.trim() || 'Classmate';
                const roleBadge = isAdviser 
                    ? `<span class="text-[9px] font-black uppercase px-1.5 py-0.5 rounded bg-amber-50 text-amber-700 border border-amber-200">Course Adviser</span>`
                    : `<span class="text-[9px] font-bold uppercase px-1.5 py-0.5 rounded bg-cyan-50 text-cyan-700 border border-cyan-200">Classmate</span>`;

                html += `
                    <div class="p-3.5 hover:bg-slate-50 transition cursor-pointer flex items-center justify-between gap-3"
                         onclick="startChatWithContact(${contact.user_id})">
                        <div class="flex items-center gap-3 min-w-0">
                            <img src="${contact.profile_pic ? '/profile_uploads/' + contact.profile_pic : '/profile_uploads/default_avatar.png'}"
                                 alt="${escapeHtml(fullName)}"
                                 class="w-10 h-10 rounded-xl object-cover ring-2 ring-slate-100 shrink-0"
                                 onerror="this.src='/profile_uploads/default_avatar.png'">
                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5">
                                    <h4 class="text-xs font-black text-slate-800 truncate">${escapeHtml(fullName)}</h4>
                                </div>
                                <div class="flex items-center gap-2 mt-0.5">
                                    ${roleBadge}
                                    <span class="text-[10px] text-slate-400 truncate max-w-[140px] font-medium" title="${escapeHtml(contact.shared_classes || contact.shared_subjects || '')}">
                                        ${escapeHtml(contact.shared_classes || contact.shared_subjects || 'Shared Class')}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <button type="button" class="p-2 rounded-xl bg-cyan-50 hover:bg-cyan-600 text-cyan-600 hover:text-white transition shrink-0 cursor-pointer text-xs" title="Chat with ${escapeHtml(fullName)}">
                            <i class="fas fa-comment-dots"></i>
                        </button>
                    </div>
                `;
            });

            container.innerHTML = html;
        }

        function resetDirectoryFilters() {
            clearContactSearch();
            selectedSubjectId = '';
            const pills = document.querySelectorAll('.subject-filter-chip');
            pills.forEach((p, idx) => {
                if (idx === 0) {
                    p.classList.add('active', 'bg-cyan-600', 'text-white');
                    p.classList.remove('bg-slate-100', 'text-slate-600');
                } else {
                    p.classList.remove('active', 'bg-cyan-600', 'text-white');
                    p.classList.add('bg-slate-100', 'text-slate-600');
                }
            });
            fetchContacts(true);
        }

        // 4. Select / Open Chat Thread
        function selectConversationFromList(partnerId) {
            const convo = conversationsList.find(c => c.other_user_id === partnerId);
            if (!convo) return;
            openChatThread({
                user_id: convo.other_user_id,
                first_name: convo.other_name.split(' ')[0],
                last_name: convo.other_name.split(' ').slice(1).join(' '),
                profile_pic: convo.other_pic,
                role: convo.other_role,
                contact_type: convo.contact_type,
                section: convo.other_section,
                grade_level: convo.other_grade_level,
                strand: convo.other_strand,
                department: convo.other_department,
                sent_at: convo.sent_at,
                shared_classes: convo.shared_classes || ''
            });
        }

        function startChatWithContact(contactId) {
            const contact = contactsList.find(c => c.user_id === contactId);
            if (!contact) return;
            openChatThread(contact);
        }

        function openChatThread(partner) {
            currentPartnerId = partner.user_id;
            currentPartner = partner;
            lastPollTimestamp = null;
            inChatSearchQuery = '';

            // Reset new messages floating badge
            const badge = document.getElementById('newMessagesBadge');
            if (badge) badge.classList.add('hidden');

            // Update URL without reloading page
            const url = new URL(window.location);
            url.searchParams.set('userId', partner.user_id);
            window.history.replaceState({}, '', url);

            // Responsive view switch for mobile
            if (window.innerWidth < 768) {
                document.getElementById('chatSidebar')?.classList.add('hidden');
                document.getElementById('chatMain')?.classList.remove('hidden');
            }

            // Show active chat pane, hide empty placeholder
            document.getElementById('noChatSelected')?.classList.add('hidden');
            document.getElementById('activeChatContainer')?.classList.remove('hidden');

            // Set Partner Header Metadata
            const partnerName = `${partner.first_name} ${partner.last_name}`;
            document.getElementById('partnerHeaderName').textContent = partnerName;
            
            const avatarEl = document.getElementById('partnerHeaderAvatar');
            if (avatarEl) {
                avatarEl.src = partner.profile_pic ? '/profile_uploads/' + partner.profile_pic : '/profile_uploads/default_avatar.png';
            }

            const isAdviser = (partner.contact_type === 'adviser' || partner.role === 'teacher');
            const roleBadgeEl = document.getElementById('partnerHeaderRoleBadge');
            if (roleBadgeEl) {
                roleBadgeEl.textContent = isAdviser ? 'Course Adviser' : 'Classmate';
                roleBadgeEl.className = isAdviser 
                    ? 'text-[9px] font-black uppercase px-2 py-0.5 rounded-md bg-amber-50 text-amber-700 border border-amber-200' 
                    : 'text-[9px] font-black uppercase px-2 py-0.5 rounded-md bg-cyan-50 text-cyan-700 border border-cyan-200';
            }

            const sharedClassEl = document.getElementById('partnerHeaderSharedClasses');
            if (sharedClassEl) {
                sharedClassEl.textContent = partner.shared_classes || partner.shared_subjects || 'Enrolled Course';
            }

            // Prepopulate conversation info panel details
            updateConversationInfoPanel();

            // Render loading in message stream
            const stream = document.getElementById('messageStream');
            if (stream) {
                stream.innerHTML = `
                    <div class="p-8 text-center text-slate-400 text-xs">
                        <i class="fas fa-circle-notch fa-spin text-xl text-cyan-500 mb-2"></i>
                        <p>Loading messages...</p>
                    </div>
                `;
            }

            // Fetch thread messages
            fetchMessages(partner.user_id, true);

            // Focus message composer input
            setTimeout(() => {
                document.getElementById('messageInput')?.focus();
            }, 100);

            // Re-render conversations list so active highlight updates
            if (activeTab === 'conversations') {
                renderConversations();
            }
        }

        // Mobile back button to conversations list
        function closeActiveChatMobile() {
            toggleConversationInfo(false);
            document.getElementById('chatMain')?.classList.add('hidden');
            document.getElementById('chatSidebar')?.classList.remove('hidden');
        }

        // 5. Fetch Messages Thread (Initial History Load)
        async function fetchMessages(partnerId, forceScroll = false) {
            if (!partnerId) return;

            try {
                const readParam = isReadReceiptsEnabled() ? '' : '?markRead=false';
                const res = await fetch(`/api/messages/${partnerId}${readParam}`);
                if (res.status === 403) {
                    const data = await res.json();
                    renderAccessDenied(data.error || 'Access Denied: You can only communicate with peers sharing your enrolled classes.');
                    return;
                }
                if (!res.ok) throw new Error('Failed to fetch messages');

                const messages = await res.json();
                
                // Compare with currentMessages to prevent unnecessary re-renders
                const hasChanged = (messages.length !== currentMessages.length) || 
                                   (messages.length > 0 && currentMessages.length > 0 && messages[messages.length - 1].message_id !== currentMessages[currentMessages.length - 1].message_id);

                if (hasChanged || forceScroll) {
                    currentMessages = messages;
                    lastPollTimestamp = messages.length > 0 ? messages[messages.length - 1].sent_at : new Date().toISOString();
                    renderMessages(messages, forceScroll);
                    updateConversationInfoPanel();
                }

                // If conversation had unread count, reset it locally and in left list
                const convo = conversationsList.find(c => c.other_user_id === partnerId);
                if (convo && convo.unread > 0) {
                    convo.unread = 0;
                    if (activeTab === 'conversations') renderConversations();
                }
                if (window.NotificationHub) {
                    window.NotificationHub.updateBadge();
                }

                const badge = document.getElementById('newMessagesBadge');
                if (badge && forceScroll) badge.classList.add('hidden');

            } catch (err) {
                console.error('[MESSAGES FETCH ERROR]', err);
            }
        }

        // 5b. Delta Polling Engine for Live Message Delivery
        async function pollDeltaMessages() {
            if (!currentPartnerId || isPolling) return;
            if (!lastPollTimestamp) {
                return fetchMessages(currentPartnerId, false);
            }

            isPolling = true;
            try {
                const readParam = isReadReceiptsEnabled() ? '' : '&markRead=false';
                const url = `/api/student/messaging/poll?partnerId=${currentPartnerId}&since=${encodeURIComponent(lastPollTimestamp)}${readParam}`;
                const res = await fetch(url);

                if (res.status === 403) {
                    const data = await res.json();
                    renderAccessDenied(data.error || 'Access Denied: Enrollment boundary mismatch.');
                    return;
                }
                if (!res.ok) return;

                const data = await res.json();
                const newMsgs = data.messages || [];

                if (newMsgs.length > 0) {
                    const stream = document.getElementById('messageStream');
                    const streamWasNearBottom = stream ? (stream.scrollHeight - stream.scrollTop - stream.clientHeight) < 120 : true;

                    let appended = false;
                    newMsgs.forEach(m => {
                        const existingIdx = currentMessages.findIndex(cur => 
                            cur.message_id === m.message_id || 
                            (String(cur.message_id).startsWith('temp-') && cur.sender_id === m.sender_id && cur.message_text === m.message_text)
                        );
                        if (existingIdx !== -1) {
                            currentMessages[existingIdx] = m;
                        } else {
                            currentMessages.push(m);
                            appended = true;
                        }
                    });

                    lastPollTimestamp = newMsgs[newMsgs.length - 1].sent_at;
                    renderMessages(currentMessages, false);
                    updateConversationInfoPanel();

                    if (streamWasNearBottom) {
                        scrollToStreamBottom();
                    } else if (appended) {
                        const badge = document.getElementById('newMessagesBadge');
                        if (badge) badge.classList.remove('hidden');
                    }

                    // Refresh left conversations preview
                    fetchConversations();
                }
            } catch (err) {
                console.warn('[DELTA POLL WARNING]', err.message);
            } finally {
                isPolling = false;
            }
        }

        function scrollToStreamBottom() {
            const stream = document.getElementById('messageStream');
            if (stream) {
                stream.scrollTo({ top: stream.scrollHeight, behavior: 'smooth' });
            }
            const badge = document.getElementById('newMessagesBadge');
            if (badge) badge.classList.add('hidden');
        }

        function refreshCurrentThread() {
            if (currentPartnerId) {
                fetchMessages(currentPartnerId, true);
            }
        }

