<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Subjects | Elementa Chemistry</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        
        .glass-effect {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(8px);
        }

        /* Unified Card Styling */
        .app-card {
            transition: transform 0.2s cubic-bezier(0.4, 0, 0.2, 1), box-shadow 0.2s cubic-bezier(0.4, 0, 0.2, 1);
        }
        .app-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px -5px rgba(15, 23, 42, 0.08), 0 8px 10px -6px rgba(15, 23, 42, 0.04);
        }

        .category-badge {
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.05em;
            text-transform: uppercase;
            padding: 2px 10px;
            border-radius: 9999px;
        }

        .sim-hidden { display: none !important; }
    </style>

    <!-- Standardized Student Navigation & Responsive Styles -->
    <%- include('partials/student-nav-styles') %>
</head>
<body class="bg-gradient-to-br from-slate-50 via-white to-indigo-50/30 text-slate-900 min-h-screen">

    <div class="flex min-h-screen relative overflow-x-hidden">
        <!-- Standardized Student Sidebar Partial -->
        <%- include('partials/student-sidebar', { activeNav: 'subjects' }) %>

        <!-- Main Content Area -->
        <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">
            <!-- App Header -->
            <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    <div>
                        <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">
                            Welcome, <%= user.first_name %>!
                        </h1>
                        <p class="text-xs text-slate-600 hidden sm:block font-medium">
                            <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                            Chemistry Enthusiast &nbsp;·&nbsp; <%= new Date().toLocaleDateString('en-PH', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3 md:gap-6">
                    <!-- Messages Navigation Button (Entry point to message-student view) -->
                    <a href="/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                        <i class="far fa-comment-dots text-xl"></i>
                        
                        <!-- Tooltip with keyboard and hover accessibility -->
                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Messages
                        </span>
                    </a>

                    <!-- Notification Button with keyboard-accessible tooltip -->
                    <button type="button" onclick="toggleNotifications()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                        <i class="far fa-bell text-xl text-slate-700"></i>
                        
                        <span class="absolute top-2 right-2 flex h-2.5 w-2.5 notif-badge hidden" aria-hidden="true">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500 border-2 border-white"></span>
                        </span>

                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Notifications
                        </span>
                    </button>
                    
                    <!-- User Profile Dropdown -->
                    <div class="relative">
                        <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                            <div class="text-right hidden lg:block">
                                <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                                <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none"><%= user.role %></p>
                            </div>
                            <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100">
                            <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                        </button>

                        <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                            <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                                <p class="text-sm font-bold text-slate-800"><%= user.first_name %> <%= user.last_name %></p>
                                <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role %></p>
                            </div>
                            <a href="/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                                <i class="far fa-user w-5 text-center"></i> View Profile
                            </a>
                            <hr class="my-2 border-slate-100">
                            <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                                <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- Scrollable Content -->
            <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
                <div class="p-4 md:p-8 flex-1">
                
                    <!-- Primary Page Header (Real <h1> for Screen Readers & Document Outline) -->
                    <div class="mb-8">
                        <h1 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
                            <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-gradient-to-br from-cyan-500 to-indigo-600 text-white shadow-md">
                                <i class="fas fa-book text-lg"></i>
                            </span>
                            My Enrolled Subjects
                        </h1>
                        <p class="text-slate-600 text-sm mt-1">Manage and access your course materials, activities, and virtual labs.</p>
                    </div>

                    <!-- Enrolled Subjects Grid -->
                    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-12">
                        <% if (subjects && subjects.length > 0) { %>
                            <% subjects.forEach(subject => { 
                                const displayImg = (subject.subject_image && subject.subject_image !== 'default_subject.png') 
                                                ? subject.subject_image 
                                                : 'default_subject.png'; 
                            %>
                                <div class="app-card bg-white rounded-3xl border border-slate-200/80 overflow-hidden shadow-sm flex flex-col group">
                                    <!-- Subject Header Image -->
                                    <div class="relative h-44 overflow-hidden bg-slate-900">
                                        <img src="/profile_uploads/<%= displayImg %>" 
                                             alt="<%= subject.subject_name %>"
                                             class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 opacity-80"
                                             onerror="this.onerror=null; this.src='/profile_uploads/default_subject.png';">
                                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/80 via-slate-950/20 to-transparent"></div>
                                        <div class="absolute bottom-4 left-4">
                                            <span class="px-3 py-1 bg-cyan-600 text-white text-xs font-black uppercase tracking-wider rounded-lg shadow-sm border border-cyan-400/30">
                                                <%= subject.subject_code %>
                                            </span>
                                        </div>
                                    </div>

                                    <!-- Subject Content -->
                                    <div class="p-6 flex flex-col flex-1">
                                        <div class="mb-2">
                                            <h2 class="font-extrabold text-slate-800 text-lg leading-snug group-hover:text-cyan-700 transition-colors">
                                                <%= subject.subject_name %>
                                            </h2>
                                        </div>
                                        
                                        <p class="text-slate-600 text-xs leading-relaxed line-clamp-2 mb-4">
                                            <%= subject.description || 'No course description available.' %>
                                        </p>

                                        <div class="space-y-2.5 mb-6 mt-auto">
                                            <div class="flex items-center gap-2.5 text-slate-600">
                                                <i class="fas fa-chalkboard-teacher w-4 text-cyan-600 text-sm"></i>
                                                <span class="text-xs font-semibold"><%= subject.teacher_name || 'Instructor' %></span>
                                            </div>
                                            <div class="flex items-center gap-2.5 text-slate-600">
                                                <i class="far fa-calendar-alt w-4 text-indigo-500 text-sm"></i>
                                                <span class="text-xs font-semibold">SY <%= subject.sy_range %> &bull; <%= subject.semester == 1 ? '1st Semester' : (subject.semester == 2 ? '2nd Semester' : (subject.semester ? 'Semester ' + subject.semester : 'Active Semester')) %></span>
                                            </div>
                                        </div>

                                        <!-- Open Subject CTA Button (Dedicated clean style, no broken nav-active class) -->
                                        <a href="/subjects/open/<%= subject.subject_id %>" 
                                           class="block w-full text-center py-3 bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-600 hover:to-indigo-700 text-white font-bold rounded-2xl shadow-sm hover:shadow-md transition-all duration-200 text-sm focus-visible:ring-2 focus-visible:ring-cyan-400">
                                            Open Subject
                                        </a>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="col-span-full py-16 text-center bg-white rounded-3xl border border-dashed border-slate-200 p-8">
                                <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto mb-3 text-slate-400">
                                    <i class="fas fa-book-open text-2xl"></i>
                                </div>
                                <h2 class="text-base font-bold text-slate-800">No subjects found</h2>
                                <p class="text-slate-500 text-xs mt-1">You are not enrolled in any subjects yet.</p>
                            </div>
                        <% } %>
                    </div>

                    <!-- ===================== SIMULATIONS SECTION ===================== -->
                    <section class="pb-8" id="simulations-section" aria-label="Interactive Science Simulations">
                        <!-- Section Header -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
                            <div>
                                <h2 class="text-2xl md:text-3xl font-extrabold text-slate-900 tracking-tight flex items-center gap-3">
                                    <span class="inline-flex items-center justify-center w-11 h-11 rounded-2xl bg-gradient-to-br from-cyan-500 to-indigo-600 text-white shadow-md">
                                        <i class="fas fa-atom text-lg"></i>
                                    </span>
                                    Elementa Simulations
                                </h2>
                                <p class="text-slate-600 text-sm mt-1">Explore chemistry & science concepts through Elementa's interactive virtual laboratories.</p>
                            </div>
                            <button onclick="toggleAllSimulations()" id="sim-toggle-btn"
                                aria-expanded="false"
                                class="flex items-center gap-2 px-5 py-2.5 bg-gradient-to-r from-cyan-500 to-indigo-600 text-white font-bold rounded-2xl shadow-sm hover:shadow-md hover:from-cyan-600 hover:to-indigo-700 transition-all text-sm whitespace-nowrap focus-visible:ring-2 focus-visible:ring-cyan-400">
                                <i class="fas fa-chevron-down text-xs" id="sim-toggle-icon"></i>
                                <span id="sim-toggle-label">Show All Simulations</span>
                            </button>
                        </div>

                        <!-- Search & Filter Bar (Accessible with hidden labels and visible focus rings) -->
                        <div class="flex flex-col sm:flex-row gap-3 mb-8">
                            <div class="relative flex-1">
                                <label for="sim-search" class="sr-only">Search simulations by title or concept</label>
                                <i class="fas fa-search absolute left-4 top-1/2 -translate-y-1/2 text-slate-400 text-sm" aria-hidden="true"></i>
                                <input type="text" id="sim-search" oninput="filterSimulations()"
                                    placeholder="Search simulations (e.g., Atom, Balancing, pH, States, Molarity)..."
                                    aria-label="Search simulations"
                                    class="w-full pl-11 pr-4 py-2.5 bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-cyan-500 outline-none text-sm font-medium shadow-xs transition-all">
                            </div>
                            <div class="sm:w-72">
                                <label for="sim-category-filter" class="sr-only">Filter simulations by topic</label>
                                <select id="sim-category-filter" onchange="filterSimulations()"
                                    aria-label="Filter simulations by topic"
                                    class="w-full px-4 py-2.5 bg-white border border-slate-200 rounded-2xl focus:ring-2 focus:ring-cyan-500 outline-none text-sm font-bold text-slate-700 shadow-xs cursor-pointer">
                                    <option value="all">All Topics</option>
                                    <option value="Atomic Structure & Quantum Models">Atomic Structure & Quantum Models</option>
                                    <option value="Chemical Bonding & Molecular Structure">Chemical Bonding & Molecular Structure</option>
                                    <option value="Chemical Reactions & Stoichiometry">Chemical Reactions & Stoichiometry</option>
                                    <option value="Solutions & Acid-Base Chemistry">Solutions & Acid-Base Chemistry</option>
                                    <option value="States of Matter & Thermodynamics">States of Matter & Thermodynamics</option>
                                    <option value="Quantum Chemistry & Light Interactions">Quantum Chemistry & Light Interactions</option>
                                </select>
                            </div>
                        </div>

                        <!-- Empty State for Search / Filter -->
                        <div id="sim-no-results" class="hidden py-16 text-center bg-white rounded-3xl border border-dashed border-slate-200 p-8">
                            <div class="w-16 h-16 bg-slate-50 rounded-2xl flex items-center justify-center mx-auto mb-3 text-slate-400">
                                <i class="fas fa-search text-2xl"></i>
                            </div>
                            <h3 class="text-base font-bold text-slate-800">No simulations found</h3>
                            <p class="text-slate-500 text-xs mt-1">Try searching with another keyword or resetting the topic filter.</p>
                        </div>

                        <!-- Simulations Grid (Static Screenshots for Fast Performance & Zero Background Freezes) -->
                        <div id="sim-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6"></div>

                        <!-- Show More / Show Less Toggle (Bottom) -->
                        <div id="sim-bottom-toggle" class="mt-8 text-center hidden">
                            <button onclick="toggleAllSimulations()"
                                class="inline-flex items-center gap-2 px-6 py-2.5 border border-slate-300 hover:border-cyan-500 bg-white hover:bg-slate-50 text-slate-700 hover:text-cyan-700 font-bold rounded-2xl shadow-xs transition-all text-sm focus-visible:ring-2 focus-visible:ring-cyan-400">
                                <i class="fas fa-chevron-up text-xs" id="sim-bottom-icon"></i>
                                <span id="sim-bottom-label">Show Less</span>
                            </button>
                        </div>
                    </section>
                </div>
            
                <!-- Footer -->
                <footer class="mt-auto py-6 px-8 border-t border-slate-200 bg-white/70">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                        <div class="text-center md:text-left">
                            <p class="text-sm text-slate-600 font-medium">
                                &copy; 2026 <span class="text-blue-600 font-bold">Mabini College</span>. All rights reserved.
                            </p>
                            <p class="text-xs text-slate-500 uppercase tracking-widest mt-1 font-semibold">
                                System Version 2.4.0-stable
                            </p>
                        </div>

                        <div class="flex flex-wrap justify-center gap-6">
                            <a href="/privacy" class="text-xs font-bold text-slate-600 hover:text-blue-600 transition">Privacy Policy</a>
                            <a href="/terms" class="text-xs font-bold text-slate-600 hover:text-blue-600 transition">Terms of Service</a>
                            <a href="/support" class="text-xs font-bold text-slate-600 hover:text-blue-600 transition flex items-center gap-1">
                                <i class="far fa-question-circle"></i> Help & Support
                            </a>
                        </div>
                    </div>
                </footer>
            </div>
        </main>
    </div>

    <!-- Notification Overlay & Drawer -->
    <div id="notification-overlay" 
         onclick="toggleNotifications()" 
         class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[60] hidden transition-opacity duration-300 opacity-0">
    </div>

    <div id="notification-panel" 
         class="fixed top-0 right-0 h-screen w-80 md:w-96 bg-white shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-200 flex flex-col"
         role="dialog"
         aria-label="Notifications Panel">
        
        <div class="p-5 border-b flex justify-between items-center bg-blue-600 text-white flex-shrink-0">
            <div>
                <h2 class="text-lg font-bold flex items-center gap-2">
                    <i class="far fa-bell"></i> Notifications
                </h2>
                <p id="notifSubtitle" class="text-xs text-blue-100 font-medium">Activity updates</p>
            </div>
            <div class="flex items-center gap-2">
                <button onclick="NotificationHub.markAllRead('notification-list')" aria-label="Mark all notifications as read" title="Mark all as read" class="hover:bg-blue-700 text-blue-100 hover:text-white p-2 rounded-lg transition text-xs font-bold flex items-center gap-1 focus-visible:ring-2 focus-visible:ring-white">
                    <i class="fas fa-check-double text-sm"></i>
                </button>
                <button onclick="toggleNotifications()" aria-label="Close notifications panel" class="hover:bg-blue-700 p-2 rounded-lg transition focus-visible:ring-2 focus-visible:ring-white">
                    <i class="fas fa-times text-xl"></i>
                </button>
            </div>
        </div>

        <div class="flex-1 overflow-y-auto p-4 space-y-3 bg-slate-50 no-scrollbar" id="notification-list">
            <div id="notification-loader" class="flex flex-col items-center justify-center h-full text-slate-500">
                <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-2"></div>
                <p class="text-xs font-bold uppercase tracking-wider">Loading Updates...</p>
            </div>
        </div>
    </div>

    <!-- Elementa Interactive Simulation Runner Modal -->
    <div id="simRunnerModal" class="fixed inset-0 z-[100] bg-slate-950/90 backdrop-blur-md hidden items-center justify-center p-1 sm:p-3 cursor-pointer"
         role="dialog" aria-modal="true" aria-labelledby="simModalTitle" onclick="if(event.target === this) closeSimModal()">
        <div id="simModalDialog" class="bg-slate-900 border border-slate-700/80 rounded-2xl sm:rounded-3xl w-full h-[96vh] max-w-[1750px] 2xl:max-w-[1900px] flex flex-col shadow-2xl overflow-hidden animate-fadeIn cursor-default transition-all duration-200">
            <!-- Mobile Landscape Tip Banner -->
            <div class="sm:hidden bg-indigo-950/90 text-indigo-200 text-[11px] font-semibold py-1.5 px-3 text-center border-b border-indigo-800/50 flex items-center justify-center gap-1.5 shrink-0">
                <i class="fas fa-rotate text-xs"></i> Rotate device to landscape for the best interactive simulation experience.
            </div>

            <!-- Modal Header -->
            <div class="px-4 py-2.5 bg-slate-950 border-b border-slate-800 flex items-center justify-between flex-shrink-0 gap-3">
                <div class="flex items-center gap-2.5 min-w-0">
                    <span class="w-8 h-8 rounded-xl bg-cyan-500/20 text-cyan-400 flex items-center justify-center font-bold text-xs flex-shrink-0">
                        <i class="fas fa-atom text-sm"></i>
                    </span>
                    <div class="min-w-0 flex items-center gap-2">
                        <h3 id="simModalTitle" class="text-white text-sm sm:text-base font-bold truncate">Elementa Simulation Viewer</h3>
                        <span id="simModalCategoryBadge" class="hidden sm:inline-block text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-800 text-cyan-400 border border-slate-700/60 truncate"></span>
                    </div>
                </div>
                <div class="flex items-center gap-1.5 sm:gap-2 flex-shrink-0">
                    <button type="button" onclick="reloadSimModal()" 
                            class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 hover:text-white text-xs font-bold rounded-xl transition flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-cyan-400" 
                            title="Reset / Reload simulation">
                        <i class="fas fa-redo text-xs"></i> <span class="hidden sm:inline">Reset</span>
                    </button>
                    <button type="button" id="simModalFullscreenBtn" onclick="toggleSimModalFullscreen()" 
                            class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold rounded-xl transition flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-cyan-400" 
                            title="Toggle Fullscreen">
                        <i class="fas fa-expand text-xs" id="simModalFullscreenIcon"></i> <span class="hidden sm:inline" id="simModalFullscreenLabel">Fullscreen</span>
                    </button>
                    <a id="simModalExternalLink" href="#" target="_blank" rel="noopener noreferrer" 
                       class="px-2.5 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold rounded-xl transition flex items-center gap-1.5 focus-visible:ring-2 focus-visible:ring-cyan-400" 
                       title="Open full page in new tab">
                        <i class="fas fa-external-link-alt text-xs"></i> <span class="hidden sm:inline">New Tab</span>
                    </a>
                    <button type="button" onclick="closeSimModal()" aria-label="Close simulation" 
                            class="w-8 h-8 rounded-xl bg-slate-800 hover:bg-rose-600 text-slate-400 hover:text-white flex items-center justify-center transition focus-visible:ring-2 focus-visible:ring-rose-400"
                            title="Close (Esc)">
                        <i class="fas fa-times text-sm"></i>
                    </button>
                </div>
            </div>

            <!-- Modal Body: Pixel-Perfect Fitting Iframe Container -->
            <div class="flex-1 w-full h-full min-h-0 min-w-0 bg-slate-950 relative overflow-hidden flex items-center justify-center" id="simModalIframeContainer">
                <!-- Mounted on demand via openSimModal() -->
            </div>
        </div>
    </div>

    <script>
        function toggleNotifications() {
            const panel = document.getElementById('notification-panel');
            const overlay = document.getElementById('notification-overlay');

            if (!panel || !overlay) return;

            if (panel.classList.contains('translate-x-full')) {
                panel.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.add('opacity-100'), 10);
                if (window.NotificationHub) {
                    NotificationHub.loadNotifications('notification-list', false);
                }
            } else {
                panel.classList.add('translate-x-full');
                overlay.classList.remove('opacity-100');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function formatTimeAgo(dateString) {
            if (!dateString) return '';
            const now = new Date();
            const past = new Date(dateString);
            const diffInMs = now - past;
            const diffInMins = Math.floor(diffInMs / 60000);
            
            if (diffInMins < 0) return 'Upcoming';
            if (diffInMins < 1) return 'Just now';
            if (diffInMins < 60) return `${diffInMins}m ago`;
            const diffInHours = Math.floor(diffInMins / 60);
            if (diffInHours < 24) return `${diffInHours}h ago`;
            return past.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }

        // Functional sidebar collapse for desktop and mobile
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const main = document.getElementById('mainContent');
            const header = document.querySelector('header');
            
            if (window.innerWidth < 768) {
                sidebar.classList.toggle('sidebar-open');
                sidebar.classList.toggle('sidebar-collapsed');
                overlay.classList.toggle('hidden');
            } else {
                sidebar.classList.toggle('sidebar-collapsed');
                if (main) main.classList.toggle('sidebar-collapsed-main');
                if (header) header.classList.toggle('sidebar-collapsed-header');
            }
        }

        function toggleUserMenu(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('userMenuBtn');
            const isExpanded = !dropdown.classList.contains('hidden');
            dropdown.classList.toggle('hidden');
            btn.setAttribute('aria-expanded', !isExpanded);
        }

        window.addEventListener('click', function() {
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('userMenuBtn');
            if (dropdown && !dropdown.classList.contains('hidden')) {
                dropdown.classList.add('hidden');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
        });

        window.addEventListener('resize', () => {
            const sidebar = document.getElementById('sidebar');
            const main = document.getElementById('mainContent');
            const header = document.querySelector('header');
            if (window.innerWidth >= 768) {
