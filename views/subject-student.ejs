        // Semantic Category Styling
        const CATEGORY_COLORS = {
            "Atomic Structure & Quantum Models":      { bg: "bg-cyan-100",    text: "text-cyan-800" },
            "Chemical Bonding & Molecular Structure": { bg: "bg-indigo-100",  text: "text-indigo-800" },
            "Chemical Reactions & Stoichiometry":     { bg: "bg-emerald-100", text: "text-emerald-800" },
            "Solutions & Acid-Base Chemistry":        { bg: "bg-amber-100",   text: "text-amber-800" },
            "States of Matter & Thermodynamics":      { bg: "bg-blue-100",    text: "text-blue-800" },
            "Quantum Chemistry & Light Interactions": { bg: "bg-purple-100",  text: "text-purple-800" }
        };

        const DEFAULT_VISIBLE = 8;
        let showAll = false;

        // Build cards using official high-resolution screenshots with graceful fallback
        function buildSimCards(sims) {
            return sims.map(sim => {
                const col = CATEGORY_COLORS[sim.category] || { bg: "bg-slate-100", text: "text-slate-700" };
                const slug = sim.slug || 'build-an-atom';
                const thumbUrl = sim.thumb || `/images/simulations/${slug}.png`;

                return `
                <div class="app-card bg-white rounded-3xl border border-slate-200/80 overflow-hidden shadow-sm flex flex-col sim-card"
                     data-id="${sim.id}"
                     data-title="${sim.title.toLowerCase()}"
                     data-category="${sim.category}">
                    
                    <!-- Static High-Resolution Thumbnail Header (Zero WebGL memory consumption) -->
                    <div class="relative h-40 bg-slate-900 overflow-hidden group/thumb cursor-pointer" onclick="openSimModal(${sim.id})">
                        <img src="${thumbUrl}" 
                             alt="Preview of ${sim.title}" 
                             loading="lazy"
                             class="w-full h-full object-cover group-hover/thumb:scale-105 transition-transform duration-300 opacity-90"
                             onerror="this.onerror=null; this.src='/assets/logo.png'; this.className='w-16 h-16 mx-auto my-12 object-contain opacity-40';">
                        
                        <div class="absolute inset-0 bg-slate-950/20 group-hover/thumb:bg-slate-950/45 transition-all flex items-center justify-center">
                            <div class="w-12 h-12 rounded-2xl bg-white/95 text-cyan-600 flex items-center justify-center shadow-lg group-hover/thumb:scale-110 group-hover/thumb:bg-cyan-500 group-hover/thumb:text-white transition-all">
                                <i class="fas fa-play text-sm ml-0.5"></i>
                            </div>
                        </div>
                    </div>

                    <!-- Card Body -->
                    <div class="p-5 flex flex-col flex-1 gap-2">
                        <span class="category-badge ${col.bg} ${col.text} self-start font-bold text-[11px] px-2.5 py-1 rounded-full">${sim.category}</span>
                        <h3 class="font-extrabold text-slate-900 text-sm leading-snug">${sim.title}</h3>
                        <p class="text-slate-600 text-xs leading-relaxed flex-1">${sim.description}</p>
                        
                        <button type="button" 
                                onclick="openSimModal(${sim.id})"
                                class="mt-3 flex items-center justify-center gap-2 py-2.5 bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-600 hover:to-indigo-700 text-white font-bold rounded-xl text-xs transition-all shadow-xs hover:shadow focus-visible:ring-2 focus-visible:ring-cyan-400">
                            <i class="fas fa-play text-[10px]"></i> Launch Simulation
                        </button>
                    </div>
                </div>`;
            }).join('');
        }

        function renderSimulations() {
            const grid = document.getElementById('sim-grid');
            grid.innerHTML = buildSimCards(SIMULATIONS);
            applyVisibility();
        }

        function applyVisibility() {
            const search = document.getElementById('sim-search').value.toLowerCase().trim();
            const category = document.getElementById('sim-category-filter').value;
            const cards = document.querySelectorAll('.sim-card');
            let visibleCount = 0;

            cards.forEach((card) => {
                const title = card.dataset.title;
                const cat = card.dataset.category;
                const matchSearch = !search || title.includes(search);
                const matchCat = category === 'all' || cat === category;
                const isFiltering = search || category !== 'all';

                if (matchSearch && matchCat) {
                    const shouldShow = isFiltering || showAll || visibleCount < DEFAULT_VISIBLE;
                    if (shouldShow) {
                        card.classList.remove('sim-hidden');
                        visibleCount++;
                    } else {
                        card.classList.add('sim-hidden');
                    }
                } else {
                    card.classList.add('sim-hidden');
                }
            });

            // Count matches
            const totalMatching = [...cards].filter(c => {
                const matchSearch = !search || c.dataset.title.includes(search);
                const matchCat = category === 'all' || c.dataset.category === category;
                return matchSearch && matchCat;
            }).length;

            document.getElementById('sim-no-results').classList.toggle('hidden', totalMatching > 0);

            // Bottom toggle display
            const isFiltering = search || category !== 'all';
            const bottomToggle = document.getElementById('sim-bottom-toggle');
            bottomToggle.classList.toggle('hidden', !showAll || isFiltering);

            // Single source of truth for simulation count
            const btn = document.getElementById('sim-toggle-btn');
            const icon = document.getElementById('sim-toggle-icon');
            const label = document.getElementById('sim-toggle-label');
            if (showAll || isFiltering) {
                icon.classList.replace('fa-chevron-down', 'fa-chevron-up');
                label.textContent = isFiltering ? `${totalMatching} Sim${totalMatching !== 1 ? 's' : ''} Found` : 'Show Less';
                btn.setAttribute('aria-expanded', 'true');
            } else {
                icon.classList.replace('fa-chevron-up', 'fa-chevron-down');
                label.textContent = `Show All ${SIMULATIONS.length} Sims`;
                btn.setAttribute('aria-expanded', 'false');
            }
        }

        function toggleAllSimulations() {
            showAll = !showAll;
            const bottomIcon = document.getElementById('sim-bottom-icon');
            const bottomLabel = document.getElementById('sim-bottom-label');
            if (showAll) {
                if (bottomIcon) bottomIcon.classList.replace('fa-chevron-up', 'fa-chevron-down');
                if (bottomLabel) bottomLabel.textContent = 'Show Less';
            } else {
                if (bottomIcon) bottomIcon.classList.replace('fa-chevron-down', 'fa-chevron-up');
                if (bottomLabel) bottomLabel.textContent = 'Show Less';
                document.getElementById('simulations-section').scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
            applyVisibility();
        }

        function filterSimulations() {
            applyVisibility();
        }

        let simResizeObserver = null;
        let isSimFullscreen = false;

        function fitSimIframe() {
            const container = document.getElementById('simModalIframeContainer');
            const iframe = document.getElementById('activeSimIframe');
            if (!container || !iframe) return;

            const cWidth = container.clientWidth;
            const cHeight = container.clientHeight;
            if (cWidth === 0 || cHeight === 0) return;

            // Ideal desktop design width for Elementa simulations (covers 440px sidebars + canvas)
            const TARGET_WIDTH = 1200;

            if (cWidth < TARGET_WIDTH) {
                // Viewport is narrower than the ideal simulation desktop width -> scale gracefully
                const scale = cWidth / TARGET_WIDTH;
                const scaledHeight = cHeight / scale;
                iframe.style.width = `${TARGET_WIDTH}px`;
                iframe.style.height = `${scaledHeight}px`;
                iframe.style.transform = `scale(${scale})`;
                iframe.style.transformOrigin = 'top left';
                iframe.style.position = 'absolute';
                iframe.style.top = '0';
                iframe.style.left = '0';
            } else {
                // Viewport is ample -> 100% natural resolution
                iframe.style.width = '100%';
                iframe.style.height = '100%';
                iframe.style.transform = 'none';
                iframe.style.position = 'relative';
                iframe.style.top = 'auto';
                iframe.style.left = 'auto';
            }
        }

        function toggleSimModalFullscreen() {
            const dialog = document.getElementById('simModalDialog');
            const icon = document.getElementById('simModalFullscreenIcon');
            const label = document.getElementById('simModalFullscreenLabel');
            if (!dialog) return;

            isSimFullscreen = !isSimFullscreen;
            if (isSimFullscreen) {
                dialog.classList.add('!fixed', '!inset-0', '!w-screen', '!h-screen', '!max-w-none', '!rounded-none', '!border-0', 'z-[110]');
                if (icon) icon.classList.replace('fa-expand', 'fa-compress');
                if (label) label.textContent = 'Exit Fullscreen';
            } else {
                dialog.classList.remove('!fixed', '!inset-0', '!w-screen', '!h-screen', '!max-w-none', '!rounded-none', '!border-0', 'z-[110]');
                if (icon) icon.classList.replace('fa-compress', 'fa-expand');
                if (label) label.textContent = 'Fullscreen';
            }

            setTimeout(fitSimIframe, 60);
        }

        function reloadSimModal() {
            const iframe = document.getElementById('activeSimIframe');
            if (iframe) {
                const currentSrc = iframe.src;
                iframe.src = 'about:blank';
                setTimeout(() => { iframe.src = currentSrc; }, 30);
            }
        }

        // On-demand simulation runner modal (Loads only 1 active iframe safely when clicked)
        function openSimModal(simId) {
            const sim = SIMULATIONS.find(s => s.id === simId);
            if (!sim) return;

            if (window.ElementaHostBridge && sim.slug) {
                ElementaHostBridge.setActiveSimulation(sim.slug);
            }

            const modal = document.getElementById('simRunnerModal');
            const titleEl = document.getElementById('simModalTitle');
            const badgeEl = document.getElementById('simModalCategoryBadge');
            const linkEl = document.getElementById('simModalExternalLink');
            const container = document.getElementById('simModalIframeContainer');

            if (titleEl) titleEl.textContent = sim.title;
            if (badgeEl) badgeEl.textContent = sim.category;
            if (linkEl) linkEl.href = sim.url;

            // Reset fullscreen state if it was open previously
            if (isSimFullscreen) {
                toggleSimModalFullscreen();
            }

            // Mount the single active iframe safely without conflicting sandbox flags
            container.innerHTML = `
                <iframe id="activeSimIframe"
                        src="${sim.url}" 
                        class="w-full h-full border-0 block" 
                        allow="fullscreen; autoplay; clipboard-write" 
                        allowfullscreen 
                        sandbox="allow-scripts allow-forms allow-popups allow-downloads allow-same-origin"
                        title="${sim.title}">
                </iframe>
            `;

            if (window.ModalManager) {
                ModalManager.open('simRunnerModal');
            } else {
                modal.classList.remove('hidden');
                modal.classList.add('flex');
                document.body.classList.add('overflow-hidden');
            }

            // Setup ResizeObserver for pixel-perfect dynamic auto-fit
            if (window.ResizeObserver) {
                if (simResizeObserver) simResizeObserver.disconnect();
                simResizeObserver = new ResizeObserver(() => {
                    fitSimIframe();
                });
                simResizeObserver.observe(container);
            }

            requestAnimationFrame(() => {
                fitSimIframe();
                setTimeout(fitSimIframe, 150);
            });
        }

        function closeSimModal() {
            const modal = document.getElementById('simRunnerModal');
            const container = document.getElementById('simModalIframeContainer');
            
            if (simResizeObserver) {
                simResizeObserver.disconnect();
                simResizeObserver = null;
            }

            if (isSimFullscreen) {
                toggleSimModalFullscreen();
            }

            // Clean unmount to destroy WebGL and free all CPU/memory instantly
            if (container) container.innerHTML = '';
            
            if (window.ModalManager) {
                ModalManager.close('simRunnerModal');
            } else {
                if (modal) {
                    modal.classList.add('hidden');
                    modal.classList.remove('flex');
                }
                document.body.classList.remove('overflow-hidden');
            }
        }

        window.addEventListener('resize', fitSimIframe);

        document.addEventListener('DOMContentLoaded', () => {
            renderSimulations();
            if (window.ElementaHostBridge) {
                ElementaHostBridge.init();
            }
        });
    </script>
