<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Dashboard | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        
        body { font-family: 'Plus Jakarta Sans', sans-serif; }
        
        .carousel-track {
            animation: scroll-carousel 30s linear infinite;
        }
        .carousel-wrapper:hover .carousel-track {
            animation-play-state: paused;
        }
        @keyframes scroll-carousel {
            from { transform: translateX(0); }
            to { transform: translateX(-50%); }
        }

        .scrollbar-hide::-webkit-scrollbar { display: none; }
        .scrollbar-hide { -ms-overflow-style: none; scrollbar-width: none; }
        
        .glass-effect {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
        }




        @import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;700;800&display=swap');

        .el-section {
            background: #06091A;
            border-radius: 28px;
            padding: 64px 48px;
            font-family: 'Syne', sans-serif;
            overflow: hidden;
            position: relative;
        }

        .el-grid-bg {
            position: absolute;
            inset: 0;
            background-image:
            linear-gradient(rgba(37,99,235,0.06) 1px, transparent 1px),
            linear-gradient(90deg, rgba(37,99,235,0.06) 1px, transparent 1px);
            background-size: 48px 48px;
            border-radius: 28px;
        }

        .el-header {
            display: flex;
            align-items: flex-start;
            justify-content: space-between;
            gap: 32px;
            margin-bottom: 52px;
            position: relative;
            z-index: 1;
        }

        .el-eyebrow {
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 14px;
        }

        .el-dot {
            width: 6px; height: 6px;
            border-radius: 50%;
            background: #00D4FF;
        }

        .el-eyebrow-text {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.18em;
            text-transform: uppercase;
            color: #4A7FA5;
        }

        .el-title {
            font-size: 48px;
            font-weight: 800;
            color: #E8EDF5;
            line-height: 1.0;
            letter-spacing: -0.02em;
            margin: 0;
        }

        .el-title span { color: #00D4FF; }

        .el-desc {
            max-width: 260px;
            font-size: 14px;
            line-height: 1.7;
            color: #4A7FA5;
            padding-top: 8px;
            font-weight: 400;
        }

        .el-stat-row {
            display: flex;
            align-items: center;
            gap: 0;
            margin-bottom: 40px;
            position: relative;
            z-index: 1;
        }

        .el-stat { display: flex; flex-direction: column; }

        .el-stat-num {
            font-size: 30px;
            font-weight: 800;
            color: #E8EDF5;
            line-height: 1;
            letter-spacing: -0.02em;
        }

        .el-stat-label {
            font-size: 11px;
            color: #4A7FA5;
            margin-top: 3px;
        }

        .el-divider-line {
            width: 1px; height: 60px;
            background: rgba(37,99,235,0.3);
            display: inline-block;
            vertical-align: middle;
            margin: 0 24px;
        }

        .el-cards {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 12px;
            position: relative;
            z-index: 1;
        }

        .el-card {
            border-radius: 20px;
            padding: 24px 20px 20px;
            position: relative;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            min-height: 190px;
            transition: transform 0.18s ease;
        }

        .el-card:hover { transform: translateY(-3px); }

        .el-card-dark { background: #0D1428; border: 1px solid rgba(37,99,235,0.22); }
        .el-card-blue { background: #0E2144; border: 1px solid rgba(0,212,255,0.2); }
        .el-card-cyan { background: #041C24; border: 1px solid rgba(0,212,255,0.25); }
        .el-card-mid  { background: #101828; border: 1px solid rgba(37,99,235,0.18); }

        .el-card-tall { grid-row: span 2; min-height: 408px; }
        .el-card-wide { grid-column: span 2; }

        .el-corner-mark {
            position: absolute;
            top: 14px; right: 16px;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.1em;
            color: rgba(74,127,165,0.5);
        }

        .el-card-label {
            display: inline-block;
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            padding: 3px 8px;
            border-radius: 4px;
            margin-bottom: 12px;
        }

        .el-label-blue { background: rgba(37,99,235,0.18); color: #60A5FA; }
        .el-label-cyan { background: rgba(0,212,255,0.12); color: #00D4FF; }
        .el-label-gray { background: rgba(255,255,255,0.05); color: #4A7FA5; }

        .el-atomic {
            font-size: 10px;
            font-weight: 700;
            letter-spacing: 0.14em;
            color: #2563EB;
            margin-bottom: 6px;
            display: block;
        }

        .el-symbol {
            font-size: 64px;
            font-weight: 800;
            line-height: 1;
            letter-spacing: -0.03em;
            margin-bottom: 4px;
            display: block;
        }

        .el-symbol-blue  { color: #2563EB; }
        .el-symbol-cyan  { color: #00D4FF; }
        .el-symbol-muted { color: #1E3A5F; }

        .el-card-name {
            font-size: 12px;
            font-weight: 700;
            color: #8892A4;
            text-transform: uppercase;
            letter-spacing: 0.10em;
            border-top: 1px solid rgba(255,255,255,0.06);
            padding-top: 12px;
            margin-top: auto;
        }

        .el-card-body {
            font-size: 12px;
            line-height: 1.65;
            color: #4A7FA5;
            font-weight: 400;
            margin-top: 6px;
        }

        .el-glow-ring {
            position: absolute;
            border-radius: 50%;
            pointer-events: none;
        }

        .el-glow-1 {
            width: 320px; height: 320px;
            background: radial-gradient(circle, rgba(37,99,235,0.12) 0%, transparent 70%);
            top: -80px; right: -60px;
        }

        .el-glow-2 {
            width: 200px; height: 200px;
            background: radial-gradient(circle, rgba(0,212,255,0.08) 0%, transparent 70%);
            bottom: 20px; left: 40px;
        }
        /* ── Mouse-trail particle canvas ── */
        #particle-canvas {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            pointer-events: none;
            z-index: 9999;
        }


        /* ── Card flip animation ── */
        .el-card-flip-wrap {
            perspective: 1000px;
        }

        .el-card-flip-inner {
            position: relative;
            width: 100%;
            height: 100%;
            transform-style: preserve-3d;
        }

        .el-card-flip-front,
        .el-card-flip-back {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            border-radius: inherit;
            overflow: hidden;
        }

        .el-card-flip-back {
            transform: rotateY(180deg);
            background: #06091A;
            border: 1px solid rgba(0, 212, 255, 0.3);
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 20px;
            text-align: center;
        }

        .el-card-flip-back .flip-icon {
            font-size: 30px;
            color: #00D4FF;
        }

        .el-card-flip-back .flip-title {
            font-size: 14px;
            font-weight: 800;
            color: #E8EDF5;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            font-family: 'Syne', sans-serif;
        }

        .el-card-flip-back .flip-body {
            font-size: 12px;
            color: #4A7FA5;
            line-height: 1.6;
            font-family: 'Syne', sans-serif;
        }

        .el-card-flip-inner.is-flipped {
            transform: rotateY(180deg);
            transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .el-card-flip-inner.is-unflipping {
            transform: rotateY(0deg);
            transition: transform 0.7s cubic-bezier(0.4, 0, 0.2, 1);
        }

    </style>

    <!-- Standardized Student Navigation & Responsive Styles -->
    <%- include('partials/student-nav-styles') %>
</head>
<body class="bg-gradient-to-br from-slate-50 via-white to-indigo-50/30 text-slate-900">
    <!-- Mouse-trail particle canvas -->
    <canvas id="particle-canvas"></canvas>

    <div class="flex min-h-screen relative overflow-x-hidden">
        <!-- Standardized Student Sidebar Partial -->
        <%- include('partials/student-sidebar', { activeNav: 'home' }) %>

        <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">
            <!-- App Header -->
            <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    <div>
                        <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">
                            Welcome, <%= user.first_name %>!
                        </h1>
                        <p class="text-xs text-slate-600 hidden sm:block font-medium">
                            <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                            Chemistry Enthusiast &nbsp;·&nbsp; <%= new Date().toLocaleDateString('en-PH', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3 md:gap-6">
                    <!-- Messages Navigation Button (Entry point to message-student view) -->
                    <a href="/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                        <i class="far fa-comment-dots text-xl"></i>
                        
                        <!-- Tooltip with keyboard and hover accessibility -->
                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Messages
                        </span>
                    </a>

                    <!-- Notification Button with keyboard-accessible tooltip -->
                    <button type="button" onclick="toggleNotifications()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                        <i class="far fa-bell text-xl text-slate-700"></i>
                        
                        <span class="absolute top-2 right-2 flex h-2.5 w-2.5 notif-badge hidden" aria-hidden="true">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500 border-2 border-white"></span>
                        </span>

                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Notifications
                        </span>
                    </button>
                    
                    <!-- User Profile Dropdown -->
                    <div class="relative">
                        <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                            <div class="text-right hidden lg:block">
                                <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                                <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none"><%= user.role %></p>
                            </div>
                            <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100">
                            <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                        </button>

                        <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                            <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                                <p class="text-sm font-bold text-slate-800"><%= user.first_name %> <%= user.last_name %></p>
                                <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role %></p>
                            </div>
                            <a href="/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                                <i class="far fa-user w-5 text-center"></i> View Profile
                            </a>
                            <hr class="my-2 border-slate-100">
                            <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                                <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                            </a>
                        </div>
                    </div>
                </div>
            </header>
            
            <div class="flex-1 overflow-y-auto mt-6 no-scrollbar flex flex-col ">
                <div class="pt-12 pb-4 px-4 md:pt-16 md:px-8 flex-1">
                <!-- ===== SECTION 1: BENEFITS ===== -->
                <section class="el-section mb-6">
                    <div class="el-grid-bg"></div>
                    <div class="el-glow-ring el-glow-1"></div>
                    <div class="el-glow-ring el-glow-2"></div>

                    <div class="el-header">
                        <div>
                        <div class="el-eyebrow">
                            <span class="el-dot"></span>
                            <span class="el-eyebrow-text">Benefits You'll Gain</span>
                        </div>
                        <h2 class="el-title">Unlock<br><span>Exclusive</span><br>Advantages</h2>
                        </div>
                        <p class="el-desc">
                        Elementa provides flexible, effective solutions for all your chemistry learning needs — consistent quality, timely feedback, and dedicated support at every stage.
                        </p>
                    </div>

                    <div class="el-stat-row">
                        <div class="el-stat">
                        <span class="el-stat-num">12K+</span>
                        <span class="el-stat-label">Active learners</span>
                        </div>
                        <span class="el-divider-line"></span>
                        <div class="el-stat">
                        <span class="el-stat-num">98%</span>
                        <span class="el-stat-label">Pass rate improvement</span>
                        </div>
                        <span class="el-divider-line"></span>
                        <div class="el-stat">
                        <span class="el-stat-num">240+</span>
                        <span class="el-stat-label">Interactive modules</span>
                        </div>
                    </div>

                    <div class="el-cards">

                        <!-- Card 1: Gamified (tall) -->
                        <div class="el-card-flip-wrap el-card-tall" style="border-radius:20px;">
                        <div class="el-card-flip-inner">
                            <div class="el-card-flip-front el-card el-card-dark el-card-tall" style="padding: 0; overflow: hidden; position:relative;">
                                <div style="position: relative; height: 160px; overflow: hidden; flex-shrink: 0;">
                                    <img src="https://images.unsplash.com/photo-1532187863486-abf9dbad1b69?w=600&q=80&auto=format&fit=crop" alt="Chemistry lab glassware" style="width:100%; height:100%; object-fit:cover; object-position: center; filter: brightness(0.55) saturate(1.4) hue-rotate(180deg);">
                                    <div style="position:absolute; inset:0; background: linear-gradient(to bottom, transparent 40%, #0D1428 100%);"></div>
                                    <span class="el-corner-mark" style="top:14px; right:16px; position:absolute;">01</span>
                                    <span class="el-card-label el-label-cyan" style="position:absolute; bottom:12px; left:20px;">Learning Method</span>
                                </div>
                                <div style="padding: 16px 20px 20px; display:flex; flex-direction:column; flex:1; justify-content:space-between;">
                                    <div>
                                        <span class="el-atomic">Gm</span>
                                        <span class="el-symbol el-symbol-cyan">Gm</span>
                                    </div>
                                    <div>
                                        <p class="el-card-name">Gamified Learning</p>
                                        <p class="el-card-body">Earn EXP, climb leaderboards, and unlock achievements as you master every concept.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="el-card-flip-back">
                                <i class="fas fa-gamepad flip-icon"></i>
                                <p class="flip-title">Gamified Learning</p>
                                <p class="flip-body">Level up your chemistry skills through quizzes, achievements, and competitive leaderboards designed for real engagement.</p>
                            </div>
                        </div>
                        </div>

                        <!-- Card 2: Personalized -->
                        <div class="el-card-flip-wrap" style="border-radius:20px; min-height:190px;">
                        <div class="el-card-flip-inner">
                            <div class="el-card-flip-front el-card el-card-blue" style="position:relative;">
                                <div>
                                    <span class="el-corner-mark">02</span>
                                    <span class="el-label-blue el-card-label">Curriculum</span>
                                    <span class="el-atomic">Pm</span>
                                    <span class="el-symbol el-symbol-blue">Pm</span>
                                </div>
                                <div>
                                    <p class="el-card-name">Personalized Modules</p>
                                    <p class="el-card-body">Tailored content matched to your subject and semester.</p>
                                </div>
                            </div>
                            <div class="el-card-flip-back">
                                <i class="fas fa-sliders-h flip-icon"></i>
                                <p class="flip-title">Personalized Modules</p>
                                <p class="flip-body">Your curriculum adapts to your current subject, track, and learning pace — no generic content.</p>
                            </div>
                        </div>
                        </div>

                        <!-- Card 3: 24/7 Support (wide) -->
                        <div class="el-card-flip-wrap el-card-wide" style="border-radius:20px; min-height:150px;">
                        <div class="el-card-flip-inner">
                            <div class="el-card-flip-front el-card el-card-mid el-card-wide" style="grid-row: auto; min-height: 150px; padding: 0; overflow: hidden; position: relative;">
                                <img src="https://images.unsplash.com/photo-1614935151651-0bea6508db6b?w=900&q=80&auto=format&fit=crop" alt="Neon chemistry" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; filter: brightness(0.18) saturate(1.8) hue-rotate(200deg);">
                                <div style="position:relative; z-index:1; padding:24px 20px; height:100%; display:flex; justify-content:space-between; align-items:flex-start; box-sizing:border-box;">
                                    <div>
                                        <span class="el-corner-mark">03</span>
                                        <span class="el-label-gray el-card-label">Support</span>
                                        <span class="el-atomic">Is</span>
                                        <span class="el-symbol el-symbol-muted" style="font-size:80px;">Is</span>
                                    </div>
                                    <div style="max-width:160px; align-self:flex-end; padding-bottom:4px;">
                                        <p class="el-card-name">24/7 Instructor Support</p>
                                        <p class="el-card-body">Ask anything, any time — via forums and direct messaging.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="el-card-flip-back">
                                <i class="fas fa-headset flip-icon"></i>
                                <p class="flip-title">24/7 Instructor Support</p>
                                <p class="flip-body">Get real answers from verified chemistry instructors — through forums or direct messages, day or night.</p>
                            </div>
                        </div>
                        </div>

                        <!-- Card 4: Consistent Quality -->
                        <div class="el-card-flip-wrap" style="border-radius:20px; min-height:190px;">
                        <div class="el-card-flip-inner">
                            <div class="el-card-flip-front el-card el-card-cyan" style="padding: 0; overflow: hidden; position: relative;">
                                <img src="https://images.unsplash.com/photo-1559757148-5c350d0d3c56?w=600&q=80&auto=format&fit=crop" alt="Scientific precision" style="position:absolute; inset:0; width:100%; height:100%; object-fit:cover; object-position:center; filter: brightness(0.25) saturate(2) hue-rotate(170deg);">
                                <div style="position:relative; z-index:1; padding:24px 20px 20px; display:flex; flex-direction:column; justify-content:space-between; height:100%; box-sizing:border-box;">
                                    <div>
                                        <span class="el-corner-mark">04</span>
                                        <span class="el-label-cyan el-card-label">Standards</span>
                                        <span class="el-atomic">Cq</span>
                                        <span class="el-symbol el-symbol-cyan" style="font-size:52px;">Cq</span>
                                    </div>
                                    <div>
                                        <p class="el-card-name">Consistent Quality</p>
                                        <p class="el-card-body">Uninterrupted academic progress, every session.</p>
                                    </div>
                                </div>
                            </div>
                            <div class="el-card-flip-back">
                                <i class="fas fa-award flip-icon"></i>
                                <p class="flip-title">Consistent Quality</p>
                                <p class="flip-body">Every module, quiz, and resource is reviewed and maintained to the highest academic standard.</p>
                            </div>
                        </div>
                        </div>

                        <!-- Card 5: Progress Tracking -->
                        <div class="el-card-flip-wrap" style="border-radius:20px; min-height:190px;">
                        <div class="el-card-flip-inner">
                            <div class="el-card-flip-front el-card el-card-dark" style="position:relative;">
                                <div>
                                    <span class="el-corner-mark">05</span>
                                    <span class="el-label-blue el-card-label">Analytics</span>
                                    <span class="el-atomic">Pt</span>
                                    <span class="el-symbol el-symbol-muted" style="font-size:52px;">Pt</span>
                                </div>
                                <div>
                                    <p class="el-card-name">Progress Tracking</p>
                                    <p class="el-card-body">Visual dashboards show exactly where you stand.</p>
                                </div>
                            </div>
                            <div class="el-card-flip-back">
                                <i class="fas fa-chart-bar flip-icon"></i>
                                <p class="flip-title">Progress Tracking</p>
                                <p class="flip-body">Live dashboards visualize your EXP growth, quiz scores, and subject completion in real time.</p>
                            </div>
                        </div>
                        </div>

                        <!-- Card 6: Expert Feedback -->
                        <div class="el-card-flip-wrap" style="border-radius:20px; min-height:190px;">
                        <div class="el-card-flip-inner">
