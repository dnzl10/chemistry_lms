                        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                            <% subjects.forEach(subject => { %>
                                <div class="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden hover:shadow-xl hover:-translate-y-1 transition-all duration-300 flex flex-col group">
                                    
                                    <div class="h-40 bg-slate-200 relative overflow-hidden">
                                        <img src="/profile_uploads/<%= subject.subject_image || 'default_subject.png' %>" 
                                            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                                            onerror="this.src='https://placehold.co/600x400/1e293b/ffffff?text=<%= subject.subject_name %>'">
                                        
                                        <div class="absolute top-4 left-4 flex flex-col gap-2">
                                            <span class="w-fit px-3 py-1 bg-white/90 backdrop-blur text-slate-900 text-[9px] font-black rounded-lg uppercase tracking-widest shadow-sm">
                                                <%= subject.semester == 1 ? '1st Semester' : '2nd Semester' %>
                                            </span>
                                            <span class="w-fit px-3 py-1 bg-blue-600/90 backdrop-blur text-white text-[9px] font-black rounded-lg uppercase tracking-widest shadow-sm">
                                                SY <%= subject.sy_range || '2025-2026' %>
                                            </span>
                                        </div>
                                    </div>

                                    <div class="p-6 flex-1 flex flex-col">
                                        <div class="flex justify-between items-start mb-3">
                                            <span class="text-blue-600 text-[10px] font-black uppercase tracking-widest">
                                                <%= subject.subject_code %>
                                            </span>
                                            <div class="flex items-center gap-1 text-slate-300">
                                                <i class="fas fa-calendar-alt text-xs"></i>
                                                <span class="text-[10px] font-bold"><%= subject.sy_range %></span>
                                            </div>
                                        </div>

                                        <h3 class="text-xl font-bold text-slate-800 mb-2 leading-tight">
                                            <%= subject.subject_name %>
                                        </h3>

                                        <p class="text-slate-500 text-sm line-clamp-2 mb-4">
                                            <%= subject.description || 'No description available for this course.' %>
                                        </p>
                                        
                                        <div class="flex items-center gap-3 mb-6 mt-auto">
                                            <img src="/profile_uploads/<%= subject.profile_pic || 'default_avatar.png' %>" 
                                                class="w-8 h-8 rounded-full border-2 border-slate-100 shadow-sm object-cover">
                                            <div class="text-xs">
                                                <p class="text-slate-400 font-medium text-[10px] uppercase">Instructor</p>
                                                <p class="text-slate-700 font-bold">
                                                    <%= subject.first_name ? subject.first_name + ' ' + subject.last_name : 'No Teacher Assigned' %>
                                                </p>
                                            </div>
                                        </div>

                                        <form action="/enroll" method="POST" class="mt-auto">
                                            <input type="hidden" name="subject_id" value="<%= subject.subject_id %>">
                                            <div class="space-y-3">
                                                <div class="relative">
                                                    <input type="password" name="enrollment_code" placeholder="Enter Access Code" 
                                                        class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm focus:ring-2 focus:ring-blue-500 focus:border-transparent outline-none transition-all">
                                                </div>
                                                <button type="submit" class="w-full py-3 bg-slate-900 text-white rounded-2xl font-bold text-sm hover:bg-blue-600 transition-colors flex items-center justify-center gap-2 group/btn">
                                                    Enroll in Course
                                                    <i class="fas fa-arrow-right text-[10px] group-hover/btn:translate-x-1 transition-transform"></i>
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            <% }) %>
                        </div>

                        <% if (subjects.length === 0) { %>
                            <div class="text-center py-20 bg-slate-100 rounded-3xl border-2 border-dashed border-slate-200">
                                <i class="fas fa-graduation-cap text-4xl text-slate-300 mb-4"></i>
                                <p class="text-slate-500 font-medium">There are no more subjects available for you.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            
            <footer class="mt-auto py-6 px-8 border-t border-slate-200 bg-white/50">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-4">
                        <div class="text-center md:text-left">
                            <p class="text-sm text-slate-500 font-medium">
                                &copy; 2026 <span class="text-blue-600 font-bold">Mabini College</span>. All rights reserved.
                            </p>
                            <p class="text-[10px] text-slate-400 uppercase tracking-widest mt-1">
                                System Version 2.4.0-stable
                            </p>
                        </div>

                        <div class="flex flex-wrap justify-center gap-6">
                            <a href="/privacy" class="text-xs font-bold text-slate-500 hover:text-blue-600 transition">Privacy Policy</a>
                            <a href="/terms" class="text-xs font-bold text-slate-500 hover:text-blue-600 transition">Terms of Service</a>
                            <a href="/support" class="text-xs font-bold text-slate-500 hover:text-blue-600 transition flex items-center gap-1">
                                <i class="far fa-question-circle"></i> Help & Support
                            </a>
                        </div>
                    </div>
                </footer>
            </div>
        </main>
    </div>

    </div> <div id="notification-overlay" 
                onclick="toggleNotifications()" 
                class="fixed inset-0 bg-slate-900/50 backdrop-blur-sm z-[60] hidden transition-opacity duration-300 opacity-0">
            </div>

            <div id="notification-panel" 
                class="fixed top-0 right-0 h-screen w-80 md:w-96 bg-white shadow-2xl z-[70] transform translate-x-full transition-transform duration-300 ease-in-out border-l border-slate-200 flex flex-col">
                
                <div class="p-5 border-b flex justify-between items-center bg-blue-600 text-white flex-shrink-0">
                    <div>
                        <h2 class="text-lg font-bold flex items-center gap-2">
                            <i class="far fa-bell"></i> Notifications
                        </h2>
                        <p id="notifSubtitle" class="text-[11px] text-blue-200 font-medium">Activity updates</p>
                    </div>
                    <div class="flex items-center gap-2">
                        <button onclick="NotificationHub.markAllRead('notification-list')" title="Mark all as read" class="hover:bg-blue-700 text-blue-100 hover:text-white p-2 rounded-lg transition text-xs font-bold flex items-center gap-1">
                            <i class="fas fa-check-double text-sm"></i>
                        </button>
                        <button onclick="toggleNotifications()" class="hover:bg-blue-700 p-2 rounded-lg transition">
                            <i class="fas fa-times text-xl"></i>
                        </button>
                    </div>
                </div>

                <div class="flex-1 overflow-y-auto p-4 space-y-4 bg-slate-50 no-scrollbar" id="notification-list">
                    <div id="notification-loader" class="flex flex-col items-center justify-center h-full text-slate-400">
                        <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-2"></div>
                        <p class="text-xs font-bold uppercase tracking-wider">Loading Updates...</p>
                    </div>
                </div>
            </div>

    <script>
        function toggleNotifications() {
            const panel = document.getElementById('notification-panel');
            const overlay = document.getElementById('notification-overlay');

            if (!panel || !overlay) return;

            if (panel.classList.contains('translate-x-full')) {
                // OPEN PANEL
                panel.classList.remove('translate-x-full');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.add('opacity-100'), 10);
                if (window.NotificationHub) {
                    NotificationHub.loadNotifications('notification-list', false);
                }
            } else {
                // CLOSE PANEL
                panel.classList.add('translate-x-full');
                overlay.classList.remove('opacity-100');
                setTimeout(() => overlay.classList.add('hidden'), 300);
            }
        }

        function formatTimeAgo(dateString) {
            if (!dateString) return '';
            const now = new Date();
            const past = new Date(dateString);
            const diffInMs = now - past;
            const diffInMins = Math.floor(diffInMs / 60000);
            
            if (diffInMins < 0) return 'Upcoming'; // For future due dates
            if (diffInMins < 1) return 'Just now';
            if (diffInMins < 60) return `${diffInMins}m ago`;
            const diffInHours = Math.floor(diffInMins / 60);
            if (diffInHours < 24) return `${diffInHours}h ago`;
            return past.toLocaleDateString('en-US', { month: 'short', day: 'numeric' });
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const main = document.getElementById('mainContent');
            const header = document.querySelector('header');
            
            if (window.innerWidth < 768) {
                sidebar.classList.toggle('sidebar-open');
                sidebar.classList.toggle('sidebar-collapsed');
                overlay.classList.toggle('hidden');
            } else {
                sidebar.classList.toggle('sidebar-collapsed');
                if (main) main.classList.toggle('sidebar-collapsed-main');
                if (header) header.classList.toggle('sidebar-collapsed-header');
            }
        }

        function toggleUserMenu(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('userMenuBtn');
            const isExpanded = !dropdown.classList.contains('hidden');
            dropdown.classList.toggle('hidden');
            if (btn) btn.setAttribute('aria-expanded', !isExpanded);
        }

        // Close dropdown when clicking outside
        window.addEventListener('click', function() {
            const dropdown = document.getElementById('userDropdown');
            const btn = document.getElementById('userMenuBtn');
            if (dropdown && !dropdown.classList.contains('hidden')) {
                dropdown.classList.add('hidden');
                if (btn) btn.setAttribute('aria-expanded', 'false');
            }
        });

        // ── Atom/Bubble Mouse Trail Particles ──
        (function () {
            const canvas = document.getElementById('particle-canvas');
            const ctx    = canvas.getContext('2d');
            let W = canvas.width  = window.innerWidth;
            let H = canvas.height = window.innerHeight;

            window.addEventListener('resize', () => {
                W = canvas.width  = window.innerWidth;
                H = canvas.height = window.innerHeight;
            });

            // Atom/chemistry color palette
            const COLORS = [
                '#00D4FF', '#2563EB', '#60A5FA',
                '#A78BFA', '#34D399', '#FBBF24'
            ];

            const particles = [];

            // Throttle: one particle every ~20ms so it's not too dense
            let lastSpawn = 0;

            window.addEventListener('mousemove', (e) => {
                const now = Date.now();
                if (now - lastSpawn < 20) return;
                lastSpawn = now;
                spawnParticle(e.clientX, e.clientY);
            });

            function spawnParticle(x, y) {
                const color  = COLORS[Math.floor(Math.random() * COLORS.length)];
                const radius = 3 + Math.random() * 5;          // 3–8 px
                const vx     = (Math.random() - 0.5) * 1.2;   // drift sideways
                const vy     = -(0.4 + Math.random() * 0.8);  // drift upward

                particles.push({
                    x, y, vx, vy,
                    radius,
                    color,
                    alpha: 0.85,
                    decay: 0.012 + Math.random() * 0.01,       // fade speed
                    // Each particle also has an electron "ring" 50% of the time
                    hasRing: Math.random() > 0.5,
                    ringRadius: radius * 1.8,
                });
            }

            function animate() {
                ctx.clearRect(0, 0, W, H);

                for (let i = particles.length - 1; i >= 0; i--) {
                    const p = particles[i];

                    p.x += p.vx;
                    p.y += p.vy;
                    p.alpha -= p.decay;

                    if (p.alpha <= 0) {
                        particles.splice(i, 1);
                        continue;
                    }

                    ctx.save();
                    ctx.globalAlpha = p.alpha;

                    // Core nucleus circle
                    ctx.beginPath();
                    ctx.arc(p.x, p.y, p.radius, 0, Math.PI * 2);
                    ctx.fillStyle = p.color;
                    ctx.shadowColor = p.color;
                    ctx.shadowBlur  = 8;
                    ctx.fill();

                    // Optional electron orbit ring
                    if (p.hasRing) {
                        ctx.beginPath();
                        ctx.arc(p.x, p.y, p.ringRadius, 0, Math.PI * 2);
                        ctx.strokeStyle = p.color;
                        ctx.lineWidth   = 0.8;
                        ctx.globalAlpha = p.alpha * 0.45;
                        ctx.stroke();
                    }

                    ctx.restore();
                }

                requestAnimationFrame(animate);
            }

            animate();
        })();

        // ── Sequential card flip (one at a time, each rests before repeating) ──
        (function () {
            const FLIP_DURATION   = 700;   // ms — matches CSS transition
            const SHOW_BACK_MS    = 2000;  // ms — how long the back is shown
            const REST_BETWEEN_MS = 10000;  // ms — pause before same card flips again
            const STAGGER_MS      = 5000;  // ms — gap between each card starting its cycle

            const wrappers = document.querySelectorAll('.el-card-flip-wrap');

            wrappers.forEach((wrap, i) => {
                const inner = wrap.querySelector('.el-card-flip-inner');

                function doFlipCycle() {
                    // 1. Flip to back
                    inner.classList.remove('is-unflipping');
                    inner.classList.add('is-flipped');

                    // 2. After showing back, flip to front
                    setTimeout(() => {
                        inner.classList.remove('is-flipped');
                        inner.classList.add('is-unflipping');

                        // 3. After returning to front, rest then repeat
                        setTimeout(() => {
                            inner.classList.remove('is-unflipping');
                            setTimeout(doFlipCycle, REST_BETWEEN_MS);
                        }, FLIP_DURATION);

                    }, FLIP_DURATION + SHOW_BACK_MS);
                }

                // Stagger the start of each card so they're never in sync
                setTimeout(doFlipCycle, i * STAGGER_MS);
            });
        })();
    </script>
    <script src="/js/notificationHub.js"></script>
</body>
</html>