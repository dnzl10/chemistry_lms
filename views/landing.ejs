    <!-- Interactive Client Scripts -->
    <script>
        // Update copyright year
        document.getElementById('current-year').textContent = new Date().getFullYear();

        // 1. Hero Element Selector Data & Handler
        const elementsData = {
            'H': { name: 'Hydrogen', mass: '1.008 u', en: '2.20 (Pauling)', cfg: '1s¹' },
            'C': { name: 'Carbon', mass: '12.011 u', en: '2.55 (Pauling)', cfg: '[He] 2s² 2p²' },
            'N': { name: 'Nitrogen', mass: '14.007 u', en: '3.04 (Pauling)', cfg: '[He] 2s² 2p³' },
            'O': { name: 'Oxygen', mass: '15.999 u', en: '3.44 (Pauling)', cfg: '[He] 2s² 2p⁴' },
            'Na': { name: 'Sodium', mass: '22.990 u', en: '0.93 (Pauling)', cfg: '[Ne] 3s¹' },
            'Cl': { name: 'Chlorine', mass: '35.45 u', en: '3.16 (Pauling)', cfg: '[Ne] 3s² 3p⁵' },
            'Fe': { name: 'Iron', mass: '55.845 u', en: '1.83 (Pauling)', cfg: '[Ar] 3d⁶ 4s²' },
            'Cu': { name: 'Copper', mass: '63.546 u', en: '1.90 (Pauling)', cfg: '[Ar] 3d¹⁰ 4s¹' }
        };

        function selectHeroElement(symbol, num, mass, cfg, en, name) {
            document.querySelectorAll('.el-chip').forEach(el => {
                el.classList.remove('active', 'border-chem-cyan', 'bg-chem-cyan/20');
                el.classList.add('border-white/10', 'bg-navy-850');
            });
            event.currentTarget.classList.add('active', 'border-chem-cyan', 'bg-chem-cyan/20');
            event.currentTarget.classList.remove('border-white/10', 'bg-navy-850');

            document.getElementById('hero-element-name').textContent = `${name} (${symbol})`;
            document.getElementById('hero-element-mass').textContent = mass + ' u';
            document.getElementById('hero-element-en').textContent = en + ' (Pauling)';
            document.getElementById('hero-element-cfg').textContent = cfg;
        }

        // 2. Curriculum Tabs Switcher
        function switchCurriculumTab(tab) {
            const btn1 = document.getElementById('btn-genchem1');
            const btn2 = document.getElementById('btn-genchem2');
            const tab1 = document.getElementById('tab-genchem1');
            const tab2 = document.getElementById('tab-genchem2');

            if (tab === 'genchem1') {
                btn1.className = 'px-5 py-2.5 rounded-lg text-xs font-bold transition-all bg-chem-cyan text-navy-950 shadow-md';
                btn2.className = 'px-5 py-2.5 rounded-lg text-xs font-bold transition-all text-slate-300 hover:text-white';
                tab1.classList.remove('hidden');
                tab2.classList.add('hidden');
            } else {
                btn2.className = 'px-5 py-2.5 rounded-lg text-xs font-bold transition-all bg-chem-cyan text-navy-950 shadow-md';
                btn1.className = 'px-5 py-2.5 rounded-lg text-xs font-bold transition-all text-slate-300 hover:text-white';
                tab2.classList.remove('hidden');
                tab1.classList.add('hidden');
            }
        }

        // 3. Dual Persona Switcher (Student vs. Faculty)
        function switchPersona(persona) {
            const btnStudent = document.getElementById('toggle-student-btn');
            const btnFaculty = document.getElementById('toggle-faculty-btn');
            const viewStudent = document.getElementById('persona-student');
            const viewFaculty = document.getElementById('persona-faculty');

            if (persona === 'student') {
                btnStudent.className = 'px-6 py-2.5 rounded-lg text-xs font-bold transition-all bg-chem-cyan text-navy-950 shadow-md';
                btnFaculty.className = 'px-6 py-2.5 rounded-lg text-xs font-bold transition-all text-slate-300 hover:text-white';
                viewStudent.classList.remove('hidden');
                viewFaculty.classList.add('hidden');
            } else {
                btnFaculty.className = 'px-6 py-2.5 rounded-lg text-xs font-bold transition-all bg-chem-cyan text-navy-950 shadow-md';
                btnStudent.className = 'px-6 py-2.5 rounded-lg text-xs font-bold transition-all text-slate-300 hover:text-white';
                viewFaculty.classList.remove('hidden');
                viewStudent.classList.add('hidden');
            }
        }

        // 4. Stoichiometric Reaction Balancer & Calculator Engine
        const reactions = {
            'propane': {
                formula: 'C<sub>3</sub>H<sub>8(g)</sub> + 5 O<sub>2(g)</sub> → 3 CO<sub>2(g)</sub> + 4 H<sub>2</sub>O<sub>(g)</sub>',
                ratioText: 'Ratio: 1 mol C₃H₈ : 5 mol O₂ → 3 mol CO₂ : 4 mol H₂O',
                energy: 'ΔH° = -2220 kJ/mol (Exothermic)',
                inputLabel: 'Mass of Propane (grams C₃H₈):',
                molarMassNote: 'Molar mass of C₃H₈ = 44.10 g/mol',
                molarMassReactant: 44.10,
                prod1Name: 'Mass of CO₂ Produced',
                prod1MolarMass: 44.01,
                prod1Coeff: 3,
                prod2Name: 'Mass of H₂O Produced',
                prod2MolarMass: 18.015,
                prod2Coeff: 4,
                reactantCoeff: 1
            },
            'water': {
                formula: '2 H<sub>2(g)</sub> + O<sub>2(g)</sub> → 2 H<sub>2</sub>O<sub>(g)</sub>',
                ratioText: 'Ratio: 2 mol H₂ : 1 mol O₂ → 2 mol H₂O',
                energy: 'ΔH° = -572 kJ/mol (Exothermic)',
                inputLabel: 'Mass of Hydrogen Gas (grams H₂):',
                molarMassNote: 'Molar mass of H₂ = 2.016 g/mol',
                molarMassReactant: 2.016,
                prod1Name: 'Mass of H₂O Produced',
                prod1MolarMass: 18.015,
                prod1Coeff: 2,
                prod2Name: 'Oxygen Consumed',
                prod2MolarMass: 32.00,
                prod2Coeff: 1,
                reactantCoeff: 2
            },
            'haber': {
                formula: 'N<sub>2(g)</sub> + 3 H<sub>2(g)</sub> ⇌ 2 NH<sub>3(g)</sub>',
                ratioText: 'Ratio: 1 mol N₂ : 3 mol H₂ → 2 mol NH₃',
                energy: 'ΔH° = -92.4 kJ/mol (Exothermic Synthesis)',
                inputLabel: 'Mass of Nitrogen Gas (grams N₂):',
                molarMassNote: 'Molar mass of N₂ = 28.014 g/mol',
                molarMassReactant: 28.014,
                prod1Name: 'Mass of Ammonia (NH₃) Produced',
                prod1MolarMass: 17.031,
                prod1Coeff: 2,
                prod2Name: 'Hydrogen Consumed (H₂)',
                prod2MolarMass: 2.016,
                prod2Coeff: 3,
                reactantCoeff: 1
            },
            'neutralization': {
                formula: 'HCl<sub>(aq)</sub> + NaOH<sub>(aq)</sub> → NaCl<sub>(aq)</sub> + H<sub>2</sub>O<sub>(l)</sub>',
                ratioText: 'Ratio: 1 mol HCl : 1 mol NaOH → 1 mol NaCl : 1 mol H₂O',
                energy: 'ΔH° = -57.1 kJ/mol (Neutralization Heat)',
                inputLabel: 'Mass of Hydrochloric Acid (grams HCl):',
                molarMassNote: 'Molar mass of HCl = 36.46 g/mol',
                molarMassReactant: 36.46,
                prod1Name: 'Mass of Salt (NaCl) Produced',
                prod1MolarMass: 58.44,
                prod1Coeff: 1,
                prod2Name: 'Mass of Water (H₂O) Formed',
                prod2MolarMass: 18.015,
                prod2Coeff: 1,
                reactantCoeff: 1
            }
        };

        function updateReactionUI() {
            const rxnKey = document.getElementById('reaction-picker').value;
            const rxn = reactions[rxnKey];
            
            document.getElementById('equation-display').innerHTML = rxn.formula;
            document.getElementById('input-label').textContent = rxn.inputLabel;
            document.getElementById('molar-mass-note').textContent = rxn.molarMassNote;
            
            calculateStoichiometry();
        }

        function calculateStoichiometry() {
            const rxnKey = document.getElementById('reaction-picker').value;
            const rxn = reactions[rxnKey];
            const inputVal = parseFloat(document.getElementById('reactant-input').value) || 0;

            if (inputVal <= 0) {
                document.getElementById('res-moles').textContent = '0.000 mol';
                document.getElementById('res-prod1-mass').textContent = '0.00 g';
                document.getElementById('res-prod2-mass').textContent = '0.00 g';
                return;
            }

            // Moles of reactant = mass / molarMass
            const molesReactant = inputVal / rxn.molarMassReactant;
            document.getElementById('res-moles').textContent = molesReactant.toFixed(3) + ' mol';

            // Product 1 Moles & Mass
            const molesProd1 = (molesReactant / rxn.reactantCoeff) * rxn.prod1Coeff;
            const massProd1 = molesProd1 * rxn.prod1MolarMass;
            document.getElementById('res-prod1-title').textContent = rxn.prod1Name;
            document.getElementById('res-prod1-mass').textContent = massProd1.toFixed(2) + ' g';
            document.getElementById('res-prod1-mol').textContent = molesProd1.toFixed(3) + ' mol produced';

            // Product 2 Moles & Mass
            const molesProd2 = (molesReactant / rxn.reactantCoeff) * rxn.prod2Coeff;
            const massProd2 = molesProd2 * rxn.prod2MolarMass;
            document.getElementById('res-prod2-title').textContent = rxn.prod2Name;
            document.getElementById('res-prod2-mass').textContent = massProd2.toFixed(2) + ' g';
            document.getElementById('res-prod2-mol').textContent = molesProd2.toFixed(3) + ' mol';
        }

        // Initialize calculator on load
        calculateStoichiometry();
    </script>
