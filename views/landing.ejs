    <style>
        :root {
            --font-display: 'Outfit', sans-serif;
            --font-body: 'Plus Jakarta Sans', sans-serif;
            --font-mono: 'JetBrains Mono', monospace;
            
            /* Primitive Tokens */
            --color-canvas: #040914;
            --color-surface-base: #071124;
            --color-surface-raised: #0b1730;
            --color-surface-hover: #102144;
            --color-border-subtle: rgba(255, 255, 255, 0.08);
            --color-border-active: rgba(0, 229, 255, 0.4);
            
            /* Academic & STEM Accents */
            --color-mabini-maroon: #8B1E2D;
            --color-mabini-gold: #D4AF37;
            --color-chem-cyan: #00E5FF;
            --color-chem-teal: #0D9488;
        }

        body {
            font-family: var(--font-body);
            background-color: var(--color-canvas);
            color: #E2E8F0;
            overflow-x: hidden;
            selection-background-color: #00E5FF;
            selection-color: #040914;
        }

        ::selection {
            background-color: rgba(0, 229, 255, 0.3);
            color: #FFFFFF;
        }

        /* Scientific Grid Pattern */
        .bg-grid-lattice {
            background-image: 
                radial-gradient(circle at center, rgba(0, 229, 255, 0.08) 1px, transparent 1px),
                linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
                linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
            background-size: 32px 32px, 96px 96px, 96px 96px;
        }

        .bg-subtle-glow {
            background: radial-gradient(circle 600px at 50% 20%, rgba(13, 148, 136, 0.15), rgba(4, 9, 20, 0) 70%);
        }

        /* Chemical formula styling */
        .chem-formula {
            font-family: var(--font-mono);
            letter-spacing: -0.02em;
        }
        
        .chem-formula sub {
            font-size: 0.72em;
            line-height: 0;
            bottom: -0.22em;
            position: relative;
            color: #38BDF8;
        }
        
        .chem-formula sup {
            font-size: 0.72em;
            line-height: 0;
            top: -0.32em;
            position: relative;
            color: #F59E0B;
        }

        /* Micro-interactions & Smooth Transitions */
        .interactive-card {
            transition: transform 0.24s cubic-bezier(0.16, 1, 0.3, 1), 
                        border-color 0.24s cubic-bezier(0.16, 1, 0.3, 1),
                        box-shadow 0.24s cubic-bezier(0.16, 1, 0.3, 1);
        }
        .interactive-card:hover {
            transform: translateY(-4px);
            border-color: rgba(0, 229, 255, 0.35);
            box-shadow: 0 16px 36px -8px rgba(0, 0, 0, 0.8), 0 0 20px -2px rgba(0, 229, 255, 0.18);
        }

        /* Reduced motion support */
        @media (prefers-reduced-motion: reduce) {
            *, ::before, ::after {
                animation-duration: 0.01ms !important;
                animation-iteration-count: 1 !important;
                transition-duration: 0.01ms !important;
                scroll-behavior: auto !important;
            }
        }
    </style>
</head>
