        <div class="flex flex-col items-center justify-center h-full text-slate-400">
            <div class="animate-spin rounded-full h-8 w-8 border-b-2 border-blue-600 mb-2"></div>
            <p class="text-xs font-bold uppercase tracking-wider">Loading…</p>
        </div>
    </div>
</div>

<!-- ══════════════════════════════════════════════════
     SERVER DATA INJECTION
══════════════════════════════════════════════════ -->
<script>
const CURRENT_USER_ID = <%= user.user_id %>;
const CURRENT_USER = {
    id:          <%= user.user_id %>,
    first_name:  '<%= user.first_name %>',
    last_name:   '<%= user.last_name %>',
    profile_pic: '<%= user.profile_pic || "default_avatar.png" %>',
    role:        '<%= user.role %>'
};
// All forum data available for client-side operations
const ALL_FORUMS = <%- JSON.stringify(filteredForumsList) %>;
</script>

<!-- ══════════════════════════════════════════════════
     MAIN SCRIPT
══════════════════════════════════════════════════ -->
<script>
// ─── STATE ──────────────────────────────────────────────────────────────────
let currentForumId   = null;
let activeParentId   = null;
let refreshTask      = null;
let pmRecipientId    = null;
let currentReplies   = [];

// ─── INIT: count badges ──────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
    updateCounts();

    // Deep link handling: redirect to canonical dedicated discussion page
    const urlParams = new URLSearchParams(window.location.search);
    const targetForumId = urlParams.get('forum_id');
    const targetReplyId = urlParams.get('reply_id') || (window.location.hash.startsWith('#reply-') ? window.location.hash.replace('#reply-', '') : null);

    if (targetForumId) {
        window.location.replace(`/forums/view/${targetForumId}${targetReplyId ? '?reply_id=' + targetReplyId + '#discussion-' + targetReplyId : ''}`);
        return;
    }
});

function updateCounts() {
    const cards = document.querySelectorAll('.forum-card');
    document.getElementById('countAll').textContent = cards.length;
    document.getElementById('forumCountLabel').textContent = `${cards.length} forum${cards.length !== 1 ? 's' : ''} available`;

    // Per-subject counts
    const counts = {};
    cards.forEach(c => {
        const sid = c.getAttribute('data-subject');
        counts[sid] = (counts[sid] || 0) + 1;
    });
    document.querySelectorAll('.subject-count').forEach(el => {
        const sid = el.getAttribute('data-for');
        el.textContent = counts[sid] || 0;
    });
}

// ─── FORUM CARD FILTER ───────────────────────────────────────────────────────
let activeSubject = 'all';

function filterBySubject(subjectId, btn) {
    activeSubject = subjectId;
    applyFilters();

    document.querySelectorAll('.subject-btn').forEach(b => {
        b.className = 'subject-btn w-full flex items-center gap-3 p-3 rounded-xl text-slate-600 hover:bg-slate-50 font-semibold text-sm transition-all';
    });
    btn.className = subjectId === 'all'
        ? 'subject-btn w-full flex items-center gap-3 p-3 rounded-xl bg-blue-50 text-blue-600 font-bold text-sm transition-all'
        : 'subject-btn w-full flex items-center gap-3 p-3 rounded-xl bg-emerald-50 text-emerald-600 font-bold text-sm transition-all';
}

function clearSearchInput() {
    const input = document.getElementById('globalSearch');
    if (input) {
        input.value = '';
        filterForumCards('');
        input.focus();
    }
}

function filterForumCards(query) {
    const clearBtn = document.getElementById('clearSearchBtn');
    if (clearBtn) {
        clearBtn.classList.toggle('hidden', !query || query.trim().length === 0);
    }
    applyFilters(query);
}

function applyFilters(query) {
    const searchInput = document.getElementById('globalSearch');
    const q = (typeof query === 'string' ? query : (searchInput ? searchInput.value : '')).toLowerCase().trim();
    let visible = 0;
    document.querySelectorAll('.forum-card').forEach(card => {
        const matchSubject = activeSubject === 'all' || card.getAttribute('data-subject') === String(activeSubject);
        const cardTitle = (card.getAttribute('data-title') || '').toLowerCase();
        const cardTopic = (card.getAttribute('data-topic') || '').toLowerCase();
        const cardContent = (card.getAttribute('data-content') || '').toLowerCase();
        const matchSearch = !q || cardTitle.includes(q) || cardTopic.includes(q) || cardContent.includes(q);
        const show = matchSubject && matchSearch;
        card.classList.toggle('hidden', !show);
        if (show) visible++;
    });
    const noResultsEl = document.getElementById('noResults');
    if (noResultsEl) noResultsEl.classList.toggle('hidden', visible > 0);
    const countLabel = document.getElementById('forumCountLabel');
    if (countLabel) countLabel.textContent = `${visible} forum${visible !== 1 ? 's' : ''} shown`;
}

function sortForums(mode) {
    const list  = document.getElementById('forumList');
    const cards = [...list.querySelectorAll('.forum-card')];
    cards.sort((a, b) => {
        if (mode === 'pinned') {
            if (a.dataset.pinned !== b.dataset.pinned) return b.dataset.pinned - a.dataset.pinned;
            return new Date(b.dataset.created) - new Date(a.dataset.created);
        }
        if (mode === 'newest')       return new Date(b.dataset.created) - new Date(a.dataset.created);
        if (mode === 'most_replies') return parseInt(b.dataset.replies) - parseInt(a.dataset.replies);
    });
    cards.forEach(c => list.appendChild(c));
}

function scrollToReply(replyId) {
    if (!replyId) return;
    window._pendingTargetReplyId = replyId;
    let attempts = 0;
    const interval = setInterval(() => {
        attempts++;
        const el = document.getElementById('reply-' + replyId);
        if (el) {
            clearInterval(interval);
            window._pendingTargetReplyId = null;
            el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            el.classList.add('ring-4', 'ring-indigo-400', 'bg-indigo-50/90', 'p-3', 'rounded-2xl', 'transition-all');
            setTimeout(() => {
                el.classList.remove('ring-4', 'ring-indigo-400', 'bg-indigo-50/90');
            }, 3500);
        } else if (attempts > 30) {
            clearInterval(interval);
            window._pendingTargetReplyId = null;
        }
    }, 150);
}
window.scrollToReply = scrollToReply;

// ─── OPEN THREAD MODAL ───────────────────────────────────────────────────────
async function openThread(forumId) {
    currentForumId = forumId;
    activeParentId = null;

    // Record view asynchronously
    fetch('/api/forum/' + forumId + '/view', { method: 'POST' }).catch(() => {});

    document.getElementById('activeForumId').value = forumId;
    document.getElementById('threadModal').classList.remove('hidden');
    document.getElementById('repliesContainer').innerHTML = buildLoadingHTML();

    // Find forum data from injected array
    const forum = ALL_FORUMS.find(f => String(f.forum_id) === String(forumId));
    if (forum) {
        document.getElementById('modalTitle').textContent = forum.title;
        document.getElementById('modalSubjectBadge').textContent = forum.subject_name || 'General';
        const topicBadge = document.getElementById('modalTopicBadge');
        if (forum.topic_name) { topicBadge.textContent = forum.topic_name; topicBadge.classList.remove('hidden'); }
        else topicBadge.classList.add('hidden');

        // Done badge
        if (forum.is_done) document.getElementById('modalDoneBadge').classList.replace('hidden','inline-flex');
        else document.getElementById('modalDoneBadge').classList.replace('inline-flex','hidden');
    }

    // Fetch full topic details
    try {
        const res   = await fetch(`/api/forum-topic/${forumId}`);
        const topic = await res.json();
        document.getElementById('threadContent').textContent = (topic.forum_content || '').trim() || '(No topic description)';
        document.getElementById('threadMeta').innerHTML = `<i class="fas fa-user text-[10px]"></i> ${topic.teacher_name} &nbsp;·&nbsp; <i class="fas fa-clock text-[10px]"></i> ${new Date(topic.created_at).toLocaleString()}`;
        document.getElementById('teacherNameLabel').textContent = topic.teacher_name;
        if (topic.teacher_pic) document.getElementById('teacherAvatar').src = `/profile_uploads/${topic.teacher_pic}`;
    } catch (e) { console.error(e); }

    cancelReply();
    await loadReplies();
    await loadMembers(forumId);

    if (refreshTask) clearInterval(refreshTask);
    refreshTask = setInterval(loadReplies, 7000);
}

// ─── LOAD REPLIES ────────────────────────────────────────────────────────────
async function loadReplies() {
    if (!currentForumId) return;
    const container = document.getElementById('repliesContainer');

    try {
        const res  = await fetch(`/api/forum-replies/${currentForumId}`);
        const data = await res.json();
        currentReplies = data;

        document.getElementById('replyCount').textContent =
            data.length ? `${data.length} repl${data.length === 1 ? 'y' : 'ies'}` : 'No replies yet';

        renderReplies(data, document.getElementById('replySearch').value);
        updateFilesList(data);

        // After first load, scroll to last reply with animation (unless deep-linking to a specific reply)
        if (container._firstLoad === undefined) {
            container._firstLoad = true;
            if (!window._pendingTargetReplyId) {
                setTimeout(() => scrollToLatest(true), 200);
            }
        }

        // Check if student has replied → mark forum done
        const hasReplied = data.some(r => r.user_id === CURRENT_USER_ID);
        if (hasReplied) markForumDone(currentForumId);

    } catch (e) {
        console.error('Error loading replies:', e);
        container.innerHTML = `<div class="text-center py-12 text-red-400"><i class="fas fa-exclamation-triangle text-2xl mb-2"></i><p class="text-sm">Failed to load replies.</p></div>`;
    }
}

function renderReplies(replies, searchQuery = '') {
    const container = document.getElementById('repliesContainer');
    const q = (searchQuery || '').toLowerCase().trim();

    const filtered = q ? replies.filter(r =>
        (r.reply_content || '').toLowerCase().includes(q) ||
        (r.first_name + ' ' + r.last_name).toLowerCase().includes(q)
    ) : replies;

    if (filtered.length === 0) {
        container.innerHTML = q
            ? `<div class="text-center py-12 text-slate-400"><i class="fas fa-search text-2xl mb-2"></i><p class="text-sm">No replies match "<strong>${q}</strong>"</p></div>`
            : `<div class="text-center py-16 text-slate-300"><i class="fas fa-comments text-4xl mb-3"></i><p class="font-semibold text-slate-400">No insights yet. Be the first!</p></div>`;
        return;
    }

    container.innerHTML = filtered.map(reply => buildReplyHTML(reply, q)).join('');
}

function buildReplyHTML(reply, hl = '') {
    const isOwn    = reply.user_id === CURRENT_USER_ID;
    const isNested = reply.parent_reply_id !== null;
    const avatar   = `/profile_uploads/${reply.profile_pic || 'default_avatar.png'}`;
    const fullName = `${reply.first_name} ${reply.last_name}`;
    const timeStr  = formatTimeAgo(reply.created_at);

    let content = escHtml(reply.reply_content || '').replace(/\n/g, '<br>');
    if (hl) content = content.replace(new RegExp(escHtml(hl), 'gi'), m => `<mark class="search-hl">${m}</mark>`);

    // Media preview
    let mediaHTML = '';
    if (reply.file_path) {
        const mt = reply.file_type || '';
        if (mt.startsWith('image/')) {
            mediaHTML = `<div class="media-preview mt-2"><img src="/forum_uploads/${reply.file_path}" onclick="openLightbox('/forum_uploads/${reply.file_path}')" alt="${escHtml(reply.file_name || 'image')}"></div>`;
        } else if (mt.startsWith('video/')) {
            mediaHTML = `<div class="media-preview mt-2"><video controls src="/forum_uploads/${reply.file_path}"></video></div>`;
        } else {
            const icon = mt.includes('pdf') ? 'fa-file-pdf text-red-500' : mt.includes('word') || mt.includes('doc') ? 'fa-file-word text-blue-500' : 'fa-file text-slate-400';
            mediaHTML = `<a href="/forum_uploads/${reply.file_path}" download class="inline-flex items-center gap-2 mt-2 px-3 py-2 bg-slate-100 hover:bg-slate-200 rounded-xl text-xs font-bold text-slate-600 transition">
                <i class="fas ${icon}"></i> ${escHtml(reply.file_name || 'Download File')}</a>`;
        }
    }

    return `
    <div class="reply-bubble flex gap-3 ${isNested ? 'ml-10 pl-4 border-l-2 border-indigo-100' : ''}" id="reply-${reply.reply_id}">
        <img src="${avatar}" class="w-9 h-9 rounded-xl object-cover ring-2 ring-white shadow-sm flex-shrink-0 mt-0.5">
        <div class="flex-1 min-w-0">
            <div class="bg-white rounded-2xl px-4 py-3 shadow-sm border border-slate-100 ${isOwn ? 'border-indigo-100 bg-indigo-50/30' : ''}">
                <div class="flex items-center justify-between gap-2 mb-1.5">
                    <div class="flex items-center gap-2">
                        <span class="text-xs font-extrabold ${isOwn ? 'text-indigo-600' : 'text-slate-700'}">${escHtml(fullName)}</span>
                        ${isOwn ? `<span class="text-[9px] font-black px-1.5 py-0.5 bg-indigo-100 text-indigo-600 rounded-full uppercase">You</span>` : ''}
                        ${reply.role === 'Teacher' ? `<span class="text-[9px] font-black px-1.5 py-0.5 bg-amber-100 text-amber-700 rounded-full uppercase"><i class="fas fa-chalkboard-teacher mr-0.5"></i>Teacher</span>` : ''}
                    </div>
                    <span class="text-[10px] text-slate-300 whitespace-nowrap">${timeStr}</span>
                </div>
                <p class="text-sm text-slate-700 leading-relaxed break-words">${content}</p>
                ${mediaHTML}
            </div>
            <div class="flex items-center gap-3 mt-1.5 px-1">
                <button onclick="setParentReply('${escHtml(reply.first_name)}', ${reply.reply_id})"
                    class="text-[11px] text-slate-400 hover:text-indigo-600 font-bold transition flex items-center gap-1">
                    <i class="fas fa-reply text-[9px]"></i> Reply
                </button>
                ${!isOwn ? `
                <button onclick="openPM(${reply.user_id}, '${escHtml(fullName)}', '${reply.profile_pic || 'default_avatar.png'}')"
                    class="text-[11px] text-slate-400 hover:text-blue-600 font-bold transition flex items-center gap-1">
                    <i class="fas fa-paper-plane text-[9px]"></i> Message
                </button>` : ''}
            </div>
        </div>
    </div>`;
}

// ─── SCROLL TO LATEST ────────────────────────────────────────────────────────
function scrollToLatest(animate = false) {
    const container = document.getElementById('repliesContainer');
    const lastReply = container.lastElementChild;
    if (!lastReply) return;
    if (animate) {
        lastReply.style.transition = 'box-shadow 0.5s';
        lastReply.style.boxShadow = '0 0 0 3px rgba(99,102,241,0.3)';
        setTimeout(() => { lastReply.style.boxShadow = ''; }, 1200);
    }
    lastReply.scrollIntoView({ behavior: 'smooth', block: 'end' });
}

// ─── REPLY SEARCH ────────────────────────────────────────────────────────────
let searchDebounce;
function searchReplies(val) {
    clearTimeout(searchDebounce);
    searchDebounce = setTimeout(() => renderReplies(currentReplies, val), 180);
}

// ─── LOAD MEMBERS ────────────────────────────────────────────────────────────
async function loadMembers(forumId) {
    const list = document.getElementById('membersList');
    list.innerHTML = buildLoadingHTML('small');
    try {
        const res  = await fetch(`/api/forum-members/${forumId}`);
        const data = await res.json();
        if (!data.length) { list.innerHTML = `<p class="text-xs text-slate-400 text-center py-4">No participants yet.</p>`; return; }

        list.innerHTML = data.map(m => {
            const isMe      = m.user_id === CURRENT_USER_ID;
            const isTeacher = m.role === 'Teacher';
            return `
            <div class="flex items-center gap-3 p-2.5 rounded-xl hover:bg-slate-50 transition group">
                <img src="/profile_uploads/${m.profile_pic || 'default_avatar.png'}" class="w-9 h-9 rounded-xl object-cover ring-2 ring-white shadow-sm flex-shrink-0">
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-extrabold text-slate-700 leading-tight truncate">${escHtml(m.first_name)} ${escHtml(m.last_name)}</p>
                    <p class="text-[10px] ${isTeacher ? 'text-amber-600 font-bold' : 'text-slate-400'}">${isTeacher ? '📚 Teacher' : isMe ? '👤 You' : '🎓 Student'}</p>
                </div>
                ${!isMe ? `
                <button onclick="openPM(${m.user_id}, '${escHtml(m.first_name + ' ' + m.last_name)}', '${m.profile_pic || 'default_avatar.png'}')"
                    class="opacity-0 group-hover:opacity-100 w-7 h-7 flex items-center justify-center rounded-lg bg-blue-50 text-blue-500 hover:bg-blue-100 transition text-xs" title="Send message">
                    <i class="fas fa-paper-plane text-[10px]"></i>
                </button>` : ''}
            </div>`;
        }).join('');
    } catch (e) { list.innerHTML = `<p class="text-xs text-red-400 text-center py-4">Failed to load members.</p>`; }
}

// ─── FILES PANEL ─────────────────────────────────────────────────────────────
function updateFilesList(replies) {
    const panel = document.getElementById('filesList');
    const withFiles = replies.filter(r => r.file_path);

    if (!withFiles.length) {
        panel.innerHTML = `<div class="text-center py-8 text-slate-300"><i class="fas fa-folder-open text-3xl mb-2"></i><p class="text-xs text-slate-400">No files uploaded yet.</p></div>`;
        return;
    }

    panel.innerHTML = withFiles.map(r => {
        const mt   = r.file_type || '';
        const icon = mt.startsWith('image/') ? 'fa-image text-blue-400' :
                     mt.startsWith('video/') ? 'fa-film text-purple-400' :
                     mt.includes('pdf')      ? 'fa-file-pdf text-red-400' :
                     mt.includes('word') || mt.includes('doc') ? 'fa-file-word text-blue-500' : 'fa-file text-slate-400';
        const preview = mt.startsWith('image/')
            ? `<img src="/forum_uploads/${r.file_path}" onclick="openLightbox('/forum_uploads/${r.file_path}')" class="w-full h-20 object-cover rounded-xl mb-2 cursor-zoom-in hover:opacity-90 transition">`
            : `<div class="w-full h-12 bg-slate-50 rounded-xl mb-2 flex items-center justify-center"><i class="fas ${icon} text-2xl"></i></div>`;

        return `
        <div class="border border-slate-100 rounded-2xl p-3 hover:border-indigo-100 hover:bg-indigo-50/20 transition">
            ${preview}
            <p class="text-[11px] font-bold text-slate-700 truncate mb-0.5">${escHtml(r.file_name || 'File')}</p>
            <p class="text-[10px] text-slate-400 mb-2">By ${escHtml(r.first_name)} · ${formatTimeAgo(r.created_at)}</p>
            <a href="/forum_uploads/${r.file_path}" download
                class="block w-full text-center text-[10px] font-bold py-1.5 bg-slate-100 hover:bg-slate-200 rounded-lg text-slate-600 transition">
                <i class="fas fa-download mr-1"></i> Download
            </a>
        </div>`;
    }).join('');
}

// ─── MARK FORUM DONE ─────────────────────────────────────────────────────────
async function markForumDone(forumId) {
    if (!forumId || window._markingDoneInProgress) return;
    const badgeId = `done-${forumId}`;
    if (document.getElementById(badgeId)) return; // Already marked done, exit early

    window._markingDoneInProgress = true;
    try {
        await fetch('/api/forum-done', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ forum_id: forumId })
        });
        // Update the card badge in the list
        if (!document.getElementById(badgeId)) {
            // Find the right card
            const allCards = document.querySelectorAll('.forum-card');
            allCards.forEach(c => {
                const btn = c.querySelector(`button[onclick*="${forumId}"]`);
                if (btn) {
                    const badgesArea = c.querySelector('.flex.flex-wrap.items-center');
                    if (badgesArea && !c.querySelector('.done-badge')) {
                        badgesArea.insertAdjacentHTML('afterbegin',
                            `<span id="done-${forumId}" class="done-badge inline-flex items-center gap-1 bg-emerald-100 text-emerald-700 text-[9px] font-black px-2 py-0.5 rounded-full uppercase tracking-wide badge-pop"><i class="fas fa-check-circle"></i> Done</span>`
                        );
                    }
                }
            });
        }
        // Update modal badge
        const modalBadge = document.getElementById('modalDoneBadge');
        if (modalBadge) modalBadge.classList.replace('hidden','inline-flex');
    } catch (e) { /* silent */ } finally {
        window._markingDoneInProgress = false;
    }
}

// ─── QUICK REACTIONS ─────────────────────────────────────────────────────────
async function sendReaction(emoji, label, evt) {
    if (!currentForumId) return;
    const btn = evt.currentTarget;
    btn.classList.add('popped');
    setTimeout(() => btn.classList.remove('popped'), 300);

    // Float animation
    const float = document.createElement('div');
    float.className = 'emoji-float';
    float.textContent = emoji;
    const rect = btn.getBoundingClientRect();
    float.style.left = rect.left + rect.width / 2 + 'px';
    float.style.top  = rect.top + 'px';
    document.body.appendChild(float);
    setTimeout(() => float.remove(), 1300);

    // Send as a quick message reply
    try {
        const fd = new FormData();
        fd.append('forum_id',   currentForumId);
        fd.append('reply_text', emoji + ' ' + label);
        fd.append('parent_id',  '');
        await fetch('/api/forum-reply', { method: 'POST', body: fd });
        await loadReplies();
        scrollToLatest();
    } catch (e) { console.error(e); }
}

// ─── REPLY FORM ───────────────────────────────────────────────────────────────
function setParentReply(name, id) {
    activeParentId = id;
    document.getElementById('replyIndicator').classList.remove('hidden');
    document.getElementById('replyTargetText').innerHTML = `<i class="fas fa-reply"></i> Replying to <strong>${escHtml(name)}</strong>`;
    const ta = document.getElementById('replyContent');
    ta.placeholder = `Reply to ${name}…`;
    ta.focus();
}

function cancelReply() {
    activeParentId = null;
    document.getElementById('replyIndicator').classList.add('hidden');
    document.getElementById('replyContent').placeholder = 'Write your insight here…';
}

function previewAttachment(input) {
    const prev = document.getElementById('attachPreview');
    if (input.files[0]) {
        prev.textContent = input.files[0].name;
        prev.classList.remove('hidden');
    } else {
        prev.classList.add('hidden');
    }
}

document.getElementById('replyForm').addEventListener('submit', async function(e) {
    e.preventDefault();
    const btn = this.querySelector('button[type=submit]');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i> Posting…';

    const fd = new FormData();
    fd.append('forum_id',   document.getElementById('activeForumId').value);
    fd.append('reply_text', document.getElementById('replyContent').value);
    fd.append('parent_id',  activeParentId !== null ? activeParentId : '');
    const file = document.getElementById('replyFile').files[0];
    if (file) fd.append('file', file);

    try {
        const res  = await fetch('/api/forum-reply', { method: 'POST', body: fd });
        const raw  = await res.text();
        let data;
        try { data = JSON.parse(raw); } catch { throw new Error('Server error'); }

        if (!res.ok || !data.success) throw new Error(data.error || 'Post failed');

        document.getElementById('replyContent').value = '';
        document.getElementById('replyFile').value = '';
        document.getElementById('attachPreview').classList.add('hidden');
        cancelReply();
        await loadReplies();
        scrollToLatest(true);

        // Mark done
        await markForumDone(currentForumId);
    } catch (err) {
        alert('Error: ' + err.message);
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-paper-plane text-xs"></i> Post Insight';
    }
});

// ─── PRIVATE MESSAGE ─────────────────────────────────────────────────────────
function openPM(userId, name, pic) {
    pmRecipientId = userId;
    document.getElementById('pmRecipientName').textContent = name;
    document.getElementById('pmAvatar').src = `/profile_uploads/${pic}`;
    document.getElementById('pmContent').value = '';
    document.getElementById('pmModal').classList.remove('hidden');
    setTimeout(() => document.getElementById('pmContent').focus(), 100);
}
function closePM() {
    pmRecipientId = null;
    document.getElementById('pmModal').classList.add('hidden');
}
async function sendPM() {
    const msg = document.getElementById('pmContent').value.trim();
    if (!msg || !pmRecipientId) return;
    try {
        const res  = await fetch('/api/send-message', {
            method:  'POST',
            headers: { 'Content-Type': 'application/json' },
            body:    JSON.stringify({ receiver_id: pmRecipientId, message: msg })
        });
        const data = await res.json();
        if (data.success) { closePM(); showToast('Message sent!', 'success'); }
        else throw new Error(data.error || 'Failed');
    } catch (e) { alert('Error: ' + e.message); }
}

// ─── MOBILE TABS ─────────────────────────────────────────────────────────────
function switchTab(tab) {
    ['discussion','members','files'].forEach(t => {
        const col = document.getElementById(`col-${t}`);
        const btn = document.getElementById(`tab-${t}`);
        if (t === tab) {
            col.classList.remove('hidden');
            btn.classList.add('tab-active');
            btn.classList.remove('text-slate-400');
        } else {
            col.classList.add('hidden');
            btn.classList.remove('tab-active');
            btn.classList.add('text-slate-400');
        }
    });
}

// ─── LIGHTBOX ────────────────────────────────────────────────────────────────
function openLightbox(src) {
    document.getElementById('lightboxImg').src = src;
    document.getElementById('lightbox').classList.remove('hidden');
}
function closeLightbox() { document.getElementById('lightbox').classList.add('hidden'); }

// ─── CLOSE MODAL ────────────────────────────────────────────────────────────
function closeModal() {
    document.getElementById('threadModal').classList.add('hidden');
    if (refreshTask) clearInterval(refreshTask);
    currentForumId = null;
    currentReplies = [];
    document.getElementById('repliesContainer')._firstLoad = undefined;
    document.getElementById('replySearch').value = '';
}

// ─── TOAST ───────────────────────────────────────────────────────────────────
function showToast(msg, type = 'success') {
    const t = document.createElement('div');
    t.className = `fixed bottom-6 right-6 z-[300] px-5 py-3 rounded-2xl shadow-xl text-sm font-bold text-white transition-all ${type === 'success' ? 'bg-emerald-500' : 'bg-red-500'}`;
    t.textContent = msg;
    document.body.appendChild(t);
    setTimeout(() => { t.style.opacity = '0'; setTimeout(() => t.remove(), 400); }, 2500);
}

// ─── HELPERS ─────────────────────────────────────────────────────────────────
function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#39;');
}

function buildLoadingHTML(size = 'normal') {
    return size === 'small'
        ? `<div class="flex justify-center py-4"><div class="animate-spin rounded-full h-5 w-5 border-b-2 border-indigo-500"></div></div>`
        : `<div class="flex flex-col items-center justify-center py-16 text-slate-400">
            <div class="animate-spin rounded-full h-10 w-10 border-b-2 border-indigo-500 mb-3"></div>
            <p class="text-xs font-bold uppercase tracking-wider">Loading discussion…</p>
           </div>`;
}

function formatTimeAgo(dateStr) {
    if (!dateStr) return '';
    const diff = Math.floor((Date.now() - new Date(dateStr)) / 1000);
    if (diff < 60)    return 'Just now';
    if (diff < 3600)  return `${Math.floor(diff/60)}m ago`;
    if (diff < 86400) return `${Math.floor(diff/3600)}h ago`;
    return new Date(dateStr).toLocaleDateString('en-US',{month:'short',day:'numeric'});
}

// ─── NOTIFICATIONS ───────────────────────────────────────────────────────────
function toggleNotifications() {
    const panel   = document.getElementById('notification-panel');
    const overlay = document.getElementById('notification-overlay');

    if (!panel || !overlay) return;

    if (panel.classList.contains('translate-x-full')) {
        panel.classList.remove('translate-x-full');
        overlay.classList.remove('hidden');
        setTimeout(() => overlay.classList.add('opacity-100'), 10);
        if (window.NotificationHub) {
            NotificationHub.loadNotifications('notification-list', false);
        }
    } else {
        panel.classList.add('translate-x-full');
        overlay.classList.remove('opacity-100');
        setTimeout(() => overlay.classList.add('hidden'), 300);
    }
}

// ─── SIDEBAR / USER MENU ─────────────────────────────────────────────────────
function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const main = document.getElementById('mainContent');
    const header = document.querySelector('header');
    
    if (window.innerWidth < 768) {
        sidebar.classList.toggle('sidebar-open');
        sidebar.classList.toggle('sidebar-collapsed');
        overlay.classList.toggle('hidden');
    } else {
        sidebar.classList.toggle('sidebar-collapsed');
        if (main) main.classList.toggle('sidebar-collapsed-main');
        if (header) header.classList.toggle('sidebar-collapsed-header');
    }
}
function toggleUserMenu(e) {
    if (e) e.stopPropagation();
    const dropdown = document.getElementById('userDropdown');
    const btn = document.getElementById('userMenuBtn');
    if (!dropdown) return;
    const isExpanded = !dropdown.classList.contains('hidden');
    dropdown.classList.toggle('hidden');
    if (btn) btn.setAttribute('aria-expanded', !isExpanded);
}

window.addEventListener('click', function(e) {
    const dropdown = document.getElementById('userDropdown');
    const btn = document.getElementById('userMenuBtn');
    if (dropdown && !dropdown.classList.contains('hidden')) {
        if (!dropdown.contains(e.target) && (!btn || !btn.contains(e.target))) {
            dropdown.classList.add('hidden');
            if (btn) btn.setAttribute('aria-expanded', 'false');
        }
    }
});
</script>
<script src="/js/notificationHub.js"></script>
</body>
</html>
