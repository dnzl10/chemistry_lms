<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forums | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800;900&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; }


        /* ── MODAL ── */
        @keyframes modalSlideUp {
            from { opacity: 0; transform: translateY(32px) scale(0.97); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }
        .modal-enter { animation: modalSlideUp 0.28s cubic-bezier(0.34,1.56,0.64,1) forwards; }

        /* Reply bubbles */
        .reply-bubble { transition: background 0.15s; }
        .reply-bubble:hover { background: #f8fafc; }

        /* Highlight search match */
        .search-hl { background: #fef08a; border-radius: 2px; padding: 0 1px; }

        /* Quick-react bar */
        .react-btn { transition: transform 0.15s, background 0.15s; }
        .react-btn:hover { transform: scale(1.25); }
        .react-btn.popped { animation: pop 0.25s ease; }
        @keyframes pop { 0%{transform:scale(1)} 50%{transform:scale(1.45)} 100%{transform:scale(1)} }

        /* Image / video media preview */
        .media-preview img { border-radius: 12px; max-height: 260px; object-fit: cover; cursor: zoom-in; }
        .media-preview video { border-radius: 12px; max-height: 240px; width: 100%; }

        /* Emoji float animation */
        @keyframes floatUp {
            0%   { opacity: 1; transform: translateY(0) scale(1.2); }
            100% { opacity: 0; transform: translateY(-60px) scale(0.8); }
        }
        .emoji-float { position: fixed; pointer-events: none; font-size: 24px;
            animation: floatUp 1.2s ease-out forwards; z-index: 9999; }

        /* Pulse badge */
        @keyframes badgePop { 0%{transform:scale(0)} 70%{transform:scale(1.15)} 100%{transform:scale(1)} }
        .badge-pop { animation: badgePop 0.35s cubic-bezier(0.34,1.56,0.64,1) forwards; }

        /* Thin scrollbar for modal panels */
        .thin-scroll::-webkit-scrollbar { width: 4px; }
        .thin-scroll::-webkit-scrollbar-track { background: transparent; }
        .thin-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 99px; }

        /* Private message modal */
        @keyframes pmSlide {
            from { opacity:0; transform:translateY(20px); }
            to   { opacity:1; transform:translateY(0); }
        }
        .pm-enter { animation: pmSlide 0.22s ease forwards; }

        /* Tab underline */
    </style>

    <!-- Standardized Student Navigation & Responsive Styles -->
    <%- include('partials/student-nav-styles') %>
</head>
<body class="bg-slate-50 text-slate-900 h-screen overflow-hidden">

<div class="flex h-screen w-full overflow-hidden">
    <!-- Standardized Student Sidebar Partial -->
    <%- include('partials/student-sidebar', { activeNav: 'forums' }) %>

    <!-- ══════════ MAIN ══════════ -->
    <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden transition-all duration-300">

        <!-- HEADER -->
        <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 flex-shrink-0 z-40">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <div>
                    <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">
                        Welcome, <%= user.first_name %>!
                    </h1>
                    <p class="text-xs text-slate-600 hidden sm:block font-medium">
                        <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                        Chemistry Enthusiast &nbsp;·&nbsp; <%= new Date().toLocaleDateString('en-PH', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3 md:gap-6">
                <!-- Messages Navigation Button (Entry point to message-student view) -->
                <a href="/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                    <i class="far fa-comment-dots text-xl"></i>
                    <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                        <span class="msg-badge-count">0</span>
                    </span>
                    <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                        Messages
                    </span>
                </a>

                <!-- Notification Button with keyboard-accessible tooltip -->
                <button type="button" onclick="toggleNotifications()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                    <i class="far fa-bell text-xl text-slate-700"></i>
                    <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center notif-badge hidden" aria-hidden="true">
                        <span class="notif-badge-count">0</span>
                    </span>
                    <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                        Notifications
                    </span>
                </button>
                
                <!-- User Profile Dropdown -->
                <div class="relative">
                    <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                        <div class="text-right hidden lg:block">
                            <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none"><%= user.role %></p>
                        </div>
                        <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100">
                        <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                    </button>

                    <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                        <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                            <p class="text-sm font-bold text-slate-800"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role %></p>
                        </div>
                        <a href="/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                            <i class="far fa-user w-5 text-center"></i> View Profile
                        </a>
                        <hr class="my-2 border-slate-100">
                        <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                            <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- PAGE BODY -->
        <div class="flex-1 flex flex-col md:flex-row min-h-0 overflow-hidden">

            <!-- LEFT SIDEBAR: Stats + Subject filter (Pinned) -->
            <aside class="w-full md:w-72 bg-white border-r border-slate-200 overflow-y-auto p-5 space-y-6 flex-shrink-0 no-scrollbar h-full">
                <!-- Stat card -->
                <div class="bg-gradient-to-br from-indigo-600 via-blue-600 to-cyan-500 rounded-3xl p-5 text-white shadow-xl relative overflow-hidden">
                    <div class="absolute -right-4 -top-4 w-24 h-24 bg-white/10 rounded-full"></div>
                    <div class="absolute -right-2 -bottom-6 w-16 h-16 bg-white/10 rounded-full"></div>
                    <p class="text-[10px] font-bold opacity-70 uppercase tracking-widest mb-1">Activity Rank</p>
                    <p class="text-4xl font-black leading-none"><%= totalParticipated %></p>
                    <p class="text-xs opacity-80 mt-1">Discussions Joined</p>
                    <div class="mt-4 pt-4 border-t border-white/20 flex items-center gap-2">
                        <i class="fas fa-award text-yellow-300 text-lg"></i>
                        <span class="text-[11px] font-extrabold uppercase tracking-wide">
                            <%= totalParticipated >= 10 ? 'Master Alchemist' : totalParticipated >= 5 ? 'Active Alchemist' : 'Novice Scholar' %>
                        </span>
                    </div>
                </div>

                <!-- Subject filter nav -->
                <div>
                    <h4 class="text-[10px] font-black text-slate-400 uppercase tracking-widest px-2 mb-3">Filter by Subject</h4>
                    <div class="space-y-1">
                        <button onclick="filterBySubject('all', this)"
                            class="subject-btn w-full flex items-center gap-3 p-3 rounded-xl bg-blue-50 text-blue-600 font-bold text-sm transition-all cursor-pointer">
                            <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-blue-100"><i class="fas fa-globe text-blue-600 text-xs"></i></span>
                            <span>All Subjects</span>
                            <span class="ml-auto text-[10px] bg-blue-100 text-blue-600 font-black px-2 py-0.5 rounded-full" id="countAll"></span>
                        </button>
                        <%
                        // Strictly populate from officially enrolled subjects
                        const subjectFilterList = (typeof subjects !== 'undefined' && Array.isArray(subjects) && subjects.length > 0)
                            ? subjects
                            : ((typeof enrolledSubjects !== 'undefined' && Array.isArray(enrolledSubjects) && enrolledSubjects.length > 0)
                                ? enrolledSubjects
                                : []);
                        
                        subjectFilterList.forEach(sub => { %>
                        <button onclick="filterBySubject('<%= sub.subject_id %>', this)"
                            data-subject="<%= sub.subject_id %>"
                            class="subject-btn w-full flex items-center gap-3 p-3 rounded-xl text-slate-600 hover:bg-slate-50 font-semibold text-sm transition-all cursor-pointer">
                            <span class="w-8 h-8 flex items-center justify-center rounded-lg bg-emerald-50"><i class="fas fa-flask text-emerald-500 text-xs"></i></span>
                            <span class="truncate text-left flex-1"><%= sub.subject_name %></span>
                            <span class="ml-auto text-[10px] bg-slate-100 text-slate-500 font-black px-2 py-0.5 rounded-full subject-count" data-for="<%= sub.subject_id %>"></span>
                        </button>
                        <% }) %>
                    </div>
                </div>
            </aside>

            <!-- MAIN FORUM LIST (Scrollable Discussion Feed) -->
            <section class="flex-1 bg-slate-50/60 overflow-y-auto p-4 md:p-8 no-scrollbar h-full">
                <div class="mb-6 space-y-4">
                    <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
                        <div>
                            <h2 class="text-2xl font-black text-slate-800 tracking-tight">Chemistry Commons</h2>
                            <p class="text-sm text-slate-500 mt-0.5">Engage with professors and peers — <span id="forumCountLabel" class="font-bold text-slate-700"></span></p>
                        </div>
                        <div class="flex items-center gap-2">
                            <span class="text-xs font-bold text-slate-400 uppercase tracking-wider">Sort:</span>
                            <select onchange="sortForums(this.value)" class="text-sm font-bold bg-white border border-slate-200 rounded-xl px-3 py-2 outline-none focus:ring-2 focus:ring-blue-500 shadow-2xs cursor-pointer">
                                <option value="pinned">Pinned First</option>
                                <option value="newest">Newest</option>
                                <option value="most_replies">Most Replies</option>
                            </select>
                        </div>
                    </div>

                    <!-- Search Discussions Input -->
                    <div class="relative">
                        <div class="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-slate-400">
                            <i class="fas fa-search text-sm"></i>
                        </div>
                        <input type="text"
                               id="globalSearch"
                               oninput="filterForumCards(this.value)"
                               placeholder="Search discussions by topic, title, keywords, or content..."
                               class="w-full pl-10 pr-10 py-2.5 bg-white border border-slate-200 rounded-2xl text-sm font-medium text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-blue-500 shadow-xs transition-all">
                        <button type="button"
                                id="clearSearchBtn"
                                onclick="clearSearchInput()"
                                class="hidden absolute inset-y-0 right-0 pr-3.5 flex items-center text-slate-400 hover:text-slate-600 transition cursor-pointer"
                                title="Clear search">
                            <i class="fas fa-times-circle text-sm"></i>
                        </button>
                    </div>
                </div>

                <div id="forumList" class="space-y-3">
                    <% 
                    const enrolledSubjectIdList = (typeof subjects !== 'undefined' && Array.isArray(subjects) && subjects.length > 0)
                        ? subjects.map(s => String(s.subject_id))
                        : ((typeof enrolledSubjects !== 'undefined' && Array.isArray(enrolledSubjects) && enrolledSubjects.length > 0)
                            ? enrolledSubjects.map(s => String(s.subject_id))
                            : []);
                    const filteredForumsList = enrolledSubjectIdList.length > 0
                        ? forums.filter(f => enrolledSubjectIdList.includes(String(f.subject_id)))
                        : [];
                    filteredForumsList.forEach(forum => { %>
                    <div class="forum-card bg-white rounded-2xl border border-slate-200 shadow-sm hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 overflow-hidden cursor-pointer"
                         onclick="window.location.href='/forums/view/<%= forum.forum_id %>'"
                         data-subject="<%= forum.subject_id || 'all' %>"
                         data-title="<%= (forum.title || '').toLowerCase() %>"
                         data-topic="<%= (forum.topic_name || '').toLowerCase() %>"
                         data-content="<%= (forum.forum_content || '').toLowerCase().replace(/"/g, '&quot;') %>"
                         data-pinned="<%= forum.is_pinned ? '1' : '0' %>"
                         data-replies="<%= forum.reply_count || 0 %>"
                         data-created="<%= forum.created_at %>">

                        <% if (forum.is_pinned) { %>
                        <div class="h-1 bg-gradient-to-r from-amber-400 to-orange-400"></div>
                        <% } else if (forum.is_done) { %>
                        <div class="h-1 bg-gradient-to-r from-emerald-400 to-teal-400"></div>
                        <% } else { %>
                        <div class="h-1 bg-gradient-to-r from-slate-100 to-slate-200"></div>
                        <% } %>

                        <div class="p-5">
                            <div class="flex flex-col sm:flex-row gap-4">
                                <!-- Teacher avatar -->
                                <div class="flex-shrink-0">
                                    <img src="/profile_uploads/<%= forum.teacher_pic || 'default_avatar.png' %>"
                                        class="w-12 h-12 rounded-2xl object-cover ring-2 ring-slate-100">
                                </div>

                                <!-- Content -->
                                <div class="flex-1 min-w-0">
                                    <div class="flex flex-wrap items-center gap-1.5 mb-2">
                                        <% if (forum.is_pinned) { %>
                                        <span class="inline-flex items-center gap-1 bg-amber-100 text-amber-700 text-[9px] font-black px-2 py-0.5 rounded-full uppercase tracking-wide">
                                            <i class="fas fa-thumbtack"></i> Pinned
                                        </span>
                                        <% } %>
                                        <% if (forum.is_done) { %>
                                        <span class="done-badge inline-flex items-center gap-1 bg-emerald-100 text-emerald-700 text-[9px] font-black px-2 py-0.5 rounded-full uppercase tracking-wide badge-pop" id="done-<%= forum.forum_id %>">
                                            <i class="fas fa-check-circle"></i> Done
                                        </span>
                                        <% } %>
                                        <span class="bg-blue-50 text-blue-600 text-[9px] font-black px-2 py-0.5 rounded-full uppercase tracking-wide">
                                            <%= forum.subject_name || 'General' %>
                                        </span>
                                        <% if (forum.topic_name) { %>
                                        <span class="bg-violet-50 text-violet-600 text-[9px] font-black px-2 py-0.5 rounded-full uppercase tracking-wide">
                                            <%= forum.topic_name %>
                                        </span>
                                        <% } %>
                                    </div>
                                    <h3 class="font-extrabold text-slate-800 text-base leading-snug mb-1"><%= forum.title %></h3>
                                    <p class="text-xs text-slate-400">
                                        Started by <span class="font-bold text-slate-600">Prof. <%= forum.teacher_lname %></span>
                                        · <span class="text-slate-400"><%= new Date(forum.created_at).toLocaleDateString('en-US',{month:'short',day:'numeric',year:'numeric'}) %></span>
                                    </p>
                                </div>

                                <!-- Right: replies + CTA -->
                                <div class="flex flex-row sm:flex-col items-center sm:items-end justify-between sm:justify-center gap-3 flex-shrink-0">
                                    <div class="text-center">
                                        <p class="text-xl font-black text-slate-800 leading-none"><%= forum.reply_count || 0 %></p>
                                        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-wide">Replies</p>
                                    </div>
                                    <a href="/forums/view/<%= forum.forum_id %>"
                                        class="flex items-center gap-2 bg-slate-900 text-white px-4 py-2.5 rounded-xl font-bold text-xs hover:bg-indigo-600 transition-all shadow-sm hover:shadow-indigo-200 hover:shadow-md whitespace-nowrap">
                                        <i class="fas fa-comments text-[10px]"></i> View Discussion
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                    <% }) %>

                    <div id="noResults" class="hidden text-center py-20">
                        <i class="fas fa-search text-4xl text-slate-200 mb-3"></i>
                        <p class="text-slate-400 font-semibold">No forums match your search.</p>
                    </div>
                </div>
            </section>
        </div><!-- /page body -->
    </main>
</div>

<!-- ══════════════════════════════════════════════════════════════════════
     THREAD MODAL — Full Discussion View
══════════════════════════════════════════════════════════════════════ -->
<div id="threadModal" class="fixed inset-0 z-[80] hidden flex items-center justify-center p-2 md:p-4">
    <div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm" onclick="closeModal()"></div>

    <!-- Modal shell: 3-column layout -->
    <div class="relative w-full max-w-7xl h-[95vh] bg-white rounded-3xl shadow-2xl flex flex-col overflow-hidden modal-enter">

        <!-- ── MODAL HEADER ── -->
        <div class="flex-shrink-0 px-6 py-4 border-b border-slate-100 bg-white flex items-start justify-between gap-4">
            <div class="flex-1 min-w-0">
                <div class="flex flex-wrap items-center gap-2 mb-1">
                    <span id="modalSubjectBadge" class="text-[10px] font-black px-2 py-0.5 bg-blue-50 text-blue-600 rounded-full uppercase tracking-wide"></span>
                    <span id="modalTopicBadge" class="text-[10px] font-black px-2 py-0.5 bg-violet-50 text-violet-600 rounded-full uppercase tracking-wide hidden"></span>
                    <span id="modalDoneBadge" class="hidden items-center gap-1 text-[10px] font-black px-2 py-0.5 bg-emerald-100 text-emerald-700 rounded-full uppercase tracking-wide"><i class="fas fa-check-circle"></i> Done</span>
                </div>
                <h3 id="modalTitle" class="font-black text-xl text-slate-800 leading-snug truncate"></h3>
                <p id="threadMeta" class="text-xs text-slate-400 mt-0.5 flex items-center gap-2"></p>
            </div>
            <button onclick="closeModal()" class="flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-xl bg-slate-100 hover:bg-red-50 hover:text-red-500 text-slate-400 transition text-sm">
                <i class="fas fa-times"></i>
            </button>
        </div>

        <!-- ── TABS (mobile) ── -->
        <div class="flex-shrink-0 flex border-b border-slate-100 md:hidden bg-white">
            <button onclick="switchTab('discussion')" class="flex-1 py-3 text-xs font-bold tab-active" id="tab-discussion">💬 Discussion</button>
            <button onclick="switchTab('members')"    class="flex-1 py-3 text-xs font-bold text-slate-400" id="tab-members">👥 Members</button>
            <button onclick="switchTab('files')"      class="flex-1 py-3 text-xs font-bold text-slate-400" id="tab-files">📎 Files</button>
        </div>

        <!-- ── MODAL BODY: 3 columns ── -->
        <div class="flex flex-1 min-h-0 overflow-hidden">

            <!-- COL 1: Discussion + Reply Form -->
            <div id="col-discussion" class="flex flex-col flex-1 min-w-0 border-r border-slate-100">

                <!-- Forum topic content -->
                <div id="topicContentArea" class="flex-shrink-0 px-6 py-4 bg-gradient-to-br from-slate-50 to-blue-50/30 border-b border-slate-100">
                    <div class="flex gap-3 items-start">
                        <img id="teacherAvatar" src="/profile_uploads/default_avatar.png" class="w-10 h-10 rounded-xl object-cover ring-2 ring-white shadow flex-shrink-0">
                        <div class="flex-1 min-w-0">
                            <p id="teacherNameLabel" class="text-xs font-black text-indigo-600 mb-1"></p>
                            <div id="threadContent" class="text-sm text-slate-700 leading-relaxed whitespace-pre-line break-words max-h-28 overflow-y-auto thin-scroll pr-2 rounded-lg"></div>
                        </div>
                    </div>
                </div>

                <!-- Reply search bar -->
                <div class="flex-shrink-0 px-6 py-3 bg-white border-b border-slate-100 flex items-center gap-3">
                    <div class="relative flex-1">
                        <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-300 text-xs"></i>
                        <input id="replySearch" type="text" placeholder="Search replies…" oninput="searchReplies(this.value)"
                            class="w-full pl-8 pr-4 py-2 bg-slate-50 border border-slate-200 rounded-xl text-xs outline-none focus:ring-2 focus:ring-blue-500 transition">
                    </div>
                    <span id="replyCount" class="text-xs font-black text-slate-400 whitespace-nowrap"></span>
                </div>

                <!-- Quick reactions bar -->
                <div class="flex-shrink-0 px-6 py-2.5 bg-white border-b border-slate-100 flex items-center gap-3">
                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-wider">Quick React:</span>
                    <div class="flex gap-1.5">
                        <% [['👍','Like'],['❤️','Heart'],['😢','Sad'],['😮','Wow'],['🤗','Care']].forEach(([emoji, label]) => { %>
                        <button onclick="sendReaction('<%= emoji %>', '<%= label %>', event)"
                            class="react-btn flex items-center gap-1 px-2.5 py-1 bg-slate-50 hover:bg-slate-100 rounded-xl text-xs font-bold text-slate-600 border border-slate-100 transition"
                            title="<%= label %>">
                            <span class="text-base leading-none"><%= emoji %></span>
                        </button>
                        <% }) %>
                    </div>
                </div>

                <!-- Replies container -->
                <div id="repliesContainer" class="flex-1 overflow-y-auto thin-scroll px-6 py-5 space-y-4 bg-slate-50/40"></div>

                <!-- Reply Form -->
                <div class="flex-shrink-0 bg-white border-t border-slate-100 px-6 py-4">
                    <div id="replyIndicator" class="hidden mb-3 flex items-center justify-between bg-indigo-50 border border-indigo-100 px-4 py-2.5 rounded-xl">
                        <p class="text-xs font-bold text-indigo-700 flex items-center gap-2" id="replyTargetText"><i class="fas fa-reply"></i></p>
                        <button type="button" onclick="cancelReply()" class="text-indigo-400 hover:text-red-500 transition text-sm"><i class="fas fa-times"></i></button>
                    </div>
                    <form id="replyForm" class="flex flex-col gap-3" enctype="multipart/form-data">
                        <input type="hidden" id="activeForumId" name="forum_id">
                        <textarea id="replyContent" name="reply_text" required rows="3" placeholder="Write your insight here…"
                            class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl text-sm focus:ring-2 focus:ring-indigo-400 outline-none resize-none transition"></textarea>
                        <div class="flex items-center gap-3">
                            <label class="flex items-center gap-2 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl cursor-pointer hover:bg-slate-100 transition text-xs font-bold text-slate-500">
                                <i class="fas fa-paperclip text-slate-400"></i> Attach File
                                <input type="file" id="replyFile" name="file" class="hidden" accept="image/*,video/*,.pdf,.doc,.docx,.ppt,.pptx" onchange="previewAttachment(this)">
                            </label>
                            <div id="attachPreview" class="hidden flex-1 text-xs text-slate-500 font-medium truncate"></div>
                            <button type="submit" class="ml-auto flex items-center gap-2 px-6 py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-bold text-sm transition shadow-sm hover:shadow-indigo-200 hover:shadow-md">
                                <i class="fas fa-paper-plane text-xs"></i> Post Insight
                            </button>
                        </div>
                    </form>
                </div>
            </div><!-- /col-discussion -->

            <!-- COL 2: Members Panel -->
            <div id="col-members" class="hidden md:flex flex-col w-64 flex-shrink-0 bg-white border-r border-slate-100">
                <div class="flex-shrink-0 px-5 py-4 border-b border-slate-100">
                    <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest flex items-center gap-2"><i class="fas fa-users text-indigo-400"></i> Participants</h4>
                </div>
                <div id="membersList" class="flex-1 overflow-y-auto thin-scroll px-4 py-3 space-y-2"></div>
            </div><!-- /col-members -->

            <!-- COL 3: Files Panel -->
            <div id="col-files" class="hidden md:flex flex-col w-64 flex-shrink-0 bg-white">
                <div class="flex-shrink-0 px-5 py-4 border-b border-slate-100">
                    <h4 class="text-xs font-black text-slate-800 uppercase tracking-widest flex items-center gap-2"><i class="fas fa-folder-open text-amber-400"></i> Uploaded Files</h4>
                </div>
                <div id="filesList" class="flex-1 overflow-y-auto thin-scroll px-4 py-3 space-y-2"></div>
            </div><!-- /col-files -->

        </div><!-- /modal body -->
    </div><!-- /modal shell -->
</div>

<!-- ══════════ PRIVATE MESSAGE MODAL ══════════ -->
<div id="pmModal" class="fixed inset-0 z-[120] hidden flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/60 backdrop-blur-sm" onclick="closePM()"></div>
    <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden pm-enter">
        <div class="px-6 py-5 bg-gradient-to-r from-indigo-600 to-blue-600 text-white flex items-center justify-between">
            <div class="flex items-center gap-3">
                <img id="pmAvatar" src="/profile_uploads/default_avatar.png" class="w-10 h-10 rounded-xl object-cover ring-2 ring-white/30">
                <div>
                    <p class="text-[10px] font-bold opacity-70 uppercase tracking-wider">Private Message</p>
                    <p id="pmRecipientName" class="font-extrabold text-base leading-tight"></p>
                </div>
            </div>
            <button onclick="closePM()" class="w-8 h-8 flex items-center justify-center rounded-xl bg-white/20 hover:bg-white/30 transition"><i class="fas fa-times text-sm"></i></button>
        </div>
        <div class="p-6">
            <textarea id="pmContent" rows="5" placeholder="Type your message here…"
                class="w-full p-4 bg-slate-50 border border-slate-200 rounded-2xl text-sm outline-none focus:ring-2 focus:ring-indigo-400 resize-none transition"></textarea>
            <div class="flex gap-3 mt-4">
                <button onclick="closePM()" class="flex-1 py-3 bg-slate-100 text-slate-600 rounded-2xl font-bold hover:bg-slate-200 transition text-sm">Cancel</button>
                <button onclick="sendPM()" class="flex-1 py-3 bg-indigo-600 text-white rounded-2xl font-bold hover:bg-indigo-700 transition text-sm flex items-center justify-center gap-2">
