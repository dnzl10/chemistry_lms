function confirmAndGetDeviceLocation() {
    closeLocationConfirmModal();
    if (!navigator.geolocation) {
        alert('Geolocation is not supported by your browser.');
        return;
    }
    const previewEl = document.getElementById('mapSelectedAddress');
    if (previewEl) previewEl.textContent = 'Detecting current position...';
    navigator.geolocation.getCurrentPosition(
        (pos) => {
            const lat = pos.coords.latitude;
            const lng = pos.coords.longitude;
            if (leafletMapInstance) {
                leafletMapInstance.setView([lat, lng], 16);
            }
            placeMapPin(lat, lng);
        },
        (err) => {
            alert('Unable to retrieve location: ' + err.message);
            if (previewEl) previewEl.textContent = 'Location access denied or unavailable.';
        },
        { enableHighAccuracy: true, timeout: 10000 }
    );
}

