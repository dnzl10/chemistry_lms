    }

    if (countEl) {
        countEl.innerHTML = `<span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-blue-600 bg-blue-50 px-2.5 py-1 rounded-full border border-blue-200/60 shadow-2xs"><i class="fas fa-calendar-alt text-[10px]"></i> ${upcoming.length} event${upcoming.length > 1 ? 's' : ''} ${isCurrentMonth ? 'this month' : 'in ' + MONTHS[calMonth]}</span>`;
