// ── INIT & FORM SUBMIT LISTENER ──
document.addEventListener('DOMContentLoaded', () => {
    renderCalendar();
    renderAgenda();

    const eventForm = document.getElementById('eventForm');
    if (eventForm) {
        eventForm.addEventListener('submit', function(e) {
            if (isSavingConfirmed) {
                return true;
            }
            e.preventDefault();

            const title = (document.getElementById('formTitle')?.value || '').trim();
            if (!title) {
                alert('Please enter an event title.');
                document.getElementById('formTitle').focus();
                return false;
            }

            const dateVal = document.getElementById('formDate')?.value;
            if (!dateVal) {
                alert('Please choose an event date.');
                document.getElementById('formDate').focus();
                return false;
            }

            const durationType = document.getElementById('durationType').value;
            let timeDisplayStr = '';
            if (durationType === 'DateRange') {
                const start = document.getElementById('formStartDate').value;
                const end = document.getElementById('formEndDate').value;
                if (start && end && new Date(start) > new Date(end)) {
                    alert('End date and time cannot be earlier than start date and time.');
                    document.getElementById('formEndDate').focus();
                    return false;
                }
                if (start && end) {
                    timeDisplayStr = `${new Date(start).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})} – ${new Date(end).toLocaleTimeString([],{hour:'2-digit',minute:'2-digit'})}`;
                }
            } else if (durationType === 'Minutes') {
                const mins = document.getElementById('formMinutes')?.value;
                if (mins) timeDisplayStr = `${mins} minutes`;
            } else {
                timeDisplayStr = 'All Day';
            }

            const subjSelect = document.getElementById('formSubjectId');
            const subjText = subjSelect && subjSelect.selectedIndex > 0 ? subjSelect.options[subjSelect.selectedIndex].text : '';

            openSaveConfirmModal({
                title: title,
                type: document.getElementById('formType')?.value || 'Event',
                subject: subjText,
                date: dateVal,
                time: timeDisplayStr,
                location: (document.getElementById('formLocation')?.value || '').trim()
            });
            return false;
        });
    }
});
</script>

