                    <button onclick="switchView('agenda')" class="px-4 py-2 bg-white hover:bg-slate-50 border border-slate-200 text-slate-600 hover:text-blue-600 rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 hover:border-blue-200 cursor-pointer shadow-2xs">
                        <i class="fas fa-list text-[10px] text-slate-400"></i> View All in Agenda
