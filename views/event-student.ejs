    pendingDeleteId = eventId;
    if (window.ModalManager) {
        ModalManager.open('deleteModal');
    } else {
        document.getElementById('deleteModal').classList.remove('hidden');
    }
    setTimeout(() => document.getElementById('deleteCancelBtn')?.focus(), 50);
