function initOrResizeMap() {
    const canvas = document.getElementById('mapPickerCanvas');
    if (!canvas) return;

    if (typeof L === 'undefined') {
        canvas.innerHTML = `
            <div class="h-full w-full flex flex-col items-center justify-center p-6 text-center text-slate-500">
                <i class="fas fa-spinner fa-spin text-2xl text-blue-600 mb-2"></i>
                <p class="text-xs font-bold">Loading Interactive Map...</p>
            </div>
        `;
        const link = document.createElement('link');
        link.rel = 'stylesheet';
        link.href = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.css';
        document.head.appendChild(link);

        const script = document.createElement('script');
        script.src = 'https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.min.js';
        script.onload = () => {
            canvas.innerHTML = '';
            setupLeaflet();
        };
        document.head.appendChild(script);
        return;
    }

    setupLeaflet();
}

function setupLeaflet() {
    const canvas = document.getElementById('mapPickerCanvas');
    if (!canvas || typeof L === 'undefined') return;

    const defaultLat = 14.5995;
    const defaultLng = 120.9842;

    if (!leafletMapInstance) {
        canvas.innerHTML = '';
        leafletMapInstance = L.map('mapPickerCanvas', {
            zoomControl: true,
            attributionControl: true
        }).setView([defaultLat, defaultLng], 15);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19,
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
        }).addTo(leafletMapInstance);

        leafletMapInstance.on('click', function(e) {
            placeMapPin(e.latlng.lat, e.latlng.lng);
        });
    }

    leafletMapInstance.invalidateSize(true);
    setTimeout(() => leafletMapInstance && leafletMapInstance.invalidateSize(true), 150);
    setTimeout(() => leafletMapInstance && leafletMapInstance.invalidateSize(true), 350);

    const currentLocVal = (document.getElementById('formLocation')?.value || '').trim();
    if (currentLocVal && !leafletMarker) {
        document.getElementById('mapSearchInput').value = currentLocVal;
        searchLocationOnMap(currentLocVal);
    } else if (!leafletMarker) {
        placeMapPin(defaultLat, defaultLng, 'Mabini College Campus / Manila');
    }
}

function placeMapPin(lat, lng, label = null) {
    if (!leafletMapInstance || typeof L === 'undefined') return;
    selectedCoordinates = { lat, lng };

    const customPin = L.divIcon({
        className: 'custom-map-pin',
        html: `
            <div style="background:#2563eb;color:white;width:34px;height:34px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);display:flex;align-items:center;justify-content:center;box-shadow:0 4px 12px rgba(37,99,235,0.4);border:2.5px solid white;">
                <i class="fas fa-location-dot" style="transform:rotate(45deg);font-size:15px;"></i>
            </div>`,
        iconSize: [34, 34],
        iconAnchor: [17, 34]
    });

    if (!leafletMarker) {
        leafletMarker = L.marker([lat, lng], { icon: customPin, draggable: true }).addTo(leafletMapInstance);
        leafletMarker.on('dragend', function(e) {
            const pt = e.target.getLatLng();
            placeMapPin(pt.lat, pt.lng);
        });
    } else {
        leafletMarker.setLatLng([lat, lng]);
    }

    const previewEl = document.getElementById('mapSelectedAddress');
    if (label) {
        selectedLocationText = label;
        if (previewEl) previewEl.textContent = label;
    } else {
        if (previewEl) previewEl.textContent = `Resolving location (${lat.toFixed(4)}, ${lng.toFixed(4)})... `;
        fetch(`https://nominatim.openstreetmap.org/reverse?format=json&lat=${lat}&lon=${lng}`)
            .then(r => r.json())
            .then(data => {
                if (data && data.display_name) {
                    const shortName = data.display_name.split(',').slice(0, 3).join(',').trim();
                    selectedLocationText = shortName;
                    if (previewEl) previewEl.textContent = shortName;
                } else {
                    selectedLocationText = `Location (${lat.toFixed(4)}, ${lng.toFixed(4)})`;
                    if (previewEl) previewEl.textContent = selectedLocationText;
                }
            })
            .catch(() => {
                selectedLocationText = `Location (${lat.toFixed(4)}, ${lng.toFixed(4)})`;
                if (previewEl) previewEl.textContent = selectedLocationText;
            });
    }
}

function searchLocationOnMap(query) {
    const q = (query || document.getElementById('mapSearchInput')?.value || '').trim();
    if (!q) return;
    fetch(`https://nominatim.openstreetmap.org/search?format=json&q=${encodeURIComponent(q)}`)
        .then(res => res.json())
        .then(data => {
            if (data && data.length > 0) {
                const item = data[0];
                const lat = parseFloat(item.lat);
                const lon = parseFloat(item.lon);
                if (leafletMapInstance) {
                    leafletMapInstance.setView([lat, lon], 16);
                }
                const parts = item.display_name.split(',');
                const shortName = parts.slice(0, 3).join(',').trim();
                placeMapPin(lat, lon, shortName);
            }
        })
        .catch(() => {});
}

function setPresetLocation(venueName) {
    selectedLocationText = venueName;
    const previewEl = document.getElementById('mapSelectedAddress');
    if (previewEl) previewEl.textContent = venueName;
