async function confirmDelete() {
    if (!pendingDeleteId) return;
    const deleteId = pendingDeleteId;
    try {
        const resp = await fetch(`/events/delete/${deleteId}`, { method: 'POST' });
        const data = await resp.json().catch(() => ({}));

        if (resp.ok && (data.success !== false)) {
            // Remove from local array with robust string comparison
            const idx = STUDENT_EVENTS.findIndex(e => String(e.event_id) === String(deleteId));
            if (idx !== -1) STUDENT_EVENTS.splice(idx, 1);
            ALL_EVENTS = ALL_EVENTS.filter(e => String(e.event_id) !== String(deleteId));
            
            renderCalendar();
            if (currentView === 'agenda') renderAgenda();
            closeDeleteModal();
        } else {
            alert(data.message || 'Failed to delete event. Please check your network connection and try again.');
            closeDeleteModal();
        }
    } catch (e) {
        console.error('Delete error:', e);
        alert('Network error while attempting to delete event.');
        closeDeleteModal();
    }
}

