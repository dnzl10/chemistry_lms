<!-- ═══════════════════════════════════════════════════════════
     DATA FROM SERVER (injected as JS)
════════════════════════════════════════════════════════════ -->
<script>
// ──── SERVER DATA ────────────────────────────────────────────────────────────
const CURRENT_USER_ID = <%= user.user_id %>;

// calendar_events rows (teacher events that student can see via enrollment)
const TEACHER_EVENTS = <%- JSON.stringify(teacherEvents) %>;

// student's own created events
const STUDENT_EVENTS = <%- JSON.stringify(studentEvents) %>;

// assessment due dates for enrolled assessments
const DUE_DATES = <%- JSON.stringify(dueDates) %>;

// Merge all into one unified list with a source flag
let ALL_EVENTS = [
    ...TEACHER_EVENTS.map(e => ({ ...e, source: 'teacher' })),
    ...STUDENT_EVENTS.map(e => ({ ...e, source: 'personal' })),
    ...DUE_DATES.map(e => ({
        event_id:          e.assessment_id ? 'asgn-' + e.assessment_id : null,
        assessment_id:     e.assessment_id,
        event_title:       e.assessment_name,
        event_description: `Due date for ${e.assessment_name}`,
        event_type:        'due_date',
        event_date:        e.due_date,
        full_due_date:     e.full_due_date || e.due_date,
        subject_id:        e.subject_id,
        subject_name:      e.subject_name,
        subject_code:      e.subject_code,
        event_location:    'Online / Classroom',
        duration_type:     'None',
        is_repeatable:     0,
        teacher_id:        null,
        source:            'due_date'
    }))
];

// ── State ──
let calYear  = new Date().getFullYear();
let calMonth = new Date().getMonth();
let activeFilter = 'all';
let searchQuery  = '';
let pendingDeleteId = null;
let currentView = 'grid';

const MONTHS = [
    'January','February','March','April','May','June',
    'July','August','September','October','November','December'
];

// ── HTML Sanitizer Utility (Stored XSS Prevention) ──
function escapeHtml(str) {
    if (str === null || str === undefined) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');
}

// ── Helpers ──
function toLocalDate(val) {
    if (!val) return null;
    if (val instanceof Date) {
        return new Date(val.getFullYear(), val.getMonth(), val.getDate());
    }
    const str = String(val).trim();
    if (!str) return null;
    if (str.includes('T') || str.includes('Z')) {
        const d = new Date(str);
        if (!isNaN(d.getTime())) {
            return new Date(d.getFullYear(), d.getMonth(), d.getDate());
        }
    }
    const parts = str.substring(0, 10).split('-');
    if (parts.length < 3) return null;
    const y = parseInt(parts[0], 10);
    const m = parseInt(parts[1], 10) - 1;
    const d = parseInt(parts[2], 10);
    if (isNaN(y) || isNaN(m) || isNaN(d)) return null;
    return new Date(y, m, d);
}

function toLocalDateStr(val) {
    const d = toLocalDate(val);
    if (!d) return '';
    const y = d.getFullYear();
    const m = String(d.getMonth() + 1).padStart(2, '0');
    const day = String(d.getDate()).padStart(2, '0');
    return `${y}-${m}-${day}`;
}

function formatDate(dateStr) {
    const d = toLocalDate(dateStr);
    if (!d) return '';
    return d.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}

function formatTimeDisplay(ev) {
    if (ev.duration_type === 'DateRange' && ev.start_date) {
        const s = new Date(ev.start_date);
        return s.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }
    if (ev.duration_type === 'Minutes' && ev.duration_minutes) {
        return `${ev.duration_minutes} mins`;
    }
    return 'All Day';
}

function pillClass(type, source) {
    if (source === 'due_date') return 'pill-due';
    if (source === 'personal') return 'pill-personal';
    switch ((type || '').toLowerCase()) {
        case 'exam':       return 'pill-exam';
        case 'deadline':   return 'pill-deadline';
        case 'holiday':    return 'pill-holiday';
        case 'assignment': return 'pill-assignment';
        default:           return 'pill-material';
    }
}

function dotColor(type, source) {
    if (source === 'personal') return '#0ea5e9';
    if (source === 'due_date') return '#ec4899';
    switch ((type || '').toLowerCase()) {
        case 'exam':       return '#ef4444';
        case 'deadline':   return '#f59e0b';
        case 'holiday':    return '#10b981';
        case 'assignment': return '#0d9488';
        default:           return '#7c3aed';
    }
}

function typeLabel(type, source) {
    if (source === 'personal') return 'My Event';
    if (source === 'due_date') return 'Due Date';
    return type || 'Event';
}

function canEdit(ev) {
    // Student can only edit their own personal events
    return ev.source === 'personal';
}

// ── FILTER + SEARCH ──
function getVisible() {
    return ALL_EVENTS.filter(ev => {
        // Filter
        if (activeFilter !== 'all') {
            if (activeFilter === 'personal' && ev.source !== 'personal') return false;
            if (activeFilter === 'teacher'  && ev.source !== 'teacher')  return false;
            if (activeFilter === 'due_date' && ev.source !== 'due_date') return false;
            if (!['all','personal','teacher','due_date'].includes(activeFilter)) {
                if ((ev.event_type || '').toLowerCase() !== activeFilter.toLowerCase()) return false;
            }
        }
        // Search
        if (searchQuery) {
            const q = searchQuery.toLowerCase();
            return (ev.event_title || '').toLowerCase().includes(q)
                || (ev.event_description || '').toLowerCase().includes(q)
                || (ev.subject_name || '').toLowerCase().includes(q)
                || (ev.event_type || '').toLowerCase().includes(q)
                || (ev.event_location || '').toLowerCase().includes(q);
        }
        return true;
    });
}

// ── CALENDAR RENDER ──
function renderCalendar() {
    document.getElementById('calMonthLabel').textContent = MONTHS[calMonth];
    document.getElementById('calYearLabel').textContent  = calYear;

    const grid = document.getElementById('calendarGrid');
    grid.innerHTML = '';

    const firstDay    = new Date(calYear, calMonth, 1).getDay();
    const daysInMonth = new Date(calYear, calMonth + 1, 0).getDate();
    const prevDays    = new Date(calYear, calMonth, 0).getDate();

    // Dynamic grid sizing: 35 cells (5 rows) if fits, otherwise 42 cells (6 rows)
    const neededCells = firstDay + daysInMonth;
    const totalCells  = Math.ceil(neededCells / 7) * 7;

    const visible = getVisible();

    // Group events by day string
    const byDay = {};
    visible.forEach(ev => {
        const d = toLocalDate(ev.event_date || ev.start_date);
        if (!d) return;
        if (d.getFullYear() === calYear && d.getMonth() === calMonth) {
            const key = d.getDate();
            if (!byDay[key]) byDay[key] = [];
            byDay[key].push(ev);
        }
    });

    const today = new Date();
    const isCurrentMonth = today.getFullYear() === calYear && today.getMonth() === calMonth;

    // Prefix cells (from previous month)
    for (let i = 0; i < firstDay; i++) {
        const cell = document.createElement('div');
        cell.className = 'border-r border-b border-slate-50 p-2 bg-slate-50/30';
        cell.innerHTML = `<span class="text-xs font-bold text-slate-200">${prevDays - firstDay + i + 1}</span>`;
        grid.appendChild(cell);
    }

    // Day cells
    for (let day = 1; day <= daysInMonth; day++) {
        const events = byDay[day] || [];
        const isToday = isCurrentMonth && today.getDate() === day;
        const isLastRows = (firstDay + day - 1) >= totalCells - 14;
        const dateStr = `${calYear}-${String(calMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;

        const cell = document.createElement('div');
        cell.className = `cal-day border-r border-b border-slate-100 p-2 hover:bg-blue-50/50 transition-colors cursor-pointer${isLastRows ? ' bottom-row' : ''}`;
        
        // Tap/click handler for mobile touch and desktop modal
        cell.onclick = (e) => handleDayClick(day, dateStr, events, e);

        // Day number
        const numSpan = isToday
            ? `<span class="text-xs font-black bg-blue-600 text-white w-6 h-6 flex items-center justify-center rounded-full shadow-2xs">${day}</span>`
            : `<span class="text-xs font-bold text-slate-500">${day}</span>`;

        // Event pills (max 2 shown + overflow)
        let pillsHTML = '';
        const maxShow = 2;
        events.slice(0, maxShow).forEach(ev => {
            const safeTitle = escapeHtml(ev.event_title);
            pillsHTML += `<div class="cal-pill ${pillClass(ev.event_type, ev.source)} text-[11px] font-bold py-0.5 px-1.5 rounded truncate" title="${safeTitle}">${safeTitle}</div>`;
        });
        if (events.length > maxShow) {
            pillsHTML += `<div class="text-[11px] text-blue-600 font-extrabold mt-0.5">+${events.length - maxShow} more</div>`;
        }

        // Tooltip (desktop hover affordance)
        let tooltipContent = '';
        if (events.length > 0) {
            tooltipContent = `
                <div class="day-tooltip p-0 pointer-events-none hidden md:block">
                    <div class="px-4 py-3 border-b border-slate-100">
                        <p class="text-xs font-black text-slate-700">${MONTHS[calMonth]} ${day}, ${calYear}</p>
                        <p class="text-[11px] text-slate-400 font-semibold">${events.length} event${events.length > 1 ? 's' : ''}</p>
                    </div>
                    <div class="p-3 space-y-2 max-h-64 overflow-y-auto no-scrollbar">
                        ${events.map(ev => `
                            <div class="rounded-xl p-3 border border-slate-100 bg-slate-50 hover:bg-white transition" style="border-left: 3px solid ${dotColor(ev.event_type, ev.source)}">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="flex-1 min-w-0">
                                        <p class="text-xs font-black text-slate-800 leading-tight truncate">${escapeHtml(ev.event_title)}</p>
                                        ${ev.subject_name ? `<span class="text-[11px] font-bold text-blue-500 block mt-0.5">${escapeHtml(ev.subject_name)}</span>` : ''}
                                        <div class="mt-1 flex flex-wrap gap-1">
                                            <span class="text-[10px] font-bold px-1.5 py-0.5 rounded" style="background:${dotColor(ev.event_type,ev.source)}20;color:${dotColor(ev.event_type,ev.source)}">${escapeHtml(typeLabel(ev.event_type, ev.source))}</span>
                                            ${ev.event_location && ev.event_location !== 'TBA' ? `<span class="text-[10px] text-slate-400 font-medium"><i class="fas fa-location-dot mr-0.5"></i>${escapeHtml(ev.event_location)}</span>` : ''}
                                        </div>
                                        ${ev.event_description ? `<p class="text-[11px] text-slate-500 mt-1 line-clamp-2">${escapeHtml(ev.event_description)}</p>` : ''}
                                    </div>
                                </div>
                            </div>
                        `).join('')}
                    </div>
                </div>`;
        }

        cell.innerHTML = `
            <div class="flex items-start justify-between">
                ${numSpan}
                ${events.length > 0 ? `<div class="flex gap-1 flex-wrap">${events.slice(0,3).map(ev=>`<span class="w-2 h-2 rounded-full" style="background:${dotColor(ev.event_type,ev.source)}"></span>`).join('')}</div>` : ''}
            </div>
            <div class="mt-1 space-y-1 overflow-hidden">${pillsHTML}</div>
            ${tooltipContent}
        `;
        grid.appendChild(cell);
    }

    // Suffix cells (from next month)
    const used = firstDay + daysInMonth;
    const remaining = totalCells - used;
    for (let i = 1; i <= remaining; i++) {
        const cell = document.createElement('div');
        cell.className = 'border-r border-b border-slate-50 p-2 bg-slate-50/30';
        cell.innerHTML = `<span class="text-xs font-bold text-slate-200">${i}</span>`;
        grid.appendChild(cell);
    }

    renderUpcomingStrip();
}

// ── DAY CLICK & TOUCH DETAILS MODAL ──
function handleDayClick(day, dateStr, events, e) {
    // If clicking edit/delete button inside cell, don't trigger cell click
    if (e && e.target && e.target.closest('button')) return;

    if (events.length === 0) {
        // Empty day: directly open create event modal with prefilled date
        openEventModal(dateStr);
        return;
    }

    // Day has events: open accessible Day Details Modal
    const modal = document.getElementById('dayDetailsModal');
    const dateLabel = document.getElementById('dayModalDate');
    const countLabel = document.getElementById('dayModalCount');
    const list = document.getElementById('dayModalEventsList');
    const addBtn = document.getElementById('dayModalAddBtn');

    dateLabel.textContent = `${MONTHS[calMonth]} ${day}, ${calYear}`;
    countLabel.textContent = `${events.length} event${events.length > 1 ? 's' : ''} scheduled`;

    addBtn.onclick = () => {
        closeDayDetailsModal();
        openEventModal(dateStr);
    };

    list.innerHTML = events.map(ev => {
        const safeTitle = escapeHtml(ev.event_title);
        const safeDesc = escapeHtml(ev.event_description);
        const safeSubj = escapeHtml(ev.subject_name);
        const safeLoc = escapeHtml(ev.event_location);

        return `
            <div class="rounded-2xl p-4 border border-slate-200/80 bg-slate-50/70 hover:bg-white transition shadow-2xs" style="border-left: 4px solid ${dotColor(ev.event_type, ev.source)}">
                <div class="flex items-start justify-between gap-3">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-1.5 flex-wrap mb-1">
