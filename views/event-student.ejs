                    </div>` : ''}
                </div>
            </div>`;
    }).join('');

    if (window.ModalManager) {
        ModalManager.open('dayDetailsModal');
    } else {
        modal.classList.remove('hidden');
    }
}

function closeDayDetailsModal() {
    if (window.ModalManager) {
        ModalManager.close('dayDetailsModal');
    } else {
        const modal = document.getElementById('dayDetailsModal');
        if (modal) modal.classList.add('hidden');
    }
}

// ── UPCOMING LIST ──
function renderUpcomingStrip() {
    const strip = document.getElementById('upcomingStrip');
    const countEl = document.getElementById('upcomingCount');
    if (!strip) return;
    strip.innerHTML = '';

    const now = new Date();
    const startOfToday = new Date(now.getFullYear(), now.getMonth(), now.getDate(), 0, 0, 0, 0);
    const isCurrentMonth = calYear === now.getFullYear() && calMonth === now.getMonth();
    const startOfMonth = new Date(calYear, calMonth, 1, 0, 0, 0, 0);
    const endOfMonth = new Date(calYear, calMonth + 1, 0, 23, 59, 59, 999);

    const visible = getVisible();

    // 1. First priority: Upcoming events from today onwards in this month
    let upcoming = visible.filter(ev => {
        const d = toLocalDate(ev.event_date || ev.start_date);
        if (!d) return false;
        if (isCurrentMonth) {
            return d >= startOfToday && d <= endOfMonth;
        } else if (new Date(calYear, calMonth, 1) > startOfToday) {
            return d >= startOfMonth && d <= endOfMonth;
        } else {
            return d >= startOfMonth && d <= endOfMonth;
        }
    }).sort((a, b) => toLocalDate(a.event_date || a.start_date) - toLocalDate(b.event_date || b.start_date));

    // 2. If current month has no events from today onwards, but has events earlier this month, show all events of this month
    if (isCurrentMonth && upcoming.length === 0) {
        upcoming = visible.filter(ev => {
            const d = toLocalDate(ev.event_date || ev.start_date);
            return d && d >= startOfMonth && d <= endOfMonth;
        }).sort((a, b) => toLocalDate(a.event_date || a.start_date) - toLocalDate(b.event_date || b.start_date));
    }

    if (upcoming.length === 0) {
        if (countEl) {
            countEl.innerHTML = '<span class="inline-flex items-center gap-1.5 text-[11px] font-bold text-emerald-600 bg-emerald-50 px-2.5 py-1 rounded-full border border-emerald-200/60 shadow-2xs"><i class="fas fa-check-circle text-[10px]"></i> All clear</span>';
        }
        strip.innerHTML = `
            <div class="w-full bg-gradient-to-b from-white via-white to-slate-50/70 rounded-3xl border border-dashed border-indigo-200/80 p-6 sm:p-9 text-center shadow-xs flex flex-col items-center justify-center transition-all hover:border-indigo-300">
                <div class="relative mb-3.5">
                    <div class="w-14 h-14 sm:w-16 sm:h-16 rounded-2xl bg-gradient-to-tr from-indigo-500/10 via-sky-500/10 to-blue-500/10 border border-indigo-100 flex items-center justify-center text-indigo-600 text-xl sm:text-2xl shadow-inner">
                        <i class="far fa-calendar-check text-indigo-500"></i>
                    </div>
                    <span class="absolute -top-1 -right-1 flex h-4 w-4">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-60"></span>
                        <span class="relative inline-flex rounded-full h-4 w-4 bg-emerald-500 border-2 border-white items-center justify-center text-[8px] text-white">
                            <i class="fas fa-check text-[8px]"></i>
