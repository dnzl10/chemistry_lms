// ── VIEW SWITCH (Week, Grid, Agenda) ──
function switchView(view) {
    currentView = view;
    const week   = document.getElementById('weekView');
    const grid   = document.getElementById('gridView');
    const agenda = document.getElementById('agendaView');
    const btnW   = document.getElementById('btnWeek');
    const btnG   = document.getElementById('btnGrid');
    const btnA   = document.getElementById('btnAgenda');

    if (btnW) {
        btnW.classList.remove('bg-slate-100', 'text-blue-600');
        btnW.classList.add('text-slate-500', 'hover:bg-slate-50');
    }
    if (btnG) {
        btnG.classList.remove('bg-slate-100', 'text-blue-600');
        btnG.classList.add('text-slate-500', 'hover:bg-slate-50');
    }
    if (btnA) {
        btnA.classList.remove('bg-slate-100', 'text-blue-600');
        btnA.classList.add('text-slate-500', 'hover:bg-slate-50');
    }

    if (week) week.classList.add('hidden');
    if (grid) grid.classList.add('hidden');
    if (agenda) agenda.classList.add('hidden');

    if (view === 'week') {
        if (week) week.classList.remove('hidden');
        if (btnW) {
            btnW.classList.add('bg-slate-100', 'text-blue-600');
            btnW.classList.remove('text-slate-500', 'hover:bg-slate-50');
        }
        renderWeekTimeline(true);
    } else if (view === 'grid') {
        if (grid) grid.classList.remove('hidden');
        if (btnG) {
            btnG.classList.add('bg-slate-100', 'text-blue-600');
            btnG.classList.remove('text-slate-500', 'hover:bg-slate-50');
        }
        renderCalendar();
    } else {
        if (agenda) agenda.classList.remove('hidden');
        if (btnA) {
            btnA.classList.add('bg-slate-100', 'text-blue-600');
            btnA.classList.remove('text-slate-500', 'hover:bg-slate-50');
        }
        renderAgenda();
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// 7-COLUMN x 24-HOUR WEEK TIMELINE ENGINE (EventStudent.md UX Specifications)
// ═══════════════════════════════════════════════════════════════════════════

let weekStartDate = getStartOfWeek(new Date());

function getStartOfWeek(d) {
    const date = new Date(d);
    const day = date.getDay(); // 0 = Sunday
    const diff = date.getDate() - day;
    const sunday = new Date(date.setDate(diff));
    sunday.setHours(0, 0, 0, 0);
    return sunday;
}

function changeWeek(delta) {
    weekStartDate.setDate(weekStartDate.getDate() + (delta * 7));
    renderWeekTimeline(false);
}

function jumpToWeekToday() {
    weekStartDate = getStartOfWeek(new Date());
    renderWeekTimeline(true);
}

function formatHourLabel(h) {
    if (h === 0) return '12 AM';
    if (h === 12) return '12 PM';
    return h < 12 ? `${h} AM` : `${h - 12} PM`;
}

function formatTimeMinutes(m) {
    const hour24 = Math.floor(m / 60);
    const min = m % 60;
    const ampm = hour24 >= 12 ? 'PM' : 'AM';
    const hour12 = hour24 % 12 || 12;
    return `${hour12}:${String(min).padStart(2, '0')} ${ampm}`;
}

function getTimelineCategoryClass(type, source) {
    if (source === 'personal') return 'tl-cat-personal';
    if (source === 'due_date') return 'tl-cat-due';
    switch ((type || '').toLowerCase()) {
        case 'exam':       return 'tl-cat-exam';
        case 'deadline':   return 'tl-cat-deadline';
        case 'assignment': return 'tl-cat-assignment';
        case 'holiday':    return 'tl-cat-holiday';
        case 'material':
        default:           return 'tl-cat-material';
    }
}

// Timing extractor for each event
function getEventTiming(ev) {
    if (ev.duration_type === 'DateRange' && ev.start_date) {
        const s = new Date(ev.start_date);
        const e = ev.end_date ? new Date(ev.end_date) : new Date(s.getTime() + 60 * 60 * 1000);
        if (!isNaN(s.getTime()) && !isNaN(e.getTime())) {
            const isSameDay = s.toDateString() === e.toDateString();
            if (!isSameDay && (e.getTime() - s.getTime() >= 20 * 3600 * 1000)) {
                return { isTimed: false, isAllDay: true };
            }
            const startMin = s.getHours() * 60 + s.getMinutes();
            let endMin = e.getHours() * 60 + e.getMinutes();
            if (endMin <= startMin) endMin = Math.min(1440, startMin + 30);
            return {
                isTimed: true,
                isAllDay: false,
                startMin,
                endMin,
                duration: Math.max(1, endMin - startMin),
                startDate: s,
                endDate: e
            };
        }
    } else if (ev.duration_type === 'Minutes' && ev.duration_minutes) {
        let s = ev.start_date ? new Date(ev.start_date) : null;
        if (!s && ev.event_date && ev.event_date.length > 10) {
            s = new Date(ev.event_date);
        }
        if (s && !isNaN(s.getTime())) {
            const startMin = s.getHours() * 60 + s.getMinutes();
            const dur = Math.max(1, parseInt(ev.duration_minutes, 10) || 30);
            const endMin = Math.min(1440, startMin + dur);
            return {
                isTimed: true,
                isAllDay: false,
                startMin,
                endMin,
                duration: dur,
                startDate: s,
                endDate: new Date(s.getTime() + dur * 60 * 1000)
            };
        }
    }
    // Fallback: duration_type === 'None' or no time specified -> All-Day Row (Rule 6)
    return { isTimed: false, isAllDay: true };
}

// Rule 3: Overlap Partitioning Algorithm (Halves, Thirds, 1/N — NO stacking or '+1 more' labels)
function partitionOverlapEvents(items) {
    if (items.length === 0) return [];
    items.sort((a, b) => a.startMin - b.startMin || b.duration - a.duration);

    const clusters = [];
    let currentCluster = [];
    let clusterEnd = -1;

    for (const item of items) {
        if (currentCluster.length === 0) {
            currentCluster.push(item);
            clusterEnd = item.endMin;
        } else if (item.startMin < clusterEnd) {
            currentCluster.push(item);
            if (item.endMin > clusterEnd) clusterEnd = item.endMin;
        } else {
            clusters.push(currentCluster);
            currentCluster = [item];
            clusterEnd = item.endMin;
        }
    }
    if (currentCluster.length > 0) {
        clusters.push(currentCluster);
    }

    const result = [];
    for (const cluster of clusters) {
        const subColumns = [];

        for (const item of cluster) {
            let placed = false;
            for (let c = 0; c < subColumns.length; c++) {
                if (subColumns[c] <= item.startMin) {
                    subColumns[c] = item.endMin;
                    item.colIndex = c;
                    placed = true;
                    break;
                }
            }
            if (!placed) {
                item.colIndex = subColumns.length;
                subColumns.push(item.endMin);
            }
        }

        const totalCols = subColumns.length;
        for (const item of cluster) {
            item.totalCols = totalCols;
            item.widthPct = 100 / totalCols;
            item.leftPct = item.colIndex * item.widthPct;
            result.push(item);
        }
    }

    return result;
}

// ── RENDER WEEK TIMELINE ──
function renderWeekTimeline(shouldAutoScroll = false) {
    const weekHeaders = document.getElementById('weekDayHeaders');
    const allDayCols  = document.getElementById('weekAllDayColumns');
    const timeGutter  = document.getElementById('timeGutter');
    const columnsWrap = document.getElementById('timelineColumnsWrapper');
    const rangeLabel  = document.getElementById('calWeekRangeLabel');
    const subLabel    = document.getElementById('calWeekSubLabel');
    const timeDisplay = document.getElementById('currentTimeDisplay');

    if (!weekHeaders || !columnsWrap) return;

    // Calculate dates of the 7 days (Sunday - Saturday)
    const days = [];
    for (let i = 0; i < 7; i++) {
        const d = new Date(weekStartDate);
        d.setDate(d.getDate() + i);
        days.push(d);
    }

    const firstDay = days[0];
    const lastDay  = days[6];
    if (rangeLabel) {
        const fMonth = MONTHS[firstDay.getMonth()].substring(0, 3);
        const lMonth = MONTHS[lastDay.getMonth()].substring(0, 3);
        if (firstDay.getMonth() === lastDay.getMonth()) {
            rangeLabel.textContent = `${fMonth} ${firstDay.getDate()} – ${lastDay.getDate()}, ${firstDay.getFullYear()}`;
        } else {
            rangeLabel.textContent = `${fMonth} ${firstDay.getDate()} – ${lMonth} ${lastDay.getDate()}, ${lastDay.getFullYear()}`;
        }
    }
    if (subLabel) {
        // Week number
        const oneJan = new Date(firstDay.getFullYear(), 0, 1);
        const numberOfDays = Math.floor((firstDay - oneJan) / (24 * 60 * 60 * 1000));
        const weekNum = Math.ceil((firstDay.getDay() + 1 + numberOfDays) / 7);
        subLabel.textContent = `Week ${weekNum} • High-Density Timeline`;
    }

    const today = new Date();
    const todayStr = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;

    if (timeDisplay) {
        timeDisplay.textContent = today.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
    }

    // 1. Render Sticky Day Headers
    const dayNames = ['Sun', 'Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat'];
    weekHeaders.innerHTML = days.map((d, i) => {
        const dStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        const isToday = dStr === todayStr;
        return `
            <div class="py-2.5 px-2 text-center select-none transition-colors ${isToday ? 'bg-blue-50/70' : ''}">
                <p class="text-[10px] font-black uppercase tracking-widest ${isToday ? 'text-blue-600' : 'text-slate-400'}">${dayNames[i]}</p>
                <div class="mt-0.5 flex justify-center">
                    <span class="text-xs font-black w-6 h-6 flex items-center justify-center rounded-full ${isToday ? 'bg-blue-600 text-white shadow-xs' : 'text-slate-700'}">${d.getDate()}</span>
                </div>
            </div>
        `;
    }).join('');

    // 2. Render Left Time Gutter (Rule 1: labels resting on division lines)
    if (timeGutter) {
        let gutterHTML = '';
        for (let h = 0; h < 24; h++) {
            gutterHTML += `
                <div class="timeline-gutter-label" style="top: ${h * 60}px;">
                    ${formatHourLabel(h)}
                </div>
            `;
        }
        timeGutter.innerHTML = gutterHTML;
    }

    // 3. Render Decoupled Sticky All-Day Row (Rule 6) & Main Canvas Columns (Rule 1)
    allDayCols.innerHTML = '';
    columnsWrap.innerHTML = '';

    // Background lines are rendered via CSS background-image on .timeline-day-col

    const visibleEvents = getVisible();

    // Loop through each day column
    days.forEach((dayDate, dayIdx) => {
        const dateStr = `${dayDate.getFullYear()}-${String(dayDate.getMonth() + 1).padStart(2, '0')}-${String(dayDate.getDate()).padStart(2, '0')}`;
        const isToday = dateStr === todayStr;

        // Filter events belonging to this day
        const dayEvents = visibleEvents.filter(ev => {
            const evDate = toLocalDateStr(ev.event_date || ev.start_date);
            return evDate === dateStr;
        });

        // Separate into All-Day events vs. Timed events
        const allDayItems = [];
        const timedItems = [];

        dayEvents.forEach(ev => {
            const timing = getEventTiming(ev);
            if (timing.isAllDay) {
                allDayItems.push(ev);
            } else {
                timedItems.push({
                    ev,
                    startMin: timing.startMin,
                    endMin: timing.endMin,
                    duration: timing.duration,
                    timing
                });
            }
        });

    // Manage Week Empty State Banner
    const weekEmptyBanner = document.getElementById('weekEmptyBanner');
    let totalEventsInWeek = 0;
    days.forEach(d => {
        const dStr = `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, '0')}-${String(d.getDate()).padStart(2, '0')}`;
        totalEventsInWeek += visibleEvents.filter(ev => toLocalDateStr(ev.event_date || ev.start_date) === dStr).length;
    });
    if (weekEmptyBanner) {
        if (totalEventsInWeek === 0) {
            weekEmptyBanner.classList.remove('hidden');
        } else {
            weekEmptyBanner.classList.add('hidden');
        }
    }

        // A. Render All-Day Column (Rule 6)
        const allDayCol = document.createElement('div');
        allDayCol.className = `px-1.5 py-1 min-h-[36px] flex flex-col justify-start ${isToday ? 'bg-blue-50/40' : ''}`;
        if (allDayItems.length === 0) {
            allDayCol.innerHTML = '<span class="text-[9px] text-slate-300 font-bold block text-center py-1 select-none">—</span>';
        } else {
            allDayItems.forEach(ev => {
                const chip = document.createElement('div');
                chip.className = `all-day-chip ${getTimelineCategoryClass(ev.event_type, ev.source)}`;
                chip.textContent = ev.event_title;
                chip.title = `${ev.event_title} (${typeLabel(ev.event_type, ev.source)})`;
                chip.onclick = (e) => {
                    e.stopPropagation();
                    if (canEdit(ev)) {
                        openEditModal(ev.event_id);
                    } else {
                        handleDayClick(dayDate.getDate(), dateStr, [ev], e);
                    }
                };
                allDayCol.appendChild(chip);
            });
        }
        allDayCols.appendChild(allDayCol);

        // B. Render Main Timeline Column (Rule 1 & Rule 3)
        const dayCol = document.createElement('div');
        dayCol.className = `timeline-day-col relative h-[1440px] z-10 ${isToday ? 'bg-blue-50/15' : ''}`;
        dayCol.dataset.date = dateStr;
        dayCol.dataset.dayIndex = dayIdx;

        // Render Top All-Day indicators directly in column for immediate visibility
        if (allDayItems.length > 0) {
            const allDaySummary = document.createElement('div');
            allDaySummary.className = 'p-1 space-y-1 bg-slate-50/80 border-b border-slate-100 z-15';
            allDayItems.forEach(ev => {
                const badge = document.createElement('div');
                badge.className = `all-day-chip ${getTimelineCategoryClass(ev.event_type, ev.source)} text-[9px] font-black py-0.5 px-1.5 shadow-2xs`;
                badge.innerHTML = `<span class="opacity-75 mr-1 font-bold">[All-Day]</span>${escapeHtml(ev.event_title)}`;
                badge.onclick = (e) => {
                    e.stopPropagation();
                    if (canEdit(ev)) {
                        openEditModal(ev.event_id);
                    } else {
                        handleDayClick(dayDate.getDate(), dateStr, [ev], e);
                    }
                };
                allDaySummary.appendChild(badge);
            });
            dayCol.appendChild(allDaySummary);
        }

        // Partition overlapping timed events (Rule 3)
        const partitionedTimedEvents = partitionOverlapEvents(timedItems);

        partitionedTimedEvents.forEach(item => {
            const ev = item.ev;
            const topPx = item.startMin;
            const heightPx = Math.max(8, item.duration);
            const widthPct = item.widthPct;
            const leftPct = item.leftPct;

            const card = document.createElement('div');
            card.dataset.eventId = ev.event_id || '';
            card.dataset.source = ev.source;
            card.dataset.startMin = item.startMin;
            card.dataset.duration = item.duration;

            const categoryClass = getTimelineCategoryClass(ev.event_type, ev.source);
            const isPersonal = ev.source === 'personal';

            card.style.top = `${topPx}px`;
            card.style.height = `${heightPx}px`;
            card.style.left = `${leftPct}%`;
            card.style.width = `calc(${widthPct}% - 2px)`;

            // Duration Scaling (Rule 4)
            if (heightPx < 15) {
                // Micro-event (<15px): render as thin colored bar with hover tooltip
                card.className = `timeline-event-card timeline-micro-event ${categoryClass} ${isPersonal ? 'is-movable' : ''}`;
                card.title = `${ev.event_title} • ${formatTimeMinutes(item.startMin)} - ${formatTimeMinutes(item.endMin)} (${item.duration}m)`;
            } else if (heightPx < 30) {
                // 15-minute slot (15px): clipped single-line title
                card.className = `timeline-event-card timeline-15m-event ${categoryClass} ${isPersonal ? 'is-movable' : ''}`;
                card.innerHTML = `
                    <div class="flex items-center justify-between w-full h-full">
                        <span class="font-extrabold truncate text-[10px]">${escapeHtml(ev.event_title)}</span>
                        <span class="text-[9px] opacity-75 font-bold ml-1 flex-shrink-0">${formatTimeMinutes(item.startMin)}</span>
                    </div>
                `;
                card.title = `${ev.event_title} • ${formatTimeMinutes(item.startMin)} - ${formatTimeMinutes(item.endMin)}`;
            } else {
                // Standard event (>=30px): multi-line rich card
                card.className = `timeline-event-card p-1.5 flex flex-col justify-between ${categoryClass} ${isPersonal ? 'is-movable' : ''}`;
                card.innerHTML = `
                    <div class="min-w-0 flex-1 overflow-hidden">
                        <div class="flex items-center justify-between gap-1 mb-0.5">
                            <span class="font-black text-xs leading-tight truncate">${escapeHtml(ev.event_title)}</span>
                            <span class="text-[9px] font-bold opacity-80 whitespace-nowrap">${formatTimeMinutes(item.startMin)}</span>
                        </div>
                        ${heightPx >= 45 ? `
                            <div class="flex items-center gap-1.5 flex-wrap text-[10px] font-bold opacity-90 leading-none mt-0.5">
                                ${ev.subject_name ? `<span class="truncate max-w-[90px]">${escapeHtml(ev.subject_name)}</span>` : ''}
                                <span>${item.duration}m</span>
                                ${ev.event_location && ev.event_location !== 'TBA' ? `<span class="truncate max-w-[80px]"><i class="fas fa-location-dot mr-0.5 text-[8px]"></i>${escapeHtml(ev.event_location)}</span>` : ''}
                            </div>
                        ` : ''}
                    </div>
                    ${isPersonal ? '<div class="timeline-resize-handle" title="Drag to resize duration"></div>' : ''}
                `;
            }

            // Click handling
            card.onclick = (e) => {
                if (card.dataset.dragged === 'true') return;
                e.stopPropagation();
                if (isPersonal) {
                    openEditModal(ev.event_id);
                } else {
                    handleDayClick(dayDate.getDate(), dateStr, [ev], e);
                }
            };

            dayCol.appendChild(card);
        });

        columnsWrap.appendChild(dayCol);
    });

    // 4. Position Active Red Marker Line (Rule 1)
    updateCurrentTimeMarker(shouldAutoScroll);

    // 5. Initialize Drag Interaction Physics (Rule 5)
    initTimelineDragPhysics();
}

// Rule 1: Active Red Current-Time Marker Line & Viewport Auto-Scroll
function updateCurrentTimeMarker(autoScroll = false) {
    const indicator = document.getElementById('currentTimeIndicator');
    const scrollContainer = document.getElementById('timelineScroll');
    const columnsWrap = document.getElementById('timelineColumnsWrapper');
    if (!indicator || !scrollContainer || !columnsWrap) return;

    const now = new Date();
    const nowStr = `${now.getFullYear()}-${String(now.getMonth() + 1).padStart(2, '0')}-${String(now.getDate()).padStart(2, '0')}`;
    const targetCol = columnsWrap.querySelector(`.timeline-day-col[data-date="${nowStr}"]`);

    if (!targetCol) {
        indicator.style.display = 'none';
        return;
    }

    const currentY = (now.getHours() * 60) + now.getMinutes();
    indicator.style.display = 'flex';
    indicator.style.top = `${currentY}px`;

    if (autoScroll) {
        // Auto-scroll viewport directly to marker minus 120px context (Rule 1)
        const targetScroll = Math.max(0, currentY - 120);
        setTimeout(() => {
            scrollContainer.scrollTo({ top: targetScroll, behavior: 'smooth' });
        }, 60);
    }
}

// ═══════════════════════════════════════════════════════════════════════════
// INTERACTION PHYSICS: DRAG-TO-CREATE, DRAG-TO-MOVE, DRAG-TO-RESIZE (Rule 5)
// ═══════════════════════════════════════════════════════════════════════════

let timelineInteractionsInitialized = false;

function initTimelineDragPhysics() {
    const scrollContainer = document.getElementById('timelineScroll');
    const ghost = document.getElementById('dragCreateGhost');
    const ghostBadge = document.getElementById('dragCreateBadge');
    const moveBadge = document.getElementById('dragMoveBadge');
    if (!scrollContainer || !ghost || !ghostBadge) return;

    // A. DRAG EMPTY SPACE TO CREATE (15-Minute Snapping)
    const dayCols = scrollContainer.querySelectorAll('.timeline-day-col');
    dayCols.forEach(col => {
        col.onpointerdown = (e) => {
            if (e.target.closest('.timeline-event-card')) return; // Ignore event cards
            if (e.button !== 0) return; // Left click only

            col.setPointerCapture(e.pointerId);
            const rect = col.getBoundingClientRect();
            const startY = Math.max(0, Math.min(1440, e.clientY - rect.top));
            const startMin = Math.floor((startY / 60) * 4) * 15;
            let currentEndMin = startMin + 15;
            const colDate = col.dataset.date;

            ghost.classList.remove('hidden');
            ghost.style.left = `${col.offsetLeft}px`;
            ghost.style.width = `${col.offsetWidth - 2}px`;
            ghost.style.top = `${startMin}px`;
            ghost.style.height = '15px';
            ghostBadge.textContent = `${formatTimeMinutes(startMin)} – ${formatTimeMinutes(currentEndMin)} (15m)`;

            col.onpointermove = (pe) => {
                const moveY = pe.clientY - rect.top;
                const rawMin = Math.floor((moveY / 60) * 4) * 15;
                currentEndMin = Math.max(startMin + 15, Math.min(1440, rawMin));
                const dur = currentEndMin - startMin;

                ghost.style.top = `${startMin}px`;
                ghost.style.height = `${dur}px`;
                ghostBadge.textContent = `${formatTimeMinutes(startMin)} – ${formatTimeMinutes(currentEndMin)} (${dur}m)`;
            };

            const finishCreate = () => {
                col.onpointermove = null;
                col.onpointerup = null;
                col.onpointercancel = null;
                ghost.classList.add('hidden');

                const dur = currentEndMin - startMin;
                if (dur >= 15) {
                    const sHour = String(Math.floor(startMin / 60)).padStart(2, '0');
                    const sMin  = String(startMin % 60).padStart(2, '0');
                    const eHour = String(Math.floor(currentEndMin / 60)).padStart(2, '0');
                    const eMin  = String(currentEndMin % 60).padStart(2, '0');

                    const startIso = `${colDate}T${sHour}:${sMin}`;
                    const endIso   = `${colDate}T${eHour}:${eMin}`;

                    openEventModal(colDate);
                    document.getElementById('durationType').value = 'DateRange';
                    toggleDurationFields();
                    document.getElementById('formStartDate').value = startIso;
                    document.getElementById('formEndDate').value   = endIso;
                }
            };

            col.onpointerup = finishCreate;
            col.onpointercancel = finishCreate;
        };
    });

    // B. DRAG BODY TO MOVE & C. DRAG EDGE TO RESIZE (Personal Events Only)
    const personalCards = scrollContainer.querySelectorAll('.timeline-event-card.is-movable');
    personalCards.forEach(card => {
        const resizeHandle = card.querySelector('.timeline-resize-handle');
        const eventId = card.dataset.eventId;
        const initialStartMin = parseInt(card.dataset.startMin, 10) || 0;
        const initialDuration = parseInt(card.dataset.duration, 10) || 30;
        const initialCol = card.closest('.timeline-day-col');
        const initialDate = initialCol ? initialCol.dataset.date : '';

        // ── RESIZE EVENT (Bottom Edge) ──
        if (resizeHandle) {
            resizeHandle.onpointerdown = (re) => {
                re.stopPropagation();
                re.preventDefault();
                resizeHandle.setPointerCapture(re.pointerId);

                card.dataset.dragged = 'true';
                const startClientY = re.clientY;
                let newDuration = initialDuration;

                if (moveBadge) {
                    moveBadge.classList.remove('hidden');
                    moveBadge.textContent = `Duration: ${newDuration}m`;
                    moveBadge.style.left = `${re.clientX + 16}px`;
                    moveBadge.style.top = `${re.clientY + 16}px`;
                }

                resizeHandle.onpointermove = (pe) => {
                    const deltaY = pe.clientY - startClientY;
                    const deltaMin = Math.round(deltaY / 15) * 15;
                    newDuration = Math.max(15, Math.min(1440 - initialStartMin, initialDuration + deltaMin));

                    card.style.height = `${newDuration}px`;
                    if (moveBadge) {
                        moveBadge.textContent = `Duration: ${newDuration}m (Ends ${formatTimeMinutes(initialStartMin + newDuration)})`;
                        moveBadge.style.left = `${pe.clientX + 16}px`;
                        moveBadge.style.top = `${pe.clientY + 16}px`;
                    }
                };

                const finishResize = async () => {
                    resizeHandle.onpointermove = null;
                    resizeHandle.onpointerup = null;
                    resizeHandle.onpointercancel = null;
                    if (moveBadge) moveBadge.classList.add('hidden');

                    setTimeout(() => { card.dataset.dragged = 'false'; }, 50);

                    if (newDuration !== initialDuration) {
                        const sHour = String(Math.floor(initialStartMin / 60)).padStart(2, '0');
                        const sMin  = String(initialStartMin % 60).padStart(2, '0');
                        const endTotal = initialStartMin + newDuration;
                        const eHour = String(Math.floor(endTotal / 60)).padStart(2, '0');
                        const eMin  = String(endTotal % 60).padStart(2, '0');

                        const startIso = `${initialDate}T${sHour}:${sMin}`;
                        const endIso   = `${initialDate}T${eHour}:${eMin}`;

                        await saveEventTimeAjax(eventId, {
                            duration_type: 'DateRange',
                            start_date: startIso,
                            end_date: endIso,
                            duration_minutes: newDuration,
                            event_date: initialDate
                        });
                    }
                };

                resizeHandle.onpointerup = finishResize;
                resizeHandle.onpointercancel = finishResize;
            };
        }

        // ── MOVE EVENT (Body Drag) ──
        card.onpointerdown = (me) => {
            if (me.target.closest('.timeline-resize-handle')) return; // handled by resize
            if (me.button !== 0) return;

            me.stopPropagation();
            card.setPointerCapture(me.pointerId);

            const startClientY = me.clientY;
            let hasMoved = false;
            let proposedStartMin = initialStartMin;
            let targetDate = initialDate;

            card.onpointermove = (pe) => {
                const deltaY = pe.clientY - startClientY;
                if (!hasMoved && Math.abs(deltaY) < 4) return;
                hasMoved = true;
                card.dataset.dragged = 'true';
                card.classList.add('is-dragging');

                const deltaMin = Math.round(deltaY / 15) * 15;
                proposedStartMin = Math.max(0, Math.min(1440 - initialDuration, initialStartMin + deltaMin));
                card.style.top = `${proposedStartMin}px`;

                // Detect target day column if dragging across days
                const hoveredCol = document.elementFromPoint(pe.clientX, pe.clientY)?.closest('.timeline-day-col');
                if (hoveredCol && hoveredCol.dataset.date) {
                    targetDate = hoveredCol.dataset.date;
                }

                if (moveBadge) {
                    moveBadge.classList.remove('hidden');
                    moveBadge.textContent = `${formatDate(targetDate)} • ${formatTimeMinutes(proposedStartMin)} – ${formatTimeMinutes(proposedStartMin + initialDuration)}`;
                    moveBadge.style.left = `${pe.clientX + 16}px`;
                    moveBadge.style.top = `${pe.clientY + 16}px`;
                }
            };

            const finishMove = async () => {
                card.onpointermove = null;
                card.onpointerup = null;
                card.onpointercancel = null;
                card.classList.remove('is-dragging');
                if (moveBadge) moveBadge.classList.add('hidden');

                setTimeout(() => { card.dataset.dragged = 'false'; }, 60);

                if (hasMoved && (proposedStartMin !== initialStartMin || targetDate !== initialDate)) {
                    const sHour = String(Math.floor(proposedStartMin / 60)).padStart(2, '0');
                    const sMin  = String(proposedStartMin % 60).padStart(2, '0');
                    const endTotal = proposedStartMin + initialDuration;
                    const eHour = String(Math.floor(endTotal / 60)).padStart(2, '0');
                    const eMin  = String(endTotal % 60).padStart(2, '0');

                    const startIso = `${targetDate}T${sHour}:${sMin}`;
                    const endIso   = `${targetDate}T${eHour}:${eMin}`;

                    await saveEventTimeAjax(eventId, {
                        event_date: targetDate,
                        duration_type: 'DateRange',
                        start_date: startIso,
                        end_date: endIso,
                        duration_minutes: initialDuration
                    });
                } else if (!hasMoved) {
                    openEditModal(eventId);
                }
            };

            card.onpointerup = finishMove;
            card.onpointercancel = finishMove;
        };
    });
}

// AJAX persistence for drag move and resize
async function saveEventTimeAjax(eventId, payload) {
    try {
        const targetEv = STUDENT_EVENTS.find(e => String(e.event_id) === String(eventId)) || {};
        const resp = await fetch(`/events/edit/${eventId}`, {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
            },
            body: JSON.stringify({
                event_title: targetEv.event_title || payload.event_title || 'Event',
                ...payload,
                is_ajax: true
            })
        });

        const data = await resp.json().catch(() => ({}));
        if (resp.ok && data.success !== false) {
            // Update local memory state
            const target = STUDENT_EVENTS.find(e => String(e.event_id) === String(eventId));
            if (target) {
                Object.assign(target, payload);
            }
            const targetAll = ALL_EVENTS.find(e => String(e.event_id) === String(eventId));
            if (targetAll) {
                Object.assign(targetAll, payload);
            }
            renderWeekTimeline(false);
            if (currentView === 'grid') renderCalendar();
            if (currentView === 'agenda') renderAgenda();
        } else {
            alert(data.message || 'Could not save event schedule update.');
            renderWeekTimeline(false);
        }
    } catch (err) {
        console.error('AJAX Event Update Error:', err);
        alert('Network error while saving schedule changes.');
        renderWeekTimeline(false);
    }
}


// ── MONTH NAV ──
function changeMonth(delta) {
    calMonth += delta;
    if (calMonth > 11) { calMonth = 0;  calYear++; }
    if (calMonth < 0)  { calMonth = 11; calYear--; }
    renderCalendar();
