                            ${ev.duration_type === 'Minutes' && ev.duration_minutes ? `<span class="flex items-center gap-1 text-amber-600"><i class="fas fa-stopwatch text-amber-400"></i>${ev.duration_minutes} mins</span>` : ''}
                        </div>
                    </div>
                    ${ev.source === 'due_date' && ev.assessment_id && ev.subject_id ? `
                    <div class="flex items-center flex-shrink-0">
                        <a href="/subjects/open/${ev.subject_id}#asgn-card-${ev.assessment_id}" class="px-3 py-1.5 rounded-xl bg-pink-50 hover:bg-pink-100 text-pink-600 font-bold text-xs transition flex items-center gap-1.5 shadow-2xs"><i class="fas fa-arrow-up-right-from-square text-[10px]"></i> View Task</a>
                    </div>` : ''}
                    ${canEdit(ev) ? `
                    <div class="flex items-center gap-1.5 flex-shrink-0">
                        <button onclick="closeDayDetailsModal(); openEditModal('${ev.event_id}')" class="w-8 h-8 rounded-xl bg-blue-50 hover:bg-blue-100 text-blue-600 transition flex items-center justify-center text-xs" title="Edit Event"><i class="fas fa-pen"></i></button>
