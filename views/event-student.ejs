let searchTimeout;
function handleSearch(val) {
    searchQuery = (val || '').trim();
    
    // Sync input values if both desktop & mobile exist
    const dInput = document.getElementById('eventSearchInput');
    const mInput = document.getElementById('eventSearchInputMobile');
    if (dInput && dInput.value !== searchQuery) dInput.value = searchQuery;
    if (mInput && mInput.value !== searchQuery) mInput.value = searchQuery;

    clearTimeout(searchTimeout);
    searchTimeout = setTimeout(() => {
        renderSearchDropdown(searchQuery);
        if (currentView === 'grid') {
            renderCalendar();
        } else {
            renderAgenda();
        }
    }, 180);
}

function renderSearchDropdown(q) {
    const dd = document.getElementById('searchDropdown');
    if (!dd) return;
    if (!q) { dd.classList.add('hidden'); return; }
    const results = ALL_EVENTS.filter(ev =>
        (ev.event_title || '').toLowerCase().includes(q.toLowerCase()) ||
        (ev.subject_name || '').toLowerCase().includes(q.toLowerCase()) ||
        (ev.event_description || '').toLowerCase().includes(q.toLowerCase())
    ).slice(0, 8);

    if (results.length === 0) {
        dd.innerHTML = `<p class="text-center text-xs font-semibold text-slate-400 py-3">No matching events found</p>`;
    } else {
        dd.innerHTML = results.map(ev => {
            const safeDate = escapeHtml(ev.event_date);
            const safeTitle = escapeHtml(ev.event_title);
            const safeSubj = escapeHtml(ev.subject_name);
            return `
            <div class="flex items-center gap-3 px-4 py-2.5 hover:bg-slate-50 cursor-pointer transition border-b border-slate-50 last:border-0"
                 onclick="jumpToEvent('${safeDate}')">
                <span class="w-2.5 h-2.5 rounded-full flex-shrink-0" style="background:${dotColor(ev.event_type,ev.source)}"></span>
                <div class="flex-1 min-w-0">
                    <p class="text-xs font-bold text-slate-800 truncate">${safeTitle}</p>
                    <p class="text-[10px] text-slate-400">${formatDate(ev.event_date)} ${safeSubj ? '· ' + safeSubj : ''}</p>
                </div>
                <span class="text-[9px] font-black px-1.5 py-0.5 rounded uppercase" style="background:${dotColor(ev.event_type,ev.source)}18;color:${dotColor(ev.event_type,ev.source)}">${escapeHtml(typeLabel(ev.event_type,ev.source))}</span>
            </div>`;
        }).join('');
    }
    dd.classList.remove('hidden');
}

function jumpToEvent(dateStr) {
    const d = toLocalDate(dateStr);
    if (!d) return;
    calYear  = d.getFullYear();
    calMonth = d.getMonth();
    const dd = document.getElementById('searchDropdown');
    if (dd) dd.classList.add('hidden');
    weekStartDate = getStartOfWeek(d);
    switchView('week');
}

