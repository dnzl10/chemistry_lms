function selectAllTopicAssessments(topicId) {
    // Reveal checkboxes when selection is triggered
    document.querySelectorAll('.asmt-col-cb-' + topicId).forEach(el => el.classList.remove('hidden'));

    const checkboxes = document.querySelectorAll('.asmt-row-cb-' + topicId);
    checkboxes.forEach(cb => {
        cb.checked = true;
        const row = document.getElementById('asmt-row-' + cb.getAttribute('data-assessment-id'));
        if (row) row.classList.add('bg-indigo-50/40');
    });

    const masterCb = document.getElementById('asmt-master-cb-' + topicId);
    if (masterCb) {
        masterCb.checked = true;
        masterCb.indeterminate = false;
    }

    // Toggle menu options: show Deselect All, hide Select All
    document.querySelectorAll('.asmt-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));
    document.querySelectorAll('.asmt-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));

    updateTopicAssessmentBatchBar(topicId);
}

function deselectAllTopicAssessments(topicId) {
    const checkboxes = document.querySelectorAll('.asmt-row-cb-' + topicId);
    checkboxes.forEach(cb => {
        cb.checked = false;
        const row = document.getElementById('asmt-row-' + cb.getAttribute('data-assessment-id'));
        if (row) row.classList.remove('bg-indigo-50/40');
    });

    const masterCb = document.getElementById('asmt-master-cb-' + topicId);
    if (masterCb) {
        masterCb.checked = false;
        masterCb.indeterminate = false;
    }

    // Hide checkboxes when selection is not active
    document.querySelectorAll('.asmt-col-cb-' + topicId).forEach(el => el.classList.add('hidden'));

    // Toggle menu options: hide Deselect All, show Select All
    document.querySelectorAll('.asmt-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));
    document.querySelectorAll('.asmt-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));

    updateTopicAssessmentBatchBar(topicId);
}

function toggleAllTopicAssessments(topicId, isChecked) {
    if (isChecked) {
        selectAllTopicAssessments(topicId);
    } else {
        deselectAllTopicAssessments(topicId);
    }
}

function onAssessmentRowCheckboxChange(topicId) {
    const checkboxes = Array.from(document.querySelectorAll('.asmt-row-cb-' + topicId));
    const checkedBoxes = checkboxes.filter(cb => cb.checked);
    const total = checkboxes.length;
    const checkedCount = checkedBoxes.length;

    // Highlight or unhighlight each row
    checkboxes.forEach(cb => {
        const row = document.getElementById('asmt-row-' + cb.getAttribute('data-assessment-id'));
        if (row) {
            if (cb.checked) {
                row.classList.add('bg-indigo-50/40');
            } else {
                row.classList.remove('bg-indigo-50/40');
            }
        }
    });

    // Update master checkbox state
    const masterCb = document.getElementById('asmt-master-cb-' + topicId);
    if (masterCb) {
        if (checkedCount === 0) {
            masterCb.checked = false;
            masterCb.indeterminate = false;
        } else if (checkedCount === total) {
            masterCb.checked = true;
            masterCb.indeterminate = false;
        } else {
            masterCb.checked = false;
            masterCb.indeterminate = true;
        }
    }

    if (checkedCount === 0) {
        // When selection feature is not active, keep checkboxes hidden
        document.querySelectorAll('.asmt-col-cb-' + topicId).forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.asmt-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));
        document.querySelectorAll('.asmt-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));
    } else if (checkedCount === total && total > 0) {
        document.querySelectorAll('.asmt-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));
        document.querySelectorAll('.asmt-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));
    } else {
        document.querySelectorAll('.asmt-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));
        document.querySelectorAll('.asmt-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));
    }

    updateTopicAssessmentBatchBar(topicId);
}

function updateTopicAssessmentBatchBar(topicId) {
    const countSpan = document.getElementById('asmt-selected-count-' + topicId);
    const batchBar = document.getElementById('asmt-batch-bar-' + topicId);
    if (!batchBar) return;

    const checkedBoxes = document.querySelectorAll('.asmt-row-cb-' + topicId + ':checked');
    const count = checkedBoxes.length;

    if (countSpan) countSpan.textContent = count;

    if (count > 0) {
        batchBar.classList.remove('hidden');
        batchBar.classList.add('inline-flex');
    } else {
        batchBar.classList.add('hidden');
        batchBar.classList.remove('inline-flex');
    }
}

async function toggleAssessmentLockFromMenu(aid, currentUnlocked, topicId) {
    const accessBtn = document.getElementById('asmt-lock-btn-' + aid);
    const newVal = currentUnlocked ? 0 : 1;
    try {
        const res = await fetch('/teacher/api/assessment/' + aid + '/unlock', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_unlocked: newVal })
        });
        if (!res.ok) throw new Error();

        // Update menu item
        const menuLockBtn = document.getElementById('asmt-menu-lock-' + aid);
        if (menuLockBtn) {
            menuLockBtn.setAttribute('data-unlocked', newVal);
            menuLockBtn.setAttribute('onclick', `closeAllAssessmentMenus(); toggleAssessmentLockFromMenu(${aid}, ${newVal}, ${topicId})`);
            const mIcon = menuLockBtn.querySelector('i');
            if (mIcon) mIcon.className = `fas fa-${newVal ? 'lock' : 'lock-open'} text-slate-400 w-3.5 text-center`;
            const mSpan = menuLockBtn.querySelector('span');
            if (mSpan) mSpan.textContent = newVal ? 'Lock' : 'Unlock';
        }

        // Update Access column button if present
        if (accessBtn) {
            accessBtn.className = 'lock-btn ' + (newVal ? 'unlocked' : 'locked');
            accessBtn.style.cssText = 'width:26px;height:26px';
            const icon = accessBtn.querySelector('i');
            if (icon) icon.className = 'fas fa-' + (newVal ? 'lock-open' : 'lock') + ' text-xs';
            accessBtn.title = newVal ? 'Lock assessment' : 'Unlock assessment';
            accessBtn.setAttribute('onclick', 'toggleAssessmentLock(' + aid + ', ' + newVal + ', this)');
        }

        cmToast('Assessment ' + (newVal ? 'unlocked' : 'locked') + '.', 'success');
    } catch(e) {
        cmToast('Failed to update assessment.', 'error');
    }
}

