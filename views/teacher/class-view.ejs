                            <i class="fas fa-calendar-check text-[10px]"></i> View History
                        </button>
                        <button type="button" onclick="openStudentDirectComm('${s.student_id}', '${encodeURIComponent(s.name)}')"
                            class="flex-1 py-1.5 px-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-lg text-[11px] font-bold transition flex items-center justify-center gap-1 shadow-sm">
                            <i class="fas fa-paper-plane text-[10px]"></i> Reach Out
                        </button>
                    </div>
                </div>`;
            });
            cardsHtml += '</div>';
            container.innerHTML = cardsHtml;
        }

        // --- RENDER MASTER ATTENDANCE PERFORMANCE TABLE ---
        function renderAttendanceMasterTable(studentStats) {
            const tbody = document.getElementById('attMasterTableBody');
            if (!tbody) return;

            const searchTerm = (document.getElementById('attMasterSearch')?.value || '').toLowerCase().trim();

            let filtered = studentStats.filter(s => {
                const matchesSearch = !searchTerm || s.name.toLowerCase().includes(searchTerm) || (s.lrn_number && s.lrn_number.includes(searchTerm)) || (s.email && s.email.toLowerCase().includes(searchTerm));
                
                let matchesFilter = true;
                if (currentMasterTierFilter === 'online') {
                    matchesFilter = s.is_online_now === true;
                } else if (currentMasterTierFilter === 'risk') {
                    matchesFilter = s.tier === 'Critical' || s.tier === 'At Risk' || (s.days_since_login === null || s.days_since_login > 7);
                } else if (currentMasterTierFilter === 'lms_inactive') {
                    matchesFilter = s.days_since_login === null || s.days_since_login > 7;
                } else if (currentMasterTierFilter === 'all_star') {
                    matchesFilter = s.engagementCategory && s.engagementCategory.includes('All-Star');
                } else if (currentMasterTierFilter === 'Exemplary') {
                    matchesFilter = s.tier === 'Exemplary';
                }

                return matchesSearch && matchesFilter;
            });

            if (!filtered.length) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="12" class="table-empty-cell">
                            <div class="standard-empty-state">
                                <div class="w-14 h-14 rounded-2xl bg-slate-100 border border-slate-200 text-slate-400 flex items-center justify-center text-xl mx-auto mb-3.5 shadow-sm">
                                    <i class="fas fa-users-slash"></i>
                                </div>
                                <h4 class="text-sm font-bold text-slate-700 mb-1">No matching students found</h4>
                                <p class="text-xs text-slate-400 max-w-sm mx-auto">No students match the selected attendance tier filter or search query.</p>
                            </div>
                        </td>
                    </tr>`;
                return;
            }

            let rows = '';
            filtered.forEach((s, idx) => {
                const avatar = s.profile_pic ? '/profile_uploads/' + s.profile_pic : '/assets/logo.png';
                let barColor = 'bg-emerald-500';
                if (s.attendance_rate < 75) barColor = 'bg-rose-500';
                else if (s.attendance_rate < 85) barColor = 'bg-amber-500';
                else if (s.attendance_rate < 95) barColor = 'bg-blue-500';

                // LMS Presence Pill
                let lmsPill = '';
                if (s.is_online_now) {
                    lmsPill = `
                        <div class="flex items-center gap-1.5">
                            <span class="relative flex h-2.5 w-2.5">
                                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
                            </span>
                            <span class="text-xs font-black text-emerald-700">Online Now</span>
                        </div>
                        <span class="text-[10px] text-slate-400 font-medium block">Actively in LMS</span>`;
                } else if (s.days_since_login === 0) {
                    lmsPill = `
                        <span class="px-2 py-0.5 rounded-md text-[10px] font-black bg-blue-100 text-blue-800 border border-blue-200">Active Today</span>
                        <span class="text-[10px] text-slate-400 block">${s.last_login_formatted}</span>`;
                } else if (s.days_since_login !== null && s.days_since_login <= 7) {
                    lmsPill = `
                        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-purple-100 text-purple-800 border border-purple-200">${s.days_since_login}d ago</span>
                        <span class="text-[10px] text-slate-400 block">${s.last_login_formatted}</span>`;
                } else if (s.days_since_login !== null) {
                    lmsPill = `
                        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-amber-100 text-amber-800 border border-amber-200">${s.days_since_login}d inactive</span>
                        <span class="text-[10px] text-slate-400 block">${s.last_login_formatted}</span>`;
                } else {
                    lmsPill = `
                        <span class="px-2 py-0.5 rounded-md text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">Never Logged In</span>
                        <span class="text-[10px] text-rose-500 font-bold block">No LMS activity</span>`;
                }

                rows += `
                <tr class="hover:bg-slate-50/80 transition">
                    <td class="text-xs font-black text-slate-400">${idx + 1}</td>
                    <td>
                        <div class="flex items-center gap-2.5">
                            <div class="relative">
                                <img src="${avatar}" class="w-8 h-8 rounded-full object-cover border border-slate-200" onerror="this.src='/assets/logo.png'">
                                ${s.is_online_now ? '<span class="absolute bottom-0 right-0 w-2.5 h-2.5 rounded-full bg-emerald-500 border-2 border-white"></span>' : ''}
                            </div>
                            <div>
                                <p class="font-bold text-xs text-slate-800 leading-tight">${s.name}</p>
                                <span class="text-[10px] text-slate-400">${s.email || s.sex || '—'}</span>
                            </div>
                        </div>
                    </td>
                    <td class="text-xs font-mono text-slate-600">${s.lrn_number}</td>
                    <td>${lmsPill}</td>
                    <td class="text-center">
                        <span class="font-black text-xs text-slate-700">${s.total_logins}</span>
                        <span class="text-[10px] text-slate-400 font-medium block">${s.active_lms_days} active days</span>
                    </td>
                    <td class="text-center font-bold text-xs text-emerald-600">${s.present_count}</td>
                    <td class="text-center font-bold text-xs text-amber-600">${s.late_count}</td>
                    <td class="text-center font-bold text-xs text-rose-600">${s.absent_count}</td>
                    <td class="text-center font-bold text-xs text-sky-600">${s.excused_count}</td>
                    <td>
                        <div>
                            <div class="flex items-center justify-between text-[11px] font-black mb-1">
                                <span class="text-slate-800">${s.attendance_rate}%</span>
                                <span class="text-[10px] text-slate-400 font-bold">${s.attended_count}/${s.total_sessions} sessions</span>
                            </div>
                            <div class="w-full bg-slate-100 rounded-full h-1.5 overflow-hidden">
                                <div class="h-full rounded-full ${barColor}" style="width: ${Math.min(100, s.attendance_rate)}%"></div>
                            </div>
                        </div>
                    </td>
                    <td class="text-center">
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black uppercase tracking-wider border ${s.engagementBadge || 'bg-slate-100 text-slate-600'}">
                            ${s.engagementCategory || s.tier}
                        </span>
                    </td>
                    <td class="text-center">
                        <button type="button" onclick="openStudentAttendanceHistory(${s.student_id})"
                            class="px-2.5 py-1 bg-indigo-50 hover:bg-indigo-100 text-indigo-700 rounded-lg text-xs font-bold transition inline-flex items-center gap-1 border border-indigo-200 shadow-sm">
                            <i class="fas fa-eye text-[10px]"></i> History
                        </button>
                    </td>
                </tr>`;
            });
            tbody.innerHTML = rows;
        }

        function filterAttendanceMasterTable() {
            if (!currentAttendanceAnalytics || !currentAttendanceAnalytics.studentStats) return;
            renderAttendanceMasterTable(currentAttendanceAnalytics.studentStats);
        }

        function filterByAttendanceTier(tier, btn) {
            currentMasterTierFilter = tier;
            document.querySelectorAll('.att-tier-pill').forEach(p => {
                p.className = 'att-tier-pill px-3 py-1 rounded-lg text-[10px] font-black uppercase transition text-slate-500 hover:text-indigo-700';
            });
            btn.className = 'att-tier-pill px-3 py-1 rounded-lg text-[10px] font-black uppercase transition bg-white text-indigo-700 shadow-sm';
            filterAttendanceMasterTable();
        }

        // --- STUDENT ATTENDANCE HISTORY MODAL ---
        async function openStudentAttendanceHistory(studentId) {
            const modalBody = document.getElementById('attModalHistoryBody');
            modalBody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-400"><i class="fas fa-spinner fa-spin text-indigo-500 text-base mb-1 block"></i>Loading historical records...</td></tr>';
            openModal('attStudentHistoryModal');

            try {
                const res = await fetch(`/teacher/api/attendance/<%= classInfo.class_id %>/student/${studentId}/history`);
                const data = await res.json();
                if (!data.success) throw new Error(data.error || 'Failed to fetch student history');

                const student = data.student || {};
                const history = data.history || [];

                document.getElementById('attModalStudentAvatar').src = student.profile_pic ? '/profile_uploads/' + student.profile_pic : '/assets/logo.png';
                document.getElementById('attModalStudentName').textContent = `${student.last_name}, ${student.first_name}`;
                document.getElementById('attModalStudentLrn').textContent = `LRN: ${student.lrn_number || '—'} · ${student.sex || '—'} · ${student.email || '—'}`;

                // Update LMS Telemetry in Modal
                const lmsBadge = document.getElementById('attModalLmsStatusBadge');
                if (lmsBadge) {
                    if (student.is_online_now) {
                        lmsBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-500/20 text-emerald-300 border border-emerald-500/30';
                        lmsBadge.innerHTML = '<span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block mr-1 animate-pulse"></span> Online Now';
                    } else {
                        lmsBadge.className = 'px-2.5 py-0.5 rounded-full text-[10px] font-black bg-slate-800 text-slate-400 border border-slate-700';
                        lmsBadge.textContent = 'Offline';
                    }
                }
                const lastLoginEl = document.getElementById('attModalLastLogin');
                if (lastLoginEl) lastLoginEl.textContent = student.last_login_formatted || 'Never logged in';
                const totalLoginsEl = document.getElementById('attModalTotalLogins');
                if (totalLoginsEl) totalLoginsEl.textContent = student.total_logins || 0;
                const activeDaysEl = document.getElementById('attModalActiveDays');
                if (activeDaysEl) activeDaysEl.textContent = student.active_lms_days || 0;

                // Calculate counts
                let pres = 0, late = 0, abs = 0, exc = 0;
                history.forEach(h => {
                    if (h.status === 'Present') pres++;
                    else if (h.status === 'Late') late++;
                    else if (h.status === 'Absent') abs++;
                    else if (h.status === 'Excused') exc++;
                });
                const total = history.length;
                const attended = pres + late;
                const rate = total > 0 ? Math.round((attended / total) * 100) : 0;

                document.getElementById('attModalPresentCount').textContent = pres;
                document.getElementById('attModalLateCount').textContent = late;
                document.getElementById('attModalAbsentCount').textContent = abs;
                document.getElementById('attModalRate').textContent = rate + '%';

                if (!history.length) {
                    modalBody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-400 font-medium">No recorded attendance logs for this student yet.</td></tr>';
                    return;
                }

                let historyRows = '';
                history.forEach(h => {
                    let badge = '';
                    if (h.status === 'Present') badge = '<span class="px-2 py-0.5 rounded-md text-[10px] font-black bg-emerald-100 text-emerald-700">Present</span>';
                    else if (h.status === 'Late') badge = '<span class="px-2 py-0.5 rounded-md text-[10px] font-black bg-amber-100 text-amber-700">Late</span>';
                    else if (h.status === 'Absent') badge = '<span class="px-2 py-0.5 rounded-md text-[10px] font-black bg-rose-100 text-rose-700">Absent</span>';
                    else if (h.status === 'Excused') badge = '<span class="px-2 py-0.5 rounded-md text-[10px] font-black bg-sky-100 text-sky-700">Excused</span>';
                    else badge = '<span class="px-2 py-0.5 rounded-md text-[10px] font-black bg-slate-100 text-slate-600">Unmarked</span>';

                    historyRows += `
                    <tr class="hover:bg-slate-50">
                        <td class="p-2.5 font-bold text-slate-800">${h.session_date}</td>
                        <td class="p-2.5 text-slate-500 font-medium">${h.day_name || '—'}</td>
                        <td class="p-2.5 text-center">${badge}</td>
                        <td class="p-2.5 font-mono text-slate-600">${h.check_in_time || '—'}</td>
                        <td class="p-2.5 text-slate-500 text-[11px]">${h.attendance_method || 'Manual_Teacher'}</td>
                        <td class="p-2.5 text-slate-600 italic text-[11px]">${h.override_reason || '—'}</td>
                    </tr>`;
                });
                modalBody.innerHTML = historyRows;
            } catch (err) {
                console.error(err);
                modalBody.innerHTML = '<tr><td colspan="6" class="p-6 text-center text-rose-500 font-bold">' + err.message + '</td></tr>';
            }
        }

        function printStudentAttendanceHistory() {
            const studentName = document.getElementById('attModalStudentName')?.textContent || 'Student';
            const studentLrn = document.getElementById('attModalStudentLrn')?.textContent || '';
            const pres = document.getElementById('attModalPresentCount')?.textContent || '0';
            const late = document.getElementById('attModalLateCount')?.textContent || '0';
            const abs = document.getElementById('attModalAbsentCount')?.textContent || '0';
            const rate = document.getElementById('attModalRate')?.textContent || '0%';
            const lastActive = document.getElementById('attModalLastLogin')?.textContent || 'Never';
            const totalLogins = document.getElementById('attModalTotalLogins')?.textContent || '0';
            const historyBody = document.getElementById('attModalHistoryBody')?.innerHTML || '';

