                                </div>
                            </div>

                            <!-- Student Physical Stats Ribbon -->
                            <div class="grid grid-cols-4 gap-2 text-center">
                                <div class="p-2.5 bg-emerald-50 rounded-xl border border-emerald-100">
                                    <span class="block text-[10px] font-black uppercase tracking-wider text-emerald-600">Present</span>
                                    <span class="text-lg font-black text-emerald-700" id="attModalPresentCount">0</span>
                                </div>
                                <div class="p-2.5 bg-amber-50 rounded-xl border border-amber-100">
                                    <span class="block text-[10px] font-black uppercase tracking-wider text-amber-600">Late</span>
                                    <span class="text-lg font-black text-amber-700" id="attModalLateCount">0</span>
                                </div>
                                <div class="p-2.5 bg-rose-50 rounded-xl border border-rose-100">
                                    <span class="block text-[10px] font-black uppercase tracking-wider text-rose-600">Absent</span>
                                    <span class="text-lg font-black text-rose-700" id="attModalAbsentCount">0</span>
                                </div>
                                <div class="p-2.5 bg-sky-50 rounded-xl border border-sky-100">
                                    <span class="block text-[10px] font-black uppercase tracking-wider text-sky-600">Attendance Rate</span>
                                    <span class="text-lg font-black text-sky-700" id="attModalRate">0%</span>
                                </div>
                            </div>

                            <!-- History Timeline Table -->
                            <div>
                                <h4 class="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                    <i class="fas fa-clock-rotate-left text-indigo-500"></i> Date-by-Date Attendance Logs
                                </h4>
                                <div class="rounded-xl border border-slate-200 overflow-hidden">
                                    <table class="w-full text-xs">
                                        <thead class="bg-slate-50 text-slate-500 border-b border-slate-200">
                                            <tr>
                                                <th class="p-2.5 text-left font-black uppercase text-[10px]">Session Date</th>
                                                <th class="p-2.5 text-left font-black uppercase text-[10px]">Day</th>
                                                <th class="p-2.5 text-center font-black uppercase text-[10px]">Status</th>
                                                <th class="p-2.5 text-left font-black uppercase text-[10px]">Time In</th>
                                                <th class="p-2.5 text-left font-black uppercase text-[10px]">Recorded Via</th>
                                                <th class="p-2.5 text-left font-black uppercase text-[10px]">Teacher Notes / Reason</th>
                                            </tr>
                                        </thead>
                                        <tbody id="attModalHistoryBody" class="divide-y divide-slate-100">
