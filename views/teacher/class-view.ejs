// -------------------------------------------------------------
// ASSIGNMENT MODAL: GROUP SETS & CHECKBOX SELECTOR
// -------------------------------------------------------------

async function loadGroupSetsDropdown(selectedSetId = null) {
    try {
        const res = await fetch(`/teacher/api/classes/${currentClassId}/group-sets`);
        const data = await res.json();
        const sel = document.getElementById('asgnGroupSetPicker');
        if (!sel) return;

        cachedGroupSets = (data && (data.groupSets || data.group_sets)) || [];
        sel.innerHTML = '<option value="">-- Choose Group Set --</option>';

        if (data && data.success && cachedGroupSets.length > 0) {
            cachedGroupSets.forEach(gs => {
                const opt = document.createElement('option');
                opt.value = gs.group_set_id;
                const name = gs.set_name || gs.title || 'Untitled Group Set';
                const count = gs.group_count !== undefined ? gs.group_count : (gs.groups ? gs.groups.length : 0);
                opt.textContent = `${name} (${count} groups)`;
                sel.appendChild(opt);
            });

            // Determine which set to select
            let targetSetId = selectedSetId;
            if (!targetSetId || !cachedGroupSets.some(gs => Number(gs.group_set_id) === Number(targetSetId))) {
                targetSetId = cachedGroupSets[0].group_set_id;
            }

            sel.value = targetSetId;
            onGroupSetPickerChange(targetSetId);
        } else {
            sel.innerHTML = '<option value="">-- No Group Sets Available --</option>';
            document.getElementById('asgnGroupSetId').value = '';
            document.getElementById('asgnGroupCheckboxList').innerHTML = '<div class="text-center py-4 text-slate-400 italic text-[11px]">No group sets created yet. Click "Manage Group Sets" above.</div>';
            updateSelectedGroupsCount();
        }
    } catch (err) {
        console.error('Failed to load group sets dropdown:', err);
    }
}

function onGroupSetPickerChange(setId) {
    const hiddenInp = document.getElementById('asgnGroupSetId');
    if (hiddenInp) hiddenInp.value = setId || '';
    renderGroupCheckboxesForSet(setId);
}

function renderGroupCheckboxesForSet(setId) {
    const listEl = document.getElementById('asgnGroupCheckboxList');
    if (!listEl) return;

    if (!setId) {
        listEl.innerHTML = '<div class="text-center py-3 text-slate-400 italic text-[11px]">Choose a group set above to view its groups.</div>';
        updateSelectedGroupsCount();
        return;
    }

    const gs = cachedGroupSets.find(s => Number(s.group_set_id) === Number(setId));
    if (!gs || !gs.groups || gs.groups.length === 0) {
        listEl.innerHTML = '<div class="text-center py-3 text-slate-400 italic text-[11px]">This group set has no generated groups yet. Use "Manage Group Sets" to add groups.</div>';
        updateSelectedGroupsCount();
        return;
    }

    listEl.innerHTML = gs.groups.map(g => {
        const memCount = g.members ? g.members.length : 0;
        const memberNames = g.members && g.members.length > 0
            ? g.members.map(m => m.first_name).join(', ')
            : 'No students assigned';
        return `
            <label class="flex items-center justify-between p-2 rounded-lg bg-slate-50 border border-slate-200/80 hover:bg-blue-50/50 cursor-pointer transition">
                <div class="flex items-center gap-2 truncate">
                    <input type="checkbox" class="asgn-group-item-cb accent-blue-600" value="${g.group_id}" checked onchange="onIndividualGroupCheckboxChange()">
                    <span class="font-bold text-slate-800 text-xs">${g.group_name}</span>
                    <span class="text-[10px] text-slate-400 truncate">(${memberNames})</span>
                </div>
                <span class="text-[10px] px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 font-bold shrink-0">
                    ${memCount} stds
                </span>
            </label>
        `;
    }).join('');

    const masterCb = document.getElementById('asgnSelectAllGroups');
    if (masterCb) masterCb.checked = true;
    updateSelectedGroupsCount();
}

function toggleSelectAllGroups(checked) {
    document.querySelectorAll('.asgn-group-item-cb').forEach(cb => {
        cb.checked = checked;
    });
    updateSelectedGroupsCount();
}

function onIndividualGroupCheckboxChange() {
    const allCbs = document.querySelectorAll('.asgn-group-item-cb');
    const checkedCbs = document.querySelectorAll('.asgn-group-item-cb:checked');
    const masterCb = document.getElementById('asgnSelectAllGroups');
    if (masterCb) {
        masterCb.checked = (allCbs.length > 0 && allCbs.length === checkedCbs.length);
    }
    updateSelectedGroupsCount();
}

function updateSelectedGroupsCount() {
    const checkedCbs = document.querySelectorAll('.asgn-group-item-cb:checked');
    const badge = document.getElementById('asgnSelectedGroupsCount');
    if (badge) {
        badge.textContent = `${checkedCbs.length} groups selected`;
    }
}

