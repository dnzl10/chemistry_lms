let pendingMaterialSavePayload = null;

async function submitMaterialForm(e) {
    e.preventDefault();
 
    const form     = e.target;
    const fd       = new FormData(form);
    const id       = fd.get('material_id');
    const isEdit   = !!id;
    const sourceMode = document.getElementById('matSrcFileBtn').style.background === 'white' ? 'file' : 'url';
    const matType  = fd.get('material_type');
    const baseTitle = (fd.get('title') || '').trim();

    if (!baseTitle) {
        cmToast('Title is required.', 'error');
        return;
    }

    let urlVal = '';
    if (sourceMode === 'url') {
        urlVal = (fd.get('file_path_or_url') || '').trim();
        if (!urlVal) {
            cmToast('Please provide a valid resource URL.', 'error');
            return;
        }
    } else {
        // Source mode is 'file'
        if (matSelectedFiles.length === 0) {
            if (!isEdit) {
                cmToast('Please attach at least one file or switch to URL mode.', 'error');
                return;
            }
        } else {
            // Verify all attached files match the selected Material Type
            const allValid = revalidateMatFiles();
            if (!allValid) {
                cmToast('Cannot submit: One or more files do not match the selected Material Type or exceed size limits.', 'error');
                return;
            }
        }
    }

    // Save pending context
    pendingMaterialSavePayload = {
        form,
        fd,
        id,
        isEdit,
        sourceMode,
        matType,
        baseTitle,
        urlVal
    };

    // Populate Save Confirmation Modal
    const confirmTitleEl = document.getElementById('matSaveConfirmTitle');
    const confirmSubEl = document.getElementById('matSaveConfirmSubtitle');
    const confirmMsgEl = document.getElementById('matSaveConfirmMsg');
    const executeBtnText = document.getElementById('matExecuteSaveBtnText');
    const sumTitle = document.getElementById('matConfirmSummaryTitle');
    const sumType = document.getElementById('matConfirmSummaryType');
    const sumSource = document.getElementById('matConfirmSummarySource');
    const sumLock = document.getElementById('matConfirmSummaryLock');

    if (confirmTitleEl) confirmTitleEl.textContent = isEdit ? 'Confirm Save Changes' : 'Confirm Add Material';
    if (confirmSubEl) confirmSubEl.textContent = isEdit ? 'Review your modifications before saving' : 'Review material details before adding';
    
    if (sumTitle) sumTitle.textContent = baseTitle;
    if (sumType) {
        const typeRule = (typeof MATERIAL_TYPE_RULES !== 'undefined') ? MATERIAL_TYPE_RULES[matType] : null;
        sumType.textContent = (typeRule ? typeRule.label : matType).toUpperCase();
    }
    
    if (sumSource) {
        if (sourceMode === 'url') {
            sumSource.textContent = 'URL: ' + (urlVal.length > 35 ? urlVal.substring(0, 32) + '...' : urlVal);
        } else if (matSelectedFiles.length === 0 && isEdit) {
            sumSource.textContent = 'Keep existing attached file';
        } else if (matSelectedFiles.length === 1) {
            sumSource.textContent = `1 file: ${matSelectedFiles[0].file.name}`;
        } else {
            sumSource.textContent = `${matSelectedFiles.length} files queued (batch upload)`;
        }
    }

    const isLocked = !!fd.get('is_locked');
    if (sumLock) {
        sumLock.textContent = isLocked ? 'Locked (Hidden from students)' : 'Unlocked (Accessible to students)';
        sumLock.className = isLocked ? 'font-semibold text-orange-600' : 'font-semibold text-emerald-600';
    }

    if (confirmMsgEl) {
        if (isEdit) {
            confirmMsgEl.textContent = 'Are you sure you want to finalize and save the changes to this learning material?';
        } else {
            confirmMsgEl.textContent = matSelectedFiles.length > 1
                ? `Are you sure you want to upload all ${matSelectedFiles.length} files to this topic?`
                : 'Are you sure you want to save and add this learning material to the topic?';
        }
    }

    if (executeBtnText) {
        executeBtnText.textContent = isEdit ? 'Yes, Save Changes' : 'Yes, Upload & Save';
    }

    openModal('matSaveConfirmModal');
}

async function confirmExecuteMaterialSave() {
    closeModal('matSaveConfirmModal');
    if (!pendingMaterialSavePayload) return;

    const { id, isEdit, sourceMode, matType, baseTitle, urlVal, fd } = pendingMaterialSavePayload;
    const saveBtn = document.getElementById('matSaveBtn');

    if (sourceMode === 'url') {
        const endpoint = isEdit ? '/teacher/api/material/' + id : '/teacher/api/material';
        const method = isEdit ? 'PUT' : 'POST';
        const payload = new FormData();
        payload.append('topic_id', fd.get('topic_id'));
        payload.append('title', baseTitle);
        payload.append('material_type', matType);
        payload.append('file_path_or_url', urlVal);
        payload.append('is_locked', fd.get('is_locked') ? '1' : '0');

        saveBtn.disabled = true;
        saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-sm"></i> Saving…';
        try {
            const res = await fetch(endpoint, { method, body: payload });
            const data = await res.json().catch(() => ({}));
            if (!res.ok) throw new Error(data.error || 'Failed to save material URL');
            matInitialState = null;
            closeModal('materialModal');
            cmToast(isEdit ? 'Material updated successfully!' : 'Material added successfully!', 'success');
            await refreshClassViewContent({ ensureTopicOpen: fd.get('topic_id'), ensureSubTab: 'materials' });
        } catch (err) {
            cmToast('Failed: ' + err.message, 'error');
        } finally {
            saveBtn.disabled = false;
            saveBtn.innerHTML = '<i class="fas fa-save text-sm"></i> <span id="matSaveBtnText">' + (isEdit ? 'Save Changes' : 'Save Material') + '</span>';
        }
        return;
    }

    // Source mode is 'file'
    if (matSelectedFiles.length === 0) {
        if (isEdit) {
            // Edit mode with no new file uploaded -> update metadata and retain existing file
            const endpoint = '/teacher/api/material/' + id;
            const payload = new FormData();
            payload.append('topic_id', fd.get('topic_id'));
            payload.append('title', baseTitle);
            payload.append('material_type', matType);
            payload.append('is_locked', fd.get('is_locked') ? '1' : '0');

            saveBtn.disabled = true;
            saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-sm"></i> Saving…';
            try {
                const res = await fetch(endpoint, { method: 'PUT', body: payload });
                const data = await res.json().catch(() => ({}));
                if (!res.ok) throw new Error(data.error || 'Failed to update material');
                matInitialState = null;
                closeModal('materialModal');
                cmToast('Material updated successfully!', 'success');
                await refreshClassViewContent({ ensureTopicOpen: fd.get('topic_id'), ensureSubTab: 'materials' });
            } catch (err) {
                cmToast('Failed: ' + err.message, 'error');
            } finally {
                saveBtn.disabled = false;
                saveBtn.innerHTML = '<i class="fas fa-save text-sm"></i> <span id="matSaveBtnText">Save Changes</span>';
            }
            return;
        } else {
            cmToast('Please attach at least one file or switch to URL mode.', 'error');
            return;
        }
    }

    // Execute upload (batch or single)
    const progressWrap = document.getElementById('matUploadProgress');
    const progressBar  = document.getElementById('matProgressBar');
    const progressPct  = document.getElementById('matProgressPercent');
    const progressLbl  = document.getElementById('matProgressLabel');

    saveBtn.disabled = true;
    saveBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-sm"></i> Uploading…';
    if (progressWrap) progressWrap.style.display = 'block';

    const totalFiles = matSelectedFiles.length;
    let successCount = 0;
    let errors = [];

    for (let i = 0; i < totalFiles; i++) {
        const item = matSelectedFiles[i];
        const isEditTarget = isEdit && i === 0;
        const uploadUrl = isEditTarget ? ('/teacher/api/material/' + id) : '/teacher/api/material';
        const uploadMethod = isEditTarget ? 'PUT' : 'POST';

        let itemTitle = (item.title || '').trim();
        if (!itemTitle) {
            itemTitle = totalFiles === 1 ? baseTitle : (baseTitle ? `${baseTitle} - ${item.file.name.replace(/\.[^/.]+$/, "")}` : item.file.name.replace(/\.[^/.]+$/, ""));
        }

        const itemPayload = new FormData();
        itemPayload.append('topic_id', fd.get('topic_id'));
        itemPayload.append('title', itemTitle);
        itemPayload.append('material_type', matType);
        itemPayload.append('is_locked', fd.get('is_locked') ? '1' : '0');
        itemPayload.append('file', item.file);

        item.status = 'uploading';
        item.progress = 0;
        renderMatFilesPreview();

        try {
            await new Promise((resolve, reject) => {
                const xhr = new XMLHttpRequest();
                xhr.open(uploadMethod, uploadUrl);

                xhr.upload.addEventListener('progress', (ev) => {
                    if (ev.lengthComputable) {
                        const filePct = Math.round((ev.loaded / ev.total) * 100);
                        item.progress = filePct;
                        const overallPct = Math.round(((i + (filePct / 100)) / totalFiles) * 100);
                        if (progressBar) progressBar.style.width = overallPct + '%';
                        if (progressPct) progressPct.textContent = overallPct + '%';
                        if (progressLbl) progressLbl.textContent = `Uploading file ${i + 1} of ${totalFiles}: "${itemTitle}" (${filePct}%)`;
                    }
                });

                xhr.onload = () => {
                    if (xhr.status >= 200 && xhr.status < 300) {
                        item.status = 'completed';
                        item.progress = 100;
                        successCount++;
                        renderMatFilesPreview();
                        resolve();
                    } else {
                        let errMsg = 'Upload failed (' + xhr.status + ')';
                        try {
                            const parsed = JSON.parse(xhr.responseText);
                            if (parsed.error) errMsg = parsed.error;
                        } catch (pe) {}
                        item.status = 'error';
                        item.errorReason = errMsg;
                        errors.push(`${item.file.name}: ${errMsg}`);
                        renderMatFilesPreview();
                        resolve();
                    }
                };

                xhr.onerror = () => {
                    item.status = 'error';
                    item.errorReason = 'Network transmission error';
                    errors.push(`${item.file.name}: Network error`);
                    renderMatFilesPreview();
                    resolve();
                };

                xhr.send(itemPayload);
            });
        } catch (uploadException) {
            item.status = 'error';
            item.errorReason = uploadException.message;
            errors.push(`${item.file.name}: ${uploadException.message}`);
            renderMatFilesPreview();
        }
    }

    if (progressBar) progressBar.style.width = '100%';
    if (progressPct) progressPct.textContent = '100%';

    if (errors.length === 0) {
        if (progressLbl) progressLbl.textContent = 'All files uploaded successfully!';
        cmToast(totalFiles > 1 ? `All ${totalFiles} materials uploaded successfully!` : 'Material saved successfully!', 'success');
        matInitialState = null;
        closeModal('materialModal');
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<i class="fas fa-save text-sm"></i> <span id="matSaveBtnText">' + (isEdit ? 'Save Changes' : 'Save Material') + '</span>';
        if (progressWrap) progressWrap.style.display = 'none';
        await refreshClassViewContent({ ensureTopicOpen: fd.get('topic_id'), ensureSubTab: 'materials' });
    } else if (successCount > 0) {
        if (progressLbl) progressLbl.textContent = `Completed with issues: ${successCount} uploaded, ${errors.length} failed.`;
        cmToast(`Uploaded ${successCount} file(s), ${errors.length} failed. Check error indicators.`, 'error');
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<i class="fas fa-save text-sm"></i> <span id="matSaveBtnText">' + (isEdit ? 'Retry Failed' : 'Save Material') + '</span>';
    } else {
        if (progressLbl) progressLbl.textContent = 'Upload failed.';
        cmToast('Failed to upload files: ' + errors.join('; '), 'error');
        saveBtn.disabled = false;
        saveBtn.innerHTML = '<i class="fas fa-save text-sm"></i> <span id="matSaveBtnText">' + (isEdit ? 'Save Changes' : 'Save Material') + '</span>';
    }
}

