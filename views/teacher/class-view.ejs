function onAssignmentRowCheckboxChange(topicId) {
    const checkboxes = Array.from(document.querySelectorAll('.asgn-row-cb-' + topicId));
    const checkedBoxes = checkboxes.filter(cb => cb.checked);
    const total = checkboxes.length;
    const checkedCount = checkedBoxes.length;

    // Highlight or unhighlight each row
    checkboxes.forEach(cb => {
        const row = document.getElementById('asgn-row-' + cb.getAttribute('data-assignment-id'));
        if (row) {
            if (cb.checked) {
                row.classList.add('bg-indigo-50/40');
            } else {
                row.classList.remove('bg-indigo-50/40');
            }
        }
    });

    // Update master checkbox state
    const masterCb = document.getElementById('asgn-master-cb-' + topicId);
    if (masterCb) {
        if (checkedCount === 0) {
            masterCb.checked = false;
            masterCb.indeterminate = false;
        } else if (checkedCount === total) {
            masterCb.checked = true;
            masterCb.indeterminate = false;
        } else {
            masterCb.checked = false;
            masterCb.indeterminate = true;
        }
    }

    if (checkedCount === 0) {
        // When selection feature is not active, keep checkboxes hidden
        document.querySelectorAll('.asgn-col-cb-' + topicId).forEach(el => el.classList.add('hidden'));
        document.querySelectorAll('.asgn-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));
        document.querySelectorAll('.asgn-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));
    } else if (checkedCount === total && total > 0) {
        document.querySelectorAll('.asgn-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));
        document.querySelectorAll('.asgn-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));
    } else {
        document.querySelectorAll('.asgn-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));
        document.querySelectorAll('.asgn-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));
    }

    updateTopicAssignmentBatchBar(topicId);
}

function updateTopicAssignmentBatchBar(topicId) {
