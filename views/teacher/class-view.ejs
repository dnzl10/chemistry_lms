async function batchToggleAssessmentLock(topicId, unlockVal) {
    const checkedBoxes = Array.from(document.querySelectorAll('.asmt-row-cb-' + topicId + ':checked'));
    if (!checkedBoxes.length) {
        cmToast('No assessments selected.', 'warning');
        return;
    }
    const ids = checkedBoxes.map(cb => cb.getAttribute('data-assessment-id'));
    const actionWord = unlockVal ? 'unlocked' : 'locked';
    cmToast(`Updating ${ids.length} assessment(s)...`, 'info');

    try {
        const results = await Promise.all(ids.map(id =>
            fetch('/teacher/api/assessment/' + id + '/unlock', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
