                                                                    </button>
                                                                    <div id="mat-dropdown-<%= mat.material_id %>" 
                                                                         class="mat-dropdown-menu hidden absolute right-0 mt-1 w-44 rounded-xl shadow-xl bg-white border border-slate-200 z-50 py-1.5 focus:outline-none"
                                                                         style="box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08);">
                                                                        <!-- Edit -->
                                                                        <button type="button" 
                                                                                class="w-full text-left px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-indigo-600 flex items-center gap-2.5 transition-colors cursor-pointer"
                                                                                onclick="closeAllMaterialMenus(); openMaterialModal(<%= mat.material_id %>, <%= topic.topic_id %>, '<%= mat.title.replace(/'/g,"\\'") %>', '<%= mat.material_type %>', '<%= (mat.file_path_or_url || '').replace(/^(\/material_uploads\/)+/, '').replace(/'/g,"\\'") %>', <%= mat.is_locked ? 1 : 0 %>)">
                                                                            <i class="fas fa-pen text-slate-400 w-3.5 text-center"></i>
                                                                            <span>Edit</span>
                                                                        </button>

                                                                        <!-- Lock / Unlock -->
                                                                        <button type="button" 
                                                                                id="mat-menu-lock-<%= mat.material_id %>"
                                                                                data-topic-id="<%= topic.topic_id %>"
                                                                                class="w-full text-left px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-indigo-600 flex items-center gap-2.5 transition-colors cursor-pointer"
                                                                                data-locked="<%= mat.is_locked ? 1 : 0 %>"
                                                                                onclick="closeAllMaterialMenus(); toggleMaterialLockFromMenu(<%= mat.material_id %>, <%= mat.is_locked ? 1 : 0 %>, <%= topic.topic_id %>)">
                                                                            <i class="fas fa-<%= mat.is_locked ? 'lock-open' : 'lock' %> text-slate-400 w-3.5 text-center"></i>
                                                                            <span><%= mat.is_locked ? 'Unlock' : 'Lock' %></span>
                                                                        </button>



                                                                        <div class="my-1 border-t border-slate-100"></div>

                                                                        <!-- Select All -->
                                                                        <button type="button"
                                                                                class="mat-menu-select-all-btn-<%= topic.topic_id %> w-full text-left px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-indigo-600 flex items-center gap-2.5 transition-colors cursor-pointer"
                                                                                onclick="closeAllMaterialMenus(); selectAllTopicMaterials(<%= topic.topic_id %>)">
                                                                            <i class="fas fa-check-square text-slate-400 w-3.5 text-center"></i>
                                                                            <span>Select All</span>
                                                                        </button>

                                                                        <!-- Deselect All (Hidden until Select All is triggered) -->
                                                                        <button type="button"
                                                                                class="mat-menu-deselect-all-btn-<%= topic.topic_id %> hidden w-full text-left px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-indigo-600 flex items-center gap-2.5 transition-colors cursor-pointer"
                                                                                onclick="closeAllMaterialMenus(); deselectAllTopicMaterials(<%= topic.topic_id %>)">
                                                                            <i class="fas fa-square text-slate-400 w-3.5 text-center"></i>
                                                                            <span>Deselect All</span>
                                                                        </button>

                                                                        <div class="my-1 border-t border-slate-100"></div>

                                                                        <!-- Delete -->
                                                                        <button type="button" 
                                                                                class="w-full text-left px-3.5 py-2 text-xs font-medium text-rose-600 hover:bg-rose-50 flex items-center gap-2.5 transition-colors cursor-pointer"
                                                                                onclick="closeAllMaterialMenus(); confirmDelete('material', <%= mat.material_id %>, '<%= mat.title.replace(/'/g,"\\'") %>')">
                                                                            <i class="fas fa-trash text-rose-500 w-3.5 text-center"></i>
                                                                            <span>Delete</span>
                                                                        </button>
                                                                    </div>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% }); %>
                                                    <% } else { %>
                                                        <tr class="empty-state-row">
                                                            <td colspan="6" class="table-empty-cell">
                                                                <div class="standard-sub-empty-state">
                                                                    <div class="w-12 h-12 rounded-2xl bg-teal-50 text-teal-600 flex items-center justify-center text-xl mb-3 shadow-sm border border-teal-100">
                                                                        <i class="fas fa-folder-open"></i>
                                                                    </div>
                                                                    <h4 class="text-sm font-bold text-slate-700 mb-1">No learning materials added yet</h4>
                                                                    <p class="text-xs text-slate-400 max-w-sm mb-3">Upload lecture PDFs, video links, or presentation slides for this topic so students can access study resources.</p>
                                                                    <button type="button" class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg text-xs font-bold bg-teal-600 hover:bg-teal-700 text-white shadow-sm transition cursor-pointer" onclick="openMaterialModal(null, <%= topic.topic_id %>)">
                                                                        <i class="fas fa-plus text-xs"></i> Add Material
                                                                    </button>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                    <% } %>
                                                    </tbody>
                                                </table>
                                            </div>



                                        </div>
                                        <!-- /topic-panel -->
                                    </div>
                                    <!-- /topic-row -->
                                    <% }); %>

                                <% } else { %>
                                    <div class="empty-sub standard-sub-empty-state" style="min-height:180px;margin:12px;">
                                        <div class="w-10 h-10 rounded-xl bg-slate-100 text-slate-400 flex items-center justify-center text-base mb-2">
                                            <i class="fas fa-book-open"></i>
                                        </div>
                                        <p class="text-xs font-bold text-slate-600 mb-0.5">No topics in Quarter <%= quarter.quarter_number %> yet</p>
                                        <p class="text-[11px] text-slate-400">Click <strong>+</strong> on the quarter header to add a topic.</p>
                                    </div>
                                <% } %>

                            </div>
                            <!-- /quarter-body -->
                        </div>
                        <!-- /quarter-block -->

                        <% }); %>
                    </div>
                    <!-- /quartersContainer -->

                    <!-- Search No Results Empty State -->
                    <div id="cmSearchNoResults" class="standard-empty-state hidden">
                        <div class="w-14 h-14 rounded-2xl bg-amber-50 border border-amber-100 text-amber-500 flex items-center justify-center text-xl mb-3.5 shadow-sm">
                            <i class="fas fa-magnifying-glass"></i>
                        </div>
                        <h3 class="text-sm font-bold text-slate-700 mb-1">No matching content found</h3>
                        <p class="text-xs text-slate-400 max-w-md mx-auto mb-4">
                            No topics, materials, assessments, or assignments match "<span id="cmSearchQueryDisplay" class="font-semibold text-slate-600"></span>".
                        </p>
                        <button type="button" onclick="cmClearSearch()" class="inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs font-bold bg-indigo-50 hover:bg-indigo-100 text-indigo-600 transition border border-indigo-200 shadow-sm">
                            <i class="fas fa-arrow-rotate-left"></i> Clear Search Filter
                        </button>
                    </div>
                </div>
                <!-- END SECTION 3 · CONTENT MANAGEMENT -->


                </div> <!-- END tab-content -->

                <!-- ============================================================
                     SECTION 2 · ENROLLED STUDENTS ROSTER
                ============================================================ -->
                <div class="main-tab-content" id="tab-students">
                <div class="section-card mb-6">

                    <!-- Card header -->
                    <div class="section-header">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-400 to-indigo-500 flex items-center justify-center shadow-md shadow-indigo-200 flex-shrink-0">
                                <i class="fas fa-users text-white text-base"></i>
                            </div>
                            <div>
                                <h2 class="text-base font-bold text-slate-800">Enrolled Students</h2>
                                <p class="text-sm text-slate-400"><%= students.length %> student<%= students.length !== 1 ? 's' : '' %> in this class</p>
                            </div>
                        </div>

                        <!-- Controls row -->
                        <div class="flex flex-wrap items-center gap-2">
                            <!-- Search -->
                            <div class="relative">
                                <i class="fas fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
                                <input type="text" id="studentSearch" class="search-input" placeholder="Search students...">
                            </div>

                            <!-- Sort buttons -->
                            <button class="sort-btn active" id="sortName" onclick="sortTable('name')">
                                <i class="fas fa-arrow-down-a-z text-sm"></i> Name
                            </button>
                            <button class="sort-btn" id="sortScore" onclick="sortTable('score')">
                                <i class="fas fa-trophy text-sm"></i> Score
                            </button>
                            <button class="sort-btn" id="sortProgress" onclick="sortTable('progress')">
                                <i class="fas fa-chart-line text-sm"></i> Progress
                            </button>

                            <!-- Export -->
                            <button onclick="exportCSV()" class="sort-btn text-emerald-600 border-emerald-200 hover:bg-emerald-50 hover:border-emerald-400">
                                <i class="fas fa-file-csv text-sm"></i> Export
                            </button>
                        </div>
                    </div>

                    <!-- Summary stat strip -->
                    <div class="grid grid-cols-2 sm:grid-cols-5 gap-px bg-slate-100 border-b border-slate-100">
                        <div class="bg-white px-5 py-4 text-center">
                            <p class="text-xl font-black text-indigo-700"><%= students.length %></p>
                            <p class="text-sm text-slate-400 font-semibold mt-0.5">Total Students</p>
                        </div>
                        <div class="bg-white px-5 py-4 text-center">
                            <p class="text-xl font-black text-cyan-600" id="avgProgress">—</p>
                            <p class="text-sm text-slate-400 font-semibold mt-0.5">Avg. Progress</p>
                        </div>
                        <div class="bg-white px-5 py-4 text-center">
                            <p class="text-xl font-black text-amber-500" id="avgSoloScore">—</p>
                            <p class="text-sm text-slate-400 font-semibold mt-0.5">Avg. Solo Score</p>
                        </div>
                        <div class="bg-white px-5 py-4 text-center">
                            <p class="text-xl font-black text-purple-600" id="avgVersusScore">—</p>
                            <p class="text-sm text-slate-400 font-semibold mt-0.5">Avg. Versus Score</p>
                        </div>
                        <div class="bg-white px-5 py-4 text-center">
                            <p class="text-xl font-black text-emerald-600" id="completeCount">—</p>
                            <p class="text-sm text-slate-400 font-semibold mt-0.5">100% Complete</p>
                        </div>
                    </div>

                    <!-- Table (horizontal scroll on small screens) -->
                    <div class="overflow-x-auto flex-1 flex flex-col">
                        <table class="roster-table" id="rosterTable">
                            <thead>
                                <tr>
                                    <th class="text-left pl-5" style="width:40px">#</th>
                                    <th class="text-left" style="min-width:200px">Student</th>
                                    <th class="text-left" style="min-width:130px">LRN</th>
                                    <th class="text-left" style="min-width:130px">Grade / Section</th>
                                    <th class="text-center" style="min-width:110px">Solo Score</th>
                                    <th class="text-center" style="min-width:110px">Versus Wins</th>
                                    <th class="text-left" style="min-width:170px">Progress</th>
                                    <th class="text-left" style="min-width:130px">Last Accessed</th>
                                    <th class="text-center pr-5" style="min-width:90px">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="rosterBody">

                                <% students.forEach(function(student, index) { %>
                                <%
                                    var prog = parseInt(student.progress_percent) || 0;
                                    var totalSolo = parseInt(student.total_solo_score) || 0;
                                    var totalVersus = parseInt(student.total_versus_score) || 0;
                                    var totalWins = parseInt(student.total_versus_wins) || 0;
                                    var totalScore = parseInt(student.total_score) || (totalSolo + totalVersus);

                                    /* Progress colour thresholds */
                                    var progColor;
                                    if      (prog >= 80) { progColor = '#10b981'; }
                                    else if (prog >= 50) { progColor = '#06b6d4'; }
                                    else if (prog >= 25) { progColor = '#f59e0b'; }
                                    else                 { progColor = '#ef4444'; }

                                    /* Last accessed */
                                    var lastAccessedStr = 'Never';
                                    if (student.last_accessed) {
                                        var d = new Date(student.last_accessed);
                                        lastAccessedStr = d.toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' });
                                    }
                                %>
                                <tr class="fade-row"
                                    style="animation-delay: <%= index * 35 %>ms"
                                    data-name="<%= (student.first_name + ' ' + student.last_name).toLowerCase() %>"
                                    data-score="<%= totalScore %>"
                                    data-solo-score="<%= totalSolo %>"
                                    data-versus-score="<%= totalVersus %>"
                                    data-versus-wins="<%= totalWins %>"
                                    data-progress="<%= prog %>">

                                    <!-- Row number -->
                                    <td class="pl-5 text-slate-400 font-bold text-sm"><%= index + 1 %></td>

                                    <!-- Student name + avatar -->
                                    <td>
                                        <div class="flex items-center gap-3">
                                            <img src="/profile_uploads/<%= student.profile_pic || 'default_avatar.png' %>"
                                                 class="avatar-ring"
                                                 alt="<%= student.first_name %>"
                                                 onerror="this.src='/profile_uploads/default_avatar.png'">
                                            <div>
                                                <p class="font-bold text-slate-800 text-base leading-tight">
                                                    <%= student.last_name %>, <%= student.first_name %>
                                                    <% if (student.middle_name) { %><%= student.middle_name.charAt(0) %>.<% } %>
                                                </p>
                                                <p class="text-sm text-slate-400 mt-0.5">
                                                    Lvl <span class="font-bold text-indigo-500"><%= student.current_level || 1 %></span>
                                                </p>
                                            </div>
                                        </div>
                                    </td>

                                    <!-- LRN -->
                                    <td><span class="lrn-mono"><%= student.lrn_number || '—' %></span></td>

                                    <!-- Grade / Section -->
                                    <td>
                                        <div class="flex flex-col gap-0.5">
                                            <span class="text-sm font-bold text-slate-700"><%= student.grade_level || '—' %></span>
                                            <span class="text-sm text-slate-400"><%= student.section || '—' %></span>
                                        </div>
                                    </td>

                                    <!-- Total Solo Score -->
                                    <td class="text-center">
                                        <span class="exp-badge">
                                            <i class="fas fa-gamepad text-amber-600" style="font-size:9px"></i>
                                            <%= totalSolo.toLocaleString() %>
                                        </span>
                                    </td>

                                    <!-- Total Versus Wins -->
                                    <td class="text-center">
                                        <span class="wins-badge">
                                            <i class="fas fa-trophy text-purple-600" style="font-size:9px"></i>
                                            <%= totalWins.toLocaleString() %>
                                        </span>
                                    </td>

                                    <!-- Progress bar -->
                                    <td>
                                        <div class="flex items-center gap-2">
                                            <div class="prog-track flex-1">
                                                <div class="prog-fill" style="width:<%= prog %>%; background:<%= progColor %>;"></div>
                                            </div>
                                            <span class="text-sm font-black w-9 text-right flex-shrink-0"
                                                  style="color:<%= progColor %>">
                                                <%= prog %>%
                                            </span>
                                        </div>
                                    </td>

                                    <!-- Last accessed -->
                                    <td>
                                        <% if (student.last_accessed) { %>
                                        <span class="text-sm text-slate-500">
                                            <i class="far fa-clock text-slate-300 mr-1"></i><%= lastAccessedStr %>
                                        </span>
                                        <% } else { %>
                                        <span class="text-sm text-slate-300 italic">Never</span>
                                        <% } %>
                                    </td>

                                    <!-- Actions -->
                                    <td class="text-center pr-5">
                                        <div class="flex items-center justify-center gap-1">
                                            <button type="button"
                                               onclick="openStudentScoresModal('<%= student.user_id %>', '<%= subject.subject_id %>', '<%= classInfo.class_id %>')"
                                               title="View detailed scores & topic analytics"
                                               class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:bg-cyan-50 hover:text-cyan-600 transition">
                                                <i class="fas fa-chart-bar text-sm"></i>
                                            </button>
                                            <a href="/teacher/messages/new?to=<%= student.user_id %>"
                                               title="Send message"
                                               class="w-8 h-8 rounded-lg flex items-center justify-center text-slate-400 hover:bg-indigo-50 hover:text-indigo-600 transition">
                                                <i class="fas fa-envelope text-sm"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>

                                <!-- Empty search / initial state -->
                                <tr id="emptyRow" class="<%= students.length === 0 ? '' : 'hidden' %>">
                                    <td colspan="9" class="table-empty-cell">
                                        <div class="standard-empty-state" style="min-height: 360px;">
                                            <div class="w-14 h-14 rounded-2xl bg-slate-100 border border-slate-200 flex items-center justify-center mb-3.5 shadow-sm">
                                                <i class="fas fa-user-slash text-slate-400 text-xl"></i>
                                            </div>
                                            <h4 class="text-sm font-bold text-slate-700 mb-1">
                                                <%= students.length === 0 ? 'No students enrolled yet' : 'No students match your search' %>
                                            </h4>
                                            <p class="text-xs text-slate-400 max-w-sm mx-auto">
                                                <%= students.length === 0 ? 'Students assigned to this section will appear here with their live scores and progress.' : 'Try searching by a different student name or LRN.' %>
                                            </p>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Table footer -->
                    <div class="px-5 py-3 border-t border-slate-100 flex items-center justify-between mt-auto bg-slate-50/40">
                        <p class="text-sm text-slate-400" id="rowCount">
                            Showing <strong><%= students.length %></strong> students
                        </p>
                        <p class="text-sm text-slate-300">
                            Class: <span class="font-semibold text-slate-400"><%= classInfo.class_name %></span>
                        </p>
                    </div>
                </div>


                </div> <!-- END tab-students -->

                <!-- ============================================================
                    SECTION 4 · SCORES & PERFORMANCE ANALYTICS
                ============================================================ -->
                <div class="main-tab-content" id="tab-analytics">
                <div class="section-card mb-6" id="analyticsSection">
                
                    <!-- Card header -->
                    <div class="section-header" onclick="toggleAnalyticsSection()" style="cursor:pointer;user-select:none;">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-blue-400 to-indigo-600 flex items-center justify-center shadow-md shadow-indigo-200 flex-shrink-0">
                                <i class="fas fa-chart-bar text-white text-base"></i>
                            </div>
                            <div>
                                <h2 class="text-base font-bold text-slate-800">Scores &amp; Performance Analytics</h2>
                                <p class="text-sm text-slate-400">Scores · Breakdown · Matches · Leaderboard · Live Sessions · Flags</p>
                            </div>
                        </div>
                        <div class="flex items-center gap-3">
                            <i class="fas fa-chevron-down text-slate-400 text-sm chevron-icon open" id="chevron-analytics" style="transition:transform 0.2s;"></i>
                            <!-- Tab bar -->
                            <div class="analytics-tabs" id="analyticsTabs" onclick="event.stopPropagation()">
                                <button class="analytics-tab active" onclick="switchAnalyticsTab('scores',this)">
                                    <i class="fas fa-table-list text-sm"></i> Scores
                                </button>
                                <button class="analytics-tab" onclick="switchAnalyticsTab('breakdown',this)">
                                    <i class="fas fa-microscope text-sm"></i> Question Breakdown
                                </button>
                            </div>
                        </div>
                    </div>

                    <div id="analytics-body" class="flex-1 flex flex-col">
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 1 · SCORE SUMMARY TABLE
                    ══════════════════════════════════════════════════════ -->
                    <div class="analytics-panel active" id="apanel-scores">
                
                        <!-- Filter bar -->
                        <div class="score-filter-bar">
                            <div class="flex items-center gap-2">
                                <label class="text-sm font-semibold text-slate-500">Quarter</label>
                                <select class="filter-select" id="scoreFilterQuarter" onchange="onScoreQuarterOrTypeChange()">
                                    <option value="">All Quarters</option>
                                    <% quarters.forEach(function(q){ %>
                                    <option value="<%= q.quarter_id %>">Quarter <%= q.quarter_number %></option>
                                    <% }); %>
                                </select>
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-sm font-semibold text-slate-500">Type</label>
                                <select class="filter-select" id="scoreFilterType" onchange="onScoreQuarterOrTypeChange()">
                                    <option value="">All Types</option>
                                    <option value="Pre-Test">Pre-Test</option>
                                    <option value="Post-Test">Post-Test</option>
                                    <option value="Quiz">Quiz</option>
                                    <option value="Assignment">Assignment</option>
                                    <option value="Arcade">Arcade</option>
                                    <option value="Competitive">Competitive</option>
                                </select>
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-sm font-semibold text-slate-500">Assessment</label>
                                <select class="filter-select" id="scoreFilterAssessment" onchange="filterScoreTable()" style="max-width:240px;">
                                    <option value="">All Assessments</option>
                                </select>
                            </div>
                            <div class="flex items-center gap-1.5 ml-auto">
                                <div class="relative">
                                    <i class="fas fa-magnifying-glass absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-300 text-sm pointer-events-none"></i>
                                    <input type="text" id="scoreSearch" class="content-search" placeholder="Search student…" oninput="filterScoreTable()" onkeydown="if(event.key==='Escape') clearScoreSearch()">
                                </div>

                                <!-- Sort Button & Dropdown Menu -->
                                <div class="relative" id="scoreSortDropdownWrap">
                                    <button type="button" id="scoreSortBtn" onclick="toggleScoreSortDropdown(event)"
                                        class="p-2 border border-slate-200 rounded-lg text-slate-500 hover:text-indigo-600 hover:border-indigo-300 hover:bg-slate-50 transition bg-white shadow-sm flex items-center justify-center h-[32px] w-[34px]"
                                        title="Sort score records">
                                        <i class="fas fa-arrow-down-short-wide text-xs"></i>
                                    </button>

                                    <!-- Dropdown Menu -->
                                    <div id="scoreSortMenu" class="hidden absolute right-0 mt-1.5 w-44 bg-white rounded-xl shadow-lg border border-slate-100 py-1.5 z-30 animate-in fade-in zoom-in-95 duration-100">
                                        <div class="px-3 py-1.5 text-[10px] font-bold text-slate-400 uppercase tracking-wider border-b border-slate-100">
                                            Sort Records By
                                        </div>
                                        <button type="button" onclick="sortScoreTable('name')"
                                            class="w-full text-left px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 flex items-center justify-between transition group" id="scoreSortOpt-name">
                                            <span class="flex items-center gap-2">
                                                <i class="fas fa-arrow-down-a-z text-slate-400 group-hover:text-indigo-500 text-xs"></i>
                                                <span>Student Name</span>
                                            </span>
                                            <i class="fas fa-check text-xs text-indigo-600 hidden" id="scoreSortCheck-name"></i>
                                        </button>
                                        <button type="button" onclick="sortScoreTable('score')"
                                            class="w-full text-left px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 flex items-center justify-between transition group" id="scoreSortOpt-score">
                                            <span class="flex items-center gap-2">
                                                <i class="fas fa-trophy text-slate-400 group-hover:text-indigo-500 text-xs"></i>
                                                <span>Score</span>
                                            </span>
                                            <i class="fas fa-check text-xs text-indigo-600 hidden" id="scoreSortCheck-score"></i>
                                        </button>
                                        <button type="button" onclick="sortScoreTable('date')"
                                            class="w-full text-left px-3 py-2 text-xs font-semibold text-slate-700 hover:bg-indigo-50 hover:text-indigo-600 flex items-center justify-between transition group bg-indigo-50/70 text-indigo-600" id="scoreSortOpt-date">
                                            <span class="flex items-center gap-2">
                                                <i class="fas fa-calendar-days text-slate-400 group-hover:text-indigo-500 text-xs"></i>
                                                <span>Date Recorded</span>
                                            </span>
                                            <i class="fas fa-check text-xs text-indigo-600" id="scoreSortCheck-date"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                
                        <!-- Score table -->
                        <div class="overflow-x-auto flex-1 flex flex-col">
                            <table class="score-table" id="scoreTable">
                                <thead>
                                    <tr>
                                        <th style="min-width:160px">Student</th>
                                        <th style="min-width:160px">Assessment</th>
                                        <th>Type</th>
                                        <th>Quarter</th>
                                        <th style="min-width:130px">Score</th>
                                        <th style="min-width:90px">EXP Gained</th>
                                        <th>Date</th>
                                        <th style="text-align:right;min-width:110px">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="scoreTableBody">
                                <% if (typeof scores !== 'undefined' && scores.length > 0) { %>
                                    <% scores.forEach(function(row, si) { %>
                                    <%
                                        var pct = Math.round((row.score_obtained / row.total_items) * 100);
                                        var barColor = pct >= 75 ? '#10b981' : pct >= 50 ? '#06b6d4' : pct >= 25 ? '#f59e0b' : '#ef4444';
                                        var typeClass = row.assessment_type === 'Pre-Test' ? 'atype-pre' :
                                                        row.assessment_type === 'Post-Test' ? 'atype-post' :
                                                        row.assessment_type === 'Quiz' ? 'atype-quiz' :
                                                        row.assessment_type === 'Assignment' ? 'atype-assign' :
                                                        row.assessment_type === 'Arcade' ? 'atype-arcade' : 'atype-comp';
                                        var dateStr = row.date_recorded ? new Date(row.date_recorded).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—';
                                    %>
                                    <tr data-student="<%= (row.first_name+' '+row.last_name).toLowerCase() %>"
                                        data-first-name="<%= (row.first_name || '').toLowerCase() %>"
                                        data-last-name="<%= (row.last_name || '').toLowerCase() %>"
                                        data-type="<%= row.assessment_type || 'Arcade' %>"
                                        data-quarter="<%= row.quarter_id || '' %>"
                                        data-assessment-id="<%= row.assessment_id || '' %>"
                                        data-assessment-name="<%= (row.assessment_name || 'arcade free play').toLowerCase() %>"
                                        data-score="<%= row.score_obtained %>"
                                        data-pct="<%= pct %>"
                                        data-date="<%= row.date_recorded ? new Date(row.date_recorded).getTime() : 0 %>"
                                        style="<%= si >= 10 ? 'display: none;' : '' %>"
                                        class="cursor-pointer hover:bg-indigo-50/60 transition group"
                                        onclick="openAssessmentDiagnosticModal('<%= row.score_id %>', <%= row.user_id %>, <%= row.assessment_id || 'null' %>, <%= classInfo.class_id %>)">
                                        <td>
                                            <div class="flex items-center gap-2">
                                                <img src="/profile_uploads/<%= row.profile_pic || 'default_avatar.png' %>"
                                                    style="width:28px;height:28px;border-radius:7px;object-fit:cover;border:1.5px solid #e0f2fe;flex-shrink:0"
                                                onerror="this.src='/profile_uploads/default_avatar.png'">
                                                <span class="font-semibold text-slate-700 text-sm"><%= row.last_name %>, <%= row.first_name %></span>
                                            </div>
                                        </td>
                                        <td class="font-semibold text-slate-700 text-sm max-w-[160px] truncate" title="<%= row.assessment_name || 'Arcade Free Play' %>"><%= row.assessment_name || 'Arcade Free Play' %></td>
                                        <td><span class="badge-type <%= typeClass %>"><%= row.assessment_type || 'Arcade' %></span></td>
                                        <td class="text-sm text-slate-500"><%= row.quarter_number ? ('Q' + row.quarter_number) : '—' %></td>
                                        <td>
                                            <div class="score-bar-wrap">
                                                <div class="score-bar-track">
                                                    <div class="score-bar-fill" style="width:<%= pct %>%;background:<%= barColor %>"></div>
                                                </div>
                                                <span class="text-sm font-bold flex-shrink-0" style="color:<%= barColor %>"><%= row.score_obtained %>/<%= row.total_items %></span>
                                            </div>
                                        </td>
                                        <td>
                                            <span class="exp-badge">
                                                <i class="fas fa-star text-amber-500" style="font-size:9px"></i>
                                                +<%= row.exp_gained %>
                                            </span>
                                        </td>
                                        <td class="text-sm text-slate-400"><%= dateStr %></td>
                                        <td class="text-right">
                                            <button type="button"
                                                onclick="event.stopPropagation(); openAssessmentDiagnosticModal('<%= row.score_id %>', <%= row.user_id %>, <%= row.assessment_id || 'null' %>, <%= classInfo.class_id %>)"
                                                class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-bold text-indigo-600 bg-indigo-50 hover:bg-indigo-600 hover:text-white transition shadow-2xs border border-indigo-100 group-hover:border-indigo-300">
                                                <i class="fas fa-chart-pie text-[11px]"></i> Diagnostic
                                            </button>
                                        </td>
                                    </tr>
                                    <% }); %>
                                <% } %>
                                    <!-- Dynamic Empty State for Filter / Search / No Data -->
                                    <tr id="scoreNoDataRow" class="<%= (typeof scores !== 'undefined' && scores.length > 0) ? 'hidden' : '' %>">
                                        <td colspan="8" class="table-empty-cell">
                                            <div class="standard-empty-state" style="min-height: 380px;">
                                                <div id="scoreEmptyIcon" class="w-14 h-14 rounded-2xl bg-slate-50 border border-slate-200 text-slate-400 flex items-center justify-center text-xl mb-3 shadow-sm">
                                                    <i class="fas fa-chart-line"></i>
                                                </div>
                                                <h4 id="scoreEmptyTitle" class="text-sm font-bold text-slate-700 mb-1">
                                                    <%= (typeof scores !== 'undefined' && scores.length > 0) ? 'No matching records' : 'No score records yet' %>
                                                </h4>
                                                <p id="scoreEmptyDesc" class="text-xs text-slate-400 max-w-sm mb-4">
                                                    <%= (typeof scores !== 'undefined' && scores.length > 0) ? 'No records match the current filter or search criteria.' : 'No assessment submissions or scores recorded for this class yet.' %>
                                                </p>
                                                <button type="button" id="scoreEmptyResetBtn" onclick="resetScoreFilters()" class="hidden inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-bold bg-indigo-50 hover:bg-indigo-100 text-indigo-600 transition border border-indigo-200 shadow-sm">
                                                    <i class="fas fa-arrow-rotate-left text-xs"></i> Reset Filters
                                                </button>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>
                        <!-- Pagination & Summary Footer -->
                        <div id="scorePaginationWrap" class="px-4 py-3 border-t border-slate-100 flex flex-col sm:flex-row items-center justify-between gap-3 text-xs bg-slate-50/50 mt-auto">
                            <!-- Left: Record counts and items-per-page selector -->
                            <div class="flex items-center gap-3 flex-wrap">
                                <p class="text-xs text-slate-500 font-medium" id="scoreCount">
                                    <% if (typeof scores !== 'undefined' && scores.length > 0) { %>Showing <strong>1–<%= Math.min(scores.length, 10) %></strong> of <strong><%= scores.length %></strong> records<% } else { %>No score records<% } %>
                                </p>
                                <div class="flex items-center gap-1.5 text-slate-500 font-medium">
                                    <span class="text-[11px] text-slate-400">Show</span>
                                    <select id="scorePageSize" onchange="changeScorePageSize(this.value)" class="text-xs font-semibold bg-white border border-slate-200 rounded-lg px-2 py-1 text-slate-700 shadow-2xs hover:border-slate-300 focus:outline-none focus:ring-1 focus:ring-indigo-500 cursor-pointer">
                                        <option value="10" selected>10</option>
                                        <option value="25">25</option>
                                        <option value="50">50</option>
                                        <option value="100">100</option>
                                    </select>
                                    <span class="text-[11px] text-slate-400">per page</span>
                                </div>
                            </div>

                            <!-- Right: Navigation controls -->
                            <div class="flex items-center gap-1.5" id="scorePaginationNav">
                                <button id="btnPrevScorePage" type="button" onclick="changeScorePage(-1)"
                                    class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-indigo-600 disabled:opacity-40 disabled:cursor-not-allowed transition font-bold flex items-center gap-1 shadow-2xs">
                                    <i class="fas fa-chevron-left text-[10px]"></i> <span>Prev</span>
                                </button>
                                <div id="scorePageNumbers" class="flex items-center gap-1"></div>
                                <button id="btnNextScorePage" type="button" onclick="changeScorePage(1)"
                                    class="px-2.5 py-1.5 rounded-lg border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-indigo-600 disabled:opacity-40 disabled:cursor-not-allowed transition font-bold flex items-center gap-1 shadow-2xs">
                                    <span>Next</span> <i class="fas fa-chevron-right text-[10px]"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 2 · PER-QUESTION RESPONSE BREAKDOWN
                    ══════════════════════════════════════════════════════ -->
                    <div class="analytics-panel" id="apanel-breakdown">
                        <div class="p-5 flex-1 flex flex-col">
                            <label class="form-label">Select Assessment to Analyse</label>
                            <select class="breakdown-assessment-select" id="breakdownSelect" onchange="renderBreakdown(this.value)">
                                <option value="">— Choose an assessment —</option>
                                <% quarters.forEach(function(q){ %>
                                    <% (q.topics || []).forEach(function(t){ %>
                                        <% (t.assessments || []).forEach(function(a){ %>
                                        <option value="<%= a.assessment_id %>" data-name="<%= a.assessment_name %>">
                                            Q<%= q.quarter_number %> · <%= t.topic_name %> · <%= a.assessment_name %>
                                        </option>
                                        <% }); %>
                                    <% }); %>
                                <% }); %>
                            </select>
                
                            <div id="breakdownContainer" class="flex-1 flex flex-col">
                                <div class="standard-empty-state" style="margin:0;min-height:410px;">
                                    <div class="w-14 h-14 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-500 flex items-center justify-center text-xl mb-3.5 shadow-sm">
                                        <i class="fas fa-microscope"></i>
                                    </div>
                                    <h4 class="text-sm font-bold text-slate-700 mb-1">No assessment selected</h4>
                                    <p class="text-xs text-slate-400 max-w-sm mx-auto">Select an assessment from the dropdown above to inspect its per-question accuracy, difficulty, and average response time.</p>
                                </div>
                            </div>
                        </div>
                    </div>

                    </div><!-- end analytics-body -->
                
