                                    <div class="cal-dow">Sun</div><div class="cal-dow">Mon</div>
                                    <div class="cal-dow">Tue</div><div class="cal-dow">Wed</div>
                                    <div class="cal-dow">Thu</div><div class="cal-dow">Fri</div>
                                    <div class="cal-dow">Sat</div>
                                </div>
                                <div class="cal-day-grid" id="calDayGrid"></div>
                            </div>
                
                            <!-- Event list for selected date -->
                            <div class="cal-event-list-panel">
                                <div class="cal-event-list-header">
                                    <p class="text-sm font-bold text-slate-600" id="calEventListDate">All Events This Month</p>
                                    <span class="text-sm text-slate-400" id="calEventListCount"></span>
                                </div>
                                <div id="calEventList">
                                    <p class="cal-empty"><i class="fas fa-calendar-xmark"></i>No events this month.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                
                
                    <!-- ══════════════════════════════════════════════════════
                        TAB 2 · UPCOMING DEADLINES TIMELINE
                    ══════════════════════════════════════════════════════ -->
                    <div class="cal-panel" id="cpanel-timeline">
                
                        <div class="cal-filter-bar">
                            <div class="flex items-center gap-2">
                                <label class="text-sm font-semibold text-slate-500">Show next</label>
                                <select class="filter-select" id="timelineDays" onchange="renderTimeline()">
                                    <option value="7">7 days</option>
                                    <option value="14">14 days</option>
                                    <option value="30" selected>30 days</option>
                                    <option value="60">60 days</option>
                                    <option value="0">All upcoming</option>
                                </select>
                            </div>
                            <div class="flex items-center gap-2">
                                <label class="text-sm font-semibold text-slate-500">Type</label>
                                <select class="filter-select" id="timelineTypeFilter" onchange="renderTimeline()">
                                    <option value="">All Types</option>
                                    <option value="Material">Material</option>
                                    <option value="Deadline">Deadline</option>
                                    <option value="Exam">Exam</option>
                                    <option value="Holiday">Holiday</option>
                                    <option value="Assessment">Assessment Due</option>
                                </select>
                            </div>
                            <p class="text-sm text-slate-400 ml-auto">
                                <i class="fas fa-circle-info mr-1"></i>
                                Combines calendar events + assessment due dates
                            </p>
                        </div>
                
                        <div class="timeline-wrap" id="timelineContainer">
                            <!-- Rendered by JS -->
                            <div class="standard-empty-state" style="margin:0;">
                                <div class="w-14 h-14 rounded-2xl bg-violet-50 text-violet-500 flex items-center justify-center text-2xl mx-auto mb-3.5 shadow-sm border border-violet-100">
                                    <i class="fas fa-hourglass-start"></i>
                                </div>
                                <h4 class="text-sm font-bold text-slate-700 mb-1">Loading timeline…</h4>
                                <p class="text-xs text-slate-400 max-w-sm mx-auto">Gathering upcoming calendar events and assessment deadlines.</p>
                            </div>
                        </div>
                    </div>
                
                </div>
                <!-- END SECTION 6 · SCHEDULING & CALENDAR -->
                </div> <!-- END tab-calendar -->

                <!-- ============================================================
                    SECTION 3 · CONTENT MANAGEMENT
                ============================================================ -->
                <div class="main-tab-content" id="tab-content">

                <div class="section-card mb-6" id="contentMgmtSection">

                    <!-- Card header -->
                    <div class="section-header">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-violet-400 to-indigo-600 flex items-center justify-center shadow-md shadow-indigo-200 flex-shrink-0">
                                <i class="fas fa-layer-group text-white text-base"></i>
                            </div>
                            <div>
                                <h2 class="text-base font-bold text-slate-800">Content Management</h2>
                                <p class="text-sm text-slate-400">Quarters · Topics · Materials · Assessments · Assignments · Announcements · Forums</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-3">
                            <div class="relative">
                                <i class="fas fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-sm pointer-events-none"></i>
                                <input type="text" id="cmSearch" class="content-search" style="width:340px;max-width:100%;padding-left:32px" placeholder="Search topics, materials, assessments, assignments..."
                                    oninput="cmGeneralSearch(this.value)" onkeydown="if(event.key==='Escape') cmClearSearch()">
                            </div>
                            <span class="text-sm text-slate-400 font-semibold hidden lg:inline-flex items-center">
                                <i class="fas fa-circle-info text-slate-300 mr-1.5"></i>
                                Locking a quarter locks everything inside it
                            </span>
                        </div>
                    </div>

                    <!-- Quarters accordion -->
                    <div id="quartersContainer" class="divide-y divide-slate-100 p-4 space-y-3 flex-1">

                        <% quarters.forEach(function(quarter, qi) { %>
                        <%
                            var qLocked = quarter.is_locked == 1;
                            var isFirstQ = qi === 0;
                        %>

                        <div class="quarter-block" id="quarter-block-<%= quarter.quarter_id %>">

                            <!-- Quarter header row -->
                            <div class="quarter-header" onclick="toggleQuarter(<%= quarter.quarter_id %>)">

                                <div class="flex items-center gap-3 flex-1 min-w-0">
                                    <!-- Chevron -->
                                    <i class="fas fa-chevron-right text-slate-400 text-sm chevron-icon <%= isFirstQ ? 'open' : '' %>"
                                    id="chevron-q-<%= quarter.quarter_id %>"></i>

                                    <!-- Lock button -->
                                    <button class="lock-btn <%= qLocked ? 'locked' : 'unlocked' %>"
                                            id="qlock-<%= quarter.quarter_id %>"
                                            title="<%= qLocked ? 'Unlock quarter' : 'Lock quarter' %>"
                                            onclick="event.stopPropagation(); toggleQuarterLock(<%= quarter.quarter_id %>, <%= qLocked ? 1 : 0 %>)">
                                        <i class="fas fa-<%= qLocked ? 'lock' : 'lock-open' %> text-sm"></i>
                                    </button>

                                    <!-- Quarter label -->
                                    <div>
                                        <p class="font-bold text-slate-700 text-base">Quarter <%= quarter.quarter_number %></p>
                                        <p class="text-sm text-slate-400">
                                            <%= quarter.topics ? quarter.topics.length : 0 %> topic<%= (quarter.topics && quarter.topics.length !== 1) ? 's' : '' %>
                                            <% if (qLocked) { %><span class="ml-2 text-orange-500 font-semibold"><i class="fas fa-lock text-sm"></i> Locked</span><% } %>
                                        </p>
                                    </div>
                                </div>

                                <!-- Quarter actions -->
                                <div class="flex items-center gap-2" onclick="event.stopPropagation()">
                                    <button class="icon-btn" title="Add topic to this quarter"
                                            onclick="openTopicModal(null, <%= quarter.quarter_id %>)">
                                        <i class="fas fa-plus text-sm"></i>
                                    </button>
                                </div>
                            </div>

                            <!-- Quarter body (topics) -->
                            <div class="quarter-body" id="quarter-body-<%= quarter.quarter_id %>" style="display:<%= isFirstQ ? 'block' : 'none' %>">



                                <% if (quarter.topics && quarter.topics.length > 0) { %>
                                    <% quarter.topics.forEach(function(topic, ti) { %>
                                    <%
                                        var tLocked = qLocked || (topic.is_locked == 1);
                                        var isFirstT = isFirstQ && ti === 0;
                                    %>

                                    <div class="topic-row" id="topic-row-<%= topic.topic_id %>"
                                        data-topic-id="<%= topic.topic_id %>"
                                        data-is-locked="<%= (topic.is_locked == 1) ? '1' : '0' %>"
                                        data-auto-unlock-at="<%= topic.auto_unlock_at || '' %>"
                                        data-auto-lock-at="<%= topic.auto_lock_at || '' %>"
                                        data-topic-name="<%= topic.topic_name.toLowerCase() %>"
                                        data-topic-desc="<%= (topic.topic_description || '').toLowerCase() %>"
                                        data-quarter="<%= quarter.quarter_id %>">

                                        <!-- Topic main row -->
                                        <div class="topic-inner">
                                            <div class="flex items-center gap-3 flex-1 min-w-0">

                                                <!-- Expand chevron -->
                                                <button class="icon-btn" onclick="toggleTopicPanel(<%= topic.topic_id %>)">
                                                    <i class="fas fa-chevron-right text-sm chevron-icon <%= isFirstT ? 'open' : '' %>" id="chevron-t-<%= topic.topic_id %>"></i>
                                                </button>

                                                <!-- Topic lock -->
                                                <button class="lock-btn <%= tLocked ? 'locked' : 'unlocked' %>"
                                                        id="tlock-<%= topic.topic_id %>"
                                                        title="<%= tLocked ? 'Unlock topic' : 'Lock topic' %>"
                                                        <%= qLocked ? 'disabled style="opacity:0.4;cursor:not-allowed"' : '' %>
                                                        onclick="toggleTopicLock(<%= topic.topic_id %>, <%= (topic.is_locked == 1) ? 1 : 0 %>)">
                                                    <i class="fas fa-<%= tLocked ? 'lock' : 'lock-open' %> text-sm"></i>
                                                </button>

                                                <!-- Topic name -->
                                                <div class="min-w-0">
                                                    <div class="flex items-center gap-2 flex-wrap">
                                                        <p class="font-semibold text-slate-700 text-base truncate"><%= topic.topic_name %></p>
                                                        <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-teal-50 text-teal-700 border border-teal-200">
                                                            <i class="fas fa-folder-open text-[10px] mr-0.5"></i><%= (topic.materials || []).length %> <%= (topic.materials || []).length === 1 ? 'Material' : 'Materials' %>
                                                        </span>
                                                        <% if (topic.auto_unlock_at) { %>
                                                            <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200" title="Scheduled Auto-Unlock">
                                                                <i class="fas fa-clock text-[10px] mr-0.5"></i>Unlocks: <%= new Date(topic.auto_unlock_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                                            </span>
                                                        <% } %>
                                                        <% if (topic.auto_lock_at) { %>
                                                            <span class="text-[11px] font-bold px-2 py-0.5 rounded-full bg-rose-50 text-rose-700 border border-rose-200" title="Scheduled Auto-Lock">
                                                                <i class="fas fa-hourglass-end text-[10px] mr-0.5"></i>Locks: <%= new Date(topic.auto_lock_at).toLocaleString([], { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                                            </span>
                                                        <% } %>
                                                    </div>
                                                    <p class="text-sm text-slate-400 truncate mt-1">
                                                        <%= topic.topic_description || '' %>
                                                        <% if (tLocked) { %><span class="ml-2 text-orange-500 font-semibold"><i class="fas fa-lock text-sm"></i> Locked</span><% } %>
                                                    </p>
                                                </div>
                                            </div>

                                            <!-- Topic actions -->
                                            <div class="flex items-center gap-1 flex-shrink-0">
                                                <script type="application/json" id="topic-data-<%= topic.topic_id %>"><%- JSON.stringify({
                                                    topic_id: topic.topic_id,
                                                    quarter_id: quarter.quarter_id,
                                                    topic_name: topic.topic_name || '',
                                                    topic_description: topic.topic_description || '',
                                                    topic_objectives: topic.topic_objectives || '',
                                                    video_url: topic.video_url || '',
                                                    is_locked: (topic.is_locked == 1) ? 1 : 0,
                                                    auto_unlock_at: topic.auto_unlock_at || null,
                                                    auto_lock_at: topic.auto_lock_at || null,
                                                    materials: (topic.materials || []).map(m => ({
                                                        material_id: m.material_id,
                                                        topic_id: m.topic_id,
                                                        title: m.title,
                                                        material_type: m.material_type,
                                                        file_path_or_url: m.file_path_or_url,
                                                        is_locked: (m.is_locked == 1) ? 1 : 0
                                                    }))
                                                }) %></script>
                                                <button class="icon-btn" title="Edit topic"
                                                        onclick="editTopicById(<%= topic.topic_id %>)">
                                                    <i class="fas fa-pen text-sm"></i>
                                                </button>
                                                <button class="icon-btn danger" title="Delete topic"
                                                        onclick="deleteTopicById(<%= topic.topic_id %>)">
                                                    <i class="fas fa-trash text-sm"></i>
                                                </button>
                                            </div>
                                        </div>

                                        <!-- ---- Topic expandable panel ---- -->
                                        <div class="topic-panel <%= isFirstT ? 'open' : '' %>" id="panel-<%= topic.topic_id %>">

                                            <!-- Tab bar -->
                                            <div class="panel-tabs">
                                                <button class="panel-tab active"
                                                        onclick="switchTab(<%= topic.topic_id %>, 'assessments', this)">
                                                    <i class="fas fa-clipboard-list text-sm"></i> Assessments
                                                </button>
                                                <button class="panel-tab"
                                                        onclick="switchTab(<%= topic.topic_id %>, 'assignments', this)">
                                                    <i class="fas fa-file-signature text-sm"></i> Assignments
                                                </button>
                                                <button class="panel-tab"
                                                        onclick="switchTab(<%= topic.topic_id %>, 'materials', this)">
                                                    <i class="fas fa-folder-open text-sm"></i> Materials
                                                </button>

                                            </div>

                                            <!-- ====== TAB: ASSESSMENTS ====== -->
                                            <div class="tab-content" id="tab-<%= topic.topic_id %>-assessments">
                                                <div class="flex items-center justify-between mb-2 flex-wrap gap-2">
                                                    <!-- Batch operations toolbar -->
                                                    <div id="asmt-batch-bar-<%= topic.topic_id %>" class="hidden items-center gap-2 bg-indigo-50 border border-indigo-200 px-3 py-1.5 rounded-xl shadow-xs transition-all">
                                                        <div class="flex items-center gap-1.5 text-xs font-semibold text-indigo-900">
                                                            <span class="w-2 h-2 rounded-full bg-indigo-600 animate-pulse"></span>
                                                            <span id="asmt-selected-count-<%= topic.topic_id %>">0</span> selected
                                                        </div>
                                                        <div class="h-4 w-px bg-indigo-200 mx-1"></div>
                                                        <button type="button" 
                                                                class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium rounded-lg bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-indigo-600 transition shadow-2xs cursor-pointer" 
                                                                onclick="batchToggleAssessmentLock(<%= topic.topic_id %>, 0)" 
                                                                title="Lock selected assessments">
                                                            <i class="fas fa-lock text-xs text-slate-500"></i> Lock
                                                        </button>
                                                        <button type="button" 
                                                                class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium rounded-lg bg-white border border-slate-200 text-slate-700 hover:bg-slate-50 hover:text-indigo-600 transition shadow-2xs cursor-pointer" 
                                                                onclick="batchToggleAssessmentLock(<%= topic.topic_id %>, 1)" 
                                                                title="Unlock selected assessments">
                                                            <i class="fas fa-lock-open text-xs text-slate-500"></i> Unlock
                                                        </button>
                                                        <button type="button" 
                                                                class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium rounded-lg bg-white border border-rose-200 text-rose-600 hover:bg-rose-50 transition shadow-2xs cursor-pointer" 
                                                                onclick="batchDeleteAssessments(<%= topic.topic_id %>)" 
                                                                title="Delete selected assessments">
                                                            <i class="fas fa-trash text-xs"></i> Delete
                                                        </button>
                                                        <button type="button" 
                                                                class="text-xs text-slate-400 hover:text-slate-600 px-1.5 py-1 ml-1 cursor-pointer" 
                                                                onclick="deselectAllTopicAssessments(<%= topic.topic_id %>)" 
                                                                title="Clear selection">
                                                            <i class="fas fa-times text-xs"></i> Clear
                                                        </button>
                                                    </div>
                                                    <div class="flex items-center justify-end ml-auto">
                                                        <button class="add-row-btn" onclick="openAssessmentModal(null, <%= topic.topic_id %>, <%= quarter.quarter_id %>)">
                                                            <i class="fas fa-plus text-sm"></i> Add Assessment
                                                        </button>
                                                    </div>
                                                </div>
                                                <table class="sub-table" id="asmt-table-<%= topic.topic_id %>">
                                                    <thead>
                                                        <tr>
                                                            <th class="asmt-col-cb-<%= topic.topic_id %> hidden" style="width:36px; text-align:center;">
                                                                <input type="checkbox" 
                                                                       class="asmt-master-cb w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" 
                                                                       id="asmt-master-cb-<%= topic.topic_id %>"
                                                                       data-topic-id="<%= topic.topic_id %>" 
                                                                       onchange="toggleAllTopicAssessments(<%= topic.topic_id %>, this.checked)" 
                                                                       title="Select / Deselect All">
                                                            </th>
                                                            <th style="width:30px">#</th>
                                                            <th>Name</th>
                                                            <th>Type</th>
                                                            <th>Items</th>
                                                            <th>Schedule Window</th>
                                                            <th>Unlocked</th>
                                                            <th style="width:60px; text-align:center;">Actions</th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                    <% if (topic.assessments && topic.assessments.length > 0) { %>
                                                        <% topic.assessments.forEach(function(asmt, ai) { %>
                                                        <%
                                                            var aTypeClass = asmt.assessment_type === 'Pre-Test' ? 'atype-pre' :
                                                                            asmt.assessment_type === 'Post-Test' ? 'atype-post' :
                                                                            asmt.assessment_type === 'Quiz' ? 'atype-quiz' : 'atype-comp';
                                                            var startStr = asmt.start_date ? new Date(asmt.start_date).toLocaleDateString('en-PH',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : 'Open';
                                                            var dueStr = asmt.due_date ? new Date(asmt.due_date).toLocaleDateString('en-PH',{month:'short',day:'numeric',hour:'2-digit',minute:'2-digit'}) : 'No Deadline';
                                                        %>
                                                        <tr data-search="<%= asmt.assessment_name.toLowerCase() %>" id="asmt-row-<%= asmt.assessment_id %>">
                                                            <td class="asmt-col-cb-<%= topic.topic_id %> hidden" style="text-align:center;">
                                                                <input type="checkbox" 
                                                                       class="asmt-row-cb asmt-row-cb-<%= topic.topic_id %> w-4 h-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500 cursor-pointer" 
                                                                       id="asmt-cb-<%= asmt.assessment_id %>"
                                                                       data-topic-id="<%= topic.topic_id %>" 
                                                                       data-assessment-id="<%= asmt.assessment_id %>"
                                                                       onchange="onAssessmentRowCheckboxChange(<%= topic.topic_id %>)">
                                                            </td>
                                                            <td class="text-slate-400 font-bold"><%= ai + 1 %></td>
                                                            <td class="font-semibold text-slate-700">
                                                                <div class="flex items-center gap-1.5 flex-wrap">
                                                                    <span><%= asmt.assessment_name %></span>
                                                                    <% if (asmt.competitive_enabled == 1 || asmt.assessment_type === 'Competitive') { %>
                                                                        <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[10px] font-black bg-amber-100 text-amber-800" title="2-Player Multiplayer Arena Enabled">⚔️ Arena</span>
                                                                    <% } %>
                                                                </div>
                                                            </td>
                                                            <td><span class="badge-type <%= aTypeClass %>"><%= asmt.assessment_type %></span></td>
                                                            <td class="text-center"><%= asmt.total_items %></td>
                                                            <td class="text-slate-500 text-xs">
                                                                <div><span class="text-slate-400 text-[10px] font-bold">FROM:</span> <%= startStr %></div>
                                                                <div><span class="text-slate-400 text-[10px] font-bold">DUE:</span> <%= dueStr %></div>
                                                            </td>
                                                            <td>
                                                                <button class="lock-btn <%= asmt.is_unlocked ? 'unlocked' : 'locked' %>"
                                                                        id="asmt-lock-btn-<%= asmt.assessment_id %>"
                                                                        style="width:26px;height:26px"
                                                                        title="<%= asmt.is_unlocked ? 'Lock assessment' : 'Unlock assessment' %>"
                                                                        onclick="toggleAssessmentLock(<%= asmt.assessment_id %>, <%= asmt.is_unlocked ? 1 : 0 %>, this)">
                                                                    <i class="fas fa-<%= asmt.is_unlocked ? 'lock-open' : 'lock' %> text-sm"></i>
                                                                </button>
                                                            </td>
                                                            <td style="text-align:center;">
                                                                <div class="relative inline-block text-left asmt-menu-container">
                                                                    <button type="button" 
                                                                            class="icon-btn asmt-menu-btn" 
                                                                            title="Actions"
                                                                            onclick="toggleAssessmentDropdownMenu(event, <%= asmt.assessment_id %>)"
                                                                            id="asmt-menu-trigger-<%= asmt.assessment_id %>">
                                                                        <i class="fas fa-ellipsis-vertical text-xs text-slate-500"></i>
                                                                    </button>
                                                                    <div id="asmt-dropdown-<%= asmt.assessment_id %>" 
                                                                         class="asmt-dropdown-menu hidden absolute right-0 mt-1 w-52 rounded-xl shadow-xl bg-white border border-slate-200 z-50 py-1.5 focus:outline-none"
                                                                         style="box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.12), 0 8px 10px -6px rgba(0, 0, 0, 0.08);">
                                                                        <!-- Edit -->
                                                                        <button type="button" 
                                                                                class="w-full text-left px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-indigo-600 flex items-center gap-2.5 transition-colors cursor-pointer"
                                                                                onclick="closeAllAssessmentMenus(); openAssessmentModal(<%= asmt.assessment_id %>, <%= topic.topic_id %>, <%= quarter.quarter_id %>)">
                                                                            <i class="fas fa-pen text-slate-400 w-3.5 text-center"></i>
                                                                            <span>Edit</span>
                                                                        </button>

                                                                        <!-- Full Question Bank Builder -->
                                                                        <a href="/teacher/question-bank?openAuthor=true" target="_blank"
                                                                           class="w-full text-left px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-indigo-600 flex items-center gap-2.5 transition-colors cursor-pointer"
                                                                           onclick="closeAllAssessmentMenus();">
                                                                            <i class="fas fa-list-check text-indigo-500 w-3.5 text-center"></i>
                                                                            <span>Full Question Bank Builder</span>
                                                                        </a>

                                                                        <!-- Lock / Unlock -->
                                                                        <button type="button" 
                                                                                id="asmt-menu-lock-<%= asmt.assessment_id %>"
                                                                                data-topic-id="<%= topic.topic_id %>"
                                                                                data-unlocked="<%= asmt.is_unlocked ? 1 : 0 %>"
                                                                                class="w-full text-left px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-indigo-600 flex items-center gap-2.5 transition-colors cursor-pointer"
                                                                                onclick="closeAllAssessmentMenus(); toggleAssessmentLockFromMenu(<%= asmt.assessment_id %>, <%= asmt.is_unlocked ? 1 : 0 %>, <%= topic.topic_id %>)">
                                                                            <i class="fas fa-<%= asmt.is_unlocked ? 'lock' : 'lock-open' %> text-slate-400 w-3.5 text-center"></i>
                                                                            <span><%= asmt.is_unlocked ? 'Lock' : 'Unlock' %></span>
                                                                        </button>

                                                                        <div class="my-1 border-t border-slate-100"></div>

                                                                        <!-- Select All -->
                                                                        <button type="button"
                                                                                class="asmt-menu-select-all-btn-<%= topic.topic_id %> w-full text-left px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-indigo-600 flex items-center gap-2.5 transition-colors cursor-pointer"
                                                                                onclick="closeAllAssessmentMenus(); selectAllTopicAssessments(<%= topic.topic_id %>)">
                                                                            <i class="fas fa-check-square text-slate-400 w-3.5 text-center"></i>
                                                                            <span>Select All</span>
                                                                        </button>

                                                                        <!-- Deselect All (Hidden until Select All is triggered) -->
                                                                        <button type="button"
                                                                                class="asmt-menu-deselect-all-btn-<%= topic.topic_id %> hidden w-full text-left px-3.5 py-2 text-xs font-medium text-slate-700 hover:bg-slate-50 hover:text-indigo-600 flex items-center gap-2.5 transition-colors cursor-pointer"
