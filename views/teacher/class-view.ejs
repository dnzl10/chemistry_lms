async function batchToggleAssessmentLock(topicId, unlockVal) {
    const checkedBoxes = Array.from(document.querySelectorAll('.asmt-row-cb-' + topicId + ':checked'));
    if (!checkedBoxes.length) {
        cmToast('No assessments selected.', 'warning');
        return;
    }
    const ids = checkedBoxes.map(cb => cb.getAttribute('data-assessment-id'));
    const actionWord = unlockVal ? 'unlocked' : 'locked';
    cmToast(`Updating ${ids.length} assessment(s)...`, 'info');

    try {
        const results = await Promise.all(ids.map(id =>
            fetch('/teacher/api/assessment/' + id + '/unlock', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ is_unlocked: unlockVal })
            })
        ));

        const allOk = results.every(r => r.ok);
        if (allOk) {
            cmToast(`Successfully ${actionWord} ${ids.length} assessment(s).`, 'success');
            // Update UI elements in place for all affected assessments
            ids.forEach(id => {
                const accessBtn = document.getElementById('asmt-lock-btn-' + id);
                if (accessBtn) {
                    accessBtn.className = 'lock-btn ' + (unlockVal ? 'unlocked' : 'locked');
                    accessBtn.style.cssText = 'width:26px;height:26px';
                    const icon = accessBtn.querySelector('i');
                    if (icon) icon.className = 'fas fa-' + (unlockVal ? 'lock-open' : 'lock') + ' text-xs';
                    accessBtn.title = unlockVal ? 'Lock assessment' : 'Unlock assessment';
                    accessBtn.setAttribute('onclick', 'toggleAssessmentLock(' + id + ', ' + unlockVal + ', this)');
                }
                const menuLockBtn = document.getElementById('asmt-menu-lock-' + id);
                if (menuLockBtn) {
                    menuLockBtn.setAttribute('data-unlocked', unlockVal);
                    menuLockBtn.setAttribute('onclick', `closeAllAssessmentMenus(); toggleAssessmentLockFromMenu(${id}, ${unlockVal}, ${topicId})`);
                    const mIcon = menuLockBtn.querySelector('i');
                    if (mIcon) mIcon.className = `fas fa-${unlockVal ? 'lock' : 'lock-open'} text-slate-400 w-3.5 text-center`;
                    const mSpan = menuLockBtn.querySelector('span');
                    if (mSpan) mSpan.textContent = unlockVal ? 'Lock' : 'Unlock';
                }
            });
        } else {
            cmToast('Some assessments could not be updated.', 'warning');
        }
    } catch (e) {
        cmToast('Batch lock update failed. Please try again.', 'error');
    }
}

function batchDeleteAssessments(topicId) {
    const checkedBoxes = Array.from(document.querySelectorAll('.asmt-row-cb-' + topicId + ':checked'));
    if (!checkedBoxes.length) {
        cmToast('No assessments selected.', 'warning');
        return;
    }
    const ids = checkedBoxes.map(cb => cb.getAttribute('data-assessment-id'));
    const modalMsg = document.getElementById('deleteModalMsg');
    if (modalMsg) {
        modalMsg.textContent = `Are you sure you want to delete ${ids.length} selected assessment${ids.length > 1 ? 's' : ''}? This action cannot be undone.`;
    }
    const btn = document.getElementById('confirmDeleteBtn');
    if (btn) {
        btn.onclick = () => executeBatchDeleteAssessments(ids, topicId);
    }
    openModal('deleteModal');
}

async function executeBatchDeleteAssessments(ids, topicId) {
    try {
        const results = await Promise.all(ids.map(id =>
            fetch('/teacher/api/assessment/' + id, { method: 'DELETE' })
        ));
        closeModal('deleteModal');
        const allOk = results.every(r => r.ok);
        ids.forEach(id => {
            const row = document.getElementById('asmt-row-' + id);
            if (row) {
                row.style.transition = 'all 0.25s ease';
                row.style.opacity = '0';
                row.style.transform = 'translateX(16px)';
            }
        });
        if (allOk) {
            cmToast(`Successfully deleted ${ids.length} assessment(s).`, 'success');
        } else {
            cmToast('Some assessments could not be deleted.', 'warning');
        }
        await refreshClassViewContent({ ensureTopicOpen: topicId, ensureSubTab: 'assessments' });
    } catch (e) {
        closeModal('deleteModal');
        cmToast('Batch delete failed. Please try again.', 'error');
    }
}

function toggleAssignmentDropdownMenu(event, asgnId) {
    if (event) {
        event.stopPropagation();
        event.preventDefault();
    }
    const menu = document.getElementById('asgn-dropdown-' + asgnId);
    if (!menu) return;
    const isCurrentlyOpen = !menu.classList.contains('hidden');
    
    closeAllAssignmentMenus();

    if (!isCurrentlyOpen) {
        menu.classList.remove('hidden');
        // Reposition if menu overflows window bottom
        const rect = menu.getBoundingClientRect();
        if (rect.bottom > window.innerHeight) {
            menu.style.bottom = '100%';
            menu.style.top = 'auto';
            menu.style.marginBottom = '6px';
            menu.style.marginTop = '0';
        } else {
            menu.style.bottom = 'auto';
            menu.style.top = '100%';
            menu.style.marginTop = '6px';
            menu.style.marginBottom = '0';
        }
    }
}

