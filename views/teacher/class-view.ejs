                                         ondragleave="handleMatDragLeave(event)"
                                         ondrop="handleMatDrop(event)"
                                         style="border:2px dashed #cbd5e1;border-radius:12px;padding:20px 16px;text-align:center;cursor:pointer;transition:all .2s;background:#f8fafc;">
                                        <div class="w-10 h-10 rounded-full bg-teal-50 text-teal-600 flex items-center justify-center mx-auto mb-2 text-lg">
                                            <i class="fas fa-cloud-arrow-up"></i>
                                        </div>
                                        <p class="text-sm font-bold text-slate-700">Click to browse or drag & drop files</p>
                                        <p class="text-xs text-slate-400 mt-0.5" id="matTypeHint">PDF files only (.pdf) — max 50MB per file</p>
                                        <p class="text-[11px] text-indigo-600 font-semibold mt-1">
                                            <i class="fas fa-layer-group mr-1"></i>Multiple file upload supported — select or drag multiple items
                                        </p>
                                    </div>
                                    <input type="file" id="materialFileInput" class="hidden" multiple
                                           accept=".pdf"
                                           onchange="onMatFilesSelected(this)">

                                    <!-- Validation Error Alert Banner -->
                                    <div id="matValidationErrorAlert" class="hidden mt-2 p-2.5 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-xs flex items-start gap-2">
                                        <i class="fas fa-exclamation-triangle text-rose-500 mt-0.5 flex-shrink-0"></i>
                                        <div id="matValidationAlertText">Unsupported file format detected. Please check the file requirements.</div>
                                    </div>

                                    <!-- Queue / Selected Files Preview Area -->
                                    <div id="matQueueContainer" class="hidden mt-3">
                                        <div class="flex items-center justify-between mb-1.5">
                                            <span class="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                                                <i class="fas fa-list-check text-teal-600"></i>
                                                Selected File Queue (<span id="matQueueCount">0</span>)
                                            </span>
                                            <button type="button" onclick="clearMatFileQueue()" class="text-[11px] font-semibold text-rose-600 hover:text-rose-700 hover:underline">
                                                Clear queue
                                            </button>
                                        </div>
                                        <div id="matQueueList" class="space-y-2 max-h-52 overflow-y-auto pr-1">
                                            <!-- Dynamically rendered file preview cards -->
                                        </div>
                                    </div>
                                </div>

                                <!-- URL input -->
                                <div id="matUrlSection" style="display:none">
                                    <label class="form-label">Resource URL <span class="text-rose-500">*</span></label>
                                    <input type="text" id="materialUrl" name="file_path_or_url" class="form-input" placeholder="https://youtube.com/... or https://drive.google.com/...">
                                    <p class="text-[11px] text-slate-400 mt-1">Supported: YouTube, Google Drive, OneDrive, external links.</p>
                                </div>

                                <div class="flex items-center gap-3 mt-1 pt-1 border-t border-slate-100">
                                    <input type="checkbox" id="materialLocked" name="is_locked" value="1" class="w-4 h-4 accent-indigo-600 rounded">
                                    <label for="materialLocked" class="form-label mb-0 cursor-pointer">Lock this material (students cannot access)</label>
                                </div>

                                <!-- Upload progress bar -->
                                <div id="matUploadProgress" style="display:none;margin-top:8px" class="p-3 bg-slate-50 border border-slate-200 rounded-xl">
                                    <div class="flex items-center justify-between text-xs font-semibold text-slate-700 mb-1">
                                        <span id="matProgressTitle" class="flex items-center gap-1.5"><i class="fas fa-spinner fa-spin text-teal-600"></i> Uploading materials…</span>
                                        <span id="matProgressPercent" class="text-teal-700 font-bold">0%</span>
                                    </div>
                                    <div style="height:6px;background:#e2e8f0;border-radius:9999px;overflow:hidden">
                                        <div id="matProgressBar" style="height:100%;width:0%;background:linear-gradient(90deg,#0d9488,#4f46e5);border-radius:9999px;transition:width .2s ease"></div>
                                    </div>
                                    <p class="text-[11px] text-slate-400 mt-1.5" id="matProgressLabel">Uploading files…</p>
                                </div>
                            </div>
                            <div class="modal-footer bg-slate-50">
                                <button type="button" onclick="handleMaterialModalClose()" class="sort-btn">Cancel</button>
                                <button type="submit" id="matSaveBtn" class="sort-btn active" style="background:#0f766e;border-color:#0d9488;color:white">
                                    <i class="fas fa-save text-sm"></i> <span id="matSaveBtnText">Save Material</span>
                                </button>
                            </div>
                        </form>
                    </div>
