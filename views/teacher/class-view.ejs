<!-- ===== SCRIPTS ===== -->
<script>
/* ---- Sidebar toggle ---- */
function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const isOpen  = !sidebar.classList.contains('-translate-x-full');
    sidebar.classList.toggle('-translate-x-full', isOpen);
    overlay.classList.toggle('hidden', isOpen);
}

/* ---- Compute + populate summary stats ---- */
(function() {
    const rows = Array.from(document.querySelectorAll('#rosterBody tr[data-name]'));
    if (!rows.length) return;

    const progs   = rows.map(r => parseFloat(r.dataset.progress)    || 0);
    const solos   = rows.map(r => parseFloat(r.dataset.soloScore)   || 0);
    const versuss = rows.map(r => parseFloat(r.dataset.versusScore) || 0);

    const avgProg   = Math.round(progs.reduce((a,b)=>a+b,0) / progs.length);
    const avgSolo   = Math.round(solos.reduce((a,b)=>a+b,0) / solos.length);
    const avgVersus = Math.round(versuss.reduce((a,b)=>a+b,0) / versuss.length);
    const done      = progs.filter(p => p >= 100).length;

    const elAvgProg = document.getElementById('avgProgress');
    const elAvgSolo = document.getElementById('avgSoloScore');
    const elAvgVs   = document.getElementById('avgVersusScore');
    const elDone    = document.getElementById('completeCount');

    if (elAvgProg) elAvgProg.textContent = avgProg + '%';
    if (elAvgSolo) elAvgSolo.textContent = avgSolo.toLocaleString();
    if (elAvgVs)   elAvgVs.textContent   = avgVersus.toLocaleString();
    if (elDone)    elDone.textContent    = done;
})();

/* ---- Search ---- */
document.getElementById('studentSearch').addEventListener('input', filterAndRender);

/* ---- Sort state ---- */
let currentSort = 'name';
let sortDir     = 1;

function sortTable(key) {
    if (currentSort === key) { 
        sortDir *= -1; 
    } else { 
        // For score, solo, wins, or progress, default to descending (-1) so highest is first!
        sortDir = (key === 'score' || key === 'solo' || key === 'wins' || key === 'progress') ? -1 : 1; 
    }
    currentSort = key;

    document.querySelectorAll('.sort-btn').forEach(b => b.classList.remove('active'));
    const idMap = { name: 'sortName', score: 'sortScore', progress: 'sortProgress' };
    if (idMap[key] && document.getElementById(idMap[key])) {
        document.getElementById(idMap[key]).classList.add('active');
    }

    filterAndRender();
}

/* ---- Filter + sort + render ---- */
function filterAndRender() {
    const searchInput = document.getElementById('studentSearch');
    const query  = searchInput ? searchInput.value.toLowerCase().trim() : '';
    const tbody  = document.getElementById('rosterBody');
    if (!tbody) return;

    const rows   = Array.from(tbody.querySelectorAll('tr[data-name]'));
    const empty  = document.getElementById('emptyRow');

    let visible = rows.filter(r => (r.dataset.name || '').includes(query));

    visible.sort((a, b) => {
        if (currentSort === 'name')     return sortDir * (a.dataset.name || '').localeCompare(b.dataset.name || '');
        if (currentSort === 'score')    return sortDir * ((parseFloat(a.dataset.score) || 0) - (parseFloat(b.dataset.score) || 0));
        if (currentSort === 'solo')     return sortDir * ((parseFloat(a.dataset.soloScore) || 0) - (parseFloat(b.dataset.soloScore) || 0));
        if (currentSort === 'wins')     return sortDir * ((parseFloat(a.dataset.versusWins) || 0) - (parseFloat(b.dataset.versusWins) || 0));
        if (currentSort === 'progress') return sortDir * ((parseFloat(a.dataset.progress) || 0) - (parseFloat(b.dataset.progress) || 0));
        return 0;
    });

    rows.forEach(r => r.style.display = 'none');
    visible.forEach((r, i) => {
        r.style.display = '';
        const firstTd = r.querySelector('td:first-child');
        if (firstTd) firstTd.textContent = i + 1;
        tbody.appendChild(r); // Re-order DOM nodes to apply sort!
    });

    if (empty) {
        tbody.appendChild(empty);
        empty.classList.toggle('hidden', visible.length > 0);
    }

    const rowCountEl = document.getElementById('rowCount');
    if (rowCountEl) {
        const total = rows.length;
        rowCountEl.innerHTML =
            'Showing <strong>' + visible.length + '</strong>' +
            (visible.length < total ? ' of ' + total : '') + ' students';
    }
}

/* ---- Export to CSV ---- */
function exportCSV() {
    const rows = Array.from(document.querySelectorAll('#rosterBody tr[data-name]'))
                      .filter(r => r.style.display !== 'none');

    const headers = ['#','Name','LRN','Grade','Section','Solo Score','Versus Wins','Progress %','Last Accessed'];
    const lines   = [headers.join(',')];

    rows.forEach((row, i) => {
        const tds    = row.querySelectorAll('td');
        const name   = tds[1].querySelector('p').textContent.trim().replace(/,/g,' ');
        const lrn    = tds[2].textContent.trim();
        const spans  = tds[3].querySelectorAll('span');
        const grade  = spans[0] ? spans[0].textContent.trim() : '';
        const sec    = spans[1] ? spans[1].textContent.trim() : '';
        const solo   = row.dataset.soloScore || '0';
        const wins   = row.dataset.versusWins || '0';
        const prog   = row.dataset.progress || '0';
        const last   = tds[7] ? tds[7].textContent.trim().replace(/,/g,'') : 'Never';
        lines.push([i+1, name, lrn, grade, sec, solo, wins, prog, last].join(','));
    });

    const blob = new Blob([lines.join('\n')], { type: 'text/csv' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = 'roster_<%= classInfo.class_name.replace(/\s+/g, "_") %>.csv';
    a.click();
    URL.revokeObjectURL(url);
}

