/* ================================================================
   SEAMLESS BACKGROUND CONTENT REFRESH (ZERO RELOAD)
   ================================================================ */
window.refreshClassViewContent = async function(options = {}) {
    try {
        const openQuarters = new Set();
        document.querySelectorAll('.quarter-body').forEach(qb => {
            if (qb.style.display !== 'none') {
                openQuarters.add(qb.id.replace('quarter-body-', ''));
            }
        });
        if (options.ensureQuarterOpen) {
            openQuarters.add(String(options.ensureQuarterOpen));
        }

        const openTopics = new Set();
        const activeSubTabs = {};
        document.querySelectorAll('.topic-panel').forEach(panel => {
            const tid = panel.id.replace('panel-', '');
            if (panel.classList.contains('open')) {
                openTopics.add(String(tid));
            }
            ['assessments', 'assignments', 'materials'].forEach(tabName => {
                const tc = document.getElementById('tab-' + tid + '-' + tabName);
                if (tc && !tc.classList.contains('hidden')) {
                    activeSubTabs[String(tid)] = tabName;
                }
            });
        });
        if (options.ensureTopicOpen) {
            openTopics.add(String(options.ensureTopicOpen));
        }
        if (options.ensureTopicOpen && options.ensureSubTab) {
            activeSubTabs[String(options.ensureTopicOpen)] = options.ensureSubTab;
        }

        const searchEl = document.getElementById('cmSearch');
        const currentSearch = searchEl ? searchEl.value : '';

        const res = await fetch(window.location.href, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            cache: 'no-store'
        });
        if (!res.ok) return;
        const html = await res.text();
        const parser = new DOMParser();
        const newDoc = parser.parseFromString(html, 'text/html');

        // 1. Swap Quarters Accordion Container
        const curContainer = document.getElementById('quartersContainer');
        const newContainer = newDoc.getElementById('quartersContainer');
        if (curContainer && newContainer) {
            curContainer.innerHTML = newContainer.innerHTML;

            if (options.ensureTopicOpen) {
                const topicRow = document.getElementById('topic-row-' + options.ensureTopicOpen);
                if (topicRow && topicRow.dataset.quarter) {
                    openQuarters.add(String(topicRow.dataset.quarter));
                }
            }

            // Restore open quarters
            document.querySelectorAll('.quarter-block').forEach(qb => {
                const qid = qb.id.replace('quarter-block-', '');
                const body = document.getElementById('quarter-body-' + qid);
                const chev = document.getElementById('chevron-q-' + qid);
                const shouldOpen = openQuarters.has(String(qid));
                if (body) body.style.display = shouldOpen ? 'block' : 'none';
                if (chev) chev.classList.toggle('open', shouldOpen);
            });

            // Restore open topics and active sub-tabs
            document.querySelectorAll('.topic-panel').forEach(panel => {
                const tid = panel.id.replace('panel-', '');
                const chev = document.getElementById('chevron-t-' + tid);
                const shouldOpen = openTopics.has(String(tid));
                panel.classList.toggle('open', shouldOpen);
                if (chev) chev.classList.toggle('open', shouldOpen);

                const subTab = activeSubTabs[String(tid)];
                if (subTab) {
                    const tabBtns = panel.querySelectorAll('.panel-tab');
                    tabBtns.forEach(btn => {
                        const onclickAttr = btn.getAttribute('onclick') || '';
                        if (onclickAttr.includes("'" + subTab + "'")) {
                            switchTab(tid, subTab, btn);
                        }
                    });
                }
            });

            if (currentSearch && currentSearch.trim() !== '') {
                cmGeneralSearch(currentSearch);
            }
        }

        // 2. Sync breakdownSelect dropdown options if present
        const curBreakdownSel = document.getElementById('breakdownSelect');
        const newBreakdownSel = newDoc.getElementById('breakdownSelect');
        if (curBreakdownSel && newBreakdownSel) {
            const prevVal = curBreakdownSel.value;
            curBreakdownSel.innerHTML = newBreakdownSel.innerHTML;
            if (prevVal) curBreakdownSel.value = prevVal;
        }

        // 3. Sync Calendar Events, Assessment Deadlines, and Assessments Filter Array
        const syncEl = newDoc.getElementById('class-view-sync-data');
        if (syncEl) {
            try {
                const syncData = JSON.parse(syncEl.textContent);
                if (Array.isArray(syncData.calEvents)) {
                    CAL_EVENTS.splice(0, CAL_EVENTS.length, ...syncData.calEvents);
                }
                if (Array.isArray(syncData.asmtDeadlines)) {
                    ASMT_DEADLINES.splice(0, ASMT_DEADLINES.length, ...syncData.asmtDeadlines);
                }
                if (Array.isArray(syncData.allAssessments) && typeof allAssessmentsList !== 'undefined') {
                    allAssessmentsList.splice(0, allAssessmentsList.length, ...syncData.allAssessments);
                }
                if (typeof updateAssessmentFilterOptions === 'function') updateAssessmentFilterOptions();
                if (typeof renderCalendar === 'function') renderCalendar();
                if (typeof renderTimeline === 'function') renderTimeline();
            } catch (parseErr) {
                console.warn('Error parsing class-view-sync-data:', parseErr);
            }
        }
    } catch (err) {
        console.error('Error refreshing class view content:', err);
    }
};
 
