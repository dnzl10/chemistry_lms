let matInitialState = null;

function hasUnsavedMaterialChanges() {
    if (!matInitialState) return false;
    const currentTitle = (document.getElementById('materialTitle')?.value || '').trim();
    const currentType = document.getElementById('materialType')?.value || 'pdf';
    const currentLocked = document.getElementById('materialLocked')?.checked || false;
    const currentUrl = (document.getElementById('materialUrl')?.value || '').trim();
    const currentSource = (document.getElementById('matSrcFileBtn')?.style.background === 'white') ? 'file' : 'url';

    if (matSelectedFiles && matSelectedFiles.length > 0) return true;
    if (currentTitle !== matInitialState.title) return true;
    if (currentType !== matInitialState.type) return true;
    if (currentLocked !== matInitialState.isLocked) return true;
    if (currentSource !== matInitialState.sourceMode) return true;
    if (currentUrl !== matInitialState.url) return true;

    return false;
}

