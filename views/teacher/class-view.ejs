/* ================================================================
   LOCK TOGGLES — each calls your REST API endpoint via fetch
   ================================================================ */

async function toggleQuarterLock(qid, currentLocked) {
    const newVal = currentLocked ? 0 : 1;
    try {
        const res = await fetch('/teacher/api/quarter/' + qid + '/lock', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_locked: newVal })
        });
        if (!res.ok) throw new Error();

        const btn = document.getElementById('qlock-' + qid);
        btn.className = 'lock-btn ' + (newVal ? 'locked' : 'unlocked');
        btn.querySelector('i').className = 'fas fa-' + (newVal ? 'lock' : 'lock-open') + ' text-xs';
        btn.title = newVal ? 'Unlock quarter' : 'Lock quarter';

        /* If locking — visually dim all topic lock buttons since they cascade */
        if (newVal) {
            document.querySelectorAll('.topic-row[data-quarter="' + qid + '"] .lock-btn').forEach(b => {
                b.classList.add('locked');
                b.classList.remove('unlocked');
                b.querySelector('i').className = 'fas fa-lock text-xs';
                b.disabled = true;
                b.style.opacity = '0.4';
                b.style.cursor  = 'not-allowed';
            });
            cmToast('Quarter locked — all topics locked with it.', 'success');
        } else {
            /* Unlock quarter only — topics stay as they are */
            document.querySelectorAll('.topic-row[data-quarter="' + qid + '"] .lock-btn').forEach(b => {
                b.disabled = false;
                b.style.opacity = '';
                b.style.cursor  = '';
            });
            cmToast('Quarter unlocked. Topics remain individually locked.', 'success');
        }
    } catch(e) {
        cmToast('Failed to update quarter lock.', 'error');
    }
}

async function toggleTopicLock(tid, currentLocked) {
    const newVal = currentLocked ? 0 : 1;
    try {
        const res = await fetch('/teacher/api/topic/' + tid + '/lock', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_locked: newVal })
        });
        if (!res.ok) throw new Error();

        const btn = document.getElementById('tlock-' + tid);
        if (btn) {
            btn.className = 'lock-btn ' + (newVal ? 'locked' : 'unlocked');
            const icon = btn.querySelector('i');
            if (icon) icon.className = 'fas fa-' + (newVal ? 'lock' : 'lock-open') + ' text-xs';
            btn.title = newVal ? 'Unlock topic' : 'Lock topic';
            btn.setAttribute('onclick', `toggleTopicLock(${tid}, ${newVal})`);
        }
        const dataEl = document.getElementById('topic-data-' + tid);
        if (dataEl) {
            try {
                const parsed = JSON.parse(dataEl.textContent);
                parsed.is_locked = newVal;
                dataEl.textContent = JSON.stringify(parsed);
            } catch (_) {}
        }
        cmToast('Topic ' + (newVal ? 'locked' : 'unlocked') + '.', 'success');
    } catch(e) {
        cmToast('Failed to update topic lock.', 'error');
    }
}

async function toggleMaterialLock(mid, currentLocked, btnEl) {
    const newVal = currentLocked ? 0 : 1;
    try {
        const res = await fetch('/teacher/api/material/' + mid + '/lock', {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_locked: newVal })
        });
