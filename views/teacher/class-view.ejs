let matSelectedFiles = [];
const MAT_MAX_FILE_BYTES = 50 * 1024 * 1024; // 50MB

function formatMatFileSize(bytes) {
    if (!bytes || bytes === 0) return '0 B';
    const k = 1024;
    const sizes = ['B', 'KB', 'MB', 'GB'];
    const i = Math.floor(Math.log(bytes) / Math.log(k));
    return parseFloat((bytes / Math.pow(k, i)).toFixed(2)) + ' ' + sizes[i];
}

function escapeMatHtml(str) {
    if (!str) return '';
    return String(str)
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#039;');
}

/* Called by the Upload/URL tab buttons in the material modal */
function switchMatSource(mode) {
    const fileBtn     = document.getElementById('matSrcFileBtn');
    const urlBtn      = document.getElementById('matSrcUrlBtn');
    const fileSection = document.getElementById('matFileSection');
    const urlSection  = document.getElementById('matUrlSection');
    if (!fileBtn || !urlBtn || !fileSection || !urlSection) return;

    if (mode === 'file') {
        fileBtn.style.background   = 'white';
        fileBtn.style.color        = '#4f46e5';
        fileBtn.style.boxShadow    = '0 1px 4px rgba(0,0,0,0.08)';
        urlBtn.style.background    = 'transparent';
        urlBtn.style.color         = '#64748b';
        urlBtn.style.boxShadow     = 'none';
        fileSection.style.display  = '';
        urlSection.style.display   = 'none';
        revalidateMatFiles();
    } else {
        urlBtn.style.background    = 'white';
        urlBtn.style.color         = '#4f46e5';
        urlBtn.style.boxShadow     = '0 1px 4px rgba(0,0,0,0.08)';
        fileBtn.style.background   = 'transparent';
        fileBtn.style.color        = '#64748b';
        fileBtn.style.boxShadow    = 'none';
        fileSection.style.display  = 'none';
        urlSection.style.display   = '';
        // Hide file validation alert when in URL mode
        const alertEl = document.getElementById('matValidationErrorAlert');
        if (alertEl) alertEl.classList.add('hidden');
    }
}

/* Validates a single file against the specified or currently active material type */
function validateMatFile(file, matType) {
    const rule = MATERIAL_TYPE_RULES[matType];
    if (!rule) return { isValid: true, reason: null };

    if (matType === 'link') {
        return { isValid: false, reason: 'Files cannot be attached to a Link/URL material type.' };
    }

    if (file.size > MAT_MAX_FILE_BYTES) {
        return {
            isValid: false,
            reason: `File size (${formatMatFileSize(file.size)}) exceeds the maximum 50MB limit.`
        };
    }

    const nameParts = (file.name || '').split('.');
    const ext = nameParts.length > 1 ? nameParts.pop().toLowerCase() : '';
    const matchesExt = rule.extensions.includes(ext);
    const matchesMime = file.type && (
        rule.mimes.includes(file.type) ||
        (matType === 'video' && file.type.startsWith('video/')) ||
        (matType === 'img' && file.type.startsWith('image/'))
    );

    if (!matchesExt && !matchesMime) {
        const allowedExts = rule.extensions.map(e => '.' + e).join(', ');
        return {
            isValid: false,
            reason: `Unsupported format ".${ext || 'unknown'}". ${rule.label} requires: ${allowedExts}`
        };
    }

    return { isValid: true, reason: null };
}

/* Revalidates all items currently queued in the modal */
function revalidateMatFiles() {
    const typeSelect = document.getElementById('materialType');
    const currentType = typeSelect ? typeSelect.value : 'pdf';
    const rule = MATERIAL_TYPE_RULES[currentType] || MATERIAL_TYPE_RULES.pdf;

    let hasErrors = false;
    let errorReasons = [];

    matSelectedFiles.forEach(item => {
        const res = validateMatFile(item.file, currentType);
        item.isValid = res.isValid;
        item.errorReason = res.reason;
        if (!res.isValid) {
            hasErrors = true;
            if (!errorReasons.includes(res.reason)) errorReasons.push(res.reason);
        }
    });

    const alertEl = document.getElementById('matValidationErrorAlert');
    const alertTextEl = document.getElementById('matValidationAlertText');
    const saveBtn = document.getElementById('matSaveBtn');

    if (hasErrors && matSelectedFiles.length > 0) {
        if (alertEl) alertEl.classList.remove('hidden');
        if (alertTextEl) {
            alertTextEl.innerHTML = `<strong>Invalid File Attached:</strong> ${escapeMatHtml(errorReasons[0])} Please remove unsupported items or switch the Material Type.`;
        }
        if (saveBtn) {
            saveBtn.style.opacity = '0.7';
        }
    } else {
        if (alertEl) alertEl.classList.add('hidden');
        if (saveBtn) {
            saveBtn.style.opacity = '1';
        }
    }

    renderMatFilesPreview();
    return !hasErrors;
}

/* Renders the preview area with full file metadata, validation indicators, and removal buttons */
function renderMatFilesPreview() {
    const container = document.getElementById('matQueueContainer');
    const listEl = document.getElementById('matQueueList');
    const countEl = document.getElementById('matQueueCount');
    const batchHint = document.getElementById('matBatchTitleHint');
    if (!container || !listEl) return;

    if (matSelectedFiles.length === 0) {
        container.classList.add('hidden');
        listEl.innerHTML = '';
        if (countEl) countEl.textContent = '0';
        if (batchHint) batchHint.classList.add('hidden');
        return;
    }

    container.classList.remove('hidden');
    if (countEl) countEl.textContent = matSelectedFiles.length;
    if (batchHint) {
        batchHint.classList.toggle('hidden', matSelectedFiles.length <= 1);
    }

    const typeSelect = document.getElementById('materialType');
    const currentType = typeSelect ? typeSelect.value : 'pdf';
    const rule = MATERIAL_TYPE_RULES[currentType] || MATERIAL_TYPE_RULES.pdf;

    listEl.innerHTML = matSelectedFiles.map((item, idx) => {
        const file = item.file;
        const ext = (file.name.split('.').pop() || '').toUpperCase();
        const mime = file.type || 'application/octet-stream';
        const formattedSize = formatMatFileSize(file.size);

        // Validation / Upload status badge
        let statusBadge = '';
        let cardBorder = 'border-slate-200';
        if (item.status === 'uploading') {
            cardBorder = 'border-indigo-400 bg-indigo-50/20';
            statusBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-indigo-700 bg-indigo-50 border border-indigo-200 px-2 py-0.5 rounded-full"><i class="fas fa-spinner fa-spin text-xs"></i> ${item.progress || 0}%</span>`;
        } else if (item.status === 'completed') {
            cardBorder = 'border-teal-400 bg-teal-50/20';
            statusBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-teal-700 bg-teal-50 border border-teal-200 px-2 py-0.5 rounded-full"><i class="fas fa-check-double text-xs"></i> Uploaded</span>`;
        } else if (item.status === 'error') {
            cardBorder = 'border-rose-400 bg-rose-50/30';
            statusBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-rose-700 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-full"><i class="fas fa-triangle-exclamation text-xs"></i> Failed</span>`;
        } else if (!item.isValid) {
            cardBorder = 'border-rose-300 bg-rose-50/30';
            statusBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-rose-700 bg-rose-50 border border-rose-200 px-2 py-0.5 rounded-full" title="${escapeMatHtml(item.errorReason)}"><i class="fas fa-ban text-xs"></i> Invalid</span>`;
        } else {
            statusBadge = `<span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 border border-emerald-200 px-2 py-0.5 rounded-full"><i class="fas fa-check-circle text-xs"></i> Ready</span>`;
        }

        // Thumbnail or Type Icon
        let previewThumbnail = '';
        if (item.previewUrl) {
            previewThumbnail = `<img src="${item.previewUrl}" alt="Preview" class="w-9 h-9 object-cover rounded-lg border border-slate-200 flex-shrink-0">`;
        } else {
            previewThumbnail = `<div class="w-9 h-9 rounded-lg ${rule.bgColor} ${rule.borderColor} border flex items-center justify-center ${rule.textColor} text-sm flex-shrink-0"><i class="fas ${rule.icon}"></i></div>`;
        }

        // Editable individual title if in batch mode (> 1 file)
        const batchTitleInput = matSelectedFiles.length > 1
            ? `<div class="mt-1.5 flex items-center gap-1.5">
                   <span class="text-[10px] font-semibold text-slate-400 flex-shrink-0">Title:</span>
                   <input type="text" value="${escapeMatHtml(item.title)}" oninput="updateMatFileTitle(${idx}, this.value)" class="text-xs px-2 py-0.5 border border-slate-200 rounded bg-slate-50 focus:bg-white focus:border-teal-500 w-full outline-none font-medium text-slate-700" placeholder="Material title for this file">
               </div>`
            : '';

        // Error message callout under invalid item
        const errorCallout = !item.isValid && item.errorReason
            ? `<div class="mt-1.5 p-1.5 rounded-lg bg-rose-50 border border-rose-200 text-rose-700 text-[11px] flex items-start gap-1.5 font-medium leading-tight">
                   <i class="fas fa-exclamation-circle text-rose-500 mt-0.5 flex-shrink-0"></i>
                   <span>${escapeMatHtml(item.errorReason)}</span>
               </div>`
            : '';

        return `
            <div class="p-2.5 rounded-xl border ${cardBorder} bg-white shadow-xs transition hover:shadow-sm" id="mat-file-card-${idx}">
                <div class="flex items-start justify-between gap-2.5">
                    <div class="flex items-start gap-2.5 min-w-0 flex-1">
                        ${previewThumbnail}
                        <div class="min-w-0 flex-1">
                            <p class="text-xs font-bold text-slate-800 truncate" title="${escapeMatHtml(file.name)}">${escapeMatHtml(file.name)}</p>
                            <div class="flex items-center flex-wrap gap-x-2 gap-y-0.5 text-[11px] text-slate-400 mt-0.5">
                                <span class="font-semibold text-slate-600"><i class="fas fa-hard-drive text-[10px] mr-1 text-slate-400"></i>${formattedSize}</span>
                                <span>•</span>
                                <span class="uppercase tracking-wider font-semibold text-slate-500">${ext}</span>
                                <span>•</span>
                                <span class="truncate max-w-[130px]" title="${escapeMatHtml(mime)}">${escapeMatHtml(mime)}</span>
                            </div>
                        </div>
                    </div>
                    <div class="flex items-center gap-1.5 flex-shrink-0">
                        ${statusBadge}
                        <button type="button" onclick="removeMatFile(${idx})" class="w-7 h-7 rounded-lg hover:bg-rose-50 text-slate-400 hover:text-rose-600 flex items-center justify-center transition" title="Remove file">
                            <i class="fas fa-trash-alt text-xs"></i>
                        </button>
                    </div>
                </div>
                ${batchTitleInput}
                ${errorCallout}
            </div>
        `;
    }).join('');
}

/* Appends newly selected or dropped files into the queue */
function addFilesToMatQueue(filesList) {
    if (!filesList || filesList.length === 0) return;
    const filesArr = Array.from(filesList);

    filesArr.forEach(file => {
        // Prevent exact duplicate file addition
        const exists = matSelectedFiles.some(item => item.file.name === file.name && item.file.size === file.size);
        if (!exists) {
            let previewUrl = null;
            if (file.type && file.type.startsWith('image/')) {
                try {
                    previewUrl = URL.createObjectURL(file);
                } catch(e) {}
            }

            const cleanName = file.name.replace(/\.[^/.]+$/, "");
            matSelectedFiles.push({
                id: 'mf_' + Date.now() + '_' + Math.random().toString(36).substr(2, 6),
                file: file,
                title: cleanName,
                isValid: true,
                errorReason: null,
                status: 'pending',
                progress: 0,
                previewUrl: previewUrl
            });
        }
    });

    // Auto-populate Title input if currently empty and single file added
    const titleInput = document.getElementById('materialTitle');
    if (titleInput && !titleInput.value.trim() && matSelectedFiles.length === 1) {
        titleInput.value = matSelectedFiles[0].title;
    }

    revalidateMatFiles();
}

/* Updates the custom title for a specific file in the queue */
function updateMatFileTitle(index, val) {
    if (matSelectedFiles[index]) {
        matSelectedFiles[index].title = val;
    }
}

/* Removes an individual file from the queue */
function removeMatFile(index) {
    if (matSelectedFiles[index]) {
        if (matSelectedFiles[index].previewUrl) {
            try { URL.revokeObjectURL(matSelectedFiles[index].previewUrl); } catch(e) {}
        }
        matSelectedFiles.splice(index, 1);
    }
    const fileInput = document.getElementById('materialFileInput');
    if (matSelectedFiles.length === 0 && fileInput) {
        fileInput.value = '';
    }
    revalidateMatFiles();
}

/* Clears all files in the queue */
function clearMatFileQueue() {
    matSelectedFiles.forEach(item => {
        if (item.previewUrl) {
            try { URL.revokeObjectURL(item.previewUrl); } catch(e) {}
        }
    });
    matSelectedFiles = [];
    const fileInput = document.getElementById('materialFileInput');
    if (fileInput) fileInput.value = '';
    renderMatFilesPreview();
    const alertEl = document.getElementById('matValidationErrorAlert');
    if (alertEl) alertEl.classList.add('hidden');
    const saveBtn = document.getElementById('matSaveBtn');
    if (saveBtn) saveBtn.style.opacity = '1';
}

/* File input change event handler */
function onMatFilesSelected(input) {
    if (input && input.files && input.files.length > 0) {
        addFilesToMatQueue(input.files);
    }
}
const onMatFileSelected = onMatFilesSelected; // backward compatibility alias

/* Drag and drop event handlers */
function handleMatDragOver(e) {
    e.preventDefault();
    e.stopPropagation();
    const dropzone = document.getElementById('matDropzone');
    if (dropzone) {
        dropzone.style.borderColor = '#0d9488';
        dropzone.style.background = '#f0fdfa';
    }
}

function handleMatDragLeave(e) {
    e.preventDefault();
    e.stopPropagation();
    const dropzone = document.getElementById('matDropzone');
    if (dropzone) {
        dropzone.style.borderColor = '#cbd5e1';
        dropzone.style.background = '#f8fafc';
    }
}

function handleMatDrop(e) {
    e.preventDefault();
    e.stopPropagation();
    const dropzone = document.getElementById('matDropzone');
    if (dropzone) {
        dropzone.style.borderColor = '#cbd5e1';
        dropzone.style.background = '#f8fafc';
    }
    if (e.dataTransfer && e.dataTransfer.files && e.dataTransfer.files.length > 0) {
        addFilesToMatQueue(e.dataTransfer.files);
    }
}

/* Force URL mode when "link" type is selected, update accept attributes, and revalidate files */
function onMaterialTypeChange(val) {
    const toggle = document.getElementById('matSourceToggle');
    const rule = MATERIAL_TYPE_RULES[val] || MATERIAL_TYPE_RULES.pdf;

    const fileInput = document.getElementById('materialFileInput');
    if (fileInput && rule.accept) {
        fileInput.accept = rule.accept;
    }

    const typeHint = document.getElementById('matTypeHint');
    if (typeHint) {
        typeHint.textContent = rule.hint;
    }

    const ruleBadge = document.getElementById('matTypeRuleBadge');
    if (ruleBadge) {
        ruleBadge.textContent = rule.label;
    }

    const modalIcon = document.getElementById('matModalIcon');
    if (modalIcon) {
        modalIcon.className = 'fas ' + rule.icon + ' text-base';
    }

    if (val === 'link') {
        if (toggle) toggle.style.display = 'none';
        switchMatSource('url');
    } else {
        if (toggle) toggle.style.display = 'flex';
    }

    revalidateMatFiles();
}


/* ================================================================
   ENROLLMENT CODE TOGGLE
   ================================================================ */
let enrollCodeVisible = false;
 
function toggleEnrollCode() {
    enrollCodeVisible = !enrollCodeVisible;
    document.getElementById('enrollCodeMask').classList.toggle('hidden', enrollCodeVisible);
    document.getElementById('enrollCodeText').classList.toggle('hidden', !enrollCodeVisible);
    const icon = document.getElementById('enrollToggleIcon');
    icon.className = enrollCodeVisible
        ? 'fas fa-eye-slash text-white/60 text-sm'
        : 'fas fa-eye text-white/60 text-sm';
}
 
 
/* ================================================================
   SHARE ENROLLMENT KEY MODAL
   ================================================================ */
function openShareModal() {
    const modal = document.getElementById('shareModal');
    modal.style.display = 'flex';
}
 
function closeShareModal() {
    const modal = document.getElementById('shareModal');
    modal.style.display = 'none';
}
 
async function copyShareMessage() {
    const text = document.getElementById('shareMessageBox').textContent.trim();
    const btn  = document.getElementById('copyShareBtn');
    try {
        await navigator.clipboard.writeText(text);
        btn.innerHTML = '<i class="fas fa-check text-sm"></i> Copied!';
        btn.style.background = '#059669';
        setTimeout(() => {
            btn.innerHTML = '<i class="fas fa-copy text-sm"></i> Copy';
            btn.style.background = '#0891b2';
        }, 2000);
    } catch (err) {
        // Fallback for older browsers
        const ta = document.createElement('textarea');
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand('copy');
        document.body.removeChild(ta);
        btn.innerHTML = '<i class="fas fa-check text-sm"></i> Copied!';
        setTimeout(() => { btn.innerHTML = '<i class="fas fa-copy text-sm"></i> Copy'; }, 2000);
    }
}
 
/* Close share modal on backdrop click */
document.getElementById('shareModal').addEventListener('click', function(e) {
    if (e.target === this) closeShareModal();
});
 
 
/* ================================================================
   SUBJECT IMAGE UPLOAD (thumbnail in hero)
   ================================================================ */
async function uploadSubjectImage(input) {
    if (!input.files[0]) return;
 
    const subjectId = <%= subject.subject_id %>;
    const fd = new FormData();
    fd.append('image', input.files[0]);
 
    try {
        const res  = await fetch(`/teacher/api/subject/${subjectId}/image`, {
            method: 'POST',
            body: fd
        });
        const data = await res.json();
 
        if (!res.ok || !data.success) throw new Error(data.error || 'Upload failed');
 
        // Update thumbnail immediately
        const wrap     = document.getElementById('subjectThumbWrap');
        const thumbIcon = document.getElementById('thumbIcon');
        const imgUrl   = `/profile_uploads/${data.filename}?t=${Date.now()}`;
 
        // Remove old <img> if it exists
        const oldImg = wrap.querySelector('img');
        if (oldImg) oldImg.remove();
 
        // Insert new <img> before the icon
        const newImg = document.createElement('img');
        newImg.src   = imgUrl;
        newImg.className = 'w-full h-full object-cover';
        newImg.onerror   = () => { newImg.style.display = 'none'; thumbIcon.style.display = 'flex'; };
        wrap.insertBefore(newImg, thumbIcon);
        thumbIcon.style.display = 'none';
 
        // Also update the background hero image
        const heroBg = document.querySelector('.subject-hero-img');
        if (heroBg) heroBg.src = imgUrl;
 
        cmToast('Subject image updated!', 'success');
 
    } catch (err) {
        cmToast('Image upload failed: ' + err.message, 'error');
    }
}


</script>


