                <!-- ======= ASSESSMENT MODAL ======= -->
                <div class="modal-backdrop" id="assessmentModal">
                    <div class="modal-card" style="max-width:1100px; width:95vw; max-height:92vh; display:flex; flex-direction:column;">
                        <div class="modal-header">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center">
                                    <i class="fas fa-clipboard-list text-amber-600 text-base"></i>
                                </div>
                                <div class="flex items-center gap-2">
                                    <h3 class="font-bold text-slate-800 text-base" id="assessmentModalTitle">Manage Assessment</h3>
                                    <span id="asmtModalLoadingSpinner" class="hidden text-xs text-amber-600 font-normal">
                                        <i class="fas fa-spinner fa-spin mr-1"></i> Loading details...
                                    </span>
                                </div>
                            </div>
                            <button type="button" onclick="handleAssessmentModalClose()" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 cursor-pointer">
                                <i class="fas fa-times text-base"></i>
                            </button>
                        </div>
                        <form id="assessmentForm" onsubmit="submitAssessmentForm(event)" style="display:flex; flex-direction:column; overflow:hidden; height:100%;">
                            <input type="hidden" id="assessmentId" name="assessment_id">
                            <input type="hidden" id="assessmentTopicId" name="topic_id">
                            <input type="hidden" id="assessmentQuarterId" name="quarter_id">

                            <div class="modal-body overflow-y-auto" style="padding:1.25rem;">
                                <div class="grid grid-cols-1 lg:grid-cols-12 gap-5">

                                    <!-- ═════════ LEFT COLUMN: SETTINGS & SCHEDULE (5 Cols) ═════════ -->
                                    <div class="lg:col-span-5 space-y-3.5">
                                        <div class="pb-1 border-b border-slate-100 flex items-center justify-between">
                                            <h4 class="text-xs font-bold uppercase tracking-wider text-slate-500">
                                                <i class="fas fa-sliders-h text-amber-600 mr-1.5"></i>General Parameters
                                            </h4>
                                            <span class="text-[10px] text-slate-400 font-medium">Arcade Exam Settings</span>
                                        </div>

                                        <div>
                                            <label class="form-label">Assessment Title <span class="text-rose-500">*</span></label>
                                            <input type="text" id="assessmentName" name="assessment_name" class="form-input font-medium" placeholder="e.g. Periodic Table Diagnostic Pre-Test" required>
                                        </div>

                                        <div class="grid grid-cols-2 gap-2.5">
                                            <div>
                                                <label class="form-label">Type <span class="text-rose-500">*</span></label>
                                                <select id="assessmentType" name="assessment_type" class="form-select" required onchange="handleAssessmentTypeChange(this)">
                                                    <option value="Pre-Test">Pre-Test (Diagnostic)</option>
                                                    <option value="Post-Test">Post-Test (Summative)</option>
                                                    <option value="Competitive">Competitive (Duel)</option>
                                                    <option value="Quiz">Quiz (Practice)</option>
                                                </select>
                                            </div>
                                            <div>
                                                <label class="form-label">Access State <span class="text-rose-500">*</span></label>
                                                <select id="assessmentUnlocked" name="is_unlocked" class="form-select font-medium" required>
                                                    <option value="1">🟢 Open / Unlocked</option>
                                                    <option value="0">🔒 Locked (Blocked)</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="grid grid-cols-2 gap-2.5">
                                            <div>
                                                <label class="form-label">Duration (mins)</label>
                                                <input type="number" id="assessmentDuration" name="duration_minutes" class="form-input" min="1" value="30" placeholder="30">
                                            </div>
                                            <div>
                                                <label class="form-label">Timer Type</label>
                                                <select id="assessmentTimerType" name="timer_type" class="form-select">
                                                    <option value="Global">Global Countdown</option>
                                                    <option value="PerItem">Per Item Limit</option>
                                                </select>
                                            </div>
                                        </div>

                                        <div class="grid grid-cols-2 gap-2.5">
                                            <div>
                                                <label class="form-label">Opens At (Start Date)</label>
                                                <input type="datetime-local" id="assessmentStart" name="start_date" class="form-input text-xs">
                                            </div>
                                            <div>
                                                <label class="form-label">Deadline (Due Date)</label>
                                                <input type="datetime-local" id="assessmentDue" name="due_date" class="form-input text-xs">
                                            </div>
                                        </div>

                                        <div>
                                            <div class="flex items-center justify-between mb-1">
                                                <label class="form-label mb-0">Total Items (Arcade Orders) <span class="text-rose-500">*</span></label>
                                                <span class="text-[10px] text-slate-400">Questions in session</span>
                                            </div>
                                            <input type="number" id="assessmentItems" name="total_items" class="form-input font-bold text-slate-800" min="1" value="10" placeholder="10" required oninput="validatePoolShortage()">
                                            <div id="assessmentPoolNotice" class="text-[11px] mt-1.5 p-2 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-start gap-1.5 transition-all">
                                                <i class="fas fa-database mt-0.5 text-emerald-600 flex-shrink-0"></i>
                                                <span id="assessmentPoolNoticeText">Checking question bank pool...</span>
                                            </div>
