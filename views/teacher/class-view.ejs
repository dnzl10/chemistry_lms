                                                                                onclick="closeAllAssignmentMenus(); confirmDelete('assignment', <%= asgn.assessment_id %>, '<%= asgn.assessment_name.replace(/'/g, "\\'") %>')">
                                                                            <i class="fas fa-trash text-rose-500 w-3.5 text-center"></i>
                                                                            <span>Delete</span>
                                                                        </button>
