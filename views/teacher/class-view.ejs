function filterManualQuestions(term) {
    const q = (term || '').toLowerCase().trim();
    document.querySelectorAll('#manualQuestionsList > div[data-question-item]').forEach(el => {
        const text = (el.getAttribute('data-search') || '').toLowerCase();
        if (!q || text.includes(q)) {
            el.classList.remove('hidden');
        } else {
            el.classList.add('hidden');
        }
    });
}

function renderManualQuestionsList() {
    const listEl = document.getElementById('manualQuestionsList');
    if (!listEl) return;
    const questions = currentTopicPool.questions || [];
    if (questions.length === 0) {
        listEl.innerHTML = `<p class="text-xs text-slate-400 p-4 text-center italic">No active approved questions found in the question bank for this topic.</p>`;
        updateManualSummary();
        return;
    }

    const selectedMap = new Map();
    (currentManualQuestions || []).forEach(mq => {
        selectedMap.set(parseInt(mq.question_id, 10), parseInt(mq.custom_points, 10) || 1);
    });

    listEl.innerHTML = questions.map((q, idx) => {
        const qid = parseInt(q.question_id, 10);
        const isChecked = selectedMap.has(qid);
        const pts = isChecked ? selectedMap.get(qid) : (q.points || 1);
        const searchText = `${q.question_code || ''} ${q.machine_name || ''} ${q.prompt || ''} ${q.answer_text || ''}`.replace(/"/g, '&quot;');
        return `
            <div data-question-item="1" data-search="${searchText}" class="flex items-start gap-2.5 p-2.5 rounded-xl border border-slate-200 bg-white hover:border-amber-300 hover:shadow-sm transition-all">
                <input type="checkbox" class="manual-q-cb mt-1 text-amber-600 rounded focus:ring-amber-500 cursor-pointer h-4 w-4" data-qid="${qid}" ${isChecked ? 'checked' : ''} onchange="onManualQuestionToggle()">
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-1.5 flex-wrap">
                        <span class="text-[10px] font-mono font-bold px-1.5 py-0.5 bg-slate-100 text-slate-700 rounded">${q.question_code || 'Q' + (idx + 1)}</span>
                        <span class="text-[10px] font-extrabold px-1.5 py-0.5 bg-indigo-50 text-indigo-700 rounded">${q.machine_name || 'Machine'}</span>
                        <span class="text-[10px] text-slate-400 font-medium"><i class="fas fa-stopwatch text-[9px] mr-0.5"></i>${q.time_limit_s || 90}s</span>
                    </div>
                    <p class="text-xs text-slate-800 font-medium mt-1 leading-snug line-clamp-2">${q.prompt || ''}</p>
                    <p class="text-[10px] text-slate-400 font-mono mt-0.5 truncate">Ans: <span class="text-indigo-600 font-semibold">${q.answer_text || '–'}</span></p>
                </div>
                <div class="flex items-center gap-1 flex-shrink-0 pt-0.5 pl-2 border-l border-slate-100">
                    <label class="text-[10px] font-bold text-slate-500">Pts:</label>
                    <input type="number" class="manual-q-pts w-12 text-center text-xs font-bold border border-slate-200 rounded-lg px-1 py-1 focus:border-amber-500" min="1" max="100" value="${pts}" data-qid="${qid}" oninput="updateManualSummary()">
                </div>
            </div>
        `;
    }).join('');

    updateManualSummary();
}

function onManualQuestionToggle() {
    updateManualSummary();
    const cbs = document.querySelectorAll('.manual-q-cb:checked');
    if (cbs.length > 0) {
        document.getElementById('assessmentItems').value = cbs.length;
    }
    validatePoolShortage();
}

function updateManualSummary() {
    const cbs = document.querySelectorAll('.manual-q-cb:checked');
    let totalPts = 0;
    cbs.forEach(cb => {
        const qid = cb.dataset.qid;
        const ptsInp = document.querySelector(`.manual-q-pts[data-qid="${qid}"]`);
        const pts = ptsInp ? (parseInt(ptsInp.value, 10) || 1) : 1;
        totalPts += pts;
    });
    const summary = document.getElementById('manualSelectedSummary');
    if (summary) {
        summary.textContent = `${cbs.length} selected • ${totalPts} total pts`;
    }
}

let asmtInitialState = null;

function getAssessmentFormSnapshot() {
    const name = (document.getElementById('assessmentName')?.value || '').trim();
    const type = document.getElementById('assessmentType')?.value || '';
    const unlocked = document.getElementById('assessmentUnlocked')?.value || '1';
    const duration = document.getElementById('assessmentDuration')?.value || '';
    const timerType = document.getElementById('assessmentTimerType')?.value || 'Global';
    const start = document.getElementById('assessmentStart')?.value || '';
    const due = document.getElementById('assessmentDue')?.value || '';
    const items = document.getElementById('assessmentItems')?.value || '';
    const compToggle = document.getElementById('assessmentCompetitiveToggle')?.checked ? '1' : '0';
    const selectionMode = document.querySelector('input[name="question_selection_mode"]:checked')?.value || 'random';
    
    const checkedQids = Array.from(document.querySelectorAll('.manual-q-cb:checked'))
        .map(cb => cb.dataset.qid)
        .sort()
        .join(',');

    return {
        name,
        type,
        unlocked,
        duration,
        timerType,
        start,
        due,
        items,
        compToggle,
        selectionMode,
        checkedQids
    };
}

function hasUnsavedAssessmentChanges() {
    if (!asmtInitialState) return false;
    const current = getAssessmentFormSnapshot();

    if (current.name !== asmtInitialState.name) return true;
    if (current.type !== asmtInitialState.type) return true;
    if (current.unlocked !== asmtInitialState.unlocked) return true;
    if (current.duration !== asmtInitialState.duration) return true;
    if (current.timerType !== asmtInitialState.timerType) return true;
    if (current.start !== asmtInitialState.start) return true;
    if (current.due !== asmtInitialState.due) return true;
    if (current.items !== asmtInitialState.items) return true;
    if (current.compToggle !== asmtInitialState.compToggle) return true;
    if (current.selectionMode !== asmtInitialState.selectionMode) return true;
    if (current.checkedQids !== asmtInitialState.checkedQids) return true;

    return false;
}

function handleAssessmentModalClose() {
    if (hasUnsavedAssessmentChanges()) {
        openModal('asmtDiscardConfirmModal');
    } else {
        closeModal('assessmentModal');
        asmtInitialState = null;
    }
}

function confirmDiscardAssessmentChanges() {
    closeModal('asmtDiscardConfirmModal');
    closeModal('assessmentModal');
    asmtInitialState = null;
}

async function openAssessmentModal(asmtId, topicId, quarterId, defaultType) {
    const form = document.getElementById('assessmentForm');
    if (form) form.reset();
    document.getElementById('assessmentId').value = asmtId || '';
    document.getElementById('assessmentTopicId').value = topicId || '';
    document.getElementById('assessmentQuarterId').value = quarterId || '';

    // Open modal immediately so user gets instant visual feedback
    openModal('assessmentModal');

    const spinner = document.getElementById('asmtModalLoadingSpinner');
    const btnFull = document.getElementById('btnFullBuilder');
    const btnSaveText = document.getElementById('btnSaveAssessmentText');
    if (btnSaveText) {
        btnSaveText.textContent = asmtId ? 'Save Changes' : 'Save Assessment';
    }

    currentManualQuestions = [];
    currentTopicPool = { count: 0, questions: [], level_number: 1 };

    if (asmtId) {
        document.getElementById('assessmentModalTitle').textContent = `Manage Assessment (#${asmtId})`;
        if (spinner) spinner.classList.remove('hidden');
        if (btnFull) {
            btnFull.classList.remove('hidden');
            btnFull.href = '/teacher/question-bank?openAuthor=true';
        }

        try {
            const res = await fetch(`/teacher/api/assessment/${asmtId}`);
            const data = await res.json();
            if (data.success && data.assessment) {
                const a = data.assessment;
                const actualTopicId = a.topic_id || topicId;
                const actualQuarterId = a.quarter_id || quarterId;
                document.getElementById('assessmentTopicId').value = actualTopicId || '';
                document.getElementById('assessmentQuarterId').value = actualQuarterId || '';

                document.getElementById('assessmentName').value = a.assessment_name || '';
                document.getElementById('assessmentType').value = a.assessment_type || 'Pre-Test';
                document.getElementById('assessmentUnlocked').value = (a.is_unlocked === 0) ? '0' : '1';
                document.getElementById('assessmentItems').value = a.total_items || 10;
                document.getElementById('assessmentDuration').value = a.duration_minutes || 30;
                document.getElementById('assessmentTimerType').value = a.timer_type || 'Global';

                if (a.start_date) {
                    try {
                        const sd = new Date(a.start_date);
                        if (!isNaN(sd.getTime())) {
                            const pad = n => String(n).padStart(2, '0');
                            document.getElementById('assessmentStart').value = `${sd.getFullYear()}-${pad(sd.getMonth() + 1)}-${pad(sd.getDate())}T${pad(sd.getHours())}:${pad(sd.getMinutes())}`;
                        }
                    } catch(e) {}
                } else {
                    document.getElementById('assessmentStart').value = '';
                }

                if (a.due_date) {
                    try {
                        const dd = new Date(a.due_date);
                        if (!isNaN(dd.getTime())) {
                            const pad = n => String(n).padStart(2, '0');
                            document.getElementById('assessmentDue').value = `${dd.getFullYear()}-${pad(dd.getMonth() + 1)}-${pad(dd.getDate())}T${pad(dd.getHours())}:${pad(dd.getMinutes())}`;
                        }
                    } catch(e) {}
                } else {
                    document.getElementById('assessmentDue').value = '';
                }

                document.getElementById('assessmentCompetitiveToggle').checked = (a.competitive_enabled == 1 || a.assessment_type === 'Competitive');

                // Load question pool for this topic
                if (actualTopicId) {
                    await loadTopicQuestionsPool(actualTopicId);
                }

                currentManualQuestions = a.manual_questions || [];

                if (a.question_selection_mode === 'manual') {
                    const modeManualRadio = document.getElementById('modeManual');
                    if (modeManualRadio) modeManualRadio.checked = true;
                    handleSelectionModeChange('manual');
                } else {
                    const modeRandomRadio = document.getElementById('modeRandom');
                    if (modeRandomRadio) modeRandomRadio.checked = true;
                    handleSelectionModeChange('random');
                }

                renderManualQuestionsList();
                validatePoolShortage();
                asmtInitialState = getAssessmentFormSnapshot();
            } else {
                console.error('Failed to load assessment details:', data.error);
            }
        } catch (err) {
            console.error('Failed to fetch assessment details:', err);
        } finally {
            if (spinner) spinner.classList.add('hidden');
        }
    } else {
        document.getElementById('assessmentModalTitle').textContent = 'Add Assessment';
        if (spinner) spinner.classList.add('hidden');
        if (btnFull) {
            btnFull.classList.remove('hidden');
            btnFull.href = '/teacher/question-bank?openAuthor=true';
        }
        if (defaultType) {
            document.getElementById('assessmentType').value = defaultType;
            if (defaultType === 'Pre-Test') {
                document.getElementById('assessmentName').value = 'Topic Diagnostic Pre-Test';
            } else if (defaultType === 'Post-Test') {
                document.getElementById('assessmentName').value = 'Topic Summative Post-Test';
            } else if (defaultType === 'Competitive') {
                document.getElementById('assessmentName').value = 'Multiplayer Arena Duel';
                document.getElementById('assessmentCompetitiveToggle').checked = true;
            }
        }
        document.getElementById('assessmentUnlocked').value = '1';
        document.getElementById('assessmentItems').value = 10;
        document.getElementById('assessmentDuration').value = 30;

        const modeRandomRadio = document.getElementById('modeRandom');
        if (modeRandomRadio) modeRandomRadio.checked = true;
        handleSelectionModeChange('random');

        if (topicId) {
            await loadTopicQuestionsPool(topicId);
        }
        validatePoolShortage();
        asmtInitialState = getAssessmentFormSnapshot();
    }
}

function handleAssessmentTypeChange(selectEl) {
    const val = selectEl.value;
    if (val === 'Assignment') {
        const topicId = document.getElementById('assessmentTopicId').value;
        const quarterId = document.getElementById('assessmentQuarterId').value;
        const enteredName = document.getElementById('assessmentName').value;
        closeModal('assessmentModal');
        openAssignmentModal(null, topicId, quarterId);
        if (enteredName) {
            document.getElementById('asgnName').value = enteredName;
        }
        selectEl.value = 'Quiz';
        return;
    }
    const compToggle = document.getElementById('assessmentCompetitiveToggle');
    if (val === 'Competitive' && compToggle) {
        compToggle.checked = true;
    }
}

let pendingAssessmentPayload = null;

function submitAssessmentForm(event) {
    event.preventDefault();
    const asmtId = document.getElementById('assessmentId').value;
    const topicId = document.getElementById('assessmentTopicId').value;
    const quarterId = document.getElementById('assessmentQuarterId').value;
    const name = document.getElementById('assessmentName').value.trim();
    const type = document.getElementById('assessmentType').value;
    const items = parseInt(document.getElementById('assessmentItems').value, 10) || 10;
    const duration = parseInt(document.getElementById('assessmentDuration').value, 10) || 30;
    const timerType = document.getElementById('assessmentTimerType').value;
    const isUnlocked = parseInt(document.getElementById('assessmentUnlocked').value, 10);
    const startDate = document.getElementById('assessmentStart').value || null;
    const dueDate = document.getElementById('assessmentDue').value || null;
    const competitiveEnabled = document.getElementById('assessmentCompetitiveToggle').checked ? 1 : 0;

    if (!name) {
        cmToast('Assessment title is required.', 'error');
        document.getElementById('assessmentName')?.focus();
        return;
    }

    const selectionMode = document.querySelector('input[name="question_selection_mode"]:checked')?.value || 'random';
    let selectedQuestions = [];
    if (selectionMode === 'manual') {
        const cbs = document.querySelectorAll('.manual-q-cb:checked');
        cbs.forEach((cb, idx) => {
            const qid = cb.dataset.qid;
            const ptsInp = document.querySelector(`.manual-q-pts[data-qid="${qid}"]`);
            const pts = ptsInp ? (parseInt(ptsInp.value, 10) || 1) : 1;
            selectedQuestions.push({
                question_id: qid,
                sort_order: idx + 1,
                custom_points: pts
            });
        });
        if (selectedQuestions.length === 0) {
            cmToast('Please select at least one question in Manual Selection mode, or choose Random Pool.', 'warning');
            return;
        }
    }

    pendingAssessmentPayload = {
        asmtId,
        url: asmtId ? `/teacher/api/assessment/${asmtId}` : '/teacher/api/assessment',
        method: asmtId ? 'PUT' : 'POST',
        payload: {
            topic_id: topicId,
            quarter_id: quarterId,
            assessment_name: name,
            assessment_type: type,
            total_items: selectionMode === 'manual' ? selectedQuestions.length : items,
            duration_minutes: duration,
            timer_type: timerType,
            is_unlocked: isUnlocked,
            start_date: startDate,
            due_date: dueDate,
            competitive_enabled: (type === 'Competitive' || competitiveEnabled) ? 1 : 0,
            question_selection_mode: selectionMode,
            selected_questions: selectedQuestions
        }
    };

    // Populate Save Confirmation Modal summary fields
    const isEdit = !!asmtId;
    const titleEl = document.getElementById('asmtSaveConfirmTitle');
    const subTitleEl = document.getElementById('asmtSaveConfirmSubtitle');
    const msgEl = document.getElementById('asmtSaveConfirmMsg');
    const executeBtnText = document.getElementById('asmtExecuteSaveBtnText');

    if (titleEl) titleEl.textContent = isEdit ? 'Confirm Assessment Changes' : 'Confirm New Assessment';
    if (subTitleEl) subTitleEl.textContent = isEdit ? 'Please review your updates before saving' : 'Please review assessment settings before creating';
    if (msgEl) msgEl.textContent = isEdit ? 'Are you sure you want to finalize and save these changes?' : 'Are you sure you want to create this assessment?';
    if (executeBtnText) executeBtnText.textContent = isEdit ? 'Yes, Save Changes' : 'Yes, Create Assessment';

    document.getElementById('asmtConfirmName').textContent = name;
    document.getElementById('asmtConfirmType').textContent = type;
    document.getElementById('asmtConfirmAccess').innerHTML = isUnlocked === 1 ? '<span class="text-emerald-600 font-semibold">🟢 Open / Unlocked</span>' : '<span class="text-rose-600 font-semibold">🔒 Locked</span>';
    document.getElementById('asmtConfirmItemsDuration').textContent = `${selectionMode === 'manual' ? selectedQuestions.length : items} items • ${duration} mins (${timerType})`;
    document.getElementById('asmtConfirmSelectionMode').textContent = selectionMode === 'manual' ? `Manual (${selectedQuestions.length} selected)` : 'Random Topic Pool';

    const scheduleRow = document.getElementById('asmtConfirmScheduleRow');
    const scheduleEl = document.getElementById('asmtConfirmSchedule');
    if (startDate || dueDate) {
        if (scheduleRow) scheduleRow.style.display = 'flex';
        let schText = '';
        if (startDate) schText += `Opens: ${startDate.replace('T', ' ')}`;
        if (dueDate) schText += `${schText ? ' | ' : ''}Due: ${dueDate.replace('T', ' ')}`;
        if (scheduleEl) scheduleEl.textContent = schText;
    } else {
        if (scheduleRow) scheduleRow.style.display = 'none';
    }

    openModal('asmtSaveConfirmModal');
}

async function confirmExecuteAssessmentSave() {
    if (!pendingAssessmentPayload) return;

    const btn = document.getElementById('asmtExecuteSaveBtn');
    const origHtml = btn ? btn.innerHTML : '';
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin text-sm"></i> Saving...';
    }

    try {
        const res = await fetch(pendingAssessmentPayload.url, {
            method: pendingAssessmentPayload.method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(pendingAssessmentPayload.payload)
        });

        const data = await res.json();
        if (data.success || data.assessment_id) {
            const savedTopicId = pendingAssessmentPayload.payload?.topic_id;
            const savedQuarterId = pendingAssessmentPayload.payload?.quarter_id;
            const wasEdit = !!pendingAssessmentPayload.asmtId;
            closeModal('asmtSaveConfirmModal');
            closeModal('assessmentModal');
            asmtInitialState = null;
            pendingAssessmentPayload = null;

            cmToast(wasEdit ? 'Assessment updated successfully!' : 'Assessment created successfully!', 'success');
            await refreshClassViewContent({
                ensureQuarterOpen: savedQuarterId,
                ensureTopicOpen: savedTopicId,
                ensureSubTab: 'assessments'
            });
        } else {
            cmToast(data.error || 'Failed to save assessment', 'error');
        }
    } catch (err) {
        console.error('Save assessment error:', err);
        cmToast('Network error while saving assessment. Please try again.', 'error');
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = origHtml;
        }
    }
}



