                                Close
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ======= STUDENT DETAILED SCORES & TOPIC PERFORMANCE MODAL ======= -->
                <div class="modal-backdrop" id="studentScoresModal" style="z-index: 310;">
                    <div class="modal-card" style="max-width: 980px; width: 100%; max-height: 92vh; display: flex; flex-direction: column;">
                        <!-- Modal Header -->
                        <div class="modal-header border-b border-slate-100 p-4 sm:p-5 flex items-center justify-between bg-white flex-shrink-0">
