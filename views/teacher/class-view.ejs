function getSelectedAudiencePool() {
    const audRadio = document.querySelector('input[name="target_audience"]:checked');
    const mode = audRadio ? audRadio.value : 'class';
    if (mode === 'students') {
        const checkedIds = new Set(Array.from(document.querySelectorAll('.asgn-std-cb:checked')).map(cb => Number(cb.value)));
        const selectedStudents = classStudentsRoster.filter(s => checkedIds.has(s.user_id));
        return {
            mode: 'students',
            list: selectedStudents,
            count: selectedStudents.length
        };
    }
    return {
        mode: 'class',
        list: classStudentsRoster,
        count: classStudentsRoster.length
    };
}

function onAudienceStudentsChanged() {
    const count = document.querySelectorAll('.asgn-std-cb:checked').length;
    const badge = document.getElementById('groupSetAudienceBadge');
    if (badge && document.querySelector('input[name="target_audience"]:checked')?.value === 'students') {
        badge.textContent = `${count} Students Detected`;
    }
}

function toggleAudienceSelection(type) {
    const stdWrap = document.getElementById('asgnStudentsWrap');
    if (stdWrap) stdWrap.classList.toggle('hidden', type !== 'students');
}

function filterAudienceStudents(query) {
    const q = (query || '').toLowerCase().trim();
