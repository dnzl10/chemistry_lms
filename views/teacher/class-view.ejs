/* ── Tab switching ── */
function switchCalTab(name, btn) {
    document.querySelectorAll('#calTabs .cal-tab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.cal-panel').forEach(p => p.classList.remove('active'));
