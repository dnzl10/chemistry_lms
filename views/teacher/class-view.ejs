async function editAssignmentModal(asgnId, topicId, quarterId) {
    try {
        const res = await fetch('/teacher/api/assignment/' + asgnId);
        const data = await res.json();
        if (!data.success) throw new Error(data.error || 'Failed to load assignment');
        const a = data.assignment;

        document.getElementById('assignmentModalTitle').textContent = 'Edit Assignment';
        document.getElementById('asgnId').value = a.assessment_id;
        document.getElementById('asgnTopicId').value = a.topic_id || topicId || '';
        document.getElementById('asgnQuarterId').value = a.quarter_id || quarterId || '';
        document.getElementById('asgnName').value = a.assessment_name || '';
        document.getElementById('asgnCategory').value = a.category || 'Homework';
        document.getElementById('asgnItems').value = a.total_items || 100;
        document.getElementById('asgnDue').value = a.due_date ? new Date(a.due_date).toISOString().slice(0, 16) : '';

        // Pedagogical blueprint
        document.getElementById('asgnObjectives').value = a.objectives || '';
        document.getElementById('asgnDescription').value = a.description || '';
        document.getElementById('asgnGuidelines').value = a.guidelines || '';

        // File links
        document.getElementById('asgnFormatFile').value = '';
        document.getElementById('asgnSampleOutput').value = '';
        if (a.format_file_path) {
            document.getElementById('asgnExistingFormatWrap').classList.remove('hidden');
            const flink = document.getElementById('asgnExistingFormatLink');
            flink.href = a.format_file_path;
            flink.textContent = a.format_file_path.split('/').pop();
        } else {
            document.getElementById('asgnExistingFormatWrap').classList.add('hidden');
        }

        if (a.sample_output_path) {
            document.getElementById('asgnExistingSampleWrap').classList.remove('hidden');
            const slink = document.getElementById('asgnExistingSampleLink');
            slink.href = a.sample_output_path;
            slink.textContent = a.sample_output_path.split('/').pop();
        } else {
            document.getElementById('asgnExistingSampleWrap').classList.add('hidden');
        }

        // Allowed extensions
        const allowed = (a.allowed_file_types || '.pdf,.docx').toLowerCase().split(',').map(s => s.trim());
        document.querySelectorAll('.asgn-ext-cb').forEach(cb => {
            cb.checked = allowed.includes(cb.value.toLowerCase());
        });
        document.getElementById('asgnMaxFileSize').value = a.max_file_size_mb || 20;

        // Target audience
        const aud = (a.target_audience === 'students') ? 'students' : 'class';
        const audRadio = document.querySelector(`input[name="target_audience"][value="${aud}"]`);
        if (audRadio) audRadio.checked = true;
        toggleAudienceSelection(aud);

        const stdSet = new Set((data.audienceStudents || []).map(s => String(s)));
        document.querySelectorAll('.asgn-std-cb').forEach(cb => {
            cb.checked = stdSet.has(String(cb.value));
        });
        document.getElementById('asgnStudentFilter').value = '';
        filterAudienceStudents('');

        // Group settings
        const isGroup = a.is_group_assignment == 1;
        document.getElementById('asgnIsGroup').checked = isGroup;
        toggleGroupAssignmentFields(isGroup);
        if (isGroup) {
            loadGroupSetsDropdown(a.group_set_id);
            const subPolVal = a.group_submission_mode || a.group_submission_policy || 'one_per_group';
            const subPolRadio = document.querySelector(`input[name="group_submission_policy"][value="${subPolVal}"]`);
            if (subPolRadio) subPolRadio.checked = true;
            const gradModeVal = a.group_grading_mode || a.group_grading_policy || 'shared_grade';
            document.getElementById('asgnGroupGrading').checked = (gradModeVal !== 'individual_grade' && gradModeVal !== 'individual');
        }

        // Resubmission policy
        const allowResub = a.allow_resubmissions == 1;
        document.getElementById('asgnAllowResubmit').checked = allowResub;
        toggleResubmitInput(allowResub);
        document.getElementById('asgnMaxAttempts').value = a.max_attempts || 3;

        // Grace buffer
        document.getElementById('asgnAllowGrace').checked = a.allow_grace == 1;
        toggleGraceInput(a.allow_grace == 1);
        document.getElementById('asgnGraceMinutes').value = a.grace_period_minutes || 5;

        // Diagnostics
        document.getElementById('asgnMinWords').value = a.min_word_count || '';
        document.getElementById('asgnMaxWords').value = a.max_word_count || '';
        document.getElementById('asgnDisallowBlank').checked = a.disallow_blank_pages == 1;

        // Rubric
        document.getElementById('asgnRubricTitle').value = a.rubric_title || '';
        const list = document.getElementById('asgnRubricCriteriaList');
        list.innerHTML = '';
        if (a.criteria && a.criteria.length > 0) {
            a.criteria.forEach(c => addRubricCriterionRow(c.title, c.description, c.max_points));
        }

        captureAssignmentInitialState();
        openModal('assignmentModal');
        setTimeout(autoResizeAllAsgnFields, 40);
    } catch (err) {
        cmToast('Error: ' + err.message, 'error');
    }
}

function toggleGraceInput(enabled) {
    const wrap = document.getElementById('asgnGraceMinutesWrapper');
    if (wrap) wrap.style.opacity = enabled ? '1' : '0.4';
    const inp = document.getElementById('asgnGraceMinutes');
    if (inp) inp.disabled = !enabled;
}

function addRubricCriterionRow(title = '', desc = '', points = 10) {
    const list = document.getElementById('asgnRubricCriteriaList');
    const rowId = 'crit-' + Date.now() + '-' + Math.floor(Math.random() * 1000);
    const div = document.createElement('div');
    div.id = rowId;
    div.className = 'p-2.5 rounded-lg bg-white border border-slate-200 text-xs space-y-1.5 shadow-sm';
    div.innerHTML = `
        <div class="flex items-center gap-2">
            <input type="text" class="form-input text-xs flex-1 font-semibold criterion-title" placeholder="Criterion title (e.g. Chemical Analysis)" value="${(title || '').replace(/"/g, '&quot;')}" required>
            <div class="flex items-center gap-1 w-24">
                <input type="number" class="form-input text-xs w-16 text-center font-bold criterion-points" min="1" max="1000" value="${points || 10}" placeholder="Pts" required>
                <span class="text-[10px] text-slate-500 font-bold">pts</span>
            </div>
            <button type="button" onclick="document.getElementById('${rowId}').remove()" class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 transition">
                <i class="fas fa-trash text-xs"></i>
            </button>
        </div>
        <textarea class="form-input text-[11px] w-full criterion-desc" rows="1" placeholder="Scoring guidance or descriptive expectations">${desc || ''}</textarea>
    `;
    list.appendChild(div);
}

async function submitAssignmentForm(e) {
    e.preventDefault();
    const form = e.target;
    if (!form.checkValidity()) {
        form.reportValidity();
        return;
    }

    const isGroupAsgn = document.getElementById('asgnIsGroup')?.checked;
    if (isGroupAsgn) {
        const pickerVal = document.getElementById('asgnGroupSetPicker')?.value || document.getElementById('asgnGroupSetId')?.value;
        if (!pickerVal) {
            cmToast('Please select or generate a Group Set for this group assignment.', 'error');
            return;
        }
    }

    // Populate confirmation modal preview details
    const nameVal = document.getElementById('asgnName')?.value || 'Untitled Assignment';
    const catVal = document.getElementById('asgnCategory')?.value || 'Homework';
    const ptsVal = document.getElementById('asgnItems')?.value || '100';
    const dueVal = document.getElementById('asgnDue')?.value;
    const isEdit = !!document.getElementById('asgnId')?.value;

    const titleEl = document.getElementById('asgnSaveConfirmTitle');
    if (titleEl) titleEl.textContent = isEdit ? 'Confirm Update Assignment' : 'Confirm New Assignment';
    const subTitleEl = document.getElementById('asgnSaveConfirmSubtitle');
    if (subTitleEl) subTitleEl.textContent = isEdit ? 'Please review your changes before saving' : 'Please review before publishing assignment';
    const msgEl = document.getElementById('asgnSaveConfirmMsg');
    if (msgEl) msgEl.textContent = isEdit 
        ? 'Are you sure you want to finalize and save the changes to this assignment?' 
        : 'Are you sure you want to create and save this assignment?';

    const confirmName = document.getElementById('asgnConfirmName');
    if (confirmName) confirmName.textContent = nameVal;
    const confirmCat = document.getElementById('asgnConfirmCategory');
    if (confirmCat) confirmCat.textContent = catVal;
    const confirmPts = document.getElementById('asgnConfirmPoints');
    if (confirmPts) confirmPts.textContent = ptsVal + ' pts';
    const confirmDue = document.getElementById('asgnConfirmDue');
    if (confirmDue) {
        confirmDue.textContent = dueVal ? new Date(dueVal).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'No Due Date (Open)';
    }
    const confirmGroup = document.getElementById('asgnConfirmGroupMode');
    if (confirmGroup) confirmGroup.textContent = isGroupAsgn ? 'Group Assignment' : 'Individual Submission';

    const saveBtnText = document.getElementById('asgnExecuteSaveBtnText');
    if (saveBtnText) saveBtnText.textContent = isEdit ? 'Yes, Update Assignment' : 'Yes, Save Assignment';

    pendingAssignmentFormData = new FormData(form);
    openModal('asgnSaveConfirmModal');
}

async function confirmExecuteAssignmentSave() {
    if (!pendingAssignmentFormData) return;

    const btn = document.getElementById('asgnExecuteSaveBtn');
    const origHtml = btn ? btn.innerHTML : '';
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i> Saving...';
    }

    const fd = pendingAssignmentFormData;
    const id = fd.get('assignment_id');
    const url = id ? '/teacher/api/assignment/' + id : '/teacher/api/assignment';
    const method = id ? 'PUT' : 'POST';

    // Collect allowed extensions
    const selectedExts = [];
    document.querySelectorAll('.asgn-ext-cb:checked').forEach(cb => selectedExts.push(cb.value));
    fd.set('allowed_file_types', selectedExts.join(', '));

    // Collect audience targets
    const aud = fd.get('target_audience') || 'class';
    if (aud === 'students') {
        const students = [];
        document.querySelectorAll('.asgn-std-cb:checked').forEach(cb => students.push(cb.value));
        fd.set('audience_students', JSON.stringify(students));
    }

    // Collect group selection
    const selectedGroupIds = [];
    document.querySelectorAll('.asgn-group-item-cb:checked').forEach(cb => selectedGroupIds.push(cb.value));
    fd.set('selected_group_ids', JSON.stringify(selectedGroupIds));

    // Collect rubric criteria
    const criteria = [];
    document.querySelectorAll('#asgnRubricCriteriaList > div').forEach(row => {
        const title = row.querySelector('.criterion-title')?.value?.trim();
        const desc = row.querySelector('.criterion-desc')?.value?.trim();
        const maxPts = parseInt(row.querySelector('.criterion-points')?.value) || 10;
        if (title) {
            criteria.push({ title, description: desc, max_points: maxPts });
        }
    });
    fd.set('rubric_criteria', JSON.stringify(criteria));

    // Handle boolean checkboxes
    if (!fd.has('allow_grace')) fd.set('allow_grace', '0');
    if (!fd.has('disallow_blank_pages')) fd.set('disallow_blank_pages', '0');
    if (!fd.has('allow_resubmissions')) fd.set('allow_resubmissions', '0');

    // Handle group assignment payload
    const isGroupAsgn = document.getElementById('asgnIsGroup')?.checked;
    if (isGroupAsgn) {
        fd.set('is_group_assignment', '1');
        const pickerVal = document.getElementById('asgnGroupSetPicker')?.value || document.getElementById('asgnGroupSetId')?.value;
        fd.set('group_set_id', pickerVal);
        const subPol = document.querySelector('input[name="group_submission_policy"]:checked')?.value || 'one_per_group';
        fd.set('group_submission_mode', subPol);
        fd.set('group_submission_policy', subPol);
        const isShared = document.getElementById('asgnGroupGrading')?.checked !== false;
        fd.set('group_grading_mode', isShared ? 'shared_grade' : 'individual_grade');
        fd.set('group_grading_policy', isShared ? 'shared' : 'individual');
    } else {
        fd.set('is_group_assignment', '0');
        fd.set('group_set_id', '');
    }

    try {
        const res = await fetch(url, {
            method,
            body: fd
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to save assignment');

        const savedTopicId = fd.get('topic_id');
        closeModal('asgnSaveConfirmModal');
        closeModal('assignmentModal');
        asgnInitialState = null;
        pendingAssignmentFormData = null;
        cmToast('Assignment saved successfully!', 'success');
        await refreshClassViewContent({ ensureTopicOpen: savedTopicId, ensureSubTab: 'assignments' });
    } catch (err) {
        cmToast('Failed to save assignment: ' + err.message, 'error');
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = origHtml;
        }
    }
}

async function submitAnnouncementForm(e) {
    e.preventDefault();
    const form = e.target;
    const fd  = new FormData(form);
    const rawId = fd.get('announcement_id');
    const id = (rawId && rawId.trim() !== '' && rawId !== 'null' && rawId !== 'undefined') ? rawId.trim() : null;
    const isEdit = Boolean(id);
    const url = isEdit ? '/teacher/api/announcement/' + id : '/teacher/api/announcement';
    const method = isEdit ? 'PUT' : 'POST';

    // Ensure boolean checkboxes exist in FormData
    if (!fd.has('is_priority')) fd.set('is_priority', '0');
    if (!fd.has('is_critical')) fd.set('is_critical', '0');
    if (!fd.has('forward_webhook')) fd.set('forward_webhook', '0');

    const submitBtn = form.querySelector('button[type="submit"]') || document.getElementById('announcementSubmitBtn');
    const origBtnHtml = submitBtn ? submitBtn.innerHTML : '';
    if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = `<i class="fas fa-spinner fa-spin text-sm mr-1"></i> ${isEdit ? 'Updating…' : 'Publishing…'}`;
    }

    const targetRow = isEdit ? document.getElementById('ann-row-' + id) : null;
    if (targetRow) {
        targetRow.classList.add('opacity-50', 'transition-opacity');
    }

    try {
        const res = await fetch(url, { method, body: fd });
        if (!res.ok) {
            const errData = await res.json().catch(() => ({}));
            throw new Error(errData.error || errData.message || 'Server returned ' + res.status);
        }
        const data = await res.json().catch(() => ({}));

        const titleVal = (fd.get('title') || '').toString().trim();
        const contentVal = (fd.get('content') || '').toString().trim();
        const isPriorityVal = fd.get('is_priority') === '1' ? 1 : 0;
        const isCriticalVal = fd.get('is_critical') === '1' ? 1 : 0;
        const dueDateVal = (fd.get('due_date') || '').toString();
        const removeAttVal = fd.get('remove_attachment') === '1';

        let attUrl = null;
        let attName = null;
        if (data.attachment_url) {
            attUrl = data.attachment_url;
            attName = data.attachment_name || attUrl.split('/').pop();
        } else if (isEdit && !removeAttVal) {
            const cached = window.getAnnData(id);
            if (cached && cached.attachment_url) {
                attUrl = cached.attachment_url;
                attName = cached.attachment_name;
            }
        }

        const annId = isEdit ? Number(id) : Number(data.announcement_id || Date.now());
        const teacherName = '<%= (user.first_name || "") + " " + (user.last_name || "") %>'.trim() || 'Instructor';

        const updatedAnn = {
            announcement_id: annId,
            class_id: <%= classInfo.class_id %>,
            title: titleVal,
            content: contentVal,
            is_priority: isPriorityVal,
            is_critical: isCriticalVal,
            due_date: dueDateVal || null,
            attachment_url: attUrl,
            attachment_name: attName,
            scope: 'class',
            author_name: teacherName,
            created_at: isEdit && window.getAnnData(id)?.created_at ? window.getAnnData(id).created_at : new Date().toISOString()
        };

        window.announcementsCache = window.announcementsCache || {};
        window.announcementsCache[annId] = updatedAnn;

        closeModal('announcementModal');
        form.reset();
        document.getElementById('announcementId').value = '';

        if (isEdit) {
            if (targetRow) {
                targetRow.classList.remove('opacity-50');
                const currentIndex = targetRow.querySelector('.ann-index-cell')?.textContent || '1';
                const tempDiv = document.createElement('tbody');
                tempDiv.innerHTML = buildAnnouncementRowHtml(updatedAnn, currentIndex);
                const newRowElem = tempDiv.firstElementChild;
                if (newRowElem) {
                    targetRow.replaceWith(newRowElem);
                    newRowElem.classList.add('bg-blue-50/70', 'transition-colors', 'duration-500');
                    setTimeout(() => newRowElem.classList.remove('bg-blue-50/70'), 1500);
                }
            }
            cmToast('Announcement updated successfully.', 'success');
        } else {
            appendAnnouncementRow(updatedAnn);
            cmToast('Announcement published successfully.', 'success');
        }
    } catch(e) {
        cmToast('Failed to save announcement: ' + e.message, 'error');
        if (targetRow) targetRow.classList.remove('opacity-50');
    } finally {
        if (submitBtn) {
            submitBtn.disabled = false;
            submitBtn.innerHTML = origBtnHtml;
        }
    }
}

