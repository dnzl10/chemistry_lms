                                    <div>
                                        <label class="form-label text-[11px]">Execution Guidelines &amp; Step-by-Step Instructions</label>
                                        <textarea id="asgnGuidelines" name="guidelines" class="form-textarea text-xs asgn-autofit-field" rows="3" style="resize:none; overflow:hidden; min-height:72px;" oninput="autoResizeAsgnField(this)" placeholder="1. Formulate hypothesis&#10;2. Record observations in table&#10;3. Format deliverable per APA guidelines..."></textarea>
                                    </div>
                                </div>

                                <!-- ── Section 3: Teacher Templates & Exemplar Files ── -->
                                <div class="p-3.5 rounded-xl bg-teal-50/50 border border-teal-200/70 space-y-3">
                                    <div class="flex items-center gap-2">
                                        <i class="fas fa-folder-open text-teal-600"></i>
                                        <span class="text-xs font-bold text-teal-900 uppercase tracking-wider">Templates &amp; Exemplar Files</span>
                                    </div>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                        <div>
                                            <label class="form-label text-[11px]">Downloadable Format File / Worksheet <span class="text-slate-400 font-normal">(Template for students)</span></label>
                                            <input type="file" id="asgnFormatFile" name="format_file" class="form-input text-xs" accept=".pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.zip">
                                            <div id="asgnExistingFormatWrap" class="hidden mt-1.5 p-2 rounded-lg bg-teal-100/60 border border-teal-200 flex items-center justify-between text-[11px]">
                                                <div class="flex items-center gap-1.5 truncate">
                                                    <i class="fas fa-file text-teal-700"></i>
                                                    <a id="asgnExistingFormatLink" href="#" target="_blank" download class="font-bold text-teal-800 hover:underline truncate">Current Template</a>
                                                </div>
                                                <span class="text-[10px] text-teal-600 font-bold uppercase tracking-wider">Uploaded</span>
                                            </div>
                                        </div>
                                        <div>
                                            <label class="form-label text-[11px]">Sample Output / Exemplar <span class="text-slate-400 font-normal">(Model output for reference)</span></label>
                                            <input type="file" id="asgnSampleOutput" name="sample_file" class="form-input text-xs" accept=".pdf,.doc,.docx,.png,.jpg,.jpeg,.webp">
                                            <div id="asgnExistingSampleWrap" class="hidden mt-1.5 p-2 rounded-lg bg-pink-100/60 border border-pink-200 flex items-center justify-between text-[11px]">
                                                <div class="flex items-center gap-1.5 truncate">
                                                    <i class="fas fa-file-circle-check text-pink-700"></i>
                                                    <a id="asgnExistingSampleLink" href="#" target="_blank" download class="font-bold text-pink-800 hover:underline truncate">Current Exemplar</a>
                                                </div>
                                                <span class="text-[10px] text-pink-600 font-bold uppercase tracking-wider">Uploaded</span>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ── Section 4: Allowed File Types & Max Size ── -->
                                <div class="p-3.5 rounded-xl bg-indigo-50/50 border border-indigo-200/70 space-y-3">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-shield-halved text-indigo-600"></i>
                                            <span class="text-xs font-bold text-indigo-900 uppercase tracking-wider">Deliverable Restrictions</span>
                                        </div>
                                        <div class="flex items-center gap-1.5">
                                            <label class="text-[11px] font-bold text-indigo-900">Max File Size:</label>
                                            <input type="number" id="asgnMaxFileSize" name="max_file_size_mb" class="form-input text-xs w-16 text-center font-bold" min="1" max="100" value="20">
                                            <span class="text-xs text-indigo-800 font-bold">MB</span>
                                        </div>
                                    </div>
                                    <div>
                                        <p class="text-[11px] text-indigo-700 mb-1.5 font-semibold">Allowed Submission File Extensions:</p>
                                        <div class="flex flex-wrap gap-2 text-xs" id="asgnAllowedExtWrap">
                                            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-indigo-200 cursor-pointer font-bold text-indigo-900">
                                                <input type="checkbox" class="asgn-ext-cb accent-indigo-600" value=".pdf" checked> .pdf
                                            </label>
                                            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-indigo-200 cursor-pointer font-bold text-indigo-900">
                                                <input type="checkbox" class="asgn-ext-cb accent-indigo-600" value=".docx" checked> .docx
                                            </label>
                                            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-indigo-200 cursor-pointer font-bold text-indigo-900">
                                                <input type="checkbox" class="asgn-ext-cb accent-indigo-600" value=".doc"> .doc
                                            </label>
                                            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-indigo-200 cursor-pointer font-bold text-indigo-900">
                                                <input type="checkbox" class="asgn-ext-cb accent-indigo-600" value=".zip"> .zip
                                            </label>
                                            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-indigo-200 cursor-pointer font-bold text-indigo-900">
                                                <input type="checkbox" class="asgn-ext-cb accent-indigo-600" value=".png"> .png
                                            </label>
                                            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-indigo-200 cursor-pointer font-bold text-indigo-900">
                                                <input type="checkbox" class="asgn-ext-cb accent-indigo-600" value=".jpg"> .jpg
                                            </label>
                                            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-indigo-200 cursor-pointer font-bold text-indigo-900">
                                                <input type="checkbox" class="asgn-ext-cb accent-indigo-600" value=".xlsx"> .xlsx
                                            </label>
                                            <label class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-indigo-200 cursor-pointer font-bold text-indigo-900">
                                                <input type="checkbox" class="asgn-ext-cb accent-indigo-600" value=".pptx"> .pptx
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- ── Section 5: Target Audience Distribution ── -->
                                <div class="p-3.5 rounded-xl bg-violet-50/50 border border-violet-200/70 space-y-3">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-users-viewfinder text-violet-600"></i>
                                            <span class="text-xs font-bold text-violet-900 uppercase tracking-wider">Target Audience Distribution</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-4 text-xs font-semibold text-violet-900">
                                        <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                            <input type="radio" name="target_audience" value="class" checked onchange="toggleAudienceSelection(this.value)" class="accent-violet-600">
                                            <span>Entire Class</span>
                                        </label>
                                        <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                            <input type="radio" name="target_audience" value="students" onchange="toggleAudienceSelection(this.value)" class="accent-violet-600">
                                            <span>Individual Students</span>
                                        </label>
                                    </div>

                                    <!-- Individual Students Selector -->
                                    <div id="asgnStudentsWrap" class="hidden pt-2 border-t border-violet-200/60 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <p class="text-[11px] text-violet-700 font-bold">Select Specific Students:</p>
                                            <input type="text" id="asgnStudentFilter" placeholder="Quick search..." oninput="filterAudienceStudents(this.value)" class="text-[11px] px-2 py-0.5 rounded border border-violet-200 bg-white">
                                        </div>
                                        <div id="asgnStudentList" class="max-h-32 overflow-y-auto space-y-1 p-2 rounded-lg bg-white border border-violet-200">
                                            <% (students || []).forEach(function(std){ %>
                                            <label class="asgn-student-item flex items-center justify-between p-1 rounded hover:bg-violet-50 text-xs cursor-pointer" data-name="<%= (std.first_name + ' ' + std.last_name + ' ' + (std.lrn || '')).toLowerCase() %>">
                                                <div class="flex items-center gap-2 truncate">
                                                    <input type="checkbox" class="asgn-std-cb accent-violet-600" value="<%= std.user_id %>" onchange="onAudienceStudentsChanged()">
                                                    <span class="font-semibold text-slate-700 truncate"><%= std.first_name %> <%= std.last_name %></span>
                                                </div>
                                                <span class="text-[10px] text-slate-400 font-mono"><%= std.section || 'N/A' %></span>
                                            </label>
                                            <% }); %>
                                        </div>
                                    </div>
                                </div>

                                <!-- ── Section 6: Group Assignment Collaboration ── -->
                                <div class="p-3.5 rounded-xl bg-blue-50/50 border border-blue-200/70 space-y-3">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-users-rectangle text-blue-600"></i>
                                            <span class="text-xs font-bold text-blue-900 uppercase tracking-wider">Group Assignment Settings</span>
                                        </div>
                                        <label class="inline-flex items-center gap-2 cursor-pointer">
                                            <input type="checkbox" id="asgnIsGroup" name="is_group_assignment" value="1" onchange="toggleGroupAssignmentFields(this.checked)" class="rounded border-blue-300 text-blue-600 focus:ring-blue-500">
                                            <span class="text-xs font-bold text-blue-900">Enable Group Assignment</span>
                                        </label>
                                    </div>

                                    <div id="asgnGroupFields" class="hidden space-y-3 pt-2 border-t border-blue-200/60">
                                        <div class="flex items-center gap-2">
                                            <div class="flex-1">
                                                <label class="form-label text-[11px]">Select Group Set</label>
                                                <select id="asgnGroupSetPicker" name="group_set_id" class="form-select text-xs" onchange="onGroupSetPickerChange(this.value)">
                                                    <option value="">-- Choose Group Set --</option>
                                                </select>
                                                <input type="hidden" id="asgnGroupSetId" value="">
                                            </div>
                                            <div class="pt-4">
                                                <button type="button" onclick="openGroupSetModal()" class="px-3 py-2 rounded-lg bg-blue-600 text-white font-bold text-xs hover:bg-blue-700 transition flex items-center gap-1.5 shadow-sm">
                                                    <i class="fas fa-users-gear text-xs"></i> Manage Group Sets
                                                </button>
                                            </div>
                                        </div>

                                        <!-- Groups Checkboxes Section -->
                                        <div class="rounded-xl border border-blue-200 bg-white p-3 space-y-2">
                                            <div class="flex items-center justify-between pb-2 border-b border-blue-100">
                                                <label class="inline-flex items-center gap-2 cursor-pointer text-xs font-bold text-blue-900">
                                                    <input type="checkbox" id="asgnSelectAllGroups" onchange="toggleSelectAllGroups(this.checked)" class="accent-blue-600" checked>
                                                    <span>All Groups</span>
                                                </label>
                                                <span id="asgnSelectedGroupsCount" class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-blue-50 text-blue-700 border border-blue-200">
                                                    0 groups selected
                                                </span>
                                            </div>
                                            <div id="asgnGroupCheckboxList" class="max-h-40 overflow-y-auto space-y-1.5 pr-1 text-xs">
                                                <div class="text-center py-3 text-slate-400 italic text-[11px]">No group set selected. Choose a group set above or create one.</div>
                                            </div>
                                        </div>

                                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 pt-1">
                                            <div>
                                                <label class="form-label text-[11px]">Submission Policy</label>
                                                <div class="space-y-1.5 text-xs text-blue-900">
                                                    <label class="flex items-center gap-1.5 cursor-pointer">
                                                        <input type="radio" name="group_submission_policy" value="one_per_group" checked class="accent-blue-600">
                                                        <span>One submission per group</span>
                                                    </label>
                                                    <label class="flex items-center gap-1.5 cursor-pointer">
                                                        <input type="radio" name="group_submission_policy" value="individual_submissions" class="accent-blue-600">
                                                        <span>Individual submissions</span>
                                                    </label>
                                                </div>
                                            </div>
                                            <div>
                                                <label class="form-label text-[11px]">Grading Policy</label>
                                                <label class="flex items-center gap-1.5 cursor-pointer text-xs text-blue-900 mt-2">
                                                    <input type="checkbox" id="asgnGroupGrading" name="group_grading_policy" value="1" checked class="rounded border-blue-300 text-blue-600 focus:ring-blue-500">
                                                    <span class="font-bold">Sync grades to all group members</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- ── Section 7: Resubmissions & Grace Buffer ── -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                                    <!-- Resubmission Policy -->
                                    <div class="p-3.5 rounded-xl bg-emerald-50/60 border border-emerald-200/80 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-2">
                                                <i class="fas fa-rotate text-emerald-600"></i>
                                                <span class="text-xs font-bold text-emerald-900 uppercase tracking-wider">Resubmission Policy</span>
                                            </div>
                                            <label class="inline-flex items-center gap-2 cursor-pointer">
                                                <input type="checkbox" id="asgnAllowResubmit" name="allow_resubmissions" value="1" onchange="toggleResubmitInput(this.checked)" class="rounded border-emerald-300 text-emerald-600 focus:ring-emerald-500">
                                                <span class="text-xs font-bold text-emerald-800">Allow Resubmissions</span>
                                            </label>
                                        </div>
                                        <div id="asgnMaxAttemptsWrap" class="flex items-center gap-2 opacity-40">
                                            <span class="text-[11px] text-emerald-700">Max Attempts:</span>
                                            <input type="number" id="asgnMaxAttempts" name="max_attempts" class="form-input text-xs w-16 text-center font-bold" min="1" max="10" value="3" disabled>
                                            <span class="text-[11px] text-emerald-600 font-medium">(1 = single try)</span>
                                        </div>
                                    </div>

                                    <!-- Grace Buffer Policy -->
                                    <div class="p-3.5 rounded-xl bg-amber-50/60 border border-amber-200/80 space-y-2">
                                        <div class="flex items-center justify-between">
                                            <div class="flex items-center gap-2">
                                                <i class="fas fa-stopwatch text-amber-600"></i>
                                                <span class="text-xs font-bold text-amber-900 uppercase tracking-wider">Grace Buffer</span>
                                            </div>
                                            <label class="inline-flex items-center gap-2 cursor-pointer">
                                                <input type="checkbox" id="asgnAllowGrace" name="allow_grace" class="rounded border-amber-300 text-amber-600 focus:ring-amber-500" checked onchange="toggleGraceInput(this.checked)">
                                                <span class="text-xs font-bold text-amber-800">Enable Grace</span>
                                            </label>
                                        </div>
                                        <div id="asgnGraceMinutesWrapper" class="flex items-center gap-2">
                                            <span class="text-[11px] text-amber-700">Extra Window:</span>
                                            <input type="number" id="asgnGraceMinutes" name="grace_period_minutes" class="form-input text-xs w-16 text-center font-bold" min="1" max="60" value="5">
                                            <span class="text-xs text-amber-800 font-bold">mins</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- ── Section 8: Pre-submission Diagnostics ── -->
                                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-2.5">
                                    <div class="flex items-center gap-2">
                                        <i class="fas fa-stethoscope text-slate-600"></i>
                                        <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">Pre-Submission Diagnostics</span>
                                    </div>
                                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-3">
                                        <div>
                                            <label class="form-label text-[11px]">Min Words</label>
                                            <input type="number" id="asgnMinWords" name="min_word_count" class="form-input text-xs" min="0" placeholder="Optional">
                                        </div>
                                        <div>
                                            <label class="form-label text-[11px]">Max Words</label>
                                            <input type="number" id="asgnMaxWords" name="max_word_count" class="form-input text-xs" min="0" placeholder="Optional">
                                        </div>
                                        <div class="flex items-center pt-5">
                                            <label class="inline-flex items-center gap-1.5 cursor-pointer">
                                                <input type="checkbox" id="asgnDisallowBlank" name="disallow_blank_pages" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" checked>
                                                <span class="text-xs font-bold text-slate-700">No blank pages</span>
                                            </label>
                                        </div>
                                    </div>
                                </div>

                                <!-- ── Section 9: Interactive Rubric Matrix ── -->
                                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200 space-y-3">
                                    <div class="flex items-center justify-between">
                                        <div class="flex items-center gap-2">
                                            <i class="fas fa-table-cells text-indigo-600"></i>
                                            <span class="text-xs font-bold text-slate-800 uppercase tracking-wider">Scoring Rubric</span>
                                        </div>
                                        <button type="button" onclick="addRubricCriterionRow()" class="px-2.5 py-1 text-xs font-bold rounded-lg bg-indigo-50 text-indigo-600 border border-indigo-200 hover:bg-indigo-100 transition">
                                            <i class="fas fa-plus mr-1"></i> Add Criterion
                                        </button>
                                    </div>
                                    <div>
                                        <input type="text" id="asgnRubricTitle" name="rubric_title" class="form-input text-xs" placeholder="Rubric Title (e.g. Scientific Inquiry &amp; Analysis Matrix)">
                                    </div>
                                    <div id="asgnRubricCriteriaList" class="space-y-2">
                                        <!-- Dynamic Criterion Rows inserted here -->
                                    </div>
                                </div>
                            </div>

                            <div class="modal-footer" style="padding: 1rem 1.25rem;">
                                <button type="button" onclick="handleAssignmentModalClose()" class="sort-btn cursor-pointer">Cancel</button>
                                <button type="submit" id="saveAsgnSubmitBtn" class="sort-btn active cursor-pointer" style="background:#0d9488;border-color:#0f766e;color:white">
                                    <i class="fas fa-save text-sm"></i> Save Assignment
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- ======= GROUP SETS MANAGEMENT MODAL ======= -->
                <div class="modal-backdrop" id="groupSetModal">
                    <div class="modal-card" style="max-width:700px; max-height: 90vh; display: flex; flex-direction: column;">
                        <div class="modal-header">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-blue-100 flex items-center justify-center">
                                    <i class="fas fa-users-gear text-blue-600 text-base"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-slate-800 text-base">Class Group Sets</h3>
                                    <p class="text-xs text-slate-500">Create, organize, and inspect student teams for group deliverables</p>
                                </div>
                            </div>
                            <button type="button" onclick="closeModal('groupSetModal')" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-times text-base"></i>
                            </button>
                        </div>
                        <div class="modal-body overflow-y-auto space-y-4 p-4">
                            <!-- Audience Detection Banner -->
                            <div id="groupSetAudienceBanner" class="p-2.5 rounded-xl bg-blue-100/70 border border-blue-200 text-xs flex items-center justify-between text-blue-900 font-medium">
                                <div class="flex items-center gap-2">
                                    <i class="fas fa-users-viewfinder text-blue-600"></i>
                                    <span>Target Audience Pool: <strong id="groupSetAudienceText">Entire Class</strong></span>
                                </div>
                                <span id="groupSetAudienceBadge" class="px-2.5 py-0.5 rounded-full text-[11px] font-bold bg-white text-blue-800 border border-blue-200 shadow-xs">
                                    0 Students Detected
                                </span>
                            </div>

                            <!-- Create New Group Set Form -->
                            <form id="createGroupSetForm" onsubmit="submitCreateGroupSet(event)" class="p-3.5 rounded-xl bg-blue-50/60 border border-blue-200 space-y-3">
                                <div class="font-bold text-xs text-blue-900 uppercase tracking-wider flex items-center gap-1.5">
                                    <i class="fas fa-plus-circle text-blue-600"></i> Create New Group Set
                                </div>
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5">
                                    <div class="sm:col-span-2">
                                        <label class="form-label text-[11px]">Group Set Name <span class="text-rose-500">*</span></label>
                                        <input type="text" id="newSetName" class="form-input text-xs" placeholder="e.g. Lab Experiment Teams" required>
                                    </div>
                                    <div>
                                        <label class="form-label text-[11px]">Number of Members <span class="text-slate-400 font-normal">(per group)</span> <span class="text-rose-500">*</span></label>
                                        <input type="number" id="newSetMemberCount" class="form-input text-xs" min="1" max="50" value="4" oninput="updateGroupCalcPreview()" required>
                                        <div id="newSetCalcPreview" class="text-[10px] text-blue-700 font-semibold mt-1"></div>
                                    </div>
                                </div>
                                <div>
                                    <label class="form-label text-[11px]">Description / Purpose</label>
                                    <input type="text" id="newSetDesc" class="form-input text-xs" placeholder="Optional notes for this group allocation...">
                                </div>

                                <!-- Selection Method Options -->
                                <div class="pt-1 space-y-1.5">
                                    <label class="form-label text-[11px]">Student Selection Method</label>
                                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
                                        <label class="flex items-center gap-2 p-2 rounded-lg border border-blue-200 bg-white cursor-pointer hover:bg-blue-50/50">
                                            <input type="radio" name="newSetGroupingMode" value="random" checked onchange="toggleGroupingMode(this.value)" class="accent-blue-600">
                                            <div>
                                                <div class="font-bold text-slate-800">Randomly Picked by System</div>
                                                <div class="text-[10px] text-slate-500">Auto-distribute students across groups</div>
                                            </div>
                                        </label>
                                        <label class="flex items-center gap-2 p-2 rounded-lg border border-blue-200 bg-white cursor-pointer hover:bg-blue-50/50">
                                            <input type="radio" name="newSetGroupingMode" value="manual" onchange="toggleGroupingMode(this.value)" class="accent-blue-600">
                                            <div>
                                                <div class="font-bold text-slate-800">Manually Select Students</div>
                                                <div class="text-[10px] text-slate-500">Pick specific students for each group</div>
                                            </div>
                                        </label>
                                    </div>
                                </div>

                                <!-- Manual Grouping Workspace (Hidden by default) -->
                                <div id="manualGroupingContainer" class="hidden space-y-3 p-3 rounded-xl bg-white border border-blue-200">
                                    <div class="flex items-center justify-between">
                                        <div>
                                            <h5 class="text-xs font-bold text-slate-800">Manual Group Staging</h5>
                                            <p class="text-[10px] text-slate-400">Add groups and assign unassigned students</p>
                                        </div>
                                        <button type="button" onclick="addManualGroupCard()" class="px-2.5 py-1 rounded-md bg-blue-50 text-blue-700 hover:bg-blue-100 font-bold text-xs border border-blue-200 transition flex items-center gap-1">
                                            <i class="fas fa-plus text-[10px]"></i> Add Group
                                        </button>
                                    </div>

                                    <!-- Unassigned students pool -->
                                    <div class="p-2 rounded-lg bg-slate-50 border border-slate-200 text-xs">
                                        <div class="flex items-center justify-between mb-1.5">
                                            <span class="text-[11px] font-bold text-slate-600">Unassigned Students Pool:</span>
                                            <span id="manualUnassignedCount" class="text-[10px] font-bold text-blue-600">0 remaining</span>
                                        </div>
                                        <div id="manualUnassignedList" class="flex flex-wrap gap-1.5 max-h-24 overflow-y-auto pr-1">
                                            <!-- Dynamically populated student chips -->
                                        </div>
