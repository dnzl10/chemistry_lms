                    </button>
                    <button class="icon-btn danger" title="Delete"
                            type="button"
                            onclick='confirmDelete("announcement", ${ann.announcement_id}, window.getAnnData(${ann.announcement_id}) ? window.getAnnData(${ann.announcement_id}).title : "")'>
                        <i class="fas fa-trash text-sm"></i>
                    </button>
                </div>
            </td>
        </tr>
    `;
}

function renumberAnnouncementRows() {
    const rows = document.querySelectorAll('#class-ann-tbody tr');
    rows.forEach((r, idx) => {
        const cell = r.querySelector('.ann-index-cell');
        if (cell) cell.textContent = idx + 1;
    });
}

function checkAnnouncementEmptyState() {
    const tbody = document.getElementById('class-ann-tbody');
    const rows = tbody ? tbody.querySelectorAll('tr') : [];
    if (!tbody || rows.length === 0) {
        const tableWrapper = document.getElementById('announcementsTableWrapper');
        if (tableWrapper) tableWrapper.remove();

        const container = document.getElementById('announcementsContainer');
        if (container && !document.getElementById('announcementsEmptyState')) {
            const emptyDiv = document.createElement('div');
            emptyDiv.id = 'announcementsEmptyState';
            emptyDiv.className = 'standard-empty-state';
            emptyDiv.style.cssText = 'margin:0;min-height:510px;';
            emptyDiv.innerHTML = `
                <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-2xl mx-auto mb-3.5 shadow-sm border border-rose-100">
                    <i class="fas fa-bullhorn"></i>
                </div>
                <h4 class="text-sm font-bold text-slate-700 mb-1">No announcements published for <%= classInfo.class_name %></h4>
                <p class="text-xs text-slate-400 max-w-sm mx-auto mb-4">Post class-wide updates, schedule adjustments, or emergency notices directly to your students.</p>
                <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-rose-600 hover:bg-rose-700 text-white shadow-sm transition" onclick="openAnnouncementModal(null, <%= classInfo.class_id %>)">
                    <i class="fas fa-plus text-xs"></i> Post First Announcement
                </button>
            `;
            container.appendChild(emptyDiv);
        }
