}

function appendAnnouncementRow(ann) {
    const container = document.getElementById('announcementsContainer');
    if (!container) return;

    let tableWrapper = document.getElementById('announcementsTableWrapper');
    let tbody = document.getElementById('class-ann-tbody');
    const emptyState = document.getElementById('announcementsEmptyState');

    if (!tbody || !tableWrapper) {
        if (emptyState) emptyState.remove();

        tableWrapper = document.createElement('div');
        tableWrapper.className = 'overflow-x-auto flex-1';
        tableWrapper.id = 'announcementsTableWrapper';
        tableWrapper.innerHTML = `
            <table class="sub-table w-full" id="class-ann-table">
                <thead>
                    <tr>
                        <th style="width:30px">#</th>
                        <th>Title</th>
                        <th>Priority</th>
                        <th>Scope</th>
                        <th>Author</th>
                        <th>Posted / Deadline</th>
                        <th style="width:100px;text-align:right">Actions</th>
                    </tr>
                </thead>
                <tbody id="class-ann-tbody"></tbody>
            </table>
        `;
        container.appendChild(tableWrapper);
        tbody = document.getElementById('class-ann-tbody');
    } else {
        if (emptyState) emptyState.style.display = 'none';
        tableWrapper.style.display = 'block';
    }

    const rowCount = tbody.querySelectorAll('tr').length;
    const tempDiv = document.createElement('tbody');
    tempDiv.innerHTML = buildAnnouncementRowHtml(ann, rowCount + 1);
    const newRow = tempDiv.firstElementChild;
    if (newRow) {
        newRow.classList.add('bg-emerald-50/80', 'transition-colors', 'duration-500');
        tbody.appendChild(newRow);
        setTimeout(() => newRow.classList.remove('bg-emerald-50/80'), 1500);
    }
    renumberAnnouncementRows();
}

function openAnnouncementModal(annId, classId, title, content, isPrio, isCritical, dueDate, attachmentUrl, attachmentName) {
    const isEdit = Boolean(annId && annId !== 'null' && annId !== 'undefined');
    document.getElementById('announcementModalTitle').textContent = isEdit ? 'Edit Announcement' : 'Add Announcement';
    document.getElementById('announcementId').value       = isEdit ? annId : '';
    document.getElementById('announcementClassId').value  = classId || <%= classInfo.class_id %>;
    document.getElementById('announcementTitle').value    = title   || '';
    document.getElementById('announcementContent').value  = content || '';
    document.getElementById('announcementPriority').checked = isPrio == 1;
    document.getElementById('announcementCritical').checked = isCritical == 1;
    document.getElementById('announcementDueDate').value  = dueDate ? dueDate.slice(0, 16) : '';
    document.getElementById('announcementForwardWebhook').checked = false;

    // Reset attachment inputs
    const fileInput = document.getElementById('announcementAttachment');
    if (fileInput) fileInput.value = '';
    const existWrap = document.getElementById('annExistingAttachmentWrap');
    const existName = document.getElementById('annExistingAttachmentName');
    const removeCheck = document.getElementById('annRemoveAttachment');
    if (removeCheck) removeCheck.checked = false;

    if (attachmentUrl) {
        if (existWrap) existWrap.classList.remove('hidden');
        if (existName) existName.textContent = attachmentName || attachmentUrl.split('/').pop();
    } else {
        if (existWrap) existWrap.classList.add('hidden');
    }

    openModal('announcementModal');
}

function editAnnouncementItem(ann, classId) {
    let data = ann;
    if (typeof ann === 'number' || typeof ann === 'string') {
        data = window.getAnnData(ann);
    }
    if (!data) return;
    openAnnouncementModal(
        data.announcement_id,
        classId || <%= classInfo.class_id %>,
        data.title,
        data.content,
        data.is_priority,
        data.is_critical,
        data.due_date ? new Date(data.due_date).toISOString() : '',
        data.attachment_url,
        data.attachment_name
    );
}



function openForumModal(fid, topicId, subjectId, title, content) {
    document.getElementById('forumModalTitle').textContent = fid ? 'Edit Forum Thread' : 'Add Forum Thread';
    document.getElementById('forumId').value        = fid       || '';
    document.getElementById('forumTopicId').value   = topicId;
    document.getElementById('forumSubjectId').value = subjectId;
    document.getElementById('forumTitle').value     = title     || '';
    document.getElementById('forumContent').value   = content   || '';
    document.getElementById('forumPinned').checked  = false;
    openModal('forumModal');
}

