let currentTopicPool = { count: 0, questions: [], level_number: 1 };
let currentManualQuestions = [];

function validatePoolShortage() {
    const items = parseInt(document.getElementById('assessmentItems').value, 10) || 0;
    const notice = document.getElementById('assessmentPoolNotice');
    const noticeText = document.getElementById('assessmentPoolNoticeText');
    if (!notice) return;
    const count = (currentTopicPool && currentTopicPool.count !== undefined) ? currentTopicPool.count : 0;

    if (count === 0) {
        notice.className = 'text-[11px] mt-1.5 p-2 rounded-lg bg-slate-100 border border-slate-300 text-slate-700 flex items-start gap-1.5 transition-all';
        notice.innerHTML = `<i class="fas fa-info-circle mt-0.5 text-slate-500"></i><span>Loading question pool information...</span>`;
        return;
    }

    if (items > count) {
        notice.className = 'text-[11px] mt-1.5 p-2.5 rounded-lg bg-amber-50 border border-amber-300 text-amber-900 flex items-start gap-2 shadow-sm transition-all';
        notice.innerHTML = `<i class="fas fa-exclamation-triangle mt-0.5 text-amber-600 text-sm flex-shrink-0"></i><div><strong>Question Shortage Warning:</strong> This topic currently only has <strong>${count} active questions</strong> in Elementa. Setting total items to <strong>${items}</strong> will result in repeated or fallback questions during gameplay. Please reduce items or add more questions in the question bank.</div>`;
    } else {
        notice.className = 'text-[11px] mt-1.5 p-2 rounded-lg bg-emerald-50 border border-emerald-200 text-emerald-800 flex items-start gap-1.5 transition-all';
        notice.innerHTML = `<i class="fas fa-check-circle mt-0.5 text-emerald-600"></i><div>Question Pool OK: <strong>${count} active questions</strong> available for Level ${currentTopicPool.level_number || '?'}. (${items} requested)</div>`;
    }
}

async function loadTopicQuestionsPool(topicId) {
    if (!topicId) return;
    try {
        const res = await fetch(`/teacher/api/topic-questions-pool/${topicId}`);
        const data = await res.json();
        if (data.success) {
            currentTopicPool = data;
            const levelBadge = document.getElementById('topicLevelBadge');
            if (levelBadge) {
                levelBadge.textContent = 'Level ' + (data.level_number || '1');
            }
            const randomCountEl = document.getElementById('randomPoolCountDisplay');
            if (randomCountEl) {
                randomCountEl.textContent = (data.count || 0) + ' questions';
            }
            renderManualQuestionsList();
            validatePoolShortage();
        }
    } catch (err) {
        console.error('Failed to load topic question pool:', err);
    }
}

function handleSelectionModeChange(mode) {
