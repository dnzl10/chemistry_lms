                <!-- ======= MATERIAL DISCARD CONFIRMATION MODAL ======= -->
                <div class="modal-backdrop" id="matDiscardConfirmModal" style="z-index: 250;">
                    <div class="modal-card" style="max-width:440px; width:92vw;">
                        <div class="modal-header">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center text-amber-600">
                                    <i class="fas fa-triangle-exclamation text-base"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-slate-800 text-base">Discard Unsaved Changes?</h3>
                                    <p class="text-[11px] text-slate-400">Unsaved data will be permanently lost</p>
                                </div>
                            </div>
                            <button type="button" onclick="closeModal('matDiscardConfirmModal')" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 transition">
                                <i class="fas fa-times text-base"></i>
                            </button>
                        </div>
                        <div class="modal-body py-4">
                            <p class="text-sm text-slate-600 leading-relaxed">
                                You have unsaved changes or attached files in this material modal. Are you sure you want to discard your changes and close?
                            </p>
                        </div>
                        <div class="modal-footer bg-slate-50 flex items-center justify-end gap-2">
                            <button type="button" onclick="closeModal('matDiscardConfirmModal')" class="sort-btn">
                                Keep Editing
                            </button>
                            <button type="button" onclick="confirmDiscardMaterialChanges()" class="sort-btn" style="background:#e11d48;border-color:#be123c;color:white">
                                <i class="fas fa-trash-can text-sm"></i> Discard & Close
                            </button>
                        </div>
                    </div>
                </div>

                <!-- ======= MATERIAL SAVE CONFIRMATION MODAL ======= -->
                <div class="modal-backdrop" id="matSaveConfirmModal" style="z-index: 250;">
                    <div class="modal-card" style="max-width:460px; width:92vw;">
                        <div class="modal-header">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-teal-100 flex items-center justify-center text-teal-600">
                                    <i class="fas fa-circle-question text-base" id="matSaveConfirmIcon"></i>
                                </div>
                                <div>
                                    <h3 class="font-bold text-slate-800 text-base" id="matSaveConfirmTitle">Confirm Material</h3>
                                    <p class="text-[11px] text-slate-400" id="matSaveConfirmSubtitle">Please review before saving</p>
                                </div>
                            </div>
                            <button type="button" onclick="closeModal('matSaveConfirmModal')" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 transition">
                                <i class="fas fa-times text-base"></i>
                            </button>
                        </div>
                        <div class="modal-body py-4 space-y-3">
                            <p class="text-sm text-slate-600 leading-relaxed" id="matSaveConfirmMsg">
                                Are you sure you want to proceed and save this learning material?
                            </p>
                            <div class="p-3 bg-slate-50 border border-slate-200 rounded-xl text-xs space-y-2">
                                <div class="flex items-start justify-between gap-2">
                                    <span class="text-slate-400 font-medium">Title:</span>
                                    <span class="font-bold text-slate-800 text-right truncate max-w-[240px]" id="matConfirmSummaryTitle"></span>
                                </div>
                                <div class="flex items-center justify-between">
                                    <span class="text-slate-400 font-medium">Material Type:</span>
                                    <span class="font-semibold text-slate-700 uppercase" id="matConfirmSummaryType"></span>
                                </div>
                                <div class="flex items-start justify-between gap-2">
                                    <span class="text-slate-400 font-medium">Files / Source:</span>
                                    <span class="font-semibold text-teal-700 text-right truncate max-w-[240px]" id="matConfirmSummarySource"></span>
