<script>
    // ── Profile dropdown ──────────────────────────────────
        function toggleProfileDropdown() {
            document.getElementById('profileDropdown').classList.toggle('open');
        }
        // Close when clicking outside
        document.addEventListener('click', function(e) {
            const wrap = document.getElementById('profileDropdownWrap');
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById('profileDropdown').classList.remove('open');
            }
        });

        // ── Main Tab Switching ──
        function switchMainTab(targetId, btn) {
            if (typeof hasUnsavedAttendanceChanges !== 'undefined' && hasUnsavedAttendanceChanges && !bypassUnsavedAttendanceGuard) {
                guardUnsavedAttendance(function() {
                    switchMainTab(targetId, btn);
                });
                return;
            }
            // Remove active from all tabs
            document.querySelectorAll('.main-tab').forEach(t => t.classList.remove('active'));
            // Hide all tab contents
            document.querySelectorAll('.main-tab-content').forEach(c => c.classList.remove('active'));
            
            // Activate target
            if (btn) btn.classList.add('active');
            const targetEl = document.getElementById(targetId);
            if (targetEl) targetEl.classList.add('active');
            if (targetId === 'tab-attendance') initAttendanceTab();
        }

                        // ── Deep-Link Router for Notification Redirects (tab, subtab, studentId, forumId, hash) ──
        window.addEventListener('DOMContentLoaded', function() {
            const params = new URLSearchParams(window.location.search);
            const rawTab = (params.get('tab') || '').toLowerCase().trim();
            const subtab = (params.get('subtab') || '').toLowerCase().trim();
            const studentId = params.get('studentId');
            const forumId = params.get('forumId') || params.get('forum_id');
            const hash = (window.location.hash || '').replace(/^#/, '').toLowerCase().trim();

            // External link / notification redirect to dedicated workspaces
            if (subtab === 'messages' || studentId || rawTab === 'messages' || hash === 'messages') {
                window.location.href = `/teacher/messages${studentId ? '?userId=' + encodeURIComponent(studentId) : ''}`;
                return;
            }
            if (forumId || rawTab === 'forums' || hash === 'forums') {
                window.location.href = forumId ? `/teacher/forums/view/${encodeURIComponent(forumId)}` : '/teacher/forums';
                return;
            }
            if (rawTab === 'communication' || rawTab === 'comm' || hash === 'communication' || hash === 'comm') {
                window.location.href = '/teacher/messages';
                return;
            }

            const tabMap = {
                'announcements': 'tab-announcements',
                'tab-announcements': 'tab-announcements',
                'attendance': 'tab-attendance',
                'tab-attendance': 'tab-attendance',
                'calendar': 'tab-calendar',
                'tab-calendar': 'tab-calendar',
                'content': 'tab-content',
                'assessments': 'tab-content',
                'materials': 'tab-content',
                'tab-content': 'tab-content',
                'students': 'tab-students',
                'roster': 'tab-students',
                'tab-students': 'tab-students',
                'analytics': 'tab-analytics',
                'scores': 'tab-analytics',
                'grading': 'tab-analytics',
                'tab-analytics': 'tab-analytics'
            };

            const resolvedTabId = tabMap[rawTab] || tabMap[hash] || null;
            if (resolvedTabId) {
                const tabBtn = document.querySelector(`.main-tab[onclick*="'${resolvedTabId}'"]`);
                switchMainTab(resolvedTabId, tabBtn);
            }
        });
</script>



<!-- Announcement Preview & Document Reader Modal Partial -->
<%- include('../partials/announcement-preview-modal') %>

<script src="/js/notificationHub.js"></script>
<script>

        // ================================================================
        // ================================================================
        // ATTENDANCE MONITORING & ANALYTICS CLIENT ENGINE
        // ================================================================
        let currentAttendanceRecords = [];
        let currentAttendanceAnalytics = null;
        let attendanceTrendChart = null;
        let attendanceDistChart = null;
        let attendanceLmsPresenceChart = null;
        let attendanceWeekdayChart = null;
        let currentAttendanceSubView = 'analytics';
        let currentMasterTierFilter = 'all';
        let attendanceInitialSnapshot = {};
        let hasUnsavedAttendanceChanges = false;
        let unsavedAttendanceModifiedCount = 0;
        let lastLoadedAttendanceDate = '';
        let pendingAttendanceNavigationAction = null;
        let bypassUnsavedAttendanceGuard = false;

        function initAttendanceTab() {
            const picker = document.getElementById('attendanceDatePicker');
            const todayStr = getAttendanceTodayStr();
            if (picker) {
                picker.max = todayStr;
                if (!picker.value || picker.value > todayStr) {
                    picker.value = todayStr;
                }
            }
            loadAttendance();
            loadAttendanceAnalytics();
        }

        // --- SUBVIEW SWITCHER (Analytics vs Daily Rollcall) ---
        function switchAttendanceSubView(view) {
            if (view !== 'rollcall' && hasUnsavedAttendanceChanges && !bypassUnsavedAttendanceGuard) {
                guardUnsavedAttendance(function() {
                    switchAttendanceSubView(view);
                });
                return;
            }
            currentAttendanceSubView = view;
            const analyticsView = document.getElementById('attSubViewAnalytics');
            const rollcallView = document.getElementById('attSubViewRollcall');
            const btnAnalytics = document.getElementById('attSubTabBtnAnalytics');
            const btnRollcall = document.getElementById('attSubTabBtnRollcall');

            if (view === 'analytics') {
                analyticsView.classList.remove('hidden');
                rollcallView.classList.add('hidden');
                btnAnalytics.className = 'px-4 py-2 rounded-lg text-xs font-black transition flex items-center gap-2 bg-white text-indigo-700 shadow-sm';
                btnRollcall.className = 'px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2 text-slate-600 hover:text-slate-900';
                if (!currentAttendanceAnalytics) loadAttendanceAnalytics();
            } else {
                analyticsView.classList.add('hidden');
                rollcallView.classList.remove('hidden');
                btnRollcall.className = 'px-4 py-2 rounded-lg text-xs font-black transition flex items-center gap-2 bg-white text-emerald-700 shadow-sm';
                btnAnalytics.className = 'px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2 text-slate-600 hover:text-slate-900';
            }
        }

        function scrollToAtRiskRadar() {
            if (currentAttendanceSubView !== 'analytics') switchAttendanceSubView('analytics');
            const el = document.getElementById('attRiskRadarSection');
            if (el) {
                el.scrollIntoView({ behavior: 'smooth', block: 'center' });
                el.classList.add('ring-4', 'ring-rose-300', 'transition-all');
                setTimeout(() => el.classList.remove('ring-4', 'ring-rose-300'), 2500);
            }
        }

        function changeAttendanceAnalyticsRange(range) {
            loadAttendanceAnalytics(range);
        }

        async function reloadAttendanceAnalytics() {
            const icon = document.getElementById('attRefreshIcon');
            if (icon) icon.classList.add('fa-spin');
            const range = document.getElementById('attAnalyticsRange')?.value || 'all';
            await loadAttendanceAnalytics(range);
            if (icon) setTimeout(() => icon.classList.remove('fa-spin'), 600);
        }

        // --- FETCH AND RENDER ANALYTICS ---
        async function loadAttendanceAnalytics(rangeParam) {
            const range = rangeParam || document.getElementById('attAnalyticsRange')?.value || 'all';
            try {
                const res = await fetch('/teacher/api/attendance/<%= classInfo.class_id %>/analytics?range=' + encodeURIComponent(range));
                const data = await res.json();
                if (!data.success) throw new Error(data.error || 'Failed to load attendance analytics');

                currentAttendanceAnalytics = data;

                // Update Executive KPI Cards
                const sum = data.summary || {};
                document.getElementById('anaKpiRate').textContent = (sum.overallAttendanceRate !== undefined ? sum.overallAttendanceRate : '--') + '%';
                
                const rateBadge = document.getElementById('anaKpiRateBadge');
                if (rateBadge) {
                    if (sum.overallAttendanceRate >= 95) {
                        rateBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-100 text-emerald-700';
                        rateBadge.textContent = 'Exemplary (95%+)';
                    } else if (sum.overallAttendanceRate >= 85) {
                        rateBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-blue-100 text-blue-700';
                        rateBadge.textContent = 'Good Standing (85%+)';
                    } else if (sum.overallAttendanceRate >= 75) {
                        rateBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-amber-100 text-amber-700';
                        rateBadge.textContent = 'Moderate Risk (75-84%)';
                    } else {
                        rateBadge.className = 'px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-rose-100 text-rose-700';
                        rateBadge.textContent = 'Critical Alert (<75%)';
                    }
                }

                // LMS Presence KPIs
                const onlineElem = document.getElementById('anaKpiOnlineNow');
                if (onlineElem) onlineElem.textContent = sum.onlineNowCount || 0;

                const lmsActiveElem = document.getElementById('anaKpiLmsActive');
                if (lmsActiveElem) lmsActiveElem.textContent = sum.activeThisWeekCount || 0;

                const lmsAdoptionElem = document.getElementById('anaKpiLmsAdoption');
                if (lmsAdoptionElem) lmsAdoptionElem.textContent = (sum.lmsAdoptionRate || 0) + '% LMS adoption rate';

                document.getElementById('anaKpiSessions').textContent = sum.totalSessionsHeld || 0;
                document.getElementById('anaKpiEntries').textContent = (sum.totalEntries || 0) + ' marks recorded';
                document.getElementById('anaKpiPunctuality').textContent = (sum.overallPunctualityRate !== undefined ? sum.overallPunctualityRate : '--') + '%';
                document.getElementById('anaKpiLateSub').textContent = (sum.totalLate || 0) + ' tardy arrivals';

                const riskTotal = (sum.criticalCount || 0) + (sum.atRiskCount || 0) + (sum.inactiveLmsCount || 0);
                document.getElementById('anaKpiRiskCount').textContent = riskTotal;
                const riskSub = document.getElementById('anaKpiRiskSub');
                if (riskSub) {
                    if (sum.ghostStudentCount > 0) riskSub.textContent = sum.ghostStudentCount + ' Severe Ghost / Inactive';
                    else if (sum.criticalCount > 0) riskSub.textContent = sum.criticalCount + ' Critical Absenteeism';
                    else if (sum.inactiveLmsCount > 0) riskSub.textContent = sum.inactiveLmsCount + ' LMS Inactive (>7d)';
                    else if (sum.atRiskCount > 0) riskSub.textContent = sum.atRiskCount + ' At Risk';
                    else riskSub.textContent = 'All Clear (0 Flagged)';
                }

                // Update Filter Pills Badges
                const studentList = data.studentStats || [];
                document.getElementById('attCountAll').textContent = studentList.length;
                const onlineBadgeElem = document.getElementById('attCountOnline');
                if (onlineBadgeElem) onlineBadgeElem.textContent = sum.onlineNowCount || 0;
                const critAtRiskElem = document.getElementById('attCountCriticalAtRisk');
                if (critAtRiskElem) critAtRiskElem.textContent = (sum.criticalCount || 0) + (sum.atRiskCount || 0);
                const lmsInactElem = document.getElementById('attCountLmsInactive');
                if (lmsInactElem) lmsInactElem.textContent = sum.inactiveLmsCount || 0;
                const allStarElem = document.getElementById('attCountAllStar');
                if (allStarElem) allStarElem.textContent = studentList.filter(s => s.engagementCategory && s.engagementCategory.includes('All-Star')).length;
                document.getElementById('attCountExemplary').textContent = sum.exemplaryCount || 0;

                // Render Sub-Components
                renderAttendanceCharts(data);
                renderAtRiskRadar(studentList);
                renderAttendanceMasterTable(studentList);
            } catch (err) {
                console.error('Error loading attendance analytics:', err);
            }
        }

        // --- RENDER CHARTS (Chart.js) ---
        function renderAttendanceCharts(data) {
            if (typeof Chart === 'undefined') return;

            // 1. Session Trend & LMS Volume Chart
            const trendCanvas = document.getElementById('attTrendChartCanvas');
            const trendEmpty = document.getElementById('attTrendEmpty');
            if (trendCanvas) {
                if (attendanceTrendChart) {
                    attendanceTrendChart.destroy();
                    attendanceTrendChart = null;
                }

                if (!data.trend || !data.trend.length) {
                    trendEmpty?.classList.remove('hidden');
                    trendCanvas.style.display = 'none';
                } else {
                    trendEmpty?.classList.add('hidden');
                    trendCanvas.style.display = 'block';

                    const labels = data.trend.map(t => {
                        const parts = t.session_date.split('-');
                        return (parts[1] + '/' + parts[2]) + ' (' + (t.day_name ? t.day_name.slice(0, 3) : '') + ')';
                    });
                    const presentData = data.trend.map(t => t.present_count);
                    const lateData = data.trend.map(t => t.late_count);
                    const absentData = data.trend.map(t => t.absent_count);
                    const rateData = data.trend.map(t => t.attendance_rate !== undefined ? t.attendance_rate : (t.rate || 0));

                    // Map LMS logins onto dates if available in lmsTimeline
                    const lmsMap = {};
                    (data.lmsTimeline || []).forEach(lt => {
                        lmsMap[lt.log_date] = lt.active_students || lt.total_logins || 0;
                    });
                    const lmsData = data.trend.map(t => lmsMap[t.session_date] || 0);

                    attendanceTrendChart = new Chart(trendCanvas, {
                        data: {
                            labels: labels,
                            datasets: [
                                {
                                    type: 'line',
                                    label: 'Attendance Rate (%)',
                                    data: rateData,
                                    borderColor: '#6366f1',
                                    backgroundColor: 'rgba(99, 102, 241, 0.08)',
                                    fill: true,
                                    tension: 0.35,
                                    borderWidth: 3,
                                    pointBackgroundColor: '#6366f1',
                                    pointHoverRadius: 6,
                                    pointRadius: 4,
                                    yAxisID: 'yRate'
                                },
                                {
                                    type: 'line',
                                    label: 'LMS Active Logins',
                                    data: lmsData,
                                    borderColor: '#8b5cf6',
                                    borderDash: [4, 4],
                                    pointBackgroundColor: '#8b5cf6',
                                    pointRadius: 3,
                                    tension: 0.3,
                                    borderWidth: 2,
                                    yAxisID: 'yCount'
                                },
                                {
                                    type: 'bar',
                                    label: 'Present',
                                    data: presentData,
                                    backgroundColor: '#10b981',
                                    borderRadius: 4,
                                    stack: 'counts',
                                    yAxisID: 'yCount'
                                },
                                {
                                    type: 'bar',
                                    label: 'Late',
                                    data: lateData,
                                    backgroundColor: '#f59e0b',
                                    borderRadius: 4,
                                    stack: 'counts',
                                    yAxisID: 'yCount'
                                },
                                {
                                    type: 'bar',
                                    label: 'Absent',
                                    data: absentData,
                                    backgroundColor: '#f43f5e',
                                    borderRadius: 4,
                                    stack: 'counts',
                                    yAxisID: 'yCount'
                                }
                            ]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            interaction: { mode: 'index', intersect: false },
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    padding: 10,
                                    cornerRadius: 8,
                                    callbacks: {
                                        afterTitle: function(items) {
                                            const idx = items[0].dataIndex;
                                            return 'Date: ' + data.trend[idx].session_date;
                                        }
                                    }
                                }
                            },
                            scales: {
                                x: {
                                    grid: { display: false },
                                    ticks: { font: { size: 10, family: 'Plus Jakarta Sans', weight: 'bold' } }
                                },
                                yCount: {
                                    type: 'linear',
                                    position: 'left',
                                    stacked: false,
                                    beginAtZero: true,
                                    ticks: { precision: 0, font: { size: 10, family: 'Plus Jakarta Sans' } },
                                    title: { display: true, text: 'Student Count', font: { size: 10, weight: 'bold' } }
                                },
                                yRate: {
                                    type: 'linear',
                                    position: 'right',
                                    min: 0,
                                    max: 100,
                                    grid: { display: false },
                                    ticks: {
                                        callback: function(v) { return v + '%'; },
                                        font: { size: 10, family: 'Plus Jakarta Sans' }
                                    },
                                    title: { display: true, text: 'Turnout %', font: { size: 10, weight: 'bold' } }
                                }
                            }
                        }
                    });
                }
            }

            // 2. Status Breakdown Doughnut Chart
            const distCanvas = document.getElementById('attDistChartCanvas');
            const distEmpty = document.getElementById('attDistEmpty');
            if (distCanvas) {
                if (attendanceDistChart) {
                    attendanceDistChart.destroy();
                    attendanceDistChart = null;
                }

                const dist = data.distribution || { present: 0, late: 0, absent: 0, excused: 0 };
                document.getElementById('attLegendPresent').textContent = dist.present;
                document.getElementById('attLegendLate').textContent = dist.late;
                document.getElementById('attLegendAbsent').textContent = dist.absent;
                document.getElementById('attLegendExcused').textContent = dist.excused;

                const totalDist = dist.present + dist.late + dist.absent + dist.excused;
                if (totalDist === 0) {
                    distEmpty?.classList.remove('hidden');
                    distCanvas.style.display = 'none';
                } else {
                    distEmpty?.classList.add('hidden');
                    distCanvas.style.display = 'block';

                    attendanceDistChart = new Chart(distCanvas, {
                        type: 'doughnut',
                        data: {
                            labels: ['Present', 'Late', 'Absent', 'Excused'],
                            datasets: [{
                                data: [dist.present, dist.late, dist.absent, dist.excused],
                                backgroundColor: ['#10b981', '#f59e0b', '#f43f5e', '#0284c7'],
                                borderWidth: 2,
                                borderColor: '#ffffff',
                                hoverOffset: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '72%',
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(item) {
                                            const val = item.raw || 0;
                                            const pct = totalDist > 0 ? Math.round((val / totalDist) * 100) : 0;
                                            return ` ${item.label}: ${val} (${pct}%)`;
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
            }

            // 3. LMS Digital Presence Doughnut Chart
            const lmsCanvas = document.getElementById('attLmsPresenceCanvas');
            const lmsEmpty = document.getElementById('attLmsPresenceEmpty');
            if (lmsCanvas) {
                if (attendanceLmsPresenceChart) {
                    attendanceLmsPresenceChart.destroy();
                    attendanceLmsPresenceChart = null;
                }

                const sum = data.summary || {};
                const onlineCount = sum.onlineNowCount || 0;
                const todayCount = Math.max(0, (sum.activeTodayCount || 0) - onlineCount);
                const weekCount = Math.max(0, (sum.activeThisWeekCount || 0) - (sum.activeTodayCount || 0));
                const dormantCount = sum.ghostStudentCount || 0;
                const inactiveCount = Math.max(0, (sum.inactiveLmsCount || 0) - dormantCount);

                const elOnline = document.getElementById('attLmsLegendOnline');
                if (elOnline) elOnline.textContent = sum.onlineNowCount || 0;
                const elToday = document.getElementById('attLmsLegendToday');
                if (elToday) elToday.textContent = sum.activeTodayCount || 0;
                const elWeek = document.getElementById('attLmsLegendWeek');
                if (elWeek) elWeek.textContent = sum.activeThisWeekCount || 0;
                const elInact = document.getElementById('attLmsLegendInactive');
                if (elInact) elInact.textContent = sum.inactiveLmsCount || 0;
                const elDorm = document.getElementById('attLmsLegendDormant');
                if (elDorm) elDorm.textContent = sum.ghostStudentCount || 0;

                const totalLms = (data.studentStats || []).length;
                if (totalLms === 0) {
                    lmsEmpty?.classList.remove('hidden');
                    lmsCanvas.style.display = 'none';
                } else {
                    lmsEmpty?.classList.add('hidden');
                    lmsCanvas.style.display = 'block';

                    attendanceLmsPresenceChart = new Chart(lmsCanvas, {
                        type: 'doughnut',
                        data: {
                            labels: ['Online Now', 'Active Today', 'Active This Week', 'Inactive (>7d)', 'Dormant / Never'],
                            datasets: [{
                                data: [onlineCount, todayCount, weekCount, inactiveCount, dormantCount],
                                backgroundColor: ['#10b981', '#3b82f6', '#8b5cf6', '#f59e0b', '#f43f5e'],
                                borderWidth: 2,
                                borderColor: '#ffffff',
                                hoverOffset: 4
                            }]
                        },
                        options: {
                            responsive: true,
                            maintainAspectRatio: false,
                            cutout: '70%',
                            plugins: {
                                legend: { display: false },
                                tooltip: {
                                    callbacks: {
                                        label: function(item) {
                                            const val = item.raw || 0;
                                            const pct = totalLms > 0 ? Math.round((val / totalLms) * 100) : 0;
                                            return ` ${item.label}: ${val} (${pct}%)`;
                                        }
                                    }
                                }
                            }
                        }
                    });
                }
            }

            // 4. Day of the Week Pattern Bar Chart
            const weekdayCanvas = document.getElementById('attWeekdayChartCanvas');
            if (weekdayCanvas) {
                if (attendanceWeekdayChart) {
                    attendanceWeekdayChart.destroy();
                    attendanceWeekdayChart = null;
                }

                const wstats = data.weekdayStats || [];
                const wLabels = wstats.map(w => w.day);
                const wData = wstats.map(w => w.rate);
                const wColors = wstats.map(w => {
                    if (w.rate >= 90) return '#10b981';
                    if (w.rate >= 80) return '#0284c7';
                    if (w.rate >= 70) return '#f59e0b';
                    if (w.sessions === 0) return '#cbd5e1';
                    return '#f43f5e';
                });

                attendanceWeekdayChart = new Chart(weekdayCanvas, {
                    type: 'bar',
                    data: {
                        labels: wLabels,
                        datasets: [{
                            label: 'Average Turnout Rate (%)',
                            data: wData,
                            backgroundColor: wColors,
                            borderRadius: 6,
                            maxBarThickness: 38
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false },
                            tooltip: {
                                callbacks: {
                                    label: function(item) {
                                        const idx = item.dataIndex;
                                        const sess = wstats[idx].sessions;
                                        return ` Average Turnout: ${item.raw}% (${sess} class ${sess === 1 ? 'day' : 'days'} held)`;
                                    }
                                }
                            }
                        },
                        scales: {
                            x: {
                                grid: { display: false },
                                ticks: { font: { size: 11, family: 'Plus Jakarta Sans', weight: 'bold' } }
                            },
                            y: {
                                min: 0,
                                max: 100,
                                ticks: {
                                    stepSize: 20,
                                    callback: function(v) { return v + '%'; },
                                    font: { size: 10, family: 'Plus Jakarta Sans' }
                                }
                            }
                        }
                    }
                });
            }
        }

        // --- RENDER AT-RISK RADAR PANEL ---
        function renderAtRiskRadar(studentStats) {
            const container = document.getElementById('attRiskCardsContainer');
            if (!container) return;

            // Flag students who have physical attendance risk OR LMS dormancy
            const flaggedStudents = studentStats.filter(s => {
                const isPhysicalRisk = s.tier === 'Critical' || s.tier === 'At Risk';
                const isLmsRisk = s.days_since_login === null || s.days_since_login > 7;
                return isPhysicalRisk || isLmsRisk;
            });

            const counterBadge = document.getElementById('attRiskCounterBadge');
            if (counterBadge) {
                counterBadge.textContent = `${flaggedStudents.length} Students Flagged`;
                if (flaggedStudents.length === 0) {
                    counterBadge.className = 'px-3 py-1 rounded-full bg-emerald-100 text-emerald-700 text-xs font-black border border-emerald-200';
                } else {
                    counterBadge.className = 'px-3 py-1 rounded-full bg-rose-100 text-rose-700 text-xs font-black border border-rose-200';
                }
            }

            if (flaggedStudents.length === 0) {
                container.innerHTML = `
                    <div class="flex items-center gap-4 p-5 rounded-2xl bg-emerald-50/70 border border-emerald-200 text-emerald-900">
                        <div class="w-12 h-12 rounded-2xl bg-emerald-500 text-white flex items-center justify-center text-xl flex-shrink-0 shadow-md shadow-emerald-200">
                            <i class="fas fa-circle-check"></i>
                        </div>
                        <div>
                            <h4 class="font-black text-sm text-emerald-900">Zero Chronic Disengagement Flagged!</h4>
                            <p class="text-xs text-emerald-700 mt-0.5">
                                All enrolled students are meeting classroom attendance expectations and actively logging into the LMS.
                            </p>
                        </div>
                    </div>`;
                return;
            }

            let cardsHtml = '<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">';
            flaggedStudents.forEach(s => {
                const avatar = s.profile_pic ? '/profile_uploads/' + s.profile_pic : '/assets/logo.png';
