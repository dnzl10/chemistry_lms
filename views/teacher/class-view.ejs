function toggleAssignmentDropdownMenu(event, asgnId) {
    if (event) {
        event.stopPropagation();
        event.preventDefault();
    }
    const menu = document.getElementById('asgn-dropdown-' + asgnId);
    if (!menu) return;
    const isCurrentlyOpen = !menu.classList.contains('hidden');
    
    closeAllAssignmentMenus();

    if (!isCurrentlyOpen) {
        menu.classList.remove('hidden');
        // Reposition if menu overflows window bottom
        const rect = menu.getBoundingClientRect();
        if (rect.bottom > window.innerHeight) {
            menu.style.bottom = '100%';
            menu.style.top = 'auto';
            menu.style.marginBottom = '6px';
            menu.style.marginTop = '0';
        } else {
            menu.style.bottom = 'auto';
            menu.style.top = '100%';
            menu.style.marginTop = '6px';
            menu.style.marginBottom = '0';
        }
    }
}

