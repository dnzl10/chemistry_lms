function updateGroupCalcPreview() {
    const memberInput = document.getElementById('newSetMemberCount');
    const previewEl = document.getElementById('newSetCalcPreview');
    if (!memberInput || !previewEl) return;

    const memberCount = Math.max(1, parseInt(memberInput.value) || 4);
    const totalStudents = currentAudienceStudents.length;
    const estGroups = Math.max(1, Math.ceil(totalStudents / memberCount));

    if (totalStudents > 0) {
        previewEl.textContent = `Generates ~${estGroups} groups for ${totalStudents} students (~${memberCount} members per group)`;
    } else {
        previewEl.textContent = `Target size: ${memberCount} members per group`;
    }
}

function toggleGroupingMode(mode) {
    const manualContainer = document.getElementById('manualGroupingContainer');
    if (manualContainer) {
        manualContainer.classList.toggle('hidden', mode !== 'manual');
    }
    if (mode === 'manual' && manualGroups.length === 0) {
        initializeManualGroups();
    }
}

function initializeManualGroups() {
    const memberCount = Math.max(1, parseInt(document.getElementById('newSetMemberCount')?.value) || 4);
    const totalStudents = currentAudienceStudents.length;
    const initialGroupCount = totalStudents > 0 ? Math.max(2, Math.ceil(totalStudents / memberCount)) : 2;

    manualGroups = [];
    for (let i = 1; i <= initialGroupCount; i++) {
        manualGroups.push({
            name: `Group ${i}`,
            studentIds: []
        });
    }
    renderManualWorkspace();
}

function addManualGroupCard() {
    manualGroups.push({
        name: `Group ${manualGroups.length + 1}`,
        studentIds: []
    });
    renderManualWorkspace();
}

function removeManualGroupCard(groupIndex) {
    manualGroups.splice(groupIndex, 1);
    renderManualWorkspace();
}

function assignStudentToManualGroup(studentId, groupIndex) {
    studentId = Number(studentId);
    manualGroups.forEach(g => {
        g.studentIds = g.studentIds.filter(id => id !== studentId);
    });
    if (manualGroups[groupIndex] && !manualGroups[groupIndex].studentIds.includes(studentId)) {
        manualGroups[groupIndex].studentIds.push(studentId);
    }
    renderManualWorkspace();
}

function unassignStudentFromManualGroup(studentId, groupIndex) {
    studentId = Number(studentId);
    if (manualGroups[groupIndex]) {
        manualGroups[groupIndex].studentIds = manualGroups[groupIndex].studentIds.filter(id => id !== studentId);
    }
    renderManualWorkspace();
}

function renderManualWorkspace() {
    const unassignedContainer = document.getElementById('manualUnassignedList');
    const unassignedCountEl = document.getElementById('manualUnassignedCount');
    const groupsContainer = document.getElementById('manualStagedGroups');
    if (!unassignedContainer || !groupsContainer) return;

    const assignedIds = new Set(manualGroups.flatMap(g => g.studentIds));
    const unassignedStudents = currentAudienceStudents.filter(s => !assignedIds.has(s.user_id));

    if (unassignedCountEl) {
        unassignedCountEl.textContent = `${unassignedStudents.length} remaining`;
    }

    if (unassignedStudents.length === 0) {
        unassignedContainer.innerHTML = '<span class="text-[11px] text-emerald-600 font-semibold italic">All detected students have been assigned to groups!</span>';
    } else {
        unassignedContainer.innerHTML = unassignedStudents.map(s => `
            <div class="inline-flex items-center gap-1.5 px-2 py-1 rounded-md bg-white border border-slate-200 text-[11px] shadow-xs">
                <span class="font-medium text-slate-700">${s.first_name} ${s.last_name}</span>
                <select class="text-[10px] py-0.5 px-1 rounded border border-slate-200 bg-slate-50 text-blue-700 font-bold" onchange="if(this.value !== '') assignStudentToManualGroup(${s.user_id}, this.value)">
                    <option value="">+ Assign</option>
                    ${manualGroups.map((g, idx) => `<option value="${idx}">${g.name}</option>`).join('')}
                </select>
            </div>
        `).join('');
    }

    groupsContainer.innerHTML = manualGroups.map((g, idx) => {
        const assignedStudents = classStudentsRoster.filter(s => g.studentIds.includes(s.user_id));
        return `
            <div class="p-2.5 rounded-lg border border-slate-200 bg-slate-50/70 space-y-2">
                <div class="flex items-center justify-between">
                    <input type="text" class="text-xs font-bold text-slate-800 bg-transparent border-b border-transparent hover:border-slate-300 focus:border-blue-500 focus:bg-white px-1 py-0.5 rounded outline-none" value="${g.name}" onchange="manualGroups[${idx}].name = this.value.trim() || 'Group ${idx + 1}'">
                    <div class="flex items-center gap-1">
                        <span class="text-[10px] font-bold text-blue-700 px-1.5 py-0.5 rounded bg-blue-100">${assignedStudents.length} stds</span>
                        <button type="button" onclick="removeManualGroupCard(${idx})" class="w-5 h-5 rounded flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 transition" title="Delete group">
                            <i class="fas fa-trash text-[10px]"></i>
                        </button>
                    </div>
                </div>
                <div class="space-y-1 min-h-[30px] p-1.5 rounded bg-white border border-slate-200 text-[11px]">
                    ${assignedStudents.length > 0 ? assignedStudents.map(s => `
                        <div class="flex items-center justify-between py-0.5 px-1 rounded hover:bg-slate-50">
                            <span class="text-slate-700 truncate">${s.first_name} ${s.last_name}</span>
                            <button type="button" onclick="unassignStudentFromManualGroup(${s.user_id}, ${idx})" class="text-slate-300 hover:text-rose-500 text-xs ml-1" title="Unassign">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    `).join('') : '<div class="text-slate-400 italic text-[10px] py-1 text-center">No students assigned yet</div>'}
                </div>
            </div>
        `;
    }).join('');
}

async function openGroupSetModal() {
    const pool = getSelectedAudiencePool();
    let poolLabel = 'Entire Class';
    let poolStudents = pool.list;

    if (pool.mode === 'students') {
        if (pool.count > 0) {
            poolLabel = 'Selected Individual Students';
        } else {
            poolLabel = 'Entire Class (No individual students were checked in Assignment form)';
            poolStudents = classStudentsRoster;
        }
    }

    currentAudienceStudents = poolStudents;

    const bannerText = document.getElementById('groupSetAudienceText');
    const bannerBadge = document.getElementById('groupSetAudienceBadge');
    if (bannerText) bannerText.textContent = poolLabel;
    if (bannerBadge) bannerBadge.textContent = `${currentAudienceStudents.length} Students Detected`;

    updateGroupCalcPreview();

    const randomRadio = document.querySelector('input[name="newSetGroupingMode"][value="random"]');
    if (randomRadio) randomRadio.checked = true;
    toggleGroupingMode('random');
    manualGroups = [];

    openModal('groupSetModal');
    loadGroupSets();
}

async function loadGroupSets() {
    const container = document.getElementById('groupSetsContainer');
    if (!container) return;
    container.innerHTML = '<div class="text-center py-6 text-slate-400 text-xs italic">Loading group sets...</div>';
    try {
        const res = await fetch(`/teacher/api/classes/${currentClassId}/group-sets`);
        const data = await res.json();
        const sets = (data && (data.groupSets || data.group_sets)) || [];
        cachedGroupSets = sets;

        if (!data || !data.success || sets.length === 0) {
            container.innerHTML = `
                <div class="p-6 text-center border-2 border-dashed border-slate-200 rounded-2xl bg-slate-50">
                    <i class="fas fa-users-slash text-slate-300 text-2xl mb-2"></i>
                    <p class="text-xs text-slate-500 font-bold">No group sets created for this class yet.</p>
                    <p class="text-[11px] text-slate-400">Use the form above to auto-generate student teams.</p>
                </div>
            `;
            return;
        }

        container.innerHTML = sets.map(gs => {
            const setName = gs.set_name || gs.title || 'Untitled Group Set';
            const groupCount = gs.group_count !== undefined ? gs.group_count : (gs.groups ? gs.groups.length : 0);
            const totalMembers = gs.total_members !== undefined ? gs.total_members : (gs.groups ? gs.groups.reduce((acc, g) => acc + (g.members ? g.members.length : 0), 0) : 0);
            return `
            <div class="p-3.5 rounded-xl bg-white border border-slate-200 shadow-sm space-y-2">
                <div class="flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <span class="w-7 h-7 rounded-lg bg-blue-50 text-blue-600 flex items-center justify-center font-black text-xs">
                            <i class="fas fa-layer-group"></i>
                        </span>
                        <div>
                            <h5 class="font-bold text-xs text-slate-800">${setName}</h5>
                            <p class="text-[10px] text-slate-400">${gs.description || 'No description provided'}</p>
                        </div>
                    </div>
                    <div class="flex items-center gap-2">
                        <span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-blue-50 text-blue-700 border border-blue-100">
                            ${groupCount} Groups · ${totalMembers} Members
                        </span>
                        <button type="button" onclick="deleteGroupSet(${gs.group_set_id})" class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-rose-500 hover:bg-rose-50 transition" title="Delete Group Set">
                            <i class="fas fa-trash text-xs"></i>
                        </button>
                    </div>
                </div>
                ${gs.groups && gs.groups.length > 0 ? `
                    <div class="grid grid-cols-2 sm:grid-cols-3 gap-2 pt-1">
                        ${gs.groups.map(g => `
                            <div class="p-2 rounded-lg bg-slate-50 border border-slate-100 text-[11px] relative">
                                <div class="font-bold text-slate-700 flex items-center justify-between">
                                    <span class="truncate">${g.group_name}</span>
                                    <div class="flex items-center gap-1.5 shrink-0">
                                        <span class="text-[10px] text-slate-400">${g.members ? g.members.length : 0} stds</span>
                                        <button type="button" onclick="deleteIndividualGroup(${g.group_id})" class="text-slate-300 hover:text-rose-500 transition" title="Delete this group">
                                            <i class="fas fa-times text-[10px]"></i>
                                        </button>
                                    </div>
                                </div>
                                <div class="text-[10px] text-slate-500 mt-1 truncate">
                                    ${g.members && g.members.length > 0 ? g.members.map(m => (m.first_name || '') + ' ' + (m.last_name || '')).filter(Boolean).join(', ') : 'No students'}
                                </div>
                            </div>
                        `).join('')}
                    </div>
                ` : '<div class="text-[11px] text-slate-400 italic py-1">No groups currently generated in this set.</div>'}
            </div>
        `;
        }).join('');

        loadGroupSetsDropdown();
    } catch (err) {
        container.innerHTML = `<div class="p-4 text-center text-xs text-rose-500">Failed to load group sets: ${err.message}</div>`;
    }
}

async function submitCreateGroupSet(e) {
    e.preventDefault();
    const btn = document.getElementById('createGroupSetBtn');
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1"></i> Generating...';

    const setName = document.getElementById('newSetName').value.trim();
    const desc = document.getElementById('newSetDesc').value.trim();
    const memberCount = parseInt(document.getElementById('newSetMemberCount')?.value) || 4;
    const mode = document.querySelector('input[name="newSetGroupingMode"]:checked')?.value || 'random';

    const payload = {
        title: setName,
        set_name: setName,
        description: desc
    };

    if (mode === 'manual') {
        const validGroups = manualGroups.filter(g => g.studentIds.length > 0);
        if (validGroups.length === 0) {
            cmToast('Please assign at least one student to a group before submitting manual groups.', 'error');
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-plus"></i> Generate Groups';
            return;
        }
        payload.groups = validGroups.map(g => ({
            group_name: g.name,
            student_ids: g.studentIds
        }));
    } else {
        payload.members_per_group = memberCount;
        payload.candidate_student_ids = currentAudienceStudents.map(s => s.user_id);
        payload.auto_distribute = true;
    }

    try {
        const res = await fetch(`/teacher/api/classes/${currentClassId}/group-sets`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to create group set');

        cmToast('Group set generated successfully!', 'success');
        document.getElementById('createGroupSetForm').reset();
        document.getElementById('newSetMemberCount').value = 4;
        toggleGroupingMode('random');
        manualGroups = [];

        loadGroupSets();
        loadGroupSetsDropdown(data.group_set_id);
    } catch (err) {
        cmToast('Error: ' + err.message, 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-plus"></i> Generate Groups';
    }
}

async function deleteIndividualGroup(groupId) {
    if (!confirm('Are you sure you want to delete this group and unassign its students?')) return;
    try {
        const res = await fetch(`/teacher/api/student-groups/${groupId}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to remove group');

        cmToast('Group removed successfully', 'success');
        loadGroupSets();
        loadGroupSetsDropdown();
    } catch (err) {
        cmToast('Error: ' + err.message, 'error');
    }
}

async function deleteGroupSet(setId) {
    if (!confirm('Are you sure you want to delete this group set and its team assignments?')) return;
    try {
        const res = await fetch(`/teacher/api/group-sets/${setId}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to delete group set');

        cmToast('Group set removed', 'success');
        loadGroupSets();
        loadGroupSetsDropdown();
    } catch (err) {
        cmToast('Error: ' + err.message, 'error');
    }
}

let asgnInitialState = null;
let pendingAssignmentFormData = null;

function autoResizeAsgnField(el) {
    if (!el) return;
    el.style.height = 'auto';
    el.style.height = el.scrollHeight + 'px';
}

function autoResizeAllAsgnFields() {
    const fields = document.querySelectorAll('#assignmentModal .asgn-autofit-field');
    fields.forEach(field => {
        field.style.height = 'auto';
        field.style.height = field.scrollHeight + 'px';
    });
}

function captureAssignmentInitialState() {
    asgnInitialState = {
        name: (document.getElementById('asgnName')?.value || '').trim(),
        category: document.getElementById('asgnCategory')?.value || '',
        items: (document.getElementById('asgnItems')?.value || '').trim(),
        due: (document.getElementById('asgnDue')?.value || '').trim(),
        objectives: (document.getElementById('asgnObjectives')?.value || '').trim(),
        description: (document.getElementById('asgnDescription')?.value || '').trim(),
        guidelines: (document.getElementById('asgnGuidelines')?.value || '').trim(),
        hasFormatFile: !!document.getElementById('asgnFormatFile')?.files?.length,
        hasSampleFile: !!document.getElementById('asgnSampleOutput')?.files?.length
    };
}

function hasUnsavedAssignmentChanges() {
    if (!asgnInitialState) return false;
    const currentName = (document.getElementById('asgnName')?.value || '').trim();
    const currentCategory = document.getElementById('asgnCategory')?.value || '';
    const currentItems = (document.getElementById('asgnItems')?.value || '').trim();
    const currentDue = (document.getElementById('asgnDue')?.value || '').trim();
    const currentObjectives = (document.getElementById('asgnObjectives')?.value || '').trim();
    const currentDescription = (document.getElementById('asgnDescription')?.value || '').trim();
    const currentGuidelines = (document.getElementById('asgnGuidelines')?.value || '').trim();
    const hasFormat = !!document.getElementById('asgnFormatFile')?.files?.length;
    const hasSample = !!document.getElementById('asgnSampleOutput')?.files?.length;

    if (currentName !== asgnInitialState.name) return true;
    if (currentCategory !== asgnInitialState.category) return true;
    if (currentItems !== asgnInitialState.items) return true;
    if (currentDue !== asgnInitialState.due) return true;
    if (currentObjectives !== asgnInitialState.objectives) return true;
    if (currentDescription !== asgnInitialState.description) return true;
    if (currentGuidelines !== asgnInitialState.guidelines) return true;
    if (hasFormat !== asgnInitialState.hasFormatFile) return true;
    if (hasSample !== asgnInitialState.hasSampleFile) return true;

    return false;
}

function handleAssignmentModalClose() {
    if (hasUnsavedAssignmentChanges()) {
        openModal('asgnDiscardConfirmModal');
    } else {
        closeModal('assignmentModal');
        asgnInitialState = null;
    }
}

function confirmDiscardAssignmentChanges() {
    closeModal('asgnDiscardConfirmModal');
    closeModal('assignmentModal');
    asgnInitialState = null;
}

