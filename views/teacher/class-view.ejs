                        <div class="modal-footer bg-slate-50 flex items-center justify-end gap-2">
                            <button type="button" onclick="closeModal('matSaveConfirmModal')" class="sort-btn">
                                Cancel
                            </button>
                            <button type="button" id="matExecuteSaveBtn" onclick="confirmExecuteMaterialSave()" class="sort-btn active" style="background:#0f766e;border-color:#0d9488;color:white">
                                <i class="fas fa-check text-sm"></i> <span id="matExecuteSaveBtnText">Yes, Save Changes</span>
                            </button>
