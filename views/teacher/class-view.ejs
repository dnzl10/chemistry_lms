                                </div>
                            </div>
                            <div class="flex items-center gap-2">
                                <button type="button" onclick="printStudentAttendanceHistory()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                                    <i class="fas fa-print text-xs"></i> <span>Print Slip</span>
