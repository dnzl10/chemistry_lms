        // --- EXPORT ATTENDANCE SUMMARY CSV ---
        function exportAttendanceSummaryCsv() {
            if (!currentAttendanceAnalytics || !currentAttendanceAnalytics.studentStats || !currentAttendanceAnalytics.studentStats.length) {
                alert('No attendance data available to export.');
                return;
            }

            const className = '<%= classInfo.class_name %>'.replace(/[^a-zA-Z0-9]/g, '_');
            const today = new Date().toISOString().slice(0, 10);
            const filename = `Attendance_LMS_Summary_${className}_${today}.csv`;

            const headers = [
                'Student Name', 'LRN', 'Email', 'Gender',
                'LMS Online Now', 'Last LMS Login', 'Total LMS Logins', 'Active LMS Days',
                'Total Sessions Held', 'Present Days', 'Late Days', 'Absent Days', 'Excused Days',
                'Attendance Rate (%)', 'Punctuality Rate (%)', 'Standing Tier', 'Dual Engagement Category', 'Last Attended Date'
            ];
            const rows = currentAttendanceAnalytics.studentStats.map(s => [
                `"${(s.name || '').replace(/"/g, '""')}"`,
                `"${s.lrn_number || ''}"`,
                `"${s.email || ''}"`,
                `"${s.sex || ''}"`,
                s.is_online_now ? 'YES' : 'NO',
                `"${s.last_login_formatted || 'Never'}"`,
                s.total_logins || 0,
                s.active_lms_days || 0,
                s.total_sessions || 0,
                s.present_count || 0,
                s.late_count || 0,
                s.absent_count || 0,
                s.excused_count || 0,
                s.attendance_rate || 0,
                s.punctuality_rate || 0,
                `"${s.tier || ''}"`,
                `"${(s.engagementCategory || '').replace(/"/g, '""')}"`,
                `"${s.last_present_date || ''}"`
            ]);

            const csvContent = '\uFEFF' + [headers.join(','), ...rows.map(r => r.join(','))].join('\r\n');
            const blob = new Blob([csvContent], { type: 'text/csv;charset=utf-8;' });
            const link = document.createElement('a');
            const url = URL.createObjectURL(blob);
            link.setAttribute('href', url);
            link.setAttribute('download', filename);
            link.style.visibility = 'hidden';
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        
