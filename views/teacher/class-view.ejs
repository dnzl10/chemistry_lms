function toggleMaterialDropdownMenu(event, matId) {
    if (event) {
        event.stopPropagation();
        event.preventDefault();
    }
    const menu = document.getElementById('mat-dropdown-' + matId);
    if (!menu) return;
    const isCurrentlyOpen = !menu.classList.contains('hidden');
    
    closeAllMaterialMenus();

    if (!isCurrentlyOpen) {
        menu.classList.remove('hidden');
        // Reposition if menu overflows window bottom
        const rect = menu.getBoundingClientRect();
        if (rect.bottom > window.innerHeight) {
            menu.style.bottom = '100%';
            menu.style.top = 'auto';
            menu.style.marginBottom = '6px';
            menu.style.marginTop = '0';
        } else {
            menu.style.bottom = 'auto';
            menu.style.top = '100%';
            menu.style.marginTop = '6px';
            menu.style.marginBottom = '0';
        }
    }
}

function closeAllMaterialMenus() {
    document.querySelectorAll('.mat-dropdown-menu').forEach(m => {
        m.classList.add('hidden');
    });
}

function selectAllTopicMaterials(topicId) {
    const checkboxes = document.querySelectorAll('.mat-row-cb-' + topicId);
    checkboxes.forEach(cb => {
        cb.checked = true;
        const row = document.getElementById('mat-row-' + cb.getAttribute('data-material-id'));
        if (row) row.classList.add('bg-indigo-50/40');
    });

    const masterCb = document.getElementById('mat-master-cb-' + topicId);
    if (masterCb) {
        masterCb.checked = true;
        masterCb.indeterminate = false;
    }

    // "The Deselect All option should only become visible once the user has triggered 'Select All'."
    document.querySelectorAll('.mat-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));
    document.querySelectorAll('.mat-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));

    updateTopicMaterialBatchBar(topicId);
}

function deselectAllTopicMaterials(topicId) {
    const checkboxes = document.querySelectorAll('.mat-row-cb-' + topicId);
    checkboxes.forEach(cb => {
        cb.checked = false;
        const row = document.getElementById('mat-row-' + cb.getAttribute('data-material-id'));
        if (row) row.classList.remove('bg-indigo-50/40');
    });

    const masterCb = document.getElementById('mat-master-cb-' + topicId);
    if (masterCb) {
        masterCb.checked = false;
        masterCb.indeterminate = false;
    }

    // Reset: hide Deselect All option and restore Select All
    document.querySelectorAll('.mat-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));
    document.querySelectorAll('.mat-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));

    updateTopicMaterialBatchBar(topicId);
}

function toggleAllTopicMaterials(topicId, isChecked) {
    if (isChecked) {
        selectAllTopicMaterials(topicId);
    } else {
        deselectAllTopicMaterials(topicId);
    }
}

function onMaterialRowCheckboxChange(topicId) {
    const checkboxes = Array.from(document.querySelectorAll('.mat-row-cb-' + topicId));
    const checkedBoxes = checkboxes.filter(cb => cb.checked);
    const total = checkboxes.length;
    const checkedCount = checkedBoxes.length;

    // Highlight or unhighlight each row
    checkboxes.forEach(cb => {
        const row = document.getElementById('mat-row-' + cb.getAttribute('data-material-id'));
        if (row) {
            if (cb.checked) {
                row.classList.add('bg-indigo-50/40');
            } else {
                row.classList.remove('bg-indigo-50/40');
            }
        }
    });

    // Update master checkbox state
    const masterCb = document.getElementById('mat-master-cb-' + topicId);
    if (masterCb) {
        if (checkedCount === 0) {
            masterCb.checked = false;
            masterCb.indeterminate = false;
        } else if (checkedCount === total) {
            masterCb.checked = true;
            masterCb.indeterminate = false;
        } else {
            masterCb.checked = false;
            masterCb.indeterminate = true;
        }
    }

    // Adjust Deselect All vs Select All options
    if (checkedCount === total && total > 0) {
        document.querySelectorAll('.mat-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));
        document.querySelectorAll('.mat-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));
    } else if (checkedCount === 0) {
        document.querySelectorAll('.mat-menu-deselect-all-btn-' + topicId).forEach(btn => btn.classList.add('hidden'));
        document.querySelectorAll('.mat-menu-select-all-btn-' + topicId).forEach(btn => btn.classList.remove('hidden'));
    }

    updateTopicMaterialBatchBar(topicId);
}

function updateTopicMaterialBatchBar(topicId) {
    const countSpan = document.getElementById('mat-selected-count-' + topicId);
    const batchBar = document.getElementById('mat-batch-bar-' + topicId);
    if (!batchBar) return;

    const checkedBoxes = document.querySelectorAll('.mat-row-cb-' + topicId + ':checked');
    const count = checkedBoxes.length;

    if (countSpan) countSpan.textContent = count;

    if (count > 0) {
        batchBar.classList.remove('hidden');
        batchBar.classList.add('inline-flex');
    } else {
        batchBar.classList.add('hidden');
        batchBar.classList.remove('inline-flex');
    }
}

async function batchToggleMaterialLock(topicId, lockVal) {
    const checkedBoxes = Array.from(document.querySelectorAll('.mat-row-cb-' + topicId + ':checked'));
    if (!checkedBoxes.length) {
        cmToast('No materials selected.', 'warning');
        return;
    }
    const ids = checkedBoxes.map(cb => cb.getAttribute('data-material-id'));
    const actionWord = lockVal ? 'locked' : 'unlocked';
    cmToast(`Updating ${ids.length} material(s)...`, 'info');

    try {
        const results = await Promise.all(ids.map(id =>
            fetch('/teacher/api/material/' + id + '/lock', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ is_locked: lockVal })
            })
        ));

        const allOk = results.every(r => r.ok);
        if (allOk) {
            cmToast(`Successfully ${actionWord} ${ids.length} material(s).`, 'success');
            // Update UI elements in place for all affected materials
            ids.forEach(id => {
                const accessBtn = document.getElementById('mat-lock-btn-' + id);
                if (accessBtn) {
                    accessBtn.className = 'lock-btn ' + (lockVal ? 'locked' : 'unlocked');
                    accessBtn.style.cssText = 'width:26px;height:26px';
                    const icon = accessBtn.querySelector('i');
                    if (icon) icon.className = 'fas fa-' + (lockVal ? 'lock' : 'lock-open') + ' text-xs';
                    accessBtn.setAttribute('onclick', 'toggleMaterialLock(' + id + ', ' + lockVal + ', this)');
                }
                const menuLockBtn = document.getElementById('mat-menu-lock-' + id);
                if (menuLockBtn) {
                    menuLockBtn.setAttribute('data-locked', lockVal);
                    menuLockBtn.setAttribute('onclick', `closeAllMaterialMenus(); toggleMaterialLockFromMenu(${id}, ${lockVal}, ${topicId})`);
                    const mIcon = menuLockBtn.querySelector('i');
                    if (mIcon) mIcon.className = `fas fa-${lockVal ? 'lock-open' : 'lock'} text-slate-400 w-3.5 text-center`;
                    const mSpan = menuLockBtn.querySelector('span');
                    if (mSpan) mSpan.textContent = lockVal ? 'Unlock' : 'Lock';
                }
            });
        } else {
            cmToast('Some materials could not be updated.', 'warning');
        }
    } catch (e) {
        cmToast('Batch lock update failed. Please try again.', 'error');
    }
}

function batchDeleteMaterials(topicId) {
    const checkedBoxes = Array.from(document.querySelectorAll('.mat-row-cb-' + topicId + ':checked'));
    if (!checkedBoxes.length) {
        cmToast('No materials selected.', 'warning');
        return;
    }
    const ids = checkedBoxes.map(cb => cb.getAttribute('data-material-id'));
    const modalMsg = document.getElementById('deleteModalMsg');
    if (modalMsg) {
        modalMsg.textContent = `Are you sure you want to delete ${ids.length} selected material${ids.length > 1 ? 's' : ''}? This action cannot be undone.`;
    }
    const btn = document.getElementById('confirmDeleteBtn');
    if (btn) {
        btn.onclick = () => executeBatchDeleteMaterials(ids, topicId);
    }
    openModal('deleteModal');
}

async function executeBatchDeleteMaterials(ids, topicId) {
    try {
        const results = await Promise.all(ids.map(id =>
            fetch('/teacher/api/material/' + id, { method: 'DELETE' })
        ));
        closeModal('deleteModal');
        const allOk = results.every(r => r.ok);
        ids.forEach(id => {
            const row = document.getElementById('mat-row-' + id);
            if (row) {
                row.style.transition = 'all 0.25s ease';
                row.style.opacity = '0';
                row.style.transform = 'translateX(16px)';
            }
        });
        if (allOk) {
            cmToast(`Successfully deleted ${ids.length} material(s).`, 'success');
        } else {
            cmToast('Some materials could not be deleted.', 'warning');
        }
        await refreshClassViewContent({ ensureTopicOpen: topicId, ensureSubTab: 'materials' });
    } catch (e) {
        closeModal('deleteModal');
        cmToast('Batch delete failed. Please try again.', 'error');
    }
}

