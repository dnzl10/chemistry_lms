                                        <span id="ssmStudentLevelBadge" class="px-2.5 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-indigo-50 text-indigo-700 border border-indigo-200 flex items-center gap-1">
                                            <i class="fas fa-bolt text-indigo-500"></i> Level 1
                                        </span>
                                    </div>
                                    <p class="text-xs text-slate-500 flex items-center gap-2 mt-1 truncate">
                                        <span id="ssmStudentMeta" class="font-medium text-slate-600 truncate">LRN: — · Grade 11 · Section —</span>
                                        <span class="text-slate-300">|</span>
                                        <span id="ssmSubjectBadge" class="font-semibold text-cyan-700 truncate">Chemistry 1</span>
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                <button type="button" onclick="printStudentScoreSummary()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                                    <i class="fas fa-print text-xs"></i> <span class="hidden sm:inline">Print Slip</span>
                                </button>
                                <button type="button" onclick="closeModal('studentScoresModal')" class="w-8 h-8 rounded-lg hover:bg-slate-100 text-slate-400 flex items-center justify-center text-base transition">
                                    <i class="fas fa-times"></i>
                                </button>
                            </div>
                        </div>

                        <!-- Modal Body (Scrollable) -->
                        <div class="modal-body p-4 sm:p-6 overflow-y-auto flex-1 space-y-6 bg-slate-50/50" id="ssmModalBody">
                            <!-- Loading Skeleton / Spinner -->
                            <div id="ssmLoadingState" class="py-16 text-center">
                                <div class="w-12 h-12 mx-auto mb-3 rounded-full border-4 border-cyan-200 border-t-cyan-600 animate-spin"></div>
                                <h4 class="text-sm font-bold text-slate-700">Loading Student Scores...</h4>
                                <p class="text-xs text-slate-400 mt-1">Synthesizing assessments, assignments, and curriculum topic telemetry</p>
                            </div>

                            <!-- Error State Container (hidden by default) -->
                            <div id="ssmErrorState" class="hidden p-6 rounded-2xl bg-rose-50 border border-rose-200 text-center">
                                <div class="w-12 h-12 mx-auto mb-2 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center text-xl">
                                    <i class="fas fa-exclamation-triangle"></i>
                                </div>
                                <h4 class="text-sm font-bold text-rose-800" id="ssmErrorMessage">Failed to load student scores</h4>
                                <p class="text-xs text-rose-600 mt-1">Please try again or verify instructor access privileges.</p>
                            </div>

                            <!-- Content Container (populated dynamically) -->
                            <div id="ssmContent" class="hidden space-y-6">
