                                <div class="flex items-center gap-2">
                                    <span class="text-[10px] uppercase font-black text-indigo-300">LMS Presence:</span>
                                    <span id="attModalLmsStatusBadge" class="px-2.5 py-0.5 rounded-full text-[10px] font-black bg-slate-800 text-slate-300 border border-slate-700">Offline</span>
