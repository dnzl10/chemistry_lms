/* ================================================================
   CALENDAR GRID
   ================================================================ */
let calYear, calMonth, calSelectedDate = null;
 
function calInit() {
    const now = new Date();
    calYear   = now.getFullYear();
    calMonth  = now.getMonth();
    renderCalendar();
}
 
function calNavMonth(dir) {
    calMonth += dir;
    if (calMonth > 11) { calMonth = 0;  calYear++; }
    if (calMonth < 0)  { calMonth = 11; calYear--; }
    calSelectedDate = null;
    renderCalendar();
}
 
function renderCalendar() {
    const typeFilter = document.getElementById('calTypeFilter')?.value || '';
    const label      = document.getElementById('calMonthLabel');
    const grid       = document.getElementById('calDayGrid');
    if (!label || !grid) return;
 
    label.textContent = new Date(calYear, calMonth, 1)
        .toLocaleDateString('en-PH', { month:'long', year:'numeric' });
 
    const firstDay = new Date(calYear, calMonth, 1).getDay();
    const daysInMonth   = new Date(calYear, calMonth + 1, 0).getDate();
    const daysInPrevMon = new Date(calYear, calMonth, 0).getDate();
    const today         = new Date(); today.setHours(0,0,0,0);
 
    /* Merge events */
    const allEvs = [...CAL_EVENTS, ...ASMT_DEADLINES]
        .filter(e => !typeFilter || e.event_type === typeFilter);
 
    /* Build event map: YYYY-MM-DD → [events] */
    const evMap = {};
    allEvs.forEach(e => {
        const key = e.event_date ? e.event_date.slice(0,10) : null;
        if (!key) return;
        if (!evMap[key]) evMap[key] = [];
        evMap[key].push(e);
        /* Expand recurring within the rendered month */
        if (e.is_repeatable && e.repeat_cycle && e.repeat_cycle !== 'None') {
            const base   = new Date(key + 'T00:00:00');
            const endDay = new Date(calYear, calMonth + 1, 0);
            let   cur    = new Date(base);
            while (cur <= endDay) {
                if (e.repeat_cycle === 'Daily')   cur.setDate(cur.getDate() + 1);
                else if (e.repeat_cycle === 'Weekly')  cur.setDate(cur.getDate() + 7);
                else if (e.repeat_cycle === 'Monthly') cur.setMonth(cur.getMonth() + 1);
                else break;
                const rkey = cur.toISOString().slice(0,10);
                if (!evMap[rkey]) evMap[rkey] = [];
                evMap[rkey].push({ ...e, _recurring: true });
            }
        }
    });
 
    let html = '';
    const totalCells = Math.ceil((firstDay + daysInMonth) / 7) * 7;
 
    for (let i = 0; i < totalCells; i++) {
        let day, month = calMonth, year = calYear, otherMonth = false;
        if (i < firstDay) {
            day = daysInPrevMon - firstDay + i + 1;
            month--; if (month < 0) { month = 11; year--; }
            otherMonth = true;
        } else if (i >= firstDay + daysInMonth) {
            day = i - firstDay - daysInMonth + 1;
            month++; if (month > 11) { month = 0; year++; }
            otherMonth = true;
        } else {
            day = i - firstDay + 1;
        }
 
        const dateStr  = `${year}-${String(month+1).padStart(2,'0')}-${String(day).padStart(2,'0')}`;
        const cellDate = new Date(dateStr + 'T00:00:00');
        const isToday  = cellDate.getTime() === today.getTime();
        const isSel    = calSelectedDate === dateStr;
        const dayEvs   = evMap[dateStr] || [];
        const MAX_SHOW = 2;
 
        const dotHtml = dayEvs.slice(0, MAX_SHOW).map(e =>
            `<div class="cal-event-dot ${EV_DOT_CLASS[e.event_type] || ''}">
                <i class="fas fa-circle" style="font-size:5px"></i>${escHtml(e.event_title.slice(0,12))}
             </div>`
        ).join('');
        const moreHtml = dayEvs.length > MAX_SHOW
            ? `<div class="cal-more">+${dayEvs.length - MAX_SHOW} more</div>` : '';
 
        html += `
        <div class="cal-day${otherMonth?' other-month':''}${isToday?' today':''}${isSel?' selected':''}"
             onclick="selectCalDay('${dateStr}')">
            <div class="cal-day-num">${day}</div>
            ${dotHtml}${moreHtml}
        </div>`;
    }
 
    grid.innerHTML = html;
    renderEventList(calSelectedDate);
}
 
function selectCalDay(dateStr) {
    calSelectedDate = dateStr;
    renderCalendar();
    renderEventList(dateStr);
}
 
function renderEventList(dateStr) {
    const typeFilter = document.getElementById('calTypeFilter')?.value || '';
    const listEl     = document.getElementById('calEventList');
    const dateLabel  = document.getElementById('calEventListDate');
    const countEl    = document.getElementById('calEventListCount');
    if (!listEl) return;
 
    const allEvs = [...CAL_EVENTS, ...ASMT_DEADLINES]
        .filter(e => !typeFilter || e.event_type === typeFilter);
 
    let filtered;
    if (dateStr) {
        filtered = allEvs.filter(e => e.event_date && e.event_date.slice(0,10) === dateStr);
        if (dateLabel) dateLabel.textContent = new Date(dateStr + 'T00:00:00')
            .toLocaleDateString('en-PH',{weekday:'short',month:'short',day:'numeric',year:'numeric'});
    } else {
        filtered = allEvs.filter(e => {
            if (!e.event_date) return false;
            const d = new Date(e.event_date);
            return d.getFullYear() === calYear && d.getMonth() === calMonth;
        });
        filtered.sort((a,b) => new Date(a.event_date) - new Date(b.event_date));
        if (dateLabel) dateLabel.textContent = 'All Events This Month';
    }
 
    if (countEl) countEl.textContent = filtered.length + ' event' + (filtered.length !== 1 ? 's' : '');
 
    if (!filtered.length) {
        listEl.innerHTML = '<p class="cal-empty"><i class="fas fa-calendar-xmark"></i>No events.</p>';
        return;
    }
 
    listEl.innerHTML = filtered.map(e => {
        const color   = EV_COLORS[e.event_type] || '#94a3b8';
        const bClass  = EV_BADGE_CLASS[e.event_type] || '';
        const dateDisp = e.event_date
            ? new Date(e.event_date + 'T00:00:00').toLocaleDateString('en-PH',{month:'short',day:'numeric'})
            : '—';
        const recBadge = e.is_repeatable
            ? `<span class="ev-badge-recurring"><i class="fas fa-rotate text-sm"></i>${e.repeat_cycle}</span>` : '';
        const isCustom = e.event_id && !String(e.event_id).startsWith('asmt-');
        const actions  = isCustom ? `
            <div class="flex gap-1 flex-shrink-0 ml-auto">
                <button class="icon-btn" title="Edit" onclick="openCalModal(${e.event_id})"><i class="fas fa-pen text-sm"></i></button>
                <button class="icon-btn danger" title="Delete" onclick="deleteCalEvent(${e.event_id}, '${escHtml(e.event_title)}')"><i class="fas fa-trash text-sm"></i></button>
            </div>` : '';
 
        return `
        <div class="cal-event-item">
            <div class="cal-event-color-bar" style="background:${color}"></div>
            <div style="flex:1;min-width:0">
                <p class="cal-event-name">${escHtml(e.event_title)}</p>
                <div class="cal-event-meta">
                    <span class="cal-event-type-badge ${bClass}">${e.event_type}</span>
                    <span><i class="far fa-calendar text-slate-300 mr-1"></i>${dateDisp}</span>
                    ${e.event_location && e.event_location !== 'TBA' ? `<span><i class="fas fa-location-dot text-slate-300 mr-1"></i>${escHtml(e.event_location)}</span>` : ''}
                    ${recBadge}
                </div>
                ${e.event_description ? `<p style="font-size:11px;color:#94a3b8;margin-top:3px">${escHtml(e.event_description.slice(0,80))}${e.event_description.length>80?'…':''}</p>` : ''}
            </div>
            ${actions}
        </div>`;
    }).join('');
}
 
/* ================================================================
   TIMELINE
   ================================================================ */
function renderTimeline() {
    const container  = document.getElementById('timelineContainer');
    const days       = parseInt(document.getElementById('timelineDays')?.value || '30');
    const typeFilter = document.getElementById('timelineTypeFilter')?.value || '';
    if (!container) return;
 
    const today = new Date(); today.setHours(0,0,0,0);
    const cutoff = days > 0 ? new Date(today.getTime() + days * 86400000) : null;
 
    const allEvs = [...CAL_EVENTS, ...ASMT_DEADLINES]
        .filter(e => !typeFilter || e.event_type === typeFilter)
        .filter(e => e.event_date)
        .map(e => ({ ...e, _date: new Date(e.event_date.slice(0,10) + 'T00:00:00') }))
        .filter(e => !cutoff || e._date <= cutoff)
        .sort((a,b) => a._date - b._date);
 
    if (!allEvs.length) {
        container.innerHTML = `
            <div class="standard-empty-state" style="margin:0;">
                <div class="w-14 h-14 rounded-2xl bg-emerald-50 border border-emerald-100 text-emerald-500 flex items-center justify-center text-2xl mx-auto mb-3.5 shadow-sm">
                    <i class="fas fa-calendar-check"></i>
                </div>
                <h4 class="text-sm font-bold text-slate-700 mb-1">No upcoming events in this period</h4>
                <p class="text-xs text-slate-400 max-w-sm mx-auto mb-4">There are no scheduled deadlines, exams, or materials due within the selected timeframe.</p>
                <button type="button" class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-lg text-xs font-semibold bg-violet-600 hover:bg-violet-700 text-white shadow-sm transition" onclick="openCalModal(null)">
                    <i class="fas fa-plus text-[10px]"></i> Schedule New Event
                </button>
            </div>`;
        return;
    }
 
    /* Group by date */
    const groups = {};
    allEvs.forEach(e => {
        const key = e.event_date.slice(0,10);
        if (!groups[key]) groups[key] = [];
        groups[key].push(e);
    });
 
    const todayStr = today.toISOString().slice(0,10);
    let html = '';
 
    Object.keys(groups).sort().forEach(dateStr => {
        const evDate   = new Date(dateStr + 'T00:00:00');
        const diffDays = Math.round((evDate - today) / 86400000);
        const dateDisp = evDate.toLocaleDateString('en-PH',{weekday:'long',month:'long',day:'numeric',year:'numeric'});
 
        let dayLabel = '';
        if (diffDays < 0)  dayLabel = `<span class="tl-days-left tl-overdue">${Math.abs(diffDays)}d overdue</span>`;
        else if (diffDays === 0) dayLabel = `<span class="tl-days-left tl-today">Today</span>`;
        else if (diffDays <= 3)  dayLabel = `<span class="tl-days-left tl-soon">In ${diffDays}d</span>`;
        else if (diffDays <= 14) dayLabel = `<span class="tl-days-left tl-upcoming">In ${diffDays}d</span>`;
        else                     dayLabel = `<span class="tl-days-left tl-far">In ${diffDays}d</span>`;
 
        html += `<div class="timeline-group">
            <div class="timeline-date-label">${dateDisp} ${dayLabel}</div>`;
 
        groups[dateStr].forEach((e, idx) => {
            const dotCls   = TL_DOT_CLASS[e.event_type] || 'td-material';
            const color    = EV_COLORS[e.event_type]    || '#94a3b8';
            const isCustom = e.event_id && !String(e.event_id).startsWith('asmt-');
            const bClass   = EV_BADGE_CLASS[e.event_type] || '';
            const recBadge = e.is_repeatable
                ? `<span class="ev-badge-recurring" style="font-size:9px"><i class="fas fa-rotate" style="font-size:8px"></i>${e.repeat_cycle}</span>` : '';
            const locText  = e.event_location && e.event_location !== 'TBA'
                ? `<span><i class="fas fa-location-dot" style="color:#d1d5db;font-size:9px;margin-right:2px"></i>${escHtml(e.event_location)}</span>` : '';
            const durText  = e.duration_minutes
                ? `<span><i class="fas fa-clock" style="color:#d1d5db;font-size:9px;margin-right:2px"></i>${e.duration_minutes}min</span>` : '';
            const actions  = isCustom ? `
                <div class="flex gap-1 flex-shrink-0">
                    <button class="icon-btn" title="Edit" onclick="openCalModal(${e.event_id})"><i class="fas fa-pen text-sm"></i></button>
                    <button class="icon-btn danger" title="Delete" onclick="deleteCalEvent(${e.event_id}, '${escHtml(e.event_title)}')"><i class="fas fa-trash text-sm"></i></button>
                </div>` : '';
 
            html += `
            <div class="timeline-item">
                <div class="timeline-line" style="position:relative">
                    <div class="timeline-dot ${dotCls}"></div>
                    ${idx < groups[dateStr].length - 1 ? `<div style="position:absolute;left:4px;top:14px;width:1.5px;bottom:-14px;background:#f1f5f9"></div>` : ''}
                </div>
                <div style="flex:1;min-width:0">
                    <div style="display:flex;align-items:flex-start;justify-content:space-between;gap:8px;flex-wrap:wrap">
                        <div>
                            <p class="tl-name">${escHtml(e.event_title)}</p>
                            <div class="tl-meta">
                                <span class="cal-event-type-badge ${bClass}" style="font-size:9px">${e.event_type}</span>
                                ${locText}${durText}${recBadge}
                            </div>
                        </div>
                        ${actions}
                    </div>
                </div>
            </div>`;
        });
 
        html += `</div>`;
    });
 
    container.innerHTML = html;
}
 
/* ================================================================
   CALENDAR MODAL OPEN/CLOSE
   ================================================================ */
function openCalModal(eventId) {
    const form = document.getElementById('calEventForm');
    form.reset();
    document.getElementById('calEventId').value = '';
    document.getElementById('calModalTitle').textContent = 'New Calendar Event';
 
    /* Set today as default date */
    document.getElementById('calEventDate').value = new Date().toISOString().slice(0,10);
 
    toggleDurationFields('None');
    toggleRepeatField(false);
 
    if (eventId) {
        const ev = CAL_EVENTS.find(e => e.event_id === eventId);
        if (ev) {
            document.getElementById('calModalTitle').textContent    = 'Edit Event';
            document.getElementById('calEventId').value             = ev.event_id;
            document.getElementById('calEventTitle').value          = ev.event_title;
            document.getElementById('calEventType').value           = ev.event_type;
            document.getElementById('calEventDate').value           = ev.event_date?.slice(0,10) || '';
            document.getElementById('calDurationType').value        = ev.duration_type || 'None';
            document.getElementById('calEventLocation').value       = ev.event_location || 'TBA';
            document.getElementById('calEventDesc').value           = ev.event_description || '';
            document.getElementById('calIsRepeatable').checked      = !!ev.is_repeatable;
            if (ev.start_date) document.getElementById('calStartDate').value   = ev.start_date.slice(0,16);
            if (ev.end_date)   document.getElementById('calEndDate').value     = ev.end_date.slice(0,16);
            if (ev.duration_minutes) document.getElementById('calDurationMins').value = ev.duration_minutes;
            if (ev.repeat_cycle) document.getElementById('calRepeatCycle').value = ev.repeat_cycle;
            toggleDurationFields(ev.duration_type || 'None');
            toggleRepeatField(!!ev.is_repeatable);
        }
    }
 
    document.getElementById('calModal').classList.add('open');
}
 
function closeCalModal() {
    document.getElementById('calModal').classList.remove('open');
}
document.getElementById('calModal').addEventListener('click', function(e) {
    if (e.target === this) closeCalModal();
});
 
function toggleDurationFields(val) {
    document.getElementById('durRangeFields').classList.toggle('visible',  val === 'DateRange');
    document.getElementById('durMinutesField').classList.toggle('visible', val === 'Minutes');
}
 
function toggleRepeatField(show) {
    document.getElementById('repeatCycleField').classList.toggle('visible', show);
}
 
/* ================================================================
   CALENDAR EVENT FORM SUBMIT
   ================================================================ */
async function submitCalEvent(e) {
    e.preventDefault();
    const fd     = new FormData(e.target);
    const id     = fd.get('event_id');
    const url    = id ? '/teacher/api/calendar-event/' + id : '/teacher/api/calendar-event';
    const method = id ? 'PUT' : 'POST';
 
    const body = {
        subject_id:        fd.get('subject_id'),
        event_title:       fd.get('event_title'),
        event_type:        fd.get('event_type'),
        event_date:        fd.get('event_date'),
        duration_type:     fd.get('duration_type'),
        start_date:        fd.get('start_date')       || null,
        end_date:          fd.get('end_date')         || null,
        duration_minutes:  fd.get('duration_minutes') ? Number(fd.get('duration_minutes')) : null,
        event_location:    fd.get('event_location')   || 'TBA',
        event_description: fd.get('event_description')|| null,
        is_repeatable:     fd.get('is_repeatable')    ? 1 : 0,
        repeat_cycle:      fd.get('is_repeatable')    ? (fd.get('repeat_cycle') || 'None') : 'None',
    };
 
    try {
        const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error('Server ' + res.status);
        closeCalModal();
        cmToast('Event saved successfully!', 'success');
