                                        <option value="word">Word Document (.doc, .docx)</option>
                                        <option value="video">Video (.mp4, .mkv, .webm, .ogg)</option>
                                        <option value="presentation">Presentation (.ppt, .pptx)</option>
                                        <option value="img">Image (.jpg, .png, .webp, .gif)</option>
                                        <option value="link">Link / URL</option>
