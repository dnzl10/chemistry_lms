        // --- DAILY ROLL CALL SHEET FUNCTIONS ---
        function getAttendanceTodayStr() {
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function updateAttendanceDateNavState() {
            const picker = document.getElementById('attendanceDatePicker');
            const nextBtn = document.getElementById('attNextDayBtn');
            if (!picker) return;
            const todayStr = getAttendanceTodayStr();
            picker.max = todayStr;
            const curVal = picker.value || todayStr;
            const isTodayOrFuture = curVal >= todayStr;
            if (nextBtn) {
                nextBtn.disabled = isTodayOrFuture;
                if (isTodayOrFuture) {
                    nextBtn.classList.add('opacity-40', 'cursor-not-allowed');
                    nextBtn.title = 'Cannot navigate to future dates';
                } else {
                    nextBtn.classList.remove('opacity-40', 'cursor-not-allowed');
                    nextBtn.title = 'Next Day';
                }
            }
        }

        async function loadAttendance() {
            const picker = document.getElementById('attendanceDatePicker');
            const todayStr = getAttendanceTodayStr();
            if (picker) {
                picker.max = todayStr;
                if (!picker.value) picker.value = todayStr;
            }
            const date = picker?.value || todayStr;
            const isFuture = date > todayStr;

            updateAttendanceDateNavState();

            // Toggle Future Date Warning Banner & Control Buttons State
            const banner = document.getElementById('attendanceFutureDateBanner');
            const bannerText = document.getElementById('attendanceFutureDateText');
            if (banner) {
                if (isFuture) {
                    banner.classList.remove('hidden');
                    if (bannerText) {
                        bannerText.textContent = `Attendance cannot be marked or saved for future dates (${date}). Form controls are disabled.`;
                    }
                } else {
                    banner.classList.add('hidden');
                }
            }

            const saveBtn = document.getElementById('saveAttendanceBtn');
            if (saveBtn) {
                saveBtn.disabled = isFuture;
                if (isFuture) {
                    saveBtn.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                    saveBtn.title = 'Cannot save attendance for future dates';
                } else {
                    saveBtn.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                    saveBtn.title = 'Save Attendance';
                }
            }

            const markAllBtn = document.getElementById('markAllPresentBtn');
            if (markAllBtn) {
                markAllBtn.disabled = isFuture;
                if (isFuture) {
                    markAllBtn.classList.add('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                    markAllBtn.title = 'Cannot mark attendance for future dates';
                } else {
                    markAllBtn.classList.remove('opacity-40', 'cursor-not-allowed', 'pointer-events-none');
                    markAllBtn.title = 'Mark All Present';
                }
            }

            const tbody = document.getElementById('attendanceTableBody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="table-empty-cell">
                        <div class="standard-empty-state" style="min-height: 410px;">
                            <div class="w-14 h-14 rounded-2xl bg-emerald-50 text-emerald-600 flex items-center justify-center text-2xl mx-auto mb-3.5 shadow-sm border border-emerald-100">
                                <i class="fas fa-spinner fa-spin"></i>
                            </div>
                            <h4 class="text-sm font-bold text-slate-700 mb-1">Loading attendance for ${date}…</h4>
                            <p class="text-xs text-slate-400 max-w-sm mx-auto">Fetching daily roll-call statuses and check-in records.</p>
                        </div>
                    </td>
                </tr>`;

            try {
                const res = await fetch('/teacher/api/attendance/<%= classInfo.class_id %>?date=' + encodeURIComponent(date));
                const data = await res.json();
                if (!data.success) throw new Error(data.error || 'Failed to load attendance');

                currentAttendanceRecords = data.students || [];

                // Update KPIs
                document.getElementById('attKpiTotal').textContent = data.summary.total;
                document.getElementById('attKpiPresent').textContent = data.summary.present;
                document.getElementById('attKpiLate').textContent = data.summary.late;
                document.getElementById('attKpiAbsent').textContent = data.summary.absent;
                document.getElementById('attKpiExcused').textContent = data.summary.excused;
                document.getElementById('attKpiUnmarked').textContent = data.summary.unmarked;

                if (!currentAttendanceRecords.length) {
                    captureAttendanceInitialSnapshot([], date);
                    tbody.innerHTML = `
                        <tr>
                            <td colspan="6" class="table-empty-cell">
                                <div class="standard-empty-state" style="min-height: 410px;">
                                    <div class="w-14 h-14 rounded-2xl bg-slate-100 border border-slate-200 text-slate-400 flex items-center justify-center text-xl mx-auto mb-3.5 shadow-sm">
                                        <i class="fas fa-user-slash"></i>
                                    </div>
                                    <h4 class="text-sm font-bold text-slate-700 mb-1">No students enrolled yet</h4>
                                    <p class="text-xs text-slate-400 max-w-sm mx-auto">Once students are enrolled in this class section, their daily roll call rows will appear here.</p>
                                </div>
                            </td>
                        </tr>`;
                    return;
                }

                let rowsHtml = '';
                currentAttendanceRecords.forEach((s, idx) => {
                    const avatar = s.profile_pic ? '/profile_uploads/' + s.profile_pic : '/assets/logo.png';
                    const timeInVal = s.check_in_time || '08:00';
                    const reasonVal = s.override_reason || '';
                    const st = s.status || 'Unmarked';

                    rowsHtml += `
                    <tr class="hover:bg-slate-50/80 transition ${isFuture ? 'opacity-75 bg-slate-50/40' : ''}" id="att-row-${s.student_id}">
                        <td class="text-xs font-black text-slate-400">${idx + 1}</td>
                        <td>
                            <div class="flex items-center gap-3">
                                <img src="${avatar}" class="w-8 h-8 rounded-full object-cover border border-slate-200" onerror="this.src='/assets/logo.png'">
                                <div>
                                    <p class="font-bold text-xs text-slate-800 leading-tight">${s.last_name}, ${s.first_name}</p>
                                    <span class="text-[10px] text-slate-400">${s.sex || '—'}</span>
                                </div>
                            </div>
                        </td>
                        <td class="text-xs font-mono text-slate-600">${s.lrn_number || '—'}</td>
                        <td class="text-center">
                            <div class="inline-flex rounded-xl p-1 bg-slate-100 border border-slate-200 gap-1 ${isFuture ? 'opacity-60 cursor-not-allowed pointer-events-none' : ''}" data-student-id="${s.student_id}">
                                <button type="button" ${isFuture ? 'disabled' : `onclick="setStudentStatus(${s.student_id}, 'Present')"`}
                                    class="att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition ${st === 'Present' ? 'bg-emerald-600 text-white shadow-sm' : 'text-slate-500 hover:text-emerald-700'}" data-status="Present">
                                    Pres
                                </button>
                                <button type="button" ${isFuture ? 'disabled' : `onclick="setStudentStatus(${s.student_id}, 'Late')"`}
                                    class="att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition ${st === 'Late' ? 'bg-amber-500 text-white shadow-sm' : 'text-slate-500 hover:text-amber-700'}" data-status="Late">
                                    Late
                                </button>
                                <button type="button" ${isFuture ? 'disabled' : `onclick="setStudentStatus(${s.student_id}, 'Absent')"`}
                                    class="att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition ${st === 'Absent' ? 'bg-rose-600 text-white shadow-sm' : 'text-slate-500 hover:text-rose-700'}" data-status="Absent">
                                    Abs
                                </button>
                                <button type="button" ${isFuture ? 'disabled' : `onclick="setStudentStatus(${s.student_id}, 'Excused')"`}
                                    class="att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition ${st === 'Excused' ? 'bg-sky-600 text-white shadow-sm' : 'text-slate-500 hover:text-sky-700'}" data-status="Excused">
                                    Exc
                                </button>
                            </div>
                        </td>
                        <td>
                            <input type="time" id="att-time-${s.student_id}" value="${timeInVal}" ${isFuture ? 'disabled' : 'oninput="checkAttendanceDirtyState()" onchange="checkAttendanceDirtyState()"'} class="px-2 py-1 text-xs font-bold border border-slate-200 rounded-lg bg-white text-slate-700 focus:ring-1 focus:ring-indigo-500 ${isFuture ? 'bg-slate-100 cursor-not-allowed opacity-60' : ''}">
                        </td>
                        <td>
                            <input type="text" id="att-reason-${s.student_id}" value="${reasonVal}" ${isFuture ? 'disabled' : 'oninput="checkAttendanceDirtyState()" onchange="checkAttendanceDirtyState()"'} placeholder="${isFuture ? 'Cannot mark attendance for future dates' : 'e.g. Medical excuse / tardy note'}" class="w-full px-2.5 py-1 text-xs border border-slate-200 rounded-lg bg-white text-slate-700 placeholder-slate-300 focus:ring-1 focus:ring-indigo-500 ${isFuture ? 'bg-slate-100 cursor-not-allowed opacity-60' : ''}">
                        </td>
                    </tr>`;
                });
                tbody.innerHTML = rowsHtml;
                captureAttendanceInitialSnapshot(currentAttendanceRecords, date);
            } catch (err) {
                console.error(err);
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="table-empty-cell">
                            <div class="standard-empty-state" style="min-height: 410px;">
                                <div class="w-14 h-14 rounded-2xl bg-rose-50 border border-rose-100 text-rose-500 flex items-center justify-center text-xl mx-auto mb-3.5 shadow-sm">
                                    <i class="fas fa-circle-exclamation"></i>
                                </div>
                                <h4 class="text-sm font-bold text-rose-600 mb-1">Failed to load attendance</h4>
                                <p class="text-xs text-slate-400 max-w-sm mx-auto">${escHtml(err.message)}</p>
                            </div>
                        </td>
                    </tr>`;
            }
        }

        function captureAttendanceInitialSnapshot(students, date) {
            lastLoadedAttendanceDate = date || getAttendanceTodayStr();
            attendanceInitialSnapshot = {};
            (students || []).forEach(s => {
                attendanceInitialSnapshot[s.student_id] = {
                    status: s.status || 'Unmarked',
                    timeIn: s.check_in_time || '08:00',
                    reason: (s.override_reason || '').trim()
                };
            });
            setAttendanceDirtyState(false, 0);
        }

        function getCurrentStudentAttendanceDomState(studentId) {
            const container = document.querySelector(`[data-student-id="${studentId}"]`);
            let status = 'Unmarked';
            if (container) {
                const activeBtn = container.querySelector('.text-white');
                if (activeBtn) status = activeBtn.getAttribute('data-status') || 'Unmarked';
            }
            const timeIn = document.getElementById('att-time-' + studentId)?.value || '08:00';
            const reason = (document.getElementById('att-reason-' + studentId)?.value || '').trim();
            return { status, timeIn, reason };
        }

        function setAttendanceDirtyState(isDirty, changedCount) {
            hasUnsavedAttendanceChanges = !!isDirty;
            unsavedAttendanceModifiedCount = changedCount || 0;
            const badge = document.getElementById('unsavedAttendanceBadge');
            const saveBtn = document.getElementById('saveAttendanceBtn');
            if (badge) {
                if (hasUnsavedAttendanceChanges) {
                    badge.textContent = unsavedAttendanceModifiedCount > 0 ? `${unsavedAttendanceModifiedCount} Unsaved` : 'Unsaved';
                    badge.classList.remove('hidden');
                } else {
                    badge.classList.add('hidden');
                }
            }
            if (saveBtn) {
                if (hasUnsavedAttendanceChanges) {
                    saveBtn.classList.add('ring-2', 'ring-amber-400', 'ring-offset-1');
                } else {
                    saveBtn.classList.remove('ring-2', 'ring-amber-400', 'ring-offset-1');
                }
            }
        }

        function checkAttendanceDirtyState() {
            if (!Array.isArray(currentAttendanceRecords) || !currentAttendanceRecords.length) {
                setAttendanceDirtyState(false, 0);
                return false;
            }
            let changedCount = 0;
            currentAttendanceRecords.forEach(s => {
                const initial = attendanceInitialSnapshot[s.student_id];
                if (!initial) return;
                const current = getCurrentStudentAttendanceDomState(s.student_id);
                if (
                    current.status !== initial.status ||
                    current.timeIn !== initial.timeIn ||
                    current.reason !== initial.reason
                ) {
                    changedCount++;
                }
            });
            setAttendanceDirtyState(changedCount > 0, changedCount);
            return changedCount > 0;
        }

        function revertUnsavedAttendanceDomToSnapshot() {
            if (!Array.isArray(currentAttendanceRecords)) return;
            currentAttendanceRecords.forEach(s => {
                const initial = attendanceInitialSnapshot[s.student_id];
                if (!initial) return;
                const container = document.querySelector(`[data-student-id="${s.student_id}"]`);
                if (container) {
                    const buttons = container.querySelectorAll('.att-btn');
                    buttons.forEach(btn => {
                        const st = btn.getAttribute('data-status');
                        btn.className = 'att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition text-slate-500 hover:text-indigo-700';
                        if (st === initial.status) {
                            if (st === 'Present') btn.className = 'att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition bg-emerald-600 text-white shadow-sm';
                            else if (st === 'Late') btn.className = 'att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition bg-amber-500 text-white shadow-sm';
                            else if (st === 'Absent') btn.className = 'att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition bg-rose-600 text-white shadow-sm';
                            else if (st === 'Excused') btn.className = 'att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition bg-sky-600 text-white shadow-sm';
                        }
                    });
                }
                const timeInput = document.getElementById('att-time-' + s.student_id);
                if (timeInput) timeInput.value = initial.timeIn;
                const reasonInput = document.getElementById('att-reason-' + s.student_id);
                if (reasonInput) reasonInput.value = initial.reason;
            });
            recalculateAttendanceKpis();
            setAttendanceDirtyState(false, 0);
        }

        function guardUnsavedAttendance(actionFn) {
            if (!hasUnsavedAttendanceChanges || bypassUnsavedAttendanceGuard) {
                if (typeof actionFn === 'function') actionFn();
                return;
            }
            pendingAttendanceNavigationAction = actionFn;
            const summaryBadge = document.getElementById('unsavedAttendanceSummaryBadge');
            const detailsEl = document.getElementById('unsavedAttendanceDetails');
            const count = unsavedAttendanceModifiedCount || 1;
            const dateLabel = lastLoadedAttendanceDate || getAttendanceTodayStr();
            if (summaryBadge) {
                summaryBadge.textContent = `${count} modified student record${count === 1 ? '' : 's'} for ${dateLabel}`;
            }
            if (detailsEl) {
                detailsEl.textContent = `You took or modified attendance for ${count} student${count === 1 ? '' : 's'} on ${dateLabel} without clicking "Save Attendance". Would you like to save before leaving?`;
            }
            openModal('unsavedAttendanceModal');
        }

        function closeUnsavedAttendanceModal() {
            pendingAttendanceNavigationAction = null;
            closeModal('unsavedAttendanceModal');
        }

        function confirmDiscardUnsavedAttendance() {
            const action = pendingAttendanceNavigationAction;
            pendingAttendanceNavigationAction = null;
            closeModal('unsavedAttendanceModal');
            revertUnsavedAttendanceDomToSnapshot();
            if (typeof action === 'function') {
                bypassUnsavedAttendanceGuard = true;
                try {
                    action();
                } finally {
                    bypassUnsavedAttendanceGuard = false;
                }
            }
        }

        async function confirmSaveAndContinueAttendance() {
            const saveContBtn = document.getElementById('unsavedAttSaveAndContinueBtn');
            const origBtnHtml = saveContBtn ? saveContBtn.innerHTML : '';
            if (saveContBtn) {
                saveContBtn.disabled = true;
                saveContBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs mr-1.5"></i> Saving...';
            }
            try {
                const ok = await saveAttendance({ silentSuccessModal: true });
                if (!ok) return;
                const action = pendingAttendanceNavigationAction;
                pendingAttendanceNavigationAction = null;
                closeModal('unsavedAttendanceModal');
                if (typeof cmToast === 'function') {
                    cmToast('Attendance saved successfully!', 'success');
                }
                if (typeof action === 'function') {
                    bypassUnsavedAttendanceGuard = true;
                    try {
                        action();
                    } finally {
                        bypassUnsavedAttendanceGuard = false;
                    }
                }
            } finally {
                if (saveContBtn) {
                    saveContBtn.disabled = false;
                    saveContBtn.innerHTML = origBtnHtml;
                }
            }
        }

        function onAttendanceDatePickerChange() {
            const picker = document.getElementById('attendanceDatePicker');
            const targetDateStr = picker?.value || getAttendanceTodayStr();
            if (hasUnsavedAttendanceChanges && !bypassUnsavedAttendanceGuard && lastLoadedAttendanceDate && targetDateStr !== lastLoadedAttendanceDate) {
                if (picker) picker.value = lastLoadedAttendanceDate;
                guardUnsavedAttendance(function() {
                    if (picker) picker.value = targetDateStr;
                    loadAttendance();
                });
                return;
            }
            loadAttendance();
        }

        function changeAttendanceDate(offset) {
            const picker = document.getElementById('attendanceDatePicker');
            const todayStr = getAttendanceTodayStr();
            const curVal = picker?.value || todayStr;
            const parts = curVal.split('-').map(Number);
            const d = new Date(parts[0], parts[1] - 1, parts[2]);
            d.setDate(d.getDate() + offset);
            const y = d.getFullYear();
            const m = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            const targetDateStr = `${y}-${m}-${day}`;

            if (targetDateStr > todayStr) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Future Date Restricted',
                        text: 'Attendance cannot be marked for future dates.',
                        timer: 2000,
                        showConfirmButton: false
                    });
                }
                updateAttendanceDateNavState();
                return;
            }

            if (hasUnsavedAttendanceChanges && !bypassUnsavedAttendanceGuard && targetDateStr !== curVal) {
                guardUnsavedAttendance(function() {
                    picker.value = targetDateStr;
                    loadAttendance();
                });
                return;
            }

            picker.value = targetDateStr;
            loadAttendance();
        }

        function setAttendanceToday() {
            const picker = document.getElementById('attendanceDatePicker');
            const todayStr = getAttendanceTodayStr();
            if (hasUnsavedAttendanceChanges && !bypassUnsavedAttendanceGuard && picker && picker.value !== todayStr) {
                guardUnsavedAttendance(function() {
                    picker.value = todayStr;
                    loadAttendance();
                });
                return;
            }
            if (picker) picker.value = todayStr;
            loadAttendance();
        }

        function setStudentStatus(studentId, status) {
            const picker = document.getElementById('attendanceDatePicker');
            const curDate = picker?.value || getAttendanceTodayStr();
            if (curDate > getAttendanceTodayStr()) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Future Date', text: 'Attendance cannot be marked for future dates.' });
                }
                return;
            }
            const container = document.querySelector(`[data-student-id="${studentId}"]`);
            if (!container) return;
            const buttons = container.querySelectorAll('.att-btn');
            buttons.forEach(btn => {
                const s = btn.getAttribute('data-status');
                btn.className = 'att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition text-slate-500 hover:text-indigo-700';
                if (s === status) {
                    if (status === 'Present') btn.className = 'att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition bg-emerald-600 text-white shadow-sm';
                    else if (status === 'Late') btn.className = 'att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition bg-amber-500 text-white shadow-sm';
                    else if (status === 'Absent') btn.className = 'att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition bg-rose-600 text-white shadow-sm';
                    else if (status === 'Excused') btn.className = 'att-btn px-2.5 py-1 rounded-lg text-[10px] font-black uppercase transition bg-sky-600 text-white shadow-sm';
                }
            });
            recalculateAttendanceKpis();
            checkAttendanceDirtyState();
        }

        function markAllAttendance(status) {
            const picker = document.getElementById('attendanceDatePicker');
            const curDate = picker?.value || getAttendanceTodayStr();
            if (curDate > getAttendanceTodayStr()) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'warning', title: 'Future Date', text: 'Attendance cannot be marked for future dates.' });
                }
                return;
            }
            currentAttendanceRecords.forEach(s => {
                setStudentStatus(s.student_id, status);
            });
            checkAttendanceDirtyState();
        }

        function recalculateAttendanceKpis() {
            let p = 0, l = 0, a = 0, e = 0, u = 0;
            currentAttendanceRecords.forEach(s => {
                const container = document.querySelector(`[data-student-id="${s.student_id}"]`);
                if (!container) return;
                const activeBtn = container.querySelector('.text-white');
                if (!activeBtn) { u++; return; }
                const st = activeBtn.getAttribute('data-status');
                if (st === 'Present') p++;
                else if (st === 'Late') l++;
                else if (st === 'Absent') a++;
                else if (st === 'Excused') e++;
                else u++;
            });
            document.getElementById('attKpiPresent').textContent = p;
            document.getElementById('attKpiLate').textContent = l;
            document.getElementById('attKpiAbsent').textContent = a;
            document.getElementById('attKpiExcused').textContent = e;
            document.getElementById('attKpiUnmarked').textContent = u;
        }

        async function saveAttendance(options) {
            const opts = options || {};
            const picker = document.getElementById('attendanceDatePicker');
            const date = picker?.value || getAttendanceTodayStr();
            const todayStr = getAttendanceTodayStr();
            if (date > todayStr) {
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Future Date Not Allowed', text: 'Attendance cannot be recorded or saved for future dates.' });
                } else {
                    alert('Attendance cannot be recorded or saved for future dates.');
                }
                return false;
            }

            const btn = document.getElementById('saveAttendanceBtn');
            const origHtml = btn.innerHTML;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i> Saving...';
            btn.disabled = true;

            const records = [];

            currentAttendanceRecords.forEach(s => {
                const container = document.querySelector(`[data-student-id="${s.student_id}"]`);
                let status = 'Present';
                if (container) {
                    const activeBtn = container.querySelector('.text-white');
                    if (activeBtn) status = activeBtn.getAttribute('data-status');
                }
                const timeIn = document.getElementById('att-time-' + s.student_id)?.value || null;
                const reason = document.getElementById('att-reason-' + s.student_id)?.value || null;

                records.push({
                    student_id: s.student_id,
                    status: status,
                    check_in_time: timeIn,
                    override_reason: reason
                });
            });

            try {
                const res = await fetch('/teacher/api/attendance/<%= classInfo.class_id %>/save', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ date, records })
                });
                const data = await res.json();
                if (!data.success) throw new Error(data.error || 'Failed to save attendance');

                setAttendanceDirtyState(false, 0);

                if (!opts.silentSuccessModal) {
                    const detailsEl = document.getElementById('attendanceSuccessDetails');
                    if (detailsEl) {
                        if (records.length > 0) {
                            detailsEl.textContent = 'Successfully recorded attendance for ' + records.length + ' student' + (records.length === 1 ? '.' : 's.');
                        } else {
                            detailsEl.textContent = 'All student attendance records have been securely logged and updated for this class session.';
                        }
                    }
                    openModal('attendanceSuccessModal');
                }

                await loadAttendance();
                loadAttendanceAnalytics();
                return true;
            } catch (err) {
                console.error(err);
                if (typeof Swal !== 'undefined') {
                    Swal.fire({ icon: 'error', title: 'Save Failed', text: err.message });
                } else {
                    alert('Save failed: ' + err.message);
                }
                return false;
            } finally {
                btn.innerHTML = origHtml;
                btn.disabled = false;
                checkAttendanceDirtyState();
            }
        }

        // Intercept link clicks and page exits when attendance changes are unsaved
        document.addEventListener('click', function(e) {
            if (!hasUnsavedAttendanceChanges || bypassUnsavedAttendanceGuard) return;
            const link = e.target.closest('a[href]');
            if (!link) return;
            const rawHref = link.getAttribute('href') || '';
            if (
                !rawHref ||
                rawHref.startsWith('#') ||
                rawHref.toLowerCase().startsWith('javascript:') ||
                link.target === '_blank' ||
                link.hasAttribute('download')
            ) {
                return;
            }
            e.preventDefault();
            e.stopPropagation();
            const destUrl = link.href;
            guardUnsavedAttendance(function() {
                window.location.href = destUrl;
            });
        }, true);

        window.addEventListener('beforeunload', function(e) {
            if (hasUnsavedAttendanceChanges && !bypassUnsavedAttendanceGuard) {
                e.preventDefault();
                e.returnValue = '';
                return '';
            }
        });
    

        // =====================================================================
        // STUDENT DETAILED SCORES & TOPIC PERFORMANCE MODAL CONTROLLER
        // =====================================================================

        let studentTopicScoreChart = null;
        let _currentStudentScoresData = null;

        async function openStudentScoresModal(studentId, subjectId, classId) {
            const loadingState = document.getElementById('ssmLoadingState');
            const errorState = document.getElementById('ssmErrorState');
            const content = document.getElementById('ssmContent');

            if (loadingState) loadingState.classList.remove('hidden');
            if (errorState) errorState.classList.add('hidden');
            if (content) content.classList.add('hidden');

            openModal('studentScoresModal');

            try {
                const subId = subjectId || '<%= subject.subject_id %>';
                const clsId = classId || '<%= classInfo.class_id %>';
                const res = await fetch(`/teacher/api/student/${studentId}/scores?subject=${subId}&classId=${clsId}`);
                const data = await res.json();

                if (!data.success) {
                    throw new Error(data.error || 'Failed to retrieve student scores');
                }

                _currentStudentScoresData = data;
                const student = data.student || {};
                const summary = data.summary || {};
                const topics = data.topics || [];
                const chartData = data.chartData || {};

                // 1. Fill Profile Header
                const avatarEl = document.getElementById('ssmStudentAvatar');
                if (avatarEl) {
                    avatarEl.src = student.profile_pic ? '/profile_uploads/' + student.profile_pic : '/profile_uploads/default_avatar.png';
                    avatarEl.onerror = () => { avatarEl.src = '/profile_uploads/default_avatar.png'; };
                }

                const nameEl = document.getElementById('ssmStudentName');
                if (nameEl) nameEl.textContent = student.full_name || 'Student Score Analysis';

                const levelEl = document.getElementById('ssmStudentLevelBadge');
                if (levelEl) levelEl.innerHTML = `<i class="fas fa-bolt text-indigo-500"></i> Level ${student.current_level || 1}`;

                const metaEl = document.getElementById('ssmStudentMeta');
                if (metaEl) {
                    metaEl.textContent = `LRN: ${student.lrn_number || '—'} · ${student.grade_level || 'Grade 11'} · ${student.section || 'Section'}`;
                }

                const subjectEl = document.getElementById('ssmSubjectBadge');
                if (subjectEl) subjectEl.textContent = student.subject_name || 'Chemistry 1';

                // 2. Fill KPI Summary Cards
                const overallAvg = summary.overall_avg || 0;
                const submittedAccuracy = summary.submitted_accuracy !== undefined && summary.submitted_accuracy !== null
                    ? summary.submitted_accuracy
                    : overallAvg;

                const overallEl = document.getElementById('ssmOverallAvg');
                if (overallEl) overallEl.textContent = overallAvg + '%';

                const overallRatingEl = document.getElementById('ssmOverallRating');
                if (overallRatingEl) {
                    if (overallAvg >= 90) {
                        overallRatingEl.textContent = 'Mastery';
                        overallRatingEl.className = 'text-[11px] font-bold text-emerald-600';
                    } else if (overallAvg >= 80) {
                        overallRatingEl.textContent = 'Proficient';
                        overallRatingEl.className = 'text-[11px] font-bold text-cyan-600';
                    } else if (overallAvg >= 75) {
                        overallRatingEl.textContent = 'Approaching';
                        overallRatingEl.className = 'text-[11px] font-bold text-amber-600';
                    } else {
                        overallRatingEl.textContent = summary.completed_tasks > 0 ? 'Developing' : 'Not Started';
                        overallRatingEl.className = overallAvg >= 50
                            ? 'text-[11px] font-bold text-amber-600'
                            : (summary.completed_tasks > 0 ? 'text-[11px] font-bold text-rose-500' : 'text-[11px] font-bold text-slate-400');
                    }
                }

                const overallBarEl = document.getElementById('ssmOverallBar');
                if (overallBarEl) {
                    overallBarEl.style.width = Math.min(overallAvg, 100) + '%';
                    overallBarEl.className = overallAvg >= 85 ? 'bg-emerald-500 h-1.5 rounded-full' : (overallAvg >= 75 ? 'bg-cyan-500 h-1.5 rounded-full' : (overallAvg >= 50 ? 'bg-amber-500 h-1.5 rounded-full' : 'bg-indigo-500 h-1.5 rounded-full'));
                }

                const curriculumScopeEl = document.getElementById('ssmCurriculumScopeText');
                if (curriculumScopeEl) {
                    curriculumScopeEl.textContent = `${summary.completed_tasks || 0}/${summary.total_tasks || 0} tasks (${summary.completion_rate || 0}%)`;
                }

                const submittedAccuracyBadge = document.getElementById('ssmSubmittedAccuracyBadge');
                if (submittedAccuracyBadge) {
                    if (summary.completed_tasks > 0) {
                        submittedAccuracyBadge.textContent = `${submittedAccuracy}% on submitted`;
                        submittedAccuracyBadge.className = submittedAccuracy >= 85
                            ? 'font-bold text-emerald-700 bg-emerald-50 border border-emerald-200 px-1.5 py-0.5 rounded text-[10px] whitespace-nowrap'
                            : (submittedAccuracy >= 75
                                ? 'font-bold text-cyan-700 bg-cyan-50 border border-cyan-200 px-1.5 py-0.5 rounded text-[10px] whitespace-nowrap'
                                : 'font-bold text-rose-700 bg-rose-50 border border-rose-200 px-1.5 py-0.5 rounded text-[10px] whitespace-nowrap');
                        submittedAccuracyBadge.style.display = '';
                    } else {
                        submittedAccuracyBadge.textContent = 'No submissions';
                        submittedAccuracyBadge.className = 'font-bold text-slate-400 bg-slate-50 border border-slate-200 px-1.5 py-0.5 rounded text-[10px] whitespace-nowrap';
                    }
                }

                const asmtAvgEl = document.getElementById('ssmAssessmentAvg');
                if (asmtAvgEl) asmtAvgEl.textContent = summary.assessment_avg !== null ? summary.assessment_avg + '%' : 'N/A';

                const asgnAvgEl = document.getElementById('ssmAssignmentAvg');
                if (asgnAvgEl) asgnAvgEl.textContent = summary.assignment_avg !== null ? summary.assignment_avg + '%' : 'N/A';

                const asmtCountEl = document.getElementById('ssmAssessmentCountText');
                if (asmtCountEl) {
                    const cnt = summary.assessment_count || 0;
                    asmtCountEl.textContent = `${cnt} assessment${cnt === 1 ? '' : 's'} recorded`;
                }

                const asgnCountEl = document.getElementById('ssmAssignmentCountText');
                if (asgnCountEl) {
                    const cnt = summary.assignment_count || 0;
                    asgnCountEl.textContent = `${cnt} assignment${cnt === 1 ? '' : 's'} recorded`;
                }

                const totalExpEl = document.getElementById('ssmTotalExp');
                if (totalExpEl) totalExpEl.textContent = (summary.total_subject_exp || 0).toLocaleString();

                // 2.1 Fill Forums KPI & EXP Breakdown Pills
                const forumsSummary = summary.forums_summary || {};
                const forumsCompletedEl = document.getElementById('ssmForumsCompleted');
                if (forumsCompletedEl) forumsCompletedEl.textContent = `${forumsSummary.completed_count || 0} / ${forumsSummary.total_count || 0}`;

                const forumsRateEl = document.getElementById('ssmForumsRate');
                if (forumsRateEl) forumsRateEl.textContent = `(${forumsSummary.completion_rate || 0}%)`;

                const forumsExpEl = document.getElementById('ssmForumsExp');
                if (forumsExpEl) forumsExpEl.textContent = `+${(forumsSummary.total_forum_exp || 0).toLocaleString()} Forum EXP`;

                const expBreakdown = summary.exp_breakdown || {};
                const asmtPill = document.getElementById('ssmExpAsmtPill');
                if (asmtPill) asmtPill.textContent = `Asmt: +${(expBreakdown.assessments_exp || 0).toLocaleString()}`;

                const asgnPill = document.getElementById('ssmExpAsgnPill');
                if (asgnPill) asgnPill.textContent = `Asgn: +${(expBreakdown.assignments_exp || 0).toLocaleString()}`;

                const forumPill = document.getElementById('ssmExpForumPill');
                if (forumPill) forumPill.textContent = `Forum: +${(expBreakdown.forums_exp || 0).toLocaleString()}`;

                const simPill = document.getElementById('ssmExpSimPill');
                if (simPill) simPill.textContent = `Sim: +${(expBreakdown.simulations_bonus_exp || 0).toLocaleString()}`;

                // 3. Fill Coursework Progress & Distribution
                const completionTextEl = document.getElementById('ssmCompletionText');
                if (completionTextEl) {
                    completionTextEl.textContent = `${summary.completed_tasks || 0} / ${summary.total_tasks || 0} completed (${summary.completion_rate || 0}%)`;
                }

                const completionBarEl = document.getElementById('ssmCompletionBar');
                if (completionBarEl) completionBarEl.style.width = (summary.completion_rate || 0) + '%';

                const dist = summary.distribution || {};
                const distM = document.getElementById('ssmDistMastery');
                if (distM) distM.textContent = dist.mastery || 0;
                const distP = document.getElementById('ssmDistProficient');
                if (distP) distP.textContent = dist.proficient || 0;
                const distA = document.getElementById('ssmDistApproaching');
                if (distA) distA.textContent = dist.approaching || 0;
                const distD = document.getElementById('ssmDistDeveloping');
                if (distD) distD.textContent = dist.developing || 0;
                const distU = document.getElementById('ssmDistUnattempted');
                if (distU) distU.textContent = dist.unattempted !== undefined ? dist.unattempted : Math.max(0, (summary.total_tasks || 0) - (summary.completed_tasks || 0));

                // 4. Render Topic Performance Chart (Horizontal Bar Chart)
                renderStudentTopicScoreChart(chartData, topics);

                // 5. Fill Diagnostic Highlights (Excelling vs Lagging Behind)
                const excellingBox = document.getElementById('ssmExcellingList');
                if (excellingBox) {
                    if (summary.excelling_topics && summary.excelling_topics.length > 0) {
                        excellingBox.innerHTML = summary.excelling_topics.map(t => `
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-emerald-100/90 text-emerald-800 text-xs font-bold border border-emerald-300 shadow-xs">
                                <i class="fas fa-check-circle text-emerald-600 text-[10px]"></i> ${t.name}
                                <span class="px-1.5 py-0.5 rounded-md bg-white text-emerald-700 font-mono text-[10px]">${t.percentage}%</span>
                            </span>
                        `).join('');
                    } else {
                        excellingBox.innerHTML = '<span class="text-xs text-emerald-600 italic">No topics meeting excelling threshold (&ge;85%) yet.</span>';
                    }
                }

                const laggingBox = document.getElementById('ssmLaggingList');
                if (laggingBox) {
                    if (summary.lagging_topics && summary.lagging_topics.length > 0) {
                        laggingBox.innerHTML = summary.lagging_topics.map(t => `
                            <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-xl bg-rose-100/90 text-rose-800 text-xs font-bold border border-rose-300 shadow-xs">
                                <i class="fas fa-triangle-exclamation text-rose-600 text-[10px]"></i> ${t.name}
                                <span class="px-1.5 py-0.5 rounded-md bg-white text-rose-700 font-mono text-[10px]">${t.percentage}%</span>
                            </span>
                        `).join('');
                    } else {
                        laggingBox.innerHTML = '<span class="text-xs text-rose-600 italic">No lagging topics detected (&lt;75%). Student is on track!</span>';
                    }
                }

                // 6. Build Topic-by-Topic Drilldowns (Accordion)
                renderTopicAccordions(topics);

                // 7. Render Interactive Simulation Quizzes Panel
                renderSimulationQuizzes(data.simulation_quizzes || [], summary.simulations_summary || {});

                // Reveal content
                if (loadingState) loadingState.classList.add('hidden');
                if (content) content.classList.remove('hidden');

            } catch (err) {
                console.error('[openStudentScoresModal Error]:', err);
                if (loadingState) loadingState.classList.add('hidden');
                if (errorState) {
                    errorState.classList.remove('hidden');
                    const msgEl = document.getElementById('ssmErrorMessage');
                    if (msgEl) msgEl.textContent = err.message || 'Failed to load scores.';
                }
            }
        }

        function renderStudentTopicScoreChart(chartData, topics) {
            const canvas = document.getElementById('studentTopicScoreCanvas');
            if (!canvas) return;

            if (studentTopicScoreChart) {
                studentTopicScoreChart.destroy();
                studentTopicScoreChart = null;
            }

            if (typeof Chart === 'undefined') {
                console.warn('Chart.js library not detected');
                return;
            }

            const ctx = canvas.getContext('2d');
            const labels = (chartData.labels || []).map(l => l.length > 28 ? l.substring(0, 26) + '...' : l);
            const scores = chartData.scores || [];
            const colors = chartData.colors || [];
            const borderColors = chartData.borderColors || [];

            studentTopicScoreChart = new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Mastery Score (%)',
                        data: scores,
                        backgroundColor: colors,
                        borderColor: borderColors,
                        borderWidth: 1.5,
                        borderRadius: 6,
                        maxBarThickness: 24
                    }]
                },
                options: {
                    indexAxis: 'y',
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0f172a',
                            titleFont: { size: 12, weight: 'bold' },
                            bodyFont: { size: 11 },
                            padding: 10,
                            cornerRadius: 8,
                            callbacks: {
                                title: (items) => chartData.labels[items[0].dataIndex] || '',
                                label: (context) => {
                                    const top = topics[context.dataIndex] || {};
                                    return [
                                        `Score: ${top.percentage !== null ? top.percentage + '%' : 'Not Attempted'} (${top.score_obtained || 0} / ${top.total_items || 0} pts)`,
                                        `Total EXP: +${(top.total_exp || 0).toLocaleString()} EXP`,
                                        `Coursework: ${top.completed_count || 0} / ${top.total_count || 0} items`,
                                        `Status: ${top.status || 'Not Started'}`
                                    ];
                                }
                            }
                        }
                    },
                    scales: {
                        x: {
                            min: 0,
                            max: 100,
                            ticks: {
                                callback: v => v + '%',
                                font: { size: 10, weight: 'bold' },
                                color: '#64748b'
                            },
                            grid: {
                                color: context => context.tick.value === 75 ? 'rgba(239, 68, 68, 0.45)' : 'rgba(226, 232, 240, 0.6)',
                                lineWidth: context => context.tick.value === 75 ? 2 : 1,
                                borderDash: context => context.tick.value === 75 ? [4, 4] : []
                            }
                        },
                        y: {
                            ticks: {
                                font: { size: 11, weight: '600' },
                                color: '#334155'
                            },
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        function renderTopicAccordions(topics) {
            const container = document.getElementById('ssmTopicAccordion');
            if (!container) return;

            if (!topics || topics.length === 0) {
                container.innerHTML = '<div class="p-8 text-center text-slate-400 bg-white rounded-2xl border border-slate-200">No topics configured for this subject.</div>';
                return;
            }

            container.innerHTML = topics.map((t, idx) => {
                let statusBadgeClass = 'bg-slate-100 text-slate-600 border-slate-200';
                let statusIcon = 'fa-circle-notch';
                if (t.status === 'Excelling') {
                    statusBadgeClass = 'bg-emerald-50 text-emerald-700 border-emerald-200';
                    statusIcon = 'fa-star';
                } else if (t.status === 'Proficient') {
                    statusBadgeClass = 'bg-cyan-50 text-cyan-700 border-cyan-200';
                    statusIcon = 'fa-check';
                } else if (t.status === 'Lagging Behind') {
                    statusBadgeClass = 'bg-rose-50 text-rose-700 border-rose-200';
                    statusIcon = 'fa-triangle-exclamation';
                }

                // Render assessments rows
                let asmtRows = '';
                if (t.assessments && t.assessments.length > 0) {
                    asmtRows = t.assessments.map(a => {
                        const isSub = a.is_submitted;
                        const pctStr = isSub && a.percentage !== null ? a.percentage + '%' : '—';
                        const scoreStr = isSub ? `${a.score_obtained} / ${a.total_items}` : `— / ${a.total_items}`;
                        const expStr = isSub && a.exp_gained ? `+${a.exp_gained} EXP` : '0 EXP';
                        const dateStr = a.submitted_at ? new Date(a.submitted_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Pending';
                        
                        let badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500">Unattempted</span>';
                        if (isSub) {
                            if (a.percentage >= 85) badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Excelling</span>';
                            else if (a.percentage >= 75) badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-cyan-50 text-cyan-700 border border-cyan-200">Passed</span>';
                            else badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200">Needs Review</span>';
                        }

                        return `
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="p-3">
                                    <div class="font-bold text-slate-800 text-xs">${a.assessment_name}</div>
                                    <div class="text-[10px] text-slate-400 mt-0.5 flex items-center gap-1.5">
                                        <span class="px-1.5 py-0.5 rounded bg-slate-100 font-medium text-slate-600">${a.assessment_type}</span>
                                        ${a.source === 'arcade' ? '<span class="text-amber-600 font-bold"><i class="fas fa-gamepad"></i> Arcade</span>' : ''}
                                    </div>
                                </td>
                                <td class="p-3 text-center font-mono font-bold text-slate-700 text-xs">${scoreStr}</td>
                                <td class="p-3 text-center font-mono font-black text-xs ${a.percentage >= 75 ? 'text-emerald-700' : (isSub ? 'text-rose-600' : 'text-slate-400')}">${pctStr}</td>
                                <td class="p-3 text-center">
                                    <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                        ${expStr}
                                    </span>
                                </td>
                                <td class="p-3 text-slate-500 text-[11px] whitespace-nowrap">${dateStr}</td>
                                <td class="p-3 text-center">${badgeHtml}</td>
                            </tr>
                        `;
                    }).join('');
                } else {
                    asmtRows = '<tr><td colspan="6" class="p-4 text-center text-slate-400 italic text-xs">No quizzes or tests assigned to this topic.</td></tr>';
                }

                // Render assignments rows
                let asgnRows = '';
                if (t.assignments && t.assignments.length > 0) {
                    asgnRows = t.assignments.map(a => {
                        const isSub = a.is_submitted;
                        const pctStr = isSub && a.percentage !== null ? a.percentage + '%' : '—';
                        const scoreStr = isSub ? `${a.score_obtained} / ${a.total_items}` : `— / ${a.total_items}`;
                        const expStr = isSub && a.exp_gained ? `+${a.exp_gained} EXP` : '0 EXP';
                        const dateStr = a.submitted_at ? new Date(a.submitted_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Not Submitted';
                        
                        let fileHtml = '<span class="text-slate-300 italic text-[11px]">—</span>';
                        if (a.file_path) {
                            fileHtml = `
                                <a href="${a.file_path}" target="_blank" class="inline-flex items-center gap-1 text-[11px] font-bold text-indigo-600 hover:text-indigo-800 transition">
                                    <i class="fas fa-file-pdf"></i> ${a.original_filename ? (a.original_filename.length > 15 ? a.original_filename.substring(0, 13) + '...' : a.original_filename) : 'File'}
                                </a>
                            `;
                        }

                        let feedbackHtml = '<span class="text-slate-300 italic text-[11px]">No feedback</span>';
                        if (a.feedback) {
                            const cleanFb = a.feedback.replace(/"/g, '&quot;');
                            feedbackHtml = `<span class="text-xs text-slate-600 truncate block max-w-xs" title="${cleanFb}">${a.feedback}</span>`;
                        }

                        return `
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="p-3">
                                    <div class="font-bold text-slate-800 text-xs">${a.assessment_name}</div>
                                    <div class="text-[10px] text-slate-400 mt-0.5 flex items-center gap-1.5">
                                        <span class="px-1.5 py-0.5 rounded bg-slate-100 font-medium text-slate-600">${a.category || 'Assignment'}</span>
                                        ${a.is_group ? '<span class="px-1.5 py-0.5 rounded bg-purple-50 text-purple-700 font-bold border border-purple-200"><i class="fas fa-users"></i> Group</span>' : ''}
                                    </div>
                                </td>
                                <td class="p-3 text-center font-mono font-bold text-slate-700 text-xs">${scoreStr}</td>
                                <td class="p-3 text-center font-mono font-black text-xs ${a.percentage >= 75 ? 'text-emerald-700' : (isSub ? 'text-rose-600' : 'text-slate-400')}">${pctStr}</td>
                                <td class="p-3 text-center">
                                    <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">
                                        ${expStr}
                                    </span>
                                </td>
                                <td class="p-3 text-center">${fileHtml}</td>
                                <td class="p-3 text-slate-500 text-[11px] whitespace-nowrap">${dateStr}</td>
                                <td class="p-3">${feedbackHtml}</td>
                            </tr>
                        `;
                    }).join('');
                } else {
                    asgnRows = '<tr><td colspan="7" class="p-4 text-center text-slate-400 italic text-xs">No assignments or deliverables assigned to this topic.</td></tr>';
                }

                // Render forums rows
                let forumRows = '';
                if (t.forums && t.forums.length > 0) {
                    forumRows = t.forums.map(f => {
                        const isDone = f.is_completed;
                        const expStr = isDone ? `+${f.exp_awarded} EXP` : '0 EXP';
                        const dueDateStr = f.due_date ? new Date(f.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'No Due Date';
                        const doneDateStr = isDone && f.done_at ? new Date(f.done_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) : 'Pending';

                        let tierBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-400">Not Completed</span>';
                        if (isDone) {
                            if (f.time_tier === 'early_bird') {
                                tierBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-sky-50 text-sky-700 border border-sky-200 flex items-center gap-1 w-max"><i class="fas fa-feather-pointed"></i> Early Bird</span>';
                            } else if (f.time_tier === 'on_time') {
                                tierBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200 flex items-center gap-1 w-max"><i class="fas fa-clock"></i> On Time</span>';
                            } else if (f.time_tier === 'late') {
                                tierBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200 flex items-center gap-1 w-max"><i class="fas fa-history"></i> Late</span>';
                            } else {
                                tierBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200 flex items-center gap-1 w-max"><i class="fas fa-check-circle"></i> Completed</span>';
                            }
                        }

                        let statusBadge = isDone
                            ? '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200">Completed</span>'
                            : '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-500">Unanswered</span>';

                        return `
                            <tr class="hover:bg-slate-50/80 transition">
                                <td class="p-3">
                                    <div class="font-bold text-slate-800 text-xs">${f.title}</div>
                                    <div class="text-[10px] text-slate-400 mt-0.5">Base Reward: ${f.base_exp || 100} EXP</div>
                                </td>
                                <td class="p-3 text-slate-500 text-[11px] whitespace-nowrap">${dueDateStr}</td>
                                <td class="p-3 text-slate-500 text-[11px] whitespace-nowrap">${doneDateStr}</td>
                                <td class="p-3 text-center">${tierBadge}</td>
                                <td class="p-3 text-center">
                                    <span class="px-2 py-0.5 rounded-lg text-[10px] font-bold ${isDone ? 'bg-purple-50 text-purple-700 border border-purple-200' : 'bg-slate-100 text-slate-400'}">
                                        ${expStr}
                                    </span>
                                </td>
                                <td class="p-3 text-center">${statusBadge}</td>
                            </tr>
                        `;
                    }).join('');
                } else {
                    forumRows = '<tr><td colspan="6" class="p-4 text-center text-slate-400 italic text-xs">No discussion forums assigned to this topic.</td></tr>';
                }

                const isFirst = idx === 0;

                return `
                    <div class="bg-white rounded-2xl border border-slate-200 overflow-hidden shadow-xs transition" id="ssmTopicCard_${t.topic_id}">
                        <!-- Topic Accordion Header -->
                        <div class="p-4 flex items-center justify-between cursor-pointer hover:bg-slate-50/70 select-none transition" onclick="toggleTopicAccordion(${t.topic_id})">
                            <div class="flex items-center gap-3 min-w-0">
                                <span class="w-8 h-8 rounded-xl bg-slate-100 text-slate-600 font-bold text-xs flex items-center justify-center flex-shrink-0 border border-slate-200">
                                    Q${t.quarter_number}
                                </span>
                                <div class="min-w-0">
                                    <h5 class="font-bold text-slate-800 text-sm leading-tight truncate">${t.topic_name}</h5>
                                    <p class="text-xs text-slate-400 mt-0.5">
                                        ${t.completed_count} / ${t.total_count} tasks completed · ${t.forums_completed_count || 0} / ${t.forums_total_count || 0} forums
                                    </p>
                                </div>
                            </div>
                            <div class="flex items-center gap-3 flex-shrink-0">
                                <!-- Topic Total EXP Badge -->
                                <span class="px-2.5 py-1 rounded-xl bg-amber-50 border border-amber-200 text-amber-700 font-black text-xs flex items-center gap-1" title="Asmt: ${t.assessments_exp || 0} | Asgn: ${t.assignments_exp || 0} | Forum: ${t.forums_exp || 0}">
                                    <i class="fas fa-bolt text-amber-500"></i> +${(t.total_exp || 0).toLocaleString()} EXP
                                </span>
                                <!-- Topic Score % -->
                                <div class="text-right hidden sm:block">
                                    <div class="text-sm font-black text-slate-800 font-mono">${t.percentage !== null ? t.percentage + '%' : '—'}</div>
                                    <div class="text-[10px] text-slate-400 font-mono">${t.score_obtained} / ${t.total_items} pts</div>
                                </div>
                                <!-- Topic Status Badge -->
                                <span class="px-2.5 py-1 rounded-xl text-[11px] font-bold border flex items-center gap-1.5 ${statusBadgeClass}">
                                    <i class="fas ${statusIcon} text-[10px]"></i> ${t.status}
                                </span>
                                <!-- Chevron -->
                                <i class="fas fa-chevron-down text-slate-400 text-xs transition-transform duration-200 ${isFirst ? 'rotate-180' : ''}" id="ssmTopicChevron_${t.topic_id}"></i>
                            </div>
                        </div>

                        <!-- Topic Accordion Body -->
                        <div class="border-t border-slate-100 p-4 sm:p-5 space-y-5 bg-slate-50/40 ${isFirst ? '' : 'hidden'}" id="ssmTopicBody_${t.topic_id}">
                            <!-- Topic EXP Subtitle Strip with Multi-Source Breakdown -->
                            <div class="p-3 bg-gradient-to-r from-amber-50 to-orange-50 rounded-xl border border-amber-200/80 flex items-center justify-between text-xs font-bold text-amber-900 flex-wrap gap-2">
                                <span class="flex items-center gap-1.5">
                                    <i class="fas fa-trophy text-amber-600"></i> Topic EXP Breakdown:
                                </span>
                                <div class="flex items-center gap-2 flex-wrap">
                                    <span class="px-2 py-0.5 rounded-md bg-white/80 text-[11px] text-cyan-800 border border-amber-200 font-medium">Asmt: +${(t.assessments_exp || 0).toLocaleString()}</span>
                                    <span class="px-2 py-0.5 rounded-md bg-white/80 text-[11px] text-emerald-800 border border-amber-200 font-medium">Asgn: +${(t.assignments_exp || 0).toLocaleString()}</span>
                                    <span class="px-2 py-0.5 rounded-md bg-white/80 text-[11px] text-purple-800 border border-amber-200 font-medium">Forums: +${(t.forums_exp || 0).toLocaleString()}</span>
                                    <span class="font-mono text-xs font-black text-amber-800 ml-1">+${(t.total_exp || 0).toLocaleString()} Total Topic EXP</span>
                                </div>
                            </div>

                            <!-- 1. Assessments Table -->
                            <div>
                                <h6 class="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                    <i class="fas fa-tasks text-cyan-600"></i> Assessments &amp; Quizzes (${t.assessments ? t.assessments.length : 0})
                                </h6>
                                <div class="bg-white rounded-xl border border-slate-200 overflow-x-auto shadow-xs">
                                    <table class="w-full text-left text-xs">
                                        <thead class="bg-slate-50 text-slate-500 border-b border-slate-100 text-[10px] font-black uppercase">
                                            <tr>
                                                <th class="p-3">Assessment Title</th>
                                                <th class="p-3 text-center">Score / Items</th>
                                                <th class="p-3 text-center">Grade %</th>
                                                <th class="p-3 text-center">EXP</th>
                                                <th class="p-3">Date Completed</th>
                                                <th class="p-3 text-center">Mastery Status</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            ${asmtRows}
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- 2. Assignments Table -->
                            <div>
                                <h6 class="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                    <i class="fas fa-file-signature text-emerald-600"></i> Assignments &amp; Deliverables (${t.assignments ? t.assignments.length : 0})
                                </h6>
                                <div class="bg-white rounded-xl border border-slate-200 overflow-x-auto shadow-xs">
                                    <table class="w-full text-left text-xs">
                                        <thead class="bg-slate-50 text-slate-500 border-b border-slate-100 text-[10px] font-black uppercase">
                                            <tr>
                                                <th class="p-3">Assignment Title</th>
                                                <th class="p-3 text-center">Score / Total</th>
                                                <th class="p-3 text-center">Grade %</th>
                                                <th class="p-3 text-center">EXP</th>
                                                <th class="p-3 text-center">Attachment</th>
                                                <th class="p-3">Submitted At</th>
                                                <th class="p-3">Teacher Notes</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            ${asgnRows}
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- 3. Forums & Class Discussions Table -->
                            <div>
                                <h6 class="text-xs font-black text-slate-700 uppercase tracking-wider mb-2 flex items-center gap-1.5">
                                    <i class="fas fa-comments text-purple-600"></i> Forums &amp; Class Discussions (${t.forums ? t.forums.length : 0})
                                </h6>
                                <div class="bg-white rounded-xl border border-slate-200 overflow-x-auto shadow-xs">
                                    <table class="w-full text-left text-xs">
                                        <thead class="bg-slate-50 text-slate-500 border-b border-slate-100 text-[10px] font-black uppercase">
                                            <tr>
                                                <th class="p-3">Discussion Forum Title</th>
                                                <th class="p-3">Due Date</th>
                                                <th class="p-3">Completion Date</th>
                                                <th class="p-3 text-center">Time Tier</th>
                                                <th class="p-3 text-center">Forum EXP</th>
                                                <th class="p-3 text-center">Status</th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-100">
                                            ${forumRows}
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function toggleTopicAccordion(topicId) {
            const body = document.getElementById('ssmTopicBody_' + topicId);
            const chevron = document.getElementById('ssmTopicChevron_' + topicId);
            if (!body) return;

            const isHidden = body.classList.contains('hidden');
            if (isHidden) {
                body.classList.remove('hidden');
                if (chevron) chevron.classList.add('rotate-180');
            } else {
                body.classList.add('hidden');
                if (chevron) chevron.classList.remove('rotate-180');
            }
        }

        let _ssmAllExpanded = false;
        function toggleAllTopicAccordions() {
            _ssmAllExpanded = !_ssmAllExpanded;
            const btn = document.getElementById('ssmToggleAllBtn');
            if (btn) btn.textContent = _ssmAllExpanded ? 'Collapse All' : 'Expand All';

            const bodies = document.querySelectorAll('[id^="ssmTopicBody_"]');
            const chevrons = document.querySelectorAll('[id^="ssmTopicChevron_"]');

            bodies.forEach(b => {
                if (_ssmAllExpanded) b.classList.remove('hidden');
                else b.classList.add('hidden');
            });

            chevrons.forEach(c => {
                if (_ssmAllExpanded) c.classList.add('rotate-180');
                else c.classList.remove('rotate-180');
            });
        }

        function renderSimulationQuizzes(quizzes, simSummary) {
            const container = document.getElementById('ssmSimulationListContainer');
            const countBadge = document.getElementById('ssmSimCountBadge');
            const bonusExpBadge = document.getElementById('ssmTotalSimBonusExpBadge');

            const totalQuizzes = (quizzes || []).length;
            const totalBonus = simSummary?.total_bonus_exp || 0;

            if (countBadge) countBadge.textContent = `${totalQuizzes} ${totalQuizzes === 1 ? 'Quiz' : 'Quizzes'}`;
            if (bonusExpBadge) bonusExpBadge.innerHTML = `<i class="fas fa-bolt text-amber-500"></i> +${totalBonus.toLocaleString()} Total Bonus EXP`;

            if (!container) return;

            if (!quizzes || quizzes.length === 0) {
                container.innerHTML = `
                    <div class="p-8 text-center text-slate-400 bg-slate-50/50 rounded-xl border border-slate-200 text-xs italic">
                        <div class="w-10 h-10 mx-auto mb-2 rounded-xl bg-amber-50 text-amber-500 flex items-center justify-center text-lg">
                            <i class="fas fa-flask"></i>
                        </div>
                        <p class="font-medium text-slate-600">No interactive simulation quizzes completed yet.</p>
                        <p class="text-[11px] text-slate-400 mt-0.5">Bonus EXP earned from 3D simulations will automatically appear here.</p>
                    </div>
                `;
                return;
            }

            const rows = quizzes.map(q => {
                const pct = q.percentage !== null && q.percentage !== undefined ? q.percentage : 0;
                const expStr = q.exp_earned ? `+${q.exp_earned} EXP` : '0 EXP';
                const dateStr = q.submitted_at ? new Date(q.submitted_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Recorded';
                const simSlugClean = (q.simulation_slug || '').replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());

                let badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600">Completed</span>';
                if (pct >= 85) badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-emerald-50 text-emerald-700 border border-emerald-200"><i class="fas fa-star text-[9px] mr-1"></i>Mastered</span>';
                else if (pct >= 75) badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-cyan-50 text-cyan-700 border border-cyan-200"><i class="fas fa-check text-[9px] mr-1"></i>Passed</span>';
                else badgeHtml = '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-amber-50 text-amber-700 border border-amber-200">Attempted</span>';

                return `
                    <tr class="hover:bg-amber-50/30 transition">
                        <td class="p-3">
                            <div class="font-bold text-slate-800 text-xs">${q.quiz_title || 'Simulation Quiz'}</div>
                            <div class="text-[10px] text-amber-700 mt-0.5 flex items-center gap-1.5 font-medium">
                                <i class="fas fa-cube text-amber-500"></i> ${simSlugClean}
                                ${q.section ? `<span class="text-slate-300">·</span> <span class="text-slate-400 font-normal">${q.section}</span>` : ''}
                            </div>
                        </td>
                        <td class="p-3 text-center font-mono font-bold text-slate-700 text-xs">
                            ${q.score} / ${q.total_questions}
                            <span class="block text-[10px] font-normal text-slate-400">(${q.correct_count} correct)</span>
                        </td>
                        <td class="p-3 text-center font-mono font-black text-xs ${pct >= 75 ? 'text-emerald-700' : 'text-slate-700'}">
                            ${pct}%
                        </td>
                        <td class="p-3 text-center">
                            <span class="px-2.5 py-1 rounded-lg text-[10px] font-black bg-amber-100 text-amber-800 border border-amber-300 shadow-xs flex items-center gap-1 justify-center w-max mx-auto">
                                <i class="fas fa-bolt text-amber-600"></i> ${expStr}
                            </span>
                        </td>
                        <td class="p-3 text-slate-500 text-[11px] whitespace-nowrap">${dateStr}</td>
                        <td class="p-3 text-center">${badgeHtml}</td>
                    </tr>
                `;
            }).join('');

            container.innerHTML = `
                <div class="bg-white rounded-xl border border-slate-200 overflow-x-auto shadow-xs">
                    <table class="w-full text-left text-xs">
                        <thead class="bg-amber-50/60 text-amber-900 border-b border-amber-100 text-[10px] font-black uppercase">
                            <tr>
                                <th class="p-3">Quiz Title &amp; Simulation</th>
                                <th class="p-3 text-center">Score / Questions</th>
                                <th class="p-3 text-center">Accuracy %</th>
                                <th class="p-3 text-center">Bonus EXP Earned</th>
                                <th class="p-3">Date Completed</th>
                                <th class="p-3 text-center">Result Status</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100">
                            ${rows}
                        </tbody>
                    </table>
                </div>
            `;
        }

        function printStudentScoreSummary() {
            if (!_currentStudentScoresData) return;
            // Expand all topic accordions so printed slip includes full assessments, assignments, forums, and simulation breakdown
            const bodies = document.querySelectorAll('[id^="ssmTopicBody_"]');
            bodies.forEach(b => b.classList.remove('hidden'));
            window.print();
        }

        // Auto-trigger modal if ?openScores=studentId is in the URL query string
        document.addEventListener('DOMContentLoaded', function() {
            try {
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.has('openScores')) {
                    const targetStudentId = urlParams.get('openScores');
                    if (targetStudentId) {
                        openStudentScoresModal(targetStudentId, '<%= subject.subject_id %>', '<%= classInfo.class_id %>');
                    }
                }
            } catch (e) {
                console.warn('[Auto-trigger openScores Error]', e);
            }
        });

</script>
</body>
</html>
