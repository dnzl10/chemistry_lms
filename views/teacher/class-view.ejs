<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= subject.subject_name %> | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }

        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Subject hero card */
        .subject-hero {
            position: relative;
            overflow: hidden;
            border-radius: 1.5rem;
            background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0c4a6e 100%);
        }
        .subject-hero::before {
            content: '';
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 70% 50%, rgba(6,182,212,0.15) 0%, transparent 60%),
                              radial-gradient(circle at 20% 80%, rgba(139,92,246,0.1) 0%, transparent 50%);
            pointer-events: none;
        }
        .subject-hero-img {
            position: absolute;
            inset: 0;
            width: 100%;
            height: 100%;
            object-fit: cover;
            opacity: 0.50;
            mask-image: linear-gradient(to bottom, rgba(0,0,0,0.6), rgba(0,0,0,0.2));
            -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.6), rgba(0,0,0,0.2));
        }

        /* Stat pill */
        .stat-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 5px 12px;
            border-radius: 9999px;
            background: rgba(255,255,255,0.1);
            border: 1px solid rgba(255,255,255,0.15);
            font-size: 12px;
            font-weight: 600;
            color: rgba(255,255,255,0.85);
            backdrop-filter: blur(4px);
        }

        /* Table styles */
        .roster-table { border-collapse: separate; border-spacing: 0; width: 100%; }
        .roster-table thead th {
            background: #f8fafc;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.08em;
            color: #64748b;
            padding: 10px 16px;
            border-bottom: 1px solid #e2e8f0;
        }
        .roster-table thead th:first-child { border-radius: 12px 0 0 0; }
        .roster-table thead th:last-child  { border-radius: 0 12px 0 0; }
        .roster-table tbody tr {
            transition: background 0.15s;
        }
        .roster-table tbody tr:hover { background: #f0fdfa; }
        .roster-table tbody td {
            padding: 13px 16px;
            border-bottom: 1px solid #f1f5f9;
            vertical-align: middle;
            font-size: 13px;
            color: #1e293b;
        }
        .roster-table tbody tr:last-child td { border-bottom: none; }

        /* Progress bar */
        .prog-track {
            width: 100%;
            height: 6px;
            background: #e2e8f0;
            border-radius: 9999px;
            overflow: hidden;
        }
        .prog-fill {
            height: 100%;
            border-radius: 9999px;
            transition: width 0.6s ease;
        }

        /* EXP badge */
        .exp-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 9999px;
            background: linear-gradient(90deg, #fef3c7, #fde68a);
            color: #92400e;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.03em;
        }

        /* Wins badge */
        .wins-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 9999px;
            background: linear-gradient(90deg, #ede9fe, #ddd6fe);
            color: #5b21b6;
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 0.03em;
        }

        /* Search input */
        .search-input {
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 8px 14px 8px 36px;
            font-size: 13px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            background: white;
            width: 240px;
        }
        .search-input:focus {
            border-color: #06b6d4;
            box-shadow: 0 0 0 3px rgba(6,182,212,0.12);
        }

        /* Sort / action button */
        .sort-btn {
            padding: 7px 13px;
            border-radius: 9px;
            border: 1px solid #e2e8f0;
            background: white;
            font-size: 12px;
            font-weight: 600;
            color: #475569;
            cursor: pointer;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: all 0.15s;
            display: flex;
            align-items: center;
            gap: 5px;
        }
        .sort-btn:hover { background: #f0fdfa; border-color: #06b6d4; color: #0891b2; }
        .sort-btn.active { background: #ecfeff; border-color: #06b6d4; color: #0e7490; }

        /* Section card */
        .section-card {
            background: white;
            border-radius: 1.25rem;
            border: 1px solid #e2e8f0;
            overflow: hidden;
            display: flex;
            flex-direction: column;
            min-height: 620px;
            box-shadow: 0 1px 3px rgba(15, 23, 42, 0.03);
        }
        .section-card.is-collapsed,
        .section-card.auto-height-card {
            min-height: unset;
        }

        .section-header {
            min-height: 72px;
            padding: 16px 20px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
            flex-shrink: 0;
            background: white;
        }

        .section-body-fill {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-height: 540px;
        }

        .table-viewport-fill {
            flex: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }

        /* Standardized Empty States */
        .standard-empty-state {
            flex: 1;
            min-height: 440px;
            margin: 16px;
            padding: 40px 24px;
            background: rgba(248, 250, 252, 0.75);
            border: 1.5px dashed #e2e8f0;
            border-radius: 1rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }
        .standard-empty-state.hidden {
            display: none !important;
        }
        .table-empty-cell {
            padding: 0 !important;
            border-bottom: none !important;
        }
        .standard-sub-empty-state {
            min-height: 260px;
            margin: 8px 0;
            padding: 32px 20px;
            background: rgba(248, 250, 252, 0.75);
            border: 1.5px dashed #e2e8f0;
            border-radius: 1rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            text-align: center;
        }

        /* Scrollable main area */
        #mainScroll { overflow-y: auto; }
        #mainScroll::-webkit-scrollbar { width: 5px; }
        #mainScroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }

        /* Avatar */
        .avatar-ring {
            width: 36px; height: 36px;
            border-radius: 10px;
            object-fit: cover;
            border: 2px solid #e0f2fe;
            flex-shrink: 0;
        }

        .lrn-mono { font-family: monospace; font-size: 12px; color: #94a3b8; letter-spacing: 0.04em; }

        /* Meta chip */
        .meta-chip {
            display: inline-flex; align-items: center; gap: 5px;
            padding: 3px 10px; border-radius: 9999px;
            font-size: 11px; font-weight: 700; letter-spacing: 0.04em;
        }

        /* Fade-in for rows */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(8px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-row { animation: fadeUp 0.25s ease forwards; opacity: 0; }
        

        /* ---- Content Management Section ---- */
        .quarter-block {
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            overflow: hidden;
            transition: box-shadow 0.2s;
        }
        .quarter-block:hover { box-shadow: 0 4px 16px rgba(99,102,241,0.07); }

        .quarter-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 14px 18px;
            background: linear-gradient(90deg, #f8fafc 0%, #f1f5f9 100%);
            cursor: pointer;
            user-select: none;
            gap: 10px;
            flex-wrap: wrap;
        }
        .quarter-header:hover { background: #eef2ff; }

        .quarter-body { background: white; }

        /* Topic row */
        .topic-row {
            border-bottom: 1px solid #f1f5f9;
            transition: background 0.15s;
        }
        .topic-row:last-child { border-bottom: none; }
        .topic-row:hover { background: #f8fafc; }

        .topic-inner {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 12px 18px 12px 32px;
            gap: 10px;
            flex-wrap: wrap;
        }

        /* Sub-items panel (materials, announcements, etc.) */
        .topic-panel {
            display: none;
            background: #fafafa;
            border-top: 1px solid #f1f5f9;
            padding: 16px 18px 16px 44px;
        }
        .topic-panel.open { display: block; }

        /* Tab bar inside topic panel */
        .panel-tabs {
            display: flex;
            gap: 2px;
            background: #f1f5f9;
            border-radius: 10px;
            padding: 3px;
            margin-bottom: 14px;
            flex-wrap: wrap;
        }
        .panel-tab {
            padding: 6px 14px;
            border-radius: 8px;
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            cursor: pointer;
            transition: all 0.15s;
            display: flex;
            align-items: center;
            gap: 5px;
            border: none;
            background: transparent;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .panel-tab:hover { background: white; color: #334155; }
        .panel-tab.active { background: white; color: #4f46e5; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }

        /* Sub-table inside topic panel */
        .sub-table { width: 100%; border-collapse: collapse; font-size: 12px; }
        .sub-table th {
            text-align: left; padding: 7px 10px;
            font-size: 10px; font-weight: 700; text-transform: uppercase;
            letter-spacing: 0.07em; color: #94a3b8;
            border-bottom: 1px solid #e2e8f0;
            background: #f8fafc;
        }
        .sub-table td {
            padding: 9px 10px;
            border-bottom: 1px solid #f8fafc;
            color: #334155;
            vertical-align: middle;
        }
        .sub-table tr:last-child td { border-bottom: none; }
        .sub-table tr:hover td { background: #f0fdfa; }

        /* Lock toggle button */
        .lock-btn {
            width: 32px; height: 32px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            background: white;
            cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center;
            transition: all 0.15s;
            flex-shrink: 0;
        }
        .lock-btn.locked { background: #fff7ed; border-color: #fed7aa; color: #ea580c; }
        .lock-btn.locked:hover { background: #ffedd5; }
        .lock-btn.unlocked { background: #f0fdf4; border-color: #bbf7d0; color: #16a34a; }
        .lock-btn.unlocked:hover { background: #dcfce7; }

        /* Icon action buttons */
        .icon-btn {
            width: 28px; height: 28px;
            border-radius: 7px;
            border: 1px solid #e2e8f0;
            background: white;
            cursor: pointer;
            display: inline-flex; align-items: center; justify-content: center;
            font-size: 11px;
            transition: all 0.15s;
            color: #64748b;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .icon-btn:hover { border-color: #06b6d4; color: #0891b2; background: #ecfeff; }
        .icon-btn.danger:hover { border-color: #fca5a5; color: #dc2626; background: #fff1f1; }
        .icon-btn.warn:hover { border-color: #fcd34d; color: #d97706; background: #fffbeb; }
        .icon-btn.success:hover { border-color: #86efac; color: #16a34a; background: #f0fdf4; }

        /* Priority / pin badges */
        .badge-priority { display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 9999px; font-size: 10px; font-weight: 700; background: #fef2f2; color: #b91c1c; }
        .badge-pinned   { display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 9999px; font-size: 10px; font-weight: 700; background: #eff6ff; color: #1d4ed8; }
        .badge-type     { display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 9999px; font-size: 10px; font-weight: 700; }

        /* Add-row button */
        .add-row-btn {
            display: flex; align-items: center; gap: 5px;
            padding: 6px 12px;
            border-radius: 8px;
            border: 1.5px dashed #cbd5e1;
            background: transparent;
            font-size: 12px; font-weight: 600; color: #94a3b8;
            cursor: pointer;
            transition: all 0.15s;
            font-family: 'Plus Jakarta Sans', sans-serif;
            margin-top: 8px;
        }
        .add-row-btn:hover { border-color: #06b6d4; color: #0891b2; background: #ecfeff; }

        /* Modal backdrop + card */
        .modal-backdrop {
            display: none;
            position: fixed; inset: 0; z-index: 200;
            background: rgba(15,23,42,0.55);
            align-items: center; justify-content: center;
            padding: 16px;
        }
        .modal-backdrop.open { display: flex; }
        .modal-card {
            background: white;
            border-radius: 1.25rem;
            width: 100%; max-width: 520px;
            box-shadow: 0 20px 60px rgba(15,23,42,0.18);
            overflow: hidden;
            animation: modalIn 0.2s ease;
        }
        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.96) translateY(8px); }
            to   { opacity: 1; transform: scale(1)    translateY(0); }
        }
        .modal-header {
            display: flex; align-items: center; justify-content: space-between;
            padding: 18px 22px;
            border-bottom: 1px solid #f1f5f9;
        }
        .modal-body { padding: 20px 22px; display: flex; flex-direction: column; gap: 14px; }
        .modal-footer {
            padding: 14px 22px;
            border-top: 1px solid #f1f5f9;
            display: flex; justify-content: flex-end; gap: 8px;
        }

        /* Form elements inside modals */
        .form-label { font-size: 12px; font-weight: 700; color: #475569; margin-bottom: 5px; display: block; }
        .form-input, .form-select, .form-textarea {
            width: 100%; padding: 9px 12px;
            border: 1px solid #e2e8f0; border-radius: 9px;
            font-size: 13px; font-family: 'Plus Jakarta Sans', sans-serif;
            color: #1e293b; outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            background: white;
        }
        .form-input:focus, .form-select:focus, .form-textarea:focus {
            border-color: #06b6d4;
            box-shadow: 0 0 0 3px rgba(6,182,212,0.1);
        }
        .form-textarea { resize: vertical; min-height: 80px; }

        /* Confirm delete modal */
        .modal-card.danger .modal-header { background: #fff1f2; }

        /* Content search bar (reuse existing .search-input styles but narrower) */
        .content-search {
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            padding: 6px 12px 6px 30px;
            font-size: 12px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            outline: none;
            background: white;
            width: 180px;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .content-search:focus { border-color: #06b6d4; box-shadow: 0 0 0 3px rgba(6,182,212,0.1); }

        /* Chevron rotate on expand */
        .chevron-icon { transition: transform 0.2s; }
        .chevron-icon.open { transform: rotate(90deg); }

        /* Empty state for sub-tables */
        .empty-sub {
            text-align: center; padding: 24px 0;
            color: #cbd5e1; font-size: 12px; font-weight: 600;
        }

        /* Material type badge colors */
        .type-pdf         { background: #fef2f2; color: #b91c1c; }
        .type-word        { background: #eff6ff; color: #1d4ed8; }
        .type-video       { background: #f0fdf4; color: #15803d; }
        .type-link        { background: #faf5ff; color: #7e22ce; }
        .type-img         { background: #fff7ed; color: #c2410c; }
        .type-presentation{ background: #ecfeff; color: #0e7490; }

        /* Assessment type badge */
        .atype-pre    { background: #e0f2fe; color: #0369a1; }
        .atype-post   { background: #dcfce7; color: #15803d; }
        .atype-quiz   { background: #fef9c3; color: #a16207; }
        .atype-comp   { background: #fce7f3; color: #9d174d; }
        .atype-assign { background: #ede9fe; color: #6d28d9; }
        .atype-arcade { background: #f1f5f9; color: #475569; }

        /* Locked row dimming */
        .locked-row td { opacity: 0.55; }

        /* Toast notification */
        #cm-toast {
            position: fixed; bottom: 24px; right: 24px; z-index: 999;
            background: #1e293b; color: white;
            padding: 10px 18px; border-radius: 10px;
            font-size: 13px; font-weight: 600;
            box-shadow: 0 8px 24px rgba(15,23,42,0.2);
            transform: translateY(80px); opacity: 0;
            transition: all 0.3s ease;
            pointer-events: none;
            display: flex; align-items: center; gap: 8px;
            max-width: 320px;
        }
        #cm-toast.show { transform: translateY(0); opacity: 1; }
        #cm-toast.success { background: #064e3b; }
        #cm-toast.error   { background: #7f1d1d; }

        /* PASTE THIS inside your <style> tag, anywhere after the existing tab CSS */
        .tab-content { display: block; }
        .tab-content.hidden { display: none !important; }


        /* ── Analytics section ── */
        .analytics-tabs { display:flex; gap:2px; background:#f1f5f9; border-radius:10px; padding:3px; flex-wrap:wrap; margin-bottom:0; }
        .analytics-tab  { padding:7px 16px; border-radius:8px; font-size:12px; font-weight:700; color:#64748b; cursor:pointer; transition:all .15s; display:flex; align-items:center; gap:5px; border:none; background:transparent; font-family:'Plus Jakarta Sans',sans-serif; }
        .analytics-tab:hover  { background:white; color:#334155; }
        .analytics-tab.active { background:white; color:#4f46e5; box-shadow:0 1px 4px rgba(0,0,0,0.08); }
        .analytics-panel { display:none; }
        .analytics-panel.active { display:flex; flex-direction:column; flex:1; min-height:540px; }
        
        /* ── Score summary ── */
        .score-filter-bar { display:flex; flex-wrap:wrap; align-items:center; gap:8px; padding:14px 18px; border-bottom:1px solid #f1f5f9; background:#fafafa; }
        .filter-select { padding:6px 10px; border:1px solid #e2e8f0; border-radius:8px; font-size:12px; font-family:'Plus Jakarta Sans',sans-serif; color:#475569; outline:none; background:white; cursor:pointer; }
        .filter-select:focus { border-color:#06b6d4; }
        
        .score-table { width:100%; border-collapse:collapse; font-size:12px; }
        .score-table th { text-align:left; padding:8px 12px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.07em; color:#94a3b8; border-bottom:1px solid #e2e8f0; background:#f8fafc; white-space:nowrap; }
        .score-table td { padding:10px 12px; border-bottom:1px solid #f8fafc; color:#334155; vertical-align:middle; }
        .score-table tr:last-child td { border-bottom:none; }
        .score-table tr:hover td { background:#f0fdfa; }
        
        .score-bar-wrap { display:flex; align-items:center; gap:6px; min-width:100px; }
        .score-bar-track { flex:1; height:5px; background:#e2e8f0; border-radius:9999px; overflow:hidden; }
        .score-bar-fill  { height:100%; border-radius:9999px; }
        
        /* ── Per-question breakdown ── */
        .breakdown-assessment-select { width:100%; padding:9px 12px; border:1px solid #e2e8f0; border-radius:9px; font-size:13px; font-family:'Plus Jakarta Sans',sans-serif; color:#1e293b; outline:none; background:white; margin-bottom:14px; }
        .breakdown-assessment-select:focus { border-color:#06b6d4; }
        
        .qb-grid { display:grid; grid-template-columns:repeat(auto-fill, minmax(260px,1fr)); gap:10px; }
        .qb-card { background:white; border:1px solid #e2e8f0; border-radius:12px; padding:12px 14px; }
        .qb-card-header { display:flex; align-items:flex-start; justify-content:space-between; gap:8px; margin-bottom:8px; }
        .qb-q-num { font-size:10px; font-weight:800; color:#94a3b8; text-transform:uppercase; letter-spacing:.06em; }
        .qb-difficulty { font-size:10px; font-weight:700; padding:2px 7px; border-radius:9999px; }
        .diff-easy   { background:#dcfce7; color:#15803d; }
        .diff-avg    { background:#fef9c3; color:#a16207; }
        .diff-hard   { background:#fee2e2; color:#b91c1c; }
        .qb-q-text   { font-size:12px; font-weight:600; color:#334155; line-height:1.5; margin-bottom:8px; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
        .qb-stats    { display:flex; gap:8px; }
        .qb-stat     { flex:1; text-align:center; background:#f8fafc; border-radius:7px; padding:5px 4px; }
        .qb-stat-val { font-size:13px; font-weight:800; }
        .qb-stat-lbl { font-size:9px; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:.04em; margin-top:1px; }
        .correct-rate-bar { height:4px; background:#e2e8f0; border-radius:9999px; overflow:hidden; margin-top:7px; }
        .correct-rate-fill { height:100%; border-radius:9999px; background:#10b981; }
        .no-data-state { text-align:center; padding:40px 0; color:#cbd5e1; font-size:13px; font-weight:600; }
        
        /* ── Competitive matches ── */
        .match-row { display:flex; align-items:center; gap:10px; padding:10px 16px; border-bottom:1px solid #f1f5f9; transition:background .15s; }
        .match-row:last-child { border-bottom:none; }
        .match-row:hover { background:#f8fafc; }
        .match-player { flex:1; min-width:0; }
        .match-player-name { font-size:12px; font-weight:700; color:#334155; truncate; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .match-player-score { font-size:11px; color:#64748b; }
        .match-vs { font-size:10px; font-weight:800; color:#cbd5e1; flex-shrink:0; }
        .match-winner-badge { font-size:10px; font-weight:800; padding:2px 8px; border-radius:9999px; background:#fef9c3; color:#a16207; flex-shrink:0; }
        .match-date-chip { font-size:10px; color:#94a3b8; flex-shrink:0; white-space:nowrap; }
        
        /* ── Leaderboard ── */
        .lb-row { display:flex; align-items:center; gap:12px; padding:10px 16px; border-bottom:1px solid #f1f5f9; transition:background .15s; }
        .lb-row:last-child { border-bottom:none; }
        .lb-row:hover { background:#f8fafc; }
        .lb-rank { width:28px; height:28px; border-radius:8px; display:flex; align-items:center; justify-content:center; font-size:12px; font-weight:800; flex-shrink:0; }
        .lb-rank.top1 { background:#fef9c3; color:#a16207; }
        .lb-rank.top2 { background:#f1f5f9; color:#475569; }
        .lb-rank.top3 { background:#fff7ed; color:#c2410c; }
        .lb-rank.other{ background:#f8fafc; color:#94a3b8; }
        .lb-avatar    { width:32px; height:32px; border-radius:9px; object-fit:cover; border:2px solid #e0f2fe; flex-shrink:0; }
        .lb-name      { flex:1; min-width:0; font-size:13px; font-weight:700; color:#334155; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
        .lb-exp-badge { display:inline-flex; align-items:center; gap:3px; padding:3px 9px; border-radius:9999px; background:linear-gradient(90deg,#fef3c7,#fde68a); color:#92400e; font-size:11px; font-weight:800; flex-shrink:0; }
        .lb-level     { font-size:11px; color:#94a3b8; flex-shrink:0; }
        .lb-hist-row  { display:flex; align-items:center; justify-content:space-between; padding:7px 16px; border-bottom:1px solid #f8fafc; font-size:12px; }
        .lb-hist-row:last-child { border-bottom:none; }
        
        /* ── Live sessions ── */
        .live-pulse { width:8px; height:8px; border-radius:50%; background:#22c55e; flex-shrink:0; animation:livePulse 1.4s ease-in-out infinite; }
        @keyframes livePulse { 0%,100%{opacity:1;transform:scale(1)} 50%{opacity:.5;transform:scale(1.3)} }
        .session-row { display:flex; align-items:center; gap:12px; padding:10px 16px; border-bottom:1px solid #f1f5f9; }
        .session-row:last-child { border-bottom:none; }
        .session-mode { font-size:10px; font-weight:700; padding:2px 7px; border-radius:9999px; }
        .mode-single { background:#e0f2fe; color:#0369a1; }
        .mode-duel   { background:#fce7f3; color:#9d174d; }
        .session-progress { flex:1; min-width:80px; }
        .session-item-bar { height:4px; background:#e2e8f0; border-radius:9999px; overflow:hidden; margin-top:3px; }
        .session-item-fill { height:100%; border-radius:9999px; background:#8b5cf6; transition:width .4s; }
        
        /* ── Flagged alerts ── */
        .flag-row { display:flex; align-items:center; gap:12px; padding:11px 16px; border-bottom:1px solid #f1f5f9; }
        .flag-row:last-child { border-bottom:none; }
        .flag-badge { display:inline-flex; align-items:center; gap:4px; padding:3px 9px; border-radius:9999px; font-size:10px; font-weight:700; background:#fef2f2; color:#b91c1c; flex-shrink:0; }
        .flag-assessment-name { font-size:11px; color:#64748b; margin-top:1px; }
        
        /* ── Live refresh button ── */
        .refresh-btn { display:flex; align-items:center; gap:5px; padding:6px 12px; border-radius:8px; border:1px solid #e2e8f0; background:white; font-size:12px; font-weight:600; color:#475569; cursor:pointer; font-family:'Plus Jakarta Sans',sans-serif; transition:all .15s; }
        .refresh-btn:hover { border-color:#06b6d4; color:#0891b2; background:#ecfeff; }
        .refresh-btn.spinning i { animation:spin .7s linear infinite; }
        @keyframes spin { to{transform:rotate(360deg)} }

        /* ── Compose announcement button ── */
        .compose-btn { display:inline-flex; align-items:center; gap:6px; padding:7px 14px; border-radius:9px; border:1px solid #e2e8f0; background:white; font-size:12px; font-weight:700; color:#475569; cursor:pointer; font-family:'Plus Jakarta Sans',sans-serif; transition:all .15s; }
        .compose-btn:hover { background:#f0fdfa; border-color:#06b6d4; color:#0891b2; }
        .compose-btn.primary { background:#0891b2; border-color:#0e7490; color:white; }
        .compose-btn.primary:hover { background:#0e7490; }
        
        /* ════════════════════════════════════════
        SCHEDULING & CALENDAR SECTION
        ════════════════════════════════════════ */
        
        /* ── Section tab bar ── */
        .cal-tabs { display:flex; gap:2px; background:#f1f5f9; border-radius:10px; padding:3px; flex-wrap:wrap; }
        .cal-tab  { padding:7px 16px; border-radius:8px; font-size:12px; font-weight:700; color:#64748b; cursor:pointer; transition:all .15s; display:flex; align-items:center; gap:5px; border:none; background:transparent; font-family:'Plus Jakarta Sans',sans-serif; }
        .cal-tab:hover  { background:white; color:#334155; }
        .cal-tab.active { background:white; color:#7c3aed; box-shadow:0 1px 4px rgba(0,0,0,0.08); }
        .cal-panel { display:none; }
        .cal-panel.active { display:flex; flex-direction:column; flex:1; min-height:540px; }
        
        /* ── Mini calendar grid ── */
        .cal-grid-wrap { padding:18px; }
        .cal-nav { display:flex; align-items:center; justify-content:space-between; margin-bottom:14px; }
        .cal-nav-btn { width:30px; height:30px; border-radius:8px; border:1px solid #e2e8f0; background:white; cursor:pointer; display:flex; align-items:center; justify-content:center; color:#64748b; transition:all .15s; }
        .cal-nav-btn:hover { border-color:#7c3aed; color:#7c3aed; background:#f5f3ff; }
        .cal-month-label { font-size:14px; font-weight:800; color:#1e293b; }
        .cal-dow-row { display:grid; grid-template-columns:repeat(7,1fr); gap:2px; margin-bottom:4px; }
        .cal-dow { font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.05em; color:#94a3b8; text-align:center; padding:4px 0; }
        .cal-day-grid { display:grid; grid-template-columns:repeat(7,1fr); gap:2px; }
        .cal-day { min-height:64px; border-radius:8px; padding:5px 6px; background:#fafafa; border:1px solid #f1f5f9; cursor:pointer; transition:background .12s; position:relative; overflow:hidden; }
        .cal-day:hover { background:#f5f3ff; border-color:#ddd6fe; }
        .cal-day.other-month .cal-day-num { color:#d1d5db; }
        .cal-day.today { background:#faf5ff; border-color:#c4b5fd; }
        .cal-day.today .cal-day-num { color:#7c3aed; font-weight:800; }
        .cal-day.selected { background:#ede9fe; border-color:#7c3aed; }
        .cal-day-num { font-size:11px; font-weight:700; color:#475569; margin-bottom:3px; }
        .cal-event-dot { display:flex; align-items:center; gap:3px; font-size:9px; font-weight:700; padding:1px 5px; border-radius:4px; margin-bottom:1px; overflow:hidden; white-space:nowrap; text-overflow:ellipsis; max-width:100%; }
        .cal-event-dot.ev-material   { background:#dbeafe; color:#1d4ed8; }
        .cal-event-dot.ev-deadline   { background:#fee2e2; color:#b91c1c; }
        .cal-event-dot.ev-exam       { background:#fef3c7; color:#92400e; }
        .cal-event-dot.ev-holiday    { background:#dcfce7; color:#15803d; }
        .cal-event-dot.ev-assessment { background:#fce7f3; color:#9d174d; }
        .cal-more { font-size:9px; color:#94a3b8; font-weight:600; }
        
        /* ── Event list (right panel) ── */
        .cal-layout { display:grid; grid-template-columns:1fr 300px; gap:0; flex:1; }
        @media (max-width:768px) { .cal-layout { grid-template-columns:1fr; } }
        .cal-event-list-panel { border-left:1px solid #f1f5f9; overflow-y:auto; max-height:520px; display:flex; flex-direction:column; }
        .cal-event-list-panel::-webkit-scrollbar { width:3px; }
        .cal-event-list-panel::-webkit-scrollbar-thumb { background:#e2e8f0; border-radius:9999px; }
        .cal-event-list-header { padding:14px 16px; border-bottom:1px solid #f1f5f9; background:#fafafa; display:flex; align-items:center; justify-content:space-between; gap:8px; flex-wrap:wrap; flex-shrink:0; }
        #calEventList { flex:1; display:flex; flex-direction:column; }
        #calEventList > .cal-empty { flex:1; display:flex; flex-direction:column; align-items:center; justify-content:center; padding:24px 16px; }
        .cal-event-item { padding:11px 16px; border-bottom:1px solid #f8fafc; display:flex; align-items:flex-start; gap:10px; transition:background .15s; }
        .cal-event-item:hover { background:#fafbff; }
        .cal-event-item:last-child { border-bottom:none; }
        .cal-event-color-bar { width:3px; border-radius:9999px; flex-shrink:0; align-self:stretch; min-height:36px; }
        .cal-event-name { font-size:12px; font-weight:700; color:#334155; line-height:1.4; }
        .cal-event-meta { font-size:10px; color:#94a3b8; margin-top:2px; display:flex; align-items:center; gap:6px; flex-wrap:wrap; }
        .cal-event-type-badge { display:inline-flex; align-items:center; gap:3px; padding:1px 7px; border-radius:9999px; font-size:10px; font-weight:700; }
        .ev-badge-material   { background:#dbeafe; color:#1d4ed8; }
        .ev-badge-deadline   { background:#fee2e2; color:#b91c1c; }
        .ev-badge-exam       { background:#fef3c7; color:#92400e; }
        .ev-badge-holiday    { background:#dcfce7; color:#15803d; }
        .ev-badge-assessment { background:#fce7f3; color:#9d174d; }
        .ev-badge-recurring  { display:inline-flex; align-items:center; gap:2px; padding:1px 6px; border-radius:9999px; background:#f5f3ff; color:#7c3aed; font-size:10px; font-weight:700; }
        
        /* ── Upcoming timeline ── */
        .timeline-wrap { padding:18px; flex:1; display:flex; flex-direction:column; }
        .timeline-group { margin-bottom:20px; }
        .timeline-date-label { font-size:11px; font-weight:800; color:#94a3b8; text-transform:uppercase; letter-spacing:.07em; margin-bottom:8px; display:flex; align-items:center; gap:6px; }
        .timeline-date-label::after { content:''; flex:1; height:1px; background:#f1f5f9; }
        .timeline-item { display:flex; align-items:flex-start; gap:12px; padding:9px 0; }
        .timeline-dot { width:10px; height:10px; border-radius:50%; flex-shrink:0; margin-top:4px; border:2px solid white; box-shadow:0 0 0 1.5px currentColor; }
        .timeline-dot.td-material   { color:#3b82f6; background:#3b82f6; }
        .timeline-dot.td-deadline   { color:#ef4444; background:#ef4444; }
        .timeline-dot.td-exam       { color:#f59e0b; background:#f59e0b; }
        .timeline-dot.td-holiday    { color:#22c55e; background:#22c55e; }
        .timeline-dot.td-assessment { color:#ec4899; background:#ec4899; }
        .timeline-line { position:relative; }
        .timeline-line::before { content:''; position:absolute; left:4px; top:18px; width:1.5px; bottom:-10px; background:#f1f5f9; }
        .tl-name { font-size:12px; font-weight:700; color:#334155; }
        .tl-meta { font-size:10px; color:#94a3b8; margin-top:1px; display:flex; gap:6px; flex-wrap:wrap; }
        .tl-days-left { font-size:10px; font-weight:800; padding:1px 7px; border-radius:9999px; flex-shrink:0; }
        .tl-overdue  { background:#fee2e2; color:#b91c1c; }
        .tl-today    { background:#fef9c3; color:#a16207; }
        .tl-soon     { background:#fce7f3; color:#9d174d; }
        .tl-upcoming { background:#f0fdf4; color:#15803d; }
        .tl-far      { background:#f8fafc; color:#64748b; }
        
        /* ── Calendar filter bar ── */
        .cal-filter-bar { display:flex; flex-wrap:wrap; align-items:center; gap:8px; padding:12px 18px; border-bottom:1px solid #f1f5f9; background:#fafafa; }
        
        /* ── Calendar event modal ── */
        .cal-modal-backdrop { display:none; position:fixed; inset:0; z-index:300; background:rgba(15,23,42,0.55); align-items:center; justify-content:center; padding:16px; }
        .cal-modal-backdrop.open { display:flex; }
        .cal-modal-card { background:white; border-radius:1.25rem; width:100%; max-width:560px; box-shadow:0 20px 60px rgba(15,23,42,0.18); overflow:hidden; animation:modalIn .2s ease; }
        
        /* ── Duration type toggle ── */
        .dur-field { display:none; }
        .dur-field.visible { display:block; }
        
        /* ── Recurring fields ── */
        .repeat-field { display:none; }
        .repeat-field.visible { display:block; }
        
        /* ── Empty state ── */
        .cal-empty { text-align:center; padding:48px 0; color:#cbd5e1; font-size:13px; font-weight:600; }
        .cal-empty i { font-size:28px; display:block; margin-bottom:8px; }
        /* END PART 2 — CSS */
        
        /* Nav active state */
        .nav-active {
            background: linear-gradient(135deg, #06b6d4 0%, #6366f1 100%) !important;
            color: white !important;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(6,182,212,0.3), 0 2px 8px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Profile dropdown */
        .profile-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 210px;
            background: white;
            border-radius: 1rem;
            box-shadow: 0 8px 32px rgba(6,182,212,0.13), 0 2px 8px rgba(99,102,241,0.10);
            border: 1px solid #e0f2fe;
            z-index: 999;
            opacity: 0;
            transform: translateY(-6px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.18s ease, transform 0.18s ease;
        }
        .profile-dropdown.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all;
        }
        .profile-dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 700;
            color: #1e293b;
            cursor: pointer;
            transition: background 0.13s;
            border-radius: 0.75rem;
            text-decoration: none;
        }
        .profile-dropdown-item:hover { background: #f0f9ff; color: #0369a1; }
        .profile-dropdown-item.danger:hover { background: #fff1f2; color: #be123c; }
        /* ── Main Tab Navigation ── */
        .main-tab {
            padding: 10px 16px;
            border-radius: 12px;
            font-size: 13px;
            font-weight: 700;
            color: #64748b;
            background: #f8fafc;
            border: 1px solid #e2e8f0;
            cursor: pointer;
            transition: all 0.2s ease;
            white-space: nowrap;
            display: flex;
            align-items: center;
        }
        .main-tab:hover {
            background: #e2e8f0;
            color: #334155;
        }
        .main-tab.active {
            background: #4f46e5;
            color: white;
            border-color: #4338ca;
            box-shadow: 0 4px 6px -1px rgba(79,70,229,0.2);
        }
        .main-tab-content {
            display: none;
            animation: fadeIn 0.3s ease;
        }
        .main-tab-content.active {
            display: block;
        }
    </style>
    <%- include('../partials/teacher-nav-styles') %>
</head>
<body class="text-slate-900">

<div class="flex min-h-screen relative overflow-x-hidden">

    <!-- Sidebar overlay (mobile) -->
    <%- include('../partials/teacher-sidebar', { activeNav: 'classes' }) %>

    <!-- ===== MAIN ===== -->
    <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- Top header -->
        <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                    <i class="fas fa-bars text-xl"></i>
                </button>

                <div class="hidden sm:block">
                    <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">MANAGE CLASSES</h1>
                    <nav class="text-xs text-slate-500 hidden sm:flex items-center gap-2 font-medium">
                        <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                        <a href="/teacher/classes" class="text-slate-500 hover:text-indigo-600 transition">My Classes</a>
                        <i class="fas fa-chevron-right text-slate-400 text-[10px]"></i>
                        <span class="font-bold text-indigo-950 truncate max-w-[220px]"><%= classInfo.class_name %></span>
                    </nav>
                </div>
            </div>

            <div class="flex items-center gap-3 md:gap-6">
                    <!-- Messages Navigation Button (Entry point to teacher messages workspace) -->
                    <a href="/teacher/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                        <i class="far fa-comment-dots text-xl"></i>
                        
                        <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                            <span class="msg-badge-count">0</span>
                        </span>

                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Messages
                        </span>
                    </a>

                <!-- Notification Button with keyboard-accessible tooltip -->
                <button type="button" onclick="toggleNotifPanel()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                    <i class="far fa-bell text-xl text-slate-700"></i>
                    <% const _unreadNotifCount = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications.filter(n => !n.is_read).length : 0; %>
                    <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center notif-badge <%= _unreadNotifCount > 0 ? '' : 'hidden' %>" aria-hidden="true">
                        <span class="notif-badge-count"><%= _unreadNotifCount > 99 ? '99+' : _unreadNotifCount %></span>
                    </span>
                    <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                        Notifications
                    </span>
                </button>

                <!-- User Profile Dropdown -->
                <div class="relative">
                    <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                        <div class="text-right hidden lg:block">
                            <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none"><%= user.role || 'Teacher' %></p>
                        </div>
                        <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100" onerror="this.src='/profile_uploads/default_avatar.png'">
                        <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                    </button>

                    <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                        <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                            <p class="text-sm font-bold text-slate-800"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role || 'Teacher' %></p>
                        </div>
                        <a href="/teacher/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                            <i class="far fa-user w-5 text-center"></i> View Profile
                        </a>
                        <hr class="my-2 border-slate-100">
                        <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                            <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- ===== SCROLLABLE CONTENT ===== -->
            <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col space-y-6">
    
                <div class="p-4 md:p-8 flex-1">

                <% if (typeof isHistoricalSY !== 'undefined' && isHistoricalSY) { %>
                <div class="mb-5 p-4 rounded-2xl bg-gradient-to-r from-amber-500/20 to-orange-500/20 border border-amber-500/40 backdrop-blur-md flex items-center justify-between gap-3 text-amber-200 shadow-md">
                    <div class="flex items-center gap-3.5">
                        <div class="w-10 h-10 rounded-xl bg-amber-500/30 border border-amber-400/40 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-box-archive text-amber-300 text-lg"></i>
                        </div>
                        <div>
                            <h4 class="font-bold text-sm text-white flex items-center gap-2">
                                Archived Academic Year (S.Y. <%= schoolYear ? schoolYear.sy_range : '' %>)
                                <span class="text-[10px] font-black uppercase px-2 py-0.5 rounded bg-amber-400/20 text-amber-300 border border-amber-400/30">Read-Only Archive</span>
                            </h4>
                            <p class="text-xs text-amber-200/90 mt-0.5">
                                This class section belongs to a historical academic year. Grade modifications and student roster changes are locked in read-only mode.
                            </p>
                        </div>
                    </div>
                    <a href="/teacher/classes" class="hidden sm:inline-flex items-center gap-1.5 px-3.5 py-2 rounded-xl bg-white/10 hover:bg-white/20 text-white text-xs font-bold transition border border-white/20 flex-shrink-0">
                        <i class="fas fa-arrow-left"></i> All Classes
                    </a>
                </div>
                <% } %>

                <!-- ============================================================
                     SECTION 1 · CLASS / SUBJECT INFO HERO
                ============================================================ -->
                <div class="subject-hero p-7 md:p-10 shadow-2xl shadow-indigo-900/20 mb-6">

                    <!-- Decorative subject image -->
                    <% if (subject.subject_image && subject.subject_image !== 'default_subject.png') { %>
                    <img src="/profile_uploads/<%= subject.subject_image %>" class="subject-hero-img" alt="" onerror="this.src='/profile_uploads/default_subject.png'">
                    <% } %>

                    <div class="relative z-10 flex flex-col gap-5">

                        <!-- Top row: thumbnail + title block side by side -->
                        <div class="flex flex-col gap-4 md:flex-row md:items-start md:gap-6">

                            <!-- Thumbnail with upload overlay -->
                            <div class="flex-shrink-0 relative group" style="width:96px">
                                <div class="relative w-24 h-24 rounded-2xl overflow-hidden ring-4 ring-white/20 shadow-xl bg-indigo-900/60 flex items-center justify-center" id="subjectThumbWrap">
    
                                    <!-- Image Layer -->
                                    <% if (subject.subject_image && subject.subject_image !== 'default_subject.png') { %>
                                        <img src="/profile_uploads/<%= subject.subject_image %>" 
                                            class="absolute inset-0 w-full h-full object-cover z-0" 
                                            onerror="this.style.display='none';">
                                    <% } %>

                                    <!-- Icon Layer (Overlay) -->
                                    <!-- Nilagyan natin ng z-10 para siguradong nasa ibabaw at drop-shadow para mabasa kahit maliwanag ang background -->
                                    <i class="fas fa-flask text-4xl text-cyan-400 opacity-80 z-10 drop-shadow-lg" id="thumbIcon"></i>

                                </div>
                                <!-- Upload overlay -->
                                <button onclick="document.getElementById('subjectImageInput').click()"
                                        title="Change subject image"
                                        class="absolute inset-0 rounded-2xl bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity flex flex-col items-center justify-center gap-1 cursor-pointer border-2 border-dashed border-white/40">
                                    <i class="fas fa-camera text-white text-base"></i>
                                    <span class="text-white text-sm font-bold">Change</span>
                                </button>
                                <input type="file" id="subjectImageInput" accept="image/*" class="hidden" onchange="uploadSubjectImage(this)">
                            </div>

                            <!-- Title + meta -->
                            <div class="flex-1 min-w-0">
                                <!-- Meta chips -->
                                <div class="flex flex-wrap items-center gap-2 mb-3">
                                    <span class="meta-chip bg-cyan-500/20 text-cyan-300 border border-cyan-500/30">
                                        <i class="fas fa-hashtag text-sm"></i>
                                        <%= subject.subject_code %>
                                    </span>
                                    <span class="meta-chip bg-indigo-500/20 text-indigo-300 border border-indigo-500/30">
                                        <i class="fas fa-calendar-days text-sm"></i>
                                        Semester <%= subject.semester %>
                                    </span>
                                    <span class="meta-chip <%= (typeof isHistoricalSY !== 'undefined' && isHistoricalSY) ? 'bg-amber-500/20 text-amber-300 border border-amber-500/30' : 'bg-emerald-500/20 text-emerald-300 border border-emerald-500/30' %>">
                                        <i class="fas fa-graduation-cap text-sm"></i>
                                        S.Y. <%= schoolYear.sy_range %> <% if (typeof isHistoricalSY !== 'undefined' && isHistoricalSY) { %>(Archive)<% } else { %>(Current)<% } %>
                                    </span>
                                </div>

                                <!-- Names -->
                                <h1 class="text-2xl md:text-3xl font-black text-white leading-tight tracking-tight mb-1">
                                    <%= subject.subject_name %>
                                </h1>
                                <p class="text-indigo-300 font-semibold text-base">
                                    <i class="fas fa-chalkboard-user mr-1 opacity-60"></i>
                                    <%= classInfo.class_name %>
                                </p>
                            </div>
                        </div>

                        <!-- Description — full width below the top row -->
                        <% if (subject.description) { %>
                        <p class="text-slate-300 text-base leading-relaxed opacity-90 w-full max-w-none mb-1">
                            <%= subject.description %>
                        </p>
                        <% } %>

                        <!-- Quick stats row -->
                        <div class="flex flex-wrap gap-2 items-center">
                            <span class="stat-pill">
                                <i class="fas fa-users text-cyan-400 text-sm"></i>
                                <%= students.length %> Students
                            </span>

                            <!-- Enrollment code: hidden by default, togglable -->
                            <span class="stat-pill" style="gap:8px">
                                <i class="fas fa-key text-amber-400 text-sm"></i>
                                Enrollment Code:
                                <span id="enrollCodeMask" class="text-white font-bold ml-1 tracking-widest">••••••••</span>
                                <span id="enrollCodeText" class="text-white font-bold ml-1 hidden"><%= subject.enrollment_code || 'N/A' %></span>
                                <button onclick="toggleEnrollCode()" title="Show/hide code"
                                        class="w-5 h-5 flex items-center justify-center rounded hover:bg-white/10 transition" id="enrollToggleBtn">
                                    <i class="fas fa-eye text-white/60 text-sm" id="enrollToggleIcon"></i>
                                </button>
                                <button onclick="openShareModal()" title="Share enrollment key"
                                        class="w-5 h-5 flex items-center justify-center rounded hover:bg-white/10 transition text-white/60 hover:text-white">
                                    <i class="fas fa-share-nodes text-sm"></i>
                                </button>
                            </span>

                            <span class="stat-pill">
                                <i class="fas fa-user-tie text-purple-400 text-sm"></i>
                                <%= user.first_name %> <%= user.last_name %>
                            </span>
                        </div>
                    </div>
                </div>

                <!-- ======= SHARE ENROLLMENT KEY MODAL ======= -->
                <div class="modal-backdrop" id="shareModal" style="display:none;position:fixed;inset:0;z-index:500;background:rgba(15,23,42,0.6);align-items:center;justify-content:center;padding:16px;">
                    <div class="modal-card" style="max-width:480px">
                        <div class="modal-header">
                            <div class="flex items-center gap-3">
                                <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center">
                                    <i class="fas fa-share-nodes text-amber-600 text-base"></i>
                                </div>
                                <h3 class="font-bold text-slate-800 text-base">Share Enrollment Key</h3>
                            </div>
                            <button onclick="closeShareModal()" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400">
                                <i class="fas fa-times text-base"></i>
                            </button>
                        </div>
                        <div class="modal-body" style="padding:20px 24px">
                            <p class="text-slate-500 text-sm mb-3">Send the message below to your students so they can enroll in this class.</p>
                            <div id="shareMessageBox" class="bg-slate-50 border border-slate-200 rounded-xl p-4 text-base text-slate-700 leading-relaxed whitespace-pre-line font-medium" style="min-height:100px">Please use this enrollment key for your LMS elective course <%= subject.subject_name %> - <%= classInfo.class_name %>
Enrollment Key: <%= subject.enrollment_code || 'N/A' %></div>
                        </div>
                        <div class="modal-footer" style="padding:12px 24px;display:flex;gap:8px;justify-content:flex-end;border-top:1px solid #f1f5f9">
                            <button onclick="closeShareModal()" class="sort-btn">Ok</button>
                            <button onclick="copyShareMessage()" class="sort-btn active" style="background:#0891b2;border-color:#0e7490;color:white" id="copyShareBtn">
                                <i class="fas fa-copy text-sm"></i> Copy
                            </button>
                        </div>
                    </div>
                </div>


                <!-- ======= MAIN TABS NAVIGATION ======= -->
                <div class="flex gap-2 overflow-x-auto mb-6 pb-2" style="scrollbar-width: thin;">
                    <button class="main-tab active" onclick="switchMainTab('tab-announcements', this)">
                        <i class="fas fa-bullhorn mr-1"></i> Announcements
                    </button>
                    <button class="main-tab" onclick="switchMainTab('tab-attendance', this)">
                        <i class="fas fa-clipboard-user mr-1"></i> Attendance
                    </button>
                    <button class="main-tab" onclick="switchMainTab('tab-calendar', this)">
                        <i class="fas fa-calendar-alt mr-1"></i> Calendar
                    </button>
                    <button class="main-tab" onclick="switchMainTab('tab-content', this)">
                        <i class="fas fa-book mr-1"></i> Content Management
                    </button>
                    <button class="main-tab" onclick="switchMainTab('tab-students', this)">
                        <i class="fas fa-users mr-1"></i> Enrolled Students
                    </button>
                    <button class="main-tab" onclick="switchMainTab('tab-analytics', this)">
                        <i class="fas fa-chart-line mr-1"></i> Scores & Analytics
                    </button>
                </div>

                <!-- ============================================================
                     SECTION · ANNOUNCEMENTS
                ============================================================ -->
                <div class="main-tab-content active" id="tab-announcements">
                <div class="section-card mb-6" id="classAnnouncementsSection">
                    <div class="section-header">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-amber-400 to-rose-500 flex items-center justify-center shadow-md shadow-rose-200 flex-shrink-0">
                                <i class="fas fa-bullhorn text-white text-base"></i>
                            </div>
                            <div>
                                <h2 class="text-base font-bold text-slate-800">Class Announcements</h2>
                                <p class="text-sm text-slate-400">Official section updates, exam reminders, and emergency broadcasts</p>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <button class="compose-btn primary" onclick="openAnnouncementModal(null, <%= classInfo.class_id %>)" style="background:#be123c;border-color:#e11d48;color:white">
                                <i class="fas fa-plus text-sm"></i> Add Announcement
                            </button>
                        </div>
                    </div>

                    <div class="p-4 flex-1 flex flex-col" id="announcementsContainer">
                        <% if (announcements && announcements.length > 0) { %>
                        <div class="overflow-x-auto flex-1" id="announcementsTableWrapper">
                            <table class="sub-table w-full" id="class-ann-table">
                                <thead>
                                    <tr>
                                        <th style="width:30px">#</th>
                                        <th>Title</th>
                                        <th>Priority</th>
                                        <th>Scope</th>
                                        <th>Author</th>
                                        <th>Posted / Deadline</th>
                                        <th style="width:100px;text-align:right">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="class-ann-tbody">
                                <% announcements.forEach(function(ann, ni) { %>
                                <%
                                    var annDate = ann.created_at ? new Date(ann.created_at).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '—';
                                %>
                                <tr data-search="<%= ann.title.toLowerCase() %>" id="ann-row-<%= ann.announcement_id %>">
                                    <td class="text-slate-400 font-bold ann-index-cell"><%= ni + 1 %></td>
                                    <td class="font-semibold text-slate-700 max-w-[260px] truncate">
                                        <%= ann.title %>
                                        <% if (ann.is_critical) { %>
                                            <span class="ml-1.5 px-2 py-0.5 rounded-full text-[9px] font-black uppercase bg-rose-500 text-white animate-pulse">Emergency</span>
                                        <% } %>
                                        <% if (ann.attachment_url) { %>
                                            <span class="ml-1 text-cyan-600 text-xs" title="Attached Document: <%= ann.attachment_name || 'Attachment' %>"><i class="fas fa-paperclip"></i></span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <button class="icon-btn <%= ann.is_priority ? 'warn' : '' %>"
                                                title="<%= ann.is_priority ? 'Remove priority' : 'Set as priority' %>"
                                                onclick="toggleAnnouncementPriority(<%= ann.announcement_id %>, <%= ann.is_priority ? 1 : 0 %>)"
                                                id="ann-prio-<%= ann.announcement_id %>">
                                            <i class="fas fa-flag text-sm <%= ann.is_priority ? 'text-amber-500' : 'text-slate-300' %>"></i>
                                        </button>
                                        <% if (ann.is_priority) { %>
                                        <span class="badge-priority ml-1"><i class="fas fa-flag text-xs"></i> Priority</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span class="px-2.5 py-1 rounded-lg text-xs font-semibold bg-slate-100 text-slate-700 border border-slate-200 inline-flex items-center gap-1.5">
                                            <i class="fas <%= ann.scope === 'global' ? 'fa-globe text-cyan-500' : 'fa-users text-indigo-500' %> text-[10px]"></i>
                                            <%= ann.scope === 'global' ? 'Campus-Wide' : classInfo.class_name %>
                                        </span>
                                    </td>
                                    <td class="text-slate-600 text-xs font-medium">
                                        <%= ann.author_name || 'Instructor' %>
                                    </td>
                                    <td class="text-slate-500 text-xs">
                                        <p><%= annDate %></p>
                                        <% if (ann.due_date) { %>
                                            <p class="text-[10px] font-bold text-rose-500 mt-0.5"><i class="fas fa-clock mr-0.5"></i>Due <%= new Date(ann.due_date).toLocaleDateString('en-US', {month:'short', day:'numeric'}) %></p>
                                        <% } %>
                                    </td>
                                    <td class="text-right">
                                        <div class="flex gap-1 justify-end">
                                            <button class="icon-btn" title="Preview Announcement & Attached Proof"
                                                    type="button"
                                                    onclick='openAnnouncementPreview(<%- JSON.stringify(ann) %>)'>
                                                <i class="fas fa-eye text-sm text-cyan-600"></i>
                                            </button>
                                            <button class="icon-btn" title="Edit"
                                                    type="button"
                                                    onclick='editAnnouncementItem(<%- JSON.stringify(ann) %>, <%= classInfo.class_id %>)'>
                                                <i class="fas fa-pen text-sm"></i>
                                            </button>
                                            <button class="icon-btn danger" title="Delete"
                                                    type="button"
                                                    onclick='confirmDelete("announcement", <%= ann.announcement_id %>, <%- JSON.stringify(ann.title) %>)'>
                                                <i class="fas fa-trash text-sm"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                                <% }); %>
                                </tbody>
                            </table>
                        </div>
                        <% } else { %>
                        <div class="standard-empty-state" style="margin:0;min-height:510px;" id="announcementsEmptyState">
                            <div class="w-14 h-14 rounded-2xl bg-rose-50 text-rose-600 flex items-center justify-center text-2xl mx-auto mb-3.5 shadow-sm border border-rose-100">
                                <i class="fas fa-bullhorn"></i>
                            </div>
                            <h4 class="text-sm font-bold text-slate-700 mb-1">No announcements published for <%= classInfo.class_name %></h4>
                            <p class="text-xs text-slate-400 max-w-sm mx-auto mb-4">Post class-wide updates, schedule adjustments, or emergency notices directly to your students.</p>
                            <button type="button" class="inline-flex items-center gap-1.5 px-4 py-2 rounded-xl text-xs font-bold bg-rose-600 hover:bg-rose-700 text-white shadow-sm transition" onclick="openAnnouncementModal(null, <%= classInfo.class_id %>)">
                                <i class="fas fa-plus text-xs"></i> Post First Announcement
                            </button>
                        </div>
                        <% } %>
                    </div>
                </div>
                </div> <!-- END tab-announcements -->

                <!-- ============================================================
                     SECTION · ATTENDANCE MONITORING & ANALYTICS
                ============================================================ -->
                <div class="main-tab-content" id="tab-attendance">
                    <!-- Attendance Sub-Navigation & Quick Action Bar -->
                    <div class="flex flex-col md:flex-row items-stretch md:items-center justify-between gap-4 mb-6 bg-white p-3 rounded-2xl border border-slate-200 shadow-sm">
                        <!-- Sub-view toggle -->
                        <div class="inline-flex p-1 bg-slate-100 rounded-xl border border-slate-200">
                            <button type="button" id="attSubTabBtnAnalytics" onclick="switchAttendanceSubView('analytics')"
                                class="px-4 py-2 rounded-lg text-xs font-black transition flex items-center gap-2 bg-white text-indigo-700 shadow-sm">
                                <i class="fas fa-chart-line text-sm text-indigo-600"></i>
                                <span>Attendance Intelligence &amp; LMS Analytics</span>
                                <span class="ml-1 px-1.5 py-0.5 rounded-full text-[10px] bg-indigo-100 text-indigo-700 font-extrabold" id="attAnalyticsBadge">Live Telemetry</span>
                            </button>
                            <button type="button" id="attSubTabBtnRollcall" onclick="switchAttendanceSubView('rollcall')"
                                class="px-4 py-2 rounded-lg text-xs font-bold transition flex items-center gap-2 text-slate-600 hover:text-slate-900">
                                <i class="fas fa-clipboard-check text-sm text-emerald-600"></i>
                                <span>Daily Roll Call &amp; Recording</span>
                                <span class="ml-1 px-1.5 py-0.5 rounded-full text-[10px] bg-slate-200/80 text-slate-600 font-bold">Manual Registry</span>
                            </button>
                        </div>

                        <!-- Range selector & Action buttons -->
                        <div class="flex items-center gap-2 flex-wrap">
                            <div class="flex items-center bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1 text-xs">
                                <i class="fas fa-filter text-slate-400 mr-2 text-[11px]"></i>
                                <span class="text-slate-500 font-bold mr-1 text-[11px]">Period:</span>
                                <select id="attAnalyticsRange" onchange="changeAttendanceAnalyticsRange(this.value)" class="bg-transparent border-0 text-xs font-bold text-slate-800 focus:ring-0 outline-none cursor-pointer py-1">
                                    <option value="all" selected>All Time (Entire Term)</option>
                                    <option value="month">Current Month</option>
                                    <option value="30d">Last 30 Days</option>
                                    <option value="7d">Last 7 Days</option>
                                </select>
                            </div>
                            <button type="button" onclick="exportAttendanceSummaryCsv()" title="Export Summary CSV"
                                class="px-3 py-2 bg-white hover:bg-slate-50 text-slate-700 border border-slate-200 rounded-xl text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                                <i class="fas fa-file-csv text-emerald-600 text-sm"></i>
                                <span class="hidden sm:inline">Export CSV</span>
                            </button>
                            <button type="button" onclick="reloadAttendanceAnalytics()" title="Refresh Attendance &amp; LMS Presence Data"
                                class="p-2 w-9 h-9 bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-600 border border-slate-200 rounded-xl text-xs font-bold transition flex items-center justify-center">
                                <i class="fas fa-arrows-rotate text-sm" id="attRefreshIcon"></i>
                            </button>
                        </div>
                    </div>

                    <!-- ========================================================
                         SUBVIEW 1: ATTENDANCE ANALYTICS & LMS TELEMETRY DASHBOARD
                    ======================================================== -->
                    <div id="attSubViewAnalytics" class="space-y-6">
                        <!-- Top Banner / High Impact Quick Summary -->
                        <div class="relative overflow-hidden rounded-2xl bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 p-6 text-white shadow-xl border border-indigo-500/20">
                            <div class="absolute -right-12 -top-12 w-64 h-64 rounded-full bg-indigo-500/10 blur-3xl pointer-events-none"></div>
                            <div class="absolute -left-12 -bottom-12 w-64 h-64 rounded-full bg-emerald-500/10 blur-3xl pointer-events-none"></div>
                            
                            <div class="relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-6">
                                <div>
                                    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-indigo-500/20 border border-indigo-400/30 text-indigo-300 text-xs font-bold mb-2">
                                        <i class="fas fa-shield-halved text-xs text-indigo-400"></i>
                                        <span>Attendance Intelligence Engine &bull; Section <%= classInfo.class_name %></span>
                                    </div>
                                    <h1 class="text-xl md:text-2xl font-black text-white tracking-tight">Course Attendance Intelligence &amp; Digital LMS Presence</h1>
                                    <p class="text-xs md:text-sm text-slate-300 mt-1 max-w-2xl font-normal leading-relaxed">
                                        Holistic physical roll-call analytics, punctuality metrics, and real-time student LMS telemetry (online monitoring, login activity, and engagement auditing) for Section <%= classInfo.class_name %>.
                                    </p>
                                </div>
                                <div class="flex items-center gap-3">
                                    <button type="button" onclick="switchAttendanceSubView('rollcall')"
                                        class="px-4 py-2.5 bg-gradient-to-r from-emerald-500 to-teal-600 hover:from-emerald-600 hover:to-teal-700 text-white rounded-xl text-xs font-bold transition flex items-center gap-2 shadow-lg shadow-emerald-500/20">
                                        <i class="fas fa-user-check text-xs"></i>
                                        <span>Take Today's Roll Call</span>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- 6 Executive KPI Cards -->
                        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-4">
                            <!-- Card 1: Class Attendance Rate -->
                            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden flex flex-col justify-between group hover:border-indigo-300 transition">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-[10px] font-black uppercase tracking-wider text-slate-400">Attendance Rate</span>
                                    <div class="w-7 h-7 rounded-lg bg-emerald-50 text-emerald-600 flex items-center justify-center text-xs">
                                        <i class="fas fa-percent"></i>
                                    </div>
                                </div>
                                <div>
                                    <div class="flex items-baseline gap-1.5">
                                        <span class="text-2xl font-black text-slate-800 tracking-tight" id="anaKpiRate">--%</span>
                                        <span class="text-[10px] font-bold text-slate-400">overall</span>
                                    </div>
                                    <div class="mt-2 flex items-center gap-1.5">
                                        <span id="anaKpiRateBadge" class="px-2 py-0.5 rounded-md text-[10px] font-extrabold bg-emerald-100 text-emerald-700">Calculating...</span>
                                    </div>
                                </div>
                            </div>

                            <!-- Card 2: LMS Online Right Now -->
                            <div class="bg-white p-4 rounded-2xl border border-slate-200 shadow-sm relative overflow-hidden flex flex-col justify-between group hover:border-emerald-300 transition">
                                <div class="flex items-center justify-between mb-2">
                                    <span class="text-[10px] font-black uppercase tracking-wider text-emerald-600">Online Now</span>
                                    <div class="relative flex h-3 w-3">
                                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                                        <span class="relative inline-flex rounded-full h-3 w-3 bg-emerald-500"></span>
                                    </div>
                                </div>
                                <div>
                                    <div class="flex items-baseline gap-1.5">
                                        <span class="text-2xl font-black text-slate-800 tracking-tight" id="anaKpiOnlineNow">0</span>
                                        <span class="text-[10px] font-bold text-slate-400">students</span>
                                    </div>
                                    <p class="text-[11px] text-emerald-600 mt-2 font-bold flex items-center gap-1">
                                        <i class="fas fa-signal text-[10px]"></i> <span>Active in LMS Now</span>
