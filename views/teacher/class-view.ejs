                cardsHtml += `
                <div class="p-4 rounded-2xl border ${borderClass} shadow-sm flex flex-col justify-between transition hover:shadow-md">
                    <div>
                        <div class="flex items-start justify-between gap-2 mb-3">
                            <div class="flex items-center gap-2.5">
                                <img src="${avatar}" class="w-10 h-10 rounded-full object-cover border-2 border-white shadow-sm" onerror="this.src='/assets/logo.png'">
                                <div>
                                    <h4 class="font-bold text-xs text-slate-800 leading-tight">${s.name}</h4>
                                    <span class="text-[10px] text-slate-400 font-mono">${s.lrn_number}</span>
                                </div>
                            </div>
                            <span class="px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider border ${s.engagementBadge || 'bg-slate-100 text-slate-600'}">
                                ${s.tier}
                            </span>
                        </div>

                        <!-- Metrics Grid -->
                        <div class="grid grid-cols-3 gap-2 p-2 bg-white rounded-xl border border-slate-100 text-center mb-3">
                            <div>
                                <span class="block text-[9px] font-bold text-slate-400 uppercase">Roll Call</span>
                                <span class="font-black text-xs ${s.attendance_rate < 80 ? 'text-rose-600' : 'text-slate-800'}">${s.attendance_rate}%</span>
                            </div>
                            <div>
                                <span class="block text-[9px] font-bold text-slate-400 uppercase">Absences</span>
                                <span class="font-black text-xs text-rose-600">${s.absent_count}</span>
                            </div>
                            <div>
                                <span class="block text-[9px] font-bold text-slate-400 uppercase">LMS Logins</span>
                                <span class="font-black text-xs text-indigo-600">${s.total_logins}</span>
                            </div>
                        </div>

                        <!-- Flag Alert Reason -->
                        <div class="p-2.5 rounded-xl bg-white border border-slate-100 text-[11px] mb-3 space-y-1">
