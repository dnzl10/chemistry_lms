/* ---- Toast helper ---- */
function cmToast(msg, type = 'success') {
    const el = document.getElementById('cm-toast');
    const icon = type === 'success' ? '✓' : '✕';
    el.textContent = icon + '  ' + msg;
    el.className   = 'show ' + type;
    clearTimeout(el._t);
    el._t = setTimeout(() => { el.className = ''; }, 3000);
}

/* ---- Quarter accordion ---- */
function toggleQuarter(qid) {
    const body    = document.getElementById('quarter-body-' + qid);
    const chevron = document.getElementById('chevron-q-' + qid);
    const isOpen  = body.style.display !== 'none';
    body.style.display = isOpen ? 'none' : 'block';
    chevron.classList.toggle('open', !isOpen);
}

/* ---- Topic panel expand ---- */
function toggleTopicPanel(tid) {
    const panel   = document.getElementById('panel-' + tid);
    const chevron = document.getElementById('chevron-t-' + tid);
    const isOpen  = panel.classList.contains('open');
    panel.classList.toggle('open', !isOpen);
    chevron.classList.toggle('open', !isOpen);
}

/* ---- Tab switching ---- */
function switchTab(tid, tabName, btn) {
    const panel = document.getElementById('panel-' + tid);
    panel.querySelectorAll('.tab-content').forEach(tc => tc.classList.add('hidden'));
    panel.querySelectorAll('.panel-tab').forEach(tb => tb.classList.remove('active'));
    document.getElementById('tab-' + tid + '-' + tabName).classList.remove('hidden');
    btn.classList.add('active');
}

/* ---- Unified Real-Time Content Management Search ---- */
function cmGeneralSearch(query) {
    const q = (query || '').toLowerCase().trim();
    const quarterBlocks = document.querySelectorAll('.quarter-block');
    const quartersContainer = document.getElementById('quartersContainer');
    const noResultsEl = document.getElementById('cmSearchNoResults');
    const queryDisplayEl = document.getElementById('cmSearchQueryDisplay');

    if (!q) {
        if (noResultsEl) noResultsEl.classList.add('hidden');
        if (quartersContainer) quartersContainer.classList.remove('hidden');
        // Reset all visibility
        quarterBlocks.forEach(qb => {
            qb.style.display = '';
        });
        document.querySelectorAll('.topic-row').forEach(row => {
            row.style.display = '';
        });
        document.querySelectorAll('.sub-table tbody tr').forEach(tr => {
            tr.style.display = '';
        });
        return;
    }

    let totalQuarterMatches = 0;

    quarterBlocks.forEach(qb => {
        const qid = qb.id.replace('quarter-block-', '');
        const topicRows = qb.querySelectorAll('.topic-row');
        let quarterHasMatch = false;

        topicRows.forEach(tRow => {
            const topicName = (tRow.dataset.topicName || '');
            const topicDesc = (tRow.dataset.topicDesc || '');
            const topicSelfMatch = topicName.includes(q) || topicDesc.includes(q);

            let matchedSubItemsCount = 0;
            let firstMatchingTab = null;

            // Search each sub-table row with data-search
            const subRows = tRow.querySelectorAll('tbody tr[data-search]');
            subRows.forEach(tr => {
                const searchData = (tr.dataset.search || tr.textContent || '').toLowerCase();
                const isMatch = searchData.includes(q);
                if (isMatch) {
                    tr.style.display = '';
                    matchedSubItemsCount++;
                    if (!firstMatchingTab) {
                        const tabContent = tr.closest('.tab-content');
                        if (tabContent && tabContent.id) {
                            const parts = tabContent.id.split('-');
                            if (parts.length >= 3) firstMatchingTab = parts[2];
                        }
                    }
                } else {
                    tr.style.display = topicSelfMatch ? '' : 'none';
                }
            });

            // Handle empty state row if topic has no items
            const emptyRows = tRow.querySelectorAll('tbody tr.empty-state-row, tbody tr td.empty-sub');
            emptyRows.forEach(er => {
                const tr = er.tagName === 'TR' ? er : er.closest('tr');
                if (tr) tr.style.display = topicSelfMatch ? '' : 'none';
            });

            if (topicSelfMatch || matchedSubItemsCount > 0) {
                tRow.style.display = '';
                quarterHasMatch = true;

                // Auto-expand quarter body
                const qBody = document.getElementById('quarter-body-' + qid);
                if (qBody) qBody.style.display = 'block';
                const chevron = document.getElementById('chevron-q-' + qid);
                if (chevron) chevron.classList.add('open');

                // If items matched inside sub-tabs, open the topic panel and switch to that tab
                if (matchedSubItemsCount > 0 && firstMatchingTab) {
                    const tid = tRow.id.replace('topic-row-', '');
                    const panel = document.getElementById('panel-' + tid);
                    if (panel && !panel.classList.contains('open')) {
                        panel.classList.add('open');
                    }
                    const tabBtn = panel ? panel.querySelector(`.panel-tab[onclick*="'${firstMatchingTab}'"]`) : null;
                    if (tabBtn && typeof switchTab === 'function') {
                        switchTab(tid, firstMatchingTab, tabBtn);
                    }
                }
            } else {
                tRow.style.display = 'none';
            }
        });

        // Hide quarter if no topics matched
        qb.style.display = quarterHasMatch ? '' : 'none';
        if (quarterHasMatch) totalQuarterMatches++;
    });

    if (totalQuarterMatches === 0) {
        if (quartersContainer) quartersContainer.classList.add('hidden');
        if (noResultsEl) {
            noResultsEl.classList.remove('hidden');
            if (queryDisplayEl) queryDisplayEl.textContent = query;
        }
    } else {
        if (quartersContainer) quartersContainer.classList.remove('hidden');
        if (noResultsEl) noResultsEl.classList.add('hidden');
    }
}

