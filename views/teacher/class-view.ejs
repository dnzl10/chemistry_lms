function confirmDelete(type, id, label) {
    const labels = {
        topic: 'topic',
        material: 'learning material',
        assessment: 'assessment',
        assignment: 'assignment',
        announcement: 'announcement',
        forum: 'forum thread'
    };
    document.getElementById('deleteModalMsg').textContent =
        'Delete ' + (labels[type] || type) + ' "' + label + '"?';

    const btn = document.getElementById('confirmDeleteBtn');
    btn.onclick = () => executeDelete(type, id);
    openModal('deleteModal');
}

async function executeDelete(type, id) {
    const urlMap = {
        topic: '/teacher/api/topic/',
        material: '/teacher/api/material/',
        assessment: '/teacher/api/assessment/',
        assignment: '/teacher/api/assignment/',
        announcement: '/teacher/api/announcement/',
        forum: '/teacher/api/forum/'
    };

    const delBtn = document.getElementById('confirmDeleteBtn');
    const origBtnHtml = delBtn ? delBtn.innerHTML : '';
    if (delBtn) {
        delBtn.disabled = true;
        delBtn.innerHTML = '<i class="fas fa-spinner fa-spin text-sm mr-1"></i> Deleting…';
    }

    const annRow = type === 'announcement' ? document.getElementById('ann-row-' + id) : null;
    if (annRow) {
        annRow.classList.add('opacity-40', 'transition-opacity');
    }

    try {
        const res = await fetch(urlMap[type] + id, { method: 'DELETE' });
        if (!res.ok) throw new Error();

        closeModal('deleteModal');

        if (type === 'announcement') {
            if (annRow) {
                annRow.style.transition = 'all 0.3s ease';
                annRow.style.opacity = '0';
                annRow.style.transform = 'translateX(20px)';
                setTimeout(() => {
                    annRow.remove();
                    if (window.announcementsCache) delete window.announcementsCache[id];
                    renumberAnnouncementRows();
                    checkAnnouncementEmptyState();
                }, 300);
            }
            cmToast('Announcement deleted successfully.', 'success');
        } else {
            const rowMap = {
                topic: 'topic-row-' + id,
                material: 'mat-row-' + id,
                assessment: 'asmt-row-' + id,
                assignment: 'asgn-row-' + id
            };
            const targetRow = rowMap[type] ? document.getElementById(rowMap[type]) : null;
            if (targetRow) {
                targetRow.style.transition = 'all 0.25s ease';
                targetRow.style.opacity = '0';
                targetRow.style.transform = 'translateX(16px)';
            }
            cmToast('Deleted successfully.', 'success');
            await refreshClassViewContent();
        }
    } catch(e) {
        closeModal('deleteModal');
        if (annRow) annRow.classList.remove('opacity-40');
        cmToast('Delete failed. Please try again.', 'error');
    } finally {
        if (delBtn) {
            delBtn.disabled = false;
            delBtn.innerHTML = origBtnHtml;
        }
    }
}




