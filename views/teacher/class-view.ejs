   ================================================================ */

const allAssessmentsList = [
<% if (typeof quarters !== 'undefined' && quarters) { %>
    <% quarters.forEach(function(q){ %>
        <% (q.topics || []).forEach(function(t){ %>
            <% (t.assessments || []).forEach(function(a){ %>
            {
                id: <%= a.assessment_id %>,
                name: <%- JSON.stringify(a.assessment_name) %>,
                type: <%- JSON.stringify(a.assessment_type || '') %>,
                quarter_id: <%= q.quarter_id %>,
                quarter_num: <%= q.quarter_number %>,
                topic_name: <%- JSON.stringify(t.topic_name) %>
            },
            <% }); %>
        <% }); %>
    <% }); %>
<% } %>
];

function updateAssessmentFilterOptions() {
    const qFilter   = document.getElementById('scoreFilterQuarter')?.value || '';
    const typeFilter= document.getElementById('scoreFilterType')?.value || '';
    const asmtSelect= document.getElementById('scoreFilterAssessment');
    if (!asmtSelect) return;

    const currentVal = asmtSelect.value;
    asmtSelect.innerHTML = '<option value="">All Assessments</option>';

    const seen = new Set();
    const filtered = (typeof allAssessmentsList !== 'undefined' ? allAssessmentsList : []).filter(a => {
        if (seen.has(a.id)) return false;
        seen.add(a.id);
        const matchQ = !qFilter || String(a.quarter_id) === String(qFilter);
        const matchT = !typeFilter || a.type === typeFilter;
        return matchQ && matchT;
    });

    let foundCurrent = false;
    filtered.forEach(a => {
        const opt = document.createElement('option');
        opt.value = a.id;
        opt.textContent = a.name;
        if (String(a.id) === String(currentVal)) {
            opt.selected = true;
            foundCurrent = true;
        }
        asmtSelect.appendChild(opt);
    });

    if (!foundCurrent && currentVal !== '') {
        asmtSelect.value = '';
    }
}

function onScoreQuarterOrTypeChange() {
    updateAssessmentFilterOptions();
    filterScoreTable();
}

/* ---- Score Table Pagination State ---- */
let currentScorePage = 1;
let scorePageSize = 10;

function changeScorePageSize(newSize) {
    scorePageSize = parseInt(newSize, 10) || 10;
    currentScorePage = 1;
    filterScoreTable(false);
}

function changeScorePage(delta) {
    currentScorePage += delta;
    filterScoreTable(false);
}

function goToScorePage(pageNum) {
    currentScorePage = pageNum;
    filterScoreTable(false);
}

function createScorePageBtn(pageNum) {
    const b = document.createElement('button');
    b.type = 'button';
    b.textContent = pageNum;
    const isActive = (pageNum === currentScorePage);
    b.className = 'w-7 h-7 rounded-lg text-xs font-bold transition flex items-center justify-center ' +
        (isActive
            ? 'bg-indigo-600 text-white shadow-sm'
            : 'border border-slate-200 bg-white text-slate-600 hover:bg-slate-50 hover:text-indigo-600 shadow-2xs');
    b.onclick = function() {
        goToScorePage(pageNum);
    };
    return b;
}

/* ---- Score Table Sorting ---- */
let currentScoreSort = { field: 'date', order: 'desc' };

function toggleScoreSortDropdown(e) {
    if (e) e.stopPropagation();
    const menu = document.getElementById('scoreSortMenu');
    if (!menu) return;
    menu.classList.toggle('hidden');
}

// Close score sort dropdown when clicking outside
document.addEventListener('click', function(e) {
    const wrap = document.getElementById('scoreSortDropdownWrap');
    const menu = document.getElementById('scoreSortMenu');
    if (wrap && menu && !wrap.contains(e.target)) {
        menu.classList.add('hidden');
    }
});

function sortScoreTable(field) {
    if (currentScoreSort.field === field) {
        currentScoreSort.order = currentScoreSort.order === 'asc' ? 'desc' : 'asc';
    } else {
        currentScoreSort.field = field;
        currentScoreSort.order = (field === 'name') ? 'asc' : 'desc';
    }

    // Update active checkmarks in menu
    ['name', 'score', 'date'].forEach(f => {
        const check = document.getElementById('scoreSortCheck-' + f);
        const opt = document.getElementById('scoreSortOpt-' + f);
        if (check) check.classList.toggle('hidden', f !== field);
        if (opt) {
            if (f === field) {
                opt.classList.add('bg-indigo-50/70', 'text-indigo-600');
            } else {
                opt.classList.remove('bg-indigo-50/70', 'text-indigo-600');
            }
        }
    });

    const tbody = document.getElementById('scoreTableBody');
    if (!tbody) return;

    const rows = Array.from(tbody.querySelectorAll('tr[data-student]'));
    const isAsc = currentScoreSort.order === 'asc';

    rows.sort((a, b) => {
        if (field === 'name') {
            const nameA = (a.dataset.lastName || '') + ' ' + (a.dataset.firstName || '');
            const nameB = (b.dataset.lastName || '') + ' ' + (b.dataset.firstName || '');
            return isAsc ? nameA.localeCompare(nameB) : nameB.localeCompare(nameA);
        } else if (field === 'score') {
            const scoreA = parseFloat(a.dataset.score) || 0;
            const scoreB = parseFloat(b.dataset.score) || 0;
            if (scoreA !== scoreB) {
                return isAsc ? scoreA - scoreB : scoreB - scoreA;
            }
            const pctA = parseFloat(a.dataset.pct) || 0;
            const pctB = parseFloat(b.dataset.pct) || 0;
            return isAsc ? pctA - pctB : pctB - pctA;
        } else if (field === 'date') {
            const dateA = parseInt(a.dataset.date, 10) || 0;
            const dateB = parseInt(b.dataset.date, 10) || 0;
            return isAsc ? dateA - dateB : dateB - dateA;
        }
        return 0;
    });

    // Re-append sorted rows maintaining empty row at bottom
    const emptyRow = document.getElementById('scoreNoDataRow');
    rows.forEach(r => tbody.appendChild(r));
    if (emptyRow) tbody.appendChild(emptyRow);

    // Close menu
    const menu = document.getElementById('scoreSortMenu');
    if (menu) menu.classList.add('hidden');

    filterScoreTable(false);
}

function clearScoreSearch() {
    const s = document.getElementById('scoreSearch');
    if (s) {
        s.value = '';
        filterScoreTable();
        s.focus();
    }
}

function resetScoreFilters() {
    const q = document.getElementById('scoreFilterQuarter');
    const t = document.getElementById('scoreFilterType');
    const a = document.getElementById('scoreFilterAssessment');
    const s = document.getElementById('scoreSearch');
    if (q) q.value = '';
    if (t) t.value = '';
    updateAssessmentFilterOptions();
    if (a) a.value = '';
    if (s) s.value = '';
    filterScoreTable();
}

function filterScoreTable(resetPage = true) {
    if (resetPage) {
        currentScorePage = 1;
    }
    const qFilter   = document.getElementById('scoreFilterQuarter')?.value || '';
    const typeFilter= document.getElementById('scoreFilterType')?.value || '';
    const asmtFilter= document.getElementById('scoreFilterAssessment')?.value || '';
    const query     = (document.getElementById('scoreSearch')?.value || '').toLowerCase().trim();
    const rows      = Array.from(document.querySelectorAll('#scoreTableBody tr[data-student]'));
    
    // Find all rows matching current filters
    const matchingRows = [];
    rows.forEach(row => {
        const matchQ    = !qFilter    || String(row.dataset.quarter) === String(qFilter);
        const matchType = !typeFilter || row.dataset.type === typeFilter;
        const matchAsmt = !asmtFilter || String(row.dataset.assessmentId) === String(asmtFilter);
        const matchName = !query      || row.dataset.student.includes(query);
        if (matchQ && matchType && matchAsmt && matchName) {
            matchingRows.push(row);
        } else {
            row.style.display = 'none';
        }
    });

    const totalMatching = matchingRows.length;
    const totalPages = Math.ceil(totalMatching / scorePageSize) || 1;

    // Bounds checking
    if (currentScorePage > totalPages) currentScorePage = totalPages;
    if (currentScorePage < 1) currentScorePage = 1;

    const startIndex = (currentScorePage - 1) * scorePageSize;
    const endIndex = Math.min(startIndex + scorePageSize, totalMatching);

    // Display only matching rows belonging to the current page
    matchingRows.forEach((row, idx) => {
        if (idx >= startIndex && idx < endIndex) {
            row.style.display = '';
        } else {
            row.style.display = 'none';
        }
    });

    const emptyRow      = document.getElementById('scoreNoDataRow');
    const emptyIcon     = document.getElementById('scoreEmptyIcon');
    const emptyTitle    = document.getElementById('scoreEmptyTitle');
    const emptyDesc     = document.getElementById('scoreEmptyDesc');
    const emptyResetBtn = document.getElementById('scoreEmptyResetBtn');

    if (emptyRow) {
        if (totalMatching === 0) {
            emptyRow.classList.remove('hidden');
            emptyRow.style.display = '';

            if (query) {
                // Empty state when search box has no matching results
                if (emptyIcon) emptyIcon.innerHTML = '<i class="fas fa-magnifying-glass"></i>';
                if (emptyTitle) emptyTitle.textContent = 'No matching students found';
                const safeQuery = query.replace(/[&<>"']/g, s => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' }[s]));
                if (emptyDesc) emptyDesc.innerHTML = 'No student records match "<strong>' + safeQuery + '</strong>". Check your spelling or clear the search.';
                if (emptyResetBtn) {
                    emptyResetBtn.classList.remove('hidden');
                    emptyResetBtn.innerHTML = '<i class="fas fa-times text-xs"></i> Clear Search';
                    emptyResetBtn.onclick = clearScoreSearch;
                }
            } else if (qFilter || typeFilter || asmtFilter) {
                // Empty state when dropdown filter combination yields no results
                if (emptyIcon) emptyIcon.innerHTML = '<i class="fas fa-filter"></i>';
                if (emptyTitle) emptyTitle.textContent = 'No scores match the selected filters';
                if (emptyDesc) emptyDesc.textContent = 'No score records found for the selected quarter, type, or assessment. Try adjusting your filter selections.';
                if (emptyResetBtn) {
                    emptyResetBtn.classList.remove('hidden');
                    emptyResetBtn.innerHTML = '<i class="fas fa-arrow-rotate-left text-xs"></i> Reset Filters';
                    emptyResetBtn.onclick = resetScoreFilters;
                }
            } else {
                // Overall empty state (no data in table at all)
                if (emptyIcon) emptyIcon.innerHTML = '<i class="fas fa-chart-line"></i>';
                if (emptyTitle) emptyTitle.textContent = 'No score records yet';
                if (emptyDesc) emptyDesc.textContent = 'No assessment submissions or scores recorded for this class yet.';
                if (emptyResetBtn) emptyResetBtn.classList.add('hidden');
            }
        } else {
            emptyRow.classList.add('hidden');
            emptyRow.style.display = 'none';
        }
    }

    // Update summary count label
    const countEl = document.getElementById('scoreCount');
    if (countEl) {
        if (rows.length === 0) {
            countEl.innerHTML = 'No score records';
        } else if (totalMatching === 0) {
            countEl.innerHTML = 'Showing <strong>0</strong> records';
        } else if (totalMatching === rows.length) {
            countEl.innerHTML = 'Showing <strong>' + (startIndex + 1) + '–' + endIndex + '</strong> of <strong>' + totalMatching + '</strong> records';
        } else {
            countEl.innerHTML = 'Showing <strong>' + (startIndex + 1) + '–' + endIndex + '</strong> of <strong>' + totalMatching + '</strong> filtered records (total ' + rows.length + ')';
        }
    }

    // Update Prev / Next buttons
    const btnPrev = document.getElementById('btnPrevScorePage');
    const btnNext = document.getElementById('btnNextScorePage');
    if (btnPrev) btnPrev.disabled = (currentScorePage <= 1);
    if (btnNext) btnNext.disabled = (currentScorePage >= totalPages || totalMatching === 0);

    // Render page buttons
    const numContainer = document.getElementById('scorePageNumbers');
    if (numContainer) {
        numContainer.innerHTML = '';
        if (totalMatching > 0) {
            const maxButtons = 5;
            let startPage = Math.max(1, currentScorePage - 2);
            let endPage = Math.min(totalPages, startPage + maxButtons - 1);
            if (endPage - startPage + 1 < maxButtons) {
                startPage = Math.max(1, endPage - maxButtons + 1);
            }

            if (startPage > 1) {
                numContainer.appendChild(createScorePageBtn(1));
                if (startPage > 2) {
                    const dots = document.createElement('span');
                    dots.className = 'px-1 text-slate-400 text-xs font-bold';
                    dots.textContent = '…';
                    numContainer.appendChild(dots);
                }
            }

            for (let p = startPage; p <= endPage; p++) {
                numContainer.appendChild(createScorePageBtn(p));
            }

            if (endPage < totalPages) {
                if (endPage < totalPages - 1) {
                    const dots2 = document.createElement('span');
                    dots2.className = 'px-1 text-slate-400 text-xs font-bold';
                    dots2.textContent = '…';
                    numContainer.appendChild(dots2);
                }
                numContainer.appendChild(createScorePageBtn(totalPages));
            }
        }
    }

    // Toggle pagination navigation visibility when not needed
    const navWrap = document.getElementById('scorePaginationNav');
    if (navWrap) {
        navWrap.style.display = (totalMatching <= scorePageSize && totalPages <= 1) ? 'none' : 'flex';
    }
}

// Initial assessment options population & initial score table pagination
if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', function() {
        updateAssessmentFilterOptions();
        filterScoreTable(false);
    });
} else {
    updateAssessmentFilterOptions();
    filterScoreTable(false);
}

/* ================================================================
   STUDENT ASSESSMENT DIAGNOSTIC & RESULT MODAL
   ================================================================ */
let currentDiagQuestions = [];
let currentDiagFilter = 'all';

async function openAssessmentDiagnosticModal(scoreId, studentId, assessmentId, classId) {
    if (!scoreId) return;
    openModal('assessmentDiagnosticModal');

    const loadingState = document.getElementById('diagLoadingState');
    const errorState   = document.getElementById('diagErrorState');
    const contentArea  = document.getElementById('diagContentArea');
    const retryBtn     = document.getElementById('diagRetryBtn');

    if (loadingState) loadingState.classList.remove('hidden');
    if (errorState)   errorState.classList.add('hidden');
    if (contentArea)  contentArea.classList.add('hidden');

    try {
        const queryParams = new URLSearchParams();
        if (studentId) queryParams.set('studentId', studentId);
        if (assessmentId) queryParams.set('assessmentId', assessmentId);
        if (classId) queryParams.set('classId', classId);

        const url = '/teacher/api/assessment-diagnostic/' + encodeURIComponent(scoreId) + '?' + queryParams.toString();
        const res = await fetch(url, {
            headers: {
                'Accept': 'application/json'
            }
        });

        if (res.redirected && res.url && res.url.includes('/login')) {
            window.location.href = '/login?error=' + encodeURIComponent('Your session has expired. Please log in again.');
            return;
        }

        if (res.status === 401) {
            window.location.href = '/login?error=' + encodeURIComponent('Your session has expired. Please log in again.');
            return;
        }

        const contentType = res.headers.get('content-type') || '';
        if (!contentType.includes('application/json')) {
            throw new Error('Server returned an unexpected format. Please refresh the page or log in again.');
        }

        if (!res.ok) {
            const errData = await res.json().catch(function() { return {}; });
            throw new Error(errData.error || ('Server responded with status ' + res.status));
        }
        const data = await res.json();
        if (!data.success) {
            throw new Error(data.error || 'Failed to retrieve assessment diagnostic data.');
        }

        renderAssessmentDiagnostic(data);

        if (loadingState) loadingState.classList.add('hidden');
        if (contentArea)  contentArea.classList.remove('hidden');
    } catch (err) {
        console.error('Failed to load assessment diagnostic:', err);
        if (loadingState) loadingState.classList.add('hidden');
        if (errorState)   errorState.classList.remove('hidden');
        const msgEl = document.getElementById('diagErrorMessage');
        const detailsEl = document.getElementById('diagErrorDetails');
        if (msgEl) msgEl.textContent = err.message || 'Unable to retrieve diagnostic record';

        const isAuthError = err.message && (
            err.message.toLowerCase().includes('session') ||
            err.message.toLowerCase().includes('log in') ||
            err.message.toLowerCase().includes('unauthenticated') ||
            err.message.toLowerCase().includes('unauthorized')
        );

        if (isAuthError) {
            if (detailsEl) detailsEl.textContent = 'Your session may have expired. Please log in again.';
            if (retryBtn) {
                retryBtn.innerHTML = '<i class="fas fa-sign-in-alt mr-1.5"></i> Log In';
                retryBtn.onclick = function() {
                    window.location.href = '/login?error=' + encodeURIComponent('Please log in to view diagnostic telemetry.');
                };
            }
        } else {
            if (detailsEl) detailsEl.textContent = 'Please verify the record exists and try again.';
            if (retryBtn) {
                retryBtn.innerHTML = '<i class="fas fa-rotate-right mr-1.5"></i> Try Again';
                retryBtn.onclick = function() {
                    openAssessmentDiagnosticModal(scoreId, studentId, assessmentId, classId);
                };
            }
        }
    }
}

function renderAssessmentDiagnostic(data) {
    if (!data) return;

    // Defensively extract student information
    const student = data.student || (data.attempt ? {
        id: data.attempt.user_id,
        name: ((data.attempt.last_name || '') + ', ' + (data.attempt.first_name || '')).trim() || 'Student',
        profile_pic: data.attempt.profile_pic
    } : {});

    // Defensively extract assessment information
    const assessment = data.assessment || (data.attempt ? {
        title: data.attempt.assessment_name || 'Assessment',
        assessment_type: data.attempt.assessment_type || 'Assessment',
        date_recorded: data.attempt.started_at || data.attempt.ended_at
    } : {});

    // Defensively extract questions and metrics
    const questions = Array.isArray(data.questions) ? data.questions : [];
    const attemptScore = data.attempt ? Number(data.attempt.score_obtained || 0) : 0;
    const attemptTotal = data.attempt ? Number(data.attempt.total_items || questions.length || 0) : questions.length;

    const metrics = data.metrics || {
        score: attemptScore,
        total: attemptTotal,
        percentage: attemptTotal > 0 ? Math.round((attemptScore / attemptTotal) * 100) : 0,
        exp_gained: (data.attempt && data.attempt.exp_gained) || (attemptScore * 10),
        cohort: data.cohort || {}
    };

    const cohort = metrics.cohort || data.cohort || {};
    const diag = data.diagnostics || data.analytics || {};

    // Normalize recommendations: ensure recList is ALWAYS an Array
    let recList = [];
    if (Array.isArray(data.recommendations)) {
        recList = data.recommendations;
    } else if (data.recommendations && typeof data.recommendations === 'object') {
        const mats = Array.isArray(data.recommendations.materials) ? data.recommendations.materials : [];
        const rems = Array.isArray(data.recommendations.remediations) ? data.recommendations.remediations : [];
        if (mats.length > 0 || rems.length > 0) {
            recList = [{
                topic_name: (data.attempt && data.attempt.topic_name) || 'Curriculum Remediation',
                materials: mats,
                remediations: rems
            }];
        }
    } else if (data.recommendationsBundle && typeof data.recommendationsBundle === 'object') {
        const mats = Array.isArray(data.recommendationsBundle.materials) ? data.recommendationsBundle.materials : [];
        const rems = Array.isArray(data.recommendationsBundle.remediations) ? data.recommendationsBundle.remediations : [];
        if (mats.length > 0 || rems.length > 0) {
            recList = [{
                topic_name: (data.attempt && data.attempt.topic_name) || 'Curriculum Remediation',
                materials: mats,
                remediations: rems
            }];
        }
    }

    // 1. Header Information
    const avatarEl = document.getElementById('diagStudentAvatar');
    if (avatarEl) {
        avatarEl.src = student.profile_pic ? ('/profile_uploads/' + student.profile_pic) : '/profile_uploads/default_avatar.png';
    }
    const nameEl = document.getElementById('diagStudentName');
    if (nameEl) nameEl.textContent = student.name || 'Student';

    const asmtBadgeEl = document.getElementById('diagAssessmentTypeBadge');
    if (asmtBadgeEl) {
        asmtBadgeEl.textContent = assessment.assessment_type || 'Assessment';
        const typeCls = assessment.assessment_type === 'Pre-Test' ? 'bg-sky-50 text-sky-700 border-sky-200'
            : assessment.assessment_type === 'Post-Test' ? 'bg-indigo-50 text-indigo-700 border-indigo-200'
            : assessment.assessment_type === 'Quiz' ? 'bg-amber-50 text-amber-700 border-amber-200'
            : 'bg-emerald-50 text-emerald-700 border-emerald-200';
        asmtBadgeEl.className = 'px-2 py-0.5 rounded-full text-[11px] font-black uppercase tracking-wider border ' + typeCls;
    }

    const titleEl = document.getElementById('diagAssessmentTitle');
    if (titleEl) titleEl.textContent = assessment.title || 'Assessment';

    const dateEl = document.getElementById('diagAssessmentDate');
    if (dateEl) {
        const dStr = assessment.date_recorded
            ? new Date(assessment.date_recorded).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric', hour: '2-digit', minute: '2-digit' })
            : '—';
        dateEl.textContent = 'Recorded: ' + dStr;
    }

    // 2. Metrics Cards
    const scoreVal = metrics.score != null ? metrics.score : 0;
    const totalVal = metrics.total != null ? metrics.total : 0;
    const pct = metrics.percentage != null ? metrics.percentage : (totalVal > 0 ? Math.round((scoreVal / totalVal) * 100) : 0);

    const scoreObtainedEl = document.getElementById('diagScoreObtained');
    if (scoreObtainedEl) scoreObtainedEl.textContent = scoreVal + '/' + totalVal;

    const scorePctEl = document.getElementById('diagScorePct');
    if (scorePctEl) {
        scorePctEl.textContent = pct + '%';
        scorePctEl.className = 'text-xs font-bold ' + (pct >= 75 ? 'text-emerald-600' : pct >= 50 ? 'text-sky-600' : pct >= 35 ? 'text-amber-600' : 'text-rose-600');
    }

    const scoreBarEl = document.getElementById('diagScoreBar');
    if (scoreBarEl) {
        scoreBarEl.style.width = Math.min(100, Math.max(0, pct)) + '%';
        scoreBarEl.className = 'h-full rounded-full transition-all duration-500 ' + (pct >= 75 ? 'bg-emerald-500' : pct >= 50 ? 'bg-sky-500' : pct >= 35 ? 'bg-amber-500' : 'bg-rose-500');
    }

    const expEl = document.getElementById('diagExpBadge');
    if (expEl) {
        expEl.innerHTML = '<i class="fas fa-star text-[9px]"></i> +' + (metrics.exp_gained || 0) + ' EXP';
    }

    // Cohort Ranking & Surpassed metric
    const rankEl = document.getElementById('diagPercentileRank');
    const isSingle = cohort.isSingleParticipant || (cohort.totalStudents != null && cohort.totalStudents <= 1);
    if (rankEl) {
        if (isSingle) {
            rankEl.textContent = 'Solo Baseline';
        } else {
            const p = cohort.percentile != null ? cohort.percentile : 50;
            rankEl.textContent = p + 'th Percentile';
        }
    }

    const surpassedEl = document.getElementById('diagSurpassedText');
    if (surpassedEl) {
        if (isSingle) {
            surpassedEl.innerHTML = '<span class="text-slate-400">Baseline record (no peer attempts yet)</span>';
        } else {
            const surpassed = cohort.surpassedCount || 0;
            const totalClassmates = Math.max(0, (cohort.totalStudents || 1) - 1);
            surpassedEl.innerHTML = 'Surpassed <strong class="text-indigo-700 font-bold">' + surpassed + '</strong> of ' + totalClassmates + ' peer' + (totalClassmates === 1 ? '' : 's');
        }
    }

    // Class average benchmark
    const classAvgScoreEl = document.getElementById('diagClassAvgScore');
    if (classAvgScoreEl) {
        classAvgScoreEl.textContent = (cohort.classAvgScore != null ? cohort.classAvgScore : scoreVal) + ' / ' + totalVal;
    }
    const classAvgPctEl = document.getElementById('diagClassAvgPct');
    if (classAvgPctEl) {
        if (isSingle) {
            classAvgPctEl.innerHTML = '<span class="text-slate-500 font-medium">' + pct + '% (Individual baseline)</span>';
        } else {
            const cPct = cohort.classAvgPercentage != null ? cohort.classAvgPercentage : 0;
            const diff = pct - cPct;
            const sign = diff > 0 ? ('+' + diff + '%') : (diff + '%');
            classAvgPctEl.innerHTML = cPct + '% benchmark <span class="ml-1 text-[10px] font-black ' + (diff >= 0 ? 'text-emerald-600' : 'text-rose-600') + '">(' + sign + ')</span>';
        }
    }

    // Diagnostic Status & Knowledge gaps
    const gapCount = (diag.knowledgeGaps || []).length;
    const masteryEl = document.getElementById('diagMasteryLevel');
    const statusIcon = document.getElementById('diagStatusIcon');
    const gapCountEl = document.getElementById('diagGapCountText');

    if (masteryEl) {
        if (pct >= 85 && gapCount === 0) {
            masteryEl.textContent = 'Demonstrated Mastery';
        } else if (pct >= 75) {
            masteryEl.textContent = gapCount === 0 ? 'Proficient' : 'Proficient (Minor Gaps)';
        } else if (pct >= 50) {
            masteryEl.textContent = 'Developing Competency';
        } else if (gapCount === 0) {
            masteryEl.textContent = 'Developing Competency';
        } else {
            masteryEl.textContent = 'Intervention Required';
        }
    }
    if (statusIcon) {
        const statusColor = (pct >= 75 && gapCount === 0) ? 'bg-emerald-500'
            : (pct >= 75 && gapCount > 0) ? 'bg-emerald-400'
            : (pct >= 50 || gapCount === 0) ? 'bg-sky-500'
            : 'bg-rose-500';
        statusIcon.className = 'w-2.5 h-2.5 rounded-full ' + statusColor;
    }
    if (gapCountEl) {
        if (gapCount === 0) {
            gapCountEl.textContent = pct >= 75 ? 'No critical knowledge gaps' : 'General review recommended';
        } else {
            gapCountEl.textContent = gapCount + ' topic gap' + (gapCount === 1 ? '' : 's') + ' flagged';
        }
    }

    // Cohort distribution ribbon
    const cohortProg = document.getElementById('diagCohortProgress');
    if (cohortProg) {
        const progWidth = isSingle ? Math.min(100, Math.max(6, pct)) : Math.min(100, Math.max(6, cohort.percentile || 50));
        cohortProg.style.width = progWidth + '%';
    }
    const cohortBadge = document.getElementById('diagCohortBadge');
    if (cohortBadge) {
        if (isSingle) {
            cohortBadge.textContent = 'Solo Baseline';
        } else {
            const p = cohort.percentile || 50;
            cohortBadge.textContent = p >= 75 ? 'Top Quartile' : p >= 50 ? 'Above Average' : 'Needs Reinforcement';
        }
    }
    const cohortAvgLabel = document.getElementById('diagCohortClassAvgLabel');
    if (cohortAvgLabel) {
        cohortAvgLabel.textContent = isSingle ? ('Score Accuracy: ' + pct + '%') : ('Class Avg: ' + (cohort.classAvgPercentage || 0) + '%');
    }
    const cohortTopScore = document.getElementById('diagCohortTopScore');
    if (cohortTopScore) {
        cohortTopScore.textContent = (cohort.topScore != null ? cohort.topScore : totalVal) + ' pts';
    }

    // 3. Analytical Breakdown: Knowledge Gaps vs Strengths
    const gapsListEl = document.getElementById('diagGapsList');
    const gapsBadgeEl = document.getElementById('diagGapBadgeCount');
    const gaps = diag.knowledgeGaps || [];
    if (gapsBadgeEl) gapsBadgeEl.textContent = gaps.length + ' Gap' + (gaps.length === 1 ? '' : 's');

    if (gapsListEl) {
        if (gaps.length === 0) {
            gapsListEl.innerHTML =
                '<div class="p-4 bg-emerald-50/60 rounded-xl border border-emerald-100 text-center">' +
                    '<i class="fas fa-circle-check text-emerald-500 text-base mb-1"></i>' +
                    '<p class="text-xs font-bold text-emerald-800">No Critical Knowledge Gaps Identified</p>' +
                    '<p class="text-[10px] text-emerald-600 mt-0.5">The student consistently answered correctly across all curriculum topics.</p>' +
                '</div>';
        } else {
            gapsListEl.innerHTML = gaps.map(function(g) {
                const title = g.topic_name || g.name || g.title || 'Curriculum Concept';
                const total = g.total != null ? g.total : (g.ratio ? parseInt(g.ratio.split('/')[1], 10) : 0);
                const correct = g.correct != null ? g.correct : (g.ratio ? parseInt(g.ratio.split('/')[0], 10) : 0);
                const wrong = g.wrong != null ? g.wrong : Math.max(0, total - correct);
                const acc = g.accuracy != null ? Math.round(g.accuracy) : (g.pct != null ? Math.round(g.pct) : (total > 0 ? Math.round((correct / total) * 100) : 0));

                return '' +
                '<div class="p-3 bg-rose-50/50 rounded-xl border border-rose-100 flex flex-col gap-1.5">' +
                    '<div class="flex items-center justify-between">' +
                        '<span class="text-xs font-bold text-slate-800 truncate">' + escHtml(title) + '</span>' +
                        '<span class="text-[10px] font-black px-2 py-0.5 rounded-full bg-rose-100 text-rose-700">Needs Instruction (' + acc + '%)</span>' +
                    '</div>' +
                    '<div class="flex items-center gap-2">' +
                        '<div class="w-full h-1.5 bg-rose-200/50 rounded-full overflow-hidden flex-1">' +
                            '<div class="h-full bg-rose-500 rounded-full" style="width:' + acc + '%"></div>' +
                        '</div>' +
                        '<span class="text-[11px] font-bold text-rose-700 flex-shrink-0">' + correct + '/' + total + ' correct</span>' +
                    '</div>' +
                    '<div class="text-[10px] text-rose-600 flex items-center gap-1 font-medium">' +
                        '<i class="fas fa-triangle-exclamation text-[9px]"></i> Missed ' + wrong + ' question' + (wrong === 1 ? '' : 's') + ' on this concept' +
                    '</div>' +
                '</div>';
            }).join('');
        }
    }

    const strengthsListEl = document.getElementById('diagStrengthsList');
    const strengthsBadgeEl = document.getElementById('diagStrengthBadgeCount');
    const strengths = diag.strengths || [];
    if (strengthsBadgeEl) strengthsBadgeEl.textContent = strengths.length + ' Strength' + (strengths.length === 1 ? '' : 's');

    if (strengthsListEl) {
        if (strengths.length === 0) {
            strengthsListEl.innerHTML =
                '<div class="p-4 bg-slate-50 rounded-xl border border-slate-200 text-center">' +
                    '<i class="fas fa-info-circle text-slate-400 text-base mb-1"></i>' +
                    '<p class="text-xs font-bold text-slate-700">No Topic Met the 75% Mastery Standard</p>' +
                    '<p class="text-[10px] text-slate-400 mt-0.5">Focus instructional remediation on fundamental topic areas.</p>' +
                '</div>';
        } else {
            strengthsListEl.innerHTML = strengths.map(function(s) {
                const title = s.topic_name || s.name || s.title || 'Curriculum Concept';
                const total = s.total != null ? s.total : (s.ratio ? parseInt(s.ratio.split('/')[1], 10) : 0);
                const correct = s.correct != null ? s.correct : (s.ratio ? parseInt(s.ratio.split('/')[0], 10) : 0);
                const acc = s.accuracy != null ? Math.round(s.accuracy) : (s.pct != null ? Math.round(s.pct) : (total > 0 ? Math.round((correct / total) * 100) : 0));

                return '' +
                '<div class="p-3 bg-emerald-50/50 rounded-xl border border-emerald-100 flex flex-col gap-1.5">' +
                    '<div class="flex items-center justify-between">' +
                        '<span class="text-xs font-bold text-slate-800 truncate">' + escHtml(title) + '</span>' +
                        '<span class="text-[10px] font-black px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800">Mastered (' + acc + '%)</span>' +
                    '</div>' +
                    '<div class="flex items-center gap-2">' +
                        '<div class="w-full h-1.5 bg-emerald-200/50 rounded-full overflow-hidden flex-1">' +
                            '<div class="h-full bg-emerald-500 rounded-full" style="width:' + acc + '%"></div>' +
                        '</div>' +
                        '<span class="text-[11px] font-bold text-emerald-700 flex-shrink-0">' + correct + '/' + total + ' correct</span>' +
                    '</div>' +
                    '<div class="text-[10px] text-emerald-700 flex items-center gap-1 font-medium">' +
                        '<i class="fas fa-check-circle text-[9px]"></i> Consistently succeeds on this curriculum area' +
                    '</div>' +
                '</div>';
            }).join('');
        }
    }

    // Question types breakdown strip
    const qTypesListEl = document.getElementById('diagQuestionTypesList');
    if (qTypesListEl) {
        const qTypes = diag.questionTypes || [];
        if (qTypes.length === 0) {
            qTypesListEl.innerHTML = '<span class="text-xs text-slate-400 col-span-full">Format telemetry not recorded.</span>';
        } else {
            qTypesListEl.innerHTML = qTypes.map(function(qt) {
                const typeName = qt.type || qt.name || qt.title || 'Standard';
                const total = qt.total != null ? qt.total : (qt.ratio ? parseInt(qt.ratio.split('/')[1], 10) : 0);
                const correct = qt.correct != null ? qt.correct : (qt.ratio ? parseInt(qt.ratio.split('/')[0], 10) : 0);
                const acc = qt.accuracy != null ? Math.round(qt.accuracy) : (qt.pct != null ? Math.round(qt.pct) : (total > 0 ? Math.round((correct / total) * 100) : 0));
                const isGood = acc >= 75;
                return '' +
                '<div class="p-2.5 rounded-xl border ' + (isGood ? 'bg-emerald-50/30 border-emerald-100' : 'bg-amber-50/30 border-amber-100') + ' flex flex-col justify-between">' +
                    '<div class="flex items-center justify-between gap-1 mb-1">' +
                        '<span class="text-[11px] font-bold text-slate-700 truncate">' + escHtml(typeName) + '</span>' +
                        '<span class="text-[10px] font-black ' + (isGood ? 'text-emerald-700' : 'text-amber-700') + '">' + acc + '%</span>' +
                    '</div>' +
                    '<span class="text-[10px] text-slate-400 font-medium">' + correct + '/' + total + ' answered correctly</span>' +
                '</div>';
            }).join('');
        }
    }

    // 4. Curriculum Topic Learning Materials & Remediation
    const materialsListEl = document.getElementById('diagMaterialsList');
    if (materialsListEl) {
        let hasMaterialsOrAdvice = false;
        let materialsHtml = '';

        if (Array.isArray(recList)) {
            recList.forEach(function(rec) {
                if (!rec) return;
                const mats = Array.isArray(rec.materials) ? rec.materials : [];
                const rems = Array.isArray(rec.remediations) ? rec.remediations : [];

            mats.forEach(function(m) {
                hasMaterialsOrAdvice = true;
                const isPdf = (m.material_type || '').toLowerCase().includes('pdf') || (m.file_path_or_url || '').toLowerCase().endsWith('.pdf');
                const isVideo = (m.material_type || '').toLowerCase().includes('video') || (m.material_type || '').toLowerCase().includes('mp4');
                const isDoc = (m.material_type || '').toLowerCase().includes('doc') || (m.material_type || '').toLowerCase().includes('ppt');
                const iconCls = isPdf ? 'fa-file-pdf text-rose-500' : isVideo ? 'fa-play-circle text-sky-500' : isDoc ? 'fa-file-word text-blue-500' : 'fa-file-alt text-indigo-500';

                const targetUrl = m.file_path_or_url
                    ? ((m.file_path_or_url.startsWith('http') || m.file_path_or_url.startsWith('/')) ? m.file_path_or_url : ('/' + m.file_path_or_url))
                    : '';

                materialsHtml += '' +
                '<div class="p-3 bg-white rounded-xl border border-slate-200/90 shadow-2xs hover:border-indigo-300 transition flex items-start gap-3">' +
                    '<div class="w-9 h-9 rounded-xl bg-slate-50 border border-slate-100 flex items-center justify-center text-lg flex-shrink-0">' +
                        '<i class="fas ' + iconCls + '"></i>' +
                    '</div>' +
                    '<div class="flex-1 min-w-0">' +
                        '<div class="flex items-center gap-1.5 flex-wrap">' +
                            '<span class="text-[10px] font-black px-1.5 py-0.5 rounded bg-indigo-50 text-indigo-700 border border-indigo-100 truncate">' + escHtml(rec.topic_name) + '</span>' +
                            '<span class="text-[9px] font-bold uppercase tracking-wider text-slate-400">' + escHtml(m.material_type || 'Material') + '</span>' +
                        '</div>' +
                        '<h5 class="text-xs font-bold text-slate-800 truncate mt-1">' + escHtml(m.title) + '</h5>' +
                        '<div class="mt-2 flex items-center gap-2">' +
                            (targetUrl ? ('<a href="' + targetUrl + '" target="_blank" class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white text-[11px] font-bold transition"><i class="fas fa-external-link-alt text-[9px]"></i> Open Material</a>') : '') +
                        '</div>' +
                    '</div>' +
                '</div>';
            });

            rems.forEach(function(rem) {
                if (rem.advice_text) {
                    hasMaterialsOrAdvice = true;
                    materialsHtml += '' +
                    '<div class="p-3 bg-amber-50/60 rounded-xl border border-amber-200/80 shadow-2xs flex items-start gap-3">' +
                        '<div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center text-sm flex-shrink-0">' +
                            '<i class="fas fa-lightbulb"></i>' +
                        '</div>' +
                        '<div class="flex-1 min-w-0">' +
                            '<span class="text-[10px] font-black px-1.5 py-0.5 rounded bg-amber-100 text-amber-800 border border-amber-200 truncate">' + escHtml(rec.topic_name) + ' Remediation Tip</span>' +
                            '<p class="text-xs text-slate-700 mt-1 leading-relaxed">' + escHtml(rem.advice_text) + '</p>' +
                            (rem.link_url ? ('<a href="' + rem.link_url + '" target="_blank" class="inline-flex items-center gap-1 mt-2 text-[11px] font-bold text-indigo-600 hover:underline"><i class="fas fa-link text-[9px]"></i> Supporting Link</a>') : '') +
                        '</div>' +
                    '</div>';
                }
            });
        });
        }

        if (!hasMaterialsOrAdvice) {
            materialsListEl.innerHTML = '' +
                '<div class="col-span-full p-4 bg-slate-50 rounded-xl border border-slate-200 text-center">' +
                    '<i class="fas fa-folder-open text-slate-300 text-lg mb-1.5"></i>' +
                    '<p class="text-xs font-bold text-slate-600">No Learning Materials Attached</p>' +
                    '<p class="text-[10px] text-slate-400 mt-0.5">Upload remedial worksheets, slide decks, or videos under Content Management > Materials to map them to student gaps.</p>' +
                '</div>';
        } else {
            materialsListEl.innerHTML = materialsHtml;
        }
    }

    // 5. Question Responses List
    currentDiagQuestions = questions;
    const correctCount = questions.filter(function(q) { return q.is_correct; }).length;
    const incorrectCount = questions.length - correctCount;

    const countAllEl = document.getElementById('diagCountAll');
    const countCorrectEl = document.getElementById('diagCountCorrect');
    const countIncorrectEl = document.getElementById('diagCountIncorrect');

    if (countAllEl) countAllEl.textContent = questions.length;
    if (countCorrectEl) countCorrectEl.textContent = correctCount;
    if (countIncorrectEl) countIncorrectEl.textContent = incorrectCount;

    filterDiagQuestions('all');
}

function filterDiagQuestions(filterType) {
    currentDiagFilter = filterType;

    // Update filter tab buttons
    const btnAll = document.getElementById('diagFilterAll');
    const btnCorrect = document.getElementById('diagFilterCorrect');
    const btnIncorrect = document.getElementById('diagFilterIncorrect');

    [btnAll, btnCorrect, btnIncorrect].forEach(function(b) {
        if (!b) return;
        b.className = 'px-2.5 py-1 rounded-lg transition text-slate-600 hover:text-indigo-700';
    });

    if (filterType === 'all' && btnAll) {
        btnAll.className = 'px-2.5 py-1 rounded-lg transition bg-white text-indigo-600 shadow-2xs font-bold';
    } else if (filterType === 'correct' && btnCorrect) {
        btnCorrect.className = 'px-2.5 py-1 rounded-lg transition bg-emerald-600 text-white shadow-2xs font-bold';
    } else if (filterType === 'incorrect' && btnIncorrect) {
        btnIncorrect.className = 'px-2.5 py-1 rounded-lg transition bg-rose-600 text-white shadow-2xs font-bold';
    }

    const container = document.getElementById('diagQuestionsContainer');
    if (!container) return;

    let filtered = currentDiagQuestions;
    if (filterType === 'correct') {
        filtered = currentDiagQuestions.filter(function(q) { return q.is_correct; });
    } else if (filterType === 'incorrect') {
        filtered = currentDiagQuestions.filter(function(q) { return !q.is_correct; });
    }

    if (filtered.length === 0) {
        container.innerHTML = '' +
            '<div class="p-6 bg-slate-50 rounded-xl border border-slate-200 text-center">' +
                '<i class="fas fa-filter text-slate-300 text-lg mb-1"></i>' +
                '<p class="text-xs font-bold text-slate-600">No questions match the "' + filterType + '" filter</p>' +
            '</div>';
        return;
    }

    container.innerHTML = filtered.map(function(q, idx) {
        const isCorrect = q.is_correct;
        const diffColor = q.difficulty === 'Easy' ? 'bg-emerald-50 text-emerald-700 border-emerald-200'
            : q.difficulty === 'Difficult' ? 'bg-rose-50 text-rose-700 border-rose-200'
            : 'bg-amber-50 text-amber-700 border-amber-200';
        const timeSpent = q.response_time_s != null && q.response_time_s > 0 ? (q.response_time_s + 's') : '—';

        return '' +
        '<div class="p-4 rounded-2xl border transition ' + (isCorrect ? 'bg-white border-slate-200/90 hover:border-emerald-300' : 'bg-rose-50/20 border-rose-200/90 hover:border-rose-300') + ' shadow-2xs">' +
            '<div class="flex items-center justify-between gap-2 mb-2 flex-wrap">' +
                '<div class="flex items-center gap-2 flex-wrap">' +
                    '<span class="text-xs font-black text-slate-800">Q' + (idx + 1) + '</span>' +
                    '<span class="px-2 py-0.5 rounded-full text-[10px] font-black border ' + (isCorrect ? 'bg-emerald-100 text-emerald-800 border-emerald-200' : 'bg-rose-100 text-rose-800 border-rose-200') + '">' +
                        '<i class="fas ' + (isCorrect ? 'fa-check' : 'fa-times') + ' mr-1"></i>' + (isCorrect ? 'Correct' : 'Incorrect') +
                    '</span>' +
                    '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600 border border-slate-200">' +
                        escHtml(q.topic_name || 'Curriculum Concept') +
                    '</span>' +
                    '<span class="px-2 py-0.5 rounded-full text-[10px] font-bold border ' + diffColor + '">' +
                        escHtml(q.difficulty || 'Standard') +
                    '</span>' +
                '</div>' +
                '<div class="text-[11px] font-medium text-slate-400 flex items-center gap-1">' +
                    '<i class="far fa-clock text-[10px]"></i> ' + timeSpent +
                '</div>' +
            '</div>' +

            '<!-- Question Text -->' +
            '<p class="text-xs sm:text-sm font-semibold text-slate-800 leading-snug mb-3">' +
                escHtml(q.question_text || 'Assessment Question') +
            '</p>' +

            '<!-- Answers Comparison Grid -->' +
            '<div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">' +
                '<div class="p-2.5 rounded-xl border ' + (isCorrect ? 'bg-emerald-50/50 border-emerald-200 text-emerald-900' : 'bg-rose-50/70 border-rose-200 text-rose-900') + '">' +
                    '<span class="text-[10px] uppercase font-black tracking-wider block mb-0.5 ' + (isCorrect ? 'text-emerald-700' : 'text-rose-700') + '">' +
                        'Student\'s Submitted Answer:' +
                    '</span>' +
                    '<span class="font-bold">' + escHtml(q.student_answer || 'No response recorded') + '</span>' +
                '</div>' +
                '<div class="p-2.5 rounded-xl border bg-slate-50 border-slate-200 text-slate-800">' +
                    '<span class="text-[10px] uppercase font-black tracking-wider block mb-0.5 text-slate-500">' +
                        'Expected Correct Benchmark:' +
                    '</span>' +
                    '<span class="font-bold text-emerald-700">' + escHtml(q.correct_answer || 'Correct Answer') + '</span>' +
                '</div>' +
            '</div>' +
        '</div>';
    }).join('');
}

function printAssessmentDiagnostic() {
    window.print();
}

/* ================================================================
   TAB 2 — QUESTION BREAKDOWN (fetched from API)
   ================================================================ */
async function renderBreakdown(assessmentId) {
    const container = document.getElementById('breakdownContainer');
    if (!assessmentId) {
        container.innerHTML = `
            <div class="standard-empty-state" style="margin:0;min-height:410px;">
                <div class="w-14 h-14 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-500 flex items-center justify-center text-xl mb-3.5 shadow-sm">
                    <i class="fas fa-microscope"></i>
                </div>
                <h4 class="text-sm font-bold text-slate-700 mb-1">No assessment selected</h4>
                <p class="text-xs text-slate-400 max-w-sm mx-auto">Select an assessment from the dropdown above to inspect its per-question accuracy, difficulty, and average response time.</p>
            </div>`;
        return;
    }
 
    container.innerHTML = `
        <div class="standard-empty-state" style="margin:0;min-height:410px;">
            <div class="w-14 h-14 rounded-2xl bg-indigo-50 border border-indigo-100 text-indigo-500 flex items-center justify-center text-xl mb-3.5 shadow-sm">
                <i class="fas fa-spinner fa-spin"></i>
            </div>
            <h4 class="text-sm font-bold text-slate-700 mb-1">Loading question breakdown…</h4>
            <p class="text-xs text-slate-400 max-w-sm mx-auto">Analyzing item-level student responses and performance telemetry.</p>
        </div>`;
 
    try {
        const classIdParam = '<%= (typeof classInfo !== "undefined" && classInfo && classInfo.class_id) ? classInfo.class_id : "" %>';
        const url = '/teacher/api/breakdown/' + encodeURIComponent(assessmentId) + (classIdParam ? '?classId=' + encodeURIComponent(classIdParam) : '');
        const res  = await fetch(url);
        if (!res.ok) throw new Error('Server returned ' + res.status);
        const data = await res.json();
 
        if (!data.questions || data.questions.length === 0) {
            container.innerHTML = `
                <div class="standard-empty-state" style="margin:0;min-height:410px;">
                    <div class="w-14 h-14 rounded-2xl bg-slate-100 border border-slate-200 text-slate-400 flex items-center justify-center text-xl mb-3.5 shadow-sm">
                        <i class="fas fa-clipboard-question"></i>
                    </div>
                    <h4 class="text-sm font-bold text-slate-700 mb-1">No response data found</h4>
                    <p class="text-xs text-slate-400 max-w-sm mx-auto">No configured questions or student response records were found for this assessment yet.</p>
                </div>`;
            return;
        }

        const totalAllResponses = data.questions.reduce((s, q) => s + (Number(q.total_responses) || 0), 0);

        // Sort: lowest correct rate first (hardest questions), but questions with responses first
        data.questions.sort((a, b) => {
            if (a.total_responses === 0 && b.total_responses > 0) return 1;
            if (a.total_responses > 0 && b.total_responses === 0) return -1;
            return a.correct_rate - b.correct_rate;
        });
 
        const diffMap = { Easy:'diff-easy', Average:'diff-avg', Difficult:'diff-hard' };
 
        let html = '<div class="qb-grid">';
        data.questions.forEach((q, i) => {
            const total   = Number(q.total_responses) || 0;
            const rate    = Math.round((Number(q.correct_rate) || 0) * 100);
            const barColor= total === 0 ? '#94a3b8' : (rate >= 70 ? '#10b981' : rate >= 40 ? '#f59e0b' : '#ef4444');
            const avgMs   = (total > 0 && q.avg_response_ms) ? (q.avg_response_ms / 1000).toFixed(1) + 's' : '—';
            const diffCls = diffMap[q.difficulty] || 'diff-avg';
 
            html += `
            <div class="qb-card">
                <div class="qb-card-header">
                    <span class="qb-q-num">Q${i + 1}</span>
                    <span class="qb-difficulty ${diffCls}">${escHtml(q.difficulty || 'Average')}</span>
                </div>
                <div class="qb-q-text">${escHtml(q.question_text || 'Assessment Question')}</div>
                <div class="qb-stats">
                    <div class="qb-stat">
                        <div class="qb-stat-val" style="color:#10b981">${q.correct_count || 0}</div>
                        <div class="qb-stat-lbl">Correct</div>
                    </div>
                    <div class="qb-stat">
                        <div class="qb-stat-val" style="color:#ef4444">${q.wrong_count || 0}</div>
                        <div class="qb-stat-lbl">Wrong</div>
                    </div>
                    <div class="qb-stat">
                        <div class="qb-stat-val" style="color:#6366f1">${avgMs}</div>
                        <div class="qb-stat-lbl">Avg Time</div>
                    </div>
                    <div class="qb-stat">
                        <div class="qb-stat-val" style="color:${barColor}">${total > 0 ? rate + '%' : '0%'}</div>
                        <div class="qb-stat-lbl">Correct%</div>
                    </div>
                </div>
                <div class="correct-rate-bar">
                    <div class="correct-rate-fill" style="width:${total > 0 ? rate : 0}%;background:${barColor}"></div>
                </div>
            </div>`;
        });
        html += '</div>';
 
        // Summary strip
        let avgRate = 0;
        let hardest = data.questions[0];
        let hardestText = '—';
        let hardestRateStr = '—';

        if (totalAllResponses > 0) {
            const attemptedQuestions = data.questions.filter(q => (q.total_responses || 0) > 0);
            if (attemptedQuestions.length > 0) {
                avgRate = Math.round(attemptedQuestions.reduce((s, q) => s + q.correct_rate, 0) / attemptedQuestions.length * 100);
                hardest = attemptedQuestions[0];
                const rawSnippet = hardest && hardest.question_text ? hardest.question_text : 'Question';
                hardestText = escHtml(rawSnippet.length > 40 ? rawSnippet.slice(0, 40) + '…' : rawSnippet);
                hardestRateStr = Math.round(hardest.correct_rate * 100) + '%';
            }
        } else {
            const rawSnippet = hardest && hardest.question_text ? hardest.question_text : 'Curriculum Question';
            hardestText = escHtml(rawSnippet.length > 40 ? rawSnippet.slice(0, 40) + '…' : rawSnippet);
            hardestRateStr = '0 Attempts';
        }

        const avgRateColor = totalAllResponses === 0 ? '#64748b' : (avgRate >= 70 ? '#10b981' : avgRate >= 40 ? '#f59e0b' : '#ef4444');
        const avgRateLabel = totalAllResponses === 0 ? 'No Attempts Yet' : avgRate + '%';

        let summaryHtml = `
        <div style="display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:14px">
            <div style="background:#f8fafc;border-radius:10px;padding:10px 14px;text-align:center">
                <p style="font-size:18px;font-weight:800;color:#4f46e5">${data.questions.length}</p>
                <p style="font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase">Questions</p>
            </div>
            <div style="background:#f8fafc;border-radius:10px;padding:10px 14px;text-align:center">
                <p style="font-size:18px;font-weight:800;color:${avgRateColor}">${avgRateLabel}</p>
                <p style="font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase">Avg Correct Rate</p>
            </div>
            <div style="background:#fff7ed;border-radius:10px;padding:10px 14px;text-align:center">
                <p style="font-size:11px;font-weight:700;color:#c2410c;white-space:nowrap;overflow:hidden;text-overflow:ellipsis" title="${escHtml(hardest && hardest.question_text ? hardest.question_text : '')}">${hardestText}</p>
                <p style="font-size:10px;color:#94a3b8;font-weight:600;text-transform:uppercase;margin-top:2px">Hardest Item (${hardestRateStr})</p>
            </div>
        </div>`;

        if (totalAllResponses === 0) {
            summaryHtml += `
            <div style="background:#eff6ff;border:1px solid #bfdbfe;color:#1e40af;border-radius:10px;padding:10px 14px;margin-bottom:14px;font-size:12px;font-weight:600;display:flex;align-items:center;gap:8px">
                <i class="fas fa-info-circle text-blue-500 text-sm"></i>
                <span>Showing ${data.questions.length} configured curriculum question(s). No student attempts recorded for this assessment yet.</span>
            </div>`;
        }

        container.innerHTML = summaryHtml + html;
    } catch(err) {
        container.innerHTML = `
            <div class="standard-empty-state" style="margin:0;min-height:410px;">
                <div class="w-14 h-14 rounded-2xl bg-rose-50 border border-rose-100 text-rose-500 flex items-center justify-center text-xl mb-3.5 shadow-sm">
                    <i class="fas fa-circle-exclamation"></i>
                </div>
                <h4 class="text-sm font-bold text-rose-600 mb-1">Failed to load breakdown</h4>
                <p class="text-xs text-slate-400 max-w-sm mx-auto">${escHtml(err.message)}</p>
            </div>`;
    }
}

window.renderBreakdown = renderBreakdown;

document.addEventListener('DOMContentLoaded', function() {
    const bSelect = document.getElementById('breakdownSelect');
    if (bSelect) {
        bSelect.addEventListener('change', function() {
            renderBreakdown(this.value);
        });
    }
});
 
function escHtml(str) {
    return String(str).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}
 
/* ================================================================
   TAB 3 — MATCH FILTER
   ================================================================ */
function filterMatches(query) {
    const q = query.toLowerCase().trim();
    document.querySelectorAll('#matchesList .match-row').forEach(row => {
        row.style.display = (!q || row.dataset.players.includes(q)) ? '' : 'none';
    });
}
 
/* ================================================================
   TAB 5 — LIVE SESSION REFRESH
   ================================================================ */
async function refreshLiveSessions() {
    const btn = document.getElementById('liveRefreshBtn');
    btn.classList.add('spinning');
    try {
        const res  = await fetch('/teacher/api/live-sessions/<%= classInfo.class_id %>');
        if (!res.ok) throw new Error('Server ' + res.status);
        const data = await res.json();
 
        const container = document.getElementById('liveSessionsList');
        if (!data.sessions || data.sessions.length === 0) {
            container.innerHTML = `
            <div class="no-data-state py-10">
                <i class="fas fa-circle-check text-emerald-300 text-2xl mb-2 block"></i>
                No students are currently in an active session.
            </div>`;
        } else {
            let html = '';
            data.sessions.forEach(sess => {
                const totalItems = sess.total_items || 1;
                const itemPct    = Math.min(Math.round((sess.current_item_index / totalItems) * 100), 100);
                const modeClass  = sess.player_mode === 'Duel' ? 'mode-duel' : 'mode-single';
                html += `
                <div class="session-row" id="sess-row-${sess.session_id}">
                    <div class="live-pulse"></div>
                    <img src="/profile_uploads/${escHtml(sess.profile_pic||'default_avatar.png')}"
                         style="width:32px;height:32px;border-radius:9px;object-fit:cover;border:2px solid #e0f2fe;flex-shrink:0"
                         onerror="this.src='/profile_uploads/default_avatar.png'">
                    <div style="flex:1;min-width:0">
                        <p style="font-weight:700;font-size:12px;color:#334155">${escHtml(sess.last_name)}, ${escHtml(sess.first_name)}</p>
                        <p style="font-size:11px;color:#94a3b8;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">${escHtml(sess.assessment_name||'Unknown')}</p>
                    </div>
                    <span class="session-mode ${modeClass}">${escHtml(sess.player_mode)}</span>
                    <div class="session-progress">
                        <div style="display:flex;align-items:center;justify-content:space-between">
                            <span style="font-size:11px;color:#64748b">Item ${sess.current_item_index}/${totalItems}</span>
                            <span style="font-size:11px;font-weight:700;color:#7c3aed">${itemPct}%</span>
                        </div>
                        <div class="session-item-bar">
                            <div class="session-item-fill" style="width:${itemPct}%"></div>
                        </div>
                    </div>
                    <div style="text-align:right;flex-shrink:0">
                        <p style="font-size:12px;font-weight:800;color:#4f46e5">${sess.accumulated_score} pts</p>
                        <p style="font-size:11px;color:#94a3b8">Score</p>
                    </div>
                </div>`;
            });
            container.innerHTML = html;
        }
    } catch(err) {
        cmToast('Failed to refresh sessions: ' + err.message, 'error');
    } finally {
        btn.classList.remove('spinning');
    }
}
 
