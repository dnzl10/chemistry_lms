        <% if (!isAdmin) { %>
            <%- include('../partials/teacher-nav-scripts') %>
                <% } else { %>
                    <script>
                        function toggleSidebar() {
                            const sidebar = document.getElementById('sidebar');
                            const overlay = document.getElementById('sidebarOverlay');
                            if (sidebar) sidebar.classList.toggle('-translate-x-full');
                            if (overlay) overlay.classList.toggle('hidden');
                        }
                    </script>
                    <% } %>

                        <script type="application/json"
                            id="sim-quizzes-sync-data"><%- JSON.stringify(simulations || []).replace(/<\//g, '<\\/') %></script>
                        <script>
                            // Global State
                            let SIMULATIONS = JSON.parse(document.getElementById('sim-quizzes-sync-data').textContent || '[]');
                            const API_BASE = '<%= apiBase %>';
                            const ACTIVE_SY_ID = <%- JSON.stringify(activeSY ? activeSY.sy_id : null) %>;
                            const ACTIVE_SY_RANGE = <%- JSON.stringify(activeSY ? activeSY.sy_range : null) %>;
                            const IS_ADMIN_PORTAL = <%= isAdmin ? 'true' : 'false' %>;
                            const SY_QUERY = (IS_ADMIN_PORTAL && ACTIVE_SY_ID) ? `?sy_id=${encodeURIComponent(ACTIVE_SY_ID)}` : '';
                            let questionsList = [];

                            function showToast(msg, icon = 'fa-circle-check', color = 'text-emerald-500') {
                                const toast = document.getElementById('sim-toast');
                                const msgEl = document.getElementById('toast-msg');
                                const iconEl = document.getElementById('toast-icon');
                                if (!toast) return;

                                msgEl.textContent = msg;
                                iconEl.className = `fas ${icon} ${color} text-lg`;
                                toast.classList.add('show');
                                setTimeout(() => toast.classList.remove('show'), 3500);
                            }

                            function openModal(id) {
                                const m = document.getElementById(id);
                                if (m) m.classList.add('open');
                            }

                            function closeModal(id) {
                                const m = document.getElementById(id);
                                if (m) m.classList.remove('open');
                            }

                            function filterSimulationCards() {
                                const search = (document.getElementById('simSearchInput').value || '').toLowerCase().trim();
                                const cat = document.getElementById('simCategoryFilter').value.toLowerCase();
                                const status = document.getElementById('simStatusFilter').value;

                                document.querySelectorAll('.sim-card').forEach(card => {
                                    const title = card.getAttribute('data-title') || '';
                                    const cardCat = card.getAttribute('data-category') || '';
                                    const cardStatus = card.getAttribute('data-status') || '';

                                    const matchesSearch = !search || title.includes(search) || cardCat.includes(search);
                                    const matchesCat = (cat === 'all') || cardCat.includes(cat);
                                    const matchesStatus = (status === 'all') || (cardStatus === status);

                                    if (matchesSearch && matchesCat && matchesStatus) {
                                        card.style.display = 'flex';
                                    } else {
                                        card.style.display = 'none';
                                    }
                                });
                            }

                            function openNewQuizModal() {
                                if (SIMULATIONS.length > 0) {
                                    openQuizEditorModal(SIMULATIONS[0].slug, null);
                                }
                            }

                            // Opens editor modal for a simulation
                            async function openQuizEditorModal(slug, quizId) {
                                const sim = SIMULATIONS.find(s => s.slug === slug);
                                if (!sim) return;

                                document.getElementById('editQuizId').value = quizId || '';
                                document.getElementById('editSimSlug').value = slug;
                                document.getElementById('displaySimName').value = sim.title;
                                document.getElementById('modalEditorTitle').textContent = quizId ? `Edit Assessment Quiz: ${sim.title}` : `Create Assessment Quiz: ${sim.title}`;

                                questionsList = [];

                                if (quizId) {
                                    // Load existing quiz details from API
                                    try {
                                        const res = await fetch(`${API_BASE}/api/quiz/${quizId}${SY_QUERY}`);
                                        const data = await res.json();
                                        if (data.success && data.quiz) {
                                            document.getElementById('editQuizTitle').value = data.quiz.title;
                                            document.getElementById('editDescription').value = data.quiz.description || '';
                                            document.getElementById('editExpPerQuestion').value = data.quiz.exp_per_question || 20;

                                            // Format datetime-local
                                            if (data.quiz.expires_at) {
                                                const d = new Date(data.quiz.expires_at);
                                                d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
                                                document.getElementById('editExpiresAt').value = d.toISOString().slice(0, 16);
                                            }

                                            questionsList = (data.questions || []).map(q => {
                                                let opts = q.options_json;
                                                if (typeof opts === 'string') {
                                                    try { opts = JSON.parse(opts); } catch (e) { opts = []; }
                                                }
                                                return {
                                                    question_id: q.question_id,
                                                    question_text: q.question_text,
                                                    question_type: q.question_type,
                                                    options: opts || ['', '', '', ''],
                                                    correct_answer: q.correct_answer,
                                                    tolerance: q.tolerance,
                                                    accepted_synonyms: q.accepted_synonyms,
                                                    explanation: q.explanation || '',
                                                    exp_value: q.exp_value || 20
                                                };
                                            });
                                        }
                                    } catch (err) {
                                        console.error('Error fetching quiz details:', err);
                                    }
                                } else {
                                    // Defaults for new quiz
                                    document.getElementById('editQuizTitle').value = `${sim.title}: Assessment Quiz`;
                                    document.getElementById('editDescription').value = `Answer these 5 conceptual and quantitative items to earn EXP Bonus.`;
                                    document.getElementById('editExpPerQuestion').value = 20;

                                    // Default due date: 7 days in future
                                    const d = new Date(Date.now() + 7 * 24 * 60 * 60 * 1000);
                                    d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
                                    document.getElementById('editExpiresAt').value = d.toISOString().slice(0, 16);

                                    // Seed with 5 template questions
                                    questionsList = [
                                        { question_text: '', question_type: 'multiple_choice', options: ['', '', '', ''], correct_answer: '0', explanation: '' },
                                        { question_text: '', question_type: 'multiple_choice', options: ['', '', '', ''], correct_answer: '0', explanation: '' },
                                        { question_text: '', question_type: 'true_false', options: ['True', 'False'], correct_answer: 'true', explanation: '' },
                                        { question_text: '', question_type: 'identification', correct_answer: '', accepted_synonyms: '', explanation: '' },
                                        { question_text: '', question_type: 'problem_solving', correct_answer: '', tolerance: 0.1, explanation: '' }
                                    ];
                                }

                                renderQuestionsBuilder();
                                calculateTotalBonusExp();
                                openModal('quizEditorModal');
                            }

                            function addQuestion(type = 'multiple_choice') {
                                const q = {
                                    question_text: '',
                                    question_type: type,
                                    options: type === 'multiple_choice' ? ['', '', '', ''] : (type === 'true_false' ? ['True', 'False'] : []),
                                    correct_answer: type === 'multiple_choice' ? '0' : (type === 'true_false' ? 'true' : ''),
                                    tolerance: type === 'problem_solving' ? 0.1 : 0,
                                    accepted_synonyms: '',
                                    explanation: '',
                                    exp_value: parseInt(document.getElementById('editExpPerQuestion').value, 10) || 20
                                };
                                questionsList.push(q);
                                renderQuestionsBuilder();
                                calculateTotalBonusExp();
                            }

                            function removeQuestion(idx) {
                                if (questionsList.length <= 1) {
                                    alert('A quiz must have at least 1 question.');
                                    return;
                                }
                                questionsList.splice(idx, 1);
                                renderQuestionsBuilder();
                                calculateTotalBonusExp();
                            }

                            function calculateTotalBonusExp() {
                                const baseExp = parseInt(document.getElementById('editExpPerQuestion').value, 10) || 20;
                                // Synchronize all questions with the updated baseExp
                                questionsList.forEach(q => {
                                    q.exp_value = baseExp;
                                });
                                const total = questionsList.length * baseExp;
                                document.getElementById('totalBonusVal').textContent = `+${total} EXP`;
                            }

                            function renderQuestionsBuilder() {
                                const container = document.getElementById('questionsContainer');
                                container.innerHTML = '';

                                questionsList.forEach((q, idx) => {
                                    const card = document.createElement('div');
                                    card.className = 'p-4 rounded-xl bg-slate-50 border border-slate-200 space-y-3';

                                    let typeOptionsHtml = '';
                                    if (q.question_type === 'multiple_choice') {
                                        const letters = ['A', 'B', 'C', 'D'];
                                        typeOptionsHtml = `
                    <div class="space-y-2 mt-2">
                        <label class="text-[11px] font-bold text-slate-600">Options (Select radio for correct answer):</label>
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                            ${(q.options || ['', '', '', '']).map((opt, oIdx) => `
                                <div class="flex items-center gap-2 p-1.5 bg-white rounded-lg border border-slate-200">
                                    <input type="radio" name="correct_mc_${idx}" value="${oIdx}" ${String(q.correct_answer) === String(oIdx) ? 'checked' : ''}
                                           onchange="questionsList[${idx}].correct_answer = '${oIdx}'"
                                           class="text-cyan-600 focus:ring-0 cursor-pointer" />
                                    <span class="text-xs font-bold text-slate-500 w-4">${letters[oIdx]}</span>
                                    <input type="text" value="${escapeHtml(opt)}" placeholder="Option ${letters[oIdx]}"
                                           oninput="questionsList[${idx}].options[${oIdx}] = this.value"
                                           class="flex-1 bg-transparent text-xs text-slate-800 outline-none" />
                                </div>
                            `).join('')}
                        </div>
                    </div>
                `;
                                    } else if (q.question_type === 'true_false') {
                                        typeOptionsHtml = `
                    <div class="flex items-center gap-4 mt-2">
                        <label class="text-[11px] font-bold text-slate-600">Correct Answer:</label>
                        <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer">
                            <input type="radio" name="correct_tf_${idx}" value="true" ${String(q.correct_answer).toLowerCase() === 'true' ? 'checked' : ''}
                                   onchange="questionsList[${idx}].correct_answer = 'true'" class="text-emerald-600" />
                            <span>True</span>
                        </label>
                        <label class="flex items-center gap-1.5 text-xs text-slate-700 cursor-pointer">
                            <input type="radio" name="correct_tf_${idx}" value="false" ${String(q.correct_answer).toLowerCase() === 'false' ? 'checked' : ''}
                                   onchange="questionsList[${idx}].correct_answer = 'false'" class="text-rose-600" />
                            <span>False</span>
                        </label>
                    </div>
                `;
                                    } else if (q.question_type === 'identification') {
                                        typeOptionsHtml = `
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
                        <div>
                            <label class="text-[11px] font-bold text-slate-600">Expected Correct Term *</label>
                            <input type="text" value="${escapeHtml(q.correct_answer || '')}" placeholder="e.g. Sublimation"
                                   oninput="questionsList[${idx}].correct_answer = this.value"
                                   class="w-full px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-500" />
                        </div>
                        <div>
                            <label class="text-[11px] font-bold text-slate-600">Accepted Synonyms (comma-separated)</label>
                            <input type="text" value="${escapeHtml(q.accepted_synonyms || '')}" placeholder="e.g. phase transition, gas to solid"
                                   oninput="questionsList[${idx}].accepted_synonyms = this.value"
                                   class="w-full px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-500" />
                        </div>
                    </div>
                `;
                                    } else if (q.question_type === 'problem_solving') {
                                        typeOptionsHtml = `
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mt-2">
                        <div>
                            <label class="text-[11px] font-bold text-slate-600">Numerical Solution *</label>
                            <input type="text" value="${escapeHtml(q.correct_answer || '')}" placeholder="e.g. 298.15"
                                   oninput="questionsList[${idx}].correct_answer = this.value"
                                   class="w-full px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-500" />
                        </div>
                        <div>
                            <label class="text-[11px] font-bold text-slate-600">Allowable Tolerance (±)</label>
                            <input type="number" step="any" value="${q.tolerance !== undefined ? q.tolerance : 0.1}"
                                   oninput="questionsList[${idx}].tolerance = parseFloat(this.value) || 0"
                                   class="w-full px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-500" />
                        </div>
                    </div>
                `;
                                    }

                                    card.innerHTML = `
                <div class="flex items-center justify-between pb-2 border-b border-slate-200">
                    <div class="flex items-center gap-2">
                        <span class="w-6 h-6 rounded-full bg-slate-200 text-slate-700 font-bold text-xs flex items-center justify-center">${idx + 1}</span>
                        <span class="text-xs font-bold text-slate-700 capitalize">${q.question_type.replace('_', ' ')}</span>
                    </div>
                    <button type="button" onclick="removeQuestion(${idx})" class="text-slate-400 hover:text-rose-600 text-xs font-bold p-1 transition">
                        <i class="fas fa-trash"></i> Remove
                    </button>
                </div>

                <div>
                    <label class="text-[11px] font-bold text-slate-600">Question Prompt *</label>
                    <textarea rows="2" placeholder="Enter problem statement or question..."
                              oninput="questionsList[${idx}].question_text = this.value"
                              class="w-full px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-500 mt-1">${escapeHtml(q.question_text || '')}</textarea>
                </div>

                ${typeOptionsHtml}

                <div class="pt-2 border-t border-slate-200">
                    <label class="text-[11px] font-bold text-slate-600">Educational Explanation (Shown in review)</label>
                    <input type="text" value="${escapeHtml(q.explanation || '')}" placeholder="Explain why the answer is correct..."
                           oninput="questionsList[${idx}].explanation = this.value"
                           class="w-full px-3 py-1.5 bg-white border border-slate-300 rounded-lg text-xs text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-500 mt-1" />
                </div>
            `;
                                    container.appendChild(card);
                                });
                            }

                            async function handleSaveQuiz(event) {
                                event.preventDefault();
                                const btn = document.getElementById('saveQuizSubmitBtn');

                                // Validation
                                for (let i = 0; i < questionsList.length; i++) {
                                    const q = questionsList[i];
                                    if (!q.question_text.trim()) {
                                        alert(`Question #${i + 1} has an empty prompt.`);
                                        return;
                                    }
                                    if (q.question_type === 'multiple_choice') {
                                        const emptyOpt = (q.options || []).some(o => !String(o).trim());
                                        if (emptyOpt) {
                                            alert(`Question #${i + 1} has empty Multiple Choice options.`);
                                            return;
                                        }
                                    } else if (!String(q.correct_answer).trim()) {
                                        alert(`Question #${i + 1} is missing a correct answer.`);
                                        return;
                                    }
                                }

                                const baseExp = parseInt(document.getElementById('editExpPerQuestion').value, 10) || 20;
                                questionsList.forEach(q => {
                                    q.exp_value = baseExp;
                                });

                                const payload = {
                                    quiz_id: document.getElementById('editQuizId').value || null,
                                    sy_id: ACTIVE_SY_ID,
                                    simulation_slug: document.getElementById('editSimSlug').value,
                                    title: document.getElementById('editQuizTitle').value,
                                    description: document.getElementById('editDescription').value,
                                    expires_at: document.getElementById('editExpiresAt').value,
                                    exp_per_question: baseExp,
                                    questions: questionsList
                                };

                                btn.disabled = true;
                                btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Saving...`;

                                try {
                                    const res = await fetch(`${API_BASE}/save`, {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify(payload)
                                    });
                                    const data = await res.json();
                                    if (data.success) {
                                        showToast('Assessment Quiz saved and activated successfully!', 'fa-circle-check', 'text-emerald-500');
                                        closeModal('quizEditorModal');
                                        setTimeout(() => window.location.reload(), 1000);
                                        await refreshSimulationQuizzesContent();
                                    } else {
                                        alert(data.error || 'Failed to save quiz.');
                                    }
                                } catch (err) {
                                    console.error('Save quiz error:', err);
                                    alert('Network error while saving quiz.');
                                } finally {
                                    btn.disabled = false;
                                    btn.innerHTML = `<i class="fas fa-save"></i> <span>Save &amp; Activate Assessment Quiz</span>`;
                                }
                            }

                            window.refreshSimulationQuizzesContent = async function () {
                                try {
                                    const res = await fetch(window.location.href, {
                                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                                        cache: 'no-store'
                                    });
                                    if (!res.ok) return;
                                    const html = await res.text();
                                    const parser = new DOMParser();
                                    const newDoc = parser.parseFromString(html, 'text/html');

                                    ['simKpiGrid', 'simulationsGrid'].forEach(id => {
                                        const curEl = document.getElementById(id);
                                        const newEl = newDoc.getElementById(id);
                                        if (curEl && newEl) {
                                            curEl.innerHTML = newEl.innerHTML;
                                        }
                                    });

                                    const syncEl = newDoc.getElementById('sim-quizzes-sync-data');
                                    if (syncEl) {
                                        try {
                                            const updatedSims = JSON.parse(syncEl.textContent);
                                            if (Array.isArray(updatedSims)) {
                                                SIMULATIONS = updatedSims;
                                            }
                                        } catch (pe) {
                                            console.warn('Error parsing sim-quizzes-sync-data:', pe);
                                        }
                                    }

                                    if (typeof filterSimulationCards === 'function') {
                                        filterSimulationCards();
                                    }
                                } catch (err) {
                                    console.error('Error refreshing simulation quizzes content:', err);
                                }
                            };

                            // Opens Telemetry & Student Analytics modal
                            async function openTelemetryModal(quizId, simTitle) {
                                document.getElementById('telemetryModalTitle').textContent = `Student Telemetry: ${simTitle}`;
                                document.getElementById('btnExportCsv').href = `${API_BASE}/export-csv/${quizId}${SY_QUERY}`;
                                openModal('telemetryModal');

                                try {
                                    const res = await fetch(`${API_BASE}/api/analytics/${quizId}${SY_QUERY}`);
                                    const data = await res.json();
                                    if (!data.success) {
                                        alert(data.error || 'Failed to load telemetry analytics.');
                                        return;
                                    }

                                    // KPIs
                                    const kpiRow = document.getElementById('telemetryKpiRow');
                                    kpiRow.innerHTML = `
                <div class="p-3.5 rounded-xl bg-slate-50 border border-slate-200">
                    <div class="text-xl font-black text-slate-800">${data.kpis.totalSubmissions}</div>
                    <div class="text-[10px] font-bold text-slate-500 uppercase">Submissions</div>
                </div>
                <div class="p-3.5 rounded-xl bg-cyan-50 border border-cyan-200">
                    <div class="text-xl font-black text-cyan-700">${data.kpis.avgPercentage}%</div>
                    <div class="text-[10px] font-bold text-cyan-600 uppercase">Class Average</div>
                </div>
                <div class="p-3.5 rounded-xl bg-emerald-50 border border-emerald-200">
                    <div class="text-xl font-black text-emerald-700">${data.kpis.perfectScores}</div>
                    <div class="text-[10px] font-bold text-emerald-600 uppercase">Perfect (100%)</div>
                </div>
                <div class="p-3.5 rounded-xl bg-amber-50 border border-amber-200">
                    <div class="text-xl font-black text-amber-600">+${data.kpis.totalExpGranted}</div>
                    <div class="text-[10px] font-bold text-amber-700 uppercase">Total EXP Awarded</div>
                </div>
            `;

                                    // Question Accuracy
                                    const qContainer = document.getElementById('questionAccuracyContainer');
                                    qContainer.innerHTML = '';
                                    (data.questionStats || []).forEach((qs, idx) => {
                                        const color = qs.accuracy_percentage >= 70 ? 'bg-emerald-500' : (qs.accuracy_percentage >= 40 ? 'bg-amber-500' : 'bg-rose-500');
                                        qContainer.innerHTML += `
                    <div>
                        <div class="flex items-center justify-between text-xs mb-1">
                            <span class="text-slate-700 font-medium truncate max-w-[80%]"><strong>Q${idx + 1}:</strong> ${escapeHtml(qs.question_text)}</span>
                            <span class="font-bold text-slate-900">${qs.accuracy_percentage}% (${qs.correct_count}/${qs.total_attempts})</span>
                        </div>
                        <div class="w-full h-2 rounded-full bg-slate-200 overflow-hidden">
                            <div class="${color} h-full" style="width: ${qs.accuracy_percentage}%;"></div>
                        </div>
                    </div>
                `;
                                    });

                                    // Submissions Table
                                    const tbody = document.getElementById('telemetrySubmissionsTbody');
                                    document.getElementById('submissionsCountBadge').textContent = `${data.submissions.length} Submissions`;
                                    tbody.innerHTML = '';

                                    if (data.submissions.length === 0) {
                                        const syLabel = ACTIVE_SY_RANGE ? ` for S.Y. ${escapeHtml(ACTIVE_SY_RANGE)}` : '';
                                        tbody.innerHTML = `<tr><td colspan="7" class="py-6 text-center text-slate-500 italic">No student submissions recorded${syLabel} yet.</td></tr>`;
                                    } else {
                                        data.submissions.forEach(sub => {
                                            const subDate = new Date(sub.submitted_at).toLocaleString();
                                            const tr = document.createElement('tr');
                                            tr.className = 'hover:bg-slate-50 transition';
                                            tr.innerHTML = `
                        <td class="py-3 px-3 font-semibold text-slate-900">${escapeHtml(sub.first_name)} ${escapeHtml(sub.last_name)}</td>
                        <td class="py-3 px-3 text-slate-600">${sub.lrn_number || 'N/A'} <span class="text-slate-400">(${sub.section || 'All'})</span></td>
                        <td class="py-3 px-3 text-slate-500">${subDate}</td>
                        <td class="py-3 px-3">
                            <span class="font-bold ${sub.percentage >= 60 ? 'text-emerald-600' : 'text-rose-600'}">
                                ${sub.correct_count} / ${sub.total_questions} (${sub.percentage}%)
                            </span>
                        </td>
                        <td class="py-3 px-3 font-black text-amber-600">+${sub.exp_earned} EXP</td>
                        <td class="py-3 px-3 text-slate-700">${sub.current_profile_exp || 0} EXP (Lvl ${sub.current_level || 1})</td>
                        <td class="py-3 px-3 text-right">
                            <button type="button" onclick="openSubmissionDrillDown(${JSON.stringify(sub).replace(/"/g, '&quot;')})"
                                    class="px-2.5 py-1 bg-slate-100 hover:bg-slate-200 text-cyan-700 font-bold rounded-lg text-[11px] transition border border-slate-200">
                                Inspect Answers
                            </button>
                        </td>
                    `;
                                            tbody.appendChild(tr);
                                        });
                                    }

                                } catch (err) {
                                    console.error('Error loading telemetry:', err);
                                }
                            }

                            function openSubmissionDrillDown(sub) {
                                document.getElementById('subDetailStudentName').textContent = `${sub.first_name} ${sub.last_name}'s Answers`;
                                document.getElementById('subDetailMeta').textContent = `Score: ${sub.correct_count}/${sub.total_questions} (${sub.percentage}%) • Earned +${sub.exp_earned} EXP on ${new Date(sub.submitted_at).toLocaleString()}`;

                                const list = document.getElementById('subDetailList');
                                list.innerHTML = '';

                                let breakdowns = [];
                                try {
                                    breakdowns = typeof sub.answers_payload === 'string' ? JSON.parse(sub.answers_payload) : sub.answers_payload;
                                } catch (e) { }

                                breakdowns.forEach((b, idx) => {
                                    const isCor = b.is_correct;

                                    // Resolve human-friendly student answer
                                    let studentAnsText = b.student_answer_display;
                                    if (!studentAnsText) {
                                        if (b.student_answer !== null && b.student_answer !== undefined && String(b.student_answer).trim() !== '') {
                                            const letters = ['A', 'B', 'C', 'D', 'E'];
                                            const sIdx = parseInt(b.student_answer, 10);
                                            if (b.question_type === 'multiple_choice' && !isNaN(sIdx) && sIdx >= 0 && sIdx < 5) {
                                                const optText = (b.options_json && b.options_json[sIdx]) ? ` (${b.options_json[sIdx]})` : '';
                                                studentAnsText = `Option ${letters[sIdx] || (sIdx + 1)}${optText}`;
                                            } else if (b.question_type === 'true_false') {
                                                const sBool = String(b.student_answer).trim().toLowerCase();
                                                studentAnsText = (sBool === 'true' || sBool === '1') ? 'True' : 'False';
                                            } else {
                                                studentAnsText = String(b.student_answer).trim();
                                            }
                                        } else {
                                            studentAnsText = 'No answer';
                                        }
                                    }

                                    // Resolve human-friendly correct answer
                                    let correctAnsText = b.correct_answer_display;
                                    if (!correctAnsText) {
                                        const letters = ['A', 'B', 'C', 'D', 'E'];
                                        const cIdx = parseInt(b.correct_answer, 10);
                                        if (b.question_type === 'multiple_choice' && !isNaN(cIdx) && cIdx >= 0 && cIdx < 5) {
                                            const optText = (b.options_json && b.options_json[cIdx]) ? ` (${b.options_json[cIdx]})` : '';
                                            correctAnsText = `Option ${letters[cIdx] || (cIdx + 1)}${optText}`;
                                        } else if (b.question_type === 'true_false') {
                                            const cBool = String(b.correct_answer).trim().toLowerCase();
                                            correctAnsText = (cBool === 'true' || cBool === '1') ? 'True' : 'False';
                                        } else {
                                            correctAnsText = String(b.correct_answer ?? '').trim();
                                        }
                                    }

                                    list.innerHTML += `
                <div class="p-3.5 rounded-xl ${isCor ? 'bg-emerald-50 border border-emerald-200 text-emerald-900' : 'bg-rose-50 border border-rose-200 text-rose-900'} text-xs">
                    <div class="font-bold text-slate-900 mb-1">Question ${idx + 1}: ${escapeHtml(b.question_text)}</div>
                    <div>Student Answer: <strong class="${isCor ? 'text-emerald-700' : 'text-rose-700'}">${escapeHtml(studentAnsText)}</strong></div>
                    <div>Correct Answer: <strong class="text-slate-800">${escapeHtml(correctAnsText)}</strong></div>
                    ${b.explanation ? `<div class="text-[11px] text-slate-500 mt-1 italic">ℹ️ ${escapeHtml(b.explanation)}</div>` : ''}
                </div>
            `;
                                });

                                openModal('submissionDetailModal');
                            }

                            function escapeHtml(str) {
                                if (!str) return '';
                                return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
                            }
                        </script>

                        <%- include('../partials/notification-panel') %>
                            <%- include('../partials/teacher-nav-scripts') %>
    </body>

    </html>