<% const isAdmin=(typeof user !=='undefined' && user && (user.role==='Admin' || user.role==='admin' )); const
    dashboardUrl=isAdmin ? '/admin/dashboard' : '/teacher/dashboard' ; const apiBase=isAdmin
    ? '/admin/simulation-quizzes' : '/teacher/simulation-quizzes' ; const activeSY=(typeof selectedSY !=='undefined' &&
    selectedSY) ? selectedSY : ((typeof currentSY !=='undefined' && currentSY) ? currentSY : null); const
    isHistorical=(typeof isHistoricalSY !=='undefined' && isHistoricalSY); const isDraft=(typeof isDraftSY
    !=='undefined' && isDraftSY); %>
    <!DOCTYPE html>
    <html lang="en">

    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>Simulation Assessment Quizzes &amp; EXP Bonus | Elementa <%= isAdmin ? 'Admin' : 'Teacher' %>
        </title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
        <style>
            @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;600&display=swap');

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: #f0fdfa;
                /* Light Cyan/Emerald tint matching teacher theme */
                background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
                background-size: 24px 24px;
                color: #0f172a;
            }

            .font-mono {
                font-family: 'JetBrains Mono', monospace;
            }

            .no-scrollbar::-webkit-scrollbar {
                display: none;
            }

            .no-scrollbar {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }

            /* Nav active state */
            .nav-active {
                background: linear-gradient(135deg, #06b6d4 0%, #6366f1 100%) !important;
                color: white !important;
                font-weight: 700;
                box-shadow: 0 4px 16px rgba(6, 182, 212, 0.3), 0 2px 8px rgba(99, 102, 241, 0.4);
            }

            .nav-active i {
                color: white !important;
            }

            /* Theme Cards */
            .theme-card {
                background: rgba(255, 255, 255, 0.95);
                border: 1px solid #e2e8f0;
                border-radius: 1.25rem;
                box-shadow: 0 4px 20px rgba(15, 23, 42, 0.03);
                transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .theme-card:hover {
                border-color: #38bdf8;
                transform: translateY(-2px);
                box-shadow: 0 12px 30px -10px rgba(14, 165, 233, 0.18);
            }

            /* Pulse Exp Badge */
            .pulse-exp-badge {
                animation: pulseGlow 2s infinite;
            }

            @keyframes pulseGlow {

                0%,
                100% {
                    box-shadow: 0 0 10px rgba(245, 158, 11, 0.4);
                }

                50% {
                    box-shadow: 0 0 18px rgba(245, 158, 11, 0.8);
                }
            }

            /* Modals */
            .modal-backdrop {
                display: none;
                position: fixed;
                inset: 0;
                z-index: 100;
                background: rgba(15, 23, 42, 0.6);
                backdrop-filter: blur(5px);
                align-items: center;
                justify-content: center;
                padding: 16px;
            }

            .modal-backdrop.open {
                display: flex;
            }

            .modal-card {
                background: #ffffff;
                border: 1px solid #e2e8f0;
                border-radius: 1.5rem;
                width: 100%;
                max-width: 950px;
                max-height: 92vh;
                overflow-y: auto;
                box-shadow: 0 25px 60px -15px rgba(15, 23, 42, 0.25);
                animation: mSlideUp .22s ease-out;
                color: #0f172a;
            }

            @keyframes mSlideUp {
                from {
                    opacity: 0;
                    transform: translateY(16px) scale(0.98);
                }

                to {
                    opacity: 1;
                    transform: translateY(0) scale(1);
                }
            }

            /* Toast */
            #sim-toast {
                position: fixed;
                bottom: 24px;
                right: 24px;
                z-index: 999;
                background: #0f172a;
                color: white;
                padding: 14px 22px;
                border-radius: 14px;
                font-size: 13px;
                font-weight: 700;
                box-shadow: 0 12px 35px rgba(0, 0, 0, 0.25);
                transform: translateY(100px);
                opacity: 0;
                transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
                pointer-events: none;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            #sim-toast.show {
                transform: translateY(0);
                opacity: 1;
            }
        </style>
        <%- include('../partials/teacher-nav-styles') %>
    </head>

    <body class="text-slate-900">

        <!-- Global Toast Notification -->
        <div id="sim-toast">
            <i class="fas fa-circle-check text-emerald-400 text-lg" id="toast-icon"></i>
            <span id="toast-msg">Quiz saved successfully</span>
        </div>

        <div class="flex min-h-screen relative overflow-x-hidden">

            <% if (isAdmin) { %>
                <%- include('../partials/admin-sidebar', { activeNav: 'simulation_quizzes' }) %>
                    <% } else { %>
                        <%- include('../partials/teacher-sidebar', { activeNav: 'simulation_quizzes' }) %>
                            <% } %>

                                <!-- ===== MAIN CONTENT ===== -->
                                <main id="mainContent"
                                    class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

                                    <!-- Top Header Bar -->
                                    <header
                                        class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
                                        <div class="flex items-center gap-4">
                                            <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar"
                                                class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                                                <i class="fas fa-bars text-xl"></i>
                                            </button>
                                            <div class="hidden sm:block">
                                                <div class="flex items-center gap-2.5 flex-wrap">
                                                    <h1
                                                        class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">
                                                        Simulation Quizzes</h1>
                                                    <% if (activeSY) { %>
                                                        <span
                                                            class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-black border shadow-2xs <%= (isHistorical || isDraft) ? 'bg-amber-50 border-amber-200 text-amber-800' : 'bg-emerald-50 border-emerald-200 text-emerald-800' %>">
                                                            <span
                                                                class="w-1.5 h-1.5 rounded-full <%= (isHistorical || isDraft) ? 'bg-amber-500' : 'bg-emerald-500 animate-pulse' %>"></span>
                                                            <span>S.Y. <%= activeSY.sy_range %><%= isHistorical ? ' · Archived' : (isDraft ? ' · Draft' : '') %></span>
                                                        </span>
                                                    <% } %>
                                                </div>
                                                <p class="text-xs text-slate-600 font-medium">
                                                    <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                                                    Customize assessment questions, set EXP bonus deadlines &amp;
                                                    telemetry
                                                </p>
                                            </div>
                                        </div>

                                        <div class="flex items-center gap-3 md:gap-6">
                                            <!-- Create Custom Quiz Button -->
                                            <button onclick="openNewQuizModal()"
                                                class="flex items-center gap-2 px-4 py-2.5 bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-600 hover:to-indigo-700 text-white font-bold text-xs rounded-xl shadow-md hover:shadow-lg transition-all">
                                                <i class="fas fa-plus text-xs"></i>
                                                <span>Create Custom Quiz</span>
                                            </button>

                                            <!-- Messages Navigation Button -->
                                            <a href="<%= (typeof isAdmin !== 'undefined' && isAdmin) ? '/admin/dashboard' : '/teacher/messages' %>"
                                                id="messagesBtn" aria-label="Open messages and conversations"
                                                class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                                                <i class="far fa-comment-dots text-xl"></i>
                                                <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                                                    <span class="msg-badge-count">0</span>
                                                </span>
                                                <span
                                                    class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                                                    Messages
                                                </span>
                                            </a>

                                            <!-- Notification Button with keyboard-accessible tooltip -->
                                            <button type="button" onclick="toggleNotifPanel()"
                                                aria-label="View notifications"
                                                class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                                                <i class="far fa-bell text-xl text-slate-700"></i>
                                                <% const _unreadNotifCount = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications.filter(n => !n.is_read).length : 0; %>
                                                <span
                                                    class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center notif-badge <%= _unreadNotifCount > 0 ? '' : 'hidden' %>"
                                                    aria-hidden="true">
                                                    <span class="notif-badge-count"><%= _unreadNotifCount > 99 ? '99+' : _unreadNotifCount %></span>
                                                </span>
                                                <span
                                                    class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                                                    Notifications
                                                </span>
                                            </button>

                                            <!-- User Profile Dropdown -->
                                            <div class="relative">
                                                <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn"
                                                    aria-expanded="false" aria-label="Open user profile menu"
                                                    class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                                                    <div class="text-right hidden lg:block">
                                                        <p class="text-sm font-bold text-slate-800 leading-none mb-1">
                                                            <%= user.first_name %>
                                                                <%= user.last_name %>
                                                        </p>
                                                        <p
                                                            class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none">
                                                            <%= user.role || ((typeof isAdmin !=='undefined' && isAdmin)
                                                                ? 'Admin' : 'Teacher' ) %>
                                                        </p>
                                                    </div>
                                                    <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>"
                                                        alt="<%= user.first_name %>'s avatar"
                                                        class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100"
                                                        onerror="this.src='/profile_uploads/default_avatar.png'">
                                                    <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                                                </button>

                                                <div id="userDropdown"
                                                    class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                                                    <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                                                        <p class="text-sm font-bold text-slate-800">
                                                            <%= user.first_name %>
                                                                <%= user.last_name %>
                                                        </p>
                                                        <p class="text-xs text-slate-600 mt-1 uppercase font-bold">
                                                            <%= user.role || ((typeof isAdmin !=='undefined' && isAdmin)
                                                                ? 'Admin' : 'Teacher' ) %>
                                                        </p>
                                                    </div>
                                                    <a href="<%= (typeof isAdmin !== 'undefined' && isAdmin) ? '/admin/academic_management' : '/teacher/profile' %>"
                                                        class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                                                        <i class="far fa-user w-5 text-center"></i> View Profile
                                                    </a>
                                                    <hr class="my-2 border-slate-100">
                                                    <a href="/logout"
                                                        class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                                                        <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                                                    </a>
                                                </div>
                                            </div>
                                        </div>
                                    </header>

                                    <!-- Scrollable Dashboard Body -->
                                    <div class="flex-1 overflow-y-auto pt-24 px-4 md:px-8 pb-16 space-y-6"
                                        id="mainScroll">

                                        <!-- Stats KPI Overview Row -->
                                        <div id="simKpiGrid"
                                            class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                                            <% const activeCount=simulations.filter(s=> s.status ===
                                                'active').length;
                                                    const expiredCount = simulations.filter(s => s.status ===
                                                    'expired').length;
                                                    const totalSubmissions = simulations.reduce((acc, s) => acc +
                                                    (s.quiz ? (s.quiz.submissions_count || 0) : 0), 0);
                                                    %>
                                                    <div class="theme-card p-5 flex items-center gap-4">
                                                        <div
                                                            class="w-12 h-12 rounded-xl bg-cyan-50 border border-cyan-200 flex items-center justify-center text-cyan-600 text-xl shrink-0">
                                                            <i class="fas fa-atom"></i>
                                                        </div>
                                                        <div>
                                                            <div class="text-2xl font-black text-slate-800">
                                                                <%= simulations.length %>
                                                            </div>
                                                            <div
                                                                class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                                                Simulations</div>
                                                        </div>
                                                    </div>

                                                    <div class="theme-card p-5 flex items-center gap-4">
                                                        <div
                                                            class="w-12 h-12 rounded-xl bg-amber-50 border border-amber-200 flex items-center justify-center text-amber-600 text-xl shrink-0 pulse-exp-badge">
                                                            <i class="fas fa-bolt"></i>
                                                        </div>
                                                        <div>
                                                            <div class="text-2xl font-black text-amber-600">
                                                                <%= activeCount %>
                                                            </div>
                                                            <div
                                                                class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                                                Active EXP Bonus Quizzes</div>
                                                        </div>
                                                    </div>

                                                    <div class="theme-card p-5 flex items-center gap-4">
                                                        <div
                                                            class="w-12 h-12 rounded-xl bg-emerald-50 border border-emerald-200 flex items-center justify-center text-emerald-600 text-xl shrink-0">
                                                            <i class="fas fa-user-check"></i>
                                                        </div>
                                                        <div>
                                                            <div class="text-2xl font-black text-emerald-600">
                                                                <%= totalSubmissions %>
                                                            </div>
                                                            <div
                                                                class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                                                Student Submissions</div>
                                                        </div>
                                                    </div>

                                                    <div class="theme-card p-5 flex items-center gap-4">
                                                        <div
                                                            class="w-12 h-12 rounded-xl bg-rose-50 border border-rose-200 flex items-center justify-center text-rose-600 text-xl shrink-0">
                                                            <i class="fas fa-clock"></i>
                                                        </div>
                                                        <div>
                                                            <div class="text-2xl font-black text-rose-600">
                                                                <%= expiredCount %>
                                                            </div>
                                                            <div
                                                                class="text-xs font-semibold text-slate-500 uppercase tracking-wider">
                                                                Expired Quizzes</div>
                                                        </div>
                                                    </div>
                                            </div>

                                            <!-- Filter & Search Controls -->
                                            <div
                                                class="theme-card p-4 flex flex-col md:flex-row items-center justify-between gap-3">
                                                <div class="relative w-full md:w-80">
                                                    <i
                                                        class="fas fa-search absolute left-3.5 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                                    <input type="text" id="simSearchInput"
                                                        oninput="filterSimulationCards()"
                                                        placeholder="Search simulation (e.g. States, Atom, pH)..."
                                                        class="w-full pl-9 pr-4 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-800 placeholder-slate-400 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors" />
                                                </div>

                                                <div class="flex items-center gap-2.5 w-full md:w-auto">
                                                    <select id="simCategoryFilter" onchange="filterSimulationCards()"
                                                        class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
                                                        <option value="all">All Topic Categories</option>
                                                        <option value="Atomic Structure">Atomic Structure</option>
                                                        <option value="Chemical Bonding">Chemical Bonding</option>
                                                        <option value="Chemical Reactions">Chemical Reactions</option>
                                                        <option value="Solutions">Solutions</option>
                                                        <option value="States of Matter">States of Matter &amp;
                                                            Thermodynamics</option>
                                                        <option value="Quantum Chemistry">Quantum Chemistry</option>
                                                    </select>

                                                    <select id="simStatusFilter" onchange="filterSimulationCards()"
                                                        class="px-3 py-2.5 bg-slate-50 border border-slate-200 rounded-xl text-xs font-medium text-slate-700 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition-colors">
                                                        <option value="all">All Quiz Statuses</option>
                                                        <option value="active">Active Bonus Quizzes</option>
                                                        <option value="expired">Expired Quizzes</option>
                                                        <option value="none">Default Practice Only</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <!-- Simulations Grid (20 Simulations) -->
                                            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5"
                                                id="simulationsGrid">
                                                <% simulations.forEach(function(sim) { %>
                                                    <div class="theme-card flex flex-col overflow-hidden sim-card group"
                                                        data-slug="<%= sim.slug %>"
                                                        data-title="<%= sim.title.toLowerCase() %>"
                                                        data-category="<%= sim.category.toLowerCase() %>"
                                                        data-status="<%= sim.status %>">

                                                        <!-- Thumbnail Preview -->
                                                        <div
                                                            class="relative h-44 bg-slate-100 overflow-hidden border-b border-slate-200">
                                                            <img src="<%= sim.thumb %>" alt="<%= sim.title %>"
                                                                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                                                                onerror="this.src='/assets/logo.png'; this.classList.add('p-8','object-contain');" />

                                                            <!-- Category Badge -->
                                                            <span
                                                                class="absolute top-2.5 left-2.5 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-white/95 text-slate-700 border border-slate-200/80 shadow-xs backdrop-blur-md">
                                                                <%= sim.category.split('&')[0].trim() %>
                                                            </span>

                                                            <!-- Status Badge -->
                                                            <% if (sim.status==='active' ) { %>
                                                                <span
                                                                    class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-lg text-[10px] font-extrabold bg-gradient-to-r from-amber-400 to-yellow-500 text-slate-950 shadow-md pulse-exp-badge">
                                                                    ⚡ EXP Bonus Active
                                                                </span>
                                                                <% } else if (sim.status==='expired' ) { %>
                                                                    <span
                                                                        class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-lg text-[10px] font-bold bg-rose-50 text-rose-700 border border-rose-200 shadow-xs backdrop-blur-md">
                                                                        ⚠️ Expired
                                                                    </span>
                                                                    <% } else { %>
                                                                        <span
                                                                            class="absolute top-2.5 right-2.5 px-2.5 py-1 rounded-lg text-[10px] font-semibold bg-slate-100 text-slate-600 border border-slate-200 shadow-xs backdrop-blur-md">
                                                                            Default (0 EXP)
                                                                        </span>
                                                                        <% } %>
                                                        </div>

                                                        <!-- Card Content -->
                                                        <div class="p-4 flex-1 flex flex-col justify-between">
                                                            <div>
                                                                <h3
                                                                    class="font-bold text-slate-900 text-sm mb-1 line-clamp-1">
                                                                    <%= sim.title %>
                                                                </h3>

                                                                <% if (sim.quiz) { %>
                                                                    <div
                                                                        class="space-y-1.5 my-2.5 p-3 rounded-xl bg-slate-50 border border-slate-200 text-[11px]">
                                                                        <div
                                                                            class="flex items-center justify-between text-slate-600">
                                                                            <span><i
                                                                                    class="fas fa-list-check text-cyan-600 mr-1.5"></i>Questions:</span>
                                                                            <span class="font-bold text-slate-900">
                                                                                <%= sim.quiz.question_count %> items
                                                                            </span>
                                                                        </div>
                                                                        <div
                                                                            class="flex items-center justify-between text-slate-600">
                                                                            <span><i
                                                                                    class="fas fa-bolt text-amber-500 mr-1.5"></i>Reward:</span>
                                                                            <span class="font-bold text-amber-600">+<%=
                                                                                    sim.quiz.total_bonus_exp %>
                                                                                    EXP</span>
                                                                        </div>
                                                                        <div
                                                                            class="flex items-center justify-between text-slate-600">
                                                                            <span><i
                                                                                    class="fas fa-users text-emerald-600 mr-1.5"></i>Submissions:</span>
                                                                            <span class="font-bold text-emerald-600">
                                                                                <%= sim.quiz.submissions_count %>
                                                                                    students
                                                                            </span>
                                                                        </div>
                                                                        <div
                                                                            class="flex items-center justify-between text-slate-500 pt-1.5 border-t border-slate-200 text-[10px]">
                                                                            <span><i class="fas fa-clock mr-1"></i>Due
                                                                                Date:</span>
                                                                            <span class="font-medium text-slate-700">
                                                                                <%= new
                                                                                    Date(sim.quiz.expires_at).toLocaleDateString()
                                                                                    %>
                                                                            </span>
                                                                        </div>
                                                                    </div>
                                                                    <% } else { %>
                                                                        <p
                                                                            class="text-xs text-slate-500 line-clamp-2 my-2.5">
                                                                            No custom quiz active. Students currently
                                                                            answer default practice questions without
                                                                            EXP bonus.
                                                                        </p>
                                                                        <% } %>
                                                            </div>

                                                            <!-- Action Buttons -->
                                                            <div
                                                                class="pt-3 border-t border-slate-100 flex items-center gap-2">
                                                                <button type="button"
                                                                    onclick="openQuizEditorModal('<%= sim.slug %>', <%= sim.quiz ? sim.quiz.quiz_id : 'null' %>)"
                                                                    class="flex-1 py-2 px-3 bg-indigo-50 hover:bg-indigo-600 text-indigo-700 hover:text-white font-bold rounded-xl text-xs transition-colors flex items-center justify-center gap-1.5 border border-indigo-200 hover:border-transparent">
                                                                    <i class="fas fa-edit text-[11px]"></i>
                                                                    <span>
                                                                        <%= sim.quiz ? 'Edit Quiz' : 'Create Quiz' %>
                                                                    </span>
                                                                </button>

                                                                <% if (sim.quiz) { %>
                                                                    <button type="button"
                                                                        onclick="openTelemetryModal(<%= sim.quiz.quiz_id %>, '<%= sim.title %>')"
                                                                        class="py-2 px-3 bg-cyan-50 hover:bg-cyan-500 text-cyan-700 hover:text-white font-bold rounded-xl text-xs transition-colors flex items-center justify-center gap-1.5 border border-cyan-200 hover:border-transparent"
                                                                        title="View student telemetry & score analytics">
                                                                        <i class="fas fa-chart-line text-[11px]"></i>
                                                                    </button>
                                                                    <% } %>

                                                                        <a href="/Simulations/Elementa%20Simulations/<%= sim.slug %>_elementa.html"
                                                                            target="_blank"
                                                                            class="py-2 px-2.5 bg-slate-100 hover:bg-slate-200 text-slate-600 hover:text-slate-900 rounded-xl text-xs transition-colors flex items-center justify-center border border-slate-200"
                                                                            title="Preview interactive simulation in new tab">
                                                                            <i
                                                                                class="fas fa-external-link-alt text-[11px]"></i>
                                                                        </a>
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <% }); %>
                                            </div>

                                        </div>
                                </main>
        </div>

