                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">EXP Award Per Question</label>
                            <input type="number" id="editExpPerQuestion" min="5" max="100" value="20"
                                oninput="calculateTotalBonusExp()"
                                class="w-full px-3.5 py-2.5 bg-white border border-slate-300 rounded-xl text-xs font-semibold text-amber-600 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition" />
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1.5">Total EXP Bonus
                                (Calculated)</label>
                            <div id="displayTotalBonusExp"
                                class="px-3.5 py-2.5 bg-amber-50 border border-amber-200 rounded-xl text-xs font-extrabold text-amber-700 flex items-center justify-between">
                                <span>Total Bonus:</span>
                                <span id="totalBonusVal">+100 EXP</span>
                            </div>
                        </div>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-700 mb-1.5">Instructions / Description
                            (Optional)</label>
                        <textarea id="editDescription" rows="2"
                            placeholder="Provide guidelines for students before they take this simulation quiz..."
                            class="w-full px-3.5 py-2 bg-white border border-slate-300 rounded-xl text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 transition"></textarea>
                    </div>

                    <!-- Dynamic Questions Section -->
                    <div class="pt-4 border-t border-slate-200">
                        <div class="flex items-center justify-between mb-4 flex-wrap gap-2">
                            <div>
                                <h3 class="text-sm font-bold text-slate-900">Questions List</h3>
                                <p class="text-xs text-slate-500">Add 5, 10, or custom items across Multiple Choice,
                                    True/False, Identification, and Problem Solving.</p>
                            </div>

                            <div class="flex items-center gap-2">
                                <button type="button" onclick="addQuestion('multiple_choice')"
                                    class="px-3 py-1.5 bg-cyan-50 hover:bg-cyan-100 text-xs font-bold text-cyan-700 rounded-lg border border-cyan-200 transition">
                                    + Multiple Choice
                                </button>
                                <button type="button" onclick="addQuestion('true_false')"
                                    class="px-3 py-1.5 bg-emerald-50 hover:bg-emerald-100 text-xs font-bold text-emerald-700 rounded-lg border border-emerald-200 transition">
                                    + True / False
                                </button>
                                <button type="button" onclick="addQuestion('identification')"
                                    class="px-3 py-1.5 bg-purple-50 hover:bg-purple-100 text-xs font-bold text-purple-700 rounded-lg border border-purple-200 transition">
                                    + Identification
                                </button>
                                <button type="button" onclick="addQuestion('problem_solving')"
                                    class="px-3 py-1.5 bg-amber-50 hover:bg-amber-100 text-xs font-bold text-amber-700 rounded-lg border border-amber-200 transition">
                                    + Problem-Solving
                                </button>
                            </div>
                        </div>

                        <div id="questionsContainer" class="space-y-4">
                            <!-- Dynamic Question Cards rendered here -->
                        </div>
                    </div>

                    <!-- Modal Footer Actions -->
                    <div
                        class="pt-6 border-t border-slate-200 flex items-center justify-between sticky bottom-0 bg-white py-4 -mb-6 px-2">
                        <button type="button" onclick="closeModal('quizEditorModal')"
                            class="px-5 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-xl text-xs transition">
                            Cancel
                        </button>
                        <button type="submit" id="saveQuizSubmitBtn"
                            class="px-6 py-2.5 bg-gradient-to-r from-cyan-500 to-indigo-600 hover:from-cyan-600 hover:to-indigo-700 text-white font-extrabold rounded-xl text-xs shadow-md hover:shadow-lg transition flex items-center gap-2">
                            <i class="fas fa-save"></i>
                            <span>Save &amp; Activate Assessment Quiz</span>
                        </button>
                    </div>
                </form>
            </div>
        </div>

