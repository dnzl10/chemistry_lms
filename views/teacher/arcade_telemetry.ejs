<script type="application/json" id="telemetry-scatter-sync-data"><%- JSON.stringify(scatter || []).replace(/<\//g, '<\\/') %></script>
<script>
/* ── Sidebar & Profile Toggle ── */
function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    sb.classList.toggle('-translate-x-full');
    ov.classList.toggle('hidden');
}

function toggleProfileDropdown() {
    // Basic stub or redirect to profile
    window.location.href = '/teacher/profile';
}

function openModal(id) {
    const el = document.getElementById(id);
    if (el) el.classList.add('open');
}

function closeModal(id) {
    document.getElementById(id).classList.remove('open');
}

function anToast(msg, isError = false) {
    const t = document.getElementById('telemetry-toast');
    const msgEl = document.getElementById('toast-msg');
    const icnEl = document.getElementById('toast-icon');
    msgEl.innerText = msg;
    icnEl.className = isError ? 'fas fa-circle-xmark text-rose-400 text-base' : 'fas fa-circle-check text-emerald-400 text-base';
    t.classList.add('show');
    setTimeout(() => t.classList.remove('show'), 3500);
}

/* ── Element Inspection Drawer ── */
let currentInspectedElement = null;

function inspectElement(el) {
    const z = el.getAttribute('data-z');
    const sym = el.getAttribute('data-symbol');
    const name = el.getAttribute('data-name');
    const enc = el.getAttribute('data-encounters');
    const err = el.getAttribute('data-errors');
    const rate = el.getAttribute('data-rate');
    const hes = el.getAttribute('data-hesitation');

    currentInspectedElement = { z, sym, name, enc, err, rate, hes };

    document.getElementById('drawerZ').innerText = '#' + z;
    document.getElementById('drawerSym').innerText = sym;
    document.getElementById('drawerName').innerText = name;
    document.getElementById('drawerEncounters').innerText = enc;
    document.getElementById('drawerErrors').innerText = err;
    document.getElementById('drawerRate').innerText = rate + '%';
    document.getElementById('drawerHesitation').innerText = hes + 's';

    document.getElementById('elementDrawer').classList.remove('hidden');
}

function openRemediationModalForElement() {
    if (!currentInspectedElement) return;
    document.getElementById('remStudentId').value = '';
    document.getElementById('remMachineName').value = currentInspectedElement.name + ' Station';
    document.getElementById('remStudentLabel').innerText = `Target Concept: ${currentInspectedElement.name} (#${currentInspectedElement.z})`;
    document.getElementById('remCustomNote').value = `Telemetry indicates high hesitation / error rate when configuring ${currentInspectedElement.name} (${currentInspectedElement.sym}). Please review atomic properties.`;
    document.getElementById('remediationModal').classList.add('open');
}

/* ── Remediation Modal Trigger ── */
function openRemediationModal(studentId, name, machine) {
    document.getElementById('remStudentId').value = studentId;
    document.getElementById('remMachineName').value = machine;
    document.getElementById('remStudentLabel').innerText = `For Cadet: ${name} (${machine})`;
    document.getElementById('remCustomNote').value = `Targeted practice assigned based on Elementa Arcade telemetry at ${machine}.`;
    document.getElementById('remediationModal').classList.add('open');
}

async function submitRemediation(e) {
    e.preventDefault();
    const studentId = document.getElementById('remStudentId').value;
    const materialId = document.getElementById('remMaterialId').value;
    const customNote = document.getElementById('remCustomNote').value;
    const machineName = document.getElementById('remMachineName').value;

    try {
        const res = await fetch('/teacher/api/arcade/assign-remediation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                student_id: studentId || null,
                material_id: materialId || null,
                custom_note: customNote,
                machine_name: machineName
            })
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error);

        anToast('Remediation guidance dispatched to student successfully!');
        closeModal('remediationModal');
    } catch (err) {
        anToast('Failed to assign: ' + err.message, true);
    }
}

/* ── Replay Timeline Viewer ── */
async function loadSessionReplay(sessionId) {
    const modal = document.getElementById('replayModal');
    const body = document.getElementById('replayTimelineBody');
    const sub = document.getElementById('replaySubtitle');

    modal.classList.add('open');
    body.innerHTML = '<div class="py-12 text-center text-slate-400"><i class="fas fa-spinner fa-spin text-2xl"></i><p class="text-xs mt-2 font-bold">Decoding hardware telemetry...</p></div>';

    try {
        const res = await fetch('/teacher/api/arcade/replay/' + sessionId);
        const data = await res.json();
        if (!data.success || !data.replay) throw new Error(data.error || 'Replay trace not available');

        const { session, events } = data.replay;
        const isDual = session.play_mode === 'Versus' || Boolean(session.student_id_p2);

        if (isDual && (session.p2_first || session.student_id_p2)) {
            const p2Name = (session.p2_first && session.p2_last) ? `${session.p2_first} ${session.p2_last}` : 'Opponent';
            sub.innerText = `Duel Matchup: ${session.p1_first} ${session.p1_last} vs ${p2Name} • Score: ${session.final_score_p1 || session.final_score || 0} - ${session.final_score_p2 || 0} PTS • Cabinet: ${session.cabinet_id || 'KIOSK-01'}`;
        } else {
            sub.innerText = `Cadet: ${session.p1_first} ${session.p1_last} • Score: ${session.final_score || session.final_score_p1 || 0} PTS • Cabinet: ${session.cabinet_id || 'KIOSK-01'}`;
        }

        if (!events || events.length === 0) {
            body.innerHTML = '<div class="py-10 text-center text-slate-400 text-xs font-semibold">No granular micro-telemetry steps found for this session.</div>';
            return;
        }

        let html = '';
        events.forEach((ev, idx) => {
            const timeStr = new Date(ev.timestamp).toLocaleTimeString([], { hour: '2-digit', minute:'2-digit', second:'2-digit' });

            if (ev.type === 'periodic_lookup') {
                const isP1 = ev.playerNumber === 1;
                html += `
                    <div class="relative flex items-start gap-3.5 sm:gap-4">
                        <!-- Node Marker -->
                        <div class="relative z-10 w-9 h-9 rounded-full bg-cyan-600 text-white flex items-center justify-center text-xs font-black shadow-md shrink-0 border-2 border-white ring-2 ring-cyan-200">
                            <i class="fas fa-eye text-xs"></i>
                        </div>
                        <!-- Card Content -->
                        <div class="flex-1 min-w-0 bg-white rounded-2xl border border-cyan-100 p-4 shadow-xs hover:border-cyan-200 transition">
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-cyan-50 pb-2 mb-2.5">
                                <div class="flex items-center gap-2 flex-wrap">
                                    ${isDual ? `
                                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-extrabold ${isP1 ? 'bg-indigo-100 text-indigo-800 border border-indigo-200' : 'bg-rose-100 text-rose-800 border border-rose-200'}">
                                            <span class="w-1.5 h-1.5 rounded-full ${isP1 ? 'bg-indigo-600' : 'bg-rose-600'}"></span>
                                            Player ${ev.playerNumber || 1}: ${ev.playerName || (isP1 ? 'Player 1' : 'Player 2')}
                                        </span>
                                    ` : ''}
                                    <span class="text-xs font-black text-cyan-950">Periodic Table Lookup: ${ev.symbol || 'Element'}</span>
                                </div>
                                <span class="text-[11px] font-mono text-cyan-700 font-semibold flex items-center gap-1">
                                    <i class="far fa-clock text-[10px]"></i>
                                    ${timeStr}
                                </span>
                            </div>
                            <p class="text-xs text-cyan-800">
                                Inspected atomic cell #${ev.atomicNumber || '—'} from <strong class="text-cyan-950 font-bold">${ev.source || 'Station Reference'}</strong> with a ${((ev.durationMs || 1500) / 1000).toFixed(1)}s focus duration.
                            </p>
                        </div>
                    </div>
                `;
            } else {
                const isPass = ev.isCorrect;
                const isP1 = ev.playerNumber === 1;
                const statusBorder = isPass ? 'border-emerald-200 hover:border-emerald-300' : (ev.isTimeout ? 'border-amber-200 hover:border-amber-300' : 'border-rose-200 hover:border-rose-300');
                const statusBg = isPass ? 'bg-white' : (ev.isTimeout ? 'bg-amber-50/20' : 'bg-rose-50/20');
                const badgeColor = isPass ? 'bg-emerald-500 ring-emerald-200' : (ev.isTimeout ? 'bg-amber-500 ring-amber-200' : 'bg-rose-500 ring-rose-200');
                const statusText = isPass ? 'Success (Pass)' : (ev.isTimeout ? 'Timeout' : 'Failure: ' + (ev.failureType || 'Incorrect Configuration'));

                html += `
                    <div class="relative flex items-start gap-3.5 sm:gap-4">
                        <!-- Node Marker -->
                        <div class="relative z-10 w-9 h-9 rounded-full ${badgeColor} text-white flex items-center justify-center text-xs font-black shadow-md shrink-0 border-2 border-white ring-2">
                            ${isDual ? `<span class="text-[11px] font-black tracking-tight">P${ev.playerNumber || 1}</span>` : `<i class="fas ${isPass ? 'fa-check' : 'fa-xmark'} text-xs"></i>`}
                            ${isDual ? `
                                <span class="absolute -bottom-1 -right-1 w-4 h-4 rounded-full ${isPass ? 'bg-emerald-600' : 'bg-rose-600'} text-white text-[9px] flex items-center justify-center border-2 border-white shadow-xs">
                                    <i class="fas ${isPass ? 'fa-check' : 'fa-xmark'}"></i>
                                </span>
                            ` : ''}
                        </div>

                        <!-- Card Content -->
                        <div class="flex-1 min-w-0 ${statusBg} rounded-2xl border ${statusBorder} p-4 shadow-xs transition">
                            <!-- Card Header: Player Turn Indicator + Order & Level + Timestamp -->
                            <div class="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-2.5 mb-2.5">
                                <div class="flex items-center gap-2 flex-wrap">
                                    ${isDual ? `
                                        <div class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-[11px] font-extrabold ${isP1 ? 'bg-indigo-50 border border-indigo-200 text-indigo-700' : 'bg-rose-50 border border-rose-200 text-rose-700'}">
                                            <span class="w-2 h-2 rounded-full ${isP1 ? 'bg-indigo-500' : 'bg-rose-500'}"></span>
                                            <span>Player ${ev.playerNumber}: ${ev.playerName}</span>
                                            <span class="ml-1 px-1.5 py-0.2 rounded ${isP1 ? 'bg-indigo-600' : 'bg-rose-600'} text-white text-[9px] font-black uppercase tracking-wider">
                                                ${isP1 ? 'Answered 1st' : 'Followed by P2'}
                                            </span>
                                        </div>
                                    ` : `
                                        <div class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[11px] font-extrabold bg-slate-100 text-slate-700 border border-slate-200">
                                            <i class="fas fa-user-astronaut text-indigo-600 text-[10px]"></i>
                                            <span>${ev.playerName || 'Cadet'}</span>
                                        </div>
                                    `}
                                    <span class="text-xs font-black text-slate-800">
                                        Customer: ${ev.customer || 'Laboratory Order'} &nbsp;•&nbsp; Level ${ev.level || 1}
                                    </span>
                                </div>
                                <span class="text-[11px] font-mono text-slate-400 font-semibold flex items-center gap-1">
                                    <i class="far fa-clock text-[10px]"></i>
                                    ${timeStr}
                                </span>
                            </div>

                            <!-- Question Snapshot -->
                            <div class="bg-slate-50 border border-slate-100 rounded-xl p-3 text-xs text-slate-600 italic">
                                "${ev.question || 'Order specifications'}"
                            </div>

                            <!-- Answers comparison (if available) -->
                            ${ev.studentAnswer ? `
                                <div class="mt-2.5 flex flex-wrap items-center gap-2 text-xs">
                                    <span class="text-slate-500 font-semibold">Answer:</span>
                                    <span class="font-mono font-bold px-2 py-0.5 rounded-md ${isPass ? 'bg-emerald-50 text-emerald-700 border border-emerald-200' : 'bg-rose-50 text-rose-700 border border-rose-200'}">
                                        ${ev.studentAnswer}
                                    </span>
                                    ${!isPass && ev.correctAnswer ? `
                                        <span class="text-slate-400 font-semibold ml-2">Expected:</span>
                                        <span class="font-mono font-bold px-2 py-0.5 rounded-md bg-slate-100 text-slate-700 border border-slate-200">
                                            ${ev.correctAnswer}
                                        </span>
                                    ` : ''}
                                </div>
                            ` : ''}

                            <!-- Telemetry Meta Badges -->
                            <div class="mt-3 flex flex-wrap items-center gap-2 text-[11px] font-bold">
                                <span class="px-2.5 py-0.5 rounded-full ${isPass ? 'bg-emerald-100 text-emerald-800' : (ev.isTimeout ? 'bg-amber-100 text-amber-800' : 'bg-rose-100 text-rose-800')}">
                                    ${statusText}
                                </span>
                                <span class="text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-full border border-slate-200">
                                    Machine: <strong class="text-slate-700">${ev.machine || 'Chemical Mixing Station'}</strong>
                                </span>
                                <span class="text-slate-500 bg-slate-100 px-2.5 py-0.5 rounded-full border border-slate-200">
                                    Hesitation: <strong class="text-indigo-600">${ev.responseTime || 0}s</strong>
                                </span>
                                ${ev.scaffoldingUsed ? '<span class="px-2.5 py-0.5 rounded-full bg-purple-100 text-purple-700 border border-purple-200">Scaffolding Clue Triggered</span>' : ''}
                            </div>
                        </div>
                    </div>
                `;
            }
        });

        // Vertical timeline track container with connecting vertical spine
        body.innerHTML = `
            <div class="relative pl-1 sm:pl-2 py-2">
                <!-- Vertical timeline connector spine line -->
                <div class="absolute left-[22px] sm:left-[26px] top-6 bottom-6 w-0.5 bg-gradient-to-b from-indigo-500 via-purple-300 to-slate-200"></div>
                <div class="space-y-6">
                    ${html}
                </div>
            </div>
        `;
    } catch (err) {
        body.innerHTML = `<div class="p-6 text-center text-rose-500 text-xs font-bold">Failed to load replay: ${err.message}</div>`;
    }
}

/* ── Speed-Accuracy Scatter Chart (Chart.js) ── */
let speedAccuracyChartInstance = null;

function renderSpeedAccuracyChart(rawScatter) {
    const ctx = document.getElementById('speedAccuracyChart');
    if (!ctx) return;

    if (speedAccuracyChartInstance) {
        speedAccuracyChartInstance.destroy();
        speedAccuracyChartInstance = null;
    }

    const points = (rawScatter || []).map(s => ({
        x: s.x !== undefined ? s.x : (s.avgHesitation || 0),
        y: s.y !== undefined ? s.y : (s.accuracyRate || 0),
        studentName: s.name || 'Cadet',
        lrn: s.lrn || ''
    }));

    speedAccuracyChartInstance = new Chart(ctx.getContext('2d'), {
        type: 'scatter',
        data: {
            datasets: [{
                label: 'Cadets',
                data: points,
                backgroundColor: points.map(p => {
                    if (p.x <= 25 && p.y >= 70) return '#10b981'; // Mastery
                    if (p.x > 25 && p.y >= 70) return '#3b82f6';  // Methodical
                    if (p.x <= 25 && p.y < 70) return '#f59e0b';  // Impulsive
                    return '#ef4444';                             // Overloaded
                }),
                pointRadius: 6,
                pointHoverRadius: 9
            }]
        },
        options: {
            responsive: true,
            maintainAspectRatio: false,
            scales: {
                x: {
                    title: { display: true, text: 'Mean Hesitation Time (seconds)', font: { family: 'Plus Jakarta Sans', weight: 'bold', size: 11 } },
                    min: 0,
                    max: 60,
                    grid: { color: '#f1f5f9' }
                },
                y: {
                    title: { display: true, text: 'Accuracy Rate (%)', font: { family: 'Plus Jakarta Sans', weight: 'bold', size: 11 } },
                    min: 0,
                    max: 100,
                    grid: { color: '#f1f5f9' }
                }
            },
            plugins: {
                legend: { display: false },
                tooltip: {
                    callbacks: {
                        label: function(context) {
                            const p = context.raw;
                            return `${p.studentName}: ${p.y}% accuracy, ${p.x}s avg hesitation`;
                        }
                    }
                }
            }
        }
    });
}

document.addEventListener('DOMContentLoaded', () => {
    const rawScatter = <%- JSON.stringify(scatter || []) %>;
    renderSpeedAccuracyChart(rawScatter);
});

async function applyTelemetryClassFilter(classId) {
    try {
        const targetUrl = '/teacher/arcade-telemetry' + (classId ? ('?class_id=' + encodeURIComponent(classId)) : '');
        window.history.pushState({ class_id: classId }, '', targetUrl);

        const res = await fetch(targetUrl, {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            cache: 'no-store'
        });
        if (!res.ok) throw new Error('Failed to load telemetry filter');
        const html = await res.text();
        const parser = new DOMParser();
        const newDoc = parser.parseFromString(html, 'text/html');

        ['telemetryContentBody', 'allSessionsModal'].forEach(id => {
            const curEl = document.getElementById(id);
            const newEl = newDoc.getElementById(id);
            if (curEl && newEl) {
                curEl.innerHTML = newEl.innerHTML;
            }
        });

        const syncEl = newDoc.getElementById('telemetry-scatter-sync-data');
        if (syncEl) {
            const updatedScatter = JSON.parse(syncEl.textContent);
            renderSpeedAccuracyChart(updatedScatter);
        }

        fetchKioskFleetStatus(false);
        showToast('Class filter applied', 'info');
    } catch (err) {
        console.error('Error applying telemetry class filter:', err);
        showToast('Failed to update class filter', 'error');
    }
}

/* Initial Kiosk Fleet Pre-render & Periodic Live Sync */
document.addEventListener('DOMContentLoaded', () => {
    try {
        const initialKiosks = <%- JSON.stringify(kiosks || []) %>;
        if (Array.isArray(initialKiosks) && initialKiosks.length > 0) {
            renderKioskCards(initialKiosks);
        } else {
            fetchKioskFleetStatus(false);
        }
    } catch (e) {
        console.error('Error pre-rendering kiosks:', e);
        fetchKioskFleetStatus(false);
    }
    setInterval(() => fetchKioskFleetStatus(false), 2000);
});

/* ── Kiosk Fleet Remote Proctor Control & Live Sync ── */

function showToast(msg, type = 'info') {
    const toast = document.getElementById('telemetry-toast');
    const msgEl = document.getElementById('toast-msg');
    const iconEl = document.getElementById('toast-icon');
    if (!toast) return;

    if (msgEl) msgEl.textContent = msg;
    if (iconEl) {
        iconEl.className = type === 'error' 
            ? 'fas fa-circle-exclamation text-rose-400 text-base' 
            : 'fas fa-circle-check text-emerald-400 text-base';
    }

    toast.classList.add('show');
    clearTimeout(toast._timer);
    toast._timer = setTimeout(() => {
        toast.classList.remove('show');
    }, 3200);
}

function renderKioskCards(kiosks) {
    const container = document.getElementById('kioskFleetContainer');
    if (!container) return;

    if (!kiosks || kiosks.length === 0) {
        container.innerHTML = `
            <div class="col-span-full py-8 text-center text-slate-400 text-xs font-semibold bg-white rounded-xl border border-dashed border-slate-300">
                <i class="fas fa-server text-slate-300 text-2xl mb-2 block"></i>
                No arcade kiosks registered in fleet database.
            </div>
        `;
        return;
    }

    let html = '';
    kiosks.forEach(k => {
        const isOnline = k.is_online || (k.seconds_since_heartbeat !== null && k.seconds_since_heartbeat <= 45);
        const isAssessmentActive = isOnline && k.active_session_id && k.active_session_id > 0;
        const isPaused = k.pending_command === 'PAUSE' || k.is_proctor_paused === 1;

        let statusBadgeClass = 'bg-slate-100 text-slate-600 border border-slate-200';
        let statusText = 'Offline';
        let statusIcon = 'fa-power-off';
        let borderCardClass = 'border-slate-200/80';

        if (!isOnline) {
            statusBadgeClass = 'bg-slate-100 text-slate-500 border border-slate-200';
            statusText = 'Offline';
            statusIcon = 'fa-cloud-slash';
        } else if (isPaused) {
            statusBadgeClass = 'bg-rose-100 text-rose-800 border border-rose-300 animate-pulse';
            statusText = 'Proctor Paused';
            statusIcon = 'fa-lock';
            borderCardClass = 'border-rose-300 ring-2 ring-rose-200/50';
        } else if (isAssessmentActive) {
            statusBadgeClass = 'bg-amber-100 text-amber-900 border border-amber-300';
            statusText = 'In Assessment';
            statusIcon = 'fa-user-pen';
            borderCardClass = 'border-amber-300/80';
        } else {
            statusBadgeClass = 'bg-emerald-100 text-emerald-800 border border-emerald-300';
            statusText = 'Ready / Practice';
            statusIcon = 'fa-gamepad';
        }

        const heartbeatAge = k.seconds_since_heartbeat !== null 
            ? (k.seconds_since_heartbeat < 60 ? `${k.seconds_since_heartbeat}s ago` : `${Math.floor(k.seconds_since_heartbeat / 60)}m ago`)
            : 'Never';

        const studentDisplay = k.student_name_p1 
            ? `${k.student_name_p1}${k.student_name_p2 ? ' & ' + k.student_name_p2 : ''}`
            : (isAssessmentActive ? `Session #${k.active_session_id}` : 'None');

        html += `
            <div class="bg-white rounded-xl border ${borderCardClass} p-5 shadow-sm hover:shadow-md transition flex flex-col justify-between">
                <div>
                    <div class="flex items-start justify-between gap-2 border-b border-slate-100 pb-3">
                        <div>
                            <div class="flex items-center gap-2">
                                <span class="w-2.5 h-2.5 rounded-full ${isOnline ? 'bg-emerald-500 animate-pulse' : 'bg-slate-300'}"></span>
                                <h4 class="text-sm font-black text-slate-800 font-mono tracking-wide">${k.kiosk_id}</h4>
                            </div>
                            <p class="text-[11px] text-slate-400 font-medium mt-0.5">IP: ${k.ip_address || '127.0.0.1'} &bull; ${k.ping_ms || 4}ms</p>
                        </div>
                        <span class="px-2.5 py-1 rounded-full text-[10px] font-black tracking-wider uppercase ${statusBadgeClass}">
                            <i class="fas ${statusIcon} mr-1"></i> ${statusText}
                        </span>
                    </div>

                    <div class="py-3.5 space-y-2 text-xs">
                        ${isAssessmentActive ? `
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400 font-bold uppercase text-[10px]">Active Cadet:</span>
                                <span class="font-extrabold text-slate-800 truncate max-w-[170px]">${studentDisplay}</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400 font-bold uppercase text-[10px]">Assessment:</span>
                                <span class="font-bold text-indigo-600 truncate max-w-[170px]">${k.assessment_name || ('Level ' + (k.level_number || 1))}</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-400 font-bold uppercase text-[10px]">Mode:</span>
                                <span class="font-semibold text-slate-600">${k.play_mode || 'Solo'}</span>
                            </div>
                        ` : `
                            <div class="py-2 text-center text-slate-400 text-xs italic">
                                <i class="fas fa-gamepad text-slate-300 text-lg mb-1 block"></i>
                                Station idle or in Guest Practice mode.
                            </div>
                        `}
                    </div>
                </div>

                <div class="pt-3 border-t border-slate-100 flex items-center justify-between gap-2">
                    <span class="text-[10px] text-slate-400 font-medium">
                        <i class="far fa-clock mr-1"></i> ${heartbeatAge}
                    </span>
                    <div class="flex items-center gap-1.5">
                        ${isPaused ? `
                            <button onclick="sendKioskCommand('${k.kiosk_id}', 'RESUME')" class="px-3 py-1.5 rounded-lg bg-emerald-600 hover:bg-emerald-700 text-white font-black text-xs transition flex items-center gap-1.5 shadow-sm">
                                <i class="fas fa-play"></i> Resume
                            </button>
                        ` : `
                            <button onclick="sendKioskCommand('${k.kiosk_id}', 'PAUSE')" class="px-3 py-1.5 rounded-lg bg-rose-600 hover:bg-rose-700 text-white font-black text-xs transition flex items-center gap-1.5 shadow-sm" ${!isAssessmentActive ? 'disabled opacity-40 cursor-not-allowed title="Only active assessments can be paused"' : ''}>
                                <i class="fas fa-pause"></i> Pause
                            </button>
                        `}
                    </div>
                </div>
            </div>
        `;
    });

    container.innerHTML = html;
}

async function fetchKioskFleetStatus(showFeedback = false) {
    const icon = document.getElementById('kiosk-refresh-icon');
    const container = document.getElementById('kioskFleetContainer');
    if (icon) icon.classList.add('fa-spin');

    try {
        const res = await fetch('/api/elementa/kiosks');
        const data = await res.json();
        if (icon) icon.classList.remove('fa-spin');

        if (data.success && data.kiosks) {
            renderKioskCards(data.kiosks);
            if (showFeedback) showToast('Kiosk fleet synchronized', 'success');
        } else {
            if (container && container.innerHTML.includes('Connecting to arcade telemetry bus')) {
                renderKioskCards([]);
            }
            if (showFeedback) showToast(data.error || 'Failed to load fleet status', 'error');
        }
    } catch (err) {
        if (icon) icon.classList.remove('fa-spin');
        console.error('[fetchKioskFleetStatus]', err);
        if (container && container.innerHTML.includes('Connecting to arcade telemetry bus')) {
            container.innerHTML = `
                <div class="col-span-full py-6 text-center bg-rose-50 border border-rose-200 rounded-xl text-rose-700 text-xs font-semibold">
                    <i class="fas fa-triangle-exclamation text-rose-500 text-lg mb-1 block"></i>
                    Unable to reach arcade telemetry bus.
                    <button onclick="fetchKioskFleetStatus(true)" class="block mx-auto mt-2 px-3 py-1 bg-white hover:bg-rose-100 border border-rose-300 rounded text-rose-800 text-[11px] font-bold shadow-xs">
                        <i class="fas fa-rotate mr-1"></i> Try Reconnecting
                    </button>
                </div>
            `;
        }
        if (showFeedback) showToast('Network error connecting to fleet', 'error');
    }
}

async function sendKioskCommand(kioskId, action) {
    const actionLabel = action === 'PAUSE' ? 'Pause' : 'Resume';
    if (!confirm(`Are you sure you want to ${actionLabel.toUpperCase()} the ongoing assessment on ${kioskId}?`)) {
        return;
    }

    try {
        const teacherName = "<%= user ? (user.first_name + ' ' + user.last_name) : 'Instructor' %>";
        const res = await fetch(`/api/elementa/kiosk/${encodeURIComponent(kioskId)}/command`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ action: action, teacher_name: teacherName })
        });
        const data = await res.json();
        if (data.success) {
            showToast(`${actionLabel} command sent to ${kioskId}`, 'success');
            fetchKioskFleetStatus(false);
            setTimeout(() => fetchKioskFleetStatus(false), 500);
            setTimeout(() => fetchKioskFleetStatus(false), 1500);
        } else {
            showToast(data.error || 'Failed to dispatch command', 'error');
        }
    } catch (err) {
        console.error('[sendKioskCommand]', err);
        showToast('Error dispatching command', 'error');
    }
}
</script>
