<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Arcade Telemetry & Cognitive Analytics | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Nav active state */
        .nav-active {
            background: linear-gradient(135deg, #06b6d4 0%, #6366f1 100%) !important;
            color: white !important;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(6,182,212,0.3), 0 2px 8px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }

        .section-card { background: white; border-radius: 1.25rem; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 4px 20px rgba(15,23,42,0.03); }
        .section-header { padding: 16px 20px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }

        /* Periodic table grid */
        .pt-grid {
            display: grid;
            grid-template-columns: repeat(18, minmax(36px, 1fr));
            gap: 4px;
            overflow-x: auto;
            padding-bottom: 8px;
        }
        .pt-cell {
            aspect-ratio: 1;
            border-radius: 8px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: 800;
            cursor: pointer;
            transition: all 0.18s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            user-select: none;
            border: 1px solid rgba(0,0,0,0.06);
        }
        .pt-cell:hover {
            transform: scale(1.18);
            z-index: 20;
            box-shadow: 0 8px 20px rgba(0,0,0,0.18);
        }
        .pt-empty { aspect-ratio: 1; visibility: hidden; }

        /* Heatmap risk color scale */
        .heat-opt { background: #dcfce7; color: #15803d; border-color: #bbf7d0; }
        .heat-low { background: #fef9c3; color: #854d0e; border-color: #fef08a; }
        .heat-med { background: #ffedd5; color: #c2410c; border-color: #fed7aa; }
        .heat-high { background: #fee2e2; color: #b91c1c; border-color: #fca5a5; }
        .heat-none { background: #f8fafc; color: #94a3b8; border-color: #e2e8f0; }

        /* Quadrant scatter markers */
        .quad-badge { display: inline-flex; align-items: center; gap: 4px; padding: 2px 8px; border-radius: 9999px; font-size: 10px; font-weight: 800; }
        .quad-mastery { background: #dcfce7; color: #15803d; }
        .quad-methodical { background: #e0f2fe; color: #0369a1; }
        .quad-impulsive { background: #fef3c7; color: #b45309; }
        .quad-overload { background: #fee2e2; color: #b91c1c; }

        /* Modals & Drawers */
        .modal-backdrop { display: none; position: fixed; inset: 0; z-index: 100; background: rgba(15,23,42,0.6); align-items: center; justify-content: center; padding: 16px; backdrop-filter: blur(4px); }
        .modal-backdrop.open { display: flex; }
        .modal-card { background: white; border-radius: 1.5rem; width: 100%; max-width: 680px; max-height: 90vh; overflow-y: auto; box-shadow: 0 25px 50px -12px rgba(0,0,0,0.25); animation: mSlideUp .22s ease-out; }
        @keyframes mSlideUp { from { opacity: 0; transform: translateY(12px) scale(0.97); } to { opacity: 1; transform: translateY(0) scale(1); } }

        /* Toast notification */
        #telemetry-toast { position: fixed; bottom: 24px; right: 24px; z-index: 999; background: #0f172a; color: white; padding: 12px 20px; border-radius: 12px; font-size: 13px; font-weight: 700; box-shadow: 0 10px 30px rgba(0,0,0,0.2); transform: translateY(100px); opacity: 0; transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1); pointer-events: none; display: flex; align-items: center; gap: 10px; }
        #telemetry-toast.show { transform: translateY(0); opacity: 1; }
    </style>
    <%- include('../partials/teacher-nav-styles') %>
</head>
<body class="text-slate-900">

<div id="telemetry-toast">
    <i class="fas fa-circle-check text-emerald-400 text-base" id="toast-icon"></i>
    <span id="toast-msg">Operation completed successfully</span>
</div>

<div class="flex min-h-screen relative overflow-x-hidden">

    <%- include('../partials/teacher-sidebar', { activeNav: 'arcade_telemetry' }) %>

    <!-- ===== MAIN CONTENT ===== -->
    <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- Top Header Bar -->
        <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <div class="hidden sm:block">
                    <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">Arcade Telemetry</h1>
                    <p class="text-xs text-slate-600 font-medium">
                        <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                        Micro-Telemetry Analytics & Cognitive Diagnostic Fleet Monitor
                    </p>
                </div>
            </div>

            <!-- Class Filter & Profile Actions -->
            <div class="flex items-center gap-3 md:gap-6">
                <!-- Class selector -->
                <div class="relative hidden sm:block">
                    <select id="telemetryClassFilter" onchange="applyTelemetryClassFilter(this.value)"
                            class="bg-slate-50 border border-slate-200 text-slate-700 text-xs font-bold rounded-xl px-3 py-2 pr-8 outline-none focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100 transition cursor-pointer">
                        <option value="">All Roster Cadets</option>
                        <% if (classes && classes.length) { %>
                            <% classes.forEach(c => { %>
                                <option value="<%= c.class_id %>" <%= (selectedClassId == c.class_id) ? 'selected' : '' %>>
                                    <%= c.class_name %> (<%= c.section || 'General' %>)
                                </option>
                            <% }); %>
                        <% } %>
                    </select>
                </div>

                    <!-- Messages Navigation Button (Entry point to teacher messages workspace) -->
                    <a href="/teacher/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                        <i class="far fa-comment-dots text-xl"></i>
                        
                        <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                            <span class="msg-badge-count">0</span>
                        </span>

                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Messages
                        </span>
                    </a>

                <!-- Notification Button with keyboard-accessible tooltip -->
                <button type="button" onclick="toggleNotifPanel()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                    <i class="far fa-bell text-xl text-slate-700"></i>
                    <% const _unreadNotifCount = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications.filter(n => !n.is_read).length : 0; %>
                    <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center notif-badge <%= _unreadNotifCount > 0 ? '' : 'hidden' %>" aria-hidden="true">
                        <span class="notif-badge-count"><%= _unreadNotifCount > 99 ? '99+' : _unreadNotifCount %></span>
                    </span>

                    <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                        Notifications
                    </span>
                </button>

                <!-- User Profile Dropdown -->
                <div class="relative">
                    <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                        <div class="text-right hidden lg:block">
                            <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none"><%= user.role || 'Teacher' %></p>
                        </div>
                        <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100" onerror="this.src='/profile_uploads/default_avatar.png'">
                        <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                    </button>

                    <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                        <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                            <p class="text-sm font-bold text-slate-800"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role || 'Teacher' %></p>
                        </div>
                        <a href="/teacher/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                            <i class="far fa-user w-5 text-center"></i> View Profile
                        </a>
                        <hr class="my-2 border-slate-100">
                        <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                            <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- ===== SCROLLABLE CONTENT BODY ===== -->
        <div id="telemetryContentBody" class="flex-1 overflow-y-auto mt-20 no-scrollbar p-4 md:p-8 space-y-6">

            <!-- HERO STAT STRIP -->
            <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
                <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-cyan-50 flex items-center justify-center text-cyan-600 text-xl font-bold">
                        <i class="fas fa-gamepad"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Total Arcade Sessions</p>
                        <h3 class="text-2xl font-black text-slate-800"><%= recentSessions ? recentSessions.length : 0 %></h3>
                    </div>
                </div>
                <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-indigo-50 flex items-center justify-center text-indigo-600 text-xl font-bold">
                        <i class="fas fa-stopwatch"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Mean Dial Hesitation</p>
                        <h3 class="text-2xl font-black text-indigo-600">
                            <%= scatter && scatter.length ? (scatter.reduce((a,c) => a + (Number(c.x !== undefined ? c.x : c.avgHesitation) || 0), 0) / scatter.length).toFixed(1) : '18.4' %>s
                        </h3>
                    </div>
                </div>
                <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-rose-50 flex items-center justify-center text-rose-600 text-xl font-bold">
                        <i class="fas fa-triangle-exclamation"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Early Warning Cadets</p>
                        <h3 class="text-2xl font-black text-rose-600">
                            <%= riskList ? riskList.filter(r => r.riskTier === 'Critical' || r.riskTier === 'Moderate').length : 0 %>
                        </h3>
                    </div>
                </div>
                <div class="bg-white rounded-2xl p-5 border border-slate-200/80 shadow-sm flex items-center gap-4">
                    <div class="w-12 h-12 rounded-xl bg-emerald-50 flex items-center justify-center text-emerald-600 text-xl font-bold">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <div>
                        <p class="text-xs font-bold text-slate-400 uppercase tracking-wider">Auto Gradebook Sync</p>
                        <h3 class="text-2xl font-black text-emerald-600">100% Active</h3>
                    </div>
                </div>
            </div>

            <!-- ============================================================
                 PROCTOR CONSOLE: LIVE KIOSK FLEET & ASSESSMENT PAUSE CONTROL
                 ============================================================ -->
            <div class="section-card border-indigo-200/80 shadow-md">
                <div class="section-header bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white border-b-0 py-4 px-6 rounded-t-2xl">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-indigo-500/20 border border-indigo-400/30 flex items-center justify-center text-indigo-400 text-lg shadow-inner">
                            <i class="fas fa-shield-halved"></i>
                        </div>
                        <div>
                            <div class="flex items-center gap-2">
                                <h2 class="text-base font-black tracking-wide text-white">Live Kiosk Fleet &amp; Assessment Proctor Console</h2>
                                <span class="px-2 py-0.5 rounded-full text-[10px] font-black uppercase tracking-wider bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 flex items-center gap-1.5">
                                    <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                    Telemetry Live
                                </span>
                            </div>
                            <p class="text-xs text-indigo-200/80 font-medium mt-0.5">
                                Real-time laboratory station governance. Only instructors have the authority to pause or release ongoing assessments.
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3">
                        <button onclick="fetchKioskFleetStatus(true)" class="px-3.5 py-1.5 rounded-lg bg-indigo-800/60 hover:bg-indigo-700/80 text-indigo-200 border border-indigo-600/40 text-xs font-bold transition flex items-center gap-1.5 shadow-sm">
                            <i class="fas fa-rotate" id="kiosk-refresh-icon"></i>
                            Refresh Fleet
                        </button>
                    </div>
                </div>

                <!-- Kiosk Grid Body -->
                <div class="p-6 bg-slate-50/50">
                    <div id="kioskFleetContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
                        <div class="col-span-full py-8 text-center text-slate-400 text-xs font-semibold">
                            <i class="fas fa-circle-notch fa-spin text-indigo-500 text-xl mb-2 block"></i>
                            Connecting to arcade telemetry bus...
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================================
                 SECTION 1: 118-ELEMENT PERIODIC TABLE DISTRACTOR HEATMAP
                 ============================================================ -->
            <div class="section-card">
                <div class="section-header">
                    <div>
                        <h2 class="text-base font-black text-slate-800 flex items-center gap-2">
                            <i class="fas fa-table-cells text-cyan-500"></i>
                            118-Element Periodic Table Distractor & Confusion Matrix
                        </h2>
                        <p class="text-xs text-slate-400 font-medium mt-0.5">
                            Real-time error density generated from live arcade customer encounters, dial tuning, and barcode lookups.
                        </p>
                    </div>
                    <div class="flex items-center gap-3 text-xs font-bold text-slate-600">
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-emerald-400"></span> 0-15% Error</span>
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-amber-400"></span> 15-35% Error</span>
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-orange-400"></span> 35-55% Error</span>
                        <span class="flex items-center gap-1.5"><span class="w-3 h-3 rounded-full bg-rose-500"></span> &gt;55% Confusion</span>
                    </div>
                </div>

                <div class="p-6 overflow-x-auto">
                    <!-- Periodic Table Layout Container -->
                    <div class="min-w-[920px]">
                        <div class="pt-grid" id="periodicTableGrid">
                            <% 
                            // Map heatmap array by atomic number
                            const heatMapLookup = {};
                            if (heatmap && heatmap.length) {
                                heatmap.forEach(h => { heatMapLookup[h.atomicNumber] = h; });
                            }

                            // 118-element fallback list in case elements is empty
                            const allElements = (typeof elements !== 'undefined' && elements && elements.length) ? elements : [];
                            
                            // Map elements by atomic number
                            const elementLookup = {};
                            allElements.forEach(el => { elementLookup[el.atomic_number] = el; });

                            for (let z = 1; z <= 118; z++) {
                                const el = elementLookup[z] || {};
                                const h = heatMapLookup[z] || {};

                                const atomicNumber = z;
                                const symbol = el.element_symbol || h.symbol || '?';
                                const name = el.element_name || h.name || ('Element ' + z);
                                const category = el.category || h.category || 'Unknown';
                                const encounters = Number(h.clicks || h.totalEncounters || 0);
                                const errors = Number(h.errors || h.errorCount || 0);
                                const errorRatio = Number(h.errorRatio || (encounters > 0 ? (errors / encounters) : 0));
                                const errorRate = (errorRatio <= 1 && errorRatio > 0) ? Math.round(errorRatio * 100) : Math.round(errorRatio);
                                const hesitation = h.hesitationAvg || 0;
                                const groupCol = el.group_col;
                                const periodRow = el.period_row;

                                let heatClass = 'heat-none';
                                if (encounters > 0) {
                                    if (errorRate > 55) heatClass = 'heat-high';
                                    else if (errorRate > 35) heatClass = 'heat-med';
                                    else if (errorRate > 15) heatClass = 'heat-low';
                                    else heatClass = 'heat-opt';
                                }

                                const gridStyle = (groupCol && periodRow) ? `grid-column: ${groupCol}; grid-row: ${periodRow};` : '';
                            %>
                                <div class="pt-cell <%= heatClass %>"
                                     style="<%= gridStyle %>"
                                     data-z="<%= atomicNumber %>"
                                     data-symbol="<%= symbol %>"
                                     data-name="<%= name %>"
                                     data-category="<%= category %>"
                                     data-encounters="<%= encounters %>"
                                     data-errors="<%= errors %>"
                                     data-rate="<%= errorRate %>"
                                     data-hesitation="<%= hesitation %>"
                                     onclick="inspectElement(this)"
                                     title="<%= name %> (#<%= atomicNumber %>) [<%= symbol %>] — Encounters: <%= encounters %>, Errors: <%= errors %> (<%= errorRate %>%)">
                                    <span class="text-[8px] opacity-75 font-normal"><%= atomicNumber %></span>
                                    <span class="text-xs font-black leading-none"><%= symbol %></span>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>

                <!-- Element Inspection Drawer (Revealed on click) -->
                <div id="elementDrawer" class="hidden p-5 bg-slate-50 border-t border-slate-200 transition-all">
                    <div class="flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div class="flex items-center gap-4">
                            <div class="w-16 h-16 rounded-2xl bg-cyan-600 text-white flex flex-col items-center justify-center shadow-lg shadow-cyan-600/20">
                                <span class="text-xs font-semibold" id="drawerZ">#1</span>
                                <span class="text-2xl font-black leading-none" id="drawerSym">H</span>
                            </div>
                            <div>
                                <h3 class="text-lg font-black text-slate-800" id="drawerName">Hydrogen</h3>
                                <div class="flex flex-wrap items-center gap-3 text-xs text-slate-500 font-semibold mt-1">
                                    <span>Encounters: <strong class="text-slate-800" id="drawerEncounters">0</strong></span>
                                    <span>•</span>
                                    <span>Errors: <strong class="text-rose-600" id="drawerErrors">0</strong></span>
                                    <span>•</span>
                                    <span>Error Rate: <strong class="text-rose-600" id="drawerRate">0%</strong></span>
                                    <span>•</span>
                                    <span>Avg Hesitation: <strong class="text-indigo-600" id="drawerHesitation">0s</strong></span>
                                </div>
                            </div>
                        </div>

                        <div class="flex items-center gap-2">
                            <button onclick="openRemediationModalForElement()" class="px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-700 text-white text-xs font-bold transition shadow-sm flex items-center gap-2">
                                <i class="fas fa-bullseye"></i> Assign Targeted Study Module
                            </button>
                            <button onclick="document.getElementById('elementDrawer').classList.add('hidden')" class="px-3 py-2 rounded-xl bg-white border border-slate-200 text-slate-600 hover:bg-slate-100 text-xs font-bold transition">
                                <i class="fas fa-xmark"></i>
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <!-- ============================================================
                 SECTION 2 & 3: SPEED-ACCURACY SCATTER & REPLAY
                 ============================================================ -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                <!-- 2A. Cognitive Hesitation & Speed-Accuracy Scatter -->
                <div class="section-card flex flex-col">
                    <div class="section-header">
                        <div>
                            <h2 class="text-base font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-brain text-indigo-500"></i>
                                Speed-Accuracy & Cognitive Hesitation
                            </h2>
                            <p class="text-xs text-slate-400 font-medium mt-0.5">
                                Identifies impulsive dial guessing vs. cognitive overload
                            </p>
                        </div>
                    </div>
                    <div class="p-6 flex-1 flex flex-col justify-between">
                        <div class="relative w-full h-80">
                            <canvas id="speedAccuracyChart"></canvas>
                        </div>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 pt-4 border-t border-slate-100 mt-4 text-center">
                            <div class="p-2 rounded-xl bg-emerald-50 text-emerald-800 text-xs">
                                <p class="font-extrabold">Mastery</p>
                                <p class="text-[10px] text-emerald-600">Fast & Accurate</p>
                            </div>
                            <div class="p-2 rounded-xl bg-blue-50 text-blue-800 text-xs">
                                <p class="font-extrabold">Methodical</p>
                                <p class="text-[10px] text-blue-600">Slow & Accurate</p>
                            </div>
                            <div class="p-2 rounded-xl bg-amber-50 text-amber-800 text-xs">
                                <p class="font-extrabold">Impulsive</p>
                                <p class="text-[10px] text-amber-600">Fast & Guessing</p>
                            </div>
                            <div class="p-2 rounded-xl bg-rose-50 text-rose-800 text-xs">
                                <p class="font-extrabold">Overloaded</p>
                                <p class="text-[10px] text-rose-600">Slow & Failing</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- 2B. Step-by-Step Problem Solving Replay Feed -->
                <div class="section-card flex flex-col">
                    <div class="section-header">
                        <div>
                            <h2 class="text-base font-black text-slate-800 flex items-center gap-2">
                                <i class="fas fa-film text-purple-500"></i>
                                Step-by-Step Problem-Solving Replay
                            </h2>
                            <p class="text-xs text-slate-400 font-medium mt-0.5">
                                Inspect micro-interactions: dial turns, scans, and periodic clicks
                            </p>
                        </div>
                        <button type="button" onclick="openModal('allSessionsModal')"
                                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-xl border border-purple-200 bg-purple-50 hover:bg-purple-600 text-purple-700 hover:text-white font-black text-xs transition shadow-2xs cursor-pointer group">
                            <span>All</span>
                            <i class="fas fa-arrow-right text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                        </button>
                    </div>
                    <div class="p-4 flex-1 min-h-0 overflow-y-auto space-y-2.5 custom-scrollbar">
                        <% if (recentSessions && recentSessions.length > 0) { %>
                            <% recentSessions.slice(0, 5).forEach(sess => { %>
                                <div class="p-3 rounded-xl border border-slate-200/80 hover:border-cyan-400 bg-white hover:bg-cyan-50/20 transition flex items-center justify-between gap-3 shadow-2xs">
                                    <div class="flex items-center gap-3 min-w-0 flex-1">
                                        <% if ((sess.game_mode === 'Versus' || sess.play_mode === 'Versus') && sess.p2_first_name) { %>
                                            <!-- Dual Avatars -->
                                            <div class="flex -space-x-2.5 overflow-hidden flex-shrink-0">
                                                <img src="/profile_uploads/<%= sess.profile_pic || 'default_avatar.png' %>" class="w-10 h-10 rounded-xl object-cover ring-2 ring-white shadow-xs" title="<%= sess.first_name %> <%= sess.last_name %>" onerror="this.src='/profile_uploads/default_avatar.png'">
                                                <img src="/profile_uploads/<%= sess.p2_profile_pic || 'default_avatar.png' %>" class="w-10 h-10 rounded-xl object-cover ring-2 ring-rose-400 shadow-xs" title="<%= sess.p2_first_name %> <%= sess.p2_last_name %>" onerror="this.src='/profile_uploads/default_avatar.png'">
                                            </div>
                                        <% } else { %>
                                            <!-- Single Avatar -->
                                            <img src="/profile_uploads/<%= sess.profile_pic || 'default_avatar.png' %>" class="w-10 h-10 rounded-xl object-cover ring-2 ring-slate-100 flex-shrink-0" onerror="this.src='/profile_uploads/default_avatar.png'">
                                        <% } %>

                                        <div class="min-w-0 flex-1">
                                            <p class="text-sm font-bold text-slate-800 leading-tight truncate">
                                                <% if ((sess.game_mode === 'Versus' || sess.play_mode === 'Versus') && sess.p2_first_name) { %>
                                                    <span><%= sess.first_name %> <%= sess.last_name %></span>
                                                    <span class="text-xs font-black text-rose-500 px-1 uppercase tracking-tight">vs</span>
                                                    <span><%= sess.p2_first_name %> <%= sess.p2_last_name %></span>
                                                <% } else { %>
                                                    <%= sess.first_name %> <%= sess.last_name %>
                                                <% } %>
                                            </p>
                                            <p class="text-[11px] text-slate-400 mt-0.5 truncate flex items-center gap-1.5">
                                                <% if ((sess.game_mode === 'Versus' || sess.play_mode === 'Versus') && sess.p2_first_name) { %>
                                                    <span class="inline-flex items-center px-1.5 py-0.2 rounded font-black text-[9px] uppercase bg-rose-100 text-rose-700">DUAL</span>
                                                <% } %>
                                                <span>LRN: <span class="font-mono text-slate-600"><%= sess.lrn_number || 'N/A' %></span></span>
                                                <span>&bull;</span>
                                                <span><%= new Date(sess.played_at || sess.started_at || Date.now()).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></span>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-3 flex-shrink-0">
                                        <div class="text-right">
                                            <% if ((sess.game_mode === 'Versus' || sess.play_mode === 'Versus') && sess.p2_first_name) { %>
                                                <p class="text-xs font-black text-cyan-700">
                                                    <%= sess.final_score %> <span class="text-slate-400 font-bold">-</span> <%= sess.final_score_p2 != null ? sess.final_score_p2 : 0 %> PTS
                                                </p>
                                            <% } else { %>
                                                <p class="text-xs font-black text-cyan-700"><%= sess.final_score %> PTS</p>
                                            <% } %>
                                            <p class="text-[10px] font-bold text-slate-400"><%= sess.cabinet_id || 'KIOSK-01' %></p>
                                        </div>
                                        <button onclick="loadSessionReplay(<%= sess.session_id %>)" class="p-2 rounded-xl bg-indigo-50 hover:bg-indigo-600 hover:text-white text-indigo-600 text-xs font-bold transition flex items-center gap-1.5 cursor-pointer">
                                            <i class="fas fa-play text-xs"></i> Replay
                                        </button>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="text-center py-12 text-slate-400 text-xs font-semibold">
                                <i class="fas fa-gamepad text-3xl mb-2 opacity-50 block"></i>
                                No arcade sessions recorded for this class selection yet.
                            </div>
                        <% } %>
                    </div>
                </div>

            </div>

            <!-- ============================================================
                 SECTION 4: EARLY WARNING INTERVENTION RADAR TABLE
                 ============================================================ -->
            <div class="section-card">
                <div class="section-header">
                    <div>
                        <h2 class="text-base font-black text-slate-800 flex items-center gap-2">
                            <i class="fas fa-shield-halved text-rose-500"></i>
                            Early Warning Intervention Radar ($Z_{\text{risk}}$ Model)
                        </h2>
                        <p class="text-xs text-slate-400 font-medium mt-0.5">
                            Predictive failure probability based on hesitation spikes, repeat timeouts, and machine failure clusters.
                        </p>
                    </div>
                </div>

                <div class="overflow-x-auto">
                    <table class="w-full text-left border-collapse">
                        <thead>
                            <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold uppercase tracking-wider text-slate-500">
                                <th class="py-3 px-5">Cadet</th>
                                <th class="py-3 px-4">Risk Tier</th>
                                <th class="py-3 px-4 text-center">Failure Risk</th>
                                <th class="py-3 px-4 text-center">Predicted Exam</th>
                                <th class="py-3 px-4">Vulnerable Machine</th>
                                <th class="py-3 px-4 text-center">Timeouts</th>
                                <th class="py-3 px-5 text-right">Intervention</th>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-slate-100 text-xs">
                            <% if (riskList && riskList.length > 0) { %>
                                <% riskList.forEach(r => { %>
                                    <tr class="hover:bg-slate-50/80 transition">
                                        <td class="py-3.5 px-5 flex items-center gap-3">
                                            <img src="/profile_uploads/<%= r.profilePic || 'default_avatar.png' %>" class="w-8 h-8 rounded-lg object-cover ring-1 ring-slate-200" onerror="this.src='/profile_uploads/default_avatar.png'">
                                            <div>
                                                <p class="font-bold text-slate-800"><%= r.name %></p>
                                                <p class="text-[10px] text-slate-400"><%= r.section || 'General' %></p>
                                            </div>
                                        </td>
                                        <td class="py-3.5 px-4">
                                            <% if (r.riskTier === 'Critical') { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-black bg-rose-100 text-rose-700">
                                                    <span class="w-1.5 h-1.5 rounded-full bg-rose-600 animate-pulse"></span> Critical Risk
                                                </span>
                                            <% } else if (r.riskTier === 'Moderate') { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-black bg-amber-100 text-amber-800">
                                                    Moderate Risk
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800">
                                                    Optimal
                                                </span>
                                            <% } %>
                                        </td>
                                        <td class="py-3.5 px-4 text-center font-black <%= r.riskScore >= 70 ? 'text-rose-600' : (r.riskScore >= 50 ? 'text-amber-600' : 'text-slate-600') %>">
                                            <%= r.riskScore %>%
                                        </td>
                                        <td class="py-3.5 px-4 text-center font-bold text-indigo-600">
                                            ~<%= r.predictedScore %>%
                                        </td>
                                        <td class="py-3.5 px-4 font-semibold text-slate-700">
                                            <%= r.vulnerableMachine %>
                                        </td>
                                        <td class="py-3.5 px-4 text-center font-mono font-bold text-slate-600">
                                            <%= r.totalTimeouts %>
                                        </td>
                                        <td class="py-3.5 px-5 text-right">
                                            <button onclick="openRemediationModal('<%= r.userId %>', '<%= r.name.replace(/'/g, '\\\'') %>', '<%= r.vulnerableMachine %>')"
                                                    class="px-3 py-1.5 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white text-[11px] font-bold transition shadow-sm">
                                                <i class="fas fa-paper-plane mr-1"></i> Remediate
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            <% } else { %>
                                <tr>
                                    <td colspan="7" class="py-10 text-center text-slate-400 font-semibold">
                                        No active risk alerts recorded. All cadets performing within healthy cognitive bounds!
                                    </td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>

        </div>
    </main>
</div>

