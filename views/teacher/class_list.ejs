<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Classes | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }
        #sidebar {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: linear-gradient(180deg, #0d1a2e 0%, #0b1523 100%);
        }
        
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* ── Main scroll ── */
        #mainScroll { overflow-y: auto; }
        #mainScroll::-webkit-scrollbar { width: 5px; }
        #mainScroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }

        /* ── Section card ── */
        .section-card {
            background: white;
            border-radius: 1.25rem;
            border: 1px solid #e2e8f0;
            overflow: hidden;
        }
        .section-header {
            padding: 16px 20px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        /* ── Class card ── */
        .class-card {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 1.25rem;
            overflow: hidden;
            transition: box-shadow 0.2s, transform 0.2s;
            cursor: pointer;
            display: flex;
            flex-direction: column;
        }
        .class-card:hover {
            box-shadow: 0 8px 32px rgba(99,102,241,0.12);
            transform: translateY(-2px);
        }
        .class-card-banner {
            height: 90px;
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
        }
        .class-card-banner img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }
        .class-card-banner-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(15,23,42,0.55) 0%, rgba(99,102,241,0.35) 100%);
        }
        .class-card-body { padding: 14px 16px; flex: 1; display: flex; flex-direction: column; gap: 6px; }
        .class-card-footer {
            padding: 10px 16px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #fafafa;
        }

        /* ── Student detail modal ── */
        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 200;
            background: rgba(15,23,42,0.55);
            align-items: center;
            justify-content: center;
            padding: 16px;
        }
        .modal-backdrop.open { display: flex; }
        .modal-card {
            background: white;
            border-radius: 1.25rem;
            width: 100%;
            max-width: 680px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(15,23,42,0.18);
            animation: modalIn 0.2s ease;
        }
        .modal-card::-webkit-scrollbar { width: 4px; }
        .modal-card::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 9999px; }
        @keyframes modalIn {
            from { opacity: 0; transform: scale(0.96) translateY(8px); }
            to   { opacity: 1; transform: scale(1)    translateY(0); }
        }
        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 18px 22px;
            border-bottom: 1px solid #f1f5f9;
            position: sticky;
            top: 0;
            background: white;
            z-index: 10;
        }
        .modal-section { padding: 18px 22px; border-bottom: 1px solid #f8fafc; }
        .modal-section:last-child { border-bottom: none; }
        .modal-section-title {
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .08em;
            color: #94a3b8;
            margin-bottom: 12px;
        }
        .detail-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        @media (max-width: 480px) { .detail-grid { grid-template-columns: 1fr; } }
        .detail-item { }
        .detail-label { font-size: 10px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 2px; }
        .detail-value { font-size: 13px; font-weight: 600; color: #334155; }
        .detail-value.mono { font-family: monospace; font-size: 12px; color: #475569; }

        /* ── Progress bar ── */
        .prog-track { width: 100%; height: 6px; background: #e2e8f0; border-radius: 9999px; overflow: hidden; }
        .prog-fill   { height: 100%; border-radius: 9999px; transition: width 0.6s ease; }

        /* ── Score rows ── */
        .score-row { display: flex; align-items: center; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid #f8fafc; font-size: 12px; }
        .score-row:last-child { border-bottom: none; }

        /* ── EXP badge ── */
        .exp-badge {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            padding: 3px 9px;
            border-radius: 9999px;
            background: linear-gradient(90deg, #fef3c7, #fde68a);
            color: #92400e;
            font-size: 11px;
            font-weight: 800;
        }

        /* ── Badge type ── */
        .badge-type { display: inline-flex; align-items: center; gap: 3px; padding: 2px 7px; border-radius: 9999px; font-size: 10px; font-weight: 700; }
        .atype-pre    { background: #e0f2fe; color: #0369a1; }
        .atype-post   { background: #dcfce7; color: #15803d; }
        .atype-quiz   { background: #fef9c3; color: #a16207; }
        .atype-comp   { background: #fce7f3; color: #9d174d; }

        /* ── Pill chip ── */
        .chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 10px; border-radius: 9999px; font-size: 11px; font-weight: 700; }
        .chip-blue   { background: #e0f2fe; color: #0369a1; }
        .chip-violet { background: #ede9fe; color: #5b21b6; }
        .chip-teal   { background: #ccfbf1; color: #0f766e; }
        .chip-amber  { background: #fef3c7; color: #92400e; }
        .chip-rose   { background: #ffe4e6; color: #be123c; }
        .chip-green  { background: #dcfce7; color: #15803d; }
        .chip-gray   { background: #f1f5f9; color: #475569; }

        /* ── Search + filter ── */
        .search-input {
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            padding: 8px 14px 8px 36px;
            font-size: 13px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
            background: white;
            width: 220px;
        }
        .search-input:focus { border-color: #06b6d4; box-shadow: 0 0 0 3px rgba(6,182,212,0.12); }

        .filter-select {
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            padding: 7px 10px;
            font-size: 12px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #475569;
            outline: none;
            background: white;
            cursor: pointer;
            transition: border-color 0.2s;
        }
        .filter-select:focus { border-color: #06b6d4; }

        /* ── Tab bar (student detail modal) ── */
        .student-tabs { display: flex; gap: 2px; background: #f1f5f9; border-radius: 10px; padding: 3px; margin-bottom: 16px; flex-wrap: wrap; }
        .student-tab  { padding: 6px 14px; border-radius: 8px; font-size: 12px; font-weight: 700; color: #64748b; cursor: pointer; transition: all .15s; border: none; background: transparent; font-family: 'Plus Jakarta Sans', sans-serif; display: flex; align-items: center; gap: 5px; }
        .student-tab:hover  { background: white; color: #334155; }
        .student-tab.active { background: white; color: #4f46e5; box-shadow: 0 1px 4px rgba(0,0,0,0.08); }
        .student-panel { display: none; }
        .student-panel.active { display: block; }

        /* ── Fade-in for cards ── */
        @keyframes fadeUp {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }
        .fade-card { animation: fadeUp 0.25s ease forwards; opacity: 0; }

        /* ── Toast ── */
        #toast {
            position: fixed; bottom: 24px; right: 24px; z-index: 999;
            background: #1e293b; color: white;
            padding: 10px 18px; border-radius: 10px;
            font-size: 13px; font-weight: 600;
            box-shadow: 0 8px 24px rgba(15,23,42,0.2);
            transform: translateY(80px); opacity: 0;
            transition: all 0.3s ease;
            pointer-events: none;
        }
        #toast.show { transform: translateY(0); opacity: 1; }
        #toast.success { background: #064e3b; }
        #toast.error   { background: #7f1d1d; }

        /* ── Response breakdown mini bar ── */
        .resp-bar-wrap { display: flex; align-items: center; gap: 6px; }
        .resp-bar-track { flex: 1; height: 4px; background: #e2e8f0; border-radius: 9999px; overflow: hidden; min-width: 60px; }
        .resp-bar-fill  { height: 100%; border-radius: 9999px; }

        /* ── Sy filter button ── */
        .sy-btn { padding: 5px 12px; border-radius: 8px; font-size: 12px; font-weight: 700; border: 1px solid #e2e8f0; background: white; color: #475569; cursor: pointer; transition: all .15s; font-family: 'Plus Jakarta Sans', sans-serif; }
        .sy-btn:hover  { border-color: #06b6d4; color: #0891b2; background: #ecfeff; }
        .sy-btn.active { background: #0891b2; border-color: #0e7490; color: white; }

        /* ── No results ── */
        .no-results { text-align: center; padding: 60px 0; color: #cbd5e1; }
        .no-results i { font-size: 32px; margin-bottom: 10px; display: block; }

        /* Nav active state */
        .nav-active {
            background: linear-gradient(135deg, #06b6d4 0%, #6366f1 100%) !important;
            color: white !important;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(6,182,212,0.3), 0 2px 8px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Profile dropdown */
        .profile-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 210px;
            background: white;
            border-radius: 1rem;
            box-shadow: 0 8px 32px rgba(6,182,212,0.13), 0 2px 8px rgba(99,102,241,0.10);
            border: 1px solid #e0f2fe;
            z-index: 999;
            opacity: 0;
            transform: translateY(-6px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.18s ease, transform 0.18s ease;
        }
        .profile-dropdown.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all;
        }
        .profile-dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 700;
            color: #1e293b;
            cursor: pointer;
            transition: background 0.13s;
            border-radius: 0.75rem;
            text-decoration: none;
        }
        .profile-dropdown-item:hover { background: #f0f9ff; color: #0369a1; }
        .profile-dropdown-item.danger:hover { background: #fff1f2; color: #be123c; }
    </style>
    <%- include('../partials/teacher-nav-styles') %>
</head>
<body class="text-slate-900">

<div id="toast"></div>

<div class="flex min-h-screen relative overflow-x-hidden">

    <!-- Sidebar overlay (mobile) -->
    <!-- Overlay (mobile) -->
    <%- include('../partials/teacher-sidebar', { activeNav: 'classes' }) %>

    <!-- ===== MAIN ===== -->
    <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- Top header -->
        <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <div>
                    <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">My Classes</h1>
                    <p class="text-xs text-slate-600 hidden sm:block font-medium">
                        <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                        Manage your classes and student rosters
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3 md:gap-6">
                    <!-- Messages Navigation Button (Entry point to teacher messages workspace) -->
                    <a href="/teacher/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                        <i class="far fa-comment-dots text-xl"></i>
                        
                        <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                            <span class="msg-badge-count">0</span>
                        </span>

                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Messages
                        </span>
                    </a>

                <!-- Notification Button with keyboard-accessible tooltip -->
                <button type="button" onclick="toggleNotifPanel()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                    <i class="far fa-bell text-xl text-slate-700"></i>
                    <% const _unreadNotifCount = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications.filter(n => !n.is_read).length : 0; %>
                    <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center notif-badge <%= _unreadNotifCount > 0 ? '' : 'hidden' %>" aria-hidden="true">
                        <span class="notif-badge-count"><%= _unreadNotifCount > 99 ? '99+' : _unreadNotifCount %></span>
                    </span>
                    <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                        Notifications
                    </span>
                </button>

                <!-- User Profile Dropdown -->
                <div class="relative">
                    <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                        <div class="text-right hidden lg:block">
                            <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none"><%= user.role || 'Teacher' %></p>
                        </div>
                        <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100" onerror="this.src='/profile_uploads/default_avatar.png'">
                        <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                    </button>

                    <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                        <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                            <p class="text-sm font-bold text-slate-800"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role || 'Teacher' %></p>
                        </div>
                        <a href="/teacher/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                            <i class="far fa-user w-5 text-center"></i> View Profile
                        </a>
                        <hr class="my-2 border-slate-100">
                        <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                            <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- ===== SCROLLABLE BODY ===== -->
        <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
    
                <div class="p-4 md:p-8 flex-1 space-y-8">

                <!-- ============================================================
                     SUMMARY STATS STRIP
                ============================================================ -->
                <div class="grid grid-cols-2 sm:grid-cols-4 gap-4 mb-8">
                    <div class="bg-white rounded-2xl border border-slate-100 p-5 text-center shadow-sm">
                        <p class="text-3xl font-black text-indigo-700"><%= classes.length %></p>
                        <p class="text-xs font-semibold text-slate-400 mt-1">Total Classes</p>
                    </div>
                    <div class="bg-white rounded-2xl border border-slate-100 p-5 text-center shadow-sm">
                        <p class="text-3xl font-black text-cyan-600" id="totalStudentCount">
                            <%= classes.reduce(function(sum, c){ return sum + (c.student_count || 0); }, 0) %>
                        </p>
                        <p class="text-xs font-semibold text-slate-400 mt-1">Total Students</p>
                    </div>
                    <div class="bg-white rounded-2xl border border-slate-100 p-5 text-center shadow-sm">
                        <p class="text-3xl font-black text-emerald-600">
                            <%= (typeof currentSY !== 'undefined' && currentSY) ? currentSY.sy_range : (schoolYears.filter(function(sy){ return sy.status === 'Current' || sy.is_active; })[0]?.sy_range || 'N/A') %>
                        </p>
                        <p class="text-xs font-semibold text-slate-400 mt-1">Current School Year</p>
                    </div>
                    <div class="bg-white rounded-2xl border border-slate-100 p-5 text-center shadow-sm">
                        <p class="text-3xl font-black text-amber-500">
                            <%= [...new Set(classes.map(function(c){ return c.subject_name; }))].length %>
                        </p>
                        <p class="text-xs font-semibold text-slate-400 mt-1">Subjects Handled</p>
                    </div>
                </div>

                <!-- ============================================================
                     CLASSES LIST
                ============================================================ -->
                <div class="section-card">
                    <div class="section-header">
                        <div class="flex items-center gap-3">
                            <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-cyan-400 to-indigo-500 flex items-center justify-center shadow-md flex-shrink-0">
                                <i class="fas fa-chalkboard-user text-white text-sm"></i>
                            </div>
                            <div>
                                <h2 class="text-sm font-bold text-slate-800">All Classes</h2>
                                <p class="text-xs text-slate-400">Click a class to view the full student roster</p>
                            </div>
                        </div>
                        <!-- Filters -->
                        <div class="flex flex-wrap items-center gap-2">
                            <!-- SY filter buttons -->
                            <div class="flex gap-1 flex-wrap" id="syFilterGroup">
                                <button class="sy-btn active" data-sy="" onclick="filterClasses(this)">All Years</button>
                                <% schoolYears.forEach(function(sy){ %>
                                <button class="sy-btn <%= (sy.status === 'Current' || sy.is_active) ? 'active' : '' %>"
                                        data-sy="<%= sy.sy_id %>"
                                        onclick="filterClasses(this)">
                                    <%= sy.sy_range %><% if (sy.status === 'Current' || sy.is_active) { %> <span style="font-size:9px" class="text-emerald-500 font-bold">● Current</span><% } else if (sy.status === 'Draft') { %> <span style="font-size:8px" class="text-sky-500">(Draft)</span><% } else { %> <span style="font-size:8px" class="text-slate-400">(Archive)</span><% } %>
                                </button>
                                <% }); %>
                            </div>
                            <!-- Search -->
                            <div class="relative">
                                <i class="fas fa-magnifying-glass absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                <input type="text" id="classSearch" class="search-input" placeholder="Search class or subject…"
                                       oninput="filterClasses(null)">
                            </div>
                            <!-- Subject filter -->
                            <select class="filter-select" id="subjectFilter" onchange="filterClasses(null)">
                                <option value="">All Subjects</option>
                                <% [...new Set(classes.map(function(c){ return c.subject_name; }))].sort().forEach(function(sn){ %>
                                <option value="<%= sn %>"><%= sn %></option>
                                <% }); %>
                            </select>
                        </div>
                    </div>

                    <!-- Classes grid -->
                    <div class="p-5">
                        <% if (classes.length === 0) { %>
                        <div class="no-results">
                            <i class="fas fa-chalkboard text-slate-300"></i>
                            <p>No classes found.</p>
                        </div>
                        <% } %>

                        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4" id="classGrid">
                            <% classes.forEach(function(cls, idx){ %>
                            <%
                                var semLabel  = cls.semester == 1 ? '1st Sem' : '2nd Sem';
                                var progColor = '#06b6d4';
                                var avg       = cls.avg_progress || 0;
                                if (avg >= 80) progColor = '#10b981';
                                else if (avg >= 50) progColor = '#06b6d4';
                                else if (avg >= 25) progColor = '#f59e0b';
                                else progColor = '#ef4444';
                            %>
                            <div class="class-card fade-card"
                                 style="animation-delay: <%= idx * 40 %>ms"
                                 data-class-id="<%= cls.class_id %>"
                                 data-class-name="<%= cls.class_name.toLowerCase() %>"
                                 data-subject-name="<%= cls.subject_name %>"
                                 data-sy-id="<%= cls.sy_id %>"
                                 onclick="window.location.href='/teacher/class/<%= cls.class_id %>'">

                                <!-- Banner -->
                                <!-- Banner -->
                                <div class="class-card-banner">
                                    <% 
                                        // Siguraduhin na may value ang image, kung wala gamitin ang default
                                        var displayImg = (cls.subject_image && cls.subject_image !== 'default_subject.png') 
                                                        ? cls.subject_image 
                                                        : 'default_subject.png'; 
                                    %>
                                    
                                    <img src="/profile_uploads/<%= displayImg %>" 
                                        alt="<%= cls.subject_name %>"
                                        onerror="this.src='/profile_uploads/default_subject.png'"> <!-- Fallback kung sakaling broken ang link -->

                                    <div class="class-card-banner-overlay"></div>
                                    
                                    <!-- Overlay text -->
                                    <div style="position:absolute;bottom:8px;left:12px;right:12px;display:flex;justify-content:space-between;align-items:center">
                                        <p style="font-size:11px;font-weight:800;color:rgba(255,255,255,0.7);text-transform:uppercase;letter-spacing:.06em">
                                            <%= cls.sy_range %> · <%= semLabel %>
                                        </p>
                                        <% if (typeof currentSY !== 'undefined' && currentSY && cls.sy_id !== currentSY.sy_id) { %>
                                        <span class="text-[9px] font-black uppercase tracking-wider bg-slate-900/80 text-slate-300 border border-slate-600/50 px-1.5 py-0.5 rounded">
                                            Archive
                                        </span>
                                        <% } else if (cls.sy_is_active || (typeof currentSY !== 'undefined' && currentSY && cls.sy_id === currentSY.sy_id)) { %>
                                        <span class="text-[9px] font-black uppercase tracking-wider bg-emerald-500/80 text-white px-1.5 py-0.5 rounded">
                                            Current
                                        </span>
                                        <% } %>
                                    </div>
                                </div>

                                <!-- Body -->
                                <div class="class-card-body">
                                    <p class="font-black text-slate-800 text-sm leading-tight"><%= cls.class_name %></p>
                                    <p class="text-xs text-indigo-500 font-bold truncate"><%= cls.subject_name %></p>
                                    <p class="text-xs text-slate-400"><%= cls.subject_code || '' %></p>
                                    <!-- Progress strip -->
                                    <div class="mt-1">
                                        <div class="flex items-center justify-between mb-1">
                                            <span class="text-xs text-slate-400">Avg Progress</span>
                                            <span class="text-xs font-black" style="color:<%= progColor %>"><%= avg %>%</span>
                                        </div>
                                        <div class="prog-track">
                                            <div class="prog-fill" style="width:<%= avg %>%;background:<%= progColor %>"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Footer -->
                                <div class="class-card-footer">
                                    <div class="flex items-center gap-2">
                                        <i class="fas fa-users text-slate-400 text-xs"></i>
                                        <span class="text-xs font-bold text-slate-600"><%= cls.student_count || 0 %> students</span>
                                    </div>
