<!-- ================================================================
     SCRIPTS
================================================================ -->
<script>

/* ── Sidebar ── */
function toggleSidebar() {
    const sidebar = document.getElementById('sidebar');
    const overlay = document.getElementById('sidebarOverlay');
    const isOpen  = !sidebar.classList.contains('-translate-x-full');
    sidebar.classList.toggle('-translate-x-full', isOpen);
    overlay.classList.toggle('hidden', isOpen);
}

/* ── Toast ── */
function showToast(msg, type = 'success') {
    const el = document.getElementById('toast');
    el.textContent = msg;
    el.className = 'show ' + type;
    clearTimeout(el._t);
    el._t = setTimeout(() => { el.className = ''; }, 3000);
}

/* ── escHtml ── */
function escHtml(str) {
    return String(str || '–')
        .replace(/&/g,'&amp;').replace(/</g,'&lt;')
        .replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ── Active SY filter state ── */
let activeSyFilter = '';

/* ── Filter classes grid ── */
function filterClasses(syBtn) {
    if (syBtn) {
        document.querySelectorAll('#syFilterGroup .sy-btn').forEach(b => b.classList.remove('active'));
        syBtn.classList.add('active');
        activeSyFilter = syBtn.dataset.sy || '';
    }
    const query   = document.getElementById('classSearch').value.toLowerCase().trim();
    const subject = document.getElementById('subjectFilter').value;
    const cards   = document.querySelectorAll('#classGrid .class-card');
    let visible   = 0;

    cards.forEach(card => {
        const matchSy   = !activeSyFilter || card.dataset.syId === activeSyFilter;
        const matchName = !query   || card.dataset.className.includes(query) || card.dataset.subjectName.toLowerCase().includes(query);
        const matchSub  = !subject || card.dataset.subjectName === subject;
        const show = matchSy && matchName && matchSub;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });

    document.getElementById('noClassResults').classList.toggle('hidden', visible > 0);
}

/* ── Roster data (populated by JS fetch) ── */
let currentRosterStudents = [];

/* ── Open class roster (fetched from API) ── */
async function openRoster(classId, className, subjectName) {
    /* Scroll to roster */
    const section = document.getElementById('rosterSection');
    section.style.display = 'block';
    section.scrollIntoView({ behavior: 'smooth', block: 'start' });

    document.getElementById('rosterTitle').textContent    = className;
    document.getElementById('rosterSubtitle').textContent = subjectName;
    document.getElementById('rosterTableBody').innerHTML  =
        '<tr><td colspan="9" style="text-align:center;padding:40px;color:#94a3b8"><i class="fas fa-spinner fa-spin mr-2"></i>Loading students…</td></tr>';

    try {
        const res  = await fetch('/teacher/api/class-roster/' + classId);
        if (!res.ok) throw new Error('Server ' + res.status);
        const data = await res.json();
        currentRosterStudents = data.students || [];
        renderRosterTable(currentRosterStudents, classId);
        computeRosterStats(currentRosterStudents);
    } catch(err) {
        document.getElementById('rosterTableBody').innerHTML =
            `<tr><td colspan="9" style="text-align:center;padding:40px;color:#ef4444">Failed to load: ${escHtml(err.message)}</td></tr>`;
    }
}

/* ── Render roster table ── */
function renderRosterTable(students) {
    const tbody = document.getElementById('rosterTableBody');
    if (!students.length) {
        tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;padding:40px;color:#94a3b8">No students enrolled.</td></tr>';
        document.getElementById('rosterCount').textContent = '0 students';
        return;
    }

    tbody.innerHTML = students.map((s, i) => {
        const prog = parseInt(s.progress_percent) || 0;
        let pColor = '#ef4444';
        if (prog >= 80) pColor = '#10b981';
        else if (prog >= 50) pColor = '#06b6d4';
        else if (prog >= 25) pColor = '#f59e0b';

        const lastStr = s.last_accessed
            ? new Date(s.last_accessed).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})
            : 'Never';

        const totalExp = parseInt(s.total_exp) || 0;

        return `<tr style="transition:background .15s" onmouseover="this.style.background='#f0fdfa'" onmouseout="this.style.background=''">
            <td style="padding:10px 14px;border-bottom:1px solid #f1f5f9;color:#94a3b8;font-weight:700;font-size:11px">${i+1}</td>
            <td style="padding:10px 14px;border-bottom:1px solid #f1f5f9">
                <div style="display:flex;align-items:center;gap:9px">
                    <img src="/profile_uploads/${escHtml(s.profile_pic||'default_avatar.png')}"
                         style="width:30px;height:30px;border-radius:8px;object-fit:cover;border:1.5px solid #e0f2fe;flex-shrink:0"
                         onerror="this.src='/profile_uploads/default_avatar.png'">
                    <div>
                        <p style="font-weight:700;font-size:12px;color:#1e293b">${escHtml(s.last_name)}, ${escHtml(s.first_name)}${s.middle_name?' '+escHtml(s.middle_name.charAt(0))+'.':''}</p>
                        <p style="font-size:10px;color:#94a3b8">Lvl <strong style="color:#6366f1">${s.current_level||1}</strong></p>
                    </div>
                </div>
            </td>
            <td style="padding:10px 14px;border-bottom:1px solid #f1f5f9;font-family:monospace;font-size:11px;color:#94a3b8">${escHtml(s.lrn_number||'–')}</td>
            <td style="padding:10px 14px;border-bottom:1px solid #f1f5f9">
                <div style="font-size:11px;font-weight:700;color:#334155">${escHtml(s.grade_level||'–')}</div>
                <div style="font-size:10px;color:#94a3b8">${escHtml(s.section||'–')}</div>
            </td>
            <td style="padding:10px 14px;border-bottom:1px solid #f1f5f9;text-align:center">
                <span style="display:inline-flex;align-items:center;justify-content:center;width:28px;height:28px;border-radius:8px;background:#ede9fe;color:#5b21b6;font-size:12px;font-weight:800">${s.current_level||1}</span>
            </td>
            <td style="padding:10px 14px;border-bottom:1px solid #f1f5f9;text-align:center">
                <span class="exp-badge"><i class="fas fa-star" style="font-size:8px;color:#f59e0b"></i>${totalExp.toLocaleString()}</span>
            </td>
            <td style="padding:10px 14px;border-bottom:1px solid #f1f5f9;min-width:140px">
                <div style="display:flex;align-items:center;gap:6px">
                    <div class="prog-track" style="flex:1"><div class="prog-fill" style="width:${prog}%;background:${pColor}"></div></div>
                    <span style="font-size:11px;font-weight:800;color:${pColor};min-width:32px;text-align:right">${prog}%</span>
                </div>
            </td>
            <td style="padding:10px 14px;border-bottom:1px solid #f1f5f9;font-size:11px;color:#64748b;white-space:nowrap">${lastStr}</td>
            <td style="padding:10px 14px;border-bottom:1px solid #f1f5f9;text-align:center">
                <button onclick="openStudentModalByIndex(${i})"
                        style="width:28px;height:28px;border-radius:7px;border:1px solid #e2e8f0;background:white;cursor:pointer;transition:all .15s;color:#64748b;display:inline-flex;align-items:center;justify-content:center"
                        onmouseover="this.style.borderColor='#06b6d4';this.style.color='#0891b2'"
                        onmouseout="this.style.borderColor='#e2e8f0';this.style.color='#64748b'"
                        title="View full profile">
                    <i class="fas fa-eye" style="font-size:11px"></i>
                </button>
            </td>
        </tr>`;
    }).join('');

    _visibleRosterStudents = students;
    document.getElementById('rosterCount').textContent = `Showing ${students.length} student${students.length!==1?'s':''}`;
}

/* ── Compute roster stats ── */
function computeRosterStats(students) {
    const count = students.length;
    document.getElementById('rosterStudentCount').textContent = count;
    if (!count) {
        document.getElementById('rosterAvgProgress').textContent = '–';
        document.getElementById('rosterAvgExp').textContent      = '–';
        document.getElementById('rosterComplete').textContent    = '–';
        return;
    }
    const progs  = students.map(s => parseInt(s.progress_percent) || 0);
    const exps   = students.map(s => parseInt(s.total_exp)        || 0);
    const avgProg = Math.round(progs.reduce((a,b)=>a+b,0) / count);
    const avgExp  = Math.round(exps.reduce((a,b)=>a+b,0)  / count);
    const done    = progs.filter(p => p >= 100).length;
    document.getElementById('rosterAvgProgress').textContent = avgProg + '%';
    document.getElementById('rosterAvgExp').textContent      = avgExp.toLocaleString();
    document.getElementById('rosterComplete').textContent    = done;
}

/* ── Filter roster ── */
function filterRoster() {
    const query  = document.getElementById('rosterSearch').value.toLowerCase().trim();
    const sortBy = document.getElementById('rosterSortBy').value;
    let   list   = [...currentRosterStudents];

    if (query) {
        list = list.filter(s =>
            (s.first_name + ' ' + s.last_name).toLowerCase().includes(query) ||
            (s.lrn_number || '').includes(query) ||
            (s.section    || '').toLowerCase().includes(query)
        );
    }

    if      (sortBy === 'exp')      list.sort((a,b) => (parseInt(b.total_exp)||0)        - (parseInt(a.total_exp)||0));
    else if (sortBy === 'progress') list.sort((a,b) => (parseInt(b.progress_percent)||0) - (parseInt(a.progress_percent)||0));
    else if (sortBy === 'level')    list.sort((a,b) => (parseInt(b.current_level)||1)     - (parseInt(a.current_level)||1));
    else                            list.sort((a,b) => (a.last_name||'').localeCompare(b.last_name||''));

    renderRosterTable(list);
    computeRosterStats(list);
}

/* ── Close roster ── */
function closeRoster() {
    document.getElementById('rosterSection').style.display = 'none';
    currentRosterStudents = [];
}

/* ── Export roster CSV ── */
function exportRosterCSV() {
    const headers = ['#','Name','LRN','Grade','Section','Strand','Level','Total EXP','Progress %','Last Active'];
    const lines   = [headers.join(',')];
    currentRosterStudents.forEach((s, i) => {
        const name    = `${s.last_name}, ${s.first_name}`;
        const last    = s.last_accessed ? new Date(s.last_accessed).toLocaleDateString('en-PH') : 'Never';
        lines.push([
            i+1, `"${name}"`, s.lrn_number||'',
            s.grade_level||'', s.section||'', s.strand||'',
            s.current_level||1, parseInt(s.total_exp)||0,
            parseInt(s.progress_percent)||0, last
        ].join(','));
    });
    const blob = new Blob([lines.join('\n')], { type:'text/csv' });
    const url  = URL.createObjectURL(blob);
    const a    = document.createElement('a');
    a.href     = url;
    a.download = 'roster.csv';
    a.click();
    URL.revokeObjectURL(url);
}

/* ── Student modal ── */
function switchStudentTab(name, btn) {
    document.querySelectorAll('#studentModalTabs .student-tab').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.student-panel').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    document.getElementById('spanel-' + name).classList.add('active');
}

function closeStudentModal() {
    document.getElementById('studentModal').classList.remove('open');
}
document.getElementById('studentModal').addEventListener('click', function(e) {
    if (e.target === this) closeStudentModal();
});

function openStudentModalByIndex(idx) {
    const tbody = document.getElementById('rosterTableBody');
    // rows contain visible students; currentRosterStudents holds the sorted list
    openStudentModal(_visibleRosterStudents[idx]);
}

let _visibleRosterStudents = [];

function openStudentModal(student) {
    /* ── Populate profile tab ── */
    document.getElementById('sdAvatar').src        = '/profile_uploads/' + (student.profile_pic || 'default_avatar.png');
    document.getElementById('sdFullName').textContent = (student.last_name || '') + ', ' + (student.first_name || '') + (student.suffix ? ' ' + student.suffix : '');
    document.getElementById('sdMeta').textContent  = (student.grade_level || '') + ' · ' + (student.section || '') + ' · ' + (student.strand || '');
    document.getElementById('sdFirstName').textContent  = student.first_name  || '–';
    document.getElementById('sdLastName').textContent   = student.last_name   || '–';
    document.getElementById('sdMiddleName').textContent = student.middle_name || '–';
    document.getElementById('sdAltName').textContent    = student.alternative_name || '–';
    document.getElementById('sdSex').textContent        = student.sex       || '–';
    document.getElementById('sdBirthdate').textContent  = student.birthdate
        ? new Date(student.birthdate).toLocaleDateString('en-PH',{month:'long',day:'numeric',year:'numeric'}) : '–';
    document.getElementById('sdLRN').textContent        = student.lrn_number || '–';
    document.getElementById('sdGrade').textContent      = student.grade_level || '–';
    document.getElementById('sdSection').textContent    = student.section     || '–';
    document.getElementById('sdStrand').textContent     = student.strand      || '–';
    document.getElementById('sdEmail').textContent      = student.email       || '–';
    document.getElementById('sdMobile').textContent     = student.mobile_number || '–';
    document.getElementById('sdAddress').textContent    = student.home_address  || '–';
    document.getElementById('sdCity').textContent       = student.city_town     || '–';
    document.getElementById('sdAbout').textContent      = student.self_description || 'No description provided.';

    /* ── Populate academic tab ── */
    const prog = parseInt(student.progress_percent) || 0;
    let pColor = prog >= 80 ? '#10b981' : prog >= 50 ? '#06b6d4' : prog >= 25 ? '#f59e0b' : '#ef4444';
    document.getElementById('sdLevel').textContent        = student.current_level || 1;
    document.getElementById('sdTotalExp').textContent     = (parseInt(student.total_exp)||0).toLocaleString();
    document.getElementById('sdProgress').textContent     = prog + '%';
    document.getElementById('sdProgressFill').style.width = prog + '%';
    document.getElementById('sdProgressFill').style.background = pColor;
    document.getElementById('sdProgressLabel').textContent = prog + '% complete · last active: ' + (student.last_accessed
        ? new Date(student.last_accessed).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : 'Never');

    /* Leaderboard history */
    if (student.leaderboard_history && student.leaderboard_history.length) {
        document.getElementById('sdLeaderboard').innerHTML = student.leaderboard_history.map(h => `
            <div style="display:flex;justify-content:space-between;padding:6px 0;border-bottom:1px solid #f8fafc;font-size:12px">
                <span style="color:#334155;font-weight:600">Rank #${h.rank_achieved}</span>
                <div style="display:flex;gap:8px">
                    <span style="color:#64748b">${new Date(h.awarded_date).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'})}</span>
                    <span class="exp-badge" style="font-size:10px;padding:1px 7px"><i class="fas fa-star" style="font-size:8px;color:#f59e0b"></i>${(h.total_exp_snapshot||0).toLocaleString()}</span>
                </div>
            </div>`).join('');
    } else {
        document.getElementById('sdLeaderboard').innerHTML = '<p class="text-xs text-slate-400 italic">No rank history yet.</p>';
    }

    /* ── Populate scores tab ── */
    if (student.scores && student.scores.length) {
        document.getElementById('sdScoresList').innerHTML = student.scores.map(sc => {
            const pct = Math.round((sc.score_obtained / sc.total_items) * 100);
            let bColor = pct >= 75 ? '#10b981' : pct >= 50 ? '#06b6d4' : pct >= 25 ? '#f59e0b' : '#ef4444';
            const tClass = sc.assessment_type === 'Pre-Test' ? 'atype-pre'
                         : sc.assessment_type === 'Post-Test' ? 'atype-post'
                         : sc.assessment_type === 'Quiz' ? 'atype-quiz' : 'atype-comp';
            const dateStr = sc.date_recorded ? new Date(sc.date_recorded).toLocaleDateString('en-PH',{month:'short',day:'numeric',year:'numeric'}) : '–';
            return `
            <div class="score-row">
                <div style="flex:1;min-width:0">
                    <p style="font-size:12px;font-weight:700;color:#334155;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:220px">${escHtml(sc.assessment_name)}</p>
                    <div style="display:flex;gap:5px;margin-top:2px;flex-wrap:wrap">
                        <span class="badge-type ${tClass}">${sc.assessment_type}</span>
                        <span style="font-size:10px;color:#94a3b8">${dateStr}</span>
                    </div>
                </div>
                <div style="text-align:right;flex-shrink:0">
                    <div class="resp-bar-wrap" style="justify-content:flex-end">
                        <div class="resp-bar-track" style="width:60px"><div class="resp-bar-fill" style="width:${pct}%;background:${bColor}"></div></div>
                        <span style="font-size:12px;font-weight:800;color:${bColor};min-width:42px">${sc.score_obtained}/${sc.total_items}</span>
                    </div>
                    <span class="exp-badge" style="font-size:10px;padding:1px 7px;margin-top:3px;display:inline-flex"><i class="fas fa-star" style="font-size:8px;color:#f59e0b"></i>+${sc.exp_gained}</span>
                </div>
            </div>`;
        }).join('');
    } else {
        document.getElementById('sdScoresList').innerHTML = '<p class="text-xs text-slate-400 italic">No scores recorded yet.</p>';
    }

    /* Reset to first tab */
    switchStudentTab('profile', document.querySelector('#studentModalTabs .student-tab'));
    document.getElementById('studentModal').classList.add('open');
}

