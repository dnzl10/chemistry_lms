                                        <button onclick="openRoster('<%= cls.class_id %>', '<%= cls.class_name.replace(/['"]/g, '') %>', '<%= cls.subject_name.replace(/['"]/g, '') %>')"
                                                class="chip chip-teal text-xs"
                                                title="View inline roster">
