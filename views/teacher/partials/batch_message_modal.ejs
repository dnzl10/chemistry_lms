<!-- Smart Batch Actions: Message Students Who... Modal -->
<div id="batchActionModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[99999] hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-xl w-full shadow-2xl overflow-hidden border border-slate-200 animate-in fade-in zoom-in-95 duration-200">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-indigo-50/50">
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-black text-base">⚡</span>
                <div>
                    <h3 class="font-black text-slate-900 text-base">Smart Batch Actions</h3>
                    <p class="text-[11px] text-slate-500 font-medium">Bulk communication & mass-grading by real-time submission status</p>
                </div>
            </div>
            <button onclick="closeBatchActionModal()" class="text-slate-400 hover:text-slate-600 font-bold p-1">&times;</button>
        </div>

        <div class="p-6 space-y-4 text-xs">
            <!-- Filter Selector -->
            <div>
                <label class="font-bold text-slate-700 block mb-1">Target Student Cohort ("Message Students Who...")</label>
                <select id="batchConditionSelect" onchange="fetchBatchTargetCount()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                    <option value="unsubmitted">Haven't submitted yet (Missing)</option>
                    <option value="below_cutoff">Scored below passing cutoff (< 75%)</option>
                    <option value="grace_period">Submitted during grace period window</option>
                    <option value="all">All enrolled students in section</option>
                </select>
            </div>

            <!-- Recipient Counter Pill -->
            <div class="p-3 bg-indigo-50/60 rounded-2xl border border-indigo-100 flex items-center justify-between">
                <div class="flex items-center gap-2">
                    <i class="fas fa-users text-indigo-600"></i>
                    <span class="font-bold text-slate-700">Matching Students:</span>
                </div>
                <span id="batchRecipientCount" class="font-black text-indigo-700 bg-white px-3 py-1 rounded-full border border-indigo-200 shadow-sm">
                    Calculating...
                </span>
            </div>

            <!-- Action Tabs -->
            <div class="flex border-b border-slate-200 gap-4">
                <button id="tabMsgBtn" onclick="switchBatchTab('message')" class="pb-2 font-black text-indigo-600 border-b-2 border-indigo-600">Send Bulk Message</button>
                <button id="tabScoreBtn" onclick="switchBatchTab('score')" class="pb-2 font-bold text-slate-400 hover:text-slate-600">Bulk Assign Score: 0</button>
            </div>

            <!-- Tab 1: Send Bulk Message -->
            <div id="batchMessageTab" class="space-y-3">
                <div>
                    <label class="font-bold text-slate-500 block mb-1">Message Subject / Title</label>
                    <input type="text" id="batchMsgSubject" placeholder="e.g. Urgent: Chemistry Lab Report Deadline" class="w-full px-3 py-2 border border-slate-200 rounded-xl font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                </div>
                <div>
                    <label class="font-bold text-slate-500 block mb-1">Message Content</label>
                    <textarea id="batchMsgBody" rows="3" placeholder="Type your reminder or announcement message..." class="w-full px-3 py-2 border border-slate-200 rounded-xl text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
                </div>
                <button onclick="dispatchBatchMessage()" id="sendBatchMsgBtn" class="w-full py-2.5 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl font-black shadow-lg shadow-indigo-200 transition flex items-center justify-center gap-2">
                    <i class="fas fa-paper-plane"></i>
                    <span>Dispatch Targeted Batch Message</span>
                </button>
            </div>

            <!-- Tab 2: Bulk Assign Zero -->
            <div id="batchScoreTab" class="space-y-3 hidden">
                <div class="p-3 bg-amber-50 rounded-2xl border border-amber-200 text-amber-800">
                    <p class="font-bold flex items-center gap-1.5"><i class="fas fa-exclamation-triangle"></i> Batch Zero Confirmation</p>
                    <p class="text-[11px] mt-1">This action will automatically assign a Score of <strong>0</strong> to all students who have not submitted their assessment, with default feedback note: <em>"Missing submission past deadline."</em></p>
                </div>
                <button onclick="executeBatchZero()" id="executeBatchZeroBtn" class="w-full py-2.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl font-black shadow-lg shadow-rose-200 transition flex items-center justify-center gap-2">
                    <i class="fas fa-gavel"></i>
                    <span>Confirm & Execute Bulk Score: 0</span>
                </button>
            </div>
        </div>

        <div class="p-4 bg-slate-50 border-t border-slate-100 flex justify-end">
            <button onclick="closeBatchActionModal()" class="px-5 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded-xl text-xs transition">
                Close
            </button>
        </div>
    </div>
</div>

<script>
    let currentBatchAssessmentId = null;

    function openBatchActionModal(assessmentId) {
        currentBatchAssessmentId = assessmentId;
        document.getElementById('batchActionModal').classList.remove('hidden');
        fetchBatchTargetCount();
    }

    function closeBatchActionModal() {
        document.getElementById('batchActionModal').classList.add('hidden');
    }

    function switchBatchTab(tab) {
        if (tab === 'message') {
            document.getElementById('batchMessageTab').classList.remove('hidden');
            document.getElementById('batchScoreTab').classList.add('hidden');
            document.getElementById('tabMsgBtn').className = 'pb-2 font-black text-indigo-600 border-b-2 border-indigo-600';
            document.getElementById('tabScoreBtn').className = 'pb-2 font-bold text-slate-400 hover:text-slate-600';
        } else {
            document.getElementById('batchMessageTab').classList.add('hidden');
            document.getElementById('batchScoreTab').classList.remove('hidden');
            document.getElementById('tabMsgBtn').className = 'pb-2 font-bold text-slate-400 hover:text-slate-600';
            document.getElementById('tabScoreBtn').className = 'pb-2 font-black text-rose-600 border-b-2 border-rose-600';
        }
    }

    async function fetchBatchTargetCount() {
        if (!currentBatchAssessmentId) return;
        const condition = document.getElementById('batchConditionSelect').value;
        const countEl = document.getElementById('batchRecipientCount');
        countEl.textContent = 'Counting...';

        try {
            const res = await fetch(`/teacher/api/assessment/${currentBatchAssessmentId}/students-filter?status=${condition}`);
            if (res.ok) {
                const data = await res.json();
                countEl.textContent = `${data.count} student(s)`;
            } else {
                countEl.textContent = '0 students';
            }
        } catch (e) {
            countEl.textContent = '0 students';
        }
    }

    async function dispatchBatchMessage() {
        const subject = document.getElementById('batchMsgSubject').value.trim();
        const body = document.getElementById('batchMsgBody').value.trim();
        const condition = document.getElementById('batchConditionSelect').value;

        if (!subject || !body) {
            alert('Please fill out both subject and message body.');
            return;
        }

        const btn = document.getElementById('sendBatchMsgBtn');
        btn.disabled = true;
        btn.textContent = 'Dispatching...';

        try {
            const res = await fetch(`/teacher/api/assessment/${currentBatchAssessmentId}/batch-message`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ condition, subject, body })
            });
            const result = await res.json();
            if (res.ok) {
                alert(`Successfully dispatched message to ${result.dispatchedCount} student(s)!`);
                closeBatchActionModal();
            } else {
                alert(result.error || 'Failed to dispatch batch message.');
            }
        } catch (e) {
            alert('Server error during dispatch.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-paper-plane mr-1"></i> Dispatch Targeted Batch Message';
        }
    }

    async function executeBatchZero() {
        if (!confirm('Are you absolutely sure you want to assign Score 0 to all unsubmitted students for this assessment?')) return;

        const btn = document.getElementById('executeBatchZeroBtn');
        btn.disabled = true;
        btn.textContent = 'Applying Scores...';

        try {
            const res = await fetch(`/teacher/api/assessment/${currentBatchAssessmentId}/batch-zero`, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' }
            });
            const result = await res.json();
            if (res.ok) {
                alert(`Successfully recorded Score 0 for ${result.affectedCount} unsubmitted student(s)!`);
                closeBatchActionModal();
                window.location.reload();
            } else {
                alert(result.error || 'Failed to apply bulk zero scores.');
            }
        } catch (e) {
            alert('Server error executing bulk scores.');
        } finally {
            btn.disabled = false;
            btn.innerHTML = '<i class="fas fa-gavel mr-1"></i> Confirm & Execute Bulk Score: 0';
        }
    }
</script>
