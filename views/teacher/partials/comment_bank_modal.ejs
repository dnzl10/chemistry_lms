<!-- Reusable Comment Bank Snippets Manager Modal -->
<div id="commentBankModal" class="fixed inset-0 bg-slate-900/60 backdrop-blur-sm z-[99999] hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-3xl max-w-2xl w-full shadow-2xl overflow-hidden border border-slate-200 animate-in fade-in zoom-in-95 duration-200">
        <div class="p-5 border-b border-slate-100 flex items-center justify-between bg-indigo-50/50">
            <div class="flex items-center gap-3">
                <span class="w-10 h-10 rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-black text-base">💬</span>
                <div>
                    <h3 class="font-black text-slate-900 text-base">Reusable Comment Bank & Snippets</h3>
                    <p class="text-[11px] text-slate-500 font-medium">Type <code class="px-1.5 py-0.5 bg-indigo-100 text-indigo-700 rounded font-bold">/shortcut</code> in feedback boxes to expand instantly</p>
                </div>
            </div>
            <button onclick="closeCommentBankModal()" class="text-slate-400 hover:text-slate-600 font-bold p-1">&times;</button>
        </div>

        <div class="p-6 space-y-5">
            <!-- Add New Snippet Form -->
            <form id="addSnippetForm" onsubmit="saveNewSnippet(event)" class="p-4 bg-slate-50 rounded-2xl border border-slate-100 space-y-3">
                <h4 class="text-xs font-black text-slate-800 uppercase tracking-wider">Create New Snippet</h4>
                <div class="grid grid-cols-3 gap-3">
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 block mb-1">Slash Shortcut</label>
                        <div class="relative">
                            <span class="absolute inset-y-0 left-0 pl-2.5 flex items-center font-bold text-indigo-600 text-xs">/</span>
                            <input type="text" id="newSnippetShortcut" placeholder="e.g. cite" required class="w-full pl-6 pr-3 py-1.5 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500" />
                        </div>
                    </div>
                    <div>
                        <label class="text-[10px] font-bold text-slate-500 block mb-1">Category</label>
                        <select id="newSnippetCategory" class="w-full px-3 py-1.5 bg-white border border-slate-200 rounded-xl text-xs font-bold text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500">
                            <option value="General">General</option>
                            <option value="Formatting">Formatting</option>
                            <option value="Accuracy">Accuracy</option>
                            <option value="Content">Content</option>
                        </select>
                    </div>
                    <div class="flex items-end">
                        <button type="submit" class="w-full py-2 bg-indigo-600 hover:bg-indigo-700 text-white rounded-xl text-xs font-black shadow-md shadow-indigo-200 transition">
                            Save Shortcut
                        </button>
                    </div>
                </div>
                <div>
                    <label class="text-[10px] font-bold text-slate-500 block mb-1">Expanded Text</label>
                    <textarea id="newSnippetText" rows="2" placeholder="Full feedback text that replaces the shortcut..." required class="w-full px-3 py-2 bg-white border border-slate-200 rounded-xl text-xs text-slate-800 focus:outline-none focus:ring-2 focus:ring-indigo-500 resize-none"></textarea>
                </div>
            </form>

            <!-- Snippets List -->
            <div class="space-y-2">
                <div class="flex items-center justify-between text-xs font-bold text-slate-500">
                    <span>Active Snippets Library</span>
                    <span id="snippetCount" class="text-[10px] bg-slate-100 px-2 py-0.5 rounded-full">0 snippets</span>
                </div>
                <div id="snippetListContainer" class="max-h-60 overflow-y-auto space-y-2 pr-1">
                    <!-- Snippet items rendered by JS -->
                </div>
            </div>
        </div>

        <div class="p-4 bg-slate-50 border-t border-slate-100 flex justify-end">
            <button onclick="closeCommentBankModal()" class="px-5 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded-xl text-xs transition">
                Close
            </button>
        </div>
    </div>
</div>

<script>
    function openCommentBankModal() {
        document.getElementById('commentBankModal').classList.remove('hidden');
        loadCommentBankSnippets();
    }

    function closeCommentBankModal() {
        document.getElementById('commentBankModal').classList.add('hidden');
    }

    async function loadCommentBankSnippets() {
        try {
            const res = await fetch('/teacher/api/comment-bank');
            if (res.ok) {
                const data = await res.json();
                renderSnippetList(data.snippets || []);
            }
        } catch (e) {
            console.error('Error loading snippets:', e);
        }
    }

    function renderSnippetList(snippets) {
        const container = document.getElementById('snippetListContainer');
        document.getElementById('snippetCount').textContent = `${snippets.length} snippets`;

        if (snippets.length === 0) {
            container.innerHTML = `<p class="text-xs text-slate-400 text-center py-4">No snippets found. Create your first shortcut above!</p>`;
            return;
        }

        container.innerHTML = snippets.map(s => `
            <div class="p-3 bg-white rounded-xl border border-slate-100 shadow-sm flex items-start justify-between gap-3 hover:border-slate-300 transition">
                <div class="flex-1">
                    <div class="flex items-center gap-2 mb-1">
                        <span class="font-mono font-black text-indigo-700 text-xs px-2 py-0.5 bg-indigo-50 rounded-lg">/${s.shortcut}</span>
                        <span class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">${s.category || 'General'}</span>
                        ${s.teacher_id === null ? '<span class="text-[9px] font-black bg-emerald-100 text-emerald-700 px-1.5 py-0.5 rounded-full">Campus Default</span>' : ''}
                    </div>
                    <p class="text-xs text-slate-700 leading-relaxed">${s.expanded_text}</p>
                </div>
                ${s.teacher_id !== null ? `
                    <button onclick="deleteSnippet(${s.snippet_id})" class="text-rose-400 hover:text-rose-600 text-xs font-bold p-1 transition" title="Delete Snippet">
                        <i class="fas fa-trash-alt"></i>
                    </button>
                ` : ''}
            </div>
        `).join('');
    }

    async function saveNewSnippet(e) {
        e.preventDefault();
        const shortcut = document.getElementById('newSnippetShortcut').value.trim().replace(/^\//, '');
        const category = document.getElementById('newSnippetCategory').value;
        const expanded_text = document.getElementById('newSnippetText').value.trim();

        if (!shortcut || !expanded_text) return;

        try {
            const res = await fetch('/teacher/api/comment-bank', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ shortcut, category, expanded_text })
            });
            if (res.ok) {
                document.getElementById('addSnippetForm').reset();
                loadCommentBankSnippets();
                if (window.refreshSnippetsCache) window.refreshSnippetsCache();
            } else {
                const err = await res.json();
                alert(err.error || 'Failed to save snippet.');
            }
        } catch (e) {
            console.error('Error saving snippet:', e);
        }
    }

    async function deleteSnippet(id) {
        if (!confirm('Are you sure you want to delete this shortcut?')) return;
        try {
            const res = await fetch(`/teacher/api/comment-bank/${id}`, { method: 'DELETE' });
            if (res.ok) {
                loadCommentBankSnippets();
                if (window.refreshSnippetsCache) window.refreshSnippetsCache();
            }
        } catch (e) {
            console.error('Error deleting snippet:', e);
        }
    }
</script>
