function markDirty() { state.isDirty = true; }

function toast(msg, type='info', duration=3500) {
  const el = document.createElement('div');
  el.className = `toast ${type}`;
  el.textContent = msg;
  $('toast-container').appendChild(el);
  setTimeout(() => el.remove(), duration);
}

function showModal(id) { $(id).classList.add('show'); }
function hideModal(id) { $(id).classList.remove('show'); }

function autoResize(el) {
  el.style.height = 'auto';
  el.style.height = el.scrollHeight + 'px';
}

function toSubscript(n) {
  if (n <= 1) return '';
  return String(n).split('').map(d => '₀₁₂₃₄₅₆₇₈₉'[parseInt(d)]).join('');
}

function modeBadgeClass(mode) {
  return { Standard:'std', Periodic_Single:'psgl', Periodic_Sequence:'pseq', Numeric:'num' }[mode] || 'std';
}
function modeBadgeText(mode) {
  return { Standard:'STD', Periodic_Single:'P.SGL', Periodic_Sequence:'P.SEQ', Numeric:'NUM' }[mode] || 'STD';
}

function activeQ() { return state.questions[state.activeSlideIndex] || null; }

// ── INIT TOP BAR ─────────────────────────────────────────────
function initTopBar() {
  const a = state.assessment;
  inpName.value     = a.assessment_name || '';
  selType.value     = a.assessment_type || 'Quiz';
  inpTotal.value    = a.total_items || '';
  inpDuration.value = a.duration_minutes || 30;
  selTimer.value    = a.timer_type || 'Global';
  chkUnlocked.checked = !!a.is_unlocked;
  lockLabel.textContent = a.is_unlocked ? 'Unlocked' : 'Locked';
  lockLabel.style.color = a.is_unlocked ? 'var(--success)' : 'var(--text-muted)';
  if (a.due_date) {
    const d = new Date(a.due_date);
    const local = new Date(d.getTime() - d.getTimezoneOffset()*60000).toISOString().slice(0,16);
    inpDuedate.value = local;
  }
  updateTimerVisibility();
}

function updateTimerVisibility() {
  const isPerItem = selTimer.value === 'PerItem';
  durationField.style.display = isPerItem ? 'none' : 'flex';
  propTLGroup.style.display   = isPerItem ? 'flex' : 'none';
}

// top bar events
inpName.addEventListener('input', () => { state.assessment.assessment_name = inpName.value; markDirty(); });
selType.addEventListener('change', () => { state.assessment.assessment_type = selType.value; markDirty(); });
inpTotal.addEventListener('input', () => { state.assessment.total_items = parseInt(inpTotal.value)||0; markDirty(); updateSlideCounter(); });
inpDuration.addEventListener('input', () => { state.assessment.duration_minutes = parseInt(inpDuration.value)||30; markDirty(); });
selTimer.addEventListener('change', () => { state.assessment.timer_type = selTimer.value; updateTimerVisibility(); markDirty(); });
chkUnlocked.addEventListener('change', () => {
  state.assessment.is_unlocked = chkUnlocked.checked ? 1 : 0;
  lockLabel.textContent = chkUnlocked.checked ? 'Unlocked' : 'Locked';
  lockLabel.style.color = chkUnlocked.checked ? 'var(--success)' : 'var(--text-muted)';
  markDirty();
});
inpDuedate.addEventListener('change', () => { state.assessment.due_date = inpDuedate.value || null; markDirty(); });

// ── SLIDE COUNTER ────────────────────────────────────────────
function updateSlideCounter() {
  const total = parseInt(state.assessment.total_items) || 0;
  const count = state.questions.length;
  if (count === 0) {
    slideCounter.textContent = '0 questions';
    slideCounter.className = '';
    return;
  }
  if (count < total) {
    slideCounter.textContent = `${count} questions | Total: ${total} (${total-count} from pool)`;
    slideCounter.className = 'ok';
  } else if (count === total) {
    slideCounter.textContent = `${count} questions | Total: ${total} ✓`;
    slideCounter.className = 'ok';
  } else {
    slideCounter.textContent = `${count} questions | Total: ${total} ⚠ Too many`;
    slideCounter.className = 'err';
  }
}

// ── SLIDE LIST RENDERING ─────────────────────────────────────
function renderSlideList() {
  // clear cards (keep empty state node)
  const cards = slideList.querySelectorAll('.slide-card-wrap');
  cards.forEach(c => c.remove());

  if (state.questions.length === 0) {
    slideEmpty.style.display = 'flex';
    updateSlideCounter();
    return;
  }
  slideEmpty.style.display = 'none';

  state.questions.forEach((q, idx) => {
    const wrap = document.createElement('div');
    wrap.className = 'slide-card-wrap';
    wrap.dataset.index = idx;

    const card = document.createElement('div');
    card.className = 'slide-card' + (idx === state.activeSlideIndex ? ' active' : '');
    card.dataset.index = idx;

    const mode = q.input_mode || 'Standard';
    const preview = (q.question_text || '').trim();
    const bgColor = BG_COLORS[parseInt((q.selected_bg_key||'').slice(-1)-1)||0] || BG_COLORS[0];

    card.innerHTML = `
      <div class="drag-handle" draggable="true">
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="3" y1="8" x2="21" y2="8"/><line x1="3" y1="16" x2="21" y2="16"/></svg>
      </div>
      <div class="slide-num">Q${idx+1}</div>
      <div class="slide-info">
        <div class="slide-preview ${!preview ? 'empty-q' : ''}">${preview ? preview.slice(0,35)+(preview.length>35?'…':'') : 'New Question'}</div>
        <div class="slide-meta">
          <span class="mode-badge ${modeBadgeClass(mode)}">${modeBadgeText(mode)}</span>
          <span class="bg-dot" style="background:${bgColor};"></span>
        </div>
      </div>
      <button class="slide-del-btn" title="Delete question">
        <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14H6L5 6"/><path d="M10 11v6M14 11v6"/><path d="M9 6V4h6v2"/></svg>
      </button>
    `;

    // delete confirm
    const delConfirm = document.createElement('div');
    delConfirm.className = 'del-confirm';
    delConfirm.innerHTML = `
      <p>Delete Question Q${idx+1}? This cannot be undone.</p>
      <div class="del-confirm-btns">
        <button class="btn-del-cancel">Cancel</button>
        <button class="btn-del-confirm">Delete</button>
      </div>
    `;

    wrap.appendChild(card);
    wrap.appendChild(delConfirm);
    slideList.appendChild(wrap);

    // card click → activate
    card.addEventListener('click', (e) => {
      if (e.target.closest('.slide-del-btn')) return;
      activateSlide(idx);
    });

    // delete btn
    card.querySelector('.slide-del-btn').addEventListener('click', (e) => {
      e.stopPropagation();
      // close all other confirms
      document.querySelectorAll('.del-confirm.show').forEach(el => el.classList.remove('show'));
      delConfirm.classList.toggle('show');
    });
    delConfirm.querySelector('.btn-del-cancel').addEventListener('click', () => {
      delConfirm.classList.remove('show');
    });
    delConfirm.querySelector('.btn-del-confirm').addEventListener('click', () => {
      deleteSlide(idx);
    });

    // drag to reorder
    initDrag(card, idx);
  });

  updateSlideCounter();
}

// ── DRAG TO REORDER ──────────────────────────────────────────
let dragSrcIdx = null;

function initDrag(card, idx) {
  const handle = card.querySelector('.drag-handle');
  handle.addEventListener('mousedown', () => { card.setAttribute('draggable','true'); });

  card.addEventListener('dragstart', (e) => {
    dragSrcIdx = idx;
    card.classList.add('drag-ghost');
    e.dataTransfer.effectAllowed = 'move';
  });
  card.addEventListener('dragend', () => {
    card.classList.remove('drag-ghost');
    card.setAttribute('draggable','false');
    dragSrcIdx = null;
  });
  card.addEventListener('dragover', (e) => {
    e.preventDefault();
    e.dataTransfer.dropEffect = 'move';
  });
  card.addEventListener('drop', (e) => {
    e.preventDefault();
    if (dragSrcIdx === null || dragSrcIdx === idx) return;
    const moved = state.questions.splice(dragSrcIdx, 1)[0];
    state.questions.splice(idx, 0, moved);
    state.questions.forEach((q, i) => { q.sort_order = i + 1; });
    // update activeSlideIndex to follow the moved item if needed
    if (state.activeSlideIndex === dragSrcIdx) state.activeSlideIndex = idx;
    else if (dragSrcIdx < state.activeSlideIndex && idx >= state.activeSlideIndex) state.activeSlideIndex--;
    else if (dragSrcIdx > state.activeSlideIndex && idx <= state.activeSlideIndex) state.activeSlideIndex++;
    markDirty();
    renderSlideList();
    renderMainContent();
    renderRightPanel();
  });
}

// ── ADD QUESTION ─────────────────────────────────────────────
$('btn-add-q').addEventListener('click', () => {
  const themeId = state.topic.theme_id || 'default_lab';
  const firstBg = THEME_BACKGROUNDS[themeId]?.bgs[0] || null;
  const newQ = {
    aq_id: null, question_id: null,
    sort_order: state.questions.length + 1,
    selected_bg_key: firstBg,
    question_text: '', instruction_override: '',
    media_path: null, media_type: null,
    input_mode: 'Standard', difficulty: 'Easy',
    mechanic_type: 'standard_mcq',
    base_exp: 100, points: 1, time_limit: 10,
    is_multiple_answer: 0, required_answers_count: 1,
    option_a: '', option_a_image: null,
    option_b: '', option_b_image: null,
    option_c: '', option_c_image: null,
    option_d: '', option_d_image: null,
    correct_answer: null,
    numeric_answer: null, numeric_tolerance: 0,
    is_ai_generated: 0,
    answer_sequences: []
  };
  state.questions.push(newQ);
  state.activeSlideIndex = state.questions.length - 1;
  markDirty();
  renderSlideList();
  renderMainContent();
  renderRightPanel();
});

// ── DELETE SLIDE ─────────────────────────────────────────────
function deleteSlide(idx) {
  const q = state.questions[idx];
  if (q.question_id) state.deletedQuestionIds.push(q.question_id);
  state.questions.splice(idx, 1);
  state.questions.forEach((q, i) => { q.sort_order = i + 1; });
  if (state.questions.length === 0) {
    state.activeSlideIndex = -1;
  } else {
    state.activeSlideIndex = Math.min(idx, state.questions.length - 1);
  }
  markDirty();
  renderSlideList();
  renderMainContent();
  renderRightPanel();
}

// ── ACTIVATE SLIDE ───────────────────────────────────────────
function activateSlide(idx) {
  state.activeSlideIndex = idx;
  renderSlideList();
  renderMainContent();
  renderRightPanel();
}

// ── RENDER MAIN CONTENT ──────────────────────────────────────
function renderMainContent() {
  const q = activeQ();
  if (!q) {
    mainEmpty.style.display = 'flex';
    mainContent.style.display = 'none';
    return;
  }
  mainEmpty.style.display = 'none';
  mainContent.style.display = 'flex';

  // background
  const themeId = state.topic.theme_id || 'default_lab';
  const bgKey   = q.selected_bg_key || THEME_BACKGROUNDS[themeId]?.bgs[0];
  $('main-tab').style.backgroundImage = bgKey ? `url('${bgImageUrl(bgKey)}')` : 'none';

  // position label
  qPositionLbl.textContent = `Question ${state.activeSlideIndex + 1} of ${state.assessment.total_items || '?'}`;

  // mode badge
  const mode = q.input_mode || 'Standard';
  qModeBadge.className = `mode-badge ${modeBadgeClass(mode)}`;
  qModeBadge.textContent = modeBadgeText(mode);

  // question text
  inpQText.value = q.question_text || '';
  autoResize(inpQText);

  // instruction
  inpInstruct.value = q.instruction_override || '';
  autoResize(inpInstruct);
  updateInstructionMeta(mode);

  // media
  renderMediaPreview(q);

  // answer area
  renderAnswerArea(q);
}

function updateInstructionMeta(mode) {
  const always = ['Periodic_Sequence','Numeric'].includes(mode);
  instrOptTag.style.display     = always ? 'none'   : 'inline';
  instrRecTag.style.display     = always ? 'inline' : 'none';
  instrInfo.style.display       = always ? 'block'  : 'none';
  inpInstruct.placeholder       = always
    ? 'Leave blank to use the default button-remapping instruction...'
    : 'Leave blank to skip the instruction screen for this question...';
}

// ── RENDER MEDIA ─────────────────────────────────────────────
function renderMediaPreview(q) {
  if (q.media_path) {
    mediaZone.style.display = 'none';
    mediaPreview.style.display = 'block';
    if (q.media_type === 'image') {
      mediaImg.src = q.media_path;
      mediaImg.style.display = 'block';
      mediaVid.style.display = 'none';
    } else {
      mediaVid.src = q.media_path;
      mediaVid.style.display = 'block';
      mediaImg.style.display = 'none';
    }
  } else {
    mediaZone.style.display = 'block';
    mediaPreview.style.display = 'none';
    mediaImg.src = '';
    mediaVid.src = '';
  }
}

// ── RENDER ANSWER AREA ───────────────────────────────────────
function renderAnswerArea(q) {
  const mode = q.input_mode || 'Standard';
  answerArea.innerHTML = '';

  if (mode === 'Standard') renderStandard(q);
  else if (mode === 'Periodic_Single') renderPeriodicSingle(q);
  else if (mode === 'Periodic_Sequence') renderPeriodicSequence(q);
  else if (mode === 'Numeric') renderNumeric(q);
}

// Standard mode
function renderStandard(q) {
  const isMulti = !!q.is_multiple_answer;
  const correctRaw = q.correct_answer || '';
  const correctSet = new Set(correctRaw.split(',').map(s=>s.trim()).filter(Boolean));

  const html = `
    <div class="multi-answer-row">
      <label>
        <label class="toggle-switch" style="width:32px;height:18px;">
          <input type="checkbox" id="chk-multi" ${isMulti ? 'checked' : ''} />
          <span class="toggle-track"></span>
        </label>
        Multiple Correct Answers
      </label>
      <div id="req-count-row" style="display:${isMulti?'flex':'none'}">
        &nbsp;Requires exactly&nbsp;
        <input type="number" id="inp-req-count" min="2" value="${q.required_answers_count||2}" />
        &nbsp;correct
      </div>
    </div>
    <div class="choices-grid">
      ${['A','B','C','D'].map(letter => {
        const key = letter.toLowerCase();
        const text  = q[`option_${key}`]   || '';
        const image = q[`option_${key}_image`] || null;
        const isSelected = correctSet.has(letter);
        return `
        <div class="choice-card ${isSelected ? 'selected' : ''}" data-letter="${letter}">
          <div class="choice-card-top">
            <div class="choice-letter">${letter}</div>
            <input type="${isMulti ? 'checkbox' : 'radio'}"
                   name="correct_answer"
                   class="choice-selector"
                   data-letter="${letter}"
                   ${isSelected ? 'checked' : ''} />
            <input type="text"
                   class="choice-text-input"
                   data-letter="${letter}"
                   placeholder="Choice ${letter}..."
                   value="${text.replace(/"/g,'&quot;')}" />
          </div>
          <div class="choice-img-area">
            <div class="choice-img-placeholder" data-letter="${letter}" ${image?'style="display:none;"':''}>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="18" height="18" rx="2"/><circle cx="8.5" cy="8.5" r="1.5"/><polyline points="21 15 16 10 5 21"/></svg>
              Add image (optional)
            </div>
            <div class="choice-img-preview" ${image?'style="display:block;"':''}>
              ${image ? `<img src="${image}" alt="Choice ${letter}" />` : ''}
            </div>
            ${image ? `<button class="btn-remove-choice-img" data-letter="${letter}">✕</button>` : ''}
            <input type="file" class="choice-img-input" data-letter="${letter}" accept=".jpg,.jpeg,.png,.gif,.webp" />
          </div>
        </div>`;
      }).join('')}
    </div>`;
  answerArea.innerHTML = html;

  // multi toggle
  const chkMulti = $('chk-multi');
  chkMulti.addEventListener('change', () => {
    const q2 = activeQ(); if (!q2) return;
    q2.is_multiple_answer = chkMulti.checked ? 1 : 0;
    if (!chkMulti.checked) { q2.correct_answer = null; q2.required_answers_count = 1; }
    markDirty();
    renderAnswerArea(q2);
  });

  $('inp-req-count') && $('inp-req-count').addEventListener('input', () => {
    const q2 = activeQ(); if (!q2) return;
    q2.required_answers_count = parseInt($('inp-req-count').value)||2;
    markDirty();
  });

  // choice selectors
  answerArea.querySelectorAll('.choice-selector').forEach(sel => {
    sel.addEventListener('change', () => {
      const q2 = activeQ(); if (!q2) return;
      if (isMulti) {
        const checked = [...answerArea.querySelectorAll('.choice-selector:checked')].map(el => el.dataset.letter);
        q2.correct_answer = checked.join(',');
      } else {
        q2.correct_answer = sel.dataset.letter;
      }
      // update card highlight
      answerArea.querySelectorAll('.choice-card').forEach(card => {
        const l = card.dataset.letter;
        const letters = (q2.correct_answer||'').split(',');
        card.classList.toggle('selected', letters.includes(l));
        const letterEl = card.querySelector('.choice-letter');
        letterEl.style.background = letters.includes(l) ? 'var(--success)' : '';
        letterEl.style.borderColor = letters.includes(l) ? 'var(--success)' : '';
        letterEl.style.color = letters.includes(l) ? '#fff' : '';
      });
      markDirty();
    });
  });

  // choice text
  answerArea.querySelectorAll('.choice-text-input').forEach(inp => {
    inp.addEventListener('input', () => {
      const q2 = activeQ(); if (!q2) return;
      q2[`option_${inp.dataset.letter.toLowerCase()}`] = inp.value;
      markDirty();
      renderSlideList();
    });
  });

  // choice image upload
  answerArea.querySelectorAll('.choice-img-placeholder').forEach(ph => {
    ph.addEventListener('click', () => {
      const inp = ph.parentElement.querySelector('.choice-img-input');
      if (inp) inp.click();
    });
  });

  answerArea.querySelectorAll('.choice-img-input').forEach(inp => {
    inp.addEventListener('change', async () => {
      const file = inp.files[0];
      if (!file) return;
      if (file.size > 5 * 1024 * 1024) { toast('File exceeds 5MB limit.','error'); inp.value=''; return; }
      const letter = inp.dataset.letter;
      const fd = new FormData();
      fd.append('choice_image', file);
      try {
        const res = await fetch('/teacher/assessment/upload-choice-image', { method:'POST', body:fd });
        const data = await res.json();
        if (!data.success) throw new Error(data.error);
        const q2 = activeQ(); if (!q2) return;
        q2[`option_${letter.toLowerCase()}_image`] = data.image_path;
        markDirty();
        renderAnswerArea(q2);
      } catch(e) { toast('Image upload failed: '+e.message,'error'); }
    });
  });

  // remove choice image
  answerArea.querySelectorAll('.btn-remove-choice-img').forEach(btn => {
    btn.addEventListener('click', () => {
      const q2 = activeQ(); if (!q2) return;
      q2[`option_${btn.dataset.letter.toLowerCase()}_image`] = null;
      markDirty();
      renderAnswerArea(q2);
    });
  });
}

// Periodic_Single mode
function renderPeriodicSingle(q) {
  const seq = q.answer_sequences[0] || {};
  const sym = seq.element_symbol || '';
  const el = ELEMENTS[sym];

  answerArea.innerHTML = `
    <div class="psingle-wrap">
      <div class="element-cell-input">
        ${el ? `<span class="element-cell-num">${el.num}</span>` : ''}
        <input type="text" id="inp-element-sym" maxlength="3" placeholder="?" value="${sym}" />
        <div class="element-cell-name">${el ? el.name : ''}</div>
      </div>
      <div class="psingle-hint">Type a valid element symbol (e.g. Au, Fe, H)</div>
      <div class="psingle-invalid" id="psingle-error">⚠ Unknown element symbol</div>
    </div>`;

  const symInp = $('inp-element-sym');
  const errMsg = $('psingle-error');
  symInp.addEventListener('input', () => {
    const val = symInp.value.trim();
    const caps = val.charAt(0).toUpperCase() + val.slice(1).toLowerCase();
    const found = ELEMENTS[caps];
    errMsg.style.display = val && !found ? 'block' : 'none';

    // update cell display
    const numEl = document.querySelector('.element-cell-num');
    const nameEl = document.querySelector('.element-cell-name');
    if (found) {
      if (numEl) numEl.textContent = found.num;
      else {
        const n = document.createElement('span');
        n.className = 'element-cell-num'; n.textContent = found.num;
        symInp.parentElement.insertBefore(n, symInp);
      }
      if (nameEl) nameEl.textContent = found.name;
    } else {
      if (numEl) numEl.textContent = '';
      if (nameEl) nameEl.textContent = '';
    }

    const q2 = activeQ(); if (!q2) return;
    if (found) {
      q2.answer_sequences = [{ element_symbol: caps, subscript: 1, sort_order: 1 }];
    } else {
      q2.answer_sequences = [];
    }
    markDirty();
  });
}

// Periodic_Sequence mode
function renderPeriodicSequence(q) {
  const seqs = q.answer_sequences.length > 0 ? q.answer_sequences : [];

  answerArea.innerHTML = `
    <div class="pseq-wrap">
      <div class="pseq-elements-row" id="pseq-row">
        ${seqs.map((s,i) => buildElementBox(s, i)).join('')}
        <button id="btn-add-element">+</button>
      </div>
      <div class="pseq-preview">
        <span class="preview-label">PREVIEW</span>
        <span id="pseq-formula"></span>
      </div>
      <div class="hw-hint">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>During the game: Students use the element buttons to add elements, <strong>Button 1(−)</strong>/<strong>Button 2(+)</strong> to adjust subscripts, <strong>Button 3(←)</strong>/<strong>Button 4(→)</strong> to navigate slots, and <strong>Enter</strong> to confirm.</span>
      </div>
    </div>`;

  attachSeqEvents();
  updateSeqPreview();

  $('btn-add-element').addEventListener('click', () => {
    const q2 = activeQ(); if (!q2) return;
    const nextOrder = q2.answer_sequences.length + 1;
    q2.answer_sequences.push({ element_symbol:'', subscript:1, sort_order: nextOrder });
    markDirty();
    renderAnswerArea(q2);
  });
}

function buildElementBox(seq, i) {
  return `
    <div class="element-box" data-index="${i}">
      <input type="text" class="seq-sym-input" maxlength="3" placeholder="?" value="${seq.element_symbol||''}" data-index="${i}" />
      <div class="subscript-label">subscript</div>
      <div class="sub-controls">
        <button class="sub-btn sub-dec" data-index="${i}">-</button>
        <input type="number" class="sub-input" min="1" value="${seq.subscript||1}" data-index="${i}" />
        <button class="sub-btn sub-inc" data-index="${i}">+</button>
      </div>
      <button class="btn-remove-element" data-index="${i}">✕</button>
    </div>`;
}

function attachSeqEvents() {
  document.querySelectorAll('.seq-sym-input').forEach(inp => {
    inp.addEventListener('input', () => {
      const q2 = activeQ(); if (!q2) return;
      const i = parseInt(inp.dataset.index);
      const val = inp.value.trim();
      const caps = val.charAt(0).toUpperCase() + val.slice(1).toLowerCase();
      q2.answer_sequences[i].element_symbol = ELEMENTS[caps] ? caps : val;
      markDirty();
      updateSeqPreview();
    });
  });

  document.querySelectorAll('.sub-input').forEach(inp => {
    inp.addEventListener('input', () => {
      const q2 = activeQ(); if (!q2) return;
      const i = parseInt(inp.dataset.index);
      q2.answer_sequences[i].subscript = Math.max(1, parseInt(inp.value)||1);
      markDirty();
      updateSeqPreview();
    });
  });

  document.querySelectorAll('.sub-dec').forEach(btn => {
    btn.addEventListener('click', () => {
      const q2 = activeQ(); if (!q2) return;
      const i = parseInt(btn.dataset.index);
      const subInp = document.querySelector(`.sub-input[data-index="${i}"]`);
      q2.answer_sequences[i].subscript = Math.max(1, (q2.answer_sequences[i].subscript||1) - 1);
      if(subInp) subInp.value = q2.answer_sequences[i].subscript;
      markDirty(); updateSeqPreview();
    });
  });

  document.querySelectorAll('.sub-inc').forEach(btn => {
    btn.addEventListener('click', () => {
      const q2 = activeQ(); if (!q2) return;
      const i = parseInt(btn.dataset.index);
      const subInp = document.querySelector(`.sub-input[data-index="${i}"]`);
      q2.answer_sequences[i].subscript = (q2.answer_sequences[i].subscript||1) + 1;
      if(subInp) subInp.value = q2.answer_sequences[i].subscript;
      markDirty(); updateSeqPreview();
    });
  });

  document.querySelectorAll('.btn-remove-element').forEach(btn => {
    btn.addEventListener('click', () => {
      const q2 = activeQ(); if (!q2) return;
      const i = parseInt(btn.dataset.index);
      q2.answer_sequences.splice(i, 1);
      q2.answer_sequences.forEach((s, idx) => { s.sort_order = idx + 1; });
      markDirty();
      renderAnswerArea(q2);
    });
  });
}

function updateSeqPreview() {
  const q2 = activeQ(); if (!q2) return;
  const formula = q2.answer_sequences.map(s => {
    const sym = s.element_symbol || '?';
    const sub = parseInt(s.subscript)||1;
    return sym + (sub > 1 ? toSubscript(sub) : '');
  }).join('');
  const el = $('pseq-formula');
  if (el) el.textContent = formula || '—';
}

// Numeric mode
function renderNumeric(q) {
  answerArea.innerHTML = `
    <div class="numeric-wrap">
      <div class="numeric-answer-field">
        <input type="number" id="inp-numeric-answer" step="any" placeholder="0" value="${q.numeric_answer !== null && q.numeric_answer !== undefined ? q.numeric_answer : ''}" />
      </div>
      <div class="numeric-tolerance-row">
        <label>Answer Tolerance (±)</label>
        <input type="number" id="inp-numeric-tolerance" step="0.0001" min="0" value="${q.numeric_tolerance || 0}" />
        <div id="numeric-range-display"></div>
      </div>
      <div class="hw-hint">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
        <span>During the game: Students use <strong>Button 1(−)</strong>/<strong>Button 2(+)</strong> to change the value, <strong>Button 3</strong> to cycle step size, <strong>Button 4</strong> to toggle sign, and <strong>Enter</strong> to confirm.</span>
      </div>
    </div>`;

  const numInp = $('inp-numeric-answer');
  const tolInp = $('inp-numeric-tolerance');
  const rangeEl = $('numeric-range-display');

  function updateRange() {
    const ans = parseFloat(numInp.value);
    const tol = parseFloat(tolInp.value) || 0;
    if (isNaN(ans)) { rangeEl.innerHTML = ''; return; }
    if (tol === 0) {
      rangeEl.innerHTML = 'Exact match required';
    } else {
      const lo = (ans - tol).toFixed(4);
      const hi = (ans + tol).toFixed(4);
      rangeEl.innerHTML = `Acceptable range: <span>${lo} — ${hi}</span>`;
    }
  }

  numInp.addEventListener('input', () => {
    const q2 = activeQ(); if (!q2) return;
    q2.numeric_answer = numInp.value !== '' ? parseFloat(numInp.value) : null;
    markDirty(); updateRange();
  });

  tolInp.addEventListener('input', () => {
    const q2 = activeQ(); if (!q2) return;
    q2.numeric_tolerance = parseFloat(tolInp.value) || 0;
    markDirty(); updateRange();
  });

  updateRange();
}

// ── RENDER RIGHT PANEL ───────────────────────────────────────
function renderRightPanel() {
  const q = activeQ();
  const activeTabPanel = $q('.right-nav-btn.active')?.dataset.panel || 'properties';

  if (!q) {
    rightEmptyMsg.style.display = 'flex';
    propPanel.style.display = 'none';
    themePanel.style.display = 'none';
    return;
  }
  rightEmptyMsg.style.display = 'none';

  if (activeTabPanel === 'properties') {
    propPanel.style.display = 'flex';
    themePanel.style.display = 'none';
    fillPropertiesPanel(q);
  } else {
    propPanel.style.display = 'none';
    themePanel.style.display = 'flex';
    fillThemePanel(q);
  }
}

function fillPropertiesPanel(q) {
  propInputMode.value  = q.input_mode || 'Standard';
  propDifficulty.value = q.difficulty || 'Easy';
  propMechanic.value   = q.mechanic_type || 'standard_mcq';
  propBaseExp.value    = q.base_exp !== undefined ? q.base_exp : 100;
  propPoints.value     = q.points !== undefined ? q.points : 1;
  propTimeLimit.value  = q.time_limit || 10;
  propTLGroup.style.display = state.assessment.timer_type === 'PerItem' ? 'flex' : 'none';
  aiBadge.className = q.is_ai_generated ? 'ai-badge ai-gen' : 'ai-badge manual';
  aiBadge.textContent = q.is_ai_generated ? '🤖 AI Generated' : '✏️ Manually Created';
}

function fillThemePanel(q) {
  const themeId  = state.topic.theme_id || 'default_lab';
  const themeConf = THEME_BACKGROUNDS[themeId];
  const soundConf = THEME_SOUNDS[themeId] || THEME_SOUNDS['default_lab'];
  themeNameBadge.textContent = themeConf?.label || themeId;

  // ── Background thumbnails ──────────────────────────────────
  bgGrid.innerHTML = '';
  (themeConf?.bgs || []).forEach((bgKey, i) => {
    const wrap = document.createElement('div');
    wrap.style.cssText = 'display:flex;flex-direction:column;gap:4px;';

    const thumb = document.createElement('div');
      thumb.className = 'bg-thumb' + (q.selected_bg_key === bgKey ? ' selected' : '');
      thumb.style.backgroundColor = BG_COLORS[i];
      thumb.style.backgroundImage = `url('${bgImageUrl(bgKey)}')`;
      thumb.style.backgroundSize = 'cover';
      thumb.style.backgroundPosition = 'center';
      thumb.title = `Background ${i+1}`;

    thumb.addEventListener('click', () => {
      const q2 = activeQ(); if (!q2) return;
      q2.selected_bg_key = bgKey;
      markDirty();
      renderMainContent();
      renderSlideList();
      fillThemePanel(q2);
    });

    const label = document.createElement('div');
    label.className = 'bg-thumb-label';
    label.textContent = `BG ${i+1}`;

    wrap.appendChild(thumb);
    wrap.appendChild(label);
    bgGrid.appendChild(wrap);
  });

  // ── Sound pickers helper ───────────────────────────────────
  function buildSoundOptions(containerId, options, currentKey, stateField, errId) {
    const container = document.getElementById(containerId);
    const errEl     = document.getElementById(errId);
    container.innerHTML = '';

    options.forEach(opt => {
      const btn = document.createElement('button');
      btn.className = 'sound-opt-btn' + (currentKey === opt.key ? ' selected' : '');
      btn.innerHTML = `<span class="sound-preview-icon">▶</span>${opt.label}`;

      btn.addEventListener('click', () => {
        // preview the sound
        previewSound(opt.key);
        // mark all buttons in this group unselected
        container.querySelectorAll('.sound-opt-btn').forEach(b => {
          b.classList.remove('selected', 'playing');
        });
        // mark this one selected + briefly playing
        btn.classList.add('selected', 'playing');
        setTimeout(() => btn.classList.remove('playing'), 4000);
        // save to state
        state.assessment[stateField] = opt.key;
        markDirty();
        if (errEl) errEl.classList.remove('show');
      });

      container.appendChild(btn);
    });
  }

  // ── Theme-based sounds ─────────────────────────────────────
  buildSoundOptions('sound-bg-options',      soundConf.bg,      state.assessment.sound_bg,      'sound_bg',      'err-sound-bg');
  buildSoundOptions('sound-correct-options', soundConf.correct, state.assessment.sound_correct,  'sound_correct',  'err-sound-correct');
  buildSoundOptions('sound-wrong-options',   soundConf.wrong,   state.assessment.sound_wrong,    'sound_wrong',    'err-sound-wrong');

  // ── Global result sounds ───────────────────────────────────
  buildSoundOptions('sound-pass-options', GLOBAL_RESULT_SOUNDS.pass, state.assessment.sound_result_pass, 'sound_result_pass', 'err-sound-pass');
  buildSoundOptions('sound-fail-options', GLOBAL_RESULT_SOUNDS.fail, state.assessment.sound_result_fail, 'sound_result_fail', 'err-sound-fail');

  // ── Speech toggle ──────────────────────────────────────────
  const chkSpeech = document.getElementById('chk-speech-enabled');
  if (chkSpeech) {
    chkSpeech.checked = !!state.assessment.speech_enabled;
    // remove old listener before adding to avoid duplicates
    const newChk = chkSpeech.cloneNode(true);
    chkSpeech.parentNode.replaceChild(newChk, chkSpeech);
    newChk.checked = !!state.assessment.speech_enabled;
    newChk.addEventListener('change', () => {
      state.assessment.speech_enabled = newChk.checked ? 1 : 0;
      markDirty();
    });
  }
}

// ── RIGHT TAB NAVIGATION ─────────────────────────────────────
document.querySelectorAll('.right-nav-btn').forEach(btn => {
  btn.addEventListener('click', () => {
    document.querySelectorAll('.right-nav-btn').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    renderRightPanel();
  });
});

// ── PROPERTIES PANEL EVENTS ──────────────────────────────────
propInputMode.addEventListener('change', () => {
  const q = activeQ(); if (!q) return;
  const oldMode = q.input_mode;
  const newMode = propInputMode.value;
  if (oldMode === newMode) return;

  // check if there's existing answer data
  const hasData = q.answer_sequences.length > 0
    || q.correct_answer
    || q.numeric_answer !== null
    || q.option_a || q.option_b || q.option_c || q.option_d;

  if (hasData) {
    state.pendingModeChange = { newMode };
    showModal('modal-mode-switch');
  } else {
    applyModeChange(newMode);
  }
});

function applyModeChange(newMode) {
  const q = activeQ(); if (!q) return;
  q.input_mode = newMode;
  q.answer_sequences = [];
  q.correct_answer = null;
  q.numeric_answer = null;
  q.numeric_tolerance = 0;
  q.option_a = ''; q.option_a_image = null;
  q.option_b = ''; q.option_b_image = null;
  q.option_c = ''; q.option_c_image = null;
  q.option_d = ''; q.option_d_image = null;
  q.is_multiple_answer = 0;
  q.required_answers_count = 1;
  markDirty();
  renderSlideList();
  renderMainContent();
}

$('btn-mode-cancel').addEventListener('click', () => {
  propInputMode.value = activeQ()?.input_mode || 'Standard';
  state.pendingModeChange = null;
  hideModal('modal-mode-switch');
});

$('btn-mode-confirm').addEventListener('click', () => {
  if (state.pendingModeChange) applyModeChange(state.pendingModeChange.newMode);
  state.pendingModeChange = null;
  hideModal('modal-mode-switch');
});

propDifficulty.addEventListener('change', () => { const q=activeQ();if(q){q.difficulty=propDifficulty.value;markDirty();} });
propMechanic.addEventListener('change', ()  => { const q=activeQ();if(q){q.mechanic_type=propMechanic.value;markDirty();} });
propBaseExp.addEventListener('input', ()    => { const q=activeQ();if(q){q.base_exp=parseInt(propBaseExp.value)||0;markDirty();} });
propPoints.addEventListener('input', ()     => { const q=activeQ();if(q){q.points=parseInt(propPoints.value)||1;markDirty();} });
propTimeLimit.addEventListener('input', ()  => { const q=activeQ();if(q){q.time_limit=parseInt(propTimeLimit.value)||10;markDirty();} });

// ── QUESTION TEXT & INSTRUCTION EVENTS ──────────────────────
inpQText.addEventListener('input', () => {
  autoResize(inpQText);
  const q = activeQ(); if (!q) return;
  q.question_text = inpQText.value;
  markDirty();
  // update slide preview live
  const card = slideList.querySelector(`.slide-card[data-index="${state.activeSlideIndex}"]`);
  if (card) {
    const prev = card.querySelector('.slide-preview');
    const text = inpQText.value.trim();
    prev.textContent = text ? text.slice(0,35)+(text.length>35?'…':'') : 'New Question';
    prev.classList.toggle('empty-q', !text);
  }
});

inpInstruct.addEventListener('input', () => {
  autoResize(inpInstruct);
  const q = activeQ(); if (!q) return;
  q.instruction_override = inpInstruct.value;
  markDirty();
});

// ── INSTRUCTION PREVIEW MODAL ────────────────────────────────
const DEFAULT_INSTRUCTIONS = {
  Periodic_Sequence: `Build the correct chemical formula using the element buttons.\n\nPress an element button to add it to the sequence.\nUse Button 1 (−) and Button 2 (+) to adjust the subscript.\nPress Button 4 to move to the next element slot.\nPress Button 3 to go back to a previous slot.\nPress Enter when your sequence is complete.`,
  Numeric: `Dial to the correct numeric answer.\n\nPress Button 2 (+) to increase the value.\nPress Button 1 (−) to decrease the value.\nPress Button 3 to cycle the step size:\n  1 → 0.1 → 0.01 → 10 → 100\nPress Button 4 to toggle positive/negative.\nPress Enter to confirm your answer.`
};

$('btn-preview-instruction').addEventListener('click', () => {
  const q = activeQ(); if (!q) return;
  const mode = q.input_mode || 'Standard';
  const custom = (q.instruction_override || '').trim();
  const preview = $('instruction-preview-content');

  if (custom) {
    preview.textContent = custom;
  } else if (DEFAULT_INSTRUCTIONS[mode]) {
    preview.textContent = DEFAULT_INSTRUCTIONS[mode];
  } else {
    preview.textContent = 'No instruction screen will be shown for this question.';
  }
  showModal('modal-instruction-preview');
});
$('btn-preview-close').addEventListener('click', () => hideModal('modal-instruction-preview'));

// ── MEDIA UPLOAD ─────────────────────────────────────────────
mediaZone.addEventListener('click', () => mediaInput.click());
mediaZone.addEventListener('dragover', e => { e.preventDefault(); mediaZone.classList.add('drag-over'); });
mediaZone.addEventListener('dragleave', () => mediaZone.classList.remove('drag-over'));
mediaZone.addEventListener('drop', e => {
  e.preventDefault();
  mediaZone.classList.remove('drag-over');
  const file = e.dataTransfer.files[0];
  if (file) handleMediaFile(file);
});
mediaInput.addEventListener('change', () => {
  if (mediaInput.files[0]) handleMediaFile(mediaInput.files[0]);
});

async function handleMediaFile(file) {
  if (file.size > 50 * 1024 * 1024) { toast('File exceeds the 50MB limit.','error'); return; }
  const allowedExts = ['.jpg','.jpeg','.png','.gif','.webp','.mp4','.webm'];
  const ext = file.name.split('.').pop().toLowerCase();
  if (!allowedExts.includes('.'+ext)) { toast('Invalid file type.','error'); return; }

  mediaProgress.style.display = 'block';
  mediaBar.style.width = '30%';

  const fd = new FormData();
  fd.append('media', file);
  try {
    const res = await fetch('/teacher/assessment/upload-media', { method:'POST', body:fd });
    mediaBar.style.width = '90%';
    const data = await res.json();
    if (!data.success) throw new Error(data.error);
    mediaBar.style.width = '100%';
    setTimeout(() => { mediaProgress.style.display = 'none'; mediaBar.style.width = '0%'; }, 500);
    const q = activeQ(); if (!q) return;
    q.media_path = data.media_path;
    q.media_type = data.media_type;
    markDirty();
    renderMediaPreview(q);
  } catch(e) {
    toast('Upload failed: '+e.message,'error');
    mediaProgress.style.display = 'none';
    mediaBar.style.width = '0%';
  }
  mediaInput.value = '';
}

btnRemMedia.addEventListener('click', () => {
  const q = activeQ(); if (!q) return;
  q.media_path = null; q.media_type = null;
  markDirty();
  renderMediaPreview(q);
});

// ── EXIT BUTTON ──────────────────────────────────────────────
const exitUrl = `/teacher/topic/${state.assessment.topic_id}`;
$('btn-exit').addEventListener('click', () => {
  if (state.isDirty) showModal('modal-exit');
  else window.history.back(); 
});
$('btn-exit-stay').addEventListener('click', () => hideModal('modal-exit'));
$('btn-exit-confirm').addEventListener('click', () => { 
    window.history.back(); 
});

// ── SAVE ─────────────────────────────────────────────────────
$('btn-save').addEventListener('click', () => {
  if (!validateAll()) return;
  showModal('modal-save');
});
$('btn-save-cancel').addEventListener('click', () => hideModal('modal-save'));
$('btn-save-confirm').addEventListener('click', () => performSave());

function validateAll() {
  // assessment name
  if (!state.assessment.assessment_name.trim()) {
    toast('Assessment name is required.','error');
    inpName.classList.add('error');
    inpName.focus();
    return false;
  }
  inpName.classList.remove('error');

  // total items
  if (!state.assessment.total_items || state.assessment.total_items < 1) {
    toast('Total items must be at least 1.','error');
    inpTotal.classList.add('error');
    return false;
  }
  inpTotal.classList.remove('error');

  if (state.questions.length > state.assessment.total_items) {
    toast(`Total items (${state.assessment.total_items}) cannot be less than questions added (${state.questions.length}).`,'error');
    return false;
  }

  // sound selections — all 5 required
  const soundChecks = [
    { field:'sound_bg',          errId:'err-sound-bg',      label:'Background music' },
    { field:'sound_correct',     errId:'err-sound-correct', label:'Correct answer sound' },
    { field:'sound_wrong',       errId:'err-sound-wrong',   label:'Wrong answer sound' },
    { field:'sound_result_pass', errId:'err-sound-pass',    label:'Pass result sound' },
    { field:'sound_result_fail', errId:'err-sound-fail',    label:'Fail result sound' }
  ];
  let soundError = false;
  soundChecks.forEach(sc => {
    const val = state.assessment[sc.field];
    const errEl = document.getElementById(sc.errId);
    if (!val || val.trim() === '') {
      if (errEl) errEl.classList.add('show');
      soundError = true;
    } else {
      if (errEl) errEl.classList.remove('show');
    }
  });
  if (soundError) {
    // switch to theme tab so teacher sees the errors
    document.querySelectorAll('.right-nav-btn').forEach(b => b.classList.remove('active'));
    document.querySelector('.right-nav-btn[data-panel="theme"]').classList.add('active');
    renderRightPanel();
    toast('Please select all required sounds in the Theme panel.', 'error');
    return false;
  }

  // per-question validation
  for (let i = 0; i < state.questions.length; i++) {
    const q = state.questions[i];
    const label = `Question Q${i+1}`;

    if (!q.question_text.trim()) {
      toast(`${label} is missing question text.`,'error');
      activateSlide(i);
      return false;
    }

    if (q.input_mode === 'Standard') {
      if (!q.correct_answer) {
        toast(`${label}: Please mark at least one correct answer.`,'error');
        activateSlide(i);
        return false;
      }
      if (q.is_multiple_answer && (!q.required_answers_count || q.required_answers_count < 2)) {
        toast(`${label}: Required answers count must be at least 2 for multiple-answer questions.`,'error');
        activateSlide(i);
        return false;
      }
    }

    if (q.input_mode === 'Periodic_Single') {
      if (!q.answer_sequences[0]?.element_symbol) {
        toast(`${label}: Please enter a valid element symbol.`,'error');
        activateSlide(i);
        return false;
      }
    }

    if (q.input_mode === 'Periodic_Sequence') {
      if (q.answer_sequences.length < 2) {
        toast(`${label}: Please add at least 2 elements to the sequence.`,'error');
        activateSlide(i);
        return false;
      }
      for (const seq of q.answer_sequences) {
        if (!ELEMENTS[seq.element_symbol]) {
          toast(`${label}: Invalid element symbol "${seq.element_symbol}" in sequence.`,'error');
          activateSlide(i);
          return false;
        }
      }
    }

    if (q.input_mode === 'Numeric') {
      if (q.numeric_answer === null || q.numeric_answer === undefined || q.numeric_answer === '') {
        toast(`${label}: Please enter the correct numeric answer.`,'error');
        activateSlide(i);
        return false;
      }
    }
  }
  return true;
}

async function performSave() {
  const saveSpinner = $('save-confirm-spinner');
  const saveLabel   = $('save-confirm-label');
  const saveBtn     = $('btn-save-confirm');
  const topSaveBtn  = $('btn-save');

  saveSpinner.style.display = 'block';
  saveLabel.textContent = 'Saving...';
  saveBtn.disabled = true;
  topSaveBtn.disabled = true;

  const payload = {
    assessment: { ...state.assessment },
    questions: state.questions.map((q, i) => ({ ...q, _index: i, sort_order: i+1 })),
    deletedQuestionIds: state.deletedQuestionIds
  };

  try {
    const res = await fetch('/teacher/assessment/save', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    const data = await res.json();

    if (!data.success) throw new Error(data.error || 'Save failed');

    // Update state with real DB IDs
    state.assessment.assessment_id = data.assessment_id;
    state.deletedQuestionIds = [];

    if (data.savedQuestions) {
      data.savedQuestions.forEach(sq => {
        const q = state.questions[sq.original_index];
        if (q) { q.aq_id = sq.aq_id; q.question_id = sq.question_id; }
      });
    }

    state.isDirty = false;

    // Update URL without reload if this was a new assessment
    const newUrl = `/teacher/assessment/${data.assessment_id}/configure`;
    if (!window.location.pathname.includes(data.assessment_id)) {
      history.replaceState(null, '', newUrl);
    }

    hideModal('modal-save');
    toast('Assessment saved successfully.','success');
  } catch(e) {
    hideModal('modal-save');
    toast('Save failed: '+e.message,'error');
  } finally {
    saveSpinner.style.display = 'none';
    saveLabel.textContent = 'Save';
    saveBtn.disabled = false;
    topSaveBtn.disabled = false;
  }
}

// ── LIGHT / DARK MODE TOGGLE ─────────────────────────────────
(function() {
  const btn   = $('btn-theme-toggle');
  const icon  = $('theme-toggle-icon');
  const label = $('theme-toggle-label');
  const saved = localStorage.getItem('gc_theme') || 'light';

  function applyTheme(mode) {
    if (mode === 'light') {
      document.body.classList.add('light-mode');
      icon.textContent  = '☀️';
      label.textContent = 'Light';
    } else {
      document.body.classList.remove('light-mode');
      icon.textContent  = '🌙';
      label.textContent = 'Dark';
    }
    localStorage.setItem('gc_theme', mode);
  }

  applyTheme(saved);

  btn.addEventListener('click', () => {
    const isCurrentlyLight = document.body.classList.contains('light-mode');
    applyTheme(isCurrentlyLight ? 'dark' : 'light');
  });
})();

// ── INIT ─────────────────────────────────────────────────────
initTopBar();
renderSlideList();
if (state.activeSlideIndex >= 0) {
  renderMainContent();
  renderRightPanel();
} else {
  mainEmpty.style.display = 'flex';
  mainContent.style.display = 'none';
  rightEmptyMsg.style.display = 'flex';
  propPanel.style.display = 'none';
  themePanel.style.display = 'none';
}
</script>
