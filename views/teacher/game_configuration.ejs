<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= pageData.assessment.assessment_id ? 'Edit Assessment' : 'New Assessment' %> — Chemistry Arcade</title>

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Syne:wght@400;600;700;800&family=DM+Sans:ital,wght@0,300;0,400;0,500;0,600;1,400&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />

  <style>
    /* ─── CSS VARIABLES ─────────────────────────────────── */
    :root {
      --bg-base      : #0d1a1f;
      --bg-surface   : #0f2027;
      --bg-elevated  : #132a33;
      --bg-card      : #1a3540;
      --bg-input     : #1e3d4a;
      --border       : #1e4d5c;
      --border-light : #236070;
      --accent       : #06b6d4;
      --accent-hover : #0891b2;
      --accent-glow  : rgba(6,182,212,0.25);
      --success      : #22c55e;
      --danger       : #ef4444;
      --warning      : #f59e0b;
      --info         : #38bdf8;
      --purple       : #8b5cf6;
      --orange       : #f97316;
      --text-primary : #e0f7fa;
      --text-secondary: #80deea;
      --text-muted   : #4dd0e1;
      --font-display : 'Syne', sans-serif;
      --font-body    : 'DM Sans', sans-serif;
      --font-mono    : 'JetBrains Mono', monospace;
      --radius-sm    : 6px;
      --radius-md    : 10px;
      --radius-lg    : 16px;
      --topbar-h     : 64px;
      --left-w       : 230px;
      --right-w      : 290px;
      --trans        : all 0.18s ease;
    }

    /* ─── LIGHT MODE OVERRIDES ──────────────────────────── */
    body.light-mode {
      --bg-base      : #f0fdfa;
      --bg-surface   : #ffffff;
      --bg-elevated  : #ecfdf5;
      --bg-card      : #d1fae5;
      --bg-input     : #f0fdfa;
      --border       : #a5f3eb;
      --border-light : #67e8db;
      --accent       : #06b6d4;
      --accent-hover : #0891b2;
      --accent-glow  : rgba(6,182,212,0.18);
      --text-primary : #1e1b4b;
      --text-secondary: #3730a3;
      --text-muted   : #6366f1;
    }
    body.light-mode #main-empty svg,
    body.light-mode #slide-empty svg { opacity: .15; }
    body.light-mode .main-card {
      background: rgba(255,255,255,.92);
    }
    body.light-mode select option { background: #ffffff; color: #1e1b4b; }

    /* ─── RESET ──────────────────────────────────────────── */
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    html, body { height: 100%; overflow: hidden; background: var(--bg-base); color: var(--text-primary); font-family: var(--font-body); font-size: 14px; }
    body.light-mode { background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px); background-size: 24px 24px; }
    button { font-family: var(--font-body); cursor: pointer; border: none; outline: none; }
    input, select, textarea { font-family: var(--font-body); outline: none; border: none; background: none; color: var(--text-primary); }
    input[type=number]::-webkit-inner-spin-button { -webkit-appearance: none; }
    input[type=number] { -moz-appearance: textfield; }
    select option { background: var(--bg-card); }
    ::-webkit-scrollbar { width: 5px; height: 5px; }
    ::-webkit-scrollbar-track { background: transparent; }
    ::-webkit-scrollbar-thumb { background: var(--border-light); border-radius: 99px; }
    ::placeholder { color: var(--text-muted); }

    /* ─── SOUND & SPEECH ─────────────────────────────────── */
    .sound-section-title {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: var(--text-muted);
      margin: 10px 0 6px;
      display: flex;
      align-items: center;
      gap: 6px;
    }
    .sound-section-title::after {
      content: '';
      flex: 1;
      height: 1px;
      background: var(--border);
    }
    .sound-picker-group {
      display: flex;
      flex-direction: column;
      gap: 4px;
      margin-bottom: 8px;
    }
    .sound-picker-label {
      font-size: 11px;
      color: var(--text-secondary);
      font-weight: 500;
    }
    .sound-options-row {
      display: flex;
      flex-wrap: wrap;
      gap: 5px;
    }
    .sound-opt-btn {
      display: flex;
      align-items: center;
      gap: 5px;
      padding: 5px 9px;
      border-radius: var(--radius-sm);
      font-size: 11px;
      font-weight: 600;
      background: var(--bg-input);
      border: 1px solid var(--border);
      color: var(--text-secondary);
      cursor: pointer;
      transition: var(--trans);
    }
    .sound-opt-btn:hover { border-color: var(--border-light); color: var(--text-primary); }
    .sound-opt-btn.selected { background: rgba(91,110,245,.12); border-color: var(--accent); color: var(--accent); }
    .sound-opt-btn.playing  { background: rgba(34,197,94,.12); border-color: var(--success); color: var(--success); }
    .sound-preview-icon { font-size: 12px; }
    .sound-required-err { font-size: 10px; color: var(--danger); display: none; margin-top: 2px; }
    .sound-required-err.show { display: block; }

    /* speech toggle row */
    .speech-toggle-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 10px 12px;
      margin-top: 6px;
    }
    .speech-toggle-info { display: flex; flex-direction: column; gap: 2px; }
    .speech-toggle-title { font-size: 12px; font-weight: 600; color: var(--text-primary); }
    .speech-toggle-sub   { font-size: 10px; color: var(--text-muted); line-height: 1.4; }
    .speech-toggle-row .toggle-switch { width: 38px; height: 21px; flex-shrink: 0; }

    /* ─── LAYOUT ─────────────────────────────────────────── */
    #app { display: flex; flex-direction: column; height: 100vh; }

    /* ─── TOP BAR ────────────────────────────────────────── */
    #topbar {
      height: var(--topbar-h);
      min-height: var(--topbar-h);
      background: var(--bg-surface);
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 0 14px;
      position: relative;
      z-index: 100;
      flex-shrink: 0;
    }

    #topbar .tb-field-group {
      display: flex;
      align-items: center;
      gap: 8px;
      flex: 1;
      overflow-x: auto;
      overflow-y: hidden;
      scrollbar-width: none;
    }
    #topbar .tb-field-group::-webkit-scrollbar { display: none; }

    .tb-field {
      display: flex;
      flex-direction: column;
      gap: 2px;
      flex-shrink: 0;
    }
    .tb-field label {
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: .06em;
      color: var(--text-muted);
    }
    .tb-input {
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 5px 9px;
      color: var(--text-primary);
      font-size: 13px;
      transition: var(--trans);
    }
    .tb-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }
    .tb-input.error  { border-color: var(--danger); }

    #inp-name { width: 180px; }
    #sel-type { width: 120px; }
    #inp-total { width: 72px; }
    #inp-duration { width: 72px; }
    #sel-timer { width: 110px; }
    #inp-duedate { width: 165px; color-scheme: dark; }
    body.light-mode #inp-duedate { color-scheme: light; }

    /* lock toggle */
    .lock-toggle-wrap { display: flex; flex-direction: column; gap: 2px; flex-shrink: 0; }
    .lock-toggle-inner { display: flex; align-items: center; gap: 7px; }
    .toggle-switch { position: relative; width: 38px; height: 21px; cursor: pointer; }
    .toggle-switch input { opacity: 0; width: 0; height: 0; position: absolute; }
    .toggle-track {
      position: absolute; inset: 0;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: 99px;
      transition: var(--trans);
    }
    .toggle-track::after {
      content: '';
      position: absolute;
      top: 3px; left: 3px;
      width: 13px; height: 13px;
      background: var(--text-muted);
      border-radius: 50%;
      transition: var(--trans);
    }
    .toggle-switch input:checked ~ .toggle-track { background: var(--success); border-color: var(--success); }
    .toggle-switch input:checked ~ .toggle-track::after { transform: translateX(17px); background: #fff; }
    #lock-label { font-size: 12px; font-weight: 600; color: var(--text-muted); min-width: 52px; }

    .tb-divider { width: 1px; height: 36px; background: var(--border); flex-shrink: 0; margin: 0 4px; }

    /* top bar buttons */
    .btn { display: inline-flex; align-items: center; gap: 6px; padding: 8px 16px; border-radius: var(--radius-sm); font-size: 13px; font-weight: 600; transition: var(--trans); flex-shrink: 0; }
    .btn-ghost { background: transparent; color: var(--text-secondary); border: 1px solid var(--border); }
    .btn-ghost:hover { background: var(--bg-elevated); color: var(--text-primary); border-color: var(--border-light); }
    .btn-primary { background: var(--accent); color: #fff; border: 1px solid transparent; }
    .btn-primary:hover { background: var(--accent-hover); box-shadow: 0 0 16px var(--accent-glow); }
    .btn-primary:disabled { opacity: .5; cursor: not-allowed; }
    .btn-danger-soft { background: rgba(239,68,68,.12); color: var(--danger); border: 1px solid rgba(239,68,68,.25); }
    .btn-danger-soft:hover { background: rgba(239,68,68,.2); }
    .btn-success-soft { background: rgba(34,197,94,.12); color: var(--success); border: 1px solid rgba(34,197,94,.25); }
    .btn-success-soft:hover { background: rgba(34,197,94,.2); }

    .spinner { width: 14px; height: 14px; border: 2px solid rgba(255,255,255,.3); border-top-color: #fff; border-radius: 50%; animation: spin .6s linear infinite; display: none; }
    @keyframes spin { to { transform: rotate(360deg); } }

    /* ─── BODY PANELS ────────────────────────────────────── */
    #body { display: flex; flex: 1; overflow: hidden; }

    /* ─── LEFT TAB ───────────────────────────────────────── */
    #left-tab {
      width: var(--left-w);
      min-width: var(--left-w);
      background: var(--bg-surface);
      border-right: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    #left-header { padding: 12px 10px 10px; border-bottom: 1px solid var(--border); flex-shrink: 0; }
    #btn-add-q {
      width: 100%;
      background: var(--accent);
      color: #fff;
      border-radius: var(--radius-sm);
      padding: 9px 0;
      font-weight: 700;
      font-size: 13px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: var(--trans);
    }
    #btn-add-q:hover { background: var(--accent-hover); box-shadow: 0 0 12px var(--accent-glow); }
    #slide-counter {
      margin-top: 8px;
      font-size: 11px;
      color: var(--text-muted);
      text-align: center;
      min-height: 16px;
    }
    #slide-counter.ok   { color: var(--success); }
    #slide-counter.warn { color: var(--warning); }
    #slide-counter.err  { color: var(--danger); }

    #slide-list { flex: 1; overflow-y: auto; padding: 8px; display: flex; flex-direction: column; gap: 4px; }

    /* empty state */
    #slide-empty {
      flex: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 10px;
      color: var(--text-muted);
      padding: 20px;
      text-align: center;
    }
    #slide-empty svg { opacity: .25; }
    #slide-empty p { font-size: 12px; line-height: 1.5; }

    /* slide card */
    .slide-card {
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 8px 8px 8px 4px;
      cursor: pointer;
      transition: var(--trans);
      display: flex;
      align-items: center;
      gap: 6px;
      position: relative;
    }
    .slide-card:hover { border-color: var(--border-light); background: var(--bg-card); }
    .slide-card.active { border-color: var(--accent); background: rgba(6,182,212,.08); }
    .slide-card.has-error { border-color: var(--danger); }

    .drag-handle {
      cursor: grab;
      color: var(--text-muted);
      padding: 0 2px;
      display: flex;
      align-items: center;
      flex-shrink: 0;
    }
    .drag-handle:active { cursor: grabbing; }
    .drag-handle svg { display: block; }

    .slide-num {
      font-family: var(--font-mono);
      font-size: 10px;
      font-weight: 500;
      color: var(--text-muted);
      min-width: 22px;
      flex-shrink: 0;
    }
    .slide-card.active .slide-num { color: var(--accent); }

    .slide-info { flex: 1; min-width: 0; }
    .slide-preview {
      font-size: 12px;
      font-weight: 500;
      color: var(--text-primary);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 100%;
    }
    .slide-preview.empty-q { color: var(--text-muted); font-style: italic; }
    .slide-meta { display: flex; align-items: center; gap: 5px; margin-top: 3px; }

    .mode-badge {
      font-size: 9px;
      font-weight: 700;
      font-family: var(--font-mono);
      padding: 1px 5px;
      border-radius: 3px;
      letter-spacing: .04em;
    }
    .mode-badge.std  { background: rgba(139,146,168,.15); color: var(--text-secondary); }
    .mode-badge.psgl { background: rgba(56,189,248,.15);  color: var(--info); }
    .mode-badge.pseq { background: rgba(168,85,247,.15);  color: var(--purple); }
    .mode-badge.num  { background: rgba(249,115,22,.15);  color: var(--orange); }

    .bg-dot {
      width: 8px; height: 8px;
      border-radius: 50%;
      flex-shrink: 0;
      background: var(--border-light);
    }

    .error-dot {
      width: 7px; height: 7px;
      border-radius: 50%;
      background: var(--danger);
      flex-shrink: 0;
    }

    .slide-del-btn {
      background: none;
      color: var(--text-muted);
      padding: 3px;
      border-radius: 4px;
      display: flex;
      align-items: center;
      transition: var(--trans);
      flex-shrink: 0;
    }
    .slide-del-btn:hover { color: var(--danger); background: rgba(239,68,68,.12); }

    /* inline delete confirm */
    .del-confirm {
      display: none;
      margin-top: 6px;
      background: rgba(239,68,68,.08);
      border: 1px solid rgba(239,68,68,.2);
      border-radius: var(--radius-sm);
      padding: 8px;
    }
    .del-confirm.show { display: block; }
    .del-confirm p { font-size: 11px; color: var(--danger); margin-bottom: 6px; }
    .del-confirm-btns { display: flex; gap: 6px; }
    .del-confirm-btns button { font-size: 11px; font-weight: 600; padding: 4px 10px; border-radius: 4px; }
    .btn-del-cancel { background: var(--bg-card); color: var(--text-secondary); border: 1px solid var(--border); }
    .btn-del-confirm { background: rgba(239,68,68,.2); color: var(--danger); border: 1px solid rgba(239,68,68,.3); }

    /* drag ghost */
    .drag-ghost { opacity: .4; }

    /* ─── MAIN TAB ───────────────────────────────────────── */
    #main-tab {
      flex: 1;
      overflow-y: auto;
      position: relative;
      background-size: cover;
      background-position: center;
      background-attachment: local;
      transition: background-image .25s ease;
    }

    #main-empty {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 14px;
      color: var(--text-muted);
      text-align: center;
      padding: 40px;
    }
    #main-empty svg { opacity: .2; }
    #main-empty p  { font-size: 14px; line-height: 1.6; max-width: 280px; }

    #main-content { padding: 20px; display: flex; flex-direction: column; gap: 14px; min-height: 100%; }

    .main-card {
      background: rgba(15,32,39,.88);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 16px;
    }

    .main-card-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .08em;
      color: var(--text-muted);
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .main-card-label .optional-tag {
      font-size: 9px;
      background: rgba(139,146,168,.12);
      color: var(--text-muted);
      padding: 1px 6px;
      border-radius: 3px;
      font-weight: 500;
      text-transform: uppercase;
    }
    .main-card-label .recommended-tag {
      font-size: 9px;
      background: rgba(245,158,11,.12);
      color: var(--warning);
      padding: 1px 6px;
      border-radius: 3px;
      font-weight: 600;
      text-transform: uppercase;
    }

    /* question header row */
    #q-header-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 4px;
    }
    #q-position-label {
      font-family: var(--font-display);
      font-size: 12px;
      font-weight: 600;
      color: var(--text-secondary);
    }

    /* question textarea */
    #inp-question-text {
      width: 100%;
      resize: none;
      overflow: hidden;
      min-height: 72px;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 12px 14px;
      font-size: 15px;
      font-family: var(--font-body);
      font-weight: 500;
      color: var(--text-primary);
      line-height: 1.5;
      transition: var(--trans);
    }
    #inp-question-text:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }

    /* instruction override */
    .instruction-row {
      display: flex;
      align-items: center;
      gap: 8px;
      margin-bottom: 8px;
    }
    .info-icon-btn {
      background: none;
      color: var(--info);
      border-radius: 50%;
      width: 18px; height: 18px;
      display: flex; align-items: center; justify-content: center;
      font-size: 11px;
      border: 1px solid rgba(56,189,248,.3);
      flex-shrink: 0;
    }
    #btn-preview-instruction {
      font-size: 11px;
      font-weight: 600;
      padding: 3px 10px;
      border-radius: 4px;
      background: rgba(6,182,212,.12);
      color: var(--accent);
      border: 1px solid rgba(6,182,212,.2);
      margin-left: auto;
      transition: var(--trans);
    }
    #btn-preview-instruction:hover { background: rgba(6,182,212,.2); }
    #inp-instruction {
      width: 100%;
      resize: none;
      overflow: hidden;
      min-height: 52px;
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 10px 12px;
      font-size: 13px;
      line-height: 1.5;
      color: var(--text-primary);
      transition: var(--trans);
    }
    #inp-instruction:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }

    /* media upload card */
    #media-upload-zone {
      border: 2px dashed var(--border);
      border-radius: var(--radius-md);
      padding: 22px;
      text-align: center;
      cursor: pointer;
      transition: var(--trans);
      color: var(--text-muted);
    }
    #media-upload-zone:hover, #media-upload-zone.drag-over {
      border-color: var(--accent);
      background: rgba(6,182,212,.05);
      color: var(--text-secondary);
    }
    #media-upload-zone svg { display: block; margin: 0 auto 8px; }
    #media-upload-zone p  { font-size: 12px; }
    #media-upload-zone span { font-size: 11px; color: var(--text-muted); }
    #media-input { display: none; }
    #media-preview-wrap { display: none; position: relative; }
    #media-preview-img  { max-width: 100%; max-height: 200px; object-fit: contain; border-radius: var(--radius-md); display: block; }
    #media-preview-vid  { max-width: 100%; max-height: 200px; border-radius: var(--radius-md); display: block; }
    #media-upload-progress {
      display: none;
      background: var(--bg-input);
      border-radius: var(--radius-sm);
      height: 6px;
      margin-top: 10px;
      overflow: hidden;
    }
    #media-upload-progress-bar {
      height: 100%;
      background: var(--accent);
      width: 0%;
      transition: width .3s ease;
      border-radius: var(--radius-sm);
    }
    #btn-remove-media {
      position: absolute;
      top: 6px; right: 6px;
      background: rgba(239,68,68,.85);
      color: #fff;
      border-radius: 50%;
      width: 24px; height: 24px;
      display: flex; align-items: center; justify-content: center;
      font-size: 12px;
      font-weight: 700;
    }
    #btn-remove-media:hover { background: var(--danger); }

    /* ─── ANSWER AREA ────────────────────────────────────── */
    #answer-area { /* dynamic content injected here */ }

    /* Standard mode choices */
    .multi-answer-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 12px;
      padding: 8px 12px;
      background: var(--bg-input);
      border-radius: var(--radius-sm);
    }
    .multi-answer-row label { font-size: 12px; color: var(--text-secondary); cursor: pointer; display: flex; align-items: center; gap: 7px; }
    .multi-answer-row .toggle-switch { width: 32px; height: 18px; }
    .multi-answer-row .toggle-track::after { width: 11px; height: 11px; }
    .multi-answer-row input:checked ~ .toggle-track::after { transform: translateX(14px); }
    #req-count-row { display: none; align-items: center; gap: 8px; font-size: 12px; color: var(--text-secondary); }
    #req-count-row input { width: 50px; background: var(--bg-input); border: 1px solid var(--border); border-radius: 4px; padding: 3px 6px; text-align: center; }

    .choices-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
    .choice-card {
      background: var(--bg-input);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      padding: 10px;
      transition: var(--trans);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .choice-card.selected { border-color: var(--success); background: rgba(34,197,94,.06); }
    .choice-card-top { display: flex; align-items: center; gap: 8px; }
    .choice-letter {
      width: 26px; height: 26px;
      border-radius: 50%;
      background: var(--bg-card);
      border: 1px solid var(--border);
      display: flex; align-items: center; justify-content: center;
      font-weight: 800;
      font-size: 12px;
      font-family: var(--font-display);
      flex-shrink: 0;
    }
    .choice-card.selected .choice-letter { background: var(--success); border-color: var(--success); color: #fff; }
    .choice-selector { /* radio/checkbox */ accent-color: var(--success); width: 15px; height: 15px; cursor: pointer; }
    .choice-text-input {
      flex: 1;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 6px 10px;
      font-size: 13px;
      color: var(--text-primary);
      width: 100%;
      transition: var(--trans);
    }
    .choice-text-input:focus { border-color: var(--accent); }

    .choice-img-area {
      border: 1px dashed var(--border);
      border-radius: var(--radius-sm);
      overflow: hidden;
      position: relative;
    }
    .choice-img-placeholder {
      padding: 8px;
      text-align: center;
      cursor: pointer;
      color: var(--text-muted);
      font-size: 11px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: var(--trans);
    }
    .choice-img-placeholder:hover { color: var(--text-secondary); background: rgba(255,255,255,.03); }
    .choice-img-preview { display: none; }
    .choice-img-preview img { width: 100%; max-height: 100px; object-fit: contain; display: block; }
    .btn-remove-choice-img {
      position: absolute;
      top: 4px; right: 4px;
      background: rgba(239,68,68,.85);
      color: #fff;
      border-radius: 50%;
      width: 18px; height: 18px;
      font-size: 10px;
      display: flex; align-items: center; justify-content: center;
    }
    .choice-img-input { display: none; }

    /* Periodic_Single */
    .psingle-wrap { display: flex; flex-direction: column; align-items: center; gap: 14px; padding: 20px 0; }
    .element-cell-input {
      width: 120px; height: 120px;
      background: var(--bg-input);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      cursor: text;
      transition: var(--trans);
      position: relative;
    }
    .element-cell-input:focus-within { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-glow); }
    .element-cell-input input {
      font-size: 36px;
      font-weight: 800;
      font-family: var(--font-display);
      text-align: center;
      width: 100%;
      background: none;
      letter-spacing: .02em;
    }
    .element-cell-name { font-size: 10px; color: var(--text-muted); text-align: center; }
    .element-cell-num  { font-size: 9px; color: var(--text-muted); position: absolute; top: 6px; left: 8px; font-family: var(--font-mono); }
    .psingle-hint { font-size: 12px; color: var(--text-muted); text-align: center; }
    .psingle-invalid { color: var(--danger); font-size: 11px; display: none; }

    /* Periodic_Sequence */
    .pseq-wrap { display: flex; flex-direction: column; gap: 14px; }
    .pseq-elements-row {
      display: flex;
      align-items: flex-start;
      gap: 8px;
      overflow-x: auto;
      padding: 8px 4px 12px;
      scrollbar-width: thin;
    }
    .element-box {
      flex-shrink: 0;
      background: var(--bg-input);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      padding: 8px;
      width: 80px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 4px;
      cursor: grab;
      transition: var(--trans);
    }
    .element-box:focus-within { border-color: var(--accent); }
    .element-box.dragging { opacity: .3; cursor: grabbing; }
    .element-box input {
      width: 100%;
      text-align: center;
      font-size: 20px;
      font-weight: 800;
      font-family: var(--font-display);
      background: none;
    }
    .element-box .subscript-label { font-size: 9px; color: var(--text-muted); }
    .element-box .sub-input {
      width: 100%;
      text-align: center;
      font-size: 13px;
      font-family: var(--font-mono);
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 4px;
      padding: 2px 0;
    }
    .element-box .sub-controls { display: flex; gap: 2px; }
    .sub-btn {
      flex: 1;
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 3px;
      padding: 2px 0;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-secondary);
      text-align: center;
    }
    .sub-btn:hover { background: var(--bg-elevated); color: var(--text-primary); }
    .btn-remove-element {
      background: none;
      color: var(--text-muted);
      font-size: 10px;
      display: flex; align-items: center; justify-content: center;
      width: 16px; height: 16px;
      border-radius: 50%;
      border: 1px solid var(--border);
    }
    .btn-remove-element:hover { background: rgba(239,68,68,.15); color: var(--danger); border-color: rgba(239,68,68,.3); }
    #btn-add-element {
      flex-shrink: 0;
      width: 80px;
      height: 80px;
      background: rgba(6,182,212,.08);
      border: 2px dashed rgba(6,182,212,.3);
      border-radius: var(--radius-md);
      color: var(--accent);
      font-size: 22px;
      font-weight: 700;
      display: flex;
      align-items: center;
      justify-content: center;
      align-self: flex-start;
      margin-top: 8px;
      transition: var(--trans);
    }
    #btn-add-element:hover { background: rgba(6,182,212,.15); border-color: var(--accent); }
    .pseq-preview {
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      font-size: 18px;
      font-family: var(--font-display);
      font-weight: 700;
      color: var(--text-primary);
      text-align: center;
      letter-spacing: .04em;
    }
    .pseq-preview .preview-label { font-size: 10px; color: var(--text-muted); font-weight: 500; margin-bottom: 4px; display: block; letter-spacing: .06em; }

    /* Numeric mode */
    .numeric-wrap { display: flex; flex-direction: column; align-items: center; gap: 20px; padding: 20px 0; }
    .numeric-answer-field {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      width: 100%;
    }
    #inp-numeric-answer {
      font-size: 32px;
      font-family: var(--font-mono);
      font-weight: 500;
      text-align: center;
      width: 220px;
      background: var(--bg-input);
      border: 2px solid var(--border);
      border-radius: var(--radius-md);
      padding: 14px 20px;
      transition: var(--trans);
    }
    #inp-numeric-answer:focus { border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-glow); }
    .numeric-tolerance-row {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 6px;
      width: 100%;
    }
    .numeric-tolerance-row label { font-size: 12px; color: var(--text-secondary); }
    #inp-numeric-tolerance {
      width: 100px;
      text-align: center;
      font-size: 15px;
      font-family: var(--font-mono);
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 6px 10px;
      transition: var(--trans);
    }
    #inp-numeric-tolerance:focus { border-color: var(--accent); }
    #numeric-range-display {
      font-size: 12px;
      color: var(--text-muted);
      min-height: 18px;
    }
    #numeric-range-display span { color: var(--success); font-weight: 600; }

    /* hardware hint callout */
    .hw-hint {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      background: rgba(56,189,248,.06);
      border: 1px solid rgba(56,189,248,.15);
      border-radius: var(--radius-sm);
      padding: 10px 12px;
      font-size: 11px;
      color: var(--text-secondary);
      line-height: 1.55;
    }
    .hw-hint svg { flex-shrink: 0; margin-top: 1px; color: var(--info); }

    /* ─── RIGHT TAB ──────────────────────────────────────── */
    #right-tab {
      width: var(--right-w);
      min-width: var(--right-w);
      background: var(--bg-surface);
      border-left: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      overflow: hidden;
    }
    #right-nav {
      display: flex;
      border-bottom: 1px solid var(--border);
      flex-shrink: 0;
    }
    .right-nav-btn {
      flex: 1;
      padding: 13px 0;
      font-size: 12px;
      font-weight: 700;
      color: var(--text-muted);
      background: none;
      border-bottom: 2px solid transparent;
      transition: var(--trans);
      text-align: center;
      letter-spacing: .04em;
      text-transform: uppercase;
    }
    .right-nav-btn.active { color: var(--accent); border-bottom-color: var(--accent); }

    #right-panel { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 0; }

    .right-empty {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-size: 12px;
      text-align: center;
      padding: 20px;
    }

    .prop-group { display: flex; flex-direction: column; gap: 6px; margin-bottom: 14px; }
    .prop-label {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .07em;
      color: var(--text-muted);
    }
    .prop-select, .prop-input {
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 8px 10px;
      font-size: 13px;
      color: var(--text-primary);
      width: 100%;
      min-width: 0;
      box-sizing: border-box;
      transition: var(--trans);
    }
    .prop-select:focus, .prop-input:focus { border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-glow); }

    /* ai badge */
    .ai-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 10px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
    }
    .ai-badge.manual { background: rgba(139,146,168,.1); color: var(--text-secondary); border: 1px solid var(--border); }
    .ai-badge.ai-gen { background: rgba(168,85,247,.1); color: var(--purple); border: 1px solid rgba(168,85,247,.25); }

    .prop-divider { height: 1px; background: var(--border); margin: 6px 0 14px; }

    /* theme backgrounds */
    .theme-label-badge {
      font-size: 11px;
      font-weight: 600;
      color: var(--text-secondary);
      background: var(--bg-elevated);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 5px 10px;
      text-align: center;
    }
    .theme-note { font-size: 11px; color: var(--text-muted); line-height: 1.4; margin-bottom: 14px; display: block; }
    .bg-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; width: 100%; }
    .bg-thumb {
      border-radius: var(--radius-sm);
      overflow: hidden;
      border: 2px solid var(--border);
      cursor: pointer;
      position: relative;
      aspect-ratio: 16/9;
      background-size: cover;
      background-position: center;
      transition: var(--trans);
    }
    .bg-thumb:hover { border-color: var(--border-light); }
    .bg-thumb.selected { border-color: var(--accent); }
    .bg-thumb.selected::after {
      content: '✓';
      position: absolute;
      inset: 0;
      background: rgba(6,182,212,.35);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #fff;
      font-weight: 800;
      font-size: 20px;
    }
    .bg-thumb-label { font-size: 10px; color: var(--text-muted); text-align: center; margin-top: 4px; }

    /* ─── THEME TOGGLE BUTTON ───────────────────────────── */
    #btn-theme-toggle {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 13px;
      border-radius: var(--radius-sm);
      font-size: 12px;
      font-weight: 600;
      background: var(--bg-elevated);
      color: var(--text-secondary);
      border: 1px solid var(--border);
      cursor: pointer;
      transition: var(--trans);
      flex-shrink: 0;
    }
    #btn-theme-toggle:hover {
      background: var(--bg-card);
      color: var(--text-primary);
      border-color: var(--border-light);
    }
    #btn-theme-toggle .toggle-icon { font-size: 14px; line-height: 1; }

    /* ─── MODALS ──────────────────────────────────────────── */
    .modal-overlay {
      position: fixed; inset: 0;
      background: rgba(30,27,75,.55);
      backdrop-filter: blur(4px);
      z-index: 1000;
      display: flex; align-items: center; justify-content: center;
      padding: 20px;
      opacity: 0; pointer-events: none;
      transition: opacity .2s ease;
    }
    .modal-overlay.show { opacity: 1; pointer-events: all; }
    .modal-box {
      background: var(--bg-elevated);
      border: 1px solid var(--border-light);
      border-radius: var(--radius-lg);
      padding: 28px;
      max-width: 420px;
      width: 100%;
      transform: scale(.95) translateY(10px);
      transition: transform .2s ease;
    }
    .modal-overlay.show .modal-box { transform: scale(1) translateY(0); }
    .modal-title { font-family: var(--font-display); font-size: 17px; font-weight: 700; margin-bottom: 10px; }
    .modal-body  { font-size: 13px; color: var(--text-secondary); line-height: 1.6; margin-bottom: 20px; }
    .modal-body.preview-instruction {
      background: var(--bg-input);
      border: 1px solid var(--border);
      border-radius: var(--radius-sm);
      padding: 14px;
      font-size: 13px;
      line-height: 1.7;
      color: var(--text-primary);
      white-space: pre-wrap;
      max-height: 300px;
      overflow-y: auto;
    }
    .modal-actions { display: flex; justify-content: flex-end; gap: 10px; }

    /* ─── TOAST ──────────────────────────────────────────── */
    #toast-container {
      position: fixed;
      bottom: 24px; right: 24px;
      z-index: 2000;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }
    .toast {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-md);
      padding: 12px 16px;
      font-size: 13px;
      font-weight: 500;
      min-width: 240px;
      max-width: 360px;
      display: flex;
      align-items: center;
      gap: 10px;
      box-shadow: 0 8px 24px rgba(6,182,212,.15);
      animation: toastIn .25s ease;
    }
    .toast.success { border-left: 3px solid var(--success); }
    .toast.error   { border-left: 3px solid var(--danger); }
    .toast.info    { border-left: 3px solid var(--info); }
    @keyframes toastIn { from { opacity: 0; transform: translateX(20px); } to { opacity: 1; transform: translateX(0); } }
  </style>
</head>
<body>
<div id="app">

  <!-- ═══════════════════════════════════════════════════════
       ZONE 1 — TOP BAR
  ═══════════════════════════════════════════════════════ -->
  <div id="topbar">
    <!-- Exit -->
    <button class="btn btn-ghost" id="btn-exit" title="Exit">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
      Exit
    </button>

    <div class="tb-divider"></div>

    <!-- Assessment fields -->
    <div class="tb-field-group">
      <!-- Name -->
      <div class="tb-field">
        <label for="inp-name">Assessment Name</label>
        <input type="text" id="inp-name" class="tb-input" maxlength="100" placeholder="Enter assessment name..." />
      </div>

      <!-- Type -->
      <div class="tb-field">
        <label for="sel-type">Type</label>
        <select id="sel-type" class="tb-input">
          <option value="Pre-Test">Pre-Test</option>
          <option value="Post-Test">Post-Test</option>
          <option value="Quiz" selected>Quiz</option>
          <option value="Competitive">Competitive</option>
        </select>
      </div>

      <!-- Total Items -->
      <div class="tb-field">
        <label for="inp-total">Total Items</label>
        <input type="number" id="inp-total" class="tb-input" min="1" placeholder="30" />
      </div>

      <!-- Timer Type -->
      <div class="tb-field">
        <label for="sel-timer">Timer Type</label>
        <select id="sel-timer" class="tb-input">
          <option value="Global" selected>Global</option>
          <option value="PerItem">Per Item</option>
        </select>
      </div>

      <!-- Duration (hidden when PerItem) -->
      <div class="tb-field" id="duration-field">
        <label for="inp-duration">Duration</label>
        <input type="number" id="inp-duration" class="tb-input" min="1" placeholder="30" />
        <span style="font-size:9px;color:var(--text-muted);margin-top:1px;">minutes</span>
      </div>

      <!-- Lock Toggle -->
      <div class="tb-field lock-toggle-wrap">
        <label>Status</label>
        <div class="lock-toggle-inner">
          <label class="toggle-switch">
            <input type="checkbox" id="chk-unlocked" />
            <span class="toggle-track"></span>
          </label>
          <span id="lock-label">Locked</span>
        </div>
      </div>

      <!-- Due Date -->
      <div class="tb-field">
        <label for="inp-duedate">Due Date</label>
        <input type="datetime-local" id="inp-duedate" class="tb-input" />
      </div>
    </div>

    <div class="tb-divider"></div>

    <!-- Theme Toggle -->
    <button id="btn-theme-toggle" title="Toggle Light/Dark Mode">
      <span class="toggle-icon" id="theme-toggle-icon">☀️</span>
      <span id="theme-toggle-label">Light</span>
    </button>

    <!-- Save -->
    <button class="btn btn-primary" id="btn-save">
      <span class="spinner" id="save-spinner"></span>
      <svg id="save-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      Save
    </button>
  </div>

  <!-- ═══════════════════════════════════════════════════════
       ZONE 2+3+4 — BODY
  ═══════════════════════════════════════════════════════ -->
  <div id="body">

    <!-- ─── LEFT TAB ─────────────────────────────────────── -->
    <div id="left-tab">
      <div id="left-header">
        <button id="btn-add-q">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          Add Question
        </button>
        <div id="slide-counter">0 questions</div>
      </div>
      <div id="slide-list">
        <div id="slide-empty">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M12 8v8M8 12h8"/></svg>
          <p>No questions yet.<br/>Click <strong>Add Question</strong> to get started.</p>
        </div>
      </div>
    </div>

    <!-- ─── MAIN TAB ──────────────────────────────────────── -->
    <div id="main-tab">
      <div id="main-empty">
        <svg width="56" height="56" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 12h8M12 8v8"/></svg>
        <p>Add a question using the panel on the left to begin editing.</p>
      </div>
      <div id="main-content" style="display:none;">
        <!-- Q header row -->
        <div id="q-header-row">
          <span id="q-position-label">Question 1</span>
          <span id="q-mode-badge" class="mode-badge std">STD</span>
        </div>

        <!-- Question text card -->
        <div class="main-card">
          <div class="main-card-label">Question</div>
          <textarea id="inp-question-text" rows="3" placeholder="Type your question here..."></textarea>
        </div>

        <!-- Instruction override card -->
        <div class="main-card">
          <div class="main-card-label">
            <span id="instruction-label-text">Custom Instruction</span>
            <span id="instruction-optional-tag" class="optional-tag">Optional</span>
            <span id="instruction-recommended-tag" class="recommended-tag" style="display:none;">Recommended</span>
            <button id="btn-preview-instruction">Preview</button>
          </div>
          <div id="instruction-info" style="display:none;margin-bottom:8px;padding:7px 10px;background:rgba(56,189,248,.06);border:1px solid rgba(56,189,248,.15);border-radius:var(--radius-sm);font-size:11px;color:var(--text-secondary);line-height:1.5;">
            ℹ️ This question type always shows a 10-second instruction screen. Your text will replace the default button guide.
          </div>
          <textarea id="inp-instruction" rows="2" placeholder="Leave blank to skip the instruction screen..."></textarea>
        </div>

        <!-- Media upload card -->
        <div class="main-card">
          <div class="main-card-label">
            Attach Media
            <span class="optional-tag">Optional</span>
          </div>
          <div id="media-upload-zone">
