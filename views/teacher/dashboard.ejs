<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Dashboard | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #f0fdfa; /* Light Cyan/Emerald tint */
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }
        #sidebar {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: linear-gradient(180deg, #0d1a2e 0%, #0b1523 100%);
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .glass-card { background: rgba(255, 255, 255, 0.92); backdrop-filter: blur(10px); }

        /* Stat card hover */
        .stat-card { transition: transform 0.18s ease, box-shadow 0.18s ease; }
        .stat-card:hover { transform: translateY(-3px); box-shadow: 0 12px 32px rgba(0,0,0,0.10); }

        /* Alert pulse */
        .pulse-badge { animation: pulseRing 2s infinite; }
        @keyframes pulseRing {
            0%,100% { opacity:1; }
            50%      { opacity:0.45; }
        }

        /* Clean scrollbars */
        .custom-scrollbar::-webkit-scrollbar { width: 4px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 10px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: #cbd5e1; }

        /* Scrollable table containers */
        .table-scroll { max-height: 260px; overflow-y: auto; }
        .table-scroll::-webkit-scrollbar { width: 3px; }
        .table-scroll::-webkit-scrollbar-thumb { background: #c7d2fe; border-radius:2px; }

        /* Section fade-in */
        .fade-in { animation: fadeUp 0.35s ease both; }
        @keyframes fadeUp { from { opacity:0; transform:translateY(10px); } to { opacity:1; transform:translateY(0); } }

        /* Live dot */
        .live-dot {
            width:8px; height:8px; border-radius:50%;
            background:#22c55e;
            box-shadow: 0 0 0 0 rgba(34,197,94,0.7);
            animation: livePulse 1.6s infinite;
            display:inline-block;
        }
        @keyframes livePulse {
            0%   { box-shadow: 0 0 0 0 rgba(34,197,94,0.7); }
            70%  { box-shadow: 0 0 0 7px rgba(34,197,94,0); }
            100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
        }

        .gradient-border {
            position: relative;
            border-radius: 1.5rem;
            background: white;
            padding: 1px;
        }
        .gradient-border::before {
            content: "";
            position: absolute;
            inset: -2px;
            background: linear-gradient(45deg, #06b6d4, #8b5cf6, #ec4899);
            border-radius: 1.6rem;
            z-index: -1;
            opacity: 0.3;
        }
        /* Nav active state */
        .nav-active {
            background: linear-gradient(135deg, #06b6d4 0%, #6366f1 100%) !important;
            color: white !important;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(6,182,212,0.3), 0 2px 8px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }

        /* Profile dropdown */
        .profile-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 210px;
            background: white;
            border-radius: 1rem;
            box-shadow: 0 8px 32px rgba(6,182,212,0.13), 0 2px 8px rgba(99,102,241,0.10);
            border: 1px solid #e0f2fe;
            z-index: 999;
            opacity: 0;
            transform: translateY(-6px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.18s ease, transform 0.18s ease;
        }
        .profile-dropdown.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all;
        }
        .profile-dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 700;
            color: #1e293b;
            cursor: pointer;
            transition: background 0.13s;
            border-radius: 0.75rem;
            text-decoration: none;
        }
        .profile-dropdown-item:hover { background: #f0f9ff; color: #0369a1; }
        .profile-dropdown-item.danger:hover { background: #fff1f2; color: #be123c; }
    </style>
    <%- include('../partials/teacher-nav-styles') %>
</head>
<body class="text-slate-900">

    <div class="flex min-h-screen relative overflow-x-hidden">
        <%- include('../partials/teacher-sidebar', { activeNav: 'dashboard' }) %>

        <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">
            
            <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    <div>
                        <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">
                            Welcome, Teacher <%= user.last_name %>!
                        </h1>
                        <p class="text-xs text-slate-600 hidden sm:block font-medium">
                            <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                            Faculty Portal &nbsp;·&nbsp; <%= new Date().toLocaleDateString('en-PH', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                        </p>
                    </div>
                </div>

                <div class="flex items-center gap-3 md:gap-6">
                    <!-- Messages Navigation Button (Entry point to teacher messages workspace) -->
                    <a href="/teacher/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                        <i class="far fa-comment-dots text-xl"></i>
                        
                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Messages
                        </span>
                    </a>

                    <!-- Notification Button with keyboard-accessible tooltip -->
                    <button type="button" onclick="toggleNotifPanel()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                        <i class="far fa-bell text-xl text-slate-700"></i>
                        
                        <span class="absolute top-2 right-2 flex h-2.5 w-2.5 notif-badge <%= (typeof notifications !== 'undefined' && notifications && notifications.some(n => !n.is_read)) ? '' : 'hidden' %>" aria-hidden="true">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500 border-2 border-white"></span>
                        </span>

                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Notifications
                        </span>
                    </button>
                    
                    <!-- User Profile Dropdown -->
                    <div class="relative">
                        <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                            <div class="text-right hidden lg:block">
                                <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                                <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none"><%= user.role || 'Teacher' %></p>
                            </div>
                            <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100" onerror="this.src='/profile_uploads/default_avatar.png'">
                            <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                        </button>

                        <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                            <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                                <p class="text-sm font-bold text-slate-800"><%= user.first_name %> <%= user.last_name %></p>
                                <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role || 'Teacher' %></p>
                            </div>
                            <a href="/teacher/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                                <i class="far fa-user w-5 text-center"></i> View Profile
                            </a>
                            <hr class="my-2 border-slate-100">
                            <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                                <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                            </a>
                        </div>
                    </div>
                </div>
            </header>

            <!-- SCROLLABLE CONTENT -->
            <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
                <div class="p-4 md:p-6 lg:p-7 flex-1 fade-in">

                    <!-- ══════════════════════════════════════════
                         SECTION 1 — KPI STAT CARDS
                    ══════════════════════════════════════════ -->
                    <div class="grid grid-cols-2 sm:grid-cols-3 xl:grid-cols-6 gap-3.5 mb-5">

                        <!-- Students -->
                        <div class="stat-card glass-card rounded-2xl p-4 border border-violet-100 flex flex-col justify-between">
                            <div class="flex items-center justify-between mb-2">
                                <div class="w-10 h-10 rounded-xl bg-violet-100 flex items-center justify-center">
                                    <i class="fas fa-user-graduate text-violet-600"></i>
                                </div>
                                <span class="text-[10px] font-black uppercase tracking-widest text-violet-400">Students</span>
                            </div>
                            <div>
                                <p class="text-2xl sm:text-3xl font-black text-indigo-900 leading-tight"><%= stats.totalStudents || 0 %></p>
                                <p class="text-xs text-slate-400 mt-0.5">Enrolled</p>
                            </div>
                        </div>

                        <!-- Classes -->
                        <div class="stat-card glass-card rounded-2xl p-4 border border-cyan-100 flex flex-col justify-between">
                            <div class="flex items-center justify-between mb-2">
                                <div class="w-10 h-10 rounded-xl bg-cyan-100 flex items-center justify-center">
                                    <i class="fas fa-chalkboard-user text-cyan-600"></i>
                                </div>
                                <span class="text-[10px] font-black uppercase tracking-widest text-cyan-400">Classes</span>
                            </div>
                            <div>
                                <p class="text-2xl sm:text-3xl font-black text-indigo-900 leading-tight"><%= classes.length %></p>
                                <p class="text-xs text-slate-400 mt-0.5">Active Sections</p>
                            </div>
                        </div>

                        <!-- Attempts -->
                        <div class="stat-card glass-card rounded-2xl p-4 border border-emerald-100 flex flex-col justify-between">
                            <div class="flex items-center justify-between mb-2">
                                <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center">
                                    <i class="fas fa-fire-flame-simple text-emerald-600"></i>
                                </div>
                                <span class="text-[10px] font-black uppercase tracking-widest text-emerald-400">Attempts</span>
                            </div>
                            <div>
                                <p class="text-2xl sm:text-3xl font-black text-indigo-900 leading-tight"><%= stats.totalAttempts || 0 %></p>
                                <p class="text-xs text-slate-400 mt-0.5">Total Submissions</p>
                            </div>
                        </div>

                        <!-- Accuracy -->
                        <div class="stat-card glass-card rounded-2xl p-4 border border-amber-100 flex flex-col justify-between">
                            <div class="flex items-center justify-between mb-2">
                                <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center">
                                    <i class="fas fa-bullseye text-amber-600"></i>
                                </div>
                                <span class="text-[10px] font-black uppercase tracking-widest text-amber-400">Accuracy</span>
                            </div>
                            <div>
                                <p class="text-2xl sm:text-3xl font-black text-indigo-900 leading-tight"><%= Math.round(stats.avgAccuracy || 0) %>%</p>
                                <p class="text-xs text-slate-400 mt-0.5">Overall Mastery</p>
                            </div>
                        </div>

                        <!-- Assessments -->
                        <div class="stat-card glass-card rounded-2xl p-4 border border-indigo-100 flex flex-col justify-between">
                            <div class="flex items-center justify-between mb-2">
                                <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center">
                                    <i class="fas fa-clipboard-list text-indigo-600"></i>
                                </div>
                                <span class="text-[10px] font-black uppercase tracking-widest text-indigo-400">Assessments</span>
                            </div>
                            <div>
                                <p class="text-2xl sm:text-3xl font-black text-indigo-900 leading-tight"><%= pendingAssessments ? pendingAssessments.length : 0 %></p>
                                <p class="text-xs text-slate-400 mt-0.5">Active Tasks</p>
                            </div>
                        </div>

                        <!-- Interventions -->
                        <div class="stat-card glass-card rounded-2xl p-4 border border-rose-100 flex flex-col justify-between">
                            <div class="flex items-center justify-between mb-2">
                                <div class="w-10 h-10 rounded-xl bg-rose-100 flex items-center justify-center">
                                    <i class="fas fa-triangle-exclamation text-rose-600"></i>
                                </div>
                                <span class="text-[10px] font-black uppercase tracking-widest text-rose-400">Interventions</span>
                            </div>
                            <div>
                                <p class="text-2xl sm:text-3xl font-black text-indigo-900 leading-tight"><%= needsAttention ? needsAttention.length : 0 %></p>
                                <p class="text-xs mt-0.5">
                                    <% if (needsAttention && needsAttention.length > 0) { %>
                                        <span class="text-rose-500 font-bold"><i class="fas fa-circle text-[8px]"></i> Action Req.</span>
                                    <% } else { %>
                                        <span class="text-emerald-500 font-bold"><i class="fas fa-circle text-[8px]"></i> Safe Zone</span>
                                    <% } %>
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════
                         ROW 2 — Active Load Details + Alert Banner
                    ══════════════════════════════════════════ -->
                    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mb-5 items-stretch">

                        <!-- Active Teaching Load Detail Card -->
                        <div class="glass-card rounded-2xl p-5 border border-cyan-100 flex flex-col justify-between h-full">
                            <div class="flex items-center justify-between mb-3">
                                <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                    <i class="fas fa-chalkboard-user text-cyan-500 mr-2"></i>Active Teaching Load
                                </h3>
                                <a href="/teacher/classes"
                                   class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline">
                                    Manage →
                                </a>
                            </div>

                            <div class="bg-gradient-to-r from-cyan-50 to-indigo-50 rounded-xl p-3.5 border border-cyan-100 flex-1 flex flex-col justify-between gap-3">
                                <div class="grid grid-cols-2 gap-2">
                                    <div class="bg-white rounded-lg p-2.5 text-center border border-cyan-100 shadow-xs">
                                        <p class="text-2xl font-black text-indigo-900"><%= classes.length %></p>
                                        <p class="text-[10px] text-slate-400 uppercase font-bold">Classes</p>
                                    </div>
                                    <div class="bg-white rounded-lg p-2.5 text-center border border-cyan-100 shadow-xs">
                                        <p class="text-2xl font-black text-indigo-900"><%= stats.totalStudents || 0 %></p>
                                        <p class="text-[10px] text-slate-400 uppercase font-bold">Students</p>
                                    </div>
                                </div>

                                <div class="space-y-2 flex-1 overflow-y-auto pr-1 custom-scrollbar min-h-[140px] max-h-[180px]">
                                    <% if (classes && classes.length > 0) { %>
                                        <% classes.slice(0, 5).forEach(cls => { %>
                                        <a href="/teacher/class/<%= cls.class_id %>" class="flex items-center justify-between bg-white/95 hover:bg-white p-2.5 rounded-xl border border-cyan-100 hover:border-cyan-300 transition text-xs shadow-xs group">
                                            <div class="min-w-0 pr-2">
                                                <p class="font-bold text-indigo-900 group-hover:text-cyan-700 transition truncate leading-tight"><%= cls.subject_name %></p>
                                                <p class="text-[10px] text-slate-400 font-semibold truncate"><%= cls.class_name %> • <%= cls.subject_code %></p>
                                            </div>
                                            <span class="text-[10px] font-black px-2 py-0.5 rounded-full bg-cyan-100 text-cyan-700 whitespace-nowrap">
                                                <%= cls.student_count %> studs
                                            </span>
                                        </a>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="flex items-center justify-center h-full text-slate-400 text-xs py-4">
                                            <p>No active classes assigned.</p>
                                        </div>
                                    <% } %>
                                </div>

                                <div class="pt-2 border-t border-cyan-200/60 flex items-center justify-between text-[10px] font-bold text-slate-500">
                                    <span><%= classes.length %> active teaching sections</span>
                                    <a href="/teacher/classes" class="text-cyan-600 hover:underline">View All Classes →</a>
                                </div>
                            </div>
                        </div>

                        <!-- Alerts & Attention — spans 2 cols -->
                        <div class="xl:col-span-2 glass-card rounded-2xl p-5 border border-rose-100 flex flex-col justify-between h-full">
                            <div class="flex items-center justify-between mb-3">
                                <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                    <i class="fas fa-triangle-exclamation text-rose-500 mr-2"></i>Needs Attention & Alerts
                                </h3>
                                <% const totalAlerts = (needsAttention ? needsAttention.length : 0) + (pendingAssessments ? pendingAssessments.length : 0); %>
                                <span class="bg-rose-100 text-rose-600 text-[10px] font-black px-2.5 py-1 rounded-full uppercase">
                                    <%= totalAlerts %> item<%= totalAlerts !== 1 ? 's' : '' %>
                                </span>
                            </div>

                            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 flex-1 items-stretch">

                                <!-- Struggling Students -->
                                <div class="flex items-center gap-3 bg-rose-50 rounded-xl p-3.5 border border-rose-100 h-full">
                                    <div class="w-10 h-10 rounded-lg bg-rose-100 flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-user-xmark text-rose-500 text-base"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xl font-black text-rose-700 leading-tight"><%= needsAttention ? needsAttention.length : 0 %></p>
                                        <p class="text-[11px] text-slate-500 font-semibold truncate">Struggling (< 50% Progress)</p>
                                    </div>
                                    <a href="/teacher/classes" class="ml-auto text-rose-500 hover:text-rose-700 text-xs font-bold whitespace-nowrap bg-white px-2 py-1 rounded-lg border border-rose-200 shadow-xs">Intervene →</a>
                                </div>

                                <!-- Upcoming Deadlines -->
                                <div class="flex items-center gap-3 bg-amber-50 rounded-xl p-3.5 border border-amber-100 h-full">
                                    <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-clock text-amber-500 text-base"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xl font-black text-amber-700 leading-tight"><%= pendingAssessments ? pendingAssessments.length : 0 %></p>
                                        <p class="text-[11px] text-slate-500 font-semibold truncate">Pending Assessments</p>
                                    </div>
                                    <a href="/teacher/classes" class="ml-auto text-amber-600 hover:text-amber-800 text-xs font-bold whitespace-nowrap bg-white px-2 py-1 rounded-lg border border-amber-200 shadow-xs">View →</a>
                                </div>

                                <!-- Grace Period Submissions -->
                                <% const graceCount = (recentScores || []).filter(s => s.is_grace_period).length; %>
                                <div class="flex items-center gap-3 bg-violet-50 rounded-xl p-3.5 border border-violet-100 h-full">
                                    <div class="w-10 h-10 rounded-lg bg-violet-100 flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-hourglass-half text-violet-500 text-base"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xl font-black text-violet-700 leading-tight"><%= graceCount %></p>
                                        <p class="text-[11px] text-slate-500 font-semibold truncate">Grace Buffer Used</p>
                                    </div>
                                    <a href="/teacher/all-activities" class="ml-auto text-violet-600 hover:text-violet-800 text-xs font-bold whitespace-nowrap bg-white px-2 py-1 rounded-lg border border-violet-200 shadow-xs">Review →</a>
                                </div>

                                <!-- Active Forum Topics -->
                                <div class="flex items-center gap-3 bg-slate-50 rounded-xl p-3.5 border border-slate-200 h-full">
                                    <div class="w-10 h-10 rounded-lg bg-slate-100 flex items-center justify-center flex-shrink-0">
                                        <i class="fas fa-comments text-slate-500 text-base"></i>
                                    </div>
                                    <div class="min-w-0 flex-1">
                                        <p class="text-xl font-black text-slate-700 leading-tight"><%= forumActivity ? forumActivity.length : 0 %></p>
                                        <p class="text-[11px] text-slate-500 font-semibold truncate">Active Forum Threads</p>
                                    </div>
                                    <a href="/teacher/forums" class="ml-auto text-slate-600 hover:text-slate-800 text-xs font-bold whitespace-nowrap bg-white px-2 py-1 rounded-lg border border-slate-300 shadow-xs">Forums →</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════
                         ROW 3 — Performance Chart + Top Students
                    ══════════════════════════════════════════ -->
                    <div class="grid grid-cols-1 xl:grid-cols-3 gap-4 mb-5 items-stretch">

                        <!-- Weekly Class Performance Chart -->
                        <div class="xl:col-span-2 glass-card rounded-2xl p-5 border border-indigo-100 flex flex-col justify-between h-full">
                            <div class="flex items-center justify-between mb-2">
                                <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                    <i class="fas fa-chart-line text-indigo-500 mr-2"></i>Performance Overview & Class Scores
                                </h3>
                                <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Weekly Trends</span>
                            </div>
                            <div class="relative flex-1 min-h-[200px] max-h-[240px] my-2">
                                <canvas id="performanceChart"></canvas>
                            </div>
                            <!-- Metric breakdown pills -->
                            <div class="flex flex-wrap gap-2 pt-2 border-t border-slate-100">
                                <span class="bg-cyan-100 text-cyan-700 text-[11px] font-bold px-3 py-1 rounded-full">
                                    Avg Accuracy: <%= Math.round(stats.avgAccuracy || 0) %>%
                                </span>
                                <span class="bg-emerald-100 text-emerald-700 text-[11px] font-bold px-3 py-1 rounded-full">
                                    Total Attempts: <%= stats.totalAttempts || 0 %>
                                </span>
                                <span class="bg-amber-100 text-amber-700 text-[11px] font-bold px-3 py-1 rounded-full">
                                    Classes: <%= classes.length %>
                                </span>
                                <span class="bg-rose-100 text-rose-700 text-[11px] font-bold px-3 py-1 rounded-full">
                                    Struggles: <%= needsAttention ? needsAttention.length : 0 %>
                                </span>
                            </div>
                        </div>

                        <!-- Top Students Leaderboard -->
                        <div class="glass-card rounded-2xl p-5 border border-amber-100 flex flex-col justify-between h-full">
                            <div class="flex items-center justify-between mb-3">
                                <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                    <i class="fas fa-trophy text-amber-500 mr-2"></i>Top Students Leaderboard
                                </h3>
                                <a href="/teacher/reports" class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline">All →</a>
                            </div>
                            <div class="space-y-2 flex-1 overflow-y-auto pr-1 custom-scrollbar min-h-[190px] max-h-[220px]">
                                <% if (leaderboard && leaderboard.length > 0) { %>
                                    <% leaderboard.slice(0, 5).forEach((student, index) => { %>
                                    <div class="flex items-center gap-3 p-2 rounded-xl hover:bg-amber-50/60 transition border border-transparent hover:border-amber-100">
                                        <span class="text-sm font-black w-5 text-center
                                            <%= index === 0 ? 'text-amber-500' : index === 1 ? 'text-slate-400' : index === 2 ? 'text-amber-700' : 'text-slate-300' %>">
                                            <%= index + 1 %>
                                        </span>
                                        <img src="/profile_uploads/<%= student.profile_pic || 'default_avatar.png' %>"
                                             class="w-8 h-8 rounded-lg object-cover border border-amber-200 flex-shrink-0">
                                        <div class="flex-1 min-w-0">
                                            <p class="text-xs font-bold text-indigo-900 truncate">
                                                <%= student.first_name %> <%= student.last_name %>
                                            </p>
                                            <p class="text-[10px] text-slate-400">Score: <%= (student.total_points || 0).toLocaleString() %> Pts</p>
                                        </div>
                                        <div class="text-right flex-shrink-0">
                                            <p class="text-xs font-black text-amber-600"><%= (student.total_points || 0).toLocaleString() %></p>
                                            <p class="text-[9px] text-slate-400 uppercase">PTS</p>
                                        </div>
                                    </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="flex flex-col items-center justify-center h-full text-center py-6 text-slate-400">
                                        <i class="fas fa-trophy text-2xl mb-2 opacity-20"></i>
                                        <p class="text-xs">No student data recorded yet.</p>
                                    </div>
                                <% } %>
                            </div>
                            <div class="pt-2 mt-auto border-t border-amber-100 flex items-center justify-between text-[10px] font-bold text-slate-400">
                                <span>High scoring chemistry champions</span>
                                <span class="text-amber-600 font-black"><i class="fas fa-medal mr-1"></i>Ranked</span>
                            </div>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════
                         ROW 4 — Submissions Feed + Subject Radar
                    ══════════════════════════════════════════ -->
                    <div class="grid grid-cols-1 xl:grid-cols-3 gap-5 mb-5 items-stretch">

                        <!-- Recent Submissions Feed (Takes 2/3 of space) -->
                        <div class="xl:col-span-2 glass-card rounded-2xl p-5 border border-slate-200 flex flex-col justify-between h-full">
                            <div>
                                <div class="flex items-center justify-between mb-3 flex-wrap gap-2">
                                    <div>
                                        <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm flex items-center gap-2">
                                            <i class="fas fa-scroll text-slate-500"></i> Recent Submissions Feed
                                        </h3>
                                        <p class="text-[10px] text-slate-400 font-bold uppercase tracking-widest mt-0.5">Real-time submissions with grace buffer transparency</p>
                                    </div>
                                    <div class="flex items-center gap-2 flex-wrap">
                                        <a href="/teacher/all-activities" class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline px-2 py-1 flex items-center gap-1">
                                            <span>Full Feed</span>
                                            <i class="fas fa-arrow-right text-[9px]"></i>
                                        </a>
                                    </div>
                                </div>

                                <!-- Dynamic height scroll area to prevent dead space -->
                                <div class="space-y-1.5 overflow-y-auto pr-2 custom-scrollbar min-h-[220px] max-h-[380px]">
                                    <% if (recentScores && recentScores.length > 0) { %>
                                        <% recentScores.slice(0, 10).forEach(score => { %>
                                        <a href="<%= score.target_url || ('/teacher/analysis/' + score.score_id + (score.student_id ? '?student_id=' + score.student_id : '')) %>" class="flex items-center justify-between p-2.5 rounded-xl hover:bg-slate-50 transition border border-transparent hover:border-slate-100 group">
                                            <div class="flex items-center gap-3 min-w-0">
                                                <% if (score.is_versus) { %>
                                                    <div class="relative flex items-center flex-shrink-0 -space-x-2">
                                                        <img src="/profile_uploads/<%= score.student_pic || 'default_avatar.png' %>" class="w-8 h-8 rounded-xl object-cover ring-2 ring-white z-10 group-hover:ring-cyan-400 transition" title="<%= score.first_name %> <%= score.last_name %>">
                                                        <img src="/profile_uploads/<%= score.p2_pic || 'default_avatar.png' %>" class="w-8 h-8 rounded-xl object-cover ring-2 ring-white z-0 group-hover:ring-cyan-400 transition" title="<%= score.p2_first_name %> <%= score.p2_last_name %>">
                                                        <div class="absolute -bottom-1 left-3 z-20 px-1 py-0.2 bg-slate-900 text-[7px] font-black text-white rounded shadow-xs border border-white">VS</div>
                                                    </div>
                                                    <div class="min-w-0">
                                                        <div class="flex items-center gap-2 flex-wrap">
                                                            <p class="text-xs font-bold text-indigo-900 group-hover:text-cyan-600 transition truncate">
                                                                <%= score.first_name %> <%= score.last_name %> <span class="text-rose-500 font-extrabold text-[11px] mx-0.5">vs</span> <%= score.p2_first_name %> <%= score.p2_last_name %>
                                                            </p>
                                                            <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[8px] font-black bg-rose-50 text-rose-700 border border-rose-200 flex-shrink-0">
                                                                <i class="fas fa-bolt text-[7px]"></i> DUAL
                                                            </span>
                                                            <% if (score.winner === 'Tie' || score.winner === 'TIE') { %>
                                                                <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[8px] font-black bg-slate-100 text-slate-700 border border-slate-200 flex-shrink-0">
                                                                    <i class="fas fa-handshake text-[7px] text-slate-500"></i> DRAW
                                                                </span>
                                                            <% } else if (score.winner === 'P1') { %>
                                                                <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[8px] font-black bg-emerald-50 text-emerald-700 border border-emerald-200 flex-shrink-0">
                                                                    <i class="fas fa-trophy text-[7px] text-amber-500"></i> <%= score.first_name %> WON
                                                                </span>
                                                            <% } else if (score.winner === 'P2') { %>
                                                                <span class="inline-flex items-center gap-1 px-1.5 py-0.2 rounded text-[8px] font-black bg-purple-50 text-purple-700 border border-purple-200 flex-shrink-0">
                                                                    <i class="fas fa-trophy text-[7px] text-amber-500"></i> <%= score.p2_first_name %> WON
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <p class="text-[10px] text-slate-400 font-semibold truncate">
                                                            <span class="text-indigo-600 font-bold"><%= score.subject_name %></span> • <%= score.assessment_name %>
                                                        </p>
                                                    </div>
                                                <% } else { %>
                                                    <div class="relative flex-shrink-0">
                                                        <img src="/profile_uploads/<%= score.student_pic || 'default_avatar.png' %>" class="w-9 h-9 rounded-xl object-cover ring-2 ring-slate-100 group-hover:ring-cyan-400 transition">
                                                        <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 border-2 border-white rounded-full"></div>
                                                    </div>
                                                    <div class="min-w-0">
                                                        <div class="flex items-center gap-2">
                                                            <p class="text-xs font-bold text-indigo-900 group-hover:text-cyan-600 transition truncate"><%= score.first_name %> <%= score.last_name %></p>
                                                            <% if (score.is_grace_period) { %>
                                                                <span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded-md text-[8px] font-black bg-amber-100 text-amber-800 border border-amber-300 flex-shrink-0">
                                                                    <i class="fas fa-clock text-[7px]"></i> Grace (+<%= score.grace_minutes_used || 1 %>m)
                                                                </span>
                                                            <% } %>
                                                        </div>
                                                        <p class="text-[10px] text-slate-400 font-semibold truncate">
                                                            <span class="text-indigo-600 font-bold"><%= score.subject_name %></span> • <%= score.assessment_name %>
                                                            <% if (score.file_path) { %>
                                                                <i class="fas fa-paperclip text-[9px] text-indigo-400 ml-1" title="Deliverable attached"></i>
                                                            <% } %>
                                                        </p>
                                                    </div>
                                                <% } %>
                                            </div>
                                            <div class="text-right flex items-center gap-3.5 flex-shrink-0">
                                                <div>
                                                    <% if (score.is_versus) { %>
                                                        <p class="text-xs font-black text-indigo-900"><%= score.score_obtained %> - <%= score.p2_score %> <span class="text-slate-300">/ <%= score.total_items %></span></p>
                                                    <% } else { %>
                                                        <p class="text-xs font-black text-indigo-900"><%= score.score_obtained !== null ? score.score_obtained : 'Pending' %> <span class="text-slate-300">/ <%= score.total_items %></span></p>
                                                    <% } %>
                                                    <p class="text-[9px] text-slate-400 font-bold uppercase"><%= score.topic_name %></p>
                                                </div>
                                                <div class="px-2 py-0.5 bg-emerald-50 text-emerald-700 rounded-lg text-center border border-emerald-200 min-w-[50px]">
                                                    <p class="text-[9px] font-black">+<%= score.exp_gained || 0 %></p>
                                                    <p class="text-[7px] font-black uppercase"><%= score.is_versus ? 'EXP EACH' : 'EXP' %></p>
                                                </div>
                                                <i class="fas fa-chevron-right text-slate-300 group-hover:text-cyan-500 transition text-xs"></i>
                                            </div>
                                        </a>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="flex flex-col items-center justify-center h-48 text-slate-400">
                                            <i class="fas fa-inbox text-3xl mb-2 opacity-20"></i>
                                            <p class="text-xs font-bold">No submissions recorded yet.</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <div class="pt-2.5 mt-3 border-t border-slate-100 flex items-center justify-between text-[11px] font-bold text-slate-400">
                                <span>Recent student chemical reactions & score logs</span>
                            </div>
                        </div>

                        <!-- Subject Focus Radar (Takes 1/3 of space) -->
                        <div class="glass-card rounded-2xl p-5 border border-violet-100 flex flex-col justify-between h-full">
                            <div>
                                <div class="flex items-center justify-between mb-3">
                                    <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                        <i class="fas fa-chart-pie text-violet-500 mr-2"></i>Subject Focus Radar
                                    </h3>
                                    <span class="text-[9px] bg-indigo-50 text-indigo-500 px-2 py-0.5 rounded-lg font-black uppercase border border-indigo-100">All Subjects</span>
                                </div>

                                <!-- Focus Chart Section -->
                                <div class="bg-slate-50/50 rounded-2xl p-3 mb-3 border border-slate-100">
                                    <div class="h-40 w-full">
                                        <canvas id="subjectFocusChart"></canvas>
                                    </div>
                                    <div class="grid grid-cols-2 gap-2 mt-2 pt-2 border-t border-slate-200/60 text-center">
                                        <div class="bg-white rounded-lg p-1.5 border border-slate-100">
                                            <p class="text-xs font-black text-indigo-900"><%= subjectAssessmentStats ? subjectAssessmentStats.length : 0 %></p>
                                            <p class="text-[9px] text-slate-400 uppercase font-bold">Subjects Tracked</p>
                                        </div>
                                        <div class="bg-white rounded-lg p-1.5 border border-slate-100">
                                            <% const focusCount = (subjectAssessmentStats || []).filter(s => s.completion_percent < 50).length; %>
                                            <p class="text-xs font-black <%= focusCount > 0 ? 'text-rose-600' : 'text-emerald-600' %>"><%= focusCount %></p>
                                            <p class="text-[9px] text-slate-400 uppercase font-bold">Needs Focus</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Completion Rows -->
                                <div>
                                    <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1.5">Completion Details</p>
                                    <div class="space-y-1.5 overflow-y-auto pr-1 custom-scrollbar min-h-[110px] max-h-[170px]">
                                        <% if (subjectAssessmentStats && subjectAssessmentStats.length > 0) { %>
                                            <% subjectAssessmentStats.forEach(sub => { %>
                                                <div class="p-2 rounded-xl bg-slate-50/80 border border-slate-100 hover:border-indigo-300 hover:bg-white transition">
                                                    <div class="flex items-center justify-between mb-1">
                                                        <div class="min-w-0 pr-2">
                                                            <span class="text-xs font-black text-indigo-900 truncate"><%= sub.subject_name %></span>
                                                            <span class="ml-1 text-[8px] bg-indigo-100 text-indigo-500 px-1.5 py-0.5 rounded font-black"><%= sub.subject_code %></span>
                                                        </div>
                                                        <div class="text-right flex-shrink-0">
                                                            <span class="text-[10px] font-black <%= sub.completion_percent < 40 ? 'text-rose-600' : sub.completion_percent < 70 ? 'text-amber-600' : 'text-emerald-600' %>">
                                                                <%= sub.completion_percent %>%
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div class="w-full bg-slate-200 rounded-full h-1.5">
                                                        <div class="h-1.5 rounded-full transition-all duration-500 <%= sub.completion_percent < 40 ? 'bg-rose-500' : sub.completion_percent < 70 ? 'bg-amber-500' : 'bg-emerald-500' %>"
                                                             style="width: <%= sub.completion_percent %>%"></div>
                                                    </div>
                                                    <div class="flex items-center justify-between mt-1 text-[8px] text-slate-400 font-bold">
                                                        <span><%= sub.students_completed %>/<%= sub.total_students %> studs</span>
                                                        <% if (sub.completion_percent < 50) { %>
                                                            <span class="text-rose-600 font-black uppercase"><i class="fas fa-triangle-exclamation"></i> Focus</span>
                                                        <% } %>
                                                    </div>
                                                </div>
                                            <% }) %>
                                        <% } else { %>
                                            <p class="text-center text-slate-400 text-xs py-4">No subject data available.</p>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <div class="pt-2 mt-2 border-t border-violet-100 flex items-center justify-between text-[10px] font-bold text-slate-400">
                                <span>Real-time completion telemetry</span>
                                <span class="text-violet-600 font-black">Target: 80%+</span>
                            </div>
                        </div>
                    </div>

                    <!-- ══════════════════════════════════════════
                         ROW 5 — Upcoming Events + Forum + Deadlines
                    ══════════════════════════════════════════ -->
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-5 items-stretch">

                        <!-- Upcoming Calendar Events -->
                        <div class="glass-card rounded-2xl p-5 border border-cyan-100 flex flex-col justify-between h-full">
                            <div>
                                <div class="flex items-center justify-between mb-2.5">
                                    <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                        <i class="fas fa-calendar text-cyan-500 mr-2"></i>Schedule & Events
                                    </h3>
                                    <button onclick="openEventModal()" class="w-7 h-7 flex items-center justify-center bg-cyan-500 text-white rounded-lg hover:bg-indigo-600 transition shadow-xs cursor-pointer" title="Create Event">
                                        <i class="fas fa-plus text-xs"></i>
                                    </button>
                                </div>

                                <!-- Calendar Month Picker -->
                                <div class="flex items-center justify-between mb-2 px-1">
                                    <span class="text-xs font-black text-indigo-900 uppercase tracking-widest" id="monthDisplay">Month Year</span>
                                    <div class="flex gap-1">
                                        <button onclick="changeMonth(-1)" class="w-6 h-6 flex items-center justify-center rounded-lg hover:bg-cyan-50 text-slate-400 hover:text-indigo-600 transition">
                                            <i class="fas fa-chevron-left text-[10px]"></i>
                                        </button>
                                        <button onclick="changeMonth(1)" class="w-6 h-6 flex items-center justify-center rounded-lg hover:bg-cyan-50 text-slate-400 hover:text-indigo-600 transition">
                                            <i class="fas fa-chevron-right text-[10px]"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="grid grid-cols-7 gap-1 text-center mb-1">
                                    <% ['S', 'M', 'T', 'W', 'T', 'F', 'S'].forEach(day => { %>
                                        <span class="text-[9px] font-black text-slate-400 uppercase"><%= day %></span>
                                    <% }) %>
                                </div>
                                
                                <div class="grid grid-cols-7 gap-1 mb-2.5" id="calendarGrid"></div>

                                <!-- Events snippet -->
                                <div class="space-y-1.5 border-t border-slate-100 pt-2 overflow-y-auto max-h-24 custom-scrollbar">
                                    <% if (events && events.length > 0) { %>
                                        <% events.slice(0, 3).forEach(event => { %>
                                        <%
                                            const evtColor = {
                                                'Material' : 'bg-emerald-100 text-emerald-700',
                                                'Deadline' : 'bg-rose-100 text-rose-700',
                                                'Exam'     : 'bg-amber-100 text-amber-700',
                                                'Holiday'  : 'bg-sky-100 text-sky-700',
                                                'Arcade Session': 'bg-fuchsia-100 text-fuchsia-700'
                                            }[event.event_type] || 'bg-slate-100 text-slate-600';
                                        %>
                                        <div class="flex items-center gap-2 p-1.5 rounded-lg border border-slate-100 hover:bg-cyan-50/40 transition">
                                            <span class="<%= evtColor %> text-[9px] font-black px-1.5 py-0.5 rounded-md uppercase flex-shrink-0">
                                                <%= event.event_type %>
                                            </span>
                                            <p class="text-[11px] font-bold text-indigo-900 truncate flex-1 min-w-0"><%= event.event_title %></p>
                                            <span class="text-[9px] text-slate-400 flex-shrink-0">
                                                <%= new Date(event.event_date).toLocaleDateString('en-PH', {month:'short', day:'numeric'}) %>
                                            </span>
                                        </div>
                                        <% }) %>
                                    <% } else { %>
                                        <p class="text-[10px] text-slate-400 text-center py-1">No upcoming events scheduled.</p>
                                    <% } %>
                                </div>
                            </div>

                            <div class="pt-2 mt-2 border-t border-cyan-100 flex items-center justify-between text-[10px] font-bold text-slate-400">
                                <span>Synchronized calendar</span>
                                <button onclick="openEventModal()" class="text-cyan-600 hover:underline cursor-pointer">+ Add Event</button>
                            </div>
                        </div>

                        <!-- Forum Activity / Discussion Lab -->
                        <div class="glass-card rounded-2xl p-5 border border-orange-100 flex flex-col justify-between h-full">
                            <div class="flex-1 flex flex-col min-w-0">
                                <div class="flex items-center justify-between mb-3">
                                    <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                        <i class="fas fa-comments text-orange-500 mr-2"></i>Discussion Lab
                                    </h3>
                                    <a href="/teacher/forums" class="text-[10px] font-black text-cyan-600 uppercase tracking-widest hover:underline">All →</a>
                                </div>
                                <div class="grid grid-cols-2 gap-2.5 mb-3">
                                    <div class="bg-orange-50 rounded-xl p-2.5 text-center border border-orange-100">
                                        <p class="text-2xl font-black text-orange-700"><%= forumActivity ? forumActivity.length : 0 %></p>
                                        <p class="text-[10px] text-slate-400 font-bold uppercase">Topics</p>
                                    </div>
                                    <div class="bg-amber-50 rounded-xl p-2.5 text-center border border-amber-100">
                                        <p class="text-2xl font-black text-amber-700"><%= pinnedDiscussions ? pinnedDiscussions.length : 0 %></p>
                                        <p class="text-[10px] text-slate-400 font-bold uppercase">Pinned</p>
                                    </div>
                                </div>
                                <div class="space-y-2 overflow-y-auto pr-1 custom-scrollbar flex-1 min-h-[180px] max-h-[300px] mb-2">
                                    <% if (forumActivity && forumActivity.length > 0) { %>
                                        <% forumActivity.slice(0, 10).forEach(forum => { %>
                                        <a href="/teacher/forums/view/<%= forum.forum_id %>" class="block bg-slate-50/80 rounded-xl p-2.5 border border-slate-100 hover:bg-orange-50/60 hover:border-orange-300 transition group cursor-pointer shadow-2xs">
                                            <div class="flex items-center justify-between gap-2 mb-0.5">
                                                <p class="text-[10px] font-black text-orange-600 truncate flex items-center gap-1 min-w-0 flex-1">
                                                    <% if (forum.is_pinned) { %><i class="fas fa-thumbtack text-amber-500 text-[8px] flex-shrink-0"></i><% } %>
                                                    <span class="truncate"><%= forum.topic_name || 'Discussion' %></span>
                                                </p>
                                                <span class="text-[9px] font-black px-1.5 py-0.5 rounded bg-orange-100 text-orange-700 group-hover:bg-orange-200 flex-shrink-0">LAB</span>
                                            </div>
                                            <p class="text-xs font-bold text-indigo-900 group-hover:text-orange-700 transition truncate"><%= forum.title %></p>
                                        </a>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="flex flex-col items-center justify-center flex-1 h-32 text-center text-slate-400">
                                            <i class="fas fa-comments text-2xl mb-1 opacity-20"></i>
                                            <p class="text-xs font-medium">No discussion topics created yet.</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <div class="pt-2 mt-auto border-t border-orange-100 flex items-center justify-between text-[10px] font-bold text-slate-400">
                                <span>Collaborative inquiry spaces</span>
                            </div>
                        </div>

                        <!-- Atomic Deadlines -->
                        <div class="glass-card rounded-2xl p-5 border border-fuchsia-100 flex flex-col justify-between h-full">
                            <div class="flex-1 flex flex-col min-w-0 min-h-0">
                                <div class="flex items-center justify-between mb-3 flex-shrink-0">
                                    <h3 class="font-black text-indigo-900 uppercase tracking-tight text-sm">
                                        <i class="fas fa-hourglass-half text-fuchsia-500 mr-2"></i>Atomic Deadlines
                                    </h3>
                                    <span class="text-[10px] font-black text-slate-400 uppercase tracking-widest">Upcoming</span>
                                </div>
                                <div class="space-y-1.5 overflow-y-auto pr-1 custom-scrollbar flex-1 min-h-0 mb-2">
                                    <% if (pendingAssessments && pendingAssessments.length > 0) { %>
                                        <% pendingAssessments.slice(0, 10).forEach(task => { %>
                                        <a href="/teacher/grading-workspace/<%= task.assessment_id %>" class="block relative pl-3.5 py-1 px-1.5 group rounded-xl hover:bg-fuchsia-50/60 transition cursor-pointer">
                                            <div class="absolute left-0 top-1 bottom-1 w-1 bg-gradient-to-b from-fuchsia-500 to-indigo-600 rounded-full group-hover:w-1.5 transition-all"></div>
                                            <div class="flex justify-between items-center gap-2">
                                                <div class="min-w-0 flex-1">
                                                    <p class="text-xs font-black text-indigo-950 truncate group-hover:text-fuchsia-700 transition leading-snug"><%= task.assessment_name %></p>
                                                    <p class="text-[10px] font-bold text-slate-400 truncate leading-snug">
                                                        <span class="text-cyan-600 font-extrabold">Q<%= task.quarter %></span> • <%= task.topic_name %> • <span class="uppercase text-[9px] font-black text-slate-400"><%= task.type %></span> • <%= task.total_items %> Items
                                                    </p>
                                                </div>
                                                <div class="text-right flex-shrink-0 flex flex-col items-end">
                                                    <span class="text-[8px] px-1.5 py-0.5 rounded font-black uppercase <%= task.is_unlocked === 1 ? 'bg-emerald-500 text-white' : 'bg-slate-200 text-slate-500' %>">
                                                        <%= task.is_unlocked === 1 ? 'LIVE' : 'IDLE' %>
                                                    </span>
                                                    <p class="text-[9px] font-black text-indigo-400 uppercase mt-0.5">
                                                        <%= new Date(task.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %>
                                                    </p>
                                                </div>
                                            </div>
                                        </a>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="flex flex-col items-center justify-center flex-1 h-32 text-center text-slate-400">
                                            <i class="fas fa-clipboard-check text-2xl mb-1 opacity-20"></i>
                                            <p class="text-xs font-bold">No pending assessments.</p>
                                        </div>
                                    <% } %>
                                </div>
                            </div>

                            <div class="pt-2 mt-auto border-t border-fuchsia-100 flex items-center justify-between text-[10px] font-bold text-slate-400 flex-shrink-0">
                                <span>Assessment pipeline</span>
                                <span class="text-fuchsia-600 font-black"><i class="fas fa-bolt mr-1"></i><%= pendingAssessments ? pendingAssessments.length : 0 %> Active</span>
                            </div>
                        </div>
                    </div>

                </div>

                <footer class="bg-white border-t border-cyan-100 py-4 px-6 md:px-8 mt-auto w-full">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-2 max-w-[1600px] mx-auto">
                        <p class="text-[11px] text-indigo-400 font-black uppercase tracking-tight">
                            &copy; 2026 <span class="text-cyan-600">Chemistry Arcade</span> - Mabini College v2.5.0
                        </p>
                        <div class="flex gap-4">
                            <a href="/teacher/classes" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest">Class Lab</a>
                            <a href="/teacher/reports" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest border-l pl-4 border-indigo-100">Performance Analytics</a>
                        </div>
                    </div>
                </footer>
            </div>
        </main>
    </div>

    <script>
        // 1. Sidebar Toggle Logic
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }

        // 2. Performance Chart Initialization (Chart.js) - 100% Dynamic & Accurate Weekly Trends
        const weeklyTrends = <%- JSON.stringify(typeof weeklyTrends !== 'undefined' ? weeklyTrends : { labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'], scores: [0, 0, 0, 0, 0, 0, 0], counts: [0, 0, 0, 0, 0, 0, 0] }) %>;
        const ctx = document.getElementById('performanceChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: weeklyTrends.labels || ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{
                    label: 'Class Score (%)',
                    data: weeklyTrends.scores || [0, 0, 0, 0, 0, 0, 0],
                    borderColor: '#06b6d4',
                    backgroundColor: 'rgba(6, 182, 212, 0.1)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 4,
                    pointRadius: 6,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#4f46e5',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: '#0d1a2e',
                        titleColor: '#67e8f9',
                        bodyColor: '#a5b4fc',
                        borderColor: '#1e3a5f',
                        borderWidth: 1,
                        padding: 10,
                        callbacks: {
                            label: function(context) {
                                const idx = context.dataIndex;
                                const count = (weeklyTrends.counts && weeklyTrends.counts[idx]) ? weeklyTrends.counts[idx] : 0;
                                return ` Avg Score: ${context.parsed.y}% (${count} submission${count !== 1 ? 's' : ''})`;
                            }
                        }
                    }
                },
                scales: {
                    y: {
                        beginAtZero: true,
                        max: 100,
                        grid: { color: '#e2e8f0' },
                        ticks: {
                            font: { weight: 'bold' },
                            callback: function(v) { return v + '%'; }
                        }
                    },
                    x: {
                        grid: { display: false },
                        ticks: { font: { weight: 'bold' } }
                    }
                }
            }
        });


        // Subject Focus Bar Chart
        const subjectStats = <%- JSON.stringify(subjectAssessmentStats || []) %>;
        if (subjectStats.length > 0) {
            const ctxSubject = document.getElementById('subjectFocusChart').getContext('2d');
            new Chart(ctxSubject, {
                type: 'bar',
                data: {
                    labels: subjectStats.map(s => s.subject_code || s.subject_name),
                    datasets: [
                        {
                            label: '% Students Completed',
                            data: subjectStats.map(s => s.completion_percent),
                            backgroundColor: subjectStats.map(s =>
                                s.completion_percent < 40 ? 'rgba(239,68,68,0.8)' :
                                s.completion_percent < 70 ? 'rgba(245,158,11,0.8)' :
                                'rgba(6,182,212,0.85)'
                            ),
                            borderRadius: 10,
                            borderSkipped: false,
                            yAxisID: 'y',
                        },
                        {
                            label: 'Total Assessments',
                            data: subjectStats.map(s => s.total_assessments),
                            backgroundColor: 'rgba(99,102,241,0.15)',
                            borderColor: 'rgba(99,102,241,0.4)',
                            borderWidth: 2,
                            borderRadius: 10,
                            borderSkipped: false,
                            type: 'bar',
                            yAxisID: 'y2',
                        }
                    ]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: { mode: 'index', intersect: false },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: '#0d1a2e',
                            titleColor: '#67e8f9',
                            bodyColor: '#a5b4fc',
                            borderColor: '#1e3a5f',
                            borderWidth: 1,
                            padding: 12,
                            callbacks: {
                                label: (ctx) => {
                                    if (ctx.datasetIndex === 0) return ` ${ctx.parsed.y}% students completed`;
                                    return ` ${ctx.parsed.y} assessments total`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            max: 100,
                            position: 'left',
                            grid: { color: '#e2e8f0' },
                            ticks: {
                                font: { weight: 'bold', size: 10 },
                                callback: v => v + '%'
                            }
                        },
                        y2: {
                            beginAtZero: true,
                            position: 'right',
                            grid: { drawOnChartArea: false },
                            ticks: {
                                font: { weight: 'bold', size: 10 },
                                stepSize: 1
                            }
                        },
                        x: {
                            grid: { display: false },
                            ticks: { font: { weight: 'bold', size: 11 } }
                        }
                    }
                }
            });
        }

        // 3. Dynamic Calendar Logic
        // Passing EJS data to Client-side JS
        // Change this line in your script tag:
        const databaseEvents = [
            ...<%- JSON.stringify(pendingAssessments || []) %>.map(a => ({...a, due_date: a.due_date, assessment_type: a.assessment_type})),
            ...<%- JSON.stringify(events || []) %>.map(e => ({...e, due_date: e.event_date, event_type: e.event_type}))
        ];
        
        let currentDate = new Date();
        let currentMonth = currentDate.getMonth();
        let currentYear = currentDate.getFullYear();

        function renderCalendar() {
            const grid = document.getElementById('calendarGrid');
            const monthLabel = document.getElementById('monthDisplay');
            if (!grid || !monthLabel) return; // Guard clause

            grid.innerHTML = '';

            const firstDay = new Date(currentYear, currentMonth, 1).getDay();
            const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
            
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            monthLabel.innerText = `${monthNames[currentMonth]} ${currentYear}`;

            // Add padding for the start of the month
            for (let i = 0; i < firstDay; i++) {
                grid.innerHTML += `<div></div>`;
            }

            // Loop through each day of the month
            for (let day = 1; day <= daysInMonth; day++) {
                // Create a comparison string for the date (YYYY-MM-DD)
                const dateString = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                
                // Filter events from DB that match this specific day
                const dayEvents = databaseEvents.filter(e => {
                    const eventDate = new Date(e.due_date).toISOString().split('T')[0];
                    return eventDate === dateString;
                });

                let eventStyle = "text-indigo-900 hover:bg-cyan-50 hover:border-cyan-100";
                let tooltip = "";

                if (dayEvents.length > 0) {
                    // Style based on the first event type found
                    const type = dayEvents[0].type || "Exam";
                    const colors = {
                        'Exam': 'bg-rose-100 text-rose-600 border-rose-200',
                        'Material': 'bg-blue-100 text-blue-600 border-blue-200',
                        'Deadline': 'bg-amber-100 text-amber-600 border-amber-200',
                        'Arcade Session': 'bg-emerald-100 text-emerald-600 border-emerald-200'
                    };
                    eventStyle = colors[type] || 'bg-cyan-100 text-cyan-600 border-cyan-200';

                    // Construct Hover Details (Tooltip)
                    tooltip = `
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-3 bg-indigo-950 text-white rounded-2xl text-[10px] opacity-0 pointer-events-none group-hover:opacity-100 transition-all z-50 shadow-xl border border-white/10">
                        <p class="font-black text-cyan-400 mb-1 uppercase italic underline tracking-tighter">Event Details</p>
                        ${dayEvents.map(e => `
                            <div class="mb-2 last:mb-0 border-b border-white/10 pb-1 last:border-0">
                                <p class="font-black text-white leading-tight">${e.assessment_name || e.event_title}</p>
                                <p class="text-cyan-200 opacity-80 uppercase text-[8px] font-bold mt-0.5">${e.topic_name || 'Class Event'}</p>
                            </div>
                        `).join('')}
                        <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[6px] border-t-indigo-950"></div>
                    </div>`;
                }

                grid.innerHTML += `
                    <div class="relative group">
                        <div class="aspect-square flex items-center justify-center text-[11px] font-bold rounded-xl border border-transparent transition-all cursor-pointer ${eventStyle}">
                            ${day}
                        </div>
                        ${tooltip}
                    </div>
                `;
            }
        }

        function changeMonth(delta) {
            currentMonth += delta;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            } else if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            }
            renderCalendar();
        }

        // 4. Modal and Form Controls
        function openEventModal() {
            const modal = document.getElementById('eventModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeEventModal() {
            const modal = document.getElementById('eventModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function toggleDurationFields() {
            const type = document.getElementById('durationType').value;
            document.getElementById('dateRangeFields').classList.toggle('hidden', type !== 'DateRange');
            document.getElementById('minuteFields').classList.toggle('hidden', type !== 'Minutes');
        }

        function toggleRepeatFields() {
            const isChecked = document.getElementById('isRepeatable').checked;
            document.getElementById('repeatCycle').classList.toggle('hidden', !isChecked);
        }

        // Initialize calendar immediately on page load
        document.addEventListener('DOMContentLoaded', renderCalendar);

        async function submitDashboardEvent(e) {
            e.preventDefault();
            const form = e.target;
            const submitBtn = form.querySelector('button[type="submit"]');
            const origText = submitBtn ? submitBtn.innerHTML : '';
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i> Saving...';
            }
            try {
                const fd = new FormData(form);
                const res = await fetch('/teacher/events/add', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                        'X-Requested-With': 'XMLHttpRequest',
                        'Accept': 'application/json'
                    },
                    body: new URLSearchParams(fd)
                });
                const data = await res.json().catch(() => ({}));
                if (!res.ok || data.success === false) {
                    throw new Error(data.error || 'Failed to save event');
                }
                databaseEvents.push({
                    event_id: data.event_id || Date.now(),
                    subject_id: fd.get('subject_id'),
                    event_title: fd.get('event_title'),
                    event_description: fd.get('event_description') || '',
                    event_type: fd.get('event_type') || 'Exam',
                    type: fd.get('event_type') || 'Exam',
                    event_date: fd.get('event_date'),
                    due_date: fd.get('event_date')
                });
                renderCalendar();
                form.reset();
                toggleDurationFields();
                toggleRepeatFields();
                closeEventModal();
            } catch (err) {
                console.error('Error adding event:', err);
                alert(err.message || 'Failed to save event.');
            } finally {
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = origText;
                }
            }
        }

        // ── Profile dropdown ──────────────────────────────────
        function toggleProfileDropdown() {
            document.getElementById('profileDropdown').classList.toggle('open');
        }
        // Close when clicking outside
        document.addEventListener('click', function(e) {
            const wrap = document.getElementById('profileDropdownWrap');
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById('profileDropdown').classList.remove('open');
            }
        });
    </script>

    <div id="eventModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
        <div class="absolute inset-0 bg-indigo-950/60 backdrop-blur-sm" onclick="closeEventModal()"></div>
        <div class="relative bg-white w-full max-w-md rounded-[2.5rem] shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-300">
            <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <h3 class="text-lg font-black text-indigo-950 italic uppercase tracking-tight">Create New Event</h3>
                <button onclick="closeEventModal()" class="text-slate-400 hover:text-rose-500 transition"><i class="fas fa-times text-xl"></i></button>
            </div>
            
            <form id="dashboardEventForm" action="/teacher/events/add" method="POST" onsubmit="submitDashboardEvent(event)" class="p-6 space-y-4 max-h-[75vh] overflow-y-auto no-scrollbar">
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Subject</label>
                    <select name="subject_id" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm focus:ring-2 focus:ring-cyan-500 outline-none">
                        <% classes.forEach(cls => { %>
                            <option value="<%= cls.subject_id %>"><%= cls.subject_name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-2">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Event Title</label>
                        <input type="text" name="event_title" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm outline-none focus:ring-2 focus:ring-cyan-500">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Description</label>
                        <textarea name="event_description" rows="2" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm outline-none focus:ring-2 focus:ring-cyan-500"></textarea>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Type</label>
                        <select name="event_type" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm outline-none">
                            <option>Material</option>
                            <option>Deadline</option>
                            <option>Exam</option>
                            <option>Holiday</option>
                            <option>Arcade Session</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Date</label>
                        <input type="date" name="event_date" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm outline-none">
                    </div>
                </div>

                <div class="p-4 bg-cyan-50 rounded-2xl border border-cyan-100">
                    <label class="block text-[10px] font-black uppercase tracking-widest text-cyan-400 mb-3">Duration Settings</label>
                    <select name="duration_type" id="durationType" onchange="toggleDurationFields()" class="w-full px-4 py-2 bg-white border border-cyan-200 rounded-xl text-sm outline-none mb-3">
                        <option value="None">No Duration</option>
                        <option value="DateRange">Date Range</option>
                        <option value="Minutes">Set in Minutes</option>
                    </select>
                    <div id="dateRangeFields" class="hidden grid grid-cols-2 gap-3">
                        <input type="datetime-local" name="start_date" class="px-3 py-2 bg-white border border-cyan-200 rounded-xl text-[10px]">
                        <input type="datetime-local" name="end_date" class="px-3 py-2 bg-white border border-cyan-200 rounded-xl text-[10px]">
                    </div>
                    <div id="minuteFields" class="hidden">
                        <input type="number" name="duration_minutes" placeholder="Minutes?" class="w-full px-3 py-2 bg-white border border-cyan-200 rounded-xl text-[10px]">
                    </div>
                </div>

                <div class="flex items-center gap-3 p-4 bg-slate-50 rounded-2xl border border-slate-200">
                    <input type="checkbox" name="is_repeatable" id="isRepeatable" onchange="toggleRepeatFields()" class="w-5 h-5 accent-cyan-600">
                    <label for="isRepeatable" class="text-xs font-bold text-slate-700">Repeat event</label>
                    <select name="repeat_cycle" id="repeatCycle" class="hidden ml-auto px-3 py-2 bg-white border border-slate-200 rounded-xl text-[10px] outline-none">
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly</option>
                        <option value="Monthly">Monthly</option>
                    </select>
                </div>

                <button type="submit" class="w-full py-4 bg-indigo-950 text-white rounded-2xl font-bold hover:bg-cyan-600 transition-all shadow-lg">
                    Create Event
                </button>
            </form>
        </div>
    </div>


    <!-- =============================================
         NOTIFICATION PANEL
    ============================================= -->
    <%- include('../partials/notification-panel') %>

    <!-- Enterprise Assignment & Grading Modals -->
    <%- include('partials/comment_bank_modal') %>
    <%- include('partials/batch_message_modal') %>
</body>
</html>