        function renderShelfFiles(files) {
            const list = document.getElementById('shelfFilesList');
            document.getElementById('shelfFilesCount').textContent = files.length;
            if (files.length === 0) {
                list.innerHTML = `<div class="py-3.5 px-3 text-center bg-slate-50/70 rounded-xl border border-dashed border-slate-200 text-xs text-slate-400 font-medium">No files attached in this thread.</div>`;
                return;
            }
            list.innerHTML = files.map(f => {
                const ext = (f.file_path ? f.file_path.split('.').pop() : '').toLowerCase();
                let icon = 'fa-file-lines text-slate-500';
                if (['jpg', 'jpeg', 'png', 'gif', 'webp'].includes(ext)) icon = 'fa-image text-indigo-500';
                else if (['mp3', 'wav', 'ogg', 'webm', 'm4a'].includes(ext)) icon = 'fa-volume-high text-cyan-600';
                else if (['pdf'].includes(ext)) icon = 'fa-file-pdf text-rose-500';
                else if (['doc', 'docx'].includes(ext)) icon = 'fa-file-word text-blue-600';

                return `
                    <div class="flex items-center justify-between p-2.5 rounded-xl border border-slate-200/90 hover:border-indigo-300 hover:bg-indigo-50/20 transition-all bg-white shadow-2xs group">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <div class="w-7 h-7 rounded-lg bg-slate-50 border border-slate-200 flex items-center justify-center flex-shrink-0 text-xs">
                                <i class="fas ${icon}"></i>
                            </div>
                            <div class="min-w-0">
                                <span class="text-xs font-semibold text-slate-800 truncate block max-w-[150px]" title="${escHtml(f.file_name)}">${escHtml(f.file_name)}</span>
                                <span class="text-[10px] text-slate-400 truncate block">${escHtml(f.author_name || 'Participant')}</span>
                            </div>
                        </div>
                        <a href="/forum_uploads/${f.file_path}" download="${escHtml(f.file_name)}" 
                            class="w-7 h-7 rounded-lg hover:bg-indigo-100 text-slate-400 hover:text-indigo-600 flex items-center justify-center transition cursor-pointer"
                            title="Download file">
                            <i class="fas fa-download text-xs"></i>
                        </a>
