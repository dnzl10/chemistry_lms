        }

        async function deleteTopicDirect(rId) {
            if (!confirm('Are you sure you want to delete this discussion topic and all its responses?')) return;
            try {
                const res = await fetch(`/teacher/api/forum/reply/${rId}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    showToast('Topic deleted successfully', 'success');
                    const row = document.getElementById('topic-row-' + rId);
                    if (row) row.remove();
                    await refreshForumViewContent();
                } else {
                    showToast(data.error || 'Failed to delete topic', 'error');
                }
            } catch (err) {
                showToast('Error deleting topic', 'error');
            }
        }

        async function deleteActiveRootTopic() {
            if (!activeDiscussionData) return;
            deleteTopicDirect(activeDiscussionData.rootTopic.reply_id);
            closeDiscussionModal();
        }

        async function deleteSubReplyDirect(rId) {
            if (!confirm('Delete this response?')) return;
            try {
                const res = await fetch(`/teacher/api/forum/reply/${rId}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    showToast('Response deleted', 'success');
                    openDiscussionModal(activeDiscussionData.rootTopic.reply_id);
                }
            } catch (err) {
                showToast('Error deleting response', 'error');
            }
        }

        // Unmask author
        function openUnmaskAuthorModalDirect(replyId) {
            document.getElementById('unmaskTargetReplyId').value = replyId;
            document.getElementById('unmaskAuthorModal').classList.remove('hidden');
        }

        function openUnmaskAuthorModal(type) {
            if (!activeDiscussionData) return;
            document.getElementById('unmaskTargetReplyId').value = activeDiscussionData.rootTopic.reply_id;
            document.getElementById('unmaskAuthorModal').classList.remove('hidden');
        }

        function closeUnmaskAuthorModal() {
            document.getElementById('unmaskAuthorModal').classList.add('hidden');
        }

        async function confirmUnmaskAuthor(e) {
            e.preventDefault();
            const rId = document.getElementById('unmaskTargetReplyId').value;
            const reason = document.getElementById('unmaskReasonSelect').value;
            if (!reason) return;

            const btn = document.getElementById('confirmUnmaskBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin text-[10px]"></i> Unmasking...';

            try {
                const res = await fetch(`/teacher/api/forum/reply/${rId}/reveal`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ reason })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Student identity unmasked and audited', 'success');
                    closeUnmaskAuthorModal();
                    if (activeDiscussionData) openDiscussionModal(rId);
                    else await refreshForumViewContent();
                } else {
                    showToast(data.error || 'Failed to unmask author', 'error');
                }
            } catch (err) {
                showToast('Error unmasking author', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-key text-[10px]"></i> Authorize & Reveal';
            }
        }

        // New Topic Modal
        let selectedTopicFile = null;
        function openNewTopicModal() {
            document.getElementById('newTopicModal').classList.remove('hidden');
            document.getElementById('editorContentArea').focus();
        }
        function closeNewTopicModal() {
            document.getElementById('newTopicModal').classList.add('hidden');
        }
        function formatDoc(cmd, val = null) {
            document.execCommand(cmd, false, val);
            document.getElementById('editorContentArea').focus();
        }
        function handleTopicFileSelected(input) {
            if (input.files && input.files[0]) {
                selectedTopicFile = input.files[0];
                document.getElementById('topicFileNameDisplay').textContent = selectedTopicFile.name;
                document.getElementById('topicSelectedFileName').classList.remove('hidden');
            }
        }
        function removeTopicFile() {
            selectedTopicFile = null;
            document.getElementById('topicFileInput').value = '';
            document.getElementById('topicSelectedFileName').classList.add('hidden');
        }

        function openFormulaShortcutModal() {
            document.getElementById('formulaShortcutModal').classList.remove('hidden');
        }
        function closeFormulaShortcutModal() {
            document.getElementById('formulaShortcutModal').classList.add('hidden');
        }
        function insertFormulaText(formula) {
            if (!formula) return;
            formatDoc('insertHTML', `<b>${formula}</b> `);
            closeFormulaShortcutModal();
        }

        async function submitNewDiscussionTopic(e) {
            e.preventDefault();
            const title = document.getElementById('topicTitleInput').value.trim();
            const content = document.getElementById('editorContentArea').innerHTML.trim();
            if (!title || !content) return;

            const fd = new FormData();
            fd.append('forum_id', CURRENT_FORUM_ID);
            fd.append('reply_title', title);
            fd.append('reply_content', content);
            if (selectedTopicFile) fd.append('forum_file', selectedTopicFile);

            const btn = document.getElementById('topicSubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-spinner fa-spin text-[10px]"></i> Publishing...';

            try {
                const res = await fetch('/teacher/api/forum-discussion-topic', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) {
                    showToast('Discussion topic published!', 'success');
                    closeNewTopicModal();
                    const titleInput = document.getElementById('topicTitleInput');
                    const editorArea = document.getElementById('editorContentArea');
                    if (titleInput) titleInput.value = '';
                    if (editorArea) editorArea.innerHTML = '';
                    removeTopicFile();
                    await refreshForumViewContent();
                } else {
                    showToast(data.error || 'Failed to publish topic', 'error');
                }
            } catch (err) {
                showToast('Error publishing topic', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane text-[10px]"></i> Publish Discussion Topic';
            }
        }

        window.refreshForumViewContent = async function() {
            try {
                const res = await fetch(window.location.href, {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    cache: 'no-store'
                });
                if (!res.ok) return;
                const html = await res.text();
                const parser = new DOMParser();
                const newDoc = parser.parseFromString(html, 'text/html');

                ['forumHeroCard', 'topicsContainer', 'countAll', 'countStarred', 'countEndorsed', 'countReported', 'topicCountBadge'].forEach(id => {
                    const curEl = document.getElementById(id);
                    const newEl = newDoc.getElementById(id);
                    if (curEl && newEl) {
                        curEl.innerHTML = newEl.innerHTML;
                    }
                });

                if (typeof applyFilters === 'function') {
                    applyFilters();
                }
            } catch (err) {
                console.error('Error refreshing forum view content:', err);
            }
        };
    </script>
</body>

</html>