                </div>

                <!-- File Attachment Shelf -->
                <div
                    class="p-4 bg-slate-50 border-t border-slate-200/80 flex items-center justify-between flex-shrink-0">
                    <div class="flex items-center gap-3">
                        <label
                            class="px-3.5 py-2 rounded-xl bg-white border border-slate-200 text-xs font-bold text-slate-700 hover:bg-slate-50 transition cursor-pointer flex items-center gap-2">
                            <i class="fas fa-paperclip text-slate-500"></i>
                            <span>Attach Document or Audio</span>
                            <input type="file" id="topicFileInput" class="hidden"
                                onchange="handleTopicFileSelected(this)">
                        </label>
                        <span id="topicSelectedFileName"
                            class="hidden text-xs font-bold text-slate-700 bg-white px-3 py-1.5 rounded-xl border border-slate-200 flex items-center gap-2">
                            <span id="topicFileNameDisplay"></span>
                            <button type="button" onclick="removeTopicFile()"
                                class="text-slate-400 hover:text-rose-500 cursor-pointer"><i
                                    class="fas fa-times"></i></button>
                        </span>
                    </div>

                    <div class="flex items-center gap-2">
                        <button type="button" onclick="closeNewTopicModal()"
                            class="px-4 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-100 transition cursor-pointer">Cancel</button>
                        <button type="submit" id="topicSubmitBtn"
                            class="px-4 py-2 rounded-xl bg-gradient-to-r from-cyan-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white text-xs font-black shadow-md transition cursor-pointer flex items-center gap-1.5">
                            <i class="fas fa-paper-plane text-[10px]"></i>
                            <span>Publish Discussion Topic</span>
                        </button>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- EDIT FORUM MODAL -->
    <div id="editForumModal"
        class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs">
        <div
            class="relative w-full max-w-2xl bg-white rounded-3xl shadow-2xl p-6 border border-slate-100 max-h-[90vh] overflow-y-auto">
            <div class="flex items-center justify-between mb-4 pb-3 border-b border-slate-100">
                <div class="flex items-center gap-2.5">
                    <div
                        class="w-9 h-9 rounded-xl bg-cyan-50 border border-cyan-100 flex items-center justify-center text-cyan-600 shadow-xs">
                        <i class="fas fa-pen text-sm"></i>
                    </div>
                    <div>
                        <h3 class="text-sm font-black text-slate-900">Edit Forum Details</h3>
                        <p class="text-[11px] font-medium text-slate-400">Configure curriculum, target section, due
                            date, and rules</p>
                    </div>
                </div>
                <button type="button" onclick="closeEditForumModal()"
                    class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-700 cursor-pointer transition">&times;</button>
            </div>
            <form onsubmit="submitEditForum(event)" class="space-y-4">
                <!-- SECTION 1: SECTION & TOPIC -->
                <div class="p-3.5 rounded-2xl bg-slate-50/70 border border-slate-100 space-y-3">
                    <div
                        class="text-[11px] font-black uppercase tracking-wider text-slate-400 flex items-center gap-1.5">
                        <i class="fas fa-layer-group text-cyan-600"></i> Targeting & Curriculum
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1">Curriculum Topic</label>
                            <select id="editForumTopicId"
                                class="w-full text-xs font-semibold px-3 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-cyan-500 bg-white">
                                <option value="">— No specific topic —</option>
                                <% (typeof topics !=='undefined' ? topics : []).forEach(t=> { %>
                                    <option value="<%= t.topic_id %>" <%=forum.topic_id==t.topic_id ? 'selected' : '' %>
                                        >Q<%= t.quarter_number %> · <%= t.topic_name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                        <div>
                            <label class="block text-xs font-bold text-slate-600 mb-1">Target Class Section</label>
                            <select id="editForumClassId"
                                class="w-full text-xs font-semibold px-3 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-cyan-500 bg-white">
                                <option value="">All Enrolled Sections</option>
                                <% (typeof classes !=='undefined' ? classes : []).forEach(c=> { %>
                                    <option value="<%= c.class_id %>" <%=forum.class_id==c.class_id ? 'selected' : '' %>
                                        ><%= c.class_name %>
                                    </option>
                                    <% }) %>
                            </select>
                        </div>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">Due Date & Time (Deadline)</label>
                        <% let formattedDue='' ; if (forum.due_date) { const d=new Date(forum.due_date); if
                            (!isNaN(d.getTime())) { const pad=n=> String(n).padStart(2, '0');
                            formattedDue =
                            `${d.getFullYear()}-${pad(d.getMonth()+1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
                            }
                            }
                            %>
                            <input type="datetime-local" id="editForumDueDate" value="<%= formattedDue %>"
                                class="w-full text-xs font-semibold px-3 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-cyan-500 bg-white">
                    </div>
                </div>

                <!-- SECTION: FORUM COVER BANNER STUDIO -->
                <div class="p-3.5 rounded-2xl bg-slate-50/70 border border-slate-100 space-y-3">
                    <div class="flex items-center justify-between flex-wrap gap-2">
                        <div class="text-[11px] font-black uppercase tracking-wider text-slate-500 flex items-center gap-1.5">
                            <i class="fas fa-image text-cyan-600"></i> Forum Cover Banner
                        </div>
                        <!-- Mode Switcher Tabs -->
                        <div class="inline-flex p-0.5 rounded-xl bg-slate-200/80 text-[11px] font-bold">
                            <button type="button" onclick="setBannerStudioTab('forumView', 'preset')" id="btnTabPreset_forumView" class="px-2.5 py-1 rounded-lg bg-white text-cyan-700 shadow-2xs transition">🎨 Presets</button>
                            <button type="button" onclick="setBannerStudioTab('forumView', 'upload')" id="btnTabUpload_forumView" class="px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900 transition">📤 Upload</button>
                            <button type="button" onclick="setBannerStudioTab('forumView', 'default')" id="btnTabDefault_forumView" class="px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900 transition">🔄 Subject Default</button>
                        </div>
                    </div>

                    <!-- Live Mini-Hero Preview Card -->
                    <div class="relative h-28 rounded-xl overflow-hidden border border-slate-200 bg-slate-900 shadow-xs">
                        <img id="bannerPreviewImg_forumView" src="<%= forum.banner_image || '/forum_banners/presets/preset-molecules.svg' %>" class="w-full h-full object-cover transition duration-300" alt="Banner Preview">
                        <div class="absolute inset-0 bg-gradient-to-t from-slate-950/90 via-slate-950/40 to-transparent"></div>
                        <div class="absolute bottom-2.5 left-3.5 right-3.5 flex items-end justify-between gap-2">
                            <div class="min-w-0">
                                <span class="inline-block text-[9px] font-black uppercase tracking-widest text-cyan-300 px-1.5 py-0.5 rounded bg-cyan-950/70 border border-cyan-500/30 mb-0.5">CURRENT BANNER</span>
                                <p id="bannerPreviewTitle_forumView" class="text-xs font-black text-white truncate drop-shadow-xs"><%= forum.title || 'Discussion Title' %></p>
                            </div>
                            <span id="bannerPreviewBadge_forumView" class="shrink-0 text-[10px] font-bold text-slate-300 bg-white/10 backdrop-blur-xs px-2 py-0.5 rounded-full border border-white/20"><%= forum.banner_image ? 'Custom Banner' : 'Subject Default' %></span>
                        </div>
                    </div>

                    <!-- Panel 1: Curated Chemistry Presets Grid -->
                    <div id="panelPreset_forumView" class="space-y-1.5">
                        <div class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Choose a Curated Chemistry Preset:</div>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <button type="button" onclick="selectBannerPreset('forumView', 'preset-molecules.svg', 'Molecular Geometry')" class="preset-card-forumView relative rounded-xl overflow-hidden border-2 border-slate-200 hover:border-cyan-500 p-0.5 bg-white hover:opacity-95 transition group text-left cursor-pointer" data-preset="preset-molecules.svg">
                                <div class="h-14 rounded-lg overflow-hidden bg-slate-800">
                                    <img src="/forum_banners/presets/preset-molecules.svg" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" alt="Molecular Geometry">
                                </div>
                                <div class="p-1.5 flex items-center justify-between">
                                    <span class="text-[10px] font-bold text-slate-800 truncate">Molecules</span>
                                    <i class="fas fa-check-circle text-cyan-600 text-[11px] preset-check hidden"></i>
                                </div>
                            </button>
                            <button type="button" onclick="selectBannerPreset('forumView', 'preset-glassware.svg', 'Laboratory Apparatus')" class="preset-card-forumView relative rounded-xl overflow-hidden border-2 border-slate-200 hover:border-cyan-500 p-0.5 bg-white hover:opacity-95 transition group text-left cursor-pointer" data-preset="preset-glassware.svg">
                                <div class="h-14 rounded-lg overflow-hidden bg-slate-800">
                                    <img src="/forum_banners/presets/preset-glassware.svg" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" alt="Lab Glassware">
                                </div>
                                <div class="p-1.5 flex items-center justify-between">
                                    <span class="text-[10px] font-bold text-slate-800 truncate">Glassware</span>
                                    <i class="fas fa-check-circle text-cyan-600 text-[11px] preset-check hidden"></i>
                                </div>
                            </button>
                            <button type="button" onclick="selectBannerPreset('forumView', 'preset-periodic.svg', 'Periodic Table')" class="preset-card-forumView relative rounded-xl overflow-hidden border-2 border-slate-200 hover:border-cyan-500 p-0.5 bg-white hover:opacity-95 transition group text-left cursor-pointer" data-preset="preset-periodic.svg">
                                <div class="h-14 rounded-lg overflow-hidden bg-slate-800">
                                    <img src="/forum_banners/presets/preset-periodic.svg" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" alt="Periodic Table">
                                </div>
                                <div class="p-1.5 flex items-center justify-between">
                                    <span class="text-[10px] font-bold text-slate-800 truncate">Periodic</span>
                                    <i class="fas fa-check-circle text-cyan-600 text-[11px] preset-check hidden"></i>
                                </div>
                            </button>
                            <button type="button" onclick="selectBannerPreset('forumView', 'preset-reactions.svg', 'Reaction Kinetics')" class="preset-card-forumView relative rounded-xl overflow-hidden border-2 border-slate-200 hover:border-cyan-500 p-0.5 bg-white hover:opacity-95 transition group text-left cursor-pointer" data-preset="preset-reactions.svg">
                                <div class="h-14 rounded-lg overflow-hidden bg-slate-800">
                                    <img src="/forum_banners/presets/preset-reactions.svg" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" alt="Reaction Kinetics">
                                </div>
                                <div class="p-1.5 flex items-center justify-between">
                                    <span class="text-[10px] font-bold text-slate-800 truncate">Reactions</span>
                                    <i class="fas fa-check-circle text-cyan-600 text-[11px] preset-check hidden"></i>
                                </div>
                            </button>
                            <button type="button" onclick="selectBannerPreset('forumView', 'preset-dna.svg', 'Biochemistry DNA')" class="preset-card-forumView relative rounded-xl overflow-hidden border-2 border-slate-200 hover:border-cyan-500 p-0.5 bg-white hover:opacity-95 transition group text-left cursor-pointer" data-preset="preset-dna.svg">
                                <div class="h-14 rounded-lg overflow-hidden bg-slate-800">
                                    <img src="/forum_banners/presets/preset-dna.svg" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" alt="Biochemistry DNA">
                                </div>
                                <div class="p-1.5 flex items-center justify-between">
                                    <span class="text-[10px] font-bold text-slate-800 truncate">Biochem</span>
                                    <i class="fas fa-check-circle text-cyan-600 text-[11px] preset-check hidden"></i>
                                </div>
                            </button>
                            <button type="button" onclick="selectBannerPreset('forumView', 'preset-thermo.svg', 'Thermochemistry')" class="preset-card-forumView relative rounded-xl overflow-hidden border-2 border-slate-200 hover:border-cyan-500 p-0.5 bg-white hover:opacity-95 transition group text-left cursor-pointer" data-preset="preset-thermo.svg">
                                <div class="h-14 rounded-lg overflow-hidden bg-slate-800">
                                    <img src="/forum_banners/presets/preset-thermo.svg" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" alt="Thermochemistry">
                                </div>
                                <div class="p-1.5 flex items-center justify-between">
                                    <span class="text-[10px] font-bold text-slate-800 truncate">Thermo</span>
                                    <i class="fas fa-check-circle text-cyan-600 text-[11px] preset-check hidden"></i>
                                </div>
                            </button>
                            <button type="button" onclick="selectBannerPreset('forumView', 'preset-organic.svg', 'Organic Synthesis')" class="preset-card-forumView relative rounded-xl overflow-hidden border-2 border-slate-200 hover:border-cyan-500 p-0.5 bg-white hover:opacity-95 transition group text-left cursor-pointer" data-preset="preset-organic.svg">
                                <div class="h-14 rounded-lg overflow-hidden bg-slate-800">
                                    <img src="/forum_banners/presets/preset-organic.svg" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" alt="Organic Synthesis">
                                </div>
                                <div class="p-1.5 flex items-center justify-between">
                                    <span class="text-[10px] font-bold text-slate-800 truncate">Organic</span>
                                    <i class="fas fa-check-circle text-cyan-600 text-[11px] preset-check hidden"></i>
                                </div>
                            </button>
                            <button type="button" onclick="selectBannerPreset('forumView', 'preset-electro.svg', 'Electrochemistry')" class="preset-card-forumView relative rounded-xl overflow-hidden border-2 border-slate-200 hover:border-cyan-500 p-0.5 bg-white hover:opacity-95 transition group text-left cursor-pointer" data-preset="preset-electro.svg">
                                <div class="h-14 rounded-lg overflow-hidden bg-slate-800">
                                    <img src="/forum_banners/presets/preset-electro.svg" class="w-full h-full object-cover group-hover:scale-105 transition duration-300" alt="Electrochemistry">
                                </div>
                                <div class="p-1.5 flex items-center justify-between">
                                    <span class="text-[10px] font-bold text-slate-800 truncate">Electro</span>
                                    <i class="fas fa-check-circle text-cyan-600 text-[11px] preset-check hidden"></i>
                                </div>
                            </button>
                        </div>
                    </div>

                    <!-- Panel 2: Custom Upload Dropzone -->
                    <div id="panelUpload_forumView" class="hidden">
                        <label for="bannerFileInput_forumView" class="flex flex-col items-center justify-center border-2 border-dashed border-slate-200 hover:border-cyan-400 bg-white hover:bg-cyan-50/20 rounded-xl p-4 cursor-pointer transition text-center group">
                            <div class="w-10 h-10 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center mb-2 group-hover:scale-110 transition">
                                <i class="fas fa-cloud-arrow-up text-base"></i>
                            </div>
                            <span class="text-xs font-bold text-slate-700">Click to upload replacement banner or drag & drop</span>
                            <span class="text-[10px] text-slate-400 mt-0.5">Recommended: 1200 &times; 400 px &bull; PNG, JPG, WebP up to 8MB</span>
                            <input type="file" id="bannerFileInput_forumView" accept="image/png,image/jpeg,image/webp" class="hidden" onchange="handleBannerFileSelect('forumView', this)">
                        </label>
                        <div id="bannerUploadFileInfo_forumView" class="mt-2 text-xs text-cyan-700 font-bold flex items-center justify-between p-2 rounded-lg bg-cyan-50 border border-cyan-100 hidden">
                            <span id="bannerUploadFileName_forumView" class="truncate flex items-center gap-1.5"><i class="fas fa-image"></i> image.png</span>
                            <button type="button" onclick="clearBannerUpload('forumView')" class="text-rose-500 hover:text-rose-700 ml-2 text-xs">Remove</button>
                        </div>
                    </div>

                    <!-- Panel 3: Subject Default Notice -->
                    <div id="panelDefault_forumView" class="hidden p-3 rounded-xl bg-slate-100/80 border border-slate-200 text-slate-600 text-xs flex items-center gap-2.5">
                        <i class="fas fa-circle-info text-cyan-600 text-base shrink-0"></i>
                        <span>This forum will use the <strong>parent subject's cover banner</strong> automatically.</span>
                    </div>
                </div>

                <!-- SECTION 2: TITLE & CONTENT -->
                <div class="space-y-3">
                    <div>
                        <label class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1">Forum Title
                            <span class="text-rose-500">*</span></label>
                        <input type="text" id="editForumTitle" required value="<%= forum.title || '' %>"
                            class="w-full text-xs font-bold px-3 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-cyan-500">
                    </div>
                    <div>
                        <div class="flex items-center justify-between mb-1">
                            <label
                                class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-0">Discussion
                                Prompt / Objectives <span class="text-rose-500">*</span></label>
                            <div class="flex items-center gap-1">
                                <button type="button" onclick="insertFormulaText('H₂O')"
                                    class="px-2 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-50 hover:text-cyan-600 text-[10px] font-bold text-slate-600 transition">H₂O</button>
                                <button type="button" onclick="insertFormulaText('CO₂')"
                                    class="px-2 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-50 hover:text-cyan-600 text-[10px] font-bold text-slate-600 transition">CO₂</button>
                                <button type="button" onclick="insertFormulaText('ΔH < 0')"
                                    class="px-2 py-0.5 rounded-md bg-slate-100 hover:bg-cyan-50 hover:text-cyan-600 text-[10px] font-bold text-slate-600 transition">ΔH</button>
                            </div>
                        </div>
                        <textarea id="editForumContent" rows="4" required
                            class="w-full text-xs font-medium px-3 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-cyan-500"><%= forum.forum_content || '' %></textarea>
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">Reference Worksheet / Learning Guide
                            (Optional)</label>
                        <% if (forum.attachment_name) { %>
                            <div
                                class="mb-2 p-2 rounded-xl bg-indigo-50 border border-indigo-100 flex items-center justify-between text-xs text-indigo-700">
                                <span class="flex items-center gap-1.5 font-bold"><i class="fas fa-paperclip"></i>
                                    <%= forum.attachment_name %>
                                </span>
                                <label
                                    class="text-[11px] font-semibold text-rose-500 cursor-pointer flex items-center gap-1">
                                    <input type="checkbox" id="editForumRemoveAttachment" class="rounded"> Remove File
                                </label>
                            </div>
                            <% } %>
                                <input type="file" id="editForumAttachment"
                                    class="w-full text-xs px-3 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-cyan-500 bg-white"
                                    accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.png,.jpg,.jpeg,.mp3,.wav,.zip">
                    </div>
                </div>

                <!-- SECTION 3: GAMIFICATION & RULES -->
                <div class="p-3.5 rounded-2xl bg-amber-50/50 border border-amber-100/80 space-y-3">
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 items-center">
                        <div>
                            <label class="block text-xs font-bold text-slate-700 mb-1">Max Base EXP Reward</label>
                            <select id="editForumBaseExp"
                                class="w-full text-xs font-semibold px-3 py-2 border border-amber-200 rounded-xl outline-none focus:ring-2 focus:ring-amber-500 bg-white">
                                <option value="50" <%=forum.base_exp==50 ? 'selected' : '' %>>50 EXP</option>
                                <option value="100" <%=!forum.base_exp || forum.base_exp==100 ? 'selected' : '' %>>100
                                    EXP (Recommended)</option>
                                <option value="150" <%=forum.base_exp==150 ? 'selected' : '' %>>150 EXP</option>
                                <option value="200" <%=forum.base_exp==200 ? 'selected' : '' %>>200 EXP</option>
                            </select>
                        </div>
                        <div class="text-[11px] text-slate-500 leading-snug">
                            Submissions decay dynamically: 100% &rarr; 85% &rarr; 70% &rarr; 40%.
                        </div>
                    </div>
                    <div class="pt-2 border-t border-amber-100 flex flex-col gap-2">
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" id="editForumPostBeforeViewing" <%=forum.post_before_viewing
                                ? 'checked' : '' %> class="rounded text-cyan-600 focus:ring-cyan-500">
                            <span class="text-xs font-semibold text-slate-700">🔒 Require post before viewing peer
                                discussions (Anti-Copy)</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" id="editForumAllowAnonymous" <%=forum.allow_anonymous !==0
                                ? 'checked' : '' %> class="rounded text-cyan-600 focus:ring-cyan-500">
                            <span class="text-xs font-semibold text-slate-700">🎭 Allow masked anonymous student
                                questions</span>
                        </label>
                        <label class="flex items-center gap-2 cursor-pointer">
                            <input type="checkbox" id="editForumPinned" <%=forum.is_pinned ? 'checked' : '' %>
                            class="rounded text-cyan-600 focus:ring-cyan-500">
                            <span class="text-xs font-semibold text-slate-700">📌 Pin this forum thread</span>
                        </label>
                    </div>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2 border-t border-slate-100">
                    <button type="button" onclick="closeEditForumModal()"
                        class="px-3.5 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">Cancel</button>
                    <button type="submit" id="btnSubmitEditForumView"
                        class="px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold cursor-pointer shadow-xs">Save
                        Changes</button>
                </div>
            </form>
        </div>
    </div>

    <!-- DELETE FORUM CONFIRMATION MODAL -->
    <div id="deleteForumModal"
        class="fixed inset-0 z-50 hidden flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs">
        <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl p-6 border border-slate-100">
            <div class="w-12 h-12 rounded-2xl bg-rose-100 text-rose-600 flex items-center justify-center text-xl mb-4">
                <i class="fas fa-trash-alt"></i>
            </div>
            <h3 class="text-base font-black text-slate-900 mb-1">Delete This Forum Board?</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
                This action will permanently delete this forum along with all discussion threads, student responses, and
                attachments.
            </p>
            <div class="flex items-center justify-end gap-2">
                <button type="button" onclick="closeDeleteForumModal()"
                    class="px-3.5 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">Cancel</button>
                <button type="button" onclick="confirmDeleteForum()"
                    class="px-4 py-2 rounded-xl bg-rose-600 hover:bg-rose-500 text-white text-xs font-bold cursor-pointer">Yes,
                    Delete Forum</button>
            </div>
        </div>
    </div>

    <!-- FORMULA SHORTCUT MODAL -->
    <div id="formulaShortcutModal"
        class="fixed inset-0 z-60 hidden flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs">
        <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl p-6 border border-slate-100">
            <div class="flex items-center justify-between mb-4">
                <h3 class="text-base font-black text-slate-900 flex items-center gap-2">
                    <i class="fas fa-flask text-cyan-600"></i> Insert Chemical Formula
                </h3>
                <button type="button" onclick="closeFormulaShortcutModal()"
                    class="text-slate-400 hover:text-slate-700 cursor-pointer"><i class="fas fa-times"></i></button>
            </div>
            <div class="grid grid-cols-2 gap-2 mb-4">
                <button type="button" onclick="insertFormulaText('H₂O')"
                    class="p-2.5 rounded-xl border border-slate-200 text-xs font-bold hover:bg-cyan-50 hover:border-cyan-300 text-slate-800 text-left">H₂O
                    (Water)</button>
                <button type="button" onclick="insertFormulaText('CO₂')"
                    class="p-2.5 rounded-xl border border-slate-200 text-xs font-bold hover:bg-cyan-50 hover:border-cyan-300 text-slate-800 text-left">CO₂
                    (Carbon Dioxide)</button>
                <button type="button" onclick="insertFormulaText('NaCl')"
                    class="p-2.5 rounded-xl border border-slate-200 text-xs font-bold hover:bg-cyan-50 hover:border-cyan-300 text-slate-800 text-left">NaCl
                    (Sodium Chloride)</button>
                <button type="button" onclick="insertFormulaText('H₂SO₄')"
                    class="p-2.5 rounded-xl border border-slate-200 text-xs font-bold hover:bg-cyan-50 hover:border-cyan-300 text-slate-800 text-left">H₂SO₄
                    (Sulfuric Acid)</button>
                <button type="button" onclick="insertFormulaText('ΔH < 0 (Exothermic)')"
                    class="p-2.5 rounded-xl border border-slate-200 text-xs font-bold hover:bg-cyan-50 hover:border-cyan-300 text-slate-800 text-left">ΔH
                    < 0 (Exothermic)</button>
                        <button type="button" onclick="insertFormulaText('ΔH > 0 (Endothermic)')"
                            class="p-2.5 rounded-xl border border-slate-200 text-xs font-bold hover:bg-cyan-50 hover:border-cyan-300 text-slate-800 text-left">ΔH
                            > 0 (Endothermic)</button>
            </div>
            <div class="flex items-center gap-2">
                <input type="text" id="customFormulaInput" placeholder="Type custom formula (e.g. C6H12O6)..."
                    class="flex-1 text-xs font-bold px-3 py-2 border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-cyan-500">
                <button type="button" onclick="insertFormulaText(document.getElementById('customFormulaInput').value)"
                    class="px-4 py-2 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold cursor-pointer">Insert</button>
            </div>
        </div>
    </div>

    <!-- Notification Toast Container -->
    <div id="toastContainer" class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 pointer-events-none"></div>

    <!-- Client Script -->
    <script>
        const CURRENT_FORUM_ID = <%= forum ? forum.forum_id : 0 %>;
        let activeDiscussionData = null;
        let isModalFullscreen = false;

        function escHtml(str) {
            if (!str) return '';
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }

        function showToast(msg, type = 'info') {
            const container = document.getElementById('toastContainer');
            const toast = document.createElement('div');
            const bgClass = type === 'success' ? 'bg-emerald-600' : type === 'error' ? 'bg-rose-600' : 'bg-slate-900';
            toast.className = `${bgClass} text-white px-4 py-2.5 rounded-2xl shadow-xl text-xs font-bold flex items-center gap-2 pointer-events-auto transform transition-all duration-300 translate-y-4 opacity-0`;
            toast.innerHTML = `<span>${msg}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.classList.remove('translate-y-4', 'opacity-0'), 10);
            setTimeout(() => {
                toast.classList.add('translate-y-4', 'opacity-0');
                setTimeout(() => toast.remove(), 300);
            }, 3500);
        }

        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            const main = document.getElementById('mainContent');
            if (window.innerWidth < 768) {
                if (sidebar) sidebar.classList.toggle('sidebar-open');
                if (overlay) overlay.classList.toggle('hidden');
            } else {
                if (sidebar) sidebar.classList.toggle('sidebar-collapsed');
                if (main) main.classList.toggle('sidebar-collapsed-main');
            }
        }

        function toggleUserMenu(event) {
            event.stopPropagation();
            const dropdown = document.getElementById('userDropdown');
            if (dropdown) dropdown.classList.toggle('hidden');
        }

        function toggleActionDropdown(event, replyId) {
            event.stopPropagation();
            const dropdown = document.getElementById('dropdown-' + replyId);
            document.querySelectorAll('.dropdown-menu').forEach(d => {
                if (d !== dropdown) d.classList.add('hidden');
            });
            if (dropdown) dropdown.classList.toggle('hidden');
        }

        window.addEventListener('click', () => {
            const dropdown = document.getElementById('userDropdown');
            if (dropdown && !dropdown.classList.contains('hidden')) dropdown.classList.add('hidden');
            document.querySelectorAll('.dropdown-menu').forEach(d => d.classList.add('hidden'));
        });

        // Filters & Search
        let currentFilter = 'all';
        function setFilter(filter, btn) {
            currentFilter = filter;
            document.querySelectorAll('#quickFilterPills .filter-pill').forEach(b => {
                b.className = 'filter-pill px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-600 transition';
            });
            btn.className = 'filter-pill active px-3 py-1 rounded-lg text-xs font-bold bg-cyan-600 text-white shadow-2xs transition';
            applyFilters();
        }

        function handleSearch() {
            applyFilters();
        }

        function applyFilters() {
            const query = (document.getElementById('discussionSearch').value || '').toLowerCase().trim();
            const rows = document.querySelectorAll('.discussion-row');
            let visibleCount = 0;

            rows.forEach(row => {
                const title = row.getAttribute('data-title') || '';
                const author = row.getAttribute('data-author') || '';
                const isEndorsed = row.getAttribute('data-endorsed') === '1';
                const isReported = row.getAttribute('data-reported') === '1';
                const isStarred = row.getAttribute('data-starred') === '1';

                const matchesQuery = !query || title.includes(query) || author.includes(query);
                let matchesFilter = true;
                if (currentFilter === 'starred') matchesFilter = isStarred;
                else if (currentFilter === 'endorsed') matchesFilter = isEndorsed;
                else if (currentFilter === 'reported') matchesFilter = isReported;

                if (matchesQuery && matchesFilter) {
                    row.style.display = '';
                    visibleCount++;
                } else {
                    row.style.display = 'none';
                }
            });

            const badge = document.getElementById('topicCountBadge');
            if (badge) badge.textContent = visibleCount;
        }

        // Cohort Roster Drawer
        function openRosterDrawer() {
            const drawer = document.getElementById('rosterDrawer');
            const overlay = document.getElementById('rosterDrawerOverlay');
            if (drawer) drawer.classList.remove('translate-x-full');
            if (overlay) overlay.classList.remove('hidden');
        }

        function closeRosterDrawer() {
            const drawer = document.getElementById('rosterDrawer');
            const overlay = document.getElementById('rosterDrawerOverlay');
            if (drawer) drawer.classList.add('translate-x-full');
            if (overlay) overlay.classList.add('hidden');
        }

        function filterRoster(q) {
            const query = (q || '').toLowerCase().trim();
            document.querySelectorAll('.roster-item').forEach(item => {
                const name = item.getAttribute('data-name') || '';
                const id = item.getAttribute('data-id') || '';
                if (!query || name.includes(query) || id.includes(query)) {
                    item.style.display = '';
                } else {
                    item.style.display = 'none';
                }
            });
        }

        // Forum Status & Operations
        async function updateForumStatus(status) {
            try {
                const res = await fetch(`/teacher/api/forum/${CURRENT_FORUM_ID}/status`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ status })
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Forum status updated to ' + status, 'success');
                } else {
                    showToast(data.error || 'Failed to update status', 'error');
                }
            } catch (err) {
                showToast('Error updating status', 'error');
            }
        }

        async function togglePinForum(fId) {
            try {
                const res = await fetch(`/teacher/api/forum/${fId}/pin`, { method: 'POST' });
                const data = await res.json();
                if (data.success) {
                    showToast('Forum pin status updated', 'success');
                    await refreshForumViewContent();
                }
            } catch (err) {
                showToast('Error updating pin', 'error');
            }
        }

        
        // ── Forum Banner Studio Controller for ForumView ──
        const bannerStudioState = {
            forumView: { 
                choice: '<%= forum.banner_image ? (forum.banner_image.includes("preset-") ? "preset" : "preset") : "default" %>', 
                preset: '<%= forum.banner_image || "preset-molecules.svg" %>', 
                title: '<%= forum.title || "" %>', 
                file: null 
            }
        };

        function capitalizeWord(s) { return s ? s.charAt(0).toUpperCase() + s.slice(1) : ''; }

        function setBannerStudioTab(scope, tab) {
            if (!bannerStudioState[scope]) return;
            bannerStudioState[scope].choice = tab;

            const tabs = ['preset', 'upload', 'default'];
            tabs.forEach(t => {
                const btn = document.getElementById(`btnTab${capitalizeWord(t)}_${scope}`);
                const panel = document.getElementById(`panel${capitalizeWord(t)}_${scope}`);
                if (!btn || !panel) return;
                if (t === tab) {
                    btn.className = 'px-2.5 py-1 rounded-lg bg-white text-cyan-700 shadow-2xs transition font-bold cursor-pointer';
                    panel.classList.remove('hidden');
                } else {
                    btn.className = 'px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900 transition font-bold cursor-pointer';
                    panel.classList.add('hidden');
                }
            });

            updateBannerStudioPreview(scope);
        }

        function selectBannerPreset(scope, presetFilename, presetTitle) {
            if (!bannerStudioState[scope]) return;
            bannerStudioState[scope].choice = 'preset';
            bannerStudioState[scope].preset = presetFilename;
            bannerStudioState[scope].title = presetTitle;
            bannerStudioState[scope].file = null;

            document.querySelectorAll(`.preset-card-${scope}`).forEach(card => {
                const isMatch = card.getAttribute('data-preset') === presetFilename;
                card.classList.toggle('border-cyan-600', isMatch);
                card.classList.toggle('bg-cyan-50/50', isMatch);
                card.classList.toggle('ring-2', isMatch);
                card.classList.toggle('ring-cyan-500/20', isMatch);
                card.classList.toggle('border-slate-200', !isMatch);
                card.classList.toggle('bg-white', !isMatch);
                const check = card.querySelector('.preset-check');
                if (check) check.classList.toggle('hidden', !isMatch);
            });

            updateBannerStudioPreview(scope);
        }

        function handleBannerFileSelect(scope, input) {
            if (!input || !input.files || !input.files[0]) return;
            const file = input.files[0];
            bannerStudioState[scope].choice = 'upload';
            bannerStudioState[scope].file = file;

            const fileInfo = document.getElementById(`bannerUploadFileInfo_${scope}`);
            const fileName = document.getElementById(`bannerUploadFileName_${scope}`);
            if (fileInfo && fileName) {
                fileName.innerHTML = `<i class="fas fa-image"></i> ${file.name}`;
                fileInfo.classList.remove('hidden');
            }

            updateBannerStudioPreview(scope);
        }

        function clearBannerUpload(scope) {
            if (!bannerStudioState[scope]) return;
            bannerStudioState[scope].file = null;
            const input = document.getElementById(`bannerFileInput_${scope}`);
            if (input) input.value = '';
            const fileInfo = document.getElementById(`bannerUploadFileInfo_${scope}`);
            if (fileInfo) fileInfo.classList.add('hidden');
            setBannerStudioTab(scope, 'preset');
        }

        function updateBannerStudioPreview(scope) {
            const previewImg = document.getElementById(`bannerPreviewImg_${scope}`);
            const badge = document.getElementById(`bannerPreviewBadge_${scope}`);
            if (!previewImg) return;

            const state = bannerStudioState[scope];
            if (state.choice === 'upload' && state.file) {
                previewImg.src = URL.createObjectURL(state.file);
                if (badge) badge.textContent = 'Custom Upload';
            } else if (state.choice === 'default') {
                previewImg.src = '/profile_uploads/<%= forum.subject_image || "default_subject.png" %>';
                if (badge) badge.textContent = 'Subject Default';
            } else {
                const preset = state.preset || 'preset-molecules.svg';
                const url = preset.startsWith('/') ? preset : `/forum_banners/presets/${preset}`;
                previewImg.src = url;
                if (badge) badge.textContent = state.title || 'Curated Preset';
            }
        }

        function initBannerStudioModal(scope, initialBanner, initialTitle) {
            if (!bannerStudioState[scope]) return;
            const titleEl = document.getElementById(`bannerPreviewTitle_${scope}`);
            if (titleEl) titleEl.textContent = initialTitle || '<%= forum.title || "Discussion Title" %>';

            if (!initialBanner) {
                setBannerStudioTab(scope, 'default');
            } else if (initialBanner.includes('preset-')) {
                const filename = initialBanner.split('/').pop();
                setBannerStudioTab(scope, 'preset');
                selectBannerPreset(scope, filename, 'Curated Preset');
            } else {
                bannerStudioState[scope].choice = 'preset';
                bannerStudioState[scope].preset = initialBanner;
                bannerStudioState[scope].file = null;
                setBannerStudioTab(scope, 'preset');
                const previewImg = document.getElementById(`bannerPreviewImg_${scope}`);
                const badge = document.getElementById(`bannerPreviewBadge_${scope}`);
                if (previewImg) previewImg.src = initialBanner;
                if (badge) badge.textContent = 'Active Custom Banner';
            }
        }

        function openEditForumModal() {
            if (typeof initBannerStudioModal === 'function') initBannerStudioModal('forumView', '<%= forum.banner_image || "" %>', '<%= forum.title || "" %>');
            document.getElementById('editForumModal').classList.remove('hidden');
        }
        function closeEditForumModal() {
            document.getElementById('editForumModal').classList.add('hidden');
        }
        async function submitEditForum(e) {
            e.preventDefault();
            const title = document.getElementById('editForumTitle').value.trim();
            const forum_content = document.getElementById('editForumContent').value.trim();
            const topic_id = document.getElementById('editForumTopicId')?.value || '';
            const class_id = document.getElementById('editForumClassId')?.value || '';
            const due_date = document.getElementById('editForumDueDate')?.value || '';
            const base_exp = document.getElementById('editForumBaseExp')?.value || '100';
            const post_before_viewing = document.getElementById('editForumPostBeforeViewing')?.checked ? 1 : 0;
            const allow_anonymous = document.getElementById('editForumAllowAnonymous')?.checked ? 1 : 0;
            const is_pinned = document.getElementById('editForumPinned')?.checked ? 1 : 0;
            const remove_attachment = document.getElementById('editForumRemoveAttachment')?.checked ? 1 : 0;
            const fileInput = document.getElementById('editForumAttachment');

            if (!title) { showToast('Title is required', 'error'); return; }

            const btn = document.getElementById('btnSubmitEditForumView');
            const origHtml = btn ? btn.innerHTML : '';
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving…';
            }

            try {
                const fd = new FormData();
                fd.append('title', title);
                fd.append('forum_content', forum_content);
                if (topic_id) fd.append('topic_id', topic_id);
                if (class_id) fd.append('class_id', class_id);
                if (due_date) fd.append('due_date', due_date);
                fd.append('base_exp', base_exp);
                fd.append('post_before_viewing', post_before_viewing);
                fd.append('allow_anonymous', allow_anonymous);
                fd.append('is_pinned', is_pinned);
                if (remove_attachment) fd.append('remove_attachment', '1');
                if (fileInput && fileInput.files[0]) {
                    fd.append('attachment', fileInput.files[0]);
                }
                // Banner Selection
                fd.append('banner_choice', bannerStudioState.forumView.choice);
                if (bannerStudioState.forumView.choice === 'preset') {
                    fd.append('banner_preset', bannerStudioState.forumView.preset);
                } else if (bannerStudioState.forumView.choice === 'upload' && bannerStudioState.forumView.file) {
                    fd.append('banner_image', bannerStudioState.forumView.file);
                } else if (bannerStudioState.forumView.choice === 'default') {
                    fd.append('remove_banner', '1');
                }

                const res = await fetch(`/teacher/api/forum/${CURRENT_FORUM_ID}/edit`, {
                    method: 'POST',
                    body: fd
                });
                const data = await res.json();
                if (data.success) {
                    showToast('Forum details updated', 'success');
                    closeEditForumModal();
                    await refreshForumViewContent();
                } else {
                    showToast(data.error || 'Failed to update forum', 'error');
                }
            } catch (err) {
                showToast('Error updating forum', 'error');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = origHtml;
                }
            }
        }

        function openDeleteForumModal() {
            document.getElementById('deleteForumModal').classList.remove('hidden');
        }
        function closeDeleteForumModal() {
            document.getElementById('deleteForumModal').classList.add('hidden');
        }
        async function confirmDeleteForum() {
            try {
                const res = await fetch(`/teacher/api/forum/${CURRENT_FORUM_ID}`, { method: 'DELETE' });
                const data = await res.json();
                if (data.success) {
                    showToast('Forum deleted successfully', 'success');
                    setTimeout(() => window.location.href = '/teacher/forums', 600);
                } else {
                    showToast(data.error || 'Failed to delete forum', 'error');
                }
            } catch (err) {
                showToast('Error deleting forum', 'error');
            }
        }

        // Discussion Thread Modal
        function applyModalScreenState(fullscreen) {
            const modal = document.getElementById('discussionModal');
            const container = document.getElementById('discussionModalContainer');
            const icon = document.getElementById('modalFullscreenIcon');
            const btn = document.getElementById('modalFullscreenBtn');
            isModalFullscreen = !!fullscreen;
            if (isModalFullscreen) {
                modal.classList.remove('p-3', 'md:p-6', 'lg:p-8');
                modal.classList.add('p-0');
                container.classList.remove('max-w-6xl', 'xl:max-w-7xl', 'h-[92vh]', 'rounded-[28px]', 'border', 'border-slate-200/90', 'shadow-2xl');
                container.classList.add('w-full', 'h-full', 'max-w-none', 'rounded-none', 'border-0', 'shadow-none');
                if (icon) icon.className = "fas fa-compress-alt text-xs";
                if (btn) btn.title = "Restore window size";
            } else {
                modal.classList.remove('p-0');
                modal.classList.add('p-3', 'md:p-6', 'lg:p-8');
                container.classList.remove('w-full', 'h-full', 'max-w-none', 'rounded-none', 'border-0', 'shadow-none');
                container.classList.add('w-full', 'max-w-6xl', 'xl:max-w-7xl', 'h-[92vh]', 'rounded-[28px]', 'border', 'border-slate-200/90', 'shadow-2xl');
                if (icon) icon.className = "fas fa-expand-alt text-xs";
                if (btn) btn.title = "Full screen";
            }
        }

        function toggleModalFullscreen() {
            applyModalScreenState(!isModalFullscreen);
        }

        // Escape key to dismiss discussion modal
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const modal = document.getElementById('discussionModal');
                if (modal && !modal.classList.contains('hidden')) {
                    closeDiscussionModal();
                }
            }
        });

        async function openDiscussionModal(replyId) {
            const modal = document.getElementById('discussionModal');
            const loading = document.getElementById('modalLoadingState');
            const content = document.getElementById('modalRootContent');

            applyModalScreenState(false);
            modal.classList.remove('hidden');
            loading.classList.remove('hidden');
            content.classList.add('hidden');
            cancelReplyTarget();

            try {
                const res = await fetch(`/teacher/api/forum/discussion/${replyId}`);
                const data = await res.json();
                if (!data.success) {
                    alert(data.error || 'Could not load discussion.');
                    closeDiscussionModal();
                    return;
                }
                activeDiscussionData = data;
                populateDiscussionModal(data);
                loading.classList.add('hidden');
                content.classList.remove('hidden');
            } catch (err) {
                console.error(err);
                showToast('Network error while opening discussion', 'error');
                closeDiscussionModal();
            }
        }

        function closeDiscussionModal() {
            document.getElementById('discussionModal').classList.add('hidden');
            activeDiscussionData = null;
        }

        function populateDiscussionModal(data) {
            const root = data.rootTopic;
            document.getElementById('modalForumTitle').textContent = root.forum_title || '<%= forum.title %>';
            document.getElementById('modalReplyTitle').textContent = root.reply_title || 'Discussion Topic';

            // Top bar sub-meta & status badges
            const headerAuthor = document.getElementById('modalHeaderAuthorName');
            if (headerAuthor) headerAuthor.textContent = root.author_name || 'Author';

            const headerTime = document.getElementById('modalHeaderTimestamp');
            if (headerTime && root.created_at) {
                headerTime.textContent = new Date(root.created_at).toLocaleString('en-US', {
                    month: 'short', day: 'numeric', year: 'numeric', hour: 'numeric', minute: '2-digit', hour12: true
                }).replace(',', ' at');
            }

            const headerEndorsed = document.getElementById('modalHeaderEndorsedBadge');
            if (headerEndorsed) {
                if (root.is_endorsed) headerEndorsed.classList.remove('hidden');
                else headerEndorsed.classList.add('hidden');
            }

            const headerAnon = document.getElementById('modalHeaderAnonymousBadge');
            if (headerAnon) {
                if (root.is_anonymous) headerAnon.classList.remove('hidden');
                else headerAnon.classList.add('hidden');
            }

            // Author details
            const authorPic = document.getElementById('rootAuthorPic');
            authorPic.src = root.author_pic ? '/profile_uploads/' + root.author_pic : '/profile_uploads/default_avatar.png';
            document.getElementById('rootAuthorName').textContent = root.author_name;

            const isTeacher = (root.author_role || '').toLowerCase() === 'teacher';
            const roleEl = document.getElementById('rootAuthorRole');
            roleEl.textContent = isTeacher ? 'Instructor' : 'Student';
            roleEl.className = isTeacher ? 'text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-blue-100 text-blue-800 border border-blue-200' : 'text-[11px] font-semibold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600';

            // Anonymous unmasking
            const maskedBadge = document.getElementById('rootMaskedBadge');
            const unmaskBtn = document.getElementById('rootUnmaskBtn');
            const unmaskBanner = document.getElementById('rootUnmaskAuditBanner');

            if (root.is_anonymous) {
                maskedBadge.classList.remove('hidden');
                if (root.unmasked_by_me) {
                    unmaskBtn.classList.add('hidden');
                    unmaskBanner.classList.remove('hidden');
                    document.getElementById('rootRealAuthorName').textContent = root.real_author_name;
                    document.getElementById('rootRealAuthorEmail').textContent = root.real_author_email || 'Student Account';
                } else {
                    unmaskBtn.classList.remove('hidden');
