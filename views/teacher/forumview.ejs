        function renderContributors(root, replies) {
            const list = document.getElementById('threadContributorsList');
            const avatarsRow = document.getElementById('threadContributorsAvatars');
            const countBadge = document.getElementById('contributorsCountBadge');
            const map = new Map();
            if (root) map.set(root.user_id, { name: root.author_name, pic: root.author_pic, role: root.author_role, count: 1 });
            replies.forEach(r => {
                if (map.has(r.user_id)) map.get(r.user_id).count++;
                else map.set(r.user_id, { name: r.user_name, pic: r.profile_pic, role: r.role, count: 1 });
            });

            const contributors = Array.from(map.values());
            if (countBadge) countBadge.textContent = `${contributors.length} active`;

            if (avatarsRow) {
                avatarsRow.innerHTML = contributors.slice(0, 6).map(c => `
                    <img src="${c.pic ? '/profile_uploads/' + c.pic : '/profile_uploads/default_avatar.png'}"
                         alt="${escHtml(c.name)}"
                         title="${escHtml(c.name)} (${c.count} ${c.count === 1 ? 'post' : 'posts'})"
                         class="w-8 h-8 rounded-full object-cover ring-2 ring-white shadow-xs">
                `).join('') + (contributors.length > 6 ? `<span class="w-8 h-8 rounded-full bg-slate-100 ring-2 ring-white flex items-center justify-center text-[10px] font-bold text-slate-600 shadow-xs">+${contributors.length - 6}</span>` : '');
            }

            if (list) {
                list.innerHTML = contributors.map(c => {
                    const isInstructor = (c.role || '').toLowerCase() === 'teacher';
                    return `
                        <div class="flex items-center justify-between py-1.5 px-2 rounded-xl hover:bg-slate-50 transition">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <img src="${c.pic ? '/profile_uploads/' + c.pic : '/profile_uploads/default_avatar.png'}" class="w-7 h-7 rounded-full object-cover ring-1 ring-slate-200 shadow-2xs flex-shrink-0">
                                <div class="min-w-0">
                                    <span class="text-xs font-bold text-slate-800 truncate block max-w-[130px]">${escHtml(c.name)}</span>
                                    <span class="text-[10px] ${isInstructor ? 'text-blue-600 font-bold' : 'text-slate-400 font-medium'}">${isInstructor ? 'Instructor' : 'Student'}</span>
                                </div>
                            </div>
                            <span class="text-[10px] font-extrabold text-indigo-700 bg-indigo-50 border border-indigo-200/80 px-2 py-0.5 rounded-full shadow-2xs">${c.count}</span>
                        </div>
                    `;
                }).join('');
            }
