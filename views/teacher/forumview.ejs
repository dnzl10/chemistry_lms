<% if (typeof stats === 'undefined') { stats = {}; } %>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= forum.title %> | Teacher Workspace | Elementa Chemistry
    </title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .glass-effect {
            background: rgba(255, 255, 255, 0.8);
            backdrop-filter: blur(10px);
        }

        .quarter-card {
            transition: box-shadow 0.2s ease;
        }

        .quarter-card:hover {
            box-shadow: 0 4px 24px 0 rgba(99, 102, 241, 0.08);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 4px 11px;
            border-radius: 9999px;
            font-size: 12px;
            font-weight: 800;
            letter-spacing: 0.04em;
            border: none;
            cursor: pointer;
            transition: filter 0.15s, transform 0.12s;
        }

        .status-badge:hover {
            filter: brightness(0.93);
            transform: scale(0.97);
        }

        .status-badge.done {
            background: #d1fae5;
            color: #065f46;
        }

        .status-badge.not-done {
            background: #fef9c3;
            color: #854d0e;
        }

        .forum-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 16px;
            border-radius: 14px;
            border: 1.5px solid #f1f5f9;
            background: #ffffff;
            transition: box-shadow 0.15s, border-color 0.15s, transform 0.12s;
        }

        .forum-row:hover {
            box-shadow: 0 4px 16px rgba(8, 145, 178, 0.08);
            border-color: #cffafe;
            transform: translateY(-1px);
        }

        .q-number-badge {
            width: 42px;
            height: 42px;
            border-radius: 14px;
            background: linear-gradient(135deg, #0891b2, #67e8f9);
            color: #fff;
            font-size: 16px;
            font-weight: 900;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(99, 102, 241, 0.25);
        }

        .dropdown-menu {
            transform-origin: top right;
            animation: dropdownFade 0.15s ease-out;
        }

        @keyframes dropdownFade {
            from {
                opacity: 0;
                transform: scale(0.95) translateY(-5px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .empty-state {
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 40px 16px;
            gap: 10px;
        }

        .empty-state .empty-icon {
            width: 52px;
            height: 52px;
            border-radius: 16px;
            background: #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #cbd5e1;
        }

        .drawer-slide {
            transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
        }
    </style>

    <!-- Standardized Navigation & Responsive Styles -->
    <%- include('../partials/teacher-nav-styles') %>
</head>

<body class="bg-slate-50 text-slate-900 min-h-screen">

    <div class="flex min-h-screen relative overflow-x-hidden">
        <!-- Standardized Teacher Sidebar Partial -->
        <%- include('../partials/teacher-sidebar', { activeNav: 'forums' }) %>

            <!-- Main Content Area (Identical to Student Layout) -->
            <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">
                <!-- Header (Exact Student Baseline in Pic 2) -->
                <header
                    class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
                    <div class="flex items-center gap-4">
                        <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar"
                            class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                            <i class="fas fa-bars text-xl"></i>
                        </button>
                        <div>
                            <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">
                                Welcome, <%= user.first_name %>!
                            </h1>
                            <p class="text-xs text-slate-600 hidden sm:block font-medium">
                                <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                                Faculty Instructor &nbsp;&bull;&nbsp; <%= new Date().toLocaleDateString('en-PH',
                                    {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                            </p>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 md:gap-6">
                        <!-- Messages Navigation Button -->
                        <a href="/teacher/messages" id="messagesBtn" aria-label="Open messages and conversations"
                            class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                            <i class="far fa-comment-dots text-xl"></i>
                            <span
                                class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Messages
                            </span>
                        </a>

                        <!-- Notification Button -->
                        <button type="button" onclick="toggleNotifications()" aria-label="View notifications"
                            class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                            <i class="far fa-bell text-xl text-slate-700"></i>
                            <span class="absolute top-2 right-2 flex h-2.5 w-2.5 notif-badge hidden" aria-hidden="true">
                                <span
                                    class="animate-ping absolute inline-flex h-full w-full rounded-full bg-red-400 opacity-75"></span>
                                <span
                                    class="relative inline-flex rounded-full h-2.5 w-2.5 bg-red-500 border-2 border-white"></span>
                            </span>
                            <span
                                class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Notifications
                            </span>
                        </button>

                        <!-- User Profile Dropdown -->
                        <div class="relative">
                            <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false"
                                aria-label="Open user profile menu"
                                class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                                <div class="text-right hidden lg:block">
                                    <p class="text-sm font-bold text-slate-800 leading-none mb-1">
                                        <%= user.first_name %>
                                            <%= user.last_name %>
                                    </p>
                                    <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none">
                                        INSTRUCTOR</p>
                                </div>
                                <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>"
                                    alt="<%= user.first_name %>'s avatar"
                                    class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100">
                                <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                            </button>

                            <div id="userDropdown"
                                class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                                <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                                    <p class="text-sm font-bold text-slate-800">
                                        <%= user.first_name %>
                                            <%= user.last_name %>
                                    </p>
                                    <p class="text-xs text-slate-600 mt-1 uppercase font-bold">INSTRUCTOR</p>
                                </div>
                                <a href="/teacher/profile"
                                    class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                                    <i class="far fa-user w-5 text-center"></i> View Profile
                                </a>
                                <hr class="my-2 border-slate-100">
                                <a href="/logout"
                                    class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                                    <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                                </a>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- Scrollable Workspace Body (Exact Student Container & Padding) -->
                <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
                    <div class="p-4 md:p-8 flex-1">

                        <!-- HERO BANNER CARD (Identical Layout to Pic 2) -->
                        <div id="forumHeroCard" class="relative rounded-2xl overflow-hidden bg-white border border-slate-100 mb-6"
                            style="box-shadow: 0 2px 16px rgba(99,102,241,0.07);">

                            <!-- Hero Banner Cover Image -->
                            <div class="relative h-52 md:h-72 bg-slate-900 overflow-hidden">
                                <% 
                                    let heroBannerSrc = '/profile_uploads/' + (forum.subject_image || 'default_subject.png');
                                    if (forum.banner_image && forum.banner_image.trim()) {
                                        const bi = forum.banner_image.trim();
                                        heroBannerSrc = bi.startsWith('/') ? bi : ('/forum_banners/uploads/' + bi);
                                    }
                                %>
                                <img src="<%= heroBannerSrc %>"
                                    class="w-full h-full object-cover" style="transition: transform 0.4s ease;"
                                    onmouseover="this.style.transform='scale(1.03)'"
                                    onmouseout="this.style.transform='scale(1)'"
                                    onerror="this.onerror=null;this.src='/profile_uploads/<%= forum.subject_image || 'default_subject.png' %>';">

                                <!-- Gradient overlay -->
                                <div class="absolute inset-0"
                                    style="background: linear-gradient(180deg, rgba(15,23,42,0.1) 0%, rgba(15,23,42,0.85) 100%);">
                                </div>

                                <!-- Inside Banner Content at Bottom -->
                                <div class="absolute bottom-0 left-0 right-0 px-7 pb-6 pt-10">
                                    <div class="flex items-end justify-between gap-4">
                                        <div>
                                            <span style="display:inline-block;background:linear-gradient(135deg,#0891b2,#67e8f9);color:#fff;
                                                    font-size:12px;font-weight:900;letter-spacing:0.1em;text-transform:uppercase;
                                                    padding:4px 12px;border-radius:9999px;margin-bottom:8px;
                                                    box-shadow:0 2px 8px rgba(99,102,241,0.35);">
                                                <%= forum.subject_code || 'CHEMISTRY' %> &bull; FORUM
                                            </span>
                                            <h2 class="text-white font-black tracking-tight"
                                                style="font-size:clamp(1.4rem,3vw,2rem);line-height:1.15;text-shadow:0 2px 8px rgba(0,0,0,0.3);">
                                                <%= forum.title %>
                                            </h2>
                                            <p
                                                style="color:rgba(199,210,254,0.9);font-size:13px;font-weight:600;margin-top:5px;display:flex;flex-wrap:wrap;align-items:center;gap:6px;">
                                                <span><i class="fas fa-book-open text-xs mr-1"></i>
                                                    <%= forum.subject_name %>
                                                </span>
                                                <span>&bull;</span>
                                                <span><i class="fas fa-flask text-xs mr-1"></i>
                                                    <%= forum.topic_name || 'Academic Discussion' %>
                                                </span>
                                                <span>&bull;</span>
                                                <span><i class="fas fa-calendar-alt text-xs mr-1"></i>Posted <%= new
                                                        Date(forum.created_at || Date.now()).toLocaleDateString('en-PH',
                                                        { month: 'short' , day: 'numeric' , year: 'numeric' }) %></span>
                                                <% if (forum.due_date) { %>
                                                    <span>&bull;</span>
                                                    <span class="text-amber-300 font-bold"><i
                                                            class="fas fa-clock text-xs mr-1"></i>Due <%= new
                                                            Date(forum.due_date).toLocaleDateString('en-PH', {
                                                            month: 'short' , day: 'numeric' , hour: '2-digit' ,
                                                            minute: '2-digit' }) %></span>
                                                    <% } %>
                                                        <span>&bull;</span>
                                                        <span class="text-cyan-300 font-bold"><i
                                                                class="fas fa-bolt text-xs mr-1"></i>
                                                            <%= forum.base_exp || 100 %> EXP
                                                        </span>
                                                        <% if (forum.post_before_viewing) { %>
                                                            <span>&bull;</span>
                                                            <span class="text-rose-300 font-bold"><i
                                                                    class="fas fa-lock text-xs mr-1"></i>Post-First
                                                                Gated</span>
                                                            <% } %>
                                            </p>
                                        </div>

                                        <!-- Quick actions for teacher on hover/focus -->
                                        <div class="flex items-center gap-2">
                                            <button onclick="togglePinForum(<%= forum.forum_id %>)"
                                                class="w-9 h-9 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md text-white flex items-center justify-center transition cursor-pointer"
                                                title="<%= forum.is_pinned ? 'Unpin Forum' : 'Pin Forum' %>">
                                                <i
                                                    class="fas fa-thumbtack text-xs <%= forum.is_pinned ? 'text-amber-400' : '' %>"></i>
                                            </button>
                                            <button onclick="openEditForumModal(); setBannerStudioTab('forumView', 'preset');"
                                                class="w-9 h-9 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md text-white flex items-center justify-center transition cursor-pointer"
                                                title="Change Cover Banner">
                                                <i class="fas fa-image text-xs"></i>
                                            </button>
                                            <button onclick="openEditForumModal()"
                                                class="w-9 h-9 rounded-xl bg-white/20 hover:bg-white/30 backdrop-blur-md text-white flex items-center justify-center transition cursor-pointer"
                                                title="Edit Forum Prompt">
                                                <i class="fas fa-pen text-xs"></i>
                                            </button>
                                            <button onclick="openDeleteForumModal()"
                                                class="w-9 h-9 rounded-xl bg-rose-500/30 hover:bg-rose-500/50 backdrop-blur-md text-rose-200 flex items-center justify-center transition cursor-pointer"
                                                title="Delete Forum">
                                                <i class="fas fa-trash-alt text-xs"></i>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Hero Body Grid (2 Cols Left, 1 Col Right) -->
                            <div class="p-7 grid grid-cols-1 lg:grid-cols-3 gap-7">

                                <!-- Left: Overview & Quick Stats -->
                                <div class="lg:col-span-2 flex flex-col gap-6 justify-between">
                                    <div>
                                        <h3
                                            class="text-xs font-black text-indigo-400 tracking-wider uppercase mb-2 flex items-center gap-1.5">
                                            <i class="fas fa-info-circle"></i> Discussion Overview & Objectives
                                        </h3>
                                        <div class="text-sm md:text-base text-slate-600 leading-relaxed font-normal prose max-w-none text-justify"
                                            style="text-align: justify;">
                                            <%- forum.forum_content
                                                || '<p class="text-slate-400 italic">No prompt provided for this forum.</p>'
                                                %>
                                        </div>
                                        <% if (forum.attachment_path) { %>
                                            <div class="mt-4 pt-3 border-t border-slate-100 flex items-center gap-2">
                                                <a href="<%= forum.attachment_path %>"
                                                    download="<%= forum.attachment_name || 'worksheet' %>"
                                                    class="inline-flex items-center gap-2 px-3.5 py-2 rounded-xl bg-indigo-50 hover:bg-indigo-100 border border-indigo-200/80 text-xs font-bold text-indigo-700 transition shadow-2xs">
                                                    <i class="fas fa-paperclip text-indigo-500"></i>
                                                    <span>
                                                        <%= forum.attachment_name || 'Download Reference Worksheet' %>
                                                    </span>
                                                    <i class="fas fa-download text-[10px] text-indigo-400 ml-1"></i>
                                                </a>
                                            </div>
                                            <% } %>
                                    </div>

                                    <!-- Quick stats row (Exact 3 Cards from Pic 2) -->
                                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 pt-3 border-t border-slate-100">
                                        <!-- Stat 1: Discussion Status -->
                                        <div
                                            class="p-4 rounded-2xl bg-gradient-to-br from-indigo-50/90 to-blue-50/60 border border-indigo-100/90 flex flex-col justify-between shadow-xs">
                                            <div class="flex items-center justify-between mb-2">
                                                <span
                                                    class="text-xs font-black tracking-wider uppercase text-indigo-600">Discussion
                                                    Status</span>
                                                <select id="forumStatusSelect" onchange="updateForumStatus(this.value)"
                                                    class="text-xs font-black px-2 py-0.5 rounded-full border border-indigo-200 bg-white/90 cursor-pointer text-indigo-800 shadow-2xs focus:outline-none">
                                                    <option value="unresolved" <%=forum.status==='unresolved'
                                                        ? 'selected' : '' %>>In Progress</option>
                                                    <option value="solved" <%=forum.status==='solved' ? 'selected' : ''
                                                        %>>Completed</option>
                                                    <option value="instructor_verified"
                                                        <%=forum.status==='instructor_verified' ? 'selected' : '' %>
                                                        >Verified</option>
                                                </select>
                                            </div>
                                            <div class="w-full bg-slate-200 h-1.5 rounded-full overflow-hidden mb-1.5">
                                                <div class="h-full bg-indigo-600 rounded-full transition-all duration-500"
                                                    style="width: <%= (typeof stats !== 'undefined' && stats && stats.completion_rate) ? stats.completion_rate : (forum.status === 'solved' || forum.status === 'instructor_verified' ? 100 : 35) %>%;">
                                                </div>
                                            </div>
                                            <p class="text-[11px] font-semibold text-slate-500">Peer collaboration task
                                            </p>
                                        </div>

                                        <!-- Stat 2: Cohort Topics -->
                                        <div
                                            class="p-4 rounded-2xl bg-gradient-to-br from-emerald-50/90 to-teal-50/60 border border-emerald-100/90 flex flex-col justify-between shadow-xs">
                                            <div class="flex items-center justify-between mb-1">
                                                <span
                                                    class="text-xs font-black tracking-wider uppercase text-emerald-700">Cohort
                                                    Topics</span>
                                                <i class="fas fa-layer-group text-emerald-500 text-sm"></i>
                                            </div>
                                            <div class="text-xl font-black text-emerald-950">
                                                <%= discussions ? discussions.length : 0 %> <span
                                                        class="text-xs font-semibold text-emerald-600 font-normal">Active
                                                        threads</span>
                                            </div>
                                            <p class="text-[11px] font-semibold text-slate-500 mt-1">Student hypotheses
                                                & debates</p>
                                        </div>

                                        <!-- Stat 3: Contributions -->
                                        <div
                                            class="p-4 rounded-2xl bg-gradient-to-br from-cyan-50/90 to-sky-50/60 border border-cyan-100/90 flex flex-col justify-between shadow-xs">
                                            <div class="flex items-center justify-between mb-1">
                                                <span
                                                    class="text-xs font-black tracking-wider uppercase text-cyan-700">Contributions</span>
                                                <i class="fas fa-comment-dots text-cyan-500 text-sm"></i>
                                            </div>
                                            <div class="text-xl font-black text-cyan-950">
                                                <%= (stats && stats.total_responses) ? stats.total_responses : 0 %>
                                                    <span
                                                        class="text-xs font-semibold text-cyan-600 font-normal">Responses</span>
                                            </div>
                                            <p class="text-[11px] font-semibold text-slate-500 mt-1">Across entire class
                                                cohort</p>
                                        </div>
                                    </div>
                                </div>

                                <!-- Right: Requirement & Facilitator Cards (Exact 2 Cards from Pic 2) -->
                                <div class="flex flex-col gap-4">
                                    <!-- Activity Requirement Card (Cohort Progress) -->
                                    <div>
                                        <h3
                                            class="text-xs font-black text-indigo-400 tracking-wider uppercase mb-2 flex items-center gap-1.5">
                                            <i class="fas fa-tasks"></i> Activity Requirement
                                        </h3>
                                        <div class="p-4 bg-emerald-50/60 border border-emerald-200/80 rounded-2xl transition hover:shadow-md hover:shadow-emerald-500/10 cursor-pointer"
                                            onclick="openRosterDrawer()" title="Click to view student cohort progress">
                                            <div class="flex justify-between items-center mb-2.5">
                                                <span
                                                    class="text-xs font-extrabold uppercase text-emerald-800 tracking-wider">Cohort
                                                    Progress</span>
                                                <button type="button" class="status-badge done cursor-pointer">
                                                    <i class="fas fa-check-circle"></i>
                                                    <span>
                                                        <%= stats ? stats.done_count : 0 %>/<%= stats ?
                                                                stats.enrolled_count : 0 %> Done
                                                    </span>
                                                </button>
                                            </div>
                                            <p class="text-xs font-bold text-emerald-900 leading-snug">
                                                <%= (stats && stats.done_count === stats.enrolled_count && stats.enrolled_count > 0) ? 'All enrolled students have marked this forum activity as completed.' : 'Students marked this forum activity as completed upon participating.' %>
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Faculty Facilitator Card -->
                                    <div>
                                        <h3
                                            class="text-xs font-black text-indigo-400 tracking-wider uppercase mb-2 flex items-center gap-1.5">
                                            <i class="fas fa-chalkboard-teacher"></i> Faculty Facilitator
                                        </h3>
                                        <div
                                            class="flex items-center gap-3 p-3.5 bg-cyan-50/40 border border-slate-200/80 rounded-2xl transition hover:shadow-md hover:shadow-indigo-500/10">
                                            <div class="relative flex-shrink-0">
                                                <img src="/profile_uploads/<%= (forum.teacher_pic || user.profile_pic) ? (forum.teacher_pic || user.profile_pic) : 'default_avatar.png' %>"
                                                    class="w-11 h-11 rounded-full object-cover border-2 border-cyan-400 shadow-xs"
                                                    onerror="this.onerror=null;this.src='/profile_uploads/default_avatar.png';">
                                                <span
                                                    class="absolute bottom-0 right-0 w-2.5 h-2.5 bg-emerald-400 rounded-full border-2 border-white"></span>
                                            </div>
                                            <div class="min-w-0 flex-1">
                                                <p class="text-sm font-extrabold text-slate-800 truncate">Prof. <%=
                                                        forum.teacher_last ? (forum.teacher_first + ' ' +
                                                        forum.teacher_last) : (user.first_name + ' ' + user.last_name)
                                                        %>
                                                </p>
                                                <p
                                                    class="text-xs font-bold text-cyan-700 flex items-center gap-1 mt-0.5">
                                                    <i class="fas fa-star text-[10px] text-amber-500"></i> Subject
                                                    Instructor
                                                </p>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                            </div>
                        </div>

                        <!-- DISCUSSION THREADS & TOPICS SECTION (Exact Match to Pic 2) -->
                        <div class="space-y-4">
                            <div class="flex flex-col md:flex-row md:items-center justify-between gap-3 pt-2">
                                <h2 class="text-xl font-black text-slate-800 flex items-center gap-3">
                                    <i class="fas fa-comments text-cyan-600"></i> Discussion Threads & Topics
                                </h2>

                                <!-- Search & Action Bar -->
                                <div class="flex flex-wrap items-center gap-2">
                                    <div class="relative flex-1 sm:w-64">
                                        <i
                                            class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                                        <input type="text" id="discussionSearch"
                                            placeholder="Search topics or authors..." oninput="handleSearch(this.value)"
                                            class="w-full pl-8 pr-3 py-1.5 text-xs font-medium bg-white border border-slate-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-cyan-500/20 focus:border-cyan-500 text-slate-700 placeholder-slate-400 transition shadow-2xs">
                                    </div>
                                    <div class="flex items-center gap-1 overflow-x-auto pb-1 sm:pb-0"
                                        id="quickFilterPills">
                                        <button type="button" onclick="setFilter('all', this)"
                                            class="filter-pill active px-3 py-1 rounded-lg text-xs font-bold bg-cyan-600 text-white shadow-2xs transition">
                                            All (<span id="countAll">
                                                <%= (discussions && discussions.length) || 0 %>
                                            </span>)
                                        </button>
                                        <button type="button" onclick="setFilter('starred', this)"
                                            class="filter-pill px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-600 transition">
                                            <i class="fas fa-star text-amber-400 mr-1"></i> Starred (<span
                                                id="countStarred">
                                                <%= (discussions ? discussions.filter(d=> d.is_starred).length : 0) %>
                                            </span>)
                                        </button>
                                        <button type="button" onclick="setFilter('endorsed', this)"
                                            class="filter-pill px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-600 transition">
                                            <i class="fas fa-check-circle text-emerald-500 mr-1"></i> Endorsed (<span
                                                id="countEndorsed">
                                                <%= (discussions ? discussions.filter(d=> d.is_endorsed).length : 0) %>
                                            </span>)
                                        </button>
                                        <button type="button" onclick="setFilter('reported', this)"
                                            class="filter-pill px-3 py-1 rounded-lg text-xs font-bold bg-slate-100 hover:bg-slate-200 text-slate-600 transition">
                                            <i class="fas fa-flag text-rose-500 mr-1"></i> Reported (<span
                                                id="countReported">
                                                <%= (discussions ? discussions.filter(d=> d.report_count > 0).length :
                                                    0) %>
                                            </span>)
                                        </button>
                                    </div>
                                    <button type="button" onclick="openNewTopicModal()"
                                        class="px-4 py-1.5 rounded-xl bg-gradient-to-r from-cyan-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white text-xs font-black shadow-md hover:shadow-cyan-500/25 transition flex items-center gap-2 cursor-pointer whitespace-nowrap">
                                        <i class="fas fa-plus"></i> Add Discussion Topic
                                    </button>
                                </div>
                            </div>

                            <!-- Main Outer Quarter-Card (Exact Match to Pic 2) -->
                            <div class="quarter-card bg-white rounded-2xl border border-slate-200 overflow-hidden mb-5"
                                style="box-shadow: 0 1px 6px rgba(0,0,0,0.05);">

                                <!-- Card Header Bar -->
                                <div class="w-full px-6 py-5 flex items-center justify-between"
                                    style="background: linear-gradient(90deg,#ecfeff,#eef2ff); transition: background 0.2s;">
                                    <div class="flex items-center gap-4">
                                        <div class="q-number-badge">
                                            <i class="fas fa-layer-group text-sm"></i>
                                        </div>
                                        <div class="text-left">
                                            <h4 class="font-black text-slate-800 text-base tracking-tight">
                                                <%= forum.title %>
                                            </h4>
                                            <p
                                                class="text-xs text-indigo-400 font-bold uppercase tracking-widest mt-0.5">
                                                <i class="fas fa-users mr-1"></i> Class Collaboration & Peer Reviews
                                            </p>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2">
                                        <span
                                            class="text-xs font-bold text-indigo-500 px-3 py-1 rounded-full bg-white border border-indigo-100 shadow-2xs">
                                            <span id="topicCountBadge">
                                                <%= (discussions && discussions.length) || 0 %>
                                            </span> Topics Available
                                        </span>
                                    </div>
                                </div>

                                <!-- Discussion Topics List Panel (Exact Match to Pic 2) -->
                                <div class="border-t border-indigo-50 p-6 space-y-3" style="background: #fafafa;"
                                    id="topicsContainer">
                                    <% if (discussions && discussions.length> 0) { %>
                                        <% discussions.forEach(topic=> {
                                            const fExt = (topic.file_path ? topic.file_path.split('.').pop() :
                                            '').toLowerCase();
                                            const isAudio = ['mp3','wav','ogg','webm','m4a'].includes(fExt);
                                            const isImg = ['jpg','jpeg','png','gif','webp'].includes(fExt);
                                            %>
                                            <div class="forum-row flex flex-col sm:flex-row sm:items-center justify-between gap-4 p-4 rounded-2xl border border-slate-200/80 bg-white hover:border-cyan-300 hover:shadow-md transition-all group cursor-pointer discussion-row"
                                                id="topic-row-<%= topic.reply_id %>"
                                                onclick="openDiscussionModal(<%= topic.reply_id %>)"
                                                data-id="<%= topic.reply_id %>"
                                                data-title="<%= String(topic.reply_title || '').toLowerCase() %>"
                                                data-author="<%= String(topic.author_name || '').toLowerCase() %>"
                                                data-endorsed="<%= topic.is_endorsed ? '1' : '0' %>"
                                                data-reported="<%= (topic.report_count && topic.report_count > 0) ? '1' : '0' %>"
                                                data-starred="<%= topic.is_starred ? '1' : '0' %>">

                                                <!-- Left Side: Author Avatar & Topic Information -->
                                                <div class="flex items-center gap-3.5 min-w-0 flex-1">
                                                    <div class="relative flex-shrink-0">
                                                        <img src="/profile_uploads/<%= topic.author_pic || 'default_avatar.png' %>"
                                                            alt="<%= topic.author_name %>"
                                                            class="w-11 h-11 rounded-xl object-cover ring-2 ring-slate-100 shadow-2xs"
                                                            onerror="this.onerror=null;this.src='/profile_uploads/default_avatar.png';">
                                                        <% if (topic.is_starred) { %>
                                                            <span
                                                                class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-amber-400 text-white flex items-center justify-center text-[9px] shadow-xs">
                                                                <i class="fas fa-star"></i>
                                                            </span>
                                                            <% } %>
                                                    </div>

                                                    <div class="min-w-0 flex-1">
                                                        <!-- Title & Attached Media Chip -->
                                                        <div class="flex items-center gap-2 flex-wrap mb-1">
                                                            <h5 class="font-extrabold text-sm md:text-base text-slate-800 group-hover:text-cyan-600 transition truncate"
                                                                title="<%= topic.reply_title %>">
                                                                <%= topic.reply_title %>
                                                            </h5>
                                                            <% if (topic.is_endorsed) { %>
                                                                <span
                                                                    class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-extrabold bg-emerald-100 text-emerald-800 border border-emerald-300 shadow-2xs">
                                                                    <i class="fas fa-check-circle text-emerald-600"></i>
                                                                    Instructor Endorsed Answer
                                                                </span>
                                                                <% } %>
                                                                    <% if (topic.file_path) { %>
                                                                        <span
                                                                            class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[10px] font-black uppercase tracking-wider <%= isAudio ? 'bg-amber-100 text-amber-800' : isImg ? 'bg-emerald-100 text-emerald-800' : 'bg-cyan-100 text-cyan-800' %>">
                                                                            <i
                                                                                class="fas <%= isAudio ? 'fa-microphone-lines' : isImg ? 'fa-image' : 'fa-paperclip' %>"></i>
                                                                            <%= isAudio ? 'Voice Note' :
                                                                                (topic.file_name || 'Attachment' ) %>
                                                                        </span>
                                                                        <% } %>
                                                        </div>

                                                        <!-- Snippet preview (Identical to Pic 2) -->
                                                        <p class="text-xs text-slate-500 line-clamp-1 mb-1 font-medium">
                                                            <%= (topic.reply_content || '' ).replace(/<[^>]*>?/gm,
                                                                '').trim() || 'No preview available' %>
                                                        </p>

                                                        <!-- Metadata (Identical to Pic 2) -->
                                                        <div
                                                            class="flex items-center gap-3 text-[11px] text-slate-400 flex-wrap">
                                                            <span
                                                                class="font-bold text-slate-600 flex items-center gap-1">
                                                                <i class="far fa-user text-[10px]"></i>
                                                                <%= topic.author_name %>
                                                                    <% if (topic.is_anonymous) { %>
                                                                        <span
                                                                            class="text-[9px] font-bold text-slate-600 bg-slate-100 px-1 py-0.2 rounded">Masked</span>
                                                                        <% } %>
                                                            </span>
                                                            <span>&bull;</span>
                                                            <span>
                                                                <i class="far fa-clock text-[10px] mr-0.5"></i>
                                                                <%= new
                                                                    Date(topic.created_at).toLocaleDateString('en-PH', {
                                                                    month: 'short' , day: 'numeric' , hour: '2-digit' ,
                                                                    minute: '2-digit' }) %>
                                                            </span>
                                                            <span>&bull;</span>
                                                            <span
                                                                class="text-cyan-700 font-extrabold flex items-center gap-1">
                                                                <i class="far fa-comments"></i>
                                                                <%= topic.sub_reply_count || topic.reply_count || 0 %>
                                                                    <%= (topic.sub_reply_count || topic.reply_count ||
                                                                        0)===1 ? 'reply' : 'replies' %>
                                                            </span>
                                                            <% if (topic.last_reply_author ||
                                                                topic.last_reply_user_name) { %>
                                                                <span>&bull;</span>
                                                                <span
                                                                    class="text-slate-500 font-semibold hidden sm:inline">
                                                                    Last activity by <%= topic.last_reply_author ||
                                                                        topic.last_reply_user_name %>
                                                                </span>
                                                                <% } %>
                                                        </div>
                                                    </div>
                                                </div>

                                                <!-- Right Side: Star, Open Discussion CTA & Ellipses Menu (Exact Pic 2 Layout) -->
                                                <div class="flex items-center gap-2 flex-shrink-0"
                                                    onclick="event.stopPropagation();">
                                                    <!-- Star Toggle Button -->
                                                    <button type="button"
                                                        onclick="event.stopPropagation(); toggleStarTopicDirect(<%= topic.reply_id %>, this)"
                                                        class="star-btn w-9 h-9 rounded-xl flex items-center justify-center transition <%= topic.is_starred ? 'bg-amber-50 text-amber-500 border border-amber-200' : 'bg-slate-50 text-slate-400 hover:text-amber-500 border border-slate-200' %>"
                                                        title="<%= topic.is_starred ? 'Unstar discussion' : 'Star discussion' %>">
                                                        <i class="fas fa-star text-xs"></i>
                                                    </button>

                                                    <!-- Open Discussion CTA Button -->
                                                    <button type="button"
                                                        onclick="event.stopPropagation(); openDiscussionModal(<%= topic.reply_id %>);"
                                                        class="px-3.5 py-2 rounded-xl bg-slate-100 hover:bg-cyan-600 text-slate-700 hover:text-white font-extrabold text-xs transition-all flex items-center gap-1.5 shadow-2xs group cursor-pointer"
                                                        title="Open Discussion Thread">
                                                        <span>Open</span>
                                                        <i
                                                            class="fas fa-arrow-right text-[10px] group-hover:translate-x-0.5 transition-transform"></i>
                                                    </button>

                                                    <!-- Ellipses Dropdown Menu -->
                                                    <div class="relative inline-block text-left">
                                                        <button type="button"
                                                            onclick="event.stopPropagation(); toggleActionDropdown(event, '<%= topic.reply_id %>')"
                                                            aria-label="Discussion options"
                                                            class="w-9 h-9 rounded-xl hover:bg-slate-100 text-slate-400 hover:text-slate-700 flex items-center justify-center transition border border-transparent hover:border-slate-200 cursor-pointer">
                                                            <i class="fas fa-ellipsis-v text-xs"></i>
                                                        </button>

                                                        <div id="dropdown-<%= topic.reply_id %>"
                                                            class="dropdown-menu hidden absolute right-0 mt-2 w-52 bg-white rounded-2xl shadow-xl border border-slate-100 py-1.5 z-30">
                                                            <button onclick="openDiscussionModal(<%= topic.reply_id %>)"
                                                                class="w-full text-left px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-cyan-600 flex items-center gap-2 transition">
                                                                <i class="fas fa-book-open text-cyan-600 w-4"></i> View
                                                                Discussion
                                                            </button>
                                                            <button
                                                                onclick="toggleEndorseTopicDirect(<%= topic.reply_id %>, this)"
                                                                class="w-full text-left px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-emerald-600 flex items-center gap-2 transition">
                                                                <i class="fas fa-check-circle text-emerald-500 w-4"></i>
                                                                <%= topic.is_endorsed ? 'Remove Endorsement'
                                                                    : 'Endorse Solution' %>
                                                            </button>
                                                            <button
                                                                onclick="toggleStarTopicDirect(<%= topic.reply_id %>, this)"
                                                                class="w-full text-left px-4 py-2 text-xs font-bold text-slate-700 hover:bg-slate-50 hover:text-amber-600 flex items-center gap-2 transition">
                                                                <i class="fas fa-star text-amber-500 w-4"></i>
                                                                <%= topic.is_starred ? 'Unstar' : 'Star Discussion' %>
                                                            </button>
                                                            <% if (topic.is_anonymous) { %>
                                                                <button
                                                                    onclick="openUnmaskAuthorModalDirect(<%= topic.reply_id %>)"
                                                                    class="w-full text-left px-4 py-2 text-xs font-bold text-amber-600 hover:bg-amber-50 flex items-center gap-2 transition">
                                                                    <i class="fas fa-eye text-amber-500 w-4"></i> Reveal
                                                                    Author Identity
                                                                </button>
                                                                <% } %>
                                                                    <div class="my-1 border-t border-slate-100"></div>
                                                                    <button
                                                                        onclick="deleteTopicDirect(<%= topic.reply_id %>)"
                                                                        class="w-full text-left px-4 py-2 text-xs font-bold text-rose-600 hover:bg-rose-50 flex items-center gap-2 transition">
                                                                        <i
                                                                            class="fas fa-trash-alt text-rose-500 w-4"></i>
                                                                        Delete Discussion
                                                                    </button>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <div class="empty-state py-12">
                                                        <div class="empty-icon">
                                                            <i class="far fa-comments"></i>
                                                        </div>
                                                        <h5 class="text-sm font-bold text-slate-700">No discussions yet
                                                        </h5>
                                                        <p class="text-xs text-slate-400">Be the first to create a topic
                                                            and kickstart the conversation.</p>
                                                        <button onclick="openNewTopicModal()"
                                                            class="mt-3 px-4 py-1.5 rounded-xl bg-cyan-600 hover:bg-cyan-500 text-white text-xs font-bold transition flex items-center gap-1.5 cursor-pointer">
                                                            <i class="fas fa-plus text-xs"></i> Start Discussion
                                                        </button>
                                                    </div>
                                                    <% } %>
                                </div>
                            </div>
                        </div>

                    </div>
                </div>
            </main>
    </div>

    <!-- OPEN DISCUSSION MODAL (SPLIT 68% / 32% - Identical to Student & Pic 2) -->
    <div id="discussionModal" onclick="if(event.target === this) closeDiscussionModal()"
        class="fixed inset-0 z-50 hidden flex items-center justify-center p-3 md:p-6 lg:p-8 bg-slate-900/60 backdrop-blur-md transition-all duration-200">
        <div id="discussionModalContainer"
            class="relative w-full max-w-6xl xl:max-w-7xl h-[92vh] rounded-[28px] shadow-2xl flex flex-col overflow-hidden border border-slate-200/90 bg-white transition-all duration-200">

            <!-- Modal Top Bar -->
            <div
                class="pt-4 px-6 md:px-8 pb-3.5 bg-white/95 backdrop-blur-xs flex items-center justify-between flex-shrink-0 border-b border-slate-200/80 gap-4">
                <div class="flex-1 min-w-0">
                    <!-- Clean Breadcrumb Path -->
                    <div class="flex items-center gap-1.5 flex-wrap text-xs font-semibold text-slate-500 mb-1">
                        <span class="hover:text-slate-700 transition">Forums</span>
                        <i class="fas fa-chevron-right text-[8px] text-slate-300"></i>
                        <span id="modalCourseTopic"
                            class="inline-flex items-center px-2 py-0.5 rounded-md text-[11px] font-bold bg-blue-50 text-blue-700 border border-blue-100">
                            <%= forum.subject_name || 'General Chemistry 1' %>
                        </span>
                        <i class="fas fa-chevron-right text-[8px] text-slate-300"></i>
                        <span id="modalForumTitle" class="truncate max-w-[280px] text-slate-600 font-medium" title="<%= forum.title %>">
                            <%= forum.title %>
                        </span>
                    </div>

                    <!-- Thread Title & Status Row -->
                    <div class="flex items-center gap-3 flex-wrap">
                        <h2 id="modalReplyTitle"
                            class="text-lg md:text-xl font-bold text-slate-900 tracking-tight leading-snug truncate max-w-2xl">
                            Discussion Topic
                        </h2>

                        <!-- Header Status Pills -->
                        <div class="flex items-center gap-1.5">
                            <span id="modalHeaderEndorsedBadge"
                                class="hidden inline-flex items-center gap-1.5 text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200 shadow-2xs">
                                <i class="fas fa-circle-check text-emerald-600"></i> Endorsed
                            </span>
                            <span id="modalHeaderAnonymousBadge"
                                class="hidden inline-flex items-center gap-1 text-[11px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">
                                <i class="fas fa-user-secret text-amber-600"></i> Anonymous
                            </span>
                        </div>
                    </div>

                    <!-- Quick Sub-meta: Author & Timestamp preview -->
                    <p id="modalHeaderSubMeta" class="text-xs text-slate-400 mt-0.5 flex items-center gap-1.5">
                        <span>Started by <strong id="modalHeaderAuthorName" class="text-slate-600 font-semibold">Author</strong></span>
                        <span class="text-slate-300">•</span>
                        <span id="modalHeaderTimestamp">Timestamp</span>
                    </p>
                </div>

                <!-- Window controls -->
                <div class="flex items-center gap-1.5 flex-shrink-0">
                    <button type="button" onclick="toggleModalFullscreen()" id="modalFullscreenBtn"
                        class="w-8 h-8 rounded-xl hover:bg-slate-100 text-slate-400 hover:text-slate-700 flex items-center justify-center transition cursor-pointer"
                        title="Full screen">
                        <i class="fas fa-expand-alt text-xs" id="modalFullscreenIcon"></i>
                    </button>
                    <button type="button" onclick="closeDiscussionModal()"
                        class="w-8 h-8 rounded-xl hover:bg-rose-50 text-slate-400 hover:text-rose-600 flex items-center justify-center transition cursor-pointer"
                        aria-label="Close modal" title="Close (Esc)">
                        <i class="fas fa-times text-sm"></i>
                    </button>
                </div>
            </div>

            <!-- Modal Split Body -->
            <div class="flex-1 flex flex-col lg:flex-row min-h-0 overflow-hidden bg-slate-50/60">

                <!-- LEFT MAIN THREAD WORKSPACE (68%) -->
                <div class="flex-1 flex flex-col min-h-0 overflow-hidden bg-slate-50/60 border-r border-slate-200/80">
                    <div class="flex-1 overflow-y-auto px-5 md:px-8 py-6 space-y-6 no-scrollbar"
                        id="modalThreadScrollArea">

                        <!-- Loading State -->
                        <div id="modalLoadingState" class="py-24 text-center space-y-3">
                            <div
                                class="w-9 h-9 border-3 border-teal-500 border-t-transparent rounded-full animate-spin mx-auto">
                            </div>
                            <p class="text-xs font-semibold text-slate-400">Loading discussion thread...</p>
                        </div>

                        <!-- Main Root Discussion Card (Constrained Max-Width for Optimal Line Length) -->
                        <div id="modalRootContent" class="hidden space-y-6 max-w-4xl mx-auto w-full">
                            <!-- Scholar Card: Anchor Inquiry Prompt -->
                            <div class="rounded-2xl border border-slate-200/90 p-6 md:p-7 bg-white relative shadow-sm border-l-4 border-l-indigo-600 transition-all">

                                <!-- Author & Controls Row -->
                                <div class="flex items-start justify-between gap-4 mb-4 pb-3.5 border-b border-slate-100/90">
                                    <div class="flex items-center gap-3.5 min-w-0">
                                        <img id="rootAuthorPic" src="/profile_uploads/default_avatar.png" alt="Author"
                                            class="w-11 h-11 rounded-full object-cover ring-2 ring-slate-100 flex-shrink-0 shadow-2xs">
                                        <div class="min-w-0">
                                            <div class="flex items-center gap-2 flex-wrap">
                                                <h4 id="rootAuthorName"
                                                    class="text-sm md:text-base font-bold text-slate-900 leading-snug">Student Name
                                                </h4>
                                                <span id="rootAuthorRole"
                                                    class="text-[11px] font-bold px-2.5 py-0.5 rounded-full bg-slate-100 text-slate-600">Student</span>
                                                <span id="rootMaskedBadge"
                                                    class="hidden inline-flex items-center gap-1.5 text-[11px] font-extrabold px-2.5 py-0.5 rounded-full bg-amber-50 text-amber-800 border border-amber-200 shadow-2xs">
                                                    <i class="fas fa-user-secret text-amber-600"></i> Anonymous Post
                                                </span>
                                                <span id="rootEndorsedBadge"
                                                    class="hidden inline-flex items-center gap-1.5 text-[11px] font-extrabold px-2.5 py-0.5 rounded-full bg-emerald-50 text-emerald-800 border border-emerald-200 shadow-2xs">
                                                    <i class="fas fa-check-circle text-emerald-600"></i> Instructor Endorsed
                                                </span>
                                            </div>
                                            <p id="rootTimestamp" class="text-xs text-slate-400 mt-1 flex items-center gap-1.5">
                                                <i class="far fa-clock text-[10px] text-slate-400"></i>
                                                <span id="rootTimestampText">Timestamp</span>
                                            </p>
                                        </div>
                                    </div>

                                    <!-- Teacher Actions for Root Topic -->
                                    <div class="flex items-center gap-2 flex-shrink-0">
                                        <!-- Unmask Author Break-Glass Button -->
                                        <button type="button" id="rootUnmaskBtn" onclick="openUnmaskAuthorModal('root')"
                                            class="hidden px-3 py-1.5 rounded-xl text-xs font-bold bg-amber-50 hover:bg-amber-100 text-amber-800 border border-amber-200 transition shadow-2xs cursor-pointer flex items-center gap-1.5">
                                            <i class="fas fa-eye text-amber-600"></i>
                                            <span>Unmask Author</span>
                                        </button>

                                        <!-- Endorse Toggle Button -->
                                        <button type="button" id="rootEndorseBtn" onclick="toggleActiveRootEndorse()"
                                            class="px-3 py-1.5 rounded-xl text-xs font-bold border border-slate-200 hover:border-emerald-500 hover:bg-emerald-50 hover:text-emerald-700 text-slate-700 transition shadow-2xs cursor-pointer flex items-center gap-1.5">
                                            <i class="fas fa-check-circle text-emerald-600"></i>
                                            <span id="rootEndorseBtnText">Endorse</span>
                                        </button>

                                        <!-- Delete Topic Button -->
                                        <button type="button" id="rootDeleteBtn" onclick="deleteActiveRootTopic()"
                                            class="w-8 h-8 rounded-xl border border-slate-200 hover:border-rose-300 hover:bg-rose-50 hover:text-rose-600 text-slate-400 transition cursor-pointer flex items-center justify-center shadow-2xs"
                                            title="Delete Topic">
                                            <i class="fas fa-trash-alt text-xs"></i>
                                        </button>
                                    </div>
                                </div>

                                <!-- Unmask Log Banner -->
                                <div id="rootUnmaskAuditBanner"
                                    class="hidden mb-4 p-3.5 rounded-xl bg-amber-50/90 border border-amber-300 text-xs text-amber-950 font-medium flex items-center justify-between gap-3 shadow-2xs">
                                    <div class="flex items-center gap-2.5">
                                        <i class="fas fa-shield-halved text-amber-600 text-base"></i>
                                        <span>Real Identity Revealed: <strong id="rootRealAuthorName" class="font-extrabold text-amber-900"></strong>
                                            (<span id="rootRealAuthorEmail" class="text-amber-800"></span>)</span>
                                    </div>
                                    <span
                                        class="text-[10px] font-extrabold uppercase tracking-wider text-amber-800 bg-amber-200/80 px-2.5 py-1 rounded-lg border border-amber-300">Audit
                                        Logged</span>
                                </div>

                                <!-- Title & Body -->
                                <h3 id="rootDiscussionTitle"
                                    class="text-lg md:text-xl font-extrabold text-slate-900 mb-2.5 leading-snug tracking-tight">Discussion
                                    Title</h3>
                                <div id="rootDiscussionBody"
                                    class="text-sm md:text-[15px] text-slate-700 leading-relaxed font-normal break-words prose prose-slate max-w-none">
                                </div>

                                <!-- Media Container -->
                                <div id="rootMediaContainer" class="mt-5 pt-4 border-t border-slate-100 hidden"></div>
                            </div>

                            <!-- Responses Sub-Tree Section -->
                            <div class="pt-2">
                                <div class="flex items-center justify-between mb-4 pb-2 border-b border-slate-200/80">
                                    <h4
                                        class="text-xs font-black uppercase tracking-wider text-slate-500 flex items-center gap-2">
                                        <i class="fas fa-comments text-indigo-600"></i>
                                        <span>Discussion Responses</span>
                                        <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[11px] font-bold bg-indigo-50 text-indigo-700 border border-indigo-200">
                                            <span id="modalRepliesCount">0</span>
                                        </span>
                                    </h4>
                                    <span class="text-[11px] text-slate-400 font-medium">Threaded view</span>
                                </div>

                                <div id="modalRepliesTree" class="space-y-3.5"></div>
                            </div>
                        </div>

                    </div>

                    <!-- Teacher Quick Sub-Reply Composer Bar (Exact Match to Pic 2 Style) -->
                    <div class="p-4 md:p-5 bg-white border-t border-slate-200/80 flex-shrink-0 shadow-lg">
                        <form onsubmit="submitSubReply(event)" class="max-w-4xl mx-auto w-full space-y-2">
                            <input type="hidden" id="replyTargetParentId" value="">

                            <!-- Replying to banner -->
                            <div id="replyingToBanner"
                                class="hidden text-xs font-semibold text-indigo-700 bg-indigo-50 border border-indigo-200/80 px-3 py-1.5 rounded-xl inline-flex items-center gap-2 mb-1 shadow-2xs">
                                <span><i class="fas fa-reply text-indigo-500 text-[10px]"></i> Replying to <strong id="replyingToName"
                                        class="text-indigo-950 font-bold">User</strong></span>
                                <button type="button" onclick="cancelReplyTarget()"
                                    class="text-indigo-400 hover:text-indigo-800 cursor-pointer ml-1"><i
                                        class="fas fa-times text-xs"></i></button>
                            </div>

                            <div class="flex items-start gap-3">
                                <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>"
                                    class="w-10 h-10 rounded-full object-cover ring-2 ring-slate-100 flex-shrink-0 mt-0.5 shadow-2xs"
                                    alt="Instructor">
                                <div
                                    class="flex-1 bg-white border border-slate-200/90 rounded-2xl p-3.5 shadow-xs focus-within:ring-2 focus-within:ring-indigo-500/20 focus-within:border-indigo-400 transition-all">
                                    <textarea id="replyTextInput" rows="2" required
                                        placeholder="Write an instructor response... (Supports chemistry formulas & markdown)"
                                        class="w-full text-xs md:text-sm font-normal text-slate-800 placeholder-slate-400 border-0 focus:outline-none resize-none bg-transparent min-h-[48px]"></textarea>

                                    <!-- Quick Chemistry Formula Insert Bar (Collapsible / Toggleable) -->
                                    <div id="chemSymbolsToolbar" class="hidden pt-2 pb-1 border-t border-slate-100 flex items-center gap-1.5 flex-wrap">
                                        <span class="text-[10px] font-bold uppercase tracking-wider text-slate-400 mr-1">Insert:</span>
                                        <button type="button" onclick="insertChemSymbol('⇌')" class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" title="Equilibrium arrow">⇌</button>
                                        <button type="button" onclick="insertChemSymbol('→')" class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" title="Forward arrow">→</button>
                                        <button type="button" onclick="insertChemSymbol('Δ')" class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" title="Heat / Delta">Δ</button>
                                        <button type="button" onclick="insertChemSymbol('₍aq₎')" class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" title="Aqueous state">₍aq₎</button>
                                        <button type="button" onclick="insertChemSymbol('₍s₎')" class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" title="Solid state">₍s₎</button>
                                        <button type="button" onclick="insertChemSymbol('₍g₎')" class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" title="Gas state">₍g₎</button>
                                        <button type="button" onclick="insertChemSymbol('₍l₎')" class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" title="Liquid state">₍l₎</button>
                                        <button type="button" onclick="insertChemSymbol('°C')" class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" title="Degrees Celsius">°C</button>
                                        <button type="button" onclick="insertChemSymbol('⁺')" class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" title="Positive charge">⁺</button>
                                        <button type="button" onclick="insertChemSymbol('⁻')" class="px-2 py-0.5 rounded-md text-xs font-bold bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-slate-700 transition" title="Negative charge">⁻</button>
                                    </div>

                                    <div class="flex items-center justify-between pt-2 border-t border-slate-100 mt-2">
                                        <div class="flex items-center gap-2">
                                            <!-- Attachment button -->
                                            <label
                                                class="cursor-pointer p-1.5 rounded-lg text-slate-400 hover:text-slate-600 hover:bg-slate-100 transition"
                                                title="Attach file, document, image, or audio">
                                                <i class="fas fa-paperclip text-sm"></i>
                                                <input type="file" id="replyFileInput" class="hidden"
                                                    onchange="handleReplyFileSelected(this)">
                                            </label>

                                            <!-- Chem symbol toggle -->
                                            <button type="button" onclick="toggleChemSymbolsToolbar()"
                                                class="p-1.5 rounded-lg text-slate-400 hover:text-indigo-600 hover:bg-indigo-50 transition cursor-pointer flex items-center gap-1"
                                                title="Toggle Chemistry symbols toolbar">
                                                <i class="fas fa-flask text-xs"></i>
                                                <span class="text-[11px] font-semibold text-slate-500">Symbols</span>
                                            </button>

                                            <!-- File Chip -->
                                            <span id="replySelectedChip"
                                                class="hidden inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-slate-100 text-slate-700 text-xs font-medium">
                                                <i class="fas fa-paperclip text-[10px] text-slate-400"></i>
                                                <span id="replySelectedFileName" class="truncate max-w-[140px]"></span>
                                                <button type="button" onclick="removeReplyFile()"
                                                    class="text-slate-400 hover:text-rose-500 ml-0.5 cursor-pointer"><i
                                                        class="fas fa-times text-xs"></i></button>
                                            </span>
                                        </div>

                                        <!-- Navy Post Button (#28406E) -->
                                        <button type="submit" id="replySubmitBtn"
                                            class="inline-flex items-center gap-2 px-5 py-2 rounded-xl bg-[#28406E] hover:bg-[#1E3156] text-white font-bold text-xs shadow-xs transition cursor-pointer">
                                            <i class="fas fa-paper-plane text-[10px]"></i>
                                            <span>Post Reply</span>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>

                <!-- RIGHT PANEL: INSTRUCTOR MODERATION & INTELLIGENCE DECK (32%) -->
                <div
                    class="w-full lg:w-72 xl:w-80 bg-white border-t lg:border-t-0 lg:border-l border-slate-200/80 p-5 md:p-6 overflow-y-auto no-scrollbar flex-shrink-0 flex flex-col space-y-6 divide-y divide-slate-100">

                    <!-- Section 1: Thread Intelligence & Context -->
                    <div>
                        <h4 class="text-xs font-black uppercase tracking-wider text-slate-500 mb-3 flex items-center gap-1.5">
                            <i class="fas fa-chart-pie text-indigo-500"></i> Thread Context
                        </h4>
                        <div class="p-3.5 bg-slate-50/80 border border-slate-200/80 rounded-2xl space-y-2 text-xs">
                            <div class="flex items-center justify-between">
                                <span class="text-slate-500 font-medium">Activity Type:</span>
                                <span class="font-bold text-slate-800">Discussion</span>
                            </div>
                            <div class="flex items-center justify-between">
                                <span class="text-slate-500 font-medium">Early-Bird EXP:</span>
                                <span class="font-extrabold text-amber-600 flex items-center gap-1">
                                    <i class="fas fa-bolt text-amber-500"></i> <%= forum.exp_reward || 50 %> EXP
                                </span>
                            </div>
                            <div class="flex items-center justify-between pt-1 border-t border-slate-200/60">
                                <span class="text-slate-500 font-medium">Post Requirement:</span>
                                <span class="font-semibold text-slate-700"><%= (forum.max_posts && forum.max_posts > 0) ? forum.max_posts + ' posts max' : 'Unlimited' %></span>
                            </div>
                        </div>
                    </div>

                    <!-- Section 2: Files & Media Shelf -->
                    <div class="pt-5">
                        <div class="flex items-center justify-between mb-3">
                            <h4 class="text-xs font-black uppercase tracking-wider text-slate-500 flex items-center gap-1.5">
                                <i class="fas fa-paperclip text-indigo-500"></i>
                                <span>Files & Media</span>
                            </h4>
                            <span class="inline-flex items-center px-2 py-0.5 rounded-full text-[10px] font-bold bg-slate-100 text-slate-600">
                                <span id="shelfFilesCount">0</span>
                            </span>
                        </div>
                        <div id="shelfFilesList" class="space-y-2"></div>
                    </div>

                    <!-- Section 3: Participants & Contributors -->
                    <div class="pt-5">
                        <div class="flex items-center justify-between mb-3">
                            <h4 class="text-xs font-black uppercase tracking-wider text-slate-500 flex items-center gap-1.5">
                                <i class="fas fa-users text-indigo-500"></i>
                                <span>Contributors</span>
                            </h4>
                            <span id="contributorsCountBadge" class="text-[11px] font-bold text-slate-400">0</span>
                        </div>
                        <div id="threadContributorsAvatars"
                            class="flex items-center -space-x-2 mb-3.5 overflow-hidden py-1"></div>
                        <div id="threadContributorsList" class="space-y-2 max-h-48 overflow-y-auto no-scrollbar"></div>
                    </div>

                    <!-- Section 4: Moderation & Safety Status Card -->
                    <div class="pt-5">
                        <h4 class="text-xs font-black uppercase tracking-wider text-slate-500 mb-2.5 flex items-center gap-1.5">
                            <i class="fas fa-shield-halved text-indigo-600"></i> Moderation & Safety
                        </h4>
                        <div id="shelfReportContainer">
                            <!-- Populated dynamically by populateDiscussionModal -->
                            <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200 text-xs">
                                <div class="flex items-center justify-between">
                                    <span class="text-slate-600 font-medium">Reports on Thread:</span>
                                    <span id="shelfReportCount" class="font-extrabold text-slate-900">0</span>
                                </div>
                                <button type="button" id="shelfReviewReportsBtn" onclick="openReportsReviewModal()"
                                    class="hidden w-full mt-2.5 py-1.5 px-3 rounded-xl bg-rose-600 hover:bg-rose-700 text-white text-xs font-bold transition shadow-2xs flex items-center justify-center gap-1.5 cursor-pointer">
                                    <i class="fas fa-flag text-[10px]"></i> Review Reports
                                </button>
                            </div>
                        </div>
                    </div>

                </div>

            </div>
        </div>
    </div>

    <!-- COHORT PROGRESS ROSTER DRAWER -->
    <div id="rosterDrawerOverlay" onclick="closeRosterDrawer()"
        class="fixed inset-0 z-50 bg-slate-900/50 backdrop-blur-xs hidden transition-opacity"></div>
    <div id="rosterDrawer"
        class="fixed top-0 right-0 bottom-0 w-full max-w-md bg-white z-50 shadow-2xl transform translate-x-full drawer-slide flex flex-col border-l border-slate-200">

        <!-- Drawer Header -->
        <div
            class="p-5 bg-gradient-to-r from-slate-900 to-indigo-950 text-white flex items-center justify-between flex-shrink-0">
            <div>
                <h3 class="text-base font-extrabold flex items-center gap-2">
                    <i class="fas fa-user-check text-cyan-400"></i> Cohort Forum Progress
                </h3>
                <p class="text-xs text-slate-300 mt-0.5">
                    <%= stats ? stats.done_count : 0 %> of <%= stats ? stats.enrolled_count : 0 %> students marked
                            completed
                </p>
            </div>
            <button onclick="closeRosterDrawer()"
                class="w-8 h-8 rounded-xl bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition cursor-pointer">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <!-- Drawer Search -->
        <div class="p-4 border-b border-slate-100 bg-slate-50 flex-shrink-0">
            <div class="relative">
                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs"></i>
                <input type="text" id="rosterSearch" oninput="filterRoster(this.value)"
                    placeholder="Search students by name or ID..."
                    class="w-full pl-8 pr-3 py-2 text-xs font-semibold bg-white border border-slate-200 rounded-xl outline-none focus:ring-2 focus:ring-indigo-500">
            </div>
        </div>

        <!-- Drawer Student List -->
        <div class="flex-1 overflow-y-auto p-4 space-y-2.5 no-scrollbar" id="rosterListContainer">
            <% if (enrolledStudents && enrolledStudents.length> 0) { %>
                <% enrolledStudents.forEach(st=> { %>
                    <div class="flex items-center justify-between p-3 rounded-2xl border border-slate-200/80 hover:border-indigo-300 bg-white transition roster-item"
                        data-name="<%= String((st.first_name || '') + ' ' + (st.last_name || '')).toLowerCase() %>"
                        data-id="<%= String(st.student_id || '').toLowerCase() %>">
                        <div class="flex items-center gap-3 min-w-0">
                            <img src="/profile_uploads/<%= st.profile_pic || 'default_avatar.png' %>"
                                class="w-9 h-9 rounded-xl object-cover ring-1 ring-slate-100 flex-shrink-0"
                                onerror="this.onerror=null;this.src='/profile_uploads/default_avatar.png';">
                            <div class="min-w-0">
                                <div class="text-xs font-extrabold text-slate-800 truncate">
                                    <%= st.first_name %>
                                        <%= st.last_name %>
                                </div>
                                <div class="text-[11px] text-slate-600 font-semibold">
                                    <%= st.student_id || 'ID N/A' %> &bull; <%= st.contributions_count || 0 %> posts
                                </div>
                            </div>
                        </div>

                        <div class="text-right flex-shrink-0">
                            <% if (st.is_done) { %>
                                <span
                                    class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800 border border-emerald-300">
                                    <i class="fas fa-circle-check text-emerald-600"></i> Completed
                                </span>
                                <div class="text-[9px] text-slate-600 mt-0.5">
                                    <%= st.done_at ? new Date(st.done_at).toLocaleDateString('en-US', { month: 'short' ,
                                        day: 'numeric' }) : 'Done' %>
                                </div>
                                <% } else { %>
                                    <span
                                        class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded-full text-[10px] font-black bg-slate-100 text-slate-600 border border-slate-200">
                                        <i class="far fa-clock text-slate-400"></i> In Progress
                                    </span>
                                    <% } %>
                        </div>
                    </div>
                    <% }) %>
                        <% } else { %>
                            <div class="text-center py-12 text-slate-400 text-xs font-semibold">
                                No students currently enrolled in this subject class.
                            </div>
                            <% } %>
        </div>
    </div>

    <!-- BREAK-GLASS AUTHOR UNMASK MODAL -->
    <div id="unmaskAuthorModal"
        class="fixed inset-0 z-60 hidden flex items-center justify-center p-4 bg-slate-900/60 backdrop-blur-xs">
        <div class="relative w-full max-w-md bg-white rounded-3xl shadow-2xl p-6 border border-slate-100">
            <div
                class="w-12 h-12 rounded-2xl bg-amber-100 text-amber-600 flex items-center justify-center text-xl mb-4">
                <i class="fas fa-shield-alt"></i>
            </div>
            <h3 class="text-base font-black text-slate-900 mb-1">Break-Glass Identity Reveal</h3>
            <p class="text-xs text-slate-600 leading-relaxed mb-4">
                Revealing this student's real identity is an audited action and will record your Instructor ID, purpose,
                and timestamp into the compliance audit log.
            </p>

            <form onsubmit="confirmUnmaskAuthor(event)" class="space-y-4">
                <input type="hidden" id="unmaskTargetReplyId" value="">
                <div>
                    <label class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1.5">Pedagogical
                        Purpose <span class="text-rose-500">*</span></label>
                    <select id="unmaskReasonSelect" required
                        class="w-full text-xs font-bold px-3 py-2.5 border border-slate-200 rounded-xl bg-slate-50 focus:bg-white focus:ring-2 focus:ring-indigo-500 outline-none">
                        <option value="">Select reason...</option>
                        <option value="Academic Integrity & Plagiarism Review">Academic Integrity & Plagiarism Review
                        </option>
                        <option value="Safety, Harassment, or Community Guidelines">Safety, Harassment, or Community
                            Guidelines</option>
                        <option value="Grading, Assessment & Cohort Participation Audit">Grading, Assessment & Cohort
                            Participation Audit</option>
                        <option value="Direct Pedagogical Support & Clarification">Direct Pedagogical Support &
                            Clarification</option>
                        <option value="Other Specified Purpose">Other Specified Purpose</option>
                    </select>
                </div>

                <div class="flex items-center justify-end gap-2 pt-2">
                    <button type="button" onclick="closeUnmaskAuthorModal()"
                        class="px-3.5 py-2 rounded-xl border border-slate-200 text-xs font-bold text-slate-600 hover:bg-slate-50 cursor-pointer">Cancel</button>
                    <button type="submit" id="confirmUnmaskBtn"
                        class="px-4 py-2 rounded-xl bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold cursor-pointer shadow-xs">
                        <i class="fas fa-key text-[10px] mr-1"></i> Authorize & Reveal
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ADD DISCUSSION TOPIC MODAL (MS WORD-STYLE RIBBON EDITOR - Exact Match) -->
    <div id="newTopicModal"
        class="fixed inset-0 z-50 hidden flex items-center justify-center p-2 md:p-6 bg-slate-900/75 backdrop-blur-sm">
        <div
            class="relative w-full max-w-5xl h-[92vh] bg-white rounded-3xl shadow-2xl flex flex-col overflow-hidden border border-slate-100">

            <!-- Modal Header -->
            <div
                class="h-16 px-6 bg-white border-b border-slate-200/80 flex items-center justify-between flex-shrink-0">
                <div class="flex items-center gap-3">
                    <div
                        class="w-10 h-10 rounded-2xl bg-gradient-to-r from-cyan-600 to-indigo-600 text-white flex items-center justify-center shadow-xs">
                        <i class="fas fa-feather-pointed text-base"></i>
                    </div>
                    <div>
                        <h3 class="text-base font-black text-slate-900 leading-snug">Add Discussion Topic</h3>
                        <p class="text-[11px] text-slate-400">Share hypotheses, lab insights, or inquiries with your
                            cohort</p>
                    </div>
                </div>

                <button type="button" onclick="closeNewTopicModal()"
                    class="w-9 h-9 rounded-xl hover:bg-slate-100 text-slate-400 hover:text-slate-700 flex items-center justify-center transition cursor-pointer">
                    <i class="fas fa-times text-base"></i>
                </button>
            </div>

            <!-- Form Container -->
            <form onsubmit="submitNewDiscussionTopic(event)" class="flex-1 flex flex-col min-h-0 overflow-hidden">

                <!-- Topic Title Input -->
                <div class="px-6 py-4 bg-white border-b border-slate-100 flex-shrink-0">
                    <label class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-1.5">
                        Reply Topic Title <span class="text-rose-500">*</span>
                    </label>
                    <input type="text" id="topicTitleInput" required
                        placeholder="e.g. Observations on Enthalpy Change during Neutralization Lab..."
                        class="w-full text-base font-extrabold text-slate-900 px-4 py-2.5 bg-slate-50 border border-slate-200 rounded-2xl focus:bg-white focus:ring-2 focus:ring-cyan-500 focus:border-transparent outline-none transition">
                </div>

                <!-- Ribbon Toolbar -->
                <div class="bg-slate-50/90 border-b border-slate-200 p-2.5 flex-shrink-0 select-none">
                    <div class="flex flex-wrap items-center gap-1 text-slate-700">
                        <select onchange="formatDoc('formatBlock', this.value)"
                            class="h-8 px-2 text-xs font-bold bg-white border border-slate-200 rounded-lg outline-none focus:ring-2 focus:ring-cyan-500 cursor-pointer mr-1">
                            <option value="<p>">Normal Paragraph</option>
                            <option value="<h1>">Heading 1</option>
                            <option value="<h2>">Heading 2</option>
                            <option value="<h3>">Heading 3</option>
                            <option value="<blockquote>">Blockquote</option>
                            <option value="<pre>">Code Block</option>
                        </select>

                        <div class="h-5 w-px bg-slate-200 mx-1"></div>

                        <button type="button" onclick="formatDoc('bold')"
                            class="w-8 h-8 rounded-lg hover:bg-white hover:text-cyan-600 transition flex items-center justify-center font-bold"
                            title="Bold (Ctrl+B)"><i class="fas fa-bold"></i></button>
                        <button type="button" onclick="formatDoc('italic')"
                            class="w-8 h-8 rounded-lg hover:bg-white hover:text-cyan-600 transition flex items-center justify-center italic"
                            title="Italic (Ctrl+I)"><i class="fas fa-italic"></i></button>
                        <button type="button" onclick="formatDoc('underline')"
                            class="w-8 h-8 rounded-lg hover:bg-white hover:text-cyan-600 transition flex items-center justify-center underline"
                            title="Underline (Ctrl+U)"><i class="fas fa-underline"></i></button>

                        <div class="h-5 w-px bg-slate-200 mx-1"></div>

                        <button type="button" onclick="formatDoc('insertUnorderedList')"
                            class="w-8 h-8 rounded-lg hover:bg-white hover:text-cyan-600 transition flex items-center justify-center"
                            title="Bulleted List"><i class="fas fa-list-ul"></i></button>
                        <button type="button" onclick="formatDoc('insertOrderedList')"
                            class="w-8 h-8 rounded-lg hover:bg-white hover:text-cyan-600 transition flex items-center justify-center"
                            title="Numbered List"><i class="fas fa-list-ol"></i></button>

                        <div class="h-5 w-px bg-slate-200 mx-1"></div>

                        <button type="button" onclick="formatDoc('justifyLeft')"
                            class="w-8 h-8 rounded-lg hover:bg-white hover:text-cyan-600 transition flex items-center justify-center"
                            title="Align Left"><i class="fas fa-align-left"></i></button>
                        <button type="button" onclick="formatDoc('justifyCenter')"
                            class="w-8 h-8 rounded-lg hover:bg-white hover:text-cyan-600 transition flex items-center justify-center"
                            title="Align Center"><i class="fas fa-align-center"></i></button>
                        <button type="button" onclick="formatDoc('justifyRight')"
                            class="w-8 h-8 rounded-lg hover:bg-white hover:text-cyan-600 transition flex items-center justify-center"
                            title="Align Right"><i class="fas fa-align-right"></i></button>

                        <div class="h-5 w-px bg-slate-200 mx-1"></div>

                        <button type="button" onclick="openFormulaShortcutModal()"
                            class="px-2.5 h-8 rounded-lg bg-cyan-50 hover:bg-cyan-100 text-cyan-700 text-xs font-bold transition flex items-center gap-1.5"
                            title="Insert Chemical Formula">
                            <i class="fas fa-flask text-xs"></i>
                            <span>Formula</span>
                        </button>
