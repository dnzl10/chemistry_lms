        function openReportsReviewModal() {
            if (!activeDiscussionData || !activeDiscussionData.reports || activeDiscussionData.reports.length === 0) {
                showToast('No pending reports on this thread.', 'info');
                return;
            }
            const reports = activeDiscussionData.reports;
            let reportDetails = reports.map((r, idx) => `• Report #${idx + 1} by ${r.reporter_name}: "${r.reason}"`).join('\n');
            alert(`Thread Moderation Reports (${reports.length}):\n\n${reportDetails}`);
        }

        // Subreply logic
        function setReplyTarget(replyId, name) {
            document.getElementById('replyTargetParentId').value = replyId;
            document.getElementById('replyingToName').textContent = name;
            document.getElementById('replyingToBanner').classList.remove('hidden');
            document.getElementById('replyTextInput').focus();
        }

        function cancelReplyTarget() {
            document.getElementById('replyTargetParentId').value = '';
            document.getElementById('replyingToBanner').classList.add('hidden');
        }

        let selectedReplyFile = null;
        function handleReplyFileSelected(input) {
            if (input.files && input.files[0]) {
                selectedReplyFile = input.files[0];
                document.getElementById('replySelectedFileName').textContent = selectedReplyFile.name;
                document.getElementById('replySelectedChip').classList.remove('hidden');
            }
        }
        function removeReplyFile() {
            selectedReplyFile = null;
            document.getElementById('replyFileInput').value = '';
            document.getElementById('replySelectedChip').classList.add('hidden');
        }

        function toggleChemSymbolsToolbar() {
            const bar = document.getElementById('chemSymbolsToolbar');
            if (bar) bar.classList.toggle('hidden');
        }

        function insertChemSymbol(symbol) {
            const textarea = document.getElementById('replyTextInput');
            if (!textarea) return;
            const start = textarea.selectionStart || 0;
            const end = textarea.selectionEnd || 0;
            const val = textarea.value;
            textarea.value = val.substring(0, start) + symbol + val.substring(end);
            textarea.focus();
            textarea.selectionStart = textarea.selectionEnd = start + symbol.length;
        }

        async function submitSubReply(e) {
            e.preventDefault();
            const text = document.getElementById('replyTextInput').value.trim();
            if (!text) return;
            const parentId = document.getElementById('replyTargetParentId').value || activeDiscussionData.rootTopic.reply_id;

            const fd = new FormData();
            fd.append('forum_id', CURRENT_FORUM_ID);
            fd.append('parent_reply_id', parentId);
            fd.append('reply_content', text);
            if (selectedReplyFile) fd.append('forum_file', selectedReplyFile);

            const btn = document.getElementById('replySubmitBtn');
            btn.disabled = true;
            btn.innerHTML = '<i class="fas fa-circle-notch fa-spin text-xs"></i> <span>Posting...</span>';

            try {
                const res = await fetch('/teacher/api/forum-subreply', { method: 'POST', body: fd });
                const data = await res.json();
                if (data.success) {
                    showToast('Reply posted successfully', 'success');
                    document.getElementById('replyTextInput').value = '';
                    removeReplyFile();
                    cancelReplyTarget();
                    openDiscussionModal(activeDiscussionData.rootTopic.reply_id);
                } else {
                    showToast(data.error || 'Failed to post reply', 'error');
                }
            } catch (err) {
                showToast('Error posting reply', 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = '<i class="fas fa-paper-plane text-[10px]"></i> <span>Post Reply</span>';
            }
        }

        // Endorsements
        async function toggleActiveRootEndorse() {
            if (!activeDiscussionData) return;
            const rId = activeDiscussionData.rootTopic.reply_id;
            try {
                const res = await fetch(`/teacher/api/forum/reply/${rId}/endorse`, { method: 'PATCH' });
                const data = await res.json();
                if (data.success) {
                    showToast('Topic endorsement toggled', 'success');
                    openDiscussionModal(rId);
                }
            } catch (err) {
                showToast('Error toggling endorsement', 'error');
            }
