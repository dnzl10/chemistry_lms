<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Teacher Dashboard | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { 
            font-family: 'Plus Jakarta Sans', sans-serif; 
            background-color: #f0fdfa; /* Light Cyan/Emerald tint */
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }
        #sidebar {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
            background: linear-gradient(180deg, #0d1a2e 0%, #0b1523 100%);
        }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        .glass-card { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); }
        .gradient-border {
            position: relative;
            border-radius: 1.5rem;
            background: white;
            padding: 1px;
        }
        .gradient-border::before {
            content: "";
            position: absolute;
            inset: -2px;
            background: linear-gradient(45deg, #06b6d4, #8b5cf6, #ec4899);
            border-radius: 1.6rem;
            z-index: -1;
            opacity: 0.3;
        }
        /* Nav active state */
        .nav-active {
            background: linear-gradient(135deg, #06b6d4 0%, #6366f1 100%) !important;
            color: white !important;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(6,182,212,0.3), 0 2px 8px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
    </style>
</head>
<body class="text-slate-900">

    <div class="flex min-h-screen relative overflow-x-hidden">
        <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-cyan-900/50 z-40 hidden md:hidden"></div>

        <aside id="sidebar" class="text-white w-64 flex-shrink-0 flex flex-col z-50 fixed inset-y-0 left-0 -translate-x-full md:translate-x-0 h-screen border-r border-indigo-900/60" style="background: linear-gradient(180deg, #0d1a2e 0%, #0b1523 100%);">
            <div class="pt-8 pb-4 px-4 flex flex-col items-center text-center relative">
                <!-- Mobile close button -->
                <button onclick="toggleSidebar()" class="md:hidden text-indigo-300 hover:text-white absolute top-4 right-4">
                    <i class="fas fa-times text-xl"></i>
                </button>

                <!-- Logo -->
                <img src="/assets/logo.png" alt="ChemArcade Logo" class="w-16 h-16 object-contain mb-3">

                <!-- Brand name -->
                <h1 class="text-xl font-black tracking-tighter text-cyan-400 uppercase italic leading-none">
                    Elem<span class="text-white">enta</span>
                </h1>
                <p class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest mt-1">Teacher Portal</p>

                <!-- Divider -->
                <!-- <div class="w-full mt-5 border-t border-indigo-800/60"></div> -->
            </div>

            <nav class="flex-1 px-4 mt-4 space-y-6 overflow-y-auto no-scrollbar pb-6">

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Main Interface</p>
                    <div class="space-y-1">
                        <a href="/teacher/dashboard" class="nav-active flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-chart-pie w-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-sm">Dashboard</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Academic Management</p>
                    <div class="space-y-1">
                        <a href="/teacher/classes" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-chalkboard-user w-5 text-emerald-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-sm">My Classes</span>
                        </a>
                    </div>

                    <div class="space-y-1">
                        <a href="/teacher/question-bank" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-database w-5 text-rose-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-sm">Question Bank</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Engagement and Communication</p>
                    <div class="space-y-1">
                        <a href="/teacher/forums" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-comments w-5 text-amber-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-sm">Forums</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Reports and Analytics</p>
                    <div class="space-y-1">
                        <a href="/teacher/reports" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-file-export w-5 text-fuchsia-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-sm">Reports</span>
                        </a>
                    </div>
                </div>
            </nav>

            <div class="p-4 border-t" style="border-color: rgba(99,102,241,0.25);">
                <a href="/logout"
                class="flex items-center gap-3 p-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition group font-bold">
                    <i class="fas fa-right-from-bracket w-5"></i> Log Out
                </a>
            </div>
        </aside>

        <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">
            
            <header class="h-20 bg-white/90 backdrop-blur-md border-b border-cyan-100 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
                <div class="flex items-center gap-4">
                    <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-cyan-50 text-cyan-600 md:hidden">
                        <i class="fas fa-bars text-xl"></i>
                    </button>
                    <h2 class="text-lg font-bold text-indigo-900 hidden sm:block uppercase tracking-tight">Welcome, Prof. <%= user.last_name %>!</h2>
                </div>

                <div class="flex items-center gap-3 md:gap-6">
                    <div class="relative group cursor-pointer p-2 hover:bg-cyan-50 rounded-full transition">
                        <i class="far fa-bell text-xl text-cyan-600"></i>
                        <span class="absolute top-2 right-2 flex h-2.5 w-2.5">
                            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                            <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                        </span>
                    </div>
                    
                    <div class="flex items-center gap-3 pl-4 border-l border-cyan-100">
                        <div class="text-right hidden lg:block">
                            <p class="text-sm font-bold text-indigo-900"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-[10px] uppercase font-black text-cyan-500 tracking-widest">Instructor</p>
                        </div>
                        <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>" class="w-10 h-10 rounded-xl object-cover ring-2 ring-cyan-400 shadow-sm shadow-cyan-200">
                    </div>
                </div>
            </header>

            <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
    
                <div class="p-4 md:p-8 flex-1">
                    
                    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4 mb-8">
                        <div class="bg-white p-5 rounded-3xl border border-cyan-100 shadow-sm shadow-cyan-100/50 group hover:shadow-md hover:border-cyan-300 transition-all">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-2xl bg-cyan-100 flex items-center justify-center text-cyan-600 group-hover:rotate-12 transition">
                                    <i class="fas fa-users-rectangle text-xl"></i>
                                </div>
                                <div>
                                    <p class="text-cyan-600 text-[10px] font-bold uppercase tracking-wider">Total Students</p>
                                    <h3 class="text-2xl font-black text-indigo-900"><%= stats.totalStudents || 0 %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="bg-rose-50 p-5 rounded-3xl border border-rose-100 shadow-sm group hover:bg-rose-100 transition">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-2xl bg-rose-200 flex items-center justify-center text-rose-600">
                                    <i class="fas fa-vial-circle-check text-xl"></i>
                                </div>
                                <div>
                                    <p class="text-rose-600 text-[10px] font-bold uppercase tracking-wider">Struggling</p>
                                    <h3 class="text-2xl font-black text-rose-700"><%= needsAttention ? needsAttention.length : 0 %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-3xl border border-emerald-100 shadow-sm hover:border-emerald-300 transition">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-2xl bg-emerald-100 flex items-center justify-center text-emerald-600">
                                    <i class="fas fa-atom text-xl"></i>
                                </div>
                                <div>
                                    <p class="text-emerald-600 text-[10px] font-bold uppercase tracking-wider">Active Classes</p>
                                    <h3 class="text-2xl font-black text-indigo-900"><%= classes.length %></h3>
                                </div>
                            </div>
                        </div>
                        <div class="bg-white p-5 rounded-3xl border border-amber-100 shadow-sm hover:border-amber-300 transition">
                            <div class="flex items-center gap-4">
                                <div class="w-12 h-12 rounded-2xl bg-amber-100 flex items-center justify-center text-amber-600">
                                    <i class="fas fa-fire-flame-simple text-xl"></i>
                                </div>
                                <div>
                                    <p class="text-amber-600 text-[10px] font-bold uppercase tracking-wider">Total Attempts</p>
                                    <h3 class="text-2xl font-black text-indigo-900"><%= stats.totalAttempts || 0 %></h3>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
                        <div class="lg:col-span-2 space-y-8">
                            <section>
                                <div class="flex justify-between items-end mb-4 px-1">
                                    <h2 class="text-xl font-black text-indigo-950 flex items-center gap-2">
                                        <i class="fas fa-flask-vial text-cyan-500"></i> Active Subjects
                                    </h2>
                                    <a href="/teacher/classes" class="text-xs font-bold text-cyan-600 hover:text-indigo-600 transition">See all classes</a>
                                </div>
                                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                                    <% classes.forEach(cls => { %>
                                    <div class="bg-white rounded-3xl border border-cyan-100 overflow-hidden hover:border-indigo-400 transition-all group shadow-sm hover:shadow-lg">
                                        <div class="h-24 bg-indigo-50 relative">
                                            <img src="/profile_uploads/<%= cls.subject_image || 'default_subject.png' %>" class="w-full h-full object-cover opacity-70 group-hover:scale-105 transition-transform duration-500">
                                            <div class="absolute bottom-2 left-4">
                                                <span class="px-2 py-1 bg-white text-[10px] font-black rounded-md uppercase tracking-tighter shadow-sm text-indigo-600 border border-indigo-100"><%= cls.subject_code %></span>
                                            </div>
                                        </div>
                                        <div class="p-4">
                                            <h4 class="font-bold text-indigo-900"><%= cls.subject_name %></h4>
                                            <p class="text-[11px] text-indigo-400 font-semibold">Section: <%= cls.class_name %> • <%= cls.student_count %> Students</p>
                                            <a href="/teacher/class/<%= cls.class_id %>" class="mt-3 block w-full py-2 bg-indigo-50 group-hover:bg-gradient-to-r group-hover:from-cyan-500 group-hover:to-indigo-600 group-hover:text-white text-center rounded-xl text-xs font-black transition-all">View Class</a>
                                        </div>
                                    </div>
                                    <% }) %>
                                </div>
                            </section>

                            <section class="bg-white rounded-3xl border border-cyan-100 p-6 shadow-sm shadow-cyan-100/30">
                                <h2 class="text-lg font-black text-indigo-950 mb-4 flex items-center gap-2">
                                    <i class="fas fa-chart-line text-emerald-500"></i> Performance Overview
                                </h2>
                                <div class="h-64 w-full">
                                    <canvas id="performanceChart"></canvas>
                                </div>
                            </section>

                            <section class="bg-white rounded-3xl border border-cyan-100 p-6 shadow-sm overflow-hidden">
                                <div class="flex justify-between items-center mb-6">
                                    <h2 class="text-lg font-black text-indigo-950 uppercase tracking-tight italic">Arcade Monitoring Feed</h2>
                                    <a href="/teacher/all-activities" class="px-4 py-2 bg-indigo-50 text-indigo-600 hover:bg-indigo-600 hover:text-white rounded-xl text-[10px] font-black uppercase transition-all">View All</a>
                                </div>
                                <div class="space-y-3">
                                    <% if(recentScores && recentScores.length > 0) { %>
                                        <% recentScores.slice(0, 5).forEach(score => { %>
                                        <a href="/teacher/analysis/<%= score.score_id %>" class="flex items-center justify-between p-4 rounded-2xl bg-cyan-50/30 border border-cyan-100 hover:border-indigo-400 hover:bg-white hover:shadow-xl hover:shadow-indigo-900/5 transition group">
                                            <div class="flex items-center gap-4">
                                                <div class="relative">
                                                    <img src="/profile_uploads/<%= score.student_pic || 'default_avatar.png' %>" class="w-12 h-12 rounded-2xl object-cover ring-2 ring-white">
                                                    <div class="absolute -bottom-1 -right-1 w-4 h-4 bg-emerald-500 border-2 border-white rounded-full"></div>
                                                </div>
                                                <div>
                                                    <p class="text-xs font-black text-indigo-900 group-hover:text-cyan-600 transition"><%= score.first_name %> <%= score.last_name %></p>
                                                    <p class="text-[10px] text-indigo-400 font-bold uppercase">
                                                        <span class="text-cyan-600"><%= score.subject_name %></span> • <%= score.topic_name %>
                                                    </p>
                                                    <p class="text-[9px] font-bold text-slate-400 mt-1 uppercase tracking-tighter italic"><%= score.assessment_name %></p>
                                                </div>
                                            </div>
                                            <div class="text-right flex items-center gap-6">
                                                <div class="hidden sm:block">
                                                    <p class="text-[10px] font-black text-slate-400 uppercase">Score</p>
                                                    <p class="text-sm font-black text-indigo-900"><%= score.score_obtained %> <span class="text-slate-300">/ <%= score.total_items %></span></p>
                                                </div>
                                                <div class="px-3 py-1 bg-emerald-100 text-emerald-700 rounded-lg text-center border border-emerald-200">
                                                    <p class="text-[9px] font-black">+<%= score.exp_gained %></p>
                                                    <p class="text-[8px] font-black uppercase">EXP</p>
                                                </div>
                                                <i class="fas fa-chevron-right text-cyan-200 group-hover:text-cyan-500 transition"></i>
                                            </div>
                                        </a>
                                        <% }) %>
                                    <% } else { %>
                                        <div class="text-center py-8">
                                            <img src="/assets/empty_feed.svg" class="w-32 mx-auto opacity-20 mb-4">
                                            <p class="text-indigo-300 text-xs font-medium italic font-bold">Waiting for chemical reaction...</p>
                                        </div>
                                    <% } %>
                                </div>
                            </section>
                        </div>

                        <div class="space-y-8">
                            <section class="bg-rose-50 rounded-3xl border border-rose-100 p-6 shadow-sm">
                                <div class="flex justify-between items-center mb-4">
                                    <h2 class="text-rose-800 text-xs font-black uppercase flex items-center gap-2">
                                        <i class="fas fa-triangle-exclamation text-rose-500"></i> Needs Attention
                                    </h2>
                                    <a href="/teacher/struggling-students" class="text-[9px] font-bold text-rose-600 hover:underline uppercase">Intervene</a>
                                </div>
                                <div class="space-y-6">
                                    <% if(needsAttention && needsAttention.length > 0) { %>
                                        <% classes.forEach(cls => { %>
                                            <% const strugglingInThisClass = needsAttention.filter(s => s.subject_id == cls.subject_id).slice(0, 3); %>
                                            <% if(strugglingInThisClass.length > 0) { %>
                                                <div class="space-y-2">
                                                    <div class="flex items-center justify-between px-1">
                                                        <p class="text-[10px] font-black text-rose-400 uppercase tracking-widest"><%= cls.subject_name %></p>
                                                        <span class="text-[9px] bg-rose-200 text-rose-700 px-1.5 py-0.5 rounded font-black"><%= strugglingInThisClass.length %> Alerts</span>
                                                    </div>
                                                    <% strugglingInThisClass.forEach(s => { %>
                                                        <div class="flex items-center justify-between bg-white p-3 rounded-2xl shadow-sm border border-rose-100 group hover:border-rose-400 transition">
                                                            <div class="flex items-center gap-3">
                                                                <img src="/profile_uploads/<%= s.profile_pic || 'default_avatar.png' %>" class="w-8 h-8 rounded-full object-cover grayscale group-hover:grayscale-0 transition-all">
                                                                <div class="flex flex-col">
                                                                    <span class="text-[11px] font-black text-indigo-950"><%= s.first_name %> <%= s.last_name %></span>
                                                                    <span class="text-[9px] text-rose-400 font-bold">Progress: <%= s.progress_percent %>%</span>
                                                                </div>
                                                            </div>
                                                            <button class="p-2 text-rose-300 hover:text-rose-600 transition"><i class="fas fa-comment-dots text-xs"></i></button>
                                                        </div>
                                                    <% }) %>
                                                </div>
                                            <% } %>
                                        <% }) %>
                                    <% } else { %>
                                        <p class="text-[11px] text-indigo-300 italic text-center py-4 font-bold">Safe Zone: No critical interventions.</p>
                                    <% } %>
                                </div>
                            </section>

                            <section class="bg-white rounded-3xl border border-cyan-100 p-6 shadow-sm">
                                <h2 class="text-indigo-900 text-xs font-black uppercase mb-4 flex justify-between">
                                    Atomic Deadlines <i class="fas fa-hourglass-half text-amber-500"></i>
                                </h2>
                                <div class="space-y-4">
                                    <% if(pendingAssessments && pendingAssessments.length > 0) { %>
                                        <% pendingAssessments.forEach(task => { %>
                                        <div class="relative pl-4 py-1 group cursor-pointer">
                                            <div class="absolute left-0 top-0 bottom-0 w-1 bg-gradient-to-b from-amber-400 to-rose-500 rounded-full group-hover:w-1.5 transition-all"></div>
                                            <div class="flex justify-between items-start">
                                                <div>
                                                    <p class="text-xs font-black text-indigo-950"><%= task.assessment_name %></p>
                                                    <p class="text-[10px] font-bold text-cyan-600">Q<%= task.quarter %>: <%= task.topic_name %></p>
                                                    <p class="text-[9px] text-slate-400 mt-1 uppercase font-black tracking-widest"><%= task.type %> • <%= task.total_items %> Items</p>
                                                </div>
                                                <div class="text-right">
                                                    <div class="flex flex-col items-end">
                                                        <i class="fas <%= task.is_unlocked === 1 ? 'fa-bolt-lightning text-emerald-500' : 'fa-lock text-slate-300' %> text-xs mb-1"></i>
                                                        <span class="text-[8px] px-1 rounded-sm font-black uppercase <%= task.is_unlocked === 1 ? 'bg-emerald-500 text-white' : 'bg-slate-200 text-slate-500' %>"><%= task.is_unlocked === 1 ? 'LIVE' : 'IDLE' %></span>
                                                    </div>
                                                    <p class="text-[9px] font-black text-indigo-400 uppercase mt-1"><%= new Date(task.due_date).toLocaleDateString('en-US', { month: 'short', day: 'numeric' }) %></p>
                                                </div>
                                            </div>
                                        </div>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </section>

                            <section class="bg-indigo-900 rounded-3xl p-6 text-white shadow-xl shadow-indigo-200">
                                <h2 class="text-cyan-400 text-xs font-black uppercase mb-4 flex items-center gap-2">
                                    <i class="fas fa-comments text-[10px]"></i> Discussion Lab
                                </h2>
                                <div class="space-y-6">
                                    <% if(forumActivity && forumActivity.length > 0) { %>
                                        <% classes.forEach(cls => { %>
                                            <% const subjectThreads = forumActivity.filter(f => f.subject_id == cls.subject_id).slice(0, 3); %>
                                            <% if(subjectThreads.length > 0) { %>
                                                <div class="space-y-2">
                                                    <p class="text-[9px] font-black text-indigo-400 uppercase tracking-[0.2em]"><%= cls.subject_name %></p>
                                                    <% subjectThreads.forEach(forum => { %>
                                                    <div class="flex justify-between items-start border-b border-indigo-800 pb-3 hover:bg-white/5 transition p-1 rounded">
                                                        <div>
                                                            <div class="flex items-center gap-2">
                                                                <% if(forum.is_pinned) { %><i class="fas fa-thumbtack text-cyan-400 text-[8px]"></i><% } %>
                                                                <p class="text-[11px] font-bold truncate w-32"><%= forum.title %></p>
                                                            </div>
                                                            <p class="text-[9px] text-indigo-400 italic mt-1 font-semibold"><%= forum.topic_name %></p>
                                                        </div>
                                                        <a href="/teacher/forums/thread/<%= forum.id %>" class="text-[10px] bg-indigo-800 hover:bg-cyan-500 px-2 py-1 rounded-md text-white font-black transition-all">LAB</a>
                                                    </div>
                                                    <% }) %>
                                                </div>
                                            <% } %>
                                        <% }) %>
                                    <% } %>
                                </div>
                            </section>

                            <section class="bg-white rounded-3xl border border-cyan-100 p-6 shadow-sm overflow-hidden">
                                <div class="flex justify-between items-center mb-6">
                                    <h2 class="text-lg font-black text-indigo-950 uppercase tracking-tight italic">
                                        <i class="fas fa-calendar-day text-indigo-500 mr-2"></i>Schedule
                                    </h2>
                                    <button onclick="openEventModal()" class="w-8 h-8 flex items-center justify-center bg-cyan-500 text-white rounded-xl hover:bg-indigo-600 transition-all shadow-lg shadow-cyan-200">
                                        <i class="fas fa-plus"></i>
                                    </button>
                                </div>

                                <div class="flex items-center justify-between mb-4 px-2">
                                    <span class="text-sm font-black text-indigo-900 uppercase tracking-widest" id="monthDisplay">Month Year</span>
                                    <div class="flex gap-2">
                                        <button onclick="changeMonth(-1)" class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-cyan-50 text-slate-400 hover:text-indigo-600 transition">
                                            <i class="fas fa-chevron-left text-xs"></i>
                                        </button>
                                        <button onclick="changeMonth(1)" class="w-7 h-7 flex items-center justify-center rounded-lg hover:bg-cyan-50 text-slate-400 hover:text-indigo-600 transition">
                                            <i class="fas fa-chevron-right text-xs"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="grid grid-cols-7 gap-1 text-center mb-2">
                                    <% ['S', 'M', 'T', 'W', 'T', 'F', 'S'].forEach(day => { %>
                                        <span class="text-[10px] font-black text-slate-400 uppercase"><%= day %></span>
                                    <% }) %>
                                </div>
                                
                                <div class="grid grid-cols-7 gap-2" id="calendarGrid">
                                    </div>
                            </section>
                        </div>
                    </div>

                    <div class="h-5"></div>
                </div>

                <footer class="bg-white border-t border-cyan-100 py-6 px-8 mt-auto w-full">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-2 max-w-[1600px] mx-auto">
                        <p class="text-[11px] text-indigo-400 font-black uppercase tracking-tight">
                            &copy; 2026 <span class="text-cyan-600">Chemistry Arcade</span> - Mabini College v2.5.0
                        </p>
                        <div class="flex gap-4">
                            <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest">Support Lab</a>
                            <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest border-l pl-4 border-indigo-100">Atomic Logs</a>
                        </div>
                    </div>
                </footer>
            </div></div>
        </main>
    </div>

    <script>
        // 1. Sidebar Toggle Logic
        function toggleSidebar() {
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('sidebarOverlay');
            sidebar.classList.toggle('-translate-x-full');
            overlay.classList.toggle('hidden');
        }

        // 2. Performance Chart Initialization (Chart.js)
        const ctx = document.getElementById('performanceChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Mon', 'Tue', 'Wed', 'Thu', 'Fri', 'Sat', 'Sun'],
                datasets: [{
                    label: 'Class Score (%)',
                    data: [65, 78, 72, 85, 80, 88, 92],
                    borderColor: '#06b6d4',
                    backgroundColor: 'rgba(6, 182, 212, 0.1)',
                    fill: true,
                    tension: 0.4,
                    borderWidth: 4,
                    pointRadius: 6,
                    pointBackgroundColor: '#fff',
                    pointBorderColor: '#4f46e5',
                    pointBorderWidth: 2
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { beginAtZero: true, max: 100, grid: { color: '#e2e8f0' }, ticks: { font: { weight: 'bold' } } },
                    x: { grid: { display: false }, ticks: { font: { weight: 'bold' } } }
                }
            }
        });

        // 3. Dynamic Calendar Logic
        // Passing EJS data to Client-side JS
        // Change this line in your script tag:
        const databaseEvents = [
            ...<%- JSON.stringify(pendingAssessments || []) %>.map(a => ({...a, due_date: a.due_date, type: 'Deadline'})),
            ...<%- JSON.stringify(events || []) %>.map(e => ({...e, due_date: e.event_date, type: e.event_type}))
        ];
        
        let currentDate = new Date();
        let currentMonth = currentDate.getMonth();
        let currentYear = currentDate.getFullYear();

        function renderCalendar() {
            const grid = document.getElementById('calendarGrid');
            const monthLabel = document.getElementById('monthDisplay');
            if (!grid || !monthLabel) return; // Guard clause

            grid.innerHTML = '';

            const firstDay = new Date(currentYear, currentMonth, 1).getDay();
            const daysInMonth = new Date(currentYear, currentMonth + 1, 0).getDate();
            
            const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];
            monthLabel.innerText = `${monthNames[currentMonth]} ${currentYear}`;

            // Add padding for the start of the month
            for (let i = 0; i < firstDay; i++) {
                grid.innerHTML += `<div></div>`;
            }

            // Loop through each day of the month
            for (let day = 1; day <= daysInMonth; day++) {
                // Create a comparison string for the date (YYYY-MM-DD)
                const dateString = `${currentYear}-${String(currentMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
                
                // Filter events from DB that match this specific day
                const dayEvents = databaseEvents.filter(e => {
                    const eventDate = new Date(e.due_date).toISOString().split('T')[0];
                    return eventDate === dateString;
                });

                let eventStyle = "text-indigo-900 hover:bg-cyan-50 hover:border-cyan-100";
                let tooltip = "";

                if (dayEvents.length > 0) {
                    // Style based on the first event type found
                    const type = dayEvents[0].type || "Exam";
                    const colors = {
                        'Exam': 'bg-rose-100 text-rose-600 border-rose-200',
                        'Material': 'bg-blue-100 text-blue-600 border-blue-200',
                        'Deadline': 'bg-amber-100 text-amber-600 border-amber-200',
                        'Arcade Session': 'bg-emerald-100 text-emerald-600 border-emerald-200'
                    };
                    eventStyle = colors[type] || 'bg-cyan-100 text-cyan-600 border-cyan-200';

                    // Construct Hover Details (Tooltip)
                    tooltip = `
                    <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-2 w-48 p-3 bg-indigo-950 text-white rounded-2xl text-[10px] opacity-0 pointer-events-none group-hover:opacity-100 transition-all z-50 shadow-xl border border-white/10">
                        <p class="font-black text-cyan-400 mb-1 uppercase italic underline tracking-tighter">Event Details</p>
                        ${dayEvents.map(e => `
                            <div class="mb-2 last:mb-0 border-b border-white/10 pb-1 last:border-0">
                                <p class="font-black text-white leading-tight">${e.assessment_name || e.event_title}</p>
                                <p class="text-cyan-200 opacity-80 uppercase text-[8px] font-bold mt-0.5">${e.topic_name || 'Class Event'}</p>
                            </div>
                        `).join('')}
                        <div class="absolute top-full left-1/2 -translate-x-1/2 w-0 h-0 border-l-[6px] border-l-transparent border-r-[6px] border-r-transparent border-t-[6px] border-t-indigo-950"></div>
                    </div>`;
                }

                grid.innerHTML += `
                    <div class="relative group">
                        <div class="aspect-square flex items-center justify-center text-[11px] font-bold rounded-xl border border-transparent transition-all cursor-pointer ${eventStyle}">
                            ${day}
                        </div>
                        ${tooltip}
                    </div>
                `;
            }
        }

        function changeMonth(delta) {
            currentMonth += delta;
            if (currentMonth < 0) {
                currentMonth = 11;
                currentYear--;
            } else if (currentMonth > 11) {
                currentMonth = 0;
                currentYear++;
            }
            renderCalendar();
        }

        // 4. Modal and Form Controls
        function openEventModal() {
            const modal = document.getElementById('eventModal');
            modal.classList.remove('hidden');
            modal.classList.add('flex');
        }

        function closeEventModal() {
            const modal = document.getElementById('eventModal');
            modal.classList.add('hidden');
            modal.classList.remove('flex');
        }

        function toggleDurationFields() {
            const type = document.getElementById('durationType').value;
            document.getElementById('dateRangeFields').classList.toggle('hidden', type !== 'DateRange');
            document.getElementById('minuteFields').classList.toggle('hidden', type !== 'Minutes');
        }

        function toggleRepeatFields() {
            const isChecked = document.getElementById('isRepeatable').checked;
            document.getElementById('repeatCycle').classList.toggle('hidden', !isChecked);
        }

        // Initialize calendar immediately on page load
        document.addEventListener('DOMContentLoaded', renderCalendar);
    </script>

    <div id="eventModal" class="fixed inset-0 z-[100] hidden items-center justify-center p-4">
        <div class="absolute inset-0 bg-indigo-950/60 backdrop-blur-sm" onclick="closeEventModal()"></div>
        <div class="relative bg-white w-full max-w-md rounded-[2.5rem] shadow-2xl overflow-hidden animate-in fade-in zoom-in duration-300">
            <div class="p-6 border-b border-slate-100 flex justify-between items-center bg-slate-50/50">
                <h3 class="text-lg font-black text-indigo-950 italic uppercase tracking-tight">Create New Event</h3>
                <button onclick="closeEventModal()" class="text-slate-400 hover:text-rose-500 transition"><i class="fas fa-times text-xl"></i></button>
            </div>
            
            <form action="/events/add" method="POST" class="p-6 space-y-4 max-h-[75vh] overflow-y-auto no-scrollbar">
                <div>
                    <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Subject</label>
                    <select name="subject_id" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm focus:ring-2 focus:ring-cyan-500 outline-none">
                        <% classes.forEach(cls => { %>
                            <option value="<%= cls.subject_id %>"><%= cls.subject_name %></option>
                        <% }) %>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div class="col-span-2">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Event Title</label>
                        <input type="text" name="event_title" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm outline-none focus:ring-2 focus:ring-cyan-500">
                    </div>
                    <div class="col-span-2">
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Description</label>
                        <textarea name="event_description" rows="2" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm outline-none focus:ring-2 focus:ring-cyan-500"></textarea>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Type</label>
                        <select name="event_type" class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm outline-none">
                            <option>Material</option>
                            <option>Deadline</option>
                            <option>Exam</option>
                            <option>Holiday</option>
                            <option>Arcade Session</option>
                        </select>
                    </div>
                    <div>
                        <label class="block text-[10px] font-black uppercase tracking-widest text-slate-400 mb-2">Date</label>
                        <input type="date" name="event_date" required class="w-full px-4 py-3 bg-slate-50 border border-slate-200 rounded-2xl text-sm outline-none">
                    </div>
                </div>

                <div class="p-4 bg-cyan-50 rounded-2xl border border-cyan-100">
                    <label class="block text-[10px] font-black uppercase tracking-widest text-cyan-400 mb-3">Duration Settings</label>
                    <select name="duration_type" id="durationType" onchange="toggleDurationFields()" class="w-full px-4 py-2 bg-white border border-cyan-200 rounded-xl text-sm outline-none mb-3">
                        <option value="None">No Duration</option>
                        <option value="DateRange">Date Range</option>
                        <option value="Minutes">Set in Minutes</option>
                    </select>
                    <div id="dateRangeFields" class="hidden grid grid-cols-2 gap-3">
                        <input type="datetime-local" name="start_date" class="px-3 py-2 bg-white border border-cyan-200 rounded-xl text-[10px]">
                        <input type="datetime-local" name="end_date" class="px-3 py-2 bg-white border border-cyan-200 rounded-xl text-[10px]">
                    </div>
                    <div id="minuteFields" class="hidden">
                        <input type="number" name="duration_minutes" placeholder="Minutes?" class="w-full px-3 py-2 bg-white border border-cyan-200 rounded-xl text-[10px]">
                    </div>
                </div>

                <div class="flex items-center gap-3 p-4 bg-slate-50 rounded-2xl border border-slate-200">
                    <input type="checkbox" name="is_repeatable" id="isRepeatable" onchange="toggleRepeatFields()" class="w-5 h-5 accent-cyan-600">
                    <label for="isRepeatable" class="text-xs font-bold text-slate-700">Repeat event</label>
                    <select name="repeat_cycle" id="repeatCycle" class="hidden ml-auto px-3 py-2 bg-white border border-slate-200 rounded-xl text-[10px] outline-none">
                        <option value="Daily">Daily</option>
                        <option value="Weekly">Weekly</option>
                        <option value="Monthly">Monthly</option>
                    </select>
                </div>

                <button type="submit" class="w-full py-4 bg-indigo-950 text-white rounded-2xl font-bold hover:bg-cyan-600 transition-all shadow-lg">
                    Create Event
                </button>
            </form>
        </div>
    </div>
</body>
</html>