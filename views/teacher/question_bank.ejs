    <!-- CLASS STUDENT DEEP DIVE MODAL                                          -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop" id="classDeepDiveModal">
        <div
            class="bg-white rounded-3xl shadow-2xl w-full max-w-6xl max-h-[92vh] flex flex-col overflow-hidden border border-slate-200">
            <!-- Modal Header -->
            <div
                class="modal-header bg-slate-50/80 px-6 py-4 border-b border-slate-100 flex items-center justify-between">
                <div class="flex items-center gap-3">
                    <div
                        class="w-10 h-10 rounded-xl bg-gradient-to-tr from-indigo-600 to-purple-600 text-white flex items-center justify-center font-bold shadow-md shadow-indigo-200">
                        <i class="fas fa-users-viewfinder text-lg"></i>
                    </div>
                    <div>
                        <h3 class="font-extrabold text-slate-800 text-base" id="deepDiveModalTitle">Class Student
                            Diagnostics & Performance Breakdown</h3>
                        <p class="text-xs text-slate-400" id="deepDiveModalSubtitle">Individual student answers, Bloom's
                            Taxonomy mastery radar, and cognitive metrics</p>
                    </div>
                </div>
                <button onclick="closeClassDeepDive()"
                    class="w-8 h-8 rounded-lg hover:bg-slate-200 flex items-center justify-center text-slate-400 hover:text-slate-600 cursor-pointer">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Modal Body (2 Columns) -->
            <div class="grid grid-cols-1 lg:grid-cols-12 flex-1 overflow-hidden min-h-[560px]">
                <!-- Left Column: Student Roster in Class -->
                <div class="lg:col-span-4 border-r border-slate-100 flex flex-col bg-slate-50/50">
                    <div class="p-3.5 border-b border-slate-100 bg-white">
                        <div class="relative">
                            <i class="fas fa-search absolute left-3.5 top-2.5 text-slate-400 text-xs"></i>
                            <input type="text" id="deepDiveStudentSearch" oninput="filterDeepDiveStudents()"
                                placeholder="Search students in class…" class="search-input w-full text-xs py-2 pl-9">
                        </div>
                    </div>

                    <div class="flex-1 overflow-y-auto p-2.5 space-y-1.5" id="deepDiveStudentList">
                        <!-- Dynamic Student Cards Rendered Here -->
                        <div class="py-12 text-center text-slate-400 text-xs">
                            <i class="fas fa-spinner fa-spin text-xl text-indigo-500 mb-2 block"></i>
                            Loading class roster…
                        </div>
                    </div>
                </div>

                <!-- Right Column: Individual Student Diagnostic View -->
                <div class="lg:col-span-8 flex flex-col overflow-y-auto p-6 space-y-6" id="deepDiveStudentDetail">
                    <!-- Empty state placeholder if no student chosen -->
