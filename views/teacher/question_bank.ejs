                                                    <th class="pb-2.5">Challenge Prompt</th>
                                                    <th class="pb-2.5 text-center">Students Who Passed</th>
                                                    <th class="pb-2.5 text-center">Class Accuracy</th>
                                                </tr>
                                            </thead>
                                            <tbody id="masteredTableBody">
                                                <tr>
                                                    <td colspan="4" class="py-6 text-center text-slate-400 text-xs">
                                                        Loading class question telemetry…</td>
                                                </tr>
                                            </tbody>
                                        </table>
                                    </div>

                                    <!-- Mastered Pagination Controls -->
                                    <div
                                        class="flex items-center justify-between text-xs pt-3 border-t border-slate-100">
                                        <span class="text-slate-400" id="masteredPageInfo">Page 1 of 1</span>
                                        <div class="flex items-center gap-1.5">
                                            <button onclick="prevMasteredPage()" id="btnMasteredPrev"
                                                class="px-3 py-1 rounded-lg border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">
                                                <i class="fas fa-chevron-left text-[10px]"></i> Prev
                                            </button>
                                            <button onclick="nextMasteredPage()" id="btnMasteredNext"
                                                class="px-3 py-1 rounded-lg border border-slate-200 text-slate-600 font-bold hover:bg-slate-50 disabled:opacity-40 disabled:cursor-not-allowed">
                                                Next <i class="fas fa-chevron-right text-[10px]"></i>
