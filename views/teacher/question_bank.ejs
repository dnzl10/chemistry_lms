                        <i class="fas fa-clipboard-check text-base"></i>
                    </div>
                    <div>
                        <h3 class="font-extrabold text-slate-800 text-sm" id="authorSaveConfirmTitle">Confirm Challenge
                            Submission</h3>
                        <p class="text-[11px] text-slate-400">Please review your challenge before saving</p>
                    </div>
