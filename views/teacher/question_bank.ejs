                        </div>
            </main>

    </div>

    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <!-- VISUAL QUESTION AUTHORING MODAL (No Raw JSON / No Raw Strings)        -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <div class="modal-backdrop" id="authorModal">
        <div class="modal-card">
            <div class="modal-header">
                <div class="flex items-center gap-3">
                    <div
                        class="w-9 h-9 rounded-xl bg-cyan-100 text-cyan-700 flex items-center justify-center font-bold">
                        <i class="fas fa-atom text-base"></i>
                    </div>
                    <div>
                        <h3 class="font-extrabold text-slate-800 text-base" id="authorModalTitle">Author Chemistry
                            Challenge</h3>
                        <p class="text-xs text-slate-400">Interactive Elementa Lab Builder</p>
                    </div>
                </div>
                <button type="button" onclick="requestCloseAuthorModal()"
                    class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 cursor-pointer">
                    <i class="fas fa-times"></i>
                </button>
            </div>

            <!-- Admin Approval Notification Banner -->
            <div
                class="bg-amber-50/80 border-b border-amber-200/80 px-6 py-3 flex items-center gap-3 text-xs text-amber-900">
                <i class="fas fa-shield-halved text-amber-600 text-sm"></i>
                <span><strong>Quality Control:</strong> All newly authored or revised questions enter <strong>Pending
                        Review</strong> and must be approved by an administrator before appearing in student arcade
                    sessions.</span>
            </div>

            <form id="authorForm" onsubmit="requestSubmitQuestion(event)" class="p-6 space-y-6">
                <input type="hidden" id="formQid" name="question_id" value="">
                <input type="hidden" id="formAnswerText" name="answer_text" value="">
                <input type="hidden" id="formStepsJson" name="steps_json" value="">

                <!-- 1. Select Station / Level -->
                <div>
                    <label class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-2">
                        1. Arcade Station & Level <span class="text-rose-500">*</span>
                    </label>
                    <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3">
                        <select id="formLevel" name="level_number" onchange="onStationChanged()"
                            class="filter-select flex-1 font-bold text-slate-800 text-sm" required>
                            <% for (let lvl=1; lvl <=12; lvl++) { %>
                                <% const m=(LEVEL_MACHINES && LEVEL_MACHINES[lvl]) || { name: 'Station ' + lvl,
                                    topic: 'Topic ' + lvl }; %>
                                    <option value="<%= lvl %>">
                                        Level <%= lvl %>: <%= m.name %> (<%= m.topic %>)
                                    </option>
                                    <% } %>
                        </select>
                        <button type="button" onclick="loadStationPreset()"
                            class="px-4 py-2.5 rounded-xl border border-cyan-200 bg-cyan-50 hover:bg-cyan-100 text-cyan-800 font-bold text-xs flex items-center justify-center gap-2 cursor-pointer">
                            <i class="fas fa-wand-magic-sparkles text-cyan-600"></i> Auto-Load Station Blueprint
                        </button>
                    </div>
                </div>

                <!-- 2. Challenge Prompt -->
                <div>
                    <label class="block text-xs font-black uppercase tracking-wider text-slate-500 mb-2">
                        2. Challenge Prompt (Customer Narrative) <span class="text-rose-500">*</span>
                    </label>
                    <textarea id="formPrompt" name="prompt" rows="3"
                        class="w-full p-3.5 rounded-xl border border-slate-200 text-sm text-slate-800 focus:border-cyan-500 focus:ring-2 focus:ring-cyan-100 outline-none transition"
                        placeholder="e.g. Good day! I need 100 mL of Sodium Chloride (NaCl) solution. Please measure it accurately."
                        required></textarea>
                </div>

                <!-- 3. Visual Step Builder Container -->
                <div>
                    <div class="flex items-center justify-between mb-2">
                        <label class="block text-xs font-black uppercase tracking-wider text-slate-500">
                            3. Laboratory Interactive Controls & Steps <span class="text-rose-500">*</span>
                        </label>
                        <div class="flex items-center gap-2">
                            <button type="button" onclick="addStep('element')"
                                class="px-3 py-1 rounded-lg bg-cyan-50 text-cyan-700 hover:bg-cyan-100 font-bold text-xs flex items-center gap-1 cursor-pointer">
                                <i class="fas fa-plus"></i> Element Slots
                            </button>
                            <button type="button" onclick="addStep('dial')"
                                class="px-3 py-1 rounded-lg bg-indigo-50 text-indigo-700 hover:bg-indigo-100 font-bold text-xs flex items-center gap-1 cursor-pointer">
                                <i class="fas fa-plus"></i> Measurement Dial
                            </button>
                            <button type="button" onclick="addStep('choice')"
                                class="px-3 py-1 rounded-lg bg-purple-50 text-purple-700 hover:bg-purple-100 font-bold text-xs flex items-center gap-1 cursor-pointer">
                                <i class="fas fa-plus"></i> Multiple Choice
                            </button>
                        </div>
                    </div>

                    <!-- Dynamic Steps Cards List -->
                    <div id="stepCardsContainer" class="space-y-4">
                        <!-- Cards will be dynamically injected here -->
                    </div>
                </div>

                <!-- 4. Parameters (Difficulty, Points, Time Limit) -->
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 pt-2 border-t border-slate-100">
                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-1.5 uppercase tracking-wider">Difficulty
                            Tier</label>
                        <select id="formDifficulty" name="difficulty" class="filter-select w-full">
                            <option value="Easy">Easy</option>
                            <option value="Average" selected>Average</option>
                            <option value="Difficult">Difficult</option>
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-1.5 uppercase tracking-wider">Points
                            Weight</label>
                        <input type="number" id="formPoints" name="points" min="1" max="50" value="1"
                            class="search-input w-full" required>
                    </div>

                    <div>
                        <label class="block text-xs font-bold text-slate-500 mb-1.5 uppercase tracking-wider">Time Limit
                            (Seconds)</label>
                        <input type="number" id="formTimeLimit" name="time_limit_s" min="10" max="600" value="90"
                            class="search-input w-full" required>
                    </div>
                </div>

                <!-- 5. Live Auto-Generated Summary & In-Game Ticket Preview -->
                <div class="bg-gradient-to-r from-slate-900 to-indigo-950 p-4 rounded-2xl text-white space-y-2">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-cyan-400 font-bold uppercase tracking-wider flex items-center gap-1.5">
                            <i class="fas fa-ticket"></i> In-Game Customer Ticket Preview
                        </span>
                        <span class="text-slate-400 text-[11px]">Auto-compiled for Godot engine</span>
                    </div>
                    <div class="flex items-center justify-between flex-wrap gap-2 pt-1 border-t border-slate-800">
                        <div class="font-mono text-base font-extrabold text-emerald-400" id="previewAnswerText">
                            (Configure steps above)
                        </div>
                        <div class="text-xs text-slate-300 font-semibold" id="previewStepsSummary">
                            0 steps configured
                        </div>
                    </div>
                </div>

                <!-- Modal Footer Buttons -->
                <div class="flex items-center justify-end gap-3 pt-3 border-t border-slate-100">
                    <button type="button" onclick="requestCloseAuthorModal()"
                        class="px-5 py-2.5 rounded-xl border border-slate-200 text-slate-600 font-bold text-xs hover:bg-slate-50 cursor-pointer">
                        Cancel
                    </button>
                    <button type="submit" id="btnSubmitAuthor"
                        class="px-6 py-2.5 rounded-xl bg-gradient-to-r from-cyan-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white font-extrabold text-xs shadow-md shadow-cyan-200 cursor-pointer">
                        <i class="fas fa-paper-plane mr-1.5"></i> Submit for Admin Approval
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ======= AUTHOR DISCARD CONFIRMATION MODAL ======= -->
    <div class="modal-backdrop" id="authorDiscardConfirmModal" style="z-index: 250;">
        <div class="modal-card" style="max-width: 440px; width: 92vw;">
            <div class="modal-header">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-amber-100 flex items-center justify-center text-amber-600">
