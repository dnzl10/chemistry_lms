    <!-- RIGHT SLIDE-OUT DRAWER: LINK TO ASSESSMENT                            -->
    <!-- ══════════════════════════════════════════════════════════════════════ -->
    <div id="linkDrawerBackdrop" class="fixed inset-0 bg-slate-900/40 backdrop-blur-xs z-50 hidden"
        onclick="closeLinkDrawer()"></div>
    <div id="linkDrawer"
        class="fixed top-0 right-0 h-full w-full max-w-md bg-white shadow-2xl z-50 transform translate-x-full transition-transform duration-300 flex flex-col">
        <div class="p-6 border-b border-slate-100 flex items-center justify-between">
            <div class="flex items-center gap-2">
                <i class="fas fa-link text-cyan-600"></i>
                <h3 class="font-bold text-slate-800 text-base">Link to Assessment</h3>
            </div>
            <button onclick="closeLinkDrawer()" class="text-slate-400 hover:text-slate-600">
                <i class="fas fa-times text-lg"></i>
            </button>
        </div>

        <div class="p-6 flex-1 overflow-y-auto space-y-4">
            <p class="text-xs text-slate-500">
                Attach this approved chemistry challenge to one of your created class assessments so students encounter
                it during their exam sessions.
            </p>

            <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wider mb-2">Target
                    Assessment</label>
                <select id="drawerAsmtSelect" class="filter-select w-full">
                    <option value="">— Select an Assessment —</option>
                    <% assessments.forEach(function(asmt) { %>
                        <option value="<%= asmt.assessment_id %>">[<%= asmt.assessment_type %>] <%= asmt.assessment_name
                                    %>
                        </option>
                        <% }); %>
                </select>
            </div>

            <input type="hidden" id="drawerQid" value="">
        </div>

        <div class="p-6 border-t border-slate-100 bg-slate-50 flex items-center justify-end gap-3">
            <button onclick="closeLinkDrawer()"
                class="px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-200">
                Cancel
            </button>
            <button onclick="submitLinkAssessment()"
                class="px-5 py-2 rounded-xl text-xs font-extrabold bg-cyan-600 hover:bg-cyan-500 text-white shadow-md">
                Confirm Link
            </button>
        </div>
    </div>

