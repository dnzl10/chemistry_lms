        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <!-- JAVASCRIPT LOGIC & VISUAL BUILDER ENGINE                               -->
        <!-- ══════════════════════════════════════════════════════════════════════ -->
        <script type="application/json"
            id="qbank-sync-data"><%- JSON.stringify(questions || []).replace(/<\//g, '<\\/') %></script>
        <script type="application/json"
            id="qbank-init-config"><%- JSON.stringify({ LEVEL_MACHINES: LEVEL_MACHINES || {}, LEVEL_TOPIC_MAP: LEVEL_TOPIC_MAP || {}, materials: materials || [] }).replace(/<\//g, '<\\/') %></script>
        <script>
            // Injected server configuration
            const _qbankConfig = JSON.parse(document.getElementById('qbank-init-config').textContent || '{}');
            const LEVEL_MACHINES = _qbankConfig.LEVEL_MACHINES || {};
            const LEVEL_TOPIC_MAP = _qbankConfig.LEVEL_TOPIC_MAP || {};
            const QUESTIONS_DATA = JSON.parse(document.getElementById('qbank-sync-data').textContent || '[]');
            const UPLOADED_MATERIALS = _qbankConfig.materials || [];

            // Standard 118 Periodic Table Elements for symbol validation
            const PERIODIC_ELEMENTS = new Set([
                "H", "He", "Li", "Be", "B", "C", "N", "O", "F", "Ne", "Na", "Mg", "Al", "Si", "P", "S", "Cl", "Ar",
                "K", "Ca", "Sc", "Ti", "V", "Cr", "Mn", "Fe", "Co", "Ni", "Cu", "Zn", "Ga", "Ge", "As", "Se", "Br", "Kr",
                "Rb", "Sr", "Y", "Zr", "Nb", "Mo", "Tc", "Ru", "Rh", "Pd", "Ag", "Cd", "In", "Sn", "Sb", "Te", "I", "Xe",
                "Cs", "Ba", "La", "Ce", "Pr", "Nd", "Pm", "Sm", "Eu", "Gd", "Tb", "Dy", "Ho", "Er", "Tm", "Yb", "Lu",
                "Hf", "Ta", "W", "Re", "Os", "Ir", "Pt", "Au", "Hg", "Tl", "Pb", "Bi", "Po", "At", "Rn", "Fr", "Ra",
                "Ac", "Th", "Pa", "U", "Np", "Pu", "Am", "Cm", "Bk", "Cf", "Es", "Fm", "Md", "No", "Lr", "Rf", "Db",
                "Sg", "Bh", "Hs", "Mt", "Ds", "Rg", "Cn", "Nh", "Fl", "Mc", "Lv", "Ts", "Og"
            ]);

            // Active builder state (steps in authoring modal)
            let currentSteps = [];

            // ── Station Standard Blueprints (Levels 1 to 12) ──
            const STATION_BLUEPRINTS = {
                1: {
                    prompt: "Good day! I need 100 mL of Sodium Chloride (NaCl) solution. Please measure it accurately.",
                    steps: [
                        { type: "pick_seq", label: "Load the reagents in order", answer: ["Na", "Cl"] },
                        { type: "dial", label: "Volume", target: 100.0, unit: " mL", min: 0.0, max: 600.0, step: 10.0, tolerance: 0.0 }
                    ]
                },
                2: {
                    prompt: "Please build a Carbon atom.",
                    steps: [
                        { type: "choice", label: "Press the element", options: ["C", "N", "O", "B", "Be"], answer: "C" },
                        { type: "dial", label: "Protons", target: 6.0, unit: "", min: 0.0, max: 30.0, step: 1.0, tolerance: 0.0 },
                        { type: "dial", label: "Neutrons", target: 6.0, unit: "", min: 0.0, max: 40.0, step: 1.0, tolerance: 0.0 },
                        { type: "dial", label: "Electrons", target: 6.0, unit: "", min: 0.0, max: 30.0, step: 1.0, tolerance: 0.0 },
                        { type: "choice", label: "Electron configuration", options: ["1s2 2s2", "1s2 2s2 2p2", "1s2 2s2 2p3", "1s2 2s2 2p4"], answer: "1s2 2s2 2p2" }
                    ]
                },
                3: {
                    prompt: "Please prepare Carbon-14 for radiometric dating.",
                    steps: [
                        { type: "choice", label: "Press the element", options: ["C", "N", "B", "O", "Be"], answer: "C" },
                        { type: "dial", label: "Neutron Count", target: 8.0, unit: " n", min: 0.0, max: 160.0, step: 1.0, tolerance: 0.0 },
                        { type: "choice", label: "Mass number", options: ["13", "14", "15", "6"], answer: "14" }
                    ]
                },
                4: {
                    prompt: "Prepare a Chlorine sample using the correct isotope combination.",
                    steps: [
                        { type: "pick_set", label: "Select isotope bottles", answer: ["Cl-35", "Cl-37"] },
                        { type: "choice", label: "Average atomic mass reading", options: ["35.00 u", "35.45 u", "36.00 u", "37.00 u"], answer: "35.45 u" }
                    ]
                },
                5: {
                    prompt: "Please produce Water (H2O) and verify percentage composition.",
                    steps: [
                        { type: "pick_seq", label: "Assemble the compound", answer: ["H", "O"] },
                        { type: "choice", label: "Percentage composition", options: ["H = 11.19% , O = 88.81%", "H = 20.00% , O = 80.00%", "H = 50.00% , O = 50.00%"], answer: "H = 11.19% , O = 88.81%" }
                    ]
                },
                6: {
                    prompt: "Please prepare Sodium Chloride.",
                    steps: [
                        { type: "pick_seq", label: "Assemble the elements", answer: ["Na", "Cl"] },
                        { type: "choice", label: "Formula confirmation", options: ["Na2Cl", "NaCl", "NaCl2", "Na2Cl3"], answer: "NaCl" }
                    ]
                },
                7: {
                    prompt: "Prepare an ionic Sodium Chloride solution in water.",
                    steps: [
                        { type: "pick_set", label: "Load reagents", answer: ["Na", "Cl", "Water"] },
                        { type: "choice", label: "Bond analyzer", options: ["Covalent bond", "Ionic bond - conducts electricity", "Metallic bond"], answer: "Ionic bond - conducts electricity" }
                    ]
                },
                8: {
                    prompt: "Please prepare Water (H2O) and analyze intermolecular forces.",
                    steps: [
                        { type: "pick_seq", label: "Build molecule", answer: ["H", "O"] },
                        { type: "choice", label: "Dominant IMF", options: ["Dipole-dipole", "Hydrogen bonding", "London dispersion"], answer: "Hydrogen bonding" }
                    ]
                },
                9: {
                    prompt: "Please produce Soap using saponification.",
                    steps: [
                        { type: "pick_set", label: "Organic reagents", answer: ["Oil", "NaOH"] },
                        { type: "choice", label: "Reaction analyzer", options: ["Combustion", "Fermentation", "Saponification"], answer: "Saponification" }
                    ]
                },
                10: {
                    prompt: "Perform a neutralization reaction using Hydrochloric Acid and Sodium Hydroxide.",
                    steps: [
                        { type: "pick_set", label: "Load reactants", answer: ["HCl", "NaOH"] },
                        { type: "choice", label: "Reaction classification", options: ["Combustion", "Neutralization - double displacement", "Synthesis"], answer: "Neutralization - double displacement" }
                    ]
                },
                11: {
                    prompt: "Prepare 1 mole of Oxygen gas (O2).",
                    steps: [
                        { type: "choice", label: "Press the substance", options: ["O2", "CO2", "H2O", "NaCl", "NH3", "CH4"], answer: "O2" },
                        { type: "dial", label: "Mole Slider", target: 1.0, unit: " mol", min: 0.0, max: 10.0, step: 0.5, tolerance: 0.0 },
                        { type: "choice", label: "Dispensed mass readout", options: ["16.00 g", "18.02 g", "32.00 g", "44.01 g"], answer: "32.00 g" }
                    ]
                },
                12: {
                    prompt: "Complete and balance the reaction to produce Water: __ H2 + __ O2 -> __ H2O.",
                    steps: [
                        { type: "choice", label: "Build the reaction product", options: ["H2O", "H2O2", "H3O", "OH"], answer: "H2O" },
                        { type: "dial", label: "Coefficient of H2", target: 2.0, unit: "", min: 1.0, max: 10.0, step: 1.0, tolerance: 0.0 },
                        { type: "dial", label: "Coefficient of O2", target: 1.0, unit: "", min: 1.0, max: 10.0, step: 1.0, tolerance: 0.0 },
                        { type: "dial", label: "Coefficient of H2O", target: 2.0, unit: "", min: 1.0, max: 10.0, step: 1.0, tolerance: 0.0 }
                    ]
                }
            };

            // ── Toast System ──
            function showToast(msg, type = 'success') {
                const toast = document.getElementById('toast');
                const icon = document.getElementById('toastIcon');
                const msgEl = document.getElementById('toastMsg');

                msgEl.textContent = msg;
                toast.className = 'show ' + type;
                if (type === 'success') icon.className = 'fas fa-check-circle text-emerald-400';
                else if (type === 'error') icon.className = 'fas fa-exclamation-circle text-rose-400';
                else icon.className = 'fas fa-info-circle text-cyan-400';

                setTimeout(() => { toast.className = ''; }, 3200);
            }

            // ── Shell Navigation Toggles (From class_list.ejs) ──
            function toggleSidebar() {
                const sidebar = document.getElementById('sidebar');
                const overlay = document.getElementById('sidebarOverlay');
                const isHidden = sidebar.classList.contains('-translate-x-full');
                if (isHidden) {
                    sidebar.classList.remove('-translate-x-full');
                    overlay.classList.remove('hidden');
                } else {
                    sidebar.classList.add('-translate-x-full');
                    overlay.classList.add('hidden');
                }
            }

            function toggleProfileDropdown() {
                document.getElementById('profileDropdown').classList.toggle('open');
            }
            document.addEventListener('click', function (e) {
                const wrap = document.getElementById('profileDropdownWrap');
                if (wrap && !wrap.contains(e.target)) {
                    document.getElementById('profileDropdown').classList.remove('open');
                }
            });

            // ── Tab Switching ──
            function switchMainTab(tab) {
                ['repo', 'status', 'telemetry'].forEach(t => {
                    const btn = document.getElementById('tabNav-' + t);
                    const content = document.getElementById('tabContent-' + t);
                    if (t === tab) {
                        btn.classList.add('active');
                        content.classList.remove('hidden');
                    } else {
                        btn.classList.remove('active');
                        content.classList.add('hidden');
                    }
                });

                if (tab === 'telemetry') loadClassTelemetry();
            }

            function switchSubQueue(sub) {
                ['pending', 'approved', 'rejected'].forEach(s => {
                    const btn = document.getElementById('subtab-' + s + '-btn');
                    const q = document.getElementById('subqueue-' + s);
                    if (s === sub) {
                        btn.className = 'px-4 py-2 rounded-xl text-xs font-bold bg-cyan-600 text-white shadow-sm';
                        q.classList.remove('hidden');
                    } else {
                        btn.className = 'px-4 py-2 rounded-xl text-xs font-bold text-slate-600 hover:bg-slate-100';
                        q.classList.add('hidden');
                    }
                });
            }

            // ── Live Filter in Repository ──
            function filterQuestions() {
                const query = (document.getElementById('repoSearch').value || '').toLowerCase().trim();
                const level = document.getElementById('repoLevelFilter').value;
                const diff = document.getElementById('repoDiffFilter').value;
                const stat = document.getElementById('repoStatusFilter').value;

                document.querySelectorAll('#questionsGrid > .q-card').forEach(card => {
                    const cPrompt = card.getAttribute('data-prompt') || '';
                    const cCode = card.getAttribute('data-code') || '';
                    const cAns = card.getAttribute('data-ans') || '';
                    const cLevel = card.getAttribute('data-level');
                    const cDiff = card.getAttribute('data-diff');
                    const cStat = card.getAttribute('data-status');

                    const matchQuery = !query || cPrompt.includes(query) || cCode.includes(query) || cAns.includes(query);
                    const matchLevel = !level || cLevel === level;
                    const matchDiff = !diff || cDiff === diff;
                    const matchStat = !stat || cStat === stat;

                    card.style.display = (matchQuery && matchLevel && matchDiff && matchStat) ? 'flex' : 'none';
                });
            }

            // ── Visual Step Builder Functions ──
            function onStationChanged() {
                const isEditing = Boolean(document.getElementById('formQid').value);
                if (!isEditing) {
                    loadStationPreset();
                } else {
                    recompileSummary();
                }
            }

            function loadStationPreset() {
                const lvl = parseInt(document.getElementById('formLevel').value, 10);
                const preset = STATION_BLUEPRINTS[lvl] || STATION_BLUEPRINTS[1];
                document.getElementById('formPrompt').value = preset.prompt;
                currentSteps = JSON.parse(JSON.stringify(preset.steps));
                renderStepCards();
                recompileSummary();
                showToast(`Loaded Blueprint for Station ${lvl}`, 'info');
            }

            function addStep(type) {
                if (type === 'element') {
                    currentSteps.push({
                        type: 'pick_seq',
                        label: 'Load reagents',
                        answer: ['Na', 'Cl']
                    });
                } else if (type === 'dial') {
                    currentSteps.push({
                        type: 'dial',
                        label: 'Volume',
                        target: 100.0,
                        unit: ' mL',
                        min: 0.0,
                        max: 600.0,
                        step: 10.0,
                        tolerance: 0.0
                    });
                } else if (type === 'choice') {
                    currentSteps.push({
                        type: 'choice',
                        label: 'Select target solution',
                        options: ['Option A', 'Option B', 'Option C'],
                        answer: 'Option A'
                    });
                }
                renderStepCards();
                recompileSummary();
            }

            function removeStep(idx) {
                currentSteps.splice(idx, 1);
                renderStepCards();
                recompileSummary();
            }

            // ── Draggable step cards & sequence management ──
            let draggedStepIndex = null;

            function handleStepDragStart(e, idx) {
                // If the drag originated from an input, select, textarea, button, or chip, ignore card dragging
                if (e.target.closest('input, select, textarea, button, .el-chip')) {
                    e.preventDefault();
                    return;
                }
                draggedStepIndex = idx;
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', String(idx));
                const card = e.currentTarget;
                setTimeout(() => {
                    if (card) card.classList.add('dragging');
                }, 0);
            }

            function handleStepDragOver(e, idx) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                const card = e.currentTarget;
                if (card && draggedStepIndex !== null && draggedStepIndex !== idx) {
                    card.classList.add('drag-over');
                }
            }

            function handleStepDragLeave(e, idx) {
                const card = e.currentTarget;
                if (card) {
                    card.classList.remove('drag-over');
                }
            }

            function handleStepDrop(e, targetIdx) {
                e.preventDefault();
                const card = e.currentTarget;
                if (card) card.classList.remove('drag-over');

                if (draggedStepIndex === null || draggedStepIndex === undefined || draggedStepIndex === targetIdx) {
                    return;
                }

                const [moved] = currentSteps.splice(draggedStepIndex, 1);
                currentSteps.splice(targetIdx, 0, moved);
                draggedStepIndex = null;
                renderStepCards();
                recompileSummary();
            }

            function handleStepDragEnd(e) {
                draggedStepIndex = null;
                document.querySelectorAll('.step-card').forEach(card => {
                    card.classList.remove('dragging', 'drag-over');
                });
            }

            function moveStep(fromIdx, offset) {
                const targetIdx = fromIdx + offset;
                if (targetIdx < 0 || targetIdx >= currentSteps.length) return;
                const [moved] = currentSteps.splice(fromIdx, 1);
                currentSteps.splice(targetIdx, 0, moved);
                renderStepCards();
                recompileSummary();
            }

            function renderStepCards() {
                const container = document.getElementById('stepCardsContainer');
                if (currentSteps.length === 0) {
                    container.innerHTML = `
                <div class="p-6 bg-slate-50 border border-dashed border-slate-200 rounded-2xl text-center text-slate-400 text-xs">
                    <i class="fas fa-microscope text-2xl mb-1.5 block text-slate-300"></i>
                    No steps added yet. Click <strong>+ Element Slots</strong> or <strong>+ Measurement Dial</strong> above or load a station blueprint.
                </div>
            `;
                    return;
                }

                container.innerHTML = currentSteps.map((step, idx) => {
                    const stepNum = idx + 1;
                    if (step.type === 'pick_seq' || step.type === 'pick_set') {
                        const isSeq = step.type === 'pick_seq';
                        const elements = Array.isArray(step.answer) ? step.answer : [step.answer];
                        const chipsHtml = elements.map((el, elIdx) => `
                    <span class="el-chip">
                        <span>${el}</span>
                        <i class="fas fa-times btn-del-chip" onclick="removeElementChip(${idx}, ${elIdx})"></i>
                    </span>
                `).join('');

                        const slotBoxesHtml = elements.map(el => `[  ${el}  ]`).join('   ');

                        return `
                <div class="step-card bg-white p-4 rounded-2xl border border-cyan-200 shadow-xs space-y-3 cursor-default"
                     draggable="true"
                     data-step-idx="${idx}"
                     ondragstart="handleStepDragStart(event, ${idx})"
                     ondragover="handleStepDragOver(event, ${idx})"
                     ondragleave="handleStepDragLeave(event, ${idx})"
                     ondrop="handleStepDrop(event, ${idx})"
                     ondragend="handleStepDragEnd(event)">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                        <div class="flex items-center gap-2">
                            <span class="step-drag-handle p-1 text-slate-400 hover:text-slate-600 cursor-grab" title="Drag to reorder step">
                                <i class="fas fa-grip-vertical"></i>
                            </span>
                            <span class="w-6 h-6 rounded-lg bg-cyan-100 text-cyan-800 text-xs font-black flex items-center justify-center">${stepNum}</span>
                            <span class="text-xs font-black uppercase tracking-wider text-slate-700">Element Reagent Slots</span>
                            <span class="text-[10px] px-2 py-0.5 rounded-full font-bold ${isSeq ? 'bg-indigo-100 text-indigo-700' : 'bg-emerald-100 text-emerald-700'}">
                                ${isSeq ? 'Strict Sequence' : 'Any Order (Set)'}
                            </span>
                        </div>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="moveStep(${idx}, -1)" ${idx === 0 ? 'disabled' : ''} class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-cyan-600 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed text-xs transition" title="Move step up">
                                <i class="fas fa-chevron-up"></i>
                            </button>
                            <button type="button" onclick="moveStep(${idx}, 1)" ${idx === currentSteps.length - 1 ? 'disabled' : ''} class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-cyan-600 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed text-xs transition" title="Move step down">
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            <button type="button" onclick="removeStep(${idx})" class="w-6 h-6 rounded flex items-center justify-center text-slate-300 hover:text-rose-500 hover:bg-rose-50 text-xs cursor-pointer ml-1" title="Delete step">
                                <i class="fas fa-trash-can"></i>
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Step Label / Action</label>
                            <input type="text" value="${step.label || 'Load reagents'}" oninput="updateStepProp(${idx}, 'label', this.value)" class="search-input w-full text-xs">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Input Order Rule</label>
                            <select onchange="updateStepProp(${idx}, 'type', this.value)" class="filter-select w-full text-xs">
                                <option value="pick_seq" ${isSeq ? 'selected' : ''}>Sequential (Order Matters)</option>
                                <option value="pick_set" ${!isSeq ? 'selected' : ''}>Unordered (Any Order)</option>
                            </select>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">
                            Target Element Formula (Type symbol & press Enter):
                        </label>
                        <div class="flex items-center gap-2 flex-wrap p-2 rounded-xl border border-slate-200 bg-slate-50 min-h-[44px]">
                            ${chipsHtml}
                            <input type="text" placeholder="+ Add Element (e.g. Na)" onkeydown="handleChipInput(event, ${idx})" class="text-xs font-mono font-bold bg-transparent outline-none text-cyan-900 w-28 px-1">
                        </div>
                    </div>

                    <!-- Live In-Game Slot Rendering -->
                    <div class="p-3 bg-slate-900 rounded-xl text-white font-mono text-xs flex items-center justify-between flex-wrap gap-2">
                        <span class="text-slate-400 text-[11px]">In-Game Arcade Display:</span>
                        <div class="text-cyan-400 font-extrabold tracking-widest">
                            SLOTS:   ${slotBoxesHtml || '[  ___  ]'}
                        </div>
                    </div>
                </div>`;
                    } else if (step.type === 'dial') {
                        return `
                <div class="step-card bg-white p-4 rounded-2xl border border-indigo-200 shadow-xs space-y-3 cursor-default"
                     draggable="true"
                     data-step-idx="${idx}"
                     ondragstart="handleStepDragStart(event, ${idx})"
                     ondragover="handleStepDragOver(event, ${idx})"
                     ondragleave="handleStepDragLeave(event, ${idx})"
                     ondrop="handleStepDrop(event, ${idx})"
                     ondragend="handleStepDragEnd(event)">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                        <div class="flex items-center gap-2">
                            <span class="step-drag-handle p-1 text-slate-400 hover:text-slate-600 cursor-grab" title="Drag to reorder step">
                                <i class="fas fa-grip-vertical"></i>
                            </span>
                            <span class="w-6 h-6 rounded-lg bg-indigo-100 text-indigo-800 text-xs font-black flex items-center justify-center">${stepNum}</span>
                            <span class="text-xs font-black uppercase tracking-wider text-slate-700">Measurement Dial / Rotary Gauge</span>
                        </div>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="moveStep(${idx}, -1)" ${idx === 0 ? 'disabled' : ''} class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed text-xs transition" title="Move step up">
                                <i class="fas fa-chevron-up"></i>
                            </button>
                            <button type="button" onclick="moveStep(${idx}, 1)" ${idx === currentSteps.length - 1 ? 'disabled' : ''} class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-indigo-600 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed text-xs transition" title="Move step down">
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            <button type="button" onclick="removeStep(${idx})" class="w-6 h-6 rounded flex items-center justify-center text-slate-300 hover:text-rose-500 hover:bg-rose-50 text-xs cursor-pointer ml-1" title="Delete step">
                                <i class="fas fa-trash-can"></i>
                            </button>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
                        <div class="col-span-2 sm:col-span-2">
                            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Parameter Label</label>
                            <input type="text" value="${step.label || 'Volume'}" oninput="updateStepProp(${idx}, 'label', this.value)" class="search-input w-full text-xs">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Target Reading</label>
                            <input type="number" step="any" value="${step.target || 100}" oninput="updateStepProp(${idx}, 'target', parseFloat(this.value)||0)" class="search-input w-full text-xs font-bold text-indigo-700">
                        </div>
                        <div>
                            <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Unit</label>
                            <input type="text" value="${step.unit || ' mL'}" oninput="updateStepProp(${idx}, 'unit', this.value)" class="search-input w-full text-xs font-mono">
                        </div>
                    </div>

                    <div class="grid grid-cols-3 gap-3 text-xs">
                        <div>
                            <label class="block text-[10px] text-slate-400 font-bold mb-1">Min Value</label>
                            <input type="number" value="${step.min || 0}" oninput="updateStepProp(${idx}, 'min', parseFloat(this.value)||0)" class="search-input w-full text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] text-slate-400 font-bold mb-1">Max Value</label>
                            <input type="number" value="${step.max || 600}" oninput="updateStepProp(${idx}, 'max', parseFloat(this.value)||0)" class="search-input w-full text-xs">
                        </div>
                        <div>
                            <label class="block text-[10px] text-slate-400 font-bold mb-1">Step Increments</label>
                            <input type="number" value="${step.step || 10}" oninput="updateStepProp(${idx}, 'step', parseFloat(this.value)||1)" class="search-input w-full text-xs">
                        </div>
                    </div>
                </div>`;
                    } else if (step.type === 'choice') {
                        const options = Array.isArray(step.options) ? step.options : ['Option A', 'Option B'];
                        const optsHtml = options.map((opt, optIdx) => `
                    <div class="flex items-center gap-2">
                        <input type="radio" name="choice_ans_${idx}" ${step.answer === opt ? 'checked' : ''} onchange="updateStepProp(${idx}, 'answer', '${opt.replace(/'/g, "\\'")}')" class="text-cyan-600 cursor-pointer">
                        <input type="text" value="${opt}" oninput="updateChoiceOption(${idx}, ${optIdx}, this.value)" class="search-input flex-1 text-xs">
                        <button type="button" onclick="removeChoiceOption(${idx}, ${optIdx})" class="text-slate-300 hover:text-rose-500 text-xs cursor-pointer"><i class="fas fa-times"></i></button>
                    </div>
                `).join('');

                        return `
                <div class="step-card bg-white p-4 rounded-2xl border border-purple-200 shadow-xs space-y-3 cursor-default"
                     draggable="true"
                     data-step-idx="${idx}"
                     ondragstart="handleStepDragStart(event, ${idx})"
                     ondragover="handleStepDragOver(event, ${idx})"
                     ondragleave="handleStepDragLeave(event, ${idx})"
                     ondrop="handleStepDrop(event, ${idx})"
                     ondragend="handleStepDragEnd(event)">
                    <div class="flex items-center justify-between border-b border-slate-100 pb-2">
                        <div class="flex items-center gap-2">
                            <span class="step-drag-handle p-1 text-slate-400 hover:text-slate-600 cursor-grab" title="Drag to reorder step">
                                <i class="fas fa-grip-vertical"></i>
                            </span>
                            <span class="w-6 h-6 rounded-lg bg-purple-100 text-purple-800 text-xs font-black flex items-center justify-center">${stepNum}</span>
                            <span class="text-xs font-black uppercase tracking-wider text-slate-700">Multiple Choice Question</span>
                        </div>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="moveStep(${idx}, -1)" ${idx === 0 ? 'disabled' : ''} class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-purple-600 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed text-xs transition" title="Move step up">
                                <i class="fas fa-chevron-up"></i>
                            </button>
                            <button type="button" onclick="moveStep(${idx}, 1)" ${idx === currentSteps.length - 1 ? 'disabled' : ''} class="w-6 h-6 rounded flex items-center justify-center text-slate-400 hover:text-purple-600 hover:bg-slate-100 disabled:opacity-30 disabled:cursor-not-allowed text-xs transition" title="Move step down">
                                <i class="fas fa-chevron-down"></i>
                            </button>
                            <button type="button" onclick="removeStep(${idx})" class="w-6 h-6 rounded flex items-center justify-center text-slate-300 hover:text-rose-500 hover:bg-rose-50 text-xs cursor-pointer ml-1" title="Delete step">
                                <i class="fas fa-trash-can"></i>
                            </button>
                        </div>
                    </div>

                    <div>
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider mb-1">Prompt / Question Label</label>
                        <input type="text" value="${step.label || 'Select option'}" oninput="updateStepProp(${idx}, 'label', this.value)" class="search-input w-full text-xs">
                    </div>

                    <div class="space-y-2">
                        <label class="block text-[11px] font-bold text-slate-500 uppercase tracking-wider">Choices (Select radio button for correct answer):</label>
                        ${optsHtml}
                        <button type="button" onclick="addChoiceOption(${idx})" class="text-[11px] text-cyan-600 hover:text-cyan-800 font-bold mt-1 cursor-pointer">
                            + Add Another Option
                        </button>
                    </div>
                </div>`;
                    }
                }).join('');
            }

            function updateStepProp(idx, prop, val) {
                if (!currentSteps[idx]) return;
                currentSteps[idx][prop] = val;
                recompileSummary();
            }

            function handleChipInput(e, stepIdx) {
                if (e.key === 'Enter' || e.key === ',') {
                    e.preventDefault();
                    const symbol = e.target.value.trim();
                    if (!symbol) return;

                    // Normalize capitalized symbol
                    const norm = symbol.charAt(0).toUpperCase() + symbol.slice(1).toLowerCase();
                    if (!Array.isArray(currentSteps[stepIdx].answer)) {
                        currentSteps[stepIdx].answer = [];
                    }
                    currentSteps[stepIdx].answer.push(norm);
                    e.target.value = '';
                    renderStepCards();
                    recompileSummary();
                }
            }

            function removeElementChip(stepIdx, elIdx) {
                if (currentSteps[stepIdx] && Array.isArray(currentSteps[stepIdx].answer)) {
                    currentSteps[stepIdx].answer.splice(elIdx, 1);
                    renderStepCards();
                    recompileSummary();
                }
            }

            function updateChoiceOption(stepIdx, optIdx, val) {
                if (currentSteps[stepIdx] && currentSteps[stepIdx].options) {
                    const wasAns = (currentSteps[stepIdx].answer === currentSteps[stepIdx].options[optIdx]);
                    currentSteps[stepIdx].options[optIdx] = val;
                    if (wasAns) currentSteps[stepIdx].answer = val;
                    recompileSummary();
                }
            }

            function addChoiceOption(stepIdx) {
                if (currentSteps[stepIdx]) {
                    if (!currentSteps[stepIdx].options) currentSteps[stepIdx].options = [];
                    currentSteps[stepIdx].options.push('New Choice');
                    renderStepCards();
                    recompileSummary();
                }
            }

            function removeChoiceOption(stepIdx, optIdx) {
                if (currentSteps[stepIdx] && currentSteps[stepIdx].options) {
                    currentSteps[stepIdx].options.splice(optIdx, 1);
                    renderStepCards();
                    recompileSummary();
                }
            }

            // Auto-compile steps into hidden form inputs and live previews
            function recompileSummary() {
                const parts = [];
                let summaryText = `${currentSteps.length} step${currentSteps.length === 1 ? '' : 's'}`;

                currentSteps.forEach(s => {
                    if (s.type === 'pick_seq' || s.type === 'pick_set') {
                        const arr = Array.isArray(s.answer) ? s.answer : [s.answer];
                        if (arr.length > 0) parts.push(arr.join('+'));
                    } else if (s.type === 'dial') {
                        parts.push(`@ ${s.target}${s.unit || ''}`);
                    } else if (s.type === 'choice') {
                        if (s.answer) parts.push(`-> ${s.answer}`);
                    }
                });

                const compiledAnswer = parts.join(' ').trim() || '(Configure steps above)';
                document.getElementById('previewAnswerText').textContent = compiledAnswer;
                document.getElementById('previewStepsSummary').textContent = summaryText;

                // Populate hidden form inputs
                document.getElementById('formAnswerText').value = compiledAnswer;
                document.getElementById('formStepsJson').value = JSON.stringify(currentSteps);
            }

            // ── Author Modal Confirmation & Dirty State Tracking ──
            let authorModalInitialSnapshot = null;

            function getAuthorModalSnapshot() {
                return JSON.stringify({
                    qid: (document.getElementById('formQid')?.value || '').trim(),
                    level: (document.getElementById('formLevel')?.value || '').trim(),
                    prompt: (document.getElementById('formPrompt')?.value || '').trim(),
                    difficulty: (document.getElementById('formDifficulty')?.value || '').trim(),
                    points: (document.getElementById('formPoints')?.value || '').trim(),
                    timeLimit: (document.getElementById('formTimeLimit')?.value || '').trim(),
                    steps: currentSteps
                });
            }

            function isAuthorFormDirty() {
                if (!authorModalInitialSnapshot) return false;
                return getAuthorModalSnapshot() !== authorModalInitialSnapshot;
            }

            function openConfirmModal(id) {
                const modal = document.getElementById(id);
                if (modal) modal.classList.add('open');
            }

            function closeConfirmModal(id) {
                const modal = document.getElementById(id);
                if (modal) modal.classList.remove('open');
            }

            function requestCloseAuthorModal() {
                if (isAuthorFormDirty()) {
                    openConfirmModal('authorDiscardConfirmModal');
                } else {
                    closeAuthorModal();
                }
            }

            function confirmDiscardAuthorChanges() {
                closeConfirmModal('authorDiscardConfirmModal');
                closeAuthorModal();
            }

            // ── Open / Close Authoring Modal ──
            function openAuthorModal() {
                document.getElementById('authorModalTitle').textContent = 'Author Chemistry Challenge';
                document.getElementById('formQid').value = '';
                document.getElementById('formPrompt').value = '';
                document.getElementById('formDifficulty').value = 'Average';
                document.getElementById('formPoints').value = 1;
                document.getElementById('formTimeLimit').value = 90;
                document.getElementById('btnSubmitAuthor').innerHTML = '<i class="fas fa-paper-plane mr-1.5"></i> Submit for Admin Approval';

                // Load blueprint for level 1
                document.getElementById('formLevel').value = 1;
                loadStationPreset();

                authorModalInitialSnapshot = getAuthorModalSnapshot();
                document.getElementById('authorModal').classList.add('open');
            }

            function closeAuthorModal() {
                authorModalInitialSnapshot = null;
                document.getElementById('authorModal').classList.remove('open');
            }

            function openEditModal(qid) {
                const q = QUESTIONS_DATA.find(item => item.question_id === qid);
                if (!q) return;

                document.getElementById('authorModalTitle').textContent = `Edit Challenge #${q.question_code || q.question_id}`;
                document.getElementById('formQid').value = q.question_id;
                document.getElementById('formLevel').value = q.level_number || 1;
                document.getElementById('formPrompt').value = q.prompt || '';
                document.getElementById('formDifficulty').value = q.difficulty || 'Average';
                document.getElementById('formPoints').value = q.points || 1;
                document.getElementById('formTimeLimit').value = q.time_limit_s || 90;
                document.getElementById('btnSubmitAuthor').innerHTML = '<i class="fas fa-save mr-1.5"></i> Update & Resubmit';

                try {
                    currentSteps = typeof q.steps_json === 'string' ? JSON.parse(q.steps_json) : (q.steps_json || []);
                } catch (e) {
                    currentSteps = [];
                }

                renderStepCards();
                recompileSummary();
                authorModalInitialSnapshot = getAuthorModalSnapshot();
                document.getElementById('authorModal').classList.add('open');
            }

            function openReviseModal(qid) {
                openEditModal(qid);
                document.getElementById('authorModalTitle').textContent = `Revise Challenge #${qid} (Admin Feedback)`;
                document.getElementById('btnSubmitAuthor').innerHTML = '<i class="fas fa-wrench mr-1.5"></i> Resubmit Revised Question';
                authorModalInitialSnapshot = getAuthorModalSnapshot();
            }

            // ── Submit Question with Save Confirmation ──
            function requestSubmitQuestion(e) {
                if (e && e.preventDefault) e.preventDefault();
                recompileSummary();

                const prompt = (document.getElementById('formPrompt')?.value || '').trim();
                if (!prompt) {
                    showToast('Please provide a challenge prompt.', 'error');
                    document.getElementById('formPrompt')?.focus();
                    return;
                }
                if (!currentSteps || !currentSteps.length) {
                    showToast('Please add at least one laboratory step.', 'error');
                    return;
                }

                const qid = document.getElementById('formQid')?.value;
                const levelNum = parseInt(document.getElementById('formLevel')?.value, 10) || 1;
                const difficulty = document.getElementById('formDifficulty')?.value || 'Average';
                const points = document.getElementById('formPoints')?.value || 1;
                const timeLimit = document.getElementById('formTimeLimit')?.value || 90;
                const machineInfo = LEVEL_MACHINES[levelNum] || { name: 'Station ' + levelNum, topic: 'Chemistry' };
                const answerText = document.getElementById('formAnswerText')?.value || '';

                // Configure Save Confirmation Modal details
                const titleEl = document.getElementById('authorSaveConfirmTitle');
                const msgEl = document.getElementById('authorSaveConfirmMsg');
                const submitBtnEl = document.getElementById('authorConfirmSubmitBtn');

                if (qid) {
                    if (titleEl) titleEl.textContent = 'Confirm Challenge Update';
                    if (msgEl) msgEl.textContent = 'Are you sure you want to save and update this challenge? Your revised version will be submitted for admin review.';
                    if (submitBtnEl) submitBtnEl.innerHTML = '<i class="fas fa-save text-xs"></i> Confirm &amp; Resubmit';
                } else {
                    if (titleEl) titleEl.textContent = 'Confirm Challenge Submission';
                    if (msgEl) msgEl.textContent = 'Are you sure you want to submit this chemistry challenge for administrator review? Once approved, it will be included in student arcade sessions.';
                    if (submitBtnEl) submitBtnEl.innerHTML = '<i class="fas fa-check text-xs"></i> Confirm &amp; Submit';
                }

                const stationEl = document.getElementById('authorConfirmStation');
                if (stationEl) stationEl.textContent = `Level ${levelNum}: ${machineInfo.name} (${machineInfo.topic})`;

                const promptEl = document.getElementById('authorConfirmPrompt');
                if (promptEl) promptEl.textContent = prompt;

                const stepsEl = document.getElementById('authorConfirmSteps');
                if (stepsEl) stepsEl.textContent = `${currentSteps.length} interactive step${currentSteps.length === 1 ? '' : 's'}`;

                const answerEl = document.getElementById('authorConfirmAnswer');
                if (answerEl) answerEl.textContent = answerText || '(Configured steps)';

                const metaEl = document.getElementById('authorConfirmMeta');
                if (metaEl) metaEl.textContent = `${difficulty} • ${points} pt${points == 1 ? '' : 's'} • ${timeLimit}s limit`;

                openConfirmModal('authorSaveConfirmModal');
            }

            async function confirmSubmitQuestion() {
                closeConfirmModal('authorSaveConfirmModal');
                await doSubmitQuestion();
            }

            // Keep submitQuestion alias for backward compatibility
            function submitQuestion(e) {
                return requestSubmitQuestion(e);
            }

            async function doSubmitQuestion() {
                recompileSummary();

                const qid = document.getElementById('formQid').value;
                const levelNum = parseInt(document.getElementById('formLevel').value, 10);
                const prompt = document.getElementById('formPrompt').value.trim();
                const answerText = document.getElementById('formAnswerText').value.trim();
                const stepsJson = document.getElementById('formStepsJson').value;
                const difficulty = document.getElementById('formDifficulty').value;
                const points = parseInt(document.getElementById('formPoints').value, 10);
                const timeLimit = parseFloat(document.getElementById('formTimeLimit').value);

                if (!prompt) {
                    showToast('Please provide a challenge prompt.', 'error');
                    return;
                }
                if (!currentSteps.length) {
                    showToast('Please add at least one laboratory step.', 'error');
                    return;
                }

                const machineInfo = LEVEL_MACHINES[levelNum] || { name: 'Chemistry Station', id: levelNum, topic: 'Chemistry' };
                const topicId = LEVEL_TOPIC_MAP[levelNum] || null;

                const payload = {
                    level_number: levelNum,
                    topic_id: topicId,
                    machine_name: machineInfo.name,
                    machine_id: levelNum,
                    prompt,
                    answer_text: answerText,
                    steps_json: stepsJson,
                    difficulty,
                    points,
                    time_limit_s: timeLimit
                };

                const url = qid ? `/teacher/api/question/${qid}` : '/teacher/api/question';
                const method = qid ? 'PUT' : 'POST';

                try {
                    const res = await fetch(url, {
                        method,
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(payload)
                    });
                    const data = await res.json();
                    if (data.success) {
                        authorModalInitialSnapshot = null;
                        showToast(qid ? 'Question updated and resubmitted for admin review!' : 'Question submitted for admin review!', 'success');
                        closeAuthorModal();
                        setTimeout(() => location.reload(), 900);
                        await refreshQuestionBankContent();
                    } else {
                        showToast(data.error || 'Failed to save question.', 'error');
                    }
                } catch (err) {
                    showToast('Network error: ' + err.message, 'error');
                }
            }

            // Backdrop click handlers for author modal and confirmation modals
            ['authorModal', 'authorDiscardConfirmModal', 'authorSaveConfirmModal', 'deactivateQuestionConfirmModal'].forEach(id => {
                const modalEl = document.getElementById(id);
                if (modalEl) {
                    modalEl.addEventListener('click', function (e) {
                        if (e.target === this) {
                            if (id === 'authorModal') {
                                requestCloseAuthorModal();
                            } else {
                                closeConfirmModal(id);
                            }
                        }
                    });
                }
            });

            // ── Actions: Delete, Cancel, Link ──
            let pendingDeactivateQid = null;

            function deleteQuestion(qid) {
                pendingDeactivateQid = qid;
                openConfirmModal('deactivateQuestionConfirmModal');
            }

            async function confirmDeactivateQuestion() {
                if (!pendingDeactivateQid) return;
                const qid = pendingDeactivateQid;
                const btn = document.getElementById('confirmDeactivateBtn');
                if (btn) {
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i> Deactivating...';
                }
                try {
                    const res = await fetch(`/teacher/api/question/${qid}`, { method: 'DELETE' });
                    const data = await res.json();
                    if (data.success) {
                        closeConfirmModal('deactivateQuestionConfirmModal');
                        showToast('Question deactivated successfully.', 'success');
                        setTimeout(() => location.reload(), 700);
                        await refreshQuestionBankContent();
                    } else {
                        showToast(data.error || 'Failed to delete question.', 'error');
                    }
                } catch (e) {
                    showToast('Error: ' + e.message, 'error');
                } finally {
                    if (btn) {
                        btn.disabled = false;
                        btn.innerHTML = '<i class="fas fa-trash-can text-xs"></i> Deactivate';
                    }
                    pendingDeactivateQid = null;
                }
            }

            async function cancelSubmission(qid) {
                if (!confirm('Cancel this pending submission and retract it from the admin review queue?')) return;
                try {
                    const res = await fetch(`/teacher/api/question/${qid}/cancel-submission`, { method: 'PATCH' });
                    const data = await res.json();
                    if (data.success) {
                        showToast('Submission cancelled.', 'info');
                        setTimeout(() => location.reload(), 700);
                        await refreshQuestionBankContent();
                    } else {
                        showToast(data.error || 'Failed to cancel submission.', 'error');
                    }
                } catch (e) {
                    showToast('Error: ' + e.message, 'error');
                }
            }

            window.refreshQuestionBankContent = async function () {
                try {
                    const activeSubQueue = ['pending', 'approved', 'rejected'].find(s => {
                        const q = document.getElementById('subqueue-' + s);
                        return q && !q.classList.contains('hidden');
                    }) || 'pending';

                    const res = await fetch(window.location.href, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        cache: 'no-store'
                    });
                    if (!res.ok) return;
                    const html = await res.text();
                    const parser = new DOMParser();
                    const newDoc = parser.parseFromString(html, 'text/html');

                    ['qbankKpiGrid', 'tabNav-status', 'questionsGrid', 'tabContent-status'].forEach(id => {
                        const curEl = document.getElementById(id);
                        const newEl = newDoc.getElementById(id);
                        if (curEl && newEl) {
                            curEl.innerHTML = newEl.innerHTML;
                        }
                    });

                    const syncEl = newDoc.getElementById('qbank-sync-data');
                    if (syncEl) {
                        try {
                            const updatedQuestions = JSON.parse(syncEl.textContent);
                            if (Array.isArray(updatedQuestions)) {
                                QUESTIONS_DATA.splice(0, QUESTIONS_DATA.length, ...updatedQuestions);
                            }
                        } catch (pe) {
                            console.warn('Error parsing qbank-sync-data:', pe);
                        }
                    }

                    if (typeof switchSubQueue === 'function') {
                        switchSubQueue(activeSubQueue);
                    }
                    if (typeof filterQuestions === 'function') {
                        filterQuestions();
                    }
                } catch (err) {
                    console.error('Error refreshing question bank content:', err);
                }
            };

            // ── Link to Assessment Drawer ──
            function openLinkDrawer(qid) {
                document.getElementById('drawerQid').value = qid;
                document.getElementById('linkDrawerBackdrop').classList.remove('hidden');
                document.getElementById('linkDrawer').classList.remove('translate-x-full');
            }

            function closeLinkDrawer() {
                document.getElementById('linkDrawerBackdrop').classList.add('hidden');
                document.getElementById('linkDrawer').classList.add('translate-x-full');
            }

            async function submitLinkAssessment() {
                const qid = document.getElementById('drawerQid').value;
                const asmtId = document.getElementById('drawerAsmtSelect').value;
                if (!asmtId) {
                    showToast('Please select a target assessment.', 'error');
                    return;
                }

                try {
                    const res = await fetch(`/teacher/api/question/${qid}/link-assessment`, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ assessment_id: asmtId })
                    });
                    const data = await res.json();
                    if (data.success) {
                        showToast('Question linked to assessment successfully!', 'success');
                        closeLinkDrawer();
                    } else {
                        showToast(data.error || 'Failed to link assessment.', 'error');
                    }
                } catch (e) {
                    showToast('Error: ' + e.message, 'error');
                }
            }

            // ── Class Telemetry & Accuracy Monitoring ──
            let currentClassTelemetry = { struggling: [], mastered: [] };
            let strugglingPage = 1;
            let masteredPage = 1;
            const TELEMETRY_PAGE_SIZE = 5;
            let deepDiveStudentsList = [];
            let selectedStudentId = null;
            let deepDiveRadarChartInstance = null;

            async function loadClassTelemetry() {
                const select = document.getElementById('telemetryClassSelect');
                if (!select || !select.value) {
                    const emptyNotice = '<tr><td colspan="4" class="py-6 text-center text-slate-400">No class selected.</td></tr>';
                    const sBody = document.getElementById('strugglingTableBody');
                    const mBody = document.getElementById('masteredTableBody');
                    if (sBody) sBody.innerHTML = emptyNotice;
                    if (mBody) mBody.innerHTML = emptyNotice;
                    return;
                }

                const classId = select.value;
                const sBody = document.getElementById('strugglingTableBody');
                const mBody = document.getElementById('masteredTableBody');
                if (sBody) sBody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-slate-400"><i class="fas fa-spinner fa-spin mr-1.5 text-cyan-600"></i> Loading struggling questions…</td></tr>';
                if (mBody) mBody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-slate-400"><i class="fas fa-spinner fa-spin mr-1.5 text-emerald-600"></i> Loading mastered questions…</td></tr>';

                try {
                    const res = await fetch(`/teacher/api/telemetry/class/${classId}`);
                    const data = await res.json();
                    if (!data.success) {
                        showToast(data.error || 'Failed to fetch class telemetry', 'error');
                        return;
                    }

                    // Update Class KPI Metric Bar
                    const stats = data.stats || {};
                    const elEnrolled = document.getElementById('classStatEnrolled');
                    const elActive = document.getElementById('classStatActive');
                    const elAccuracy = document.getElementById('classStatAccuracy');
                    const elAttempts = document.getElementById('classStatAttempts');

                    if (elEnrolled) elEnrolled.textContent = stats.total_enrolled || 0;
                    if (elActive) elActive.textContent = stats.active_students || 0;
                    if (elAccuracy) elAccuracy.textContent = (stats.class_accuracy !== null && stats.class_accuracy !== undefined) ? stats.class_accuracy + '%' : '0%';
                    if (elAttempts) elAttempts.textContent = stats.total_attempts || 0;

                    currentClassTelemetry.struggling = data.struggling || [];
                    currentClassTelemetry.mastered = data.mastered || [];

                    const elStrugglingCount = document.getElementById('strugglingCountBadge');
                    const elMasteredCount = document.getElementById('masteredCountBadge');
                    if (elStrugglingCount) elStrugglingCount.textContent = `${currentClassTelemetry.struggling.length} Questions`;
                    if (elMasteredCount) elMasteredCount.textContent = `${currentClassTelemetry.mastered.length} Questions`;

                    strugglingPage = 1;
                    masteredPage = 1;

                    renderStrugglingTable();
                    renderMasteredTable();
                } catch (e) {
                    console.error('Error fetching class telemetry:', e);
                    if (sBody) sBody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-rose-500">Error loading struggling questions.</td></tr>';
                    if (mBody) mBody.innerHTML = '<tr><td colspan="4" class="py-6 text-center text-rose-500">Error loading mastered questions.</td></tr>';
                }
            }

            function renderStrugglingTable() {
                const tbody = document.getElementById('strugglingTableBody');
                if (!tbody) return;
                const list = currentClassTelemetry.struggling;
                const total = list.length;
                const totalPages = Math.ceil(total / TELEMETRY_PAGE_SIZE) || 1;

                if (strugglingPage > totalPages) strugglingPage = totalPages;
                if (strugglingPage < 1) strugglingPage = 1;

                const infoEl = document.getElementById('strugglingPageInfo');
                const prevBtn = document.getElementById('btnStrugglingPrev');
                const nextBtn = document.getElementById('btnStrugglingNext');

                if (infoEl) infoEl.textContent = `Page ${strugglingPage} of ${totalPages} (${total} total)`;
                if (prevBtn) prevBtn.disabled = (strugglingPage <= 1);
                if (nextBtn) nextBtn.disabled = (strugglingPage >= totalPages);

                if (!total) {
                    tbody.innerHTML = `<tr><td colspan="6" class="py-8 text-center text-slate-400">
                <i class="fas fa-circle-check text-emerald-400 text-3xl mb-2 block"></i>
                <span class="font-bold text-slate-600 block">No Struggling Questions</span>
                <span class="text-xs text-slate-400">All questions answered in this class had 100% accuracy or no gameplay recorded yet.</span>
            </td></tr>`;
                    return;
                }

                const start = (strugglingPage - 1) * TELEMETRY_PAGE_SIZE;
                const pageItems = list.slice(start, start + TELEMETRY_PAGE_SIZE);

                tbody.innerHTML = pageItems.map(q => {
                    const errRate = q.error_rate_pct !== undefined ? q.error_rate_pct : 0;
                    const badgeClass = errRate >= 50 ? 'bg-rose-100 text-rose-800' : 'bg-amber-100 text-amber-800';
                    const assignedDoc = q.assigned_material_title ? `
                <span class="px-2.5 py-1 rounded-xl text-[11px] font-bold bg-amber-50 text-amber-900 border border-amber-200 inline-flex items-center gap-1.5 shadow-xs" title="${escapeHtml(q.assigned_material_title)}">
                    <i class="fas fa-file-circle-check text-amber-600"></i>
                    <span class="max-w-[130px] truncate">${escapeHtml(q.assigned_material_title)}</span>
                </span>
            ` : `<span class="text-[11px] text-slate-400 italic">None assigned</span>`;

                    const validQId = (q.question_id && !isNaN(parseInt(q.question_id, 10))) ? parseInt(q.question_id, 10) : 0;
                    const rowClick = validQId ? `openAssignRemediationModal(${validQId})` : `showToast('Question record reference is missing for this challenge.', 'warning')`;

                    return `
                <tr onclick="${rowClick}" class="border-b border-slate-50 hover:bg-amber-50/50 transition cursor-pointer group">
                    <td class="py-3 text-xs font-bold text-slate-800">
                        <span class="font-mono text-cyan-700 block">${escapeHtml(q.question_code || 'Q')}</span>
                        <span class="text-[10px] text-slate-400 font-semibold">Level ${q.level_number}: ${escapeHtml(q.machine_name || '')}</span>
                    </td>
                    <td class="py-3 text-xs text-slate-700 max-w-sm">
                        <p class="font-semibold line-clamp-2 group-hover:text-amber-900 transition">${escapeHtml(q.question_prompt || '')}</p>
                        <p class="text-[10px] text-slate-400 font-mono mt-0.5">Answer: <span class="text-slate-600 font-bold">${escapeHtml(q.correct_answer || '')}</span></p>
                    </td>
                    <td class="py-3 text-center">
                        <span class="px-2.5 py-1 rounded-full text-xs font-black bg-rose-50 text-rose-700 border border-rose-100 inline-flex items-center gap-1">
                            <i class="fas fa-user-xmark text-[10px]"></i> ${q.students_failed_count || q.wrong_count || 0} students
                        </span>
                        <span class="text-[10px] text-slate-400 block mt-0.5">(${q.wrong_count || 0} / ${q.total_attempts || 0} attempts)</span>
                    </td>
                    <td class="py-3 text-center">
                        <span class="px-2.5 py-1 rounded-full text-xs font-black ${badgeClass}">
                            ${errRate}% error
                        </span>
                    </td>
                    <td class="py-3 text-center">
                        ${assignedDoc}
                    </td>
                    <td class="py-3 text-right">
                        <button onclick="event.stopPropagation(); ${rowClick}" class="px-3 py-1.5 rounded-xl bg-amber-500 hover:bg-amber-600 text-white font-bold text-xs inline-flex items-center gap-1.5 shadow-sm transition transform hover:-translate-y-0.5 cursor-pointer ml-auto">
                            <i class="fas fa-file-circle-plus"></i>
                            <span>${q.assigned_material_title ? 'Change' : 'Set Doc'}</span>
                        </button>
                    </td>
                </tr>
            `;
                }).join('');
            }

            function prevStrugglingPage() {
                if (strugglingPage > 1) {
                    strugglingPage--;
                    renderStrugglingTable();
                }
            }

            function nextStrugglingPage() {
                const totalPages = Math.ceil(currentClassTelemetry.struggling.length / TELEMETRY_PAGE_SIZE) || 1;
                if (strugglingPage < totalPages) {
                    strugglingPage++;
                    renderStrugglingTable();
                }
            }

            function renderMasteredTable() {
                const tbody = document.getElementById('masteredTableBody');
                if (!tbody) return;
                const list = currentClassTelemetry.mastered;
                const total = list.length;
                const totalPages = Math.ceil(total / TELEMETRY_PAGE_SIZE) || 1;

                if (masteredPage > totalPages) masteredPage = totalPages;
                if (masteredPage < 1) masteredPage = 1;

                const infoEl = document.getElementById('masteredPageInfo');
                const prevBtn = document.getElementById('btnMasteredPrev');
                const nextBtn = document.getElementById('btnMasteredNext');

                if (infoEl) infoEl.textContent = `Page ${masteredPage} of ${totalPages} (${total} total)`;
                if (prevBtn) prevBtn.disabled = (masteredPage <= 1);
                if (nextBtn) nextBtn.disabled = (masteredPage >= totalPages);

                if (!total) {
                    tbody.innerHTML = `<tr><td colspan="4" class="py-8 text-center text-slate-400">
                <i class="fas fa-hourglass-start text-indigo-400 text-3xl mb-2 block"></i>
                <span class="font-bold text-slate-600 block">No Mastered Questions Yet</span>
                <span class="text-xs text-slate-400">Once students answer questions correctly during gameplay, they will be listed here.</span>
            </td></tr>`;
                    return;
                }

                const start = (masteredPage - 1) * TELEMETRY_PAGE_SIZE;
                const pageItems = list.slice(start, start + TELEMETRY_PAGE_SIZE);

                tbody.innerHTML = pageItems.map(q => {
                    const accRate = q.accuracy_pct !== undefined ? q.accuracy_pct : 0;
                    return `
                <tr class="border-b border-slate-50 hover:bg-slate-50/60 transition">
                    <td class="py-3 text-xs font-bold text-slate-800">
                        <span class="font-mono text-cyan-700 block">${escapeHtml(q.question_code || 'Q')}</span>
                        <span class="text-[10px] text-slate-400 font-semibold">Level ${q.level_number}: ${escapeHtml(q.machine_name || '')}</span>
                    </td>
                    <td class="py-3 text-xs text-slate-700 max-w-sm">
                        <p class="font-semibold line-clamp-2">${escapeHtml(q.question_prompt || '')}</p>
                        <p class="text-[10px] text-slate-400 font-mono mt-0.5">Answer: <span class="text-slate-600 font-bold">${escapeHtml(q.correct_answer || '')}</span></p>
                    </td>
                    <td class="py-3 text-center">
                        <span class="px-2.5 py-1 rounded-full text-xs font-black bg-emerald-50 text-emerald-700 border border-emerald-100 inline-flex items-center gap-1">
                            <i class="fas fa-user-check text-[10px]"></i> ${q.students_passed_count || q.correct_count || 0} students
                        </span>
                        <span class="text-[10px] text-slate-400 block mt-0.5">(${q.correct_count || 0} / ${q.total_attempts || 0} attempts)</span>
                    </td>
                    <td class="py-3 text-center">
                        <span class="px-2.5 py-1 rounded-full text-xs font-black bg-emerald-100 text-emerald-800">
                            ${accRate}% accuracy
                        </span>
                    </td>
                </tr>
            `;
                }).join('');
            }

            function prevMasteredPage() {
                if (masteredPage > 1) {
                    masteredPage--;
                    renderMasteredTable();
                }
            }

            function nextMasteredPage() {
                const totalPages = Math.ceil(currentClassTelemetry.mastered.length / TELEMETRY_PAGE_SIZE) || 1;
                if (masteredPage < totalPages) {
                    masteredPage++;
                    renderMasteredTable();
                }
            }

            // ── Deep Dive Modal Functions ──
            async function openClassDeepDive() {
                const select = document.getElementById('telemetryClassSelect');
                if (!select || !select.value) {
                    showToast('Please select a class first.', 'error');
                    return;
                }

                const classId = select.value;
                const className = select.options[select.selectedIndex].text;
                document.getElementById('deepDiveModalTitle').textContent = `${className} — Student Diagnostics & Breakdown`;

                document.getElementById('classDeepDiveModal').classList.add('open');
                document.getElementById('deepDiveEmptyState').classList.remove('hidden');
                document.getElementById('deepDiveActiveContent').classList.add('hidden');
                document.getElementById('deepDiveStudentSearch').value = '';

                const rosterContainer = document.getElementById('deepDiveStudentList');
                rosterContainer.innerHTML = `
            <div class="py-12 text-center text-slate-400 text-xs">
                <i class="fas fa-spinner fa-spin text-xl text-indigo-500 mb-2 block"></i>
                Loading class roster…
            </div>
        `;

                try {
                    const res = await fetch(`/teacher/api/telemetry/class/${classId}/students`);
                    const data = await res.json();
                    if (!data.success) {
                        showToast(data.error || 'Failed to load students roster', 'error');
                        return;
                    }

                    deepDiveStudentsList = data.students || [];
                    renderDeepDiveRoster(deepDiveStudentsList);

                    if (deepDiveStudentsList.length > 0) {
                        selectDeepDiveStudent(deepDiveStudentsList[0].user_id);
                    } else {
                        rosterContainer.innerHTML = `
                    <div class="py-12 text-center text-slate-400 text-xs p-4">
                        <i class="fas fa-users-slash text-2xl text-slate-300 mb-2 block"></i>
                        No students enrolled in this class yet.
                    </div>
                `;
                    }
                } catch (e) {
                    console.error('Error fetching students roster:', e);
                    rosterContainer.innerHTML = '<div class="py-8 text-center text-rose-500 text-xs">Failed to load class roster.</div>';
                }
            }

            function closeClassDeepDive() {
                document.getElementById('classDeepDiveModal').classList.remove('open');
            }

            function filterDeepDiveStudents() {
                const q = (document.getElementById('deepDiveStudentSearch').value || '').toLowerCase().trim();
                const filtered = deepDiveStudentsList.filter(s => {
                    const fullName = `${s.first_name || ''} ${s.last_name || ''}`.toLowerCase();
                    const lrn = String(s.lrn_number || '').toLowerCase();
                    return fullName.includes(q) || lrn.includes(q);
                });
                renderDeepDiveRoster(filtered);
            }

            function renderDeepDiveRoster(students) {
                const rosterContainer = document.getElementById('deepDiveStudentList');
                if (!students.length) {
                    rosterContainer.innerHTML = '<div class="py-8 text-center text-slate-400 text-xs">No matching students found.</div>';
                    return;
                }

                rosterContainer.innerHTML = students.map(s => {
                    const isSelected = s.user_id === selectedStudentId;
                    const accuracy = s.accuracy_pct !== null && s.accuracy_pct !== undefined ? `${s.accuracy_pct}%` : '0%';
                    const initial = (s.first_name ? s.first_name[0] : 'S').toUpperCase();
                    const activeBg = isSelected ? 'bg-indigo-50 border-indigo-300 ring-2 ring-indigo-200' : 'bg-white border-slate-200/80 hover:bg-slate-50';

                    return `
                <div onclick="selectDeepDiveStudent(${s.user_id})" class="p-3 rounded-2xl border cursor-pointer transition ${activeBg} flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5 overflow-hidden">
                        ${s.profile_pic ? `
                            <img src="${escapeHtml(s.profile_pic)}" class="w-9 h-9 rounded-xl object-cover border border-slate-200 flex-shrink-0">
                        ` : `
                            <div class="w-9 h-9 rounded-xl bg-indigo-100 text-indigo-700 font-bold flex items-center justify-center text-xs flex-shrink-0">
                                ${initial}
                            </div>
                        `}
                        <div class="truncate">
                            <h5 class="text-xs font-bold text-slate-800 truncate">${escapeHtml(s.first_name)} ${escapeHtml(s.last_name)}</h5>
                            <p class="text-[10px] text-slate-400 font-mono">LRN: ${escapeHtml(s.lrn_number || 'N/A')}</p>
                        </div>
                    </div>
                    <div class="text-right flex-shrink-0">
                        <span class="text-xs font-black text-indigo-700 block">${s.total_score || 0} pts</span>
                        <span class="text-[10px] font-bold text-emerald-600">${accuracy} acc</span>
                    </div>
                </div>
            `;
                }).join('');
            }

            async function selectDeepDiveStudent(studentId) {
                selectedStudentId = studentId;
                renderDeepDiveRoster(deepDiveStudentsList);

                document.getElementById('deepDiveEmptyState').classList.add('hidden');
                document.getElementById('deepDiveActiveContent').classList.remove('hidden');

                // Reset views with loading state
                document.getElementById('studentDetailName').textContent = 'Loading student profile…';
                document.getElementById('studentDetailLrn').textContent = '—';
                document.getElementById('studentDetailScore').textContent = '—';
                document.getElementById('studentDetailAccuracy').textContent = '—';
                document.getElementById('studentDetailQuestions').textContent = '—';
                document.getElementById('studentAttemptsTableBody').innerHTML = '<tr><td colspan="7" class="py-6 text-center text-slate-400"><i class="fas fa-spinner fa-spin mr-1.5 text-cyan-600"></i> Loading question logs…</td></tr>';

                try {
                    const res = await fetch(`/teacher/api/telemetry/student/${studentId}`);
                    const data = await res.json();
                    if (!data.success) {
                        showToast(data.error || 'Failed to fetch student diagnostic', 'error');
                        return;
                    }

                    const student = data.student;
                    const radar = data.radar || { remembering: 0, understanding: 0, applying: 0, analyzing: 0, precision: 0 };
                    const attempts = data.attempts || [];

                    // 1. Populate Profile Banner
                    document.getElementById('studentDetailName').textContent = `${student.first_name} ${student.last_name}`;
                    document.getElementById('studentDetailLrn').textContent = student.lrn_number || 'N/A';
                    const initial = (student.first_name ? student.first_name[0] : 'S').toUpperCase();
                    document.getElementById('studentDetailAvatar').textContent = initial;

                    const totalScore = attempts.reduce((acc, cur) => acc + (cur.points_awarded || 0), 0);
                    const correctCount = attempts.filter(a => a.is_correct === 1).length;
                    const accuracyPct = attempts.length ? Math.round((correctCount / attempts.length) * 100) : 0;

                    document.getElementById('studentDetailScore').textContent = totalScore;
                    document.getElementById('studentDetailAccuracy').textContent = `${accuracyPct}%`;
                    document.getElementById('studentDetailQuestions').textContent = attempts.length;
                    document.getElementById('studentAttemptsCount').textContent = `${attempts.length} attempts recorded`;

                    // 2. Render Bloom's Taxonomy Radar Chart
                    renderRadarChart(radar);

                    // 3. Update Cognitive Mastery Pillars
                    updateCognitivePillars(radar);

                    // 4. Render Attempts Log Table
                    renderAttemptsTable(attempts);

                } catch (e) {
                    console.error('Error fetching student details:', e);
                    showToast('Failed to load student diagnostic details.', 'error');
                }
            }

            function renderRadarChart(radar) {
                const ctx = document.getElementById('deepDiveRadarChart');
                if (!ctx) return;

                if (deepDiveRadarChartInstance) {
                    deepDiveRadarChartInstance.destroy();
                }

                const dataPoints = [
                    radar.remembering || 0,
                    radar.understanding || 0,
                    radar.applying || 0,
                    radar.analyzing || 0,
                    radar.precision || 0
                ];

                deepDiveRadarChartInstance = new Chart(ctx, {
                    type: 'radar',
                    data: {
                        labels: ['Remembering', 'Understanding', 'Applying', 'Analyzing', 'Lab Precision'],
                        datasets: [{
                            label: 'Mastery Level (%)',
                            data: dataPoints,
                            fill: true,
                            backgroundColor: 'rgba(99, 102, 241, 0.2)',
                            borderColor: 'rgb(79, 70, 229)',
                            pointBackgroundColor: 'rgb(79, 70, 229)',
                            pointBorderColor: '#fff',
                            pointHoverBackgroundColor: '#fff',
                            pointHoverBorderColor: 'rgb(79, 70, 229)',
                            pointRadius: 4,
                            borderWidth: 2
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            r: {
                                angleLines: { color: 'rgba(0, 0, 0, 0.06)' },
                                grid: { color: 'rgba(0, 0, 0, 0.06)' },
                                suggestedMin: 0,
                                suggestedMax: 100,
                                ticks: {
                                    stepSize: 25,
                                    font: { size: 9 },
                                    backdropColor: 'transparent'
                                },
                                pointLabels: {
                                    font: { size: 10, weight: 'bold' },
                                    color: '#334155'
                                }
                            }
                        },
                        plugins: {
                            legend: { display: false }
                        }
                    }
                });
            }

            function updateCognitivePillars(radar) {
                const pillars = [
                    { key: 'Remembering', val: radar.remembering || 0 },
                    { key: 'Understanding', val: radar.understanding || 0 },
                    { key: 'Applying', val: radar.applying || 0 },
                    { key: 'Analyzing', val: radar.analyzing || 0 },
                    { key: 'Precision', val: radar.precision || 0 }
                ];

                pillars.forEach(p => {
                    const valEl = document.getElementById(`pillarVal${p.key}`);
                    const barEl = document.getElementById(`pillarBar${p.key}`);
                    if (valEl) valEl.textContent = `${p.val}%`;
                    if (barEl) barEl.style.width = `${Math.min(100, Math.max(0, p.val))}%`;
                });
            }

            function renderAttemptsTable(attempts) {
                const tbody = document.getElementById('studentAttemptsTableBody');
                if (!tbody) return;
                if (!attempts.length) {
                    tbody.innerHTML = '<tr><td colspan="7" class="py-8 text-center text-slate-400">No arcade questions attempted by this student yet.</td></tr>';
                    return;
                }

                tbody.innerHTML = attempts.map(a => {
                    const isCorrect = a.is_correct === 1;
                    const isTimeout = a.is_timeout === 1;
                    let resultBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-rose-100 text-rose-800">Wrong</span>';
                    if (isCorrect) {
                        resultBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-emerald-100 text-emerald-800"><i class="fas fa-check mr-0.5"></i> Correct</span>';
                    } else if (isTimeout) {
                        resultBadge = '<span class="px-2 py-0.5 rounded-full text-[10px] font-black bg-amber-100 text-amber-800"><i class="fas fa-clock mr-0.5"></i> Timeout</span>';
                    }

                    const timeStr = a.response_time_s ? `${parseFloat(a.response_time_s).toFixed(1)}s` : '—';

                    return `
                <tr class="border-b border-slate-50 hover:bg-slate-50/60 transition">
                    <td class="py-2.5 font-bold text-slate-700">
                        <span class="font-mono text-cyan-700 block">${escapeHtml(a.question_code || 'Q')}</span>
                        <span class="text-[10px] text-slate-400 font-semibold">Lvl ${a.level_number || 1}</span>
                    </td>
                    <td class="py-2.5 text-slate-700 max-w-xs truncate" title="${escapeHtml(a.question_prompt || '')}">
                        ${escapeHtml(a.question_prompt || '—')}
                    </td>
                    <td class="py-2.5 font-mono text-[11px] font-bold ${isCorrect ? 'text-emerald-700' : 'text-rose-700'} max-w-[140px] truncate" title="${escapeHtml(a.player_answer || '')}">
                        ${escapeHtml(a.player_answer || 'None / Timeout')}
                    </td>
                    <td class="py-2.5 font-mono text-[11px] font-bold text-slate-700 max-w-[140px] truncate" title="${escapeHtml(a.correct_answer || '')}">
                        ${escapeHtml(a.correct_answer || '—')}
                    </td>
                    <td class="py-2.5 text-center">${resultBadge}</td>
                    <td class="py-2.5 text-center font-bold ${isCorrect ? 'text-amber-600' : 'text-slate-400'}">
                        +${a.points_awarded || 0}
                    </td>
                    <td class="py-2.5 text-right font-mono text-slate-500">${timeStr}</td>
                </tr>
            `;
                }).join('');
            }

            // ══════════════════════════════════════════════════════════════════════
            // REMEDIATION ASSIGNMENT ENGINE (Struggling Questions Focus Documents)
            // ══════════════════════════════════════════════════════════════════════
            let selectedRemediationMaterialId = null;
            let currentRemediationMaterials = [];

            async function openAssignRemediationModal(questionId) {
                const select = document.getElementById('telemetryClassSelect');
                if (!select || !select.value) {
                    showToast('Please select a class first.', 'error');
                    return;
                }

                const classId = parseInt(select.value, 10);
                const qId = parseInt(questionId, 10);

                if (!qId || isNaN(qId)) {
                    showToast('Question record could not be identified for this challenge.', 'error');
                    return;
                }
                if (!classId || isNaN(classId)) {
                    showToast('Please select a valid class first.', 'error');
                    return;
                }

                const className = select.options[select.selectedIndex].text;

                document.getElementById('remedQuestionId').value = qId;
                document.getElementById('remedClassId').value = classId;
                document.getElementById('remedAdviceText').value = '';
                selectedRemediationMaterialId = null;

                // Open modal and show loading state
                document.getElementById('assignRemediationModal').classList.add('open');
                document.getElementById('remedQuestionCodeBadge').textContent = 'Loading…';
                document.getElementById('remedMachineName').textContent = '';
                document.getElementById('remedQuestionPrompt').textContent = 'Fetching question telemetry…';
                document.getElementById('remedStudentsCountHeader').innerHTML = `<i class="fas fa-spinner fa-spin mr-1 text-amber-600"></i> Loading struggling students in ${className}…`;
                document.getElementById('remedStrugglingStudentsChips').innerHTML = '';
                document.getElementById('remedMaterialsContainer').innerHTML = `
            <div class="py-8 text-center text-slate-400 text-xs">
                <i class="fas fa-spinner fa-spin text-base text-amber-500 mb-1 block"></i>
                Loading uploaded learning materials…
            </div>
        `;

                try {
                    const res = await fetch(`/teacher/api/telemetry/question/${qId}/struggling-students?classId=${classId}`);
                    const data = await res.json();
                    if (!data.success) {
                        showToast(data.error || 'Failed to fetch question telemetry', 'error');
                        closeAssignRemediationModal();
                        return;
                    }

                    const q = data.question;
                    const students = data.students || [];
                    const currentRem = data.current_remediation;
                    currentRemediationMaterials = (data.materials && data.materials.length) ? data.materials : (typeof UPLOADED_MATERIALS !== 'undefined' ? UPLOADED_MATERIALS : []);

                    // 1. Populate Question Details
                    document.getElementById('remedQuestionCodeBadge').textContent = `#${q.question_code || ('Q' + q.question_id)}`;
                    document.getElementById('remedMachineName').textContent = `Level ${q.level_number || 1}: ${q.machine_name || 'Station'}`;
                    document.getElementById('remedQuestionPrompt').textContent = q.prompt || '';

                    // 2. Populate Struggling Students Chips
                    document.getElementById('remedStudentsCountHeader').innerHTML = `
                <i class="fas fa-users-viewfinder mr-1 text-amber-600"></i> 
                ${students.length} student(s) in <span class="text-amber-900">${className}</span> who missed this question:
            `;

                    if (students.length === 0) {
                        document.getElementById('remedStrugglingStudentsChips').innerHTML = `
                    <span class="text-xs text-slate-400 italic">No students recorded with missed attempts in this session.</span>
                `;
                    } else {
                        document.getElementById('remedStrugglingStudentsChips').innerHTML = students.map(s => {
                            const initial = (s.first_name ? s.first_name[0] : 'S').toUpperCase();
                            return `
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-lg bg-white border border-rose-200 text-xs font-bold text-slate-700 shadow-xs">
                            <span class="w-4 h-4 rounded-full bg-rose-100 text-rose-700 text-[10px] flex items-center justify-center font-black">${initial}</span>
                            <span>${escapeHtml(s.first_name)} ${escapeHtml(s.last_name)}</span>
                            <span class="text-[10px] text-rose-600 font-extrabold">(${s.wrong_count}x)</span>
                        </span>
                    `;
                        }).join('');
                    }

                    // 3. Populate Topic Filter Dropdown
                    const topicsSet = new Set();
                    currentRemediationMaterials.forEach(m => {
                        if (m.topic_name) topicsSet.add(m.topic_name);
                    });

                    const topicFilterSelect = document.getElementById('remedTopicFilter');
                    topicFilterSelect.innerHTML = '<option value="">All Topics</option>' +
                        Array.from(topicsSet).sort().map(t => `<option value="${escapeHtml(t)}">${escapeHtml(t)}</option>`).join('');

                    // Pre-select current remediation if already assigned
                    if (currentRem && currentRem.material_id) {
                        selectedRemediationMaterialId = currentRem.material_id;
                        document.getElementById('remedAdviceText').value = currentRem.advice_text || '';
                    }

                    // 4. Render Materials List
                    filterRemediationMaterialsList();

                } catch (e) {
                    console.error('Error opening remediation modal:', e);
                    showToast('Network error loading question details', 'error');
                    closeAssignRemediationModal();
                }
            }

            function closeAssignRemediationModal() {
                document.getElementById('assignRemediationModal').classList.remove('open');
            }

            function filterRemediationMaterialsList() {
                const topic = document.getElementById('remedTopicFilter').value;
                const query = (document.getElementById('remedDocSearch').value || '').toLowerCase().trim();

                const filtered = currentRemediationMaterials.filter(m => {
                    const matchTopic = !topic || m.topic_name === topic;
                    const matchQuery = !query || (m.title && m.title.toLowerCase().includes(query)) || (m.topic_name && m.topic_name.toLowerCase().includes(query));
                    return matchTopic && matchQuery;
                });

                renderRemediationMaterialsList(filtered);
            }

            function renderRemediationMaterialsList(list) {
                const container = document.getElementById('remedMaterialsContainer');
                if (!list || !list.length) {
                    container.innerHTML = `
                <div class="py-8 text-center text-slate-400 text-xs">
                    <i class="fas fa-folder-open text-2xl text-slate-300 mb-2 block"></i>
                    No uploaded learning materials found matching your filter.
                </div>
            `;
                    return;
                }

                container.innerHTML = list.map(m => {
                    const isSelected = selectedRemediationMaterialId === m.material_id;
                    const cardBg = isSelected
                        ? 'bg-amber-50/80 border-amber-400 ring-2 ring-amber-300'
                        : 'bg-white border-slate-200/90 hover:bg-slate-50';

                    // Distinct file type badge & icon
                    let typeIcon = '<i class="fas fa-file-lines text-slate-500"></i>';
                    const mType = (m.material_type || '').toLowerCase();
                    if (mType.includes('pdf')) {
                        typeIcon = '<i class="fas fa-file-pdf text-rose-500"></i>';
                    } else if (mType.includes('word') || mType.includes('doc')) {
                        typeIcon = '<i class="fas fa-file-word text-blue-500"></i>';
                    } else if (mType.includes('presentation') || mType.includes('ppt')) {
                        typeIcon = '<i class="fas fa-file-powerpoint text-amber-500"></i>';
                    } else if (mType.includes('video')) {
                        typeIcon = '<i class="fas fa-file-video text-purple-500"></i>';
                    } else if (mType.includes('img') || mType.includes('image')) {
                        typeIcon = '<i class="fas fa-file-image text-emerald-500"></i>';
                    } else if (mType.includes('link')) {
                        typeIcon = '<i class="fas fa-link text-cyan-500"></i>';
                    }

                    return `
                <div onclick="selectRemediationMaterial(${m.material_id})" class="p-3 rounded-xl border cursor-pointer transition flex items-center justify-between gap-3 ${cardBg}">
                    <div class="flex items-center gap-3 overflow-hidden">
                        <div class="w-8 h-8 rounded-lg bg-slate-100 flex items-center justify-center text-sm flex-shrink-0">
                            ${typeIcon}
                        </div>
                        <div class="truncate">
                            <h5 class="text-xs font-bold text-slate-800 truncate">${escapeHtml(m.title)}</h5>
                            <span class="text-[10px] font-bold text-slate-400 flex items-center gap-1 mt-0.5">
                                <i class="fas fa-book-bookmark text-[9px] text-amber-600"></i>
                                ${escapeHtml(m.topic_name || 'Chemistry Topic')}
                            </span>
                        </div>
                    </div>

                    <div class="flex items-center flex-shrink-0">
                        <input type="radio" name="remedMaterialRadio" ${isSelected ? 'checked' : ''} class="w-4 h-4 text-amber-600 focus:ring-amber-500 border-slate-300 pointer-events-none">
                    </div>
                </div>
            `;
                }).join('');
            }

            function selectRemediationMaterial(materialId) {
                selectedRemediationMaterialId = materialId;
                filterRemediationMaterialsList();
            }

            async function submitRemediationAssignment(e) {
                e.preventDefault();

                const questionId = document.getElementById('remedQuestionId').value;
                const classId = document.getElementById('remedClassId').value;
                const adviceText = document.getElementById('remedAdviceText').value.trim();

                if (!selectedRemediationMaterialId) {
                    showToast('Please select an uploaded document from the list above.', 'error');
                    return;
                }

                const submitBtn = document.getElementById('btnSubmitRemediation');
                const origBtnText = submitBtn.innerHTML;
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<i class="fas fa-spinner fa-spin mr-1.5"></i> Assigning…';

                try {
                    const res = await fetch('/teacher/api/telemetry/assign-remediation', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({
                            class_id: classId,
                            question_id: questionId,
                            material_id: selectedRemediationMaterialId,
                            advice_text: adviceText
                        })
                    });

                    const data = await res.json();
                    if (data.success) {
                        showToast(`Assigned "${data.material_title}" to ${data.student_count} student(s) in ${data.class_name}!`, 'success');
                        closeAssignRemediationModal();
                        loadClassTelemetry(); // Refresh struggling questions table
                    } else {
                        showToast(data.error || 'Failed to assign remediation document', 'error');
                    }
                } catch (err) {
                    console.error('Error assigning remediation:', err);
                    showToast('Network error while assigning document', 'error');
                } finally {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = origBtnText;
                }
            }

            function escapeHtml(str) {
                if (!str && str !== 0) return '';
                return String(str)
                    .replace(/&/g, '&amp;')
                    .replace(/</g, '&lt;')
                    .replace(/>/g, '&gt;')
                    .replace(/"/g, '&quot;')
                    .replace(/'/g, '&#039;');
            }

            // Auto-open Author Chemistry Challenge modal or deep-linked tab/subqueue from notifications
            window.addEventListener('DOMContentLoaded', function () {
                const urlParams = new URLSearchParams(window.location.search);
                if (urlParams.get('openAuthor') === 'true' || urlParams.get('author') === 'true') {
                    if (typeof openAuthorModal === 'function') {
                        openAuthorModal();
                    }
                }

                const tab = (urlParams.get('tab') || '').toLowerCase().trim();
                const sub = (urlParams.get('sub') || '').toLowerCase().trim();
                const qId = urlParams.get('q') || urlParams.get('questionId');

                if (['repo', 'status', 'telemetry'].includes(tab) && typeof switchMainTab === 'function') {
                    switchMainTab(tab);
                }
                if (['pending', 'approved', 'rejected'].includes(sub)) {
                    if (typeof switchMainTab === 'function') switchMainTab('status');
                    if (typeof switchSubQueue === 'function') switchSubQueue(sub);
                }
                if (qId) {
                    setTimeout(() => {
                        const qEl = document.querySelector(`[data-qid="${qId}"]`) || document.getElementById(`q-row-${qId}`);
                        if (qEl) {
                            qEl.scrollIntoView({ behavior: 'smooth', block: 'center' });
                            qEl.classList.add('ring-2', 'ring-cyan-500');
                            setTimeout(() => qEl.classList.remove('ring-2', 'ring-cyan-500'), 4000);
                        }
                    }, 200);
                }
            });
        </script>
</body>

</html>