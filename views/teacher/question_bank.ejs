                    </div>
                </div>
            </div>
            <div
                class="px-6 py-4 bg-slate-50 border-t border-slate-100 rounded-b-3xl flex items-center justify-end gap-2.5">
                <button type="button" onclick="closeConfirmModal('authorSaveConfirmModal')"
                    class="px-4 py-2 rounded-xl border border-slate-200 text-slate-600 font-bold text-xs hover:bg-white cursor-pointer">
                    Keep Editing
                </button>
                <button type="button" id="authorConfirmSubmitBtn" onclick="confirmSubmitQuestion()"
                    class="px-5 py-2 rounded-xl bg-gradient-to-r from-cyan-600 to-indigo-600 hover:from-cyan-500 hover:to-indigo-500 text-white font-extrabold text-xs shadow-md shadow-cyan-200 cursor-pointer flex items-center gap-1.5">
                    <i class="fas fa-check text-xs"></i> Confirm &amp; Submit
                </button>
            </div>
        </div>
    </div>

