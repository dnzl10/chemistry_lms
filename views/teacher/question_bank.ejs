                <button type="button" onclick="closeConfirmModal('authorSaveConfirmModal')"
                    class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 transition cursor-pointer">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>
            <div class="p-6 space-y-3">
                <p class="text-xs text-slate-600 leading-relaxed" id="authorSaveConfirmMsg">
