<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= user.first_name %> <%= user.last_name %> · Profile | Elementa</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        * { box-sizing: border-box; }
        body { font-family: 'Plus Jakarta Sans', sans-serif; background: #f5f6fa; }

        ::-webkit-scrollbar { width: 5px; height: 5px; }
        ::-webkit-scrollbar-track { background: transparent; }
        ::-webkit-scrollbar-thumb { background: #dde1ec; border-radius: 10px; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        .nav-active {
            background: linear-gradient(135deg, #06b6d4 0%, #6366f1 100%) !important;
            color: white !important; font-weight: 700;
            box-shadow: 0 4px 16px rgba(6,182,212,.3), 0 2px 8px rgba(99,102,241,.4);
        }
        .nav-active i { color: white !important; }

        /* ── Profile shell ── */
        .profile-shell {
            background: white;
            border-radius: 24px;
            box-shadow: 0 2px 24px rgba(15,23,42,.07), 0 0 0 1px rgba(226,232,240,.8);
            overflow: hidden;
            display: flex;
            min-height: calc(100vh - 160px);
        }

        /* ── Left inner nav ── */
        .profile-left {
            width: 220px; flex-shrink: 0;
            border-right: 1px solid #f1f5f9;
            padding: 28px 0;
            display: flex; flex-direction: column; gap: 4px;
        }
        .profile-left-section-label {
            font-size: 9px; font-weight: 800; color: #94a3b8;
            text-transform: uppercase; letter-spacing: .12em;
            padding: 12px 20px 6px;
        }
        .profile-nav-item {
            display: flex; align-items: center; gap: 10px;
            padding: 9px 20px; font-size: 13px; font-weight: 600;
            color: #64748b; cursor: pointer; border-radius: 0;
            transition: all .15s; position: relative;
            border: none; background: none; width: 100%; text-align: left;
        }
        .profile-nav-item:hover { background: #f8fafc; color: #334155; }
        .profile-nav-item.active { background: #eff6ff; color: #3b82f6; font-weight: 700; }
        .profile-nav-item.active::before {
            content: ''; position: absolute; left: 0; top: 0; bottom: 0;
            width: 3px; background: #3b82f6; border-radius: 0 3px 3px 0;
        }

        /* ── Right panel ── */
        .profile-right { flex: 1; min-width: 0; display: flex; flex-direction: column; }

        .profile-topbar {
            display: flex; align-items: center; justify-content: space-between;
            padding: 18px 28px 14px; border-bottom: 1px solid #f1f5f9;
            position: sticky; top: 0; background: white; z-index: 10;
        }
        .profile-topbar-title { display: flex; align-items: center; gap: 10px; }
        .profile-topbar-title h2 { font-size: 20px; font-weight: 800; color: #0f172a; }
        .profile-topbar-title span { font-size: 20px; }
        .profile-topbar-actions { display: flex; align-items: center; gap: 10px; }

        .btn-primary {
            background: #3b82f6; color: white; border: none;
            border-radius: 10px; padding: 8px 20px;
            font-size: 13px; font-weight: 700; cursor: pointer;
            transition: background .15s, transform .1s;
            font-family: 'Plus Jakarta Sans', sans-serif;
            display: inline-flex; align-items: center; gap: 6px;
        }
        .btn-primary:hover { background: #2563eb; transform: translateY(-1px); }
        .btn-outline {
            background: white; color: #64748b;
            border: 1.5px solid #e2e8f0; border-radius: 10px;
            padding: 8px 16px; font-size: 13px; font-weight: 700;
            cursor: pointer; transition: all .15s;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }
        .btn-outline:hover { border-color: #3b82f6; color: #3b82f6; }

        .icon-btn {
            width: 36px; height: 36px; border-radius: 10px;
            display: flex; align-items: center; justify-content: center;
            border: 1.5px solid #e2e8f0; background: white; color: #64748b;
            cursor: pointer; transition: all .15s;
        }
        .icon-btn:hover { border-color: #3b82f6; color: #3b82f6; background: #eff6ff; }

        /* ── Content ── */
        .profile-content { padding: 28px; flex: 1; overflow-y: auto; }
        .profile-content::-webkit-scrollbar { width: 4px; }
        .profile-content::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 9999px; }

        .section-view { display: none; }
        .section-view.active { display: block; }

        /* ── Info grid layout ── */
        .info-grid {
            display: grid;
            grid-template-columns: 1fr 210px;
            gap: 28px;
            align-items: start;
        }

        /* ── Form elements ── */
        .form-section-title { font-size: 16px; font-weight: 800; color: #0f172a; margin-bottom: 4px; }
        .form-section-sub { font-size: 12px; color: #94a3b8; margin-bottom: 22px; font-weight: 500; }

        .field-label {
            display: block; font-size: 11px; font-weight: 700; color: #64748b;
            margin-bottom: 5px; text-transform: uppercase; letter-spacing: .06em;
        }
        .field-input {
            width: 100%; background: #f8fafc; border: 1.5px solid #e2e8f0;
            border-radius: 10px; padding: 9px 13px;
            font-size: 13px; font-weight: 600; color: #334155;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: border-color .15s; outline: none;
        }
        .field-input.readonly { cursor: default; color: #475569; }
        .field-input-row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
        .field-group { margin-bottom: 16px; }

        .gender-row { display: flex; gap: 20px; margin-top: 6px; }
        .gender-option { display: flex; align-items: center; gap: 6px; font-size: 13px; font-weight: 600; color: #475569; }
        .gender-radio {
            width: 16px; height: 16px; border: 2px solid #cbd5e1; border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            transition: border-color .15s; flex-shrink: 0;
        }
        .gender-radio.selected { border-color: #3b82f6; }
        .gender-radio.selected::after { content: ''; width: 8px; height: 8px; border-radius: 50%; background: #3b82f6; }

        /* ── Photo section ── */
        .photo-section { text-align: center; }
        .photo-section-label { font-size: 11px; font-weight: 700; color: #64748b; text-transform: uppercase; letter-spacing: .06em; margin-bottom: 12px; display: block; }
        .profile-photo-wrap { position: relative; display: inline-block; margin-bottom: 16px; }
        .profile-photo-wrap img {
            width: 96px; height: 96px; border-radius: 50%;
            object-fit: cover; border: 3px solid #e0e7ff;
            box-shadow: 0 4px 20px rgba(99,102,241,.2);
        }
        .photo-edit-btn {
            position: absolute; bottom: 2px; right: 2px;
            width: 28px; height: 28px; border-radius: 50%;
            background: #3b82f6; color: white;
            display: flex; align-items: center; justify-content: center;
            font-size: 11px; cursor: pointer;
            box-shadow: 0 2px 8px rgba(59,130,246,.4);
            border: 2px solid white;
        }

        /* ── Classes tab ── */
        .class-card {
            border: 1.5px solid #e2e8f0; border-radius: 14px; padding: 16px 18px;
            display: flex; align-items: center; gap: 14px;
            transition: border-color .15s, box-shadow .15s; cursor: pointer;
            text-decoration: none;
        }
        .class-card:hover { border-color: #93c5fd; box-shadow: 0 2px 12px rgba(59,130,246,.1); }
        .class-icon {
            width: 42px; height: 42px; border-radius: 12px;
            display: flex; align-items: center; justify-content: center;
            font-size: 18px; flex-shrink: 0;
        }

        /* ── Stat pill ── */
        .stat-pill {
            display: flex; align-items: center; gap: 8px;
            background: #f8fafc; border: 1.5px solid #e2e8f0;
            border-radius: 12px; padding: 10px 16px; flex: 1;
        }
        .stat-pill-icon {
            width: 34px; height: 34px; border-radius: 9px;
            display: flex; align-items: center; justify-content: center;
            font-size: 14px; flex-shrink: 0;
        }
        .stat-pill-val { font-size: 18px; font-weight: 800; color: #0f172a; line-height: 1; }
        .stat-pill-label { font-size: 10px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .06em; }

        /* ── Profile dropdown ── */
        .profile-dropdown {
            position: absolute; top: calc(100% + 10px); right: 0; width: 210px;
            background: white; border-radius: 1rem;
            box-shadow: 0 8px 32px rgba(6,182,212,.13), 0 2px 8px rgba(99,102,241,.10);
            border: 1px solid #e0f2fe; z-index: 999;
            opacity: 0; transform: translateY(-6px) scale(0.97);
            pointer-events: none; transition: opacity .18s ease, transform .18s ease;
        }
        .profile-dropdown.open { opacity: 1; transform: translateY(0) scale(1); pointer-events: all; }
        .profile-dropdown-item {
            display: flex; align-items: center; gap: 10px; padding: 10px 16px;
            font-size: 13px; font-weight: 700; color: #1e293b; cursor: pointer;
            transition: background .13s; border-radius: .75rem; text-decoration: none;
        }
        .profile-dropdown-item:hover { background: #f0f9ff; color: #0369a1; }
        .profile-dropdown-item.danger:hover { background: #fff1f2; color: #be123c; }

                /* ── Edit drawer ── */
        #editDrawerBackdrop {
            display: none; position: fixed; inset: 0;
            background: rgba(15,23,42,.45); z-index: 150;
        }
        #editDrawer {
            display: none; position: fixed; top: 0; right: 0;
            width: 100%; max-width: 400px; height: 100%;
            background: white; z-index: 160;
            box-shadow: -8px 0 40px rgba(15,23,42,.12);
            transform: translateX(100%);
            transition: transform .3s cubic-bezier(.4,0,.2,1);
            overflow-y: auto; display: flex; flex-direction: column;
        }

        /* ── Toast ── */
        #profileToast {
            position: fixed; bottom: 24px; right: 24px; z-index: 999;
            background: #1e293b; color: white;
            padding: 10px 18px; border-radius: 12px;
            font-size: 13px; font-weight: 600;
            box-shadow: 0 8px 24px rgba(15,23,42,.2);
            transform: translateY(80px); opacity: 0;
            transition: all .3s ease; pointer-events: none;
            display: flex; align-items: center; gap: 8px;
        }
        #profileToast.show { transform: translateY(0); opacity: 1; }
        #profileToast.success { background: #064e3b; }
        #profileToast.error { background: #7f1d1d; }

        /* ── Success banner ── */
        .success-banner {
            background: #f0fdf4; border: 1.5px solid #bbf7d0;
            border-radius: 12px; padding: 10px 16px;
            display: flex; align-items: center; gap: 10px;
            font-size: 13px; font-weight: 700; color: #15803d;
            margin-bottom: 20px;
            animation: slideDown .3s ease;
        }
        @keyframes slideDown { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: translateY(0); } }
    </style>
    <%- include('../partials/teacher-nav-styles') %>
</head>
<body class="text-slate-900">

<div id="profileToast"><i class="fas fa-circle-check"></i> <span id="profileToastMsg"></span></div>

<div class="flex min-h-screen relative overflow-x-hidden">
    <%- include('../partials/teacher-sidebar', { activeNav: 'profile' }) %>

<!-- ═══════════════ MAIN ═══════════════ -->
<main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 transition-all duration-300">

    <!-- ── TOP HEADER ── -->
    <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
        <div class="flex items-center gap-4">
            <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                <i class="fas fa-bars text-xl"></i>
            </button>
            <div class="hidden sm:block">
                <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">My Profile</h1>
                <p class="text-xs text-slate-600 font-medium">
                    <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                    Teacher Portal &nbsp;·&nbsp; <%= new Date().toLocaleDateString('en-PH', {weekday:'long', year:'numeric', month:'long', day:'numeric'}) %>
                </p>
            </div>
        </div>

        <div class="flex items-center gap-3 md:gap-6">
                    <!-- Messages Navigation Button (Entry point to teacher messages workspace) -->
                    <a href="/teacher/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                        <i class="far fa-comment-dots text-xl"></i>
                        
                        <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                            <span class="msg-badge-count">0</span>
                        </span>

                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Messages
                        </span>
                    </a>

            <!-- Notification Button with keyboard-accessible tooltip -->
            <button type="button" onclick="toggleNotifPanel()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                <i class="far fa-bell text-xl text-slate-700"></i>
                <% const _unreadNotifCount = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications.filter(n => !n.is_read).length : 0; %>
                <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center notif-badge <%= _unreadNotifCount > 0 ? '' : 'hidden' %>" aria-hidden="true">
                    <span class="notif-badge-count"><%= _unreadNotifCount > 99 ? '99+' : _unreadNotifCount %></span>
                </span>
                <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                    Notifications
                </span>
            </button>

            <!-- User Profile Dropdown -->
            <div class="relative">
                <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                    <div class="text-right hidden lg:block">
                        <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                        <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none"><%= user.role || 'Teacher' %></p>
                    </div>
                    <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100" onerror="this.src='/profile_uploads/default_avatar.png'">
                    <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                </button>

                <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                    <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                        <p class="text-sm font-bold text-slate-800"><%= user.first_name %> <%= user.last_name %></p>
                        <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role || 'Teacher' %></p>
                    </div>
                    <a href="/teacher/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                        <i class="far fa-user w-5 text-center"></i> View Profile
                    </a>
                    <hr class="my-2 border-slate-100">
                    <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                        <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- ── SCROLL AREA ── -->
    <div class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
        <div class="p-4 md:p-6 flex-1 flex flex-col gap-4">

            <!-- ═══ PROFILE SHELL ═══ -->
            <div class="profile-shell">

                <!-- ── Left inner nav ── -->
                <div class="profile-left">
                    <div class="px-5 pb-4 mb-1">
                        <div class="flex items-center gap-3">
                            <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                                 class="w-10 h-10 rounded-xl object-cover ring-2 ring-cyan-200"
                                 onerror="this.src='/profile_uploads/default_avatar.png'">
                            <div>
                                <p class="text-sm font-black text-slate-800 leading-tight truncate" style="max-width:130px">
                                    <%= user.first_name %> <%= user.last_name %>
                                </p>
                                <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Teacher</p>
                            </div>
                        </div>
                    </div>

                    <div class="w-full h-px bg-slate-100 mb-3"></div>

                    <span class="profile-left-section-label">Overview</span>
                    <button class="profile-nav-item active" id="navInfo" onclick="switchSection('info', this)">
                        <i class="fas fa-address-card w-4 text-blue-400 text-sm"></i> Information
                    </button>
                    <button class="profile-nav-item" id="navClasses" onclick="switchSection('classes', this)">
                        <i class="fas fa-chalkboard-user w-4 text-amber-400 text-sm"></i> My Classes
                    </button>

                    <span class="profile-left-section-label" style="margin-top:8px;">Actions</span>
                    <button class="profile-nav-item" onclick="toggleEditDrawer()">
                        <i class="fas fa-pen-nib w-4 text-indigo-400 text-sm"></i> Edit Profile
                    </button>
                    <a href="/logout" class="profile-nav-item" style="color:#ef4444;">
                        <i class="fas fa-right-from-bracket w-4 text-sm"></i> Log Out
                    </a>
                </div>

                <!-- ── Right panel ── -->
                <div class="profile-right">

                    <!-- Top bar -->
                    <div class="profile-topbar">
                        <div class="profile-topbar-title">
                            <button onclick="history.back()" class="icon-btn mr-1">
                                <i class="fas fa-arrow-left text-xs"></i>
                            </button>
                            <h2 id="sectionHeading">Information</h2>
                            <span id="sectionEmoji">🪪</span>
                            <% if (typeof currentSY !== 'undefined' && currentSY && currentSY.sy_range) { %>
                                <span style="margin-left:8px;padding:3px 10px;border-radius:999px;background:#ecfdf5;border:1px solid #a7f3d0;color:#047857;font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;">
                                    S.Y. <%= currentSY.sy_range %> &middot; Active
                                </span>
                            <% } else { %>
                                <span style="margin-left:8px;padding:3px 10px;border-radius:999px;background:#fff1f2;border:1px solid #fecdd3;color:#be123c;font-size:10px;font-weight:800;letter-spacing:.04em;text-transform:uppercase;">
                                    No Active S.Y.
                                </span>
                            <% } %>
                        </div>
                        <div class="profile-topbar-actions">
                            <button class="btn-primary" onclick="toggleEditDrawer()">
                                <i class="fas fa-pen-nib text-xs"></i> Edit Profile
                            </button>
                        </div>
                    </div>

                    <!-- ════ INFORMATION SECTION ════ -->
                    <div class="profile-content section-view active" id="section-info">

                        <% if (updated) { %>
                        <div class="success-banner">
                            <i class="fas fa-circle-check text-emerald-500"></i>
                            Profile updated successfully!
                        </div>
                        <% } %>

                        <!-- Quick stat pills -->
                        <div style="display:flex;gap:10px;margin-bottom:24px;flex-wrap:wrap;">
                            <div class="stat-pill">
                                <div class="stat-pill-icon" style="background:#eff6ff;">
                                    <i class="fas fa-chalkboard-user" style="color:#3b82f6;"></i>
                                </div>
                                <div>
                                    <div class="stat-pill-val"><%= user.faculty_id || '—' %></div>
                                    <div class="stat-pill-label">Faculty ID</div>
                                </div>
                            </div>
                            <div class="stat-pill">
                                <div class="stat-pill-icon" style="background:#f0fdf4;">
                                    <i class="fas fa-building" style="color:#10b981;"></i>
                                </div>
                                <div>
                                    <div class="stat-pill-val" style="font-size:13px;"><%= user.department || '—' %></div>
                                    <div class="stat-pill-label">Department</div>
                                </div>
                            </div>
                            <div class="stat-pill">
                                <div class="stat-pill-icon" style="background:#fdf4ff;">
                                    <i class="fas fa-calendar-check" style="color:#9333ea;"></i>
                                </div>
                                <div>
                                    <div class="stat-pill-val" style="font-size:13px;">
                                        <%= new Date(user.created_at).toLocaleDateString('en-PH', {month:'short', day:'numeric', year:'numeric'}) %>
                                    </div>
                                    <div class="stat-pill-label">Joined</div>
                                </div>
                            </div>
                        </div>

                        <div class="info-grid">
                            <!-- LEFT: form fields -->
                            <div>
                                <p class="form-section-title">Personal Details</p>
                                <p class="form-section-sub">Basic identity and contact information on record.</p>

                                <!-- Full name row -->
                                <div class="field-group">
                                    <label class="field-label">Full Name</label>
                                    <div class="field-input-row">
                                        <input class="field-input readonly" readonly
                                               value="<%= user.first_name || '—' %>" placeholder="First Name">
                                        <input class="field-input readonly" readonly
                                               value="<%= user.last_name || '—' %>" placeholder="Last Name">
                                    </div>
                                </div>

                                <!-- Middle name + suffix -->
                                <div class="field-group">
                                    <div class="field-input-row">
                                        <div>
                                            <label class="field-label">Middle Name</label>
                                            <input class="field-input readonly" readonly
                                                   value="<%= user.middle_name || '—' %>">
                                        </div>
                                        <div>
                                            <label class="field-label">Suffix</label>
                                            <input class="field-input readonly" readonly
                                                   value="<%= user.suffix || '—' %>">
                                        </div>
                                    </div>
                                </div>

                                <!-- Email -->
                                <div class="field-group">
                                    <label class="field-label">Email Address</label>
                                    <input class="field-input readonly" readonly value="<%= user.email || '—' %>">
                                </div>

                                <!-- Faculty ID + Department -->
                                <div class="field-group">
                                    <div class="field-input-row">
                                        <div>
                                            <label class="field-label">Faculty ID</label>
                                            <input class="field-input readonly" readonly
                                                   value="<%= user.faculty_id || '—' %>">
                                        </div>
                                        <div>
                                            <label class="field-label">Department</label>
                                            <input class="field-input readonly" readonly
                                                   value="<%= user.department || '—' %>">
                                        </div>
                                    </div>
                                </div>

                                <!-- Sex -->
                                <div class="field-group">
                                    <label class="field-label">Sex</label>
                                    <div class="gender-row">
                                        <% const sexVal = (user.sex || '').toLowerCase(); %>
                                        <div class="gender-option">
                                            <div class="gender-radio <%= sexVal === 'male' ? 'selected' : '' %>"></div>
                                            <span>Male</span>
                                        </div>
                                        <div class="gender-option">
                                            <div class="gender-radio <%= sexVal === 'female' ? 'selected' : '' %>"></div>
                                            <span>Female</span>
                                        </div>
                                    </div>
                                </div>

                                <!-- Birthdate -->
                                <div class="field-group">
                                    <label class="field-label">Date of Birth</label>
                                    <input class="field-input readonly" readonly
                                           value="<%= user.birthdate ? new Date(user.birthdate).toLocaleDateString('en-PH', {year:'numeric', month:'long', day:'numeric'}) : '—' %>">
                                </div>

                                <!-- Mobile -->
                                <div class="field-group">
                                    <label class="field-label">Mobile Number</label>
                                    <input class="field-input readonly" readonly
                                           value="<%= user.mobile_number || '—' %>">
                                </div>

                                <!-- City / Town -->
                                <div class="field-group">
                                    <label class="field-label">City / Town</label>
                                    <input class="field-input readonly" readonly
                                           value="<%= user.city_town || '—' %>">
                                </div>

                                <!-- Home address -->
                                <div class="field-group">
                                    <label class="field-label">Home Address</label>
                                    <input class="field-input readonly" readonly
                                           value="<%= user.home_address || '—' %>">
                                </div>

                                <!-- Campus -->
                                <div class="field-group">
                                    <label class="field-label">Institution</label>
                                    <input class="field-input readonly" readonly value="Mabini Colleges, Inc.">
                                </div>

                                <!-- Bio -->
                                <div class="field-group">
                                    <label class="field-label">About / Self Description</label>
                                    <div class="field-input readonly" style="min-height:72px;line-height:1.6;font-size:13px;color:#475569;">
                                        <%= user.self_description || 'No description set yet.' %>
                                    </div>
                                </div>

                            </div><!-- /left fields -->

                            <!-- RIGHT: photo + quick actions -->
                            <div style="display:flex;flex-direction:column;gap:20px;position:sticky;top:0;">

                                <div class="photo-section">
                                    <span class="photo-section-label">Profile Photo</span>
                                    <div class="profile-photo-wrap">
                                        <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                                             onerror="this.src='/profile_uploads/default_avatar.png'"
                                             alt="<%= user.first_name %>">
                                        <button onclick="toggleEditDrawer()" class="photo-edit-btn" style="border:none;cursor:pointer;">
                                            <i class="fas fa-pen"></i>
                                        </button>
                                    </div>
                                    <p class="text-xs font-bold text-slate-700 mt-1"><%= user.first_name %> <%= user.last_name %></p>
                                    <p class="text-[11px] text-slate-400">Instructor · Teacher Portal</p>
                                    <div style="display:flex;align-items:center;justify-content:center;gap:5px;margin-top:6px;">
                                        <span style="width:7px;height:7px;border-radius:50%;background:#22c55e;display:inline-block;"></span>
                                        <span style="font-size:10px;font-weight:700;color:#22c55e;">Online</span>
                                    </div>
                                </div>

                                <!-- Quick action buttons -->
                                <div style="display:flex;flex-direction:column;gap:6px;">
                                    <button onclick="toggleEditDrawer()" class="btn-primary" style="width:100%;justify-content:center;">
                                        <i class="fas fa-pen-nib text-xs"></i> Edit Profile
                                    </button>
                                    <a href="/teacher/classes" class="btn-primary" style="width:100%;justify-content:center;background:#0d9488;text-decoration:none;">
                                        <i class="fas fa-chalkboard-user text-xs"></i> My Classes
                                    </a>
                                    <a href="/teacher/reports" class="btn-primary" style="width:100%;justify-content:center;background:#7c3aed;text-decoration:none;">
                                        <i class="fas fa-chart-bar text-xs"></i> Reports
                                    </a>
                                </div>

                                <!-- Identity card -->
                                <div style="background:#0f172a;border-radius:16px;padding:18px;text-align:center;">
                                    <p style="font-size:9px;font-weight:800;color:#94a3b8;text-transform:uppercase;letter-spacing:.1em;margin-bottom:8px;">Faculty Record</p>
                                    <p style="font-size:11px;font-weight:700;color:#93c5fd;">Faculty ID</p>
                                    <code style="color:#67e8f9;font-size:12px;font-family:monospace;display:block;word-break:break-all;margin-top:2px;"><%= user.faculty_id || '—' %></code>
                                    <div style="height:1px;background:rgba(255,255,255,.08);margin:12px 0;"></div>
                                    <p style="font-size:9px;font-weight:700;color:#64748b;margin-bottom:2px;">Email on file</p>
                                    <p style="font-size:10px;font-weight:600;color:#7dd3fc;word-break:break-all;"><%= user.email %></p>
                                </div>

                            </div><!-- /right col -->
                        </div><!-- /info-grid -->
                    </div><!-- /section-info -->

                    <!-- ════ MY CLASSES SECTION ════ -->
                    <div class="profile-content section-view" id="section-classes">
                        <p class="form-section-title">My Classes</p>
                        <p class="form-section-sub">All classes you are currently handling this school year.</p>

                        <div id="classesContainer" style="display:flex;flex-direction:column;gap:10px;">
                            <div style="text-align:center;padding:40px;color:#94a3b8;font-size:13px;">
                                <i class="fas fa-spinner fa-spin" style="font-size:20px;margin-bottom:8px;display:block;"></i>
                                Loading classes…
                            </div>
                        </div>
                    </div><!-- /section-classes -->

                </div><!-- /profile-right -->
            </div><!-- /profile-shell -->

            <!-- Footer -->
            <footer class="mt-2 py-6 border-t border-slate-100 bg-white/80 backdrop-blur-md rounded-2xl px-6">
                <div class="flex flex-col md:flex-row justify-between items-center gap-3">
                    <p class="text-xs text-slate-400 font-bold">&copy; 2026 <span class="text-blue-600">Mabini College</span> · Elementa v2.5.0</p>
                    <div class="flex gap-5">
                        <a href="/privacy" class="text-xs font-bold text-slate-400 hover:text-blue-600 transition">Privacy</a>
                        <a href="/terms" class="text-xs font-bold text-slate-400 hover:text-blue-600 transition">Terms</a>
                        <a href="/support" class="text-xs font-bold text-slate-400 hover:text-blue-600 transition">Support</a>
                    </div>
                </div>
            </footer>

        </div>
    </div>
</main>
</div><!-- /flex wrapper -->

