<!-- ═══════════════════════════════
     EDIT PROFILE DRAWER
═══════════════════════════════ -->
<div id="editDrawerBackdrop" onclick="closeEditDrawer()"></div>
<div id="editDrawer">
    <!-- Drawer header -->
    <div style="display:flex;align-items:center;justify-content:space-between;padding:20px 24px 16px;border-bottom:1px solid #f1f5f9;flex-shrink:0;position:sticky;top:0;background:white;z-index:5;">
        <div>
            <p style="font-size:15px;font-weight:800;color:#0f172a;">Edit Profile</p>
            <p style="font-size:11px;color:#94a3b8;font-weight:500;margin-top:1px;">Update your personal information</p>
        </div>
        <button onclick="closeEditDrawer()" style="width:32px;height:32px;border-radius:9px;border:1.5px solid #e2e8f0;background:white;color:#64748b;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:14px;">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <!-- Photo upload -->
    <div style="padding:20px 24px 0;border-bottom:1px solid #f8fafc;">
        <span style="display:block;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:12px;">Profile Photo</span>
        <div style="display:flex;align-items:center;gap:14px;">
            <img id="editPhotoPreview"
                 src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                 onerror="this.src='/profile_uploads/default_avatar.png'"
                 style="width:64px;height:64px;border-radius:50%;object-fit:cover;border:3px solid #e0e7ff;">
            <div>
                <label for="editPhotoInput"
                       style="display:inline-block;padding:8px 16px;background:#eff6ff;color:#3b82f6;border-radius:9px;font-size:12px;font-weight:700;cursor:pointer;border:1.5px solid #dbeafe;">
                    <i class="fas fa-upload text-xs mr-1"></i> Upload new photo
                </label>
                <input type="file" id="editPhotoInput" accept="image/*" style="display:none;" onchange="previewEditPhoto(this)">
                <p style="font-size:10px;color:#94a3b8;font-weight:500;margin-top:5px;">JPG, PNG, WEBP · max 5MB</p>
            </div>
        </div>
        <div style="height:1px;background:#f1f5f9;margin:16px 0 0;"></div>
    </div>

    <!-- Form fields -->
    <div style="padding:20px 24px;display:flex;flex-direction:column;gap:14px;flex:1;">

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            <div>
                <label style="display:block;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">First Name</label>
                <input type="text" id="edit_first_name" maxlength="100"
                       value="<%= user.first_name || '' %>"
                       style="width:100%;padding:9px 13px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;color:#334155;font-family:'Plus Jakarta Sans',sans-serif;outline:none;transition:border-color .15s;background:white;"
                       onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
            </div>
            <div>
                <label style="display:block;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">Last Name</label>
                <input type="text" id="edit_last_name" maxlength="100"
                       value="<%= user.last_name || '' %>"
                       style="width:100%;padding:9px 13px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;color:#334155;font-family:'Plus Jakarta Sans',sans-serif;outline:none;transition:border-color .15s;background:white;"
                       onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
            </div>
        </div>

        <div style="display:grid;grid-template-columns:1fr 1fr;gap:10px;">
            <div>
                <label style="display:block;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">Middle Name</label>
                <input type="text" id="edit_middle_name" maxlength="100"
                       value="<%= user.middle_name || '' %>"
                       style="width:100%;padding:9px 13px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;color:#334155;font-family:'Plus Jakarta Sans',sans-serif;outline:none;transition:border-color .15s;background:white;"
                       onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
            </div>
            <div>
                <label style="display:block;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">Suffix</label>
                <input type="text" id="edit_suffix" maxlength="20"
                       value="<%= user.suffix || '' %>" placeholder="Jr., Sr., III…"
                       style="width:100%;padding:9px 13px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;color:#334155;font-family:'Plus Jakarta Sans',sans-serif;outline:none;transition:border-color .15s;background:white;"
                       onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
            </div>
        </div>

        <div>
            <label style="display:block;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">Mobile Number</label>
            <input type="tel" id="edit_mobile_number" maxlength="20"
                   value="<%= user.mobile_number || '' %>" placeholder="e.g. 09075375486"
                   style="width:100%;padding:9px 13px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;color:#334155;font-family:'Plus Jakarta Sans',sans-serif;outline:none;transition:border-color .15s;background:white;"
                   onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
        </div>

        <div>
            <label style="display:block;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">City / Town</label>
            <input type="text" id="edit_city_town" maxlength="100"
                   value="<%= user.city_town || '' %>" placeholder="e.g. Labo, Camarines Norte"
                   style="width:100%;padding:9px 13px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;color:#334155;font-family:'Plus Jakarta Sans',sans-serif;outline:none;transition:border-color .15s;background:white;"
                   onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'">
        </div>

        <div>
            <label style="display:block;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">Home Address</label>
            <textarea id="edit_home_address" maxlength="300" rows="2"
                      placeholder="e.g. Purok-3, Bulhao, Labo, Camarines Norte"
                      style="width:100%;padding:9px 13px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;color:#334155;font-family:'Plus Jakarta Sans',sans-serif;outline:none;resize:vertical;transition:border-color .15s;background:white;"
                      onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'"><%= user.home_address || '' %></textarea>
        </div>

        <div>
            <label style="display:block;font-size:11px;font-weight:700;color:#64748b;text-transform:uppercase;letter-spacing:.06em;margin-bottom:5px;">About / Self Description</label>
            <textarea id="edit_self_description" maxlength="500" rows="3"
                      placeholder="Tell your students something about yourself…"
                      style="width:100%;padding:9px 13px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:600;color:#334155;font-family:'Plus Jakarta Sans',sans-serif;outline:none;resize:vertical;transition:border-color .15s;background:white;"
                      onfocus="this.style.borderColor='#3b82f6'" onblur="this.style.borderColor='#e2e8f0'"><%= user.self_description || '' %></textarea>
        </div>

        <!-- Note: email, faculty_id, department, sex, birthdate are read-only (managed by admin) -->
        <div style="background:#fefce8;border:1.5px solid #fde68a;border-radius:10px;padding:10px 14px;font-size:11px;font-weight:600;color:#92400e;display:flex;align-items:flex-start;gap:8px;">
            <i class="fas fa-circle-info" style="margin-top:1px;flex-shrink:0;"></i>
            <span>Email, Faculty ID, Department, Sex, and Birthdate are managed by your administrator and cannot be changed here.</span>
        </div>

        <!-- Save / Cancel -->
        <div style="display:flex;gap:10px;margin-top:4px;">
            <button onclick="closeEditDrawer()"
                    style="flex:1;padding:10px;border:1.5px solid #e2e8f0;border-radius:10px;font-size:13px;font-weight:700;color:#64748b;background:white;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;transition:all .15s;"
                    onmouseover="this.style.borderColor='#6366f1';this.style.color='#6366f1'"
                    onmouseout="this.style.borderColor='#e2e8f0';this.style.color='#64748b'">
                Cancel
            </button>
            <button onclick="saveProfile()" id="editSaveBtn"
                    style="flex:1;padding:10px;border:none;border-radius:10px;font-size:13px;font-weight:700;color:white;background:#3b82f6;cursor:pointer;font-family:'Plus Jakarta Sans',sans-serif;transition:all .15s;display:flex;align-items:center;justify-content:center;gap:6px;"
                    onmouseover="this.style.background='#2563eb'"
                    onmouseout="this.style.background='#3b82f6'">
                <i class="fas fa-save text-xs"></i> Save Changes
            </button>
        </div>

        <div id="editDrawerMsg" style="display:none;margin-top:4px;padding:10px 14px;border-radius:10px;font-size:12px;font-weight:600;text-align:center;"></div>

    </div>
</div>

<!-- ═══════════════════════════════
     SCRIPTS
═══════════════════════════════ -->
<script>
/* ── Toast ── */
function showToast(msg, type = 'success') {
    const el = document.getElementById('profileToast');
    el.querySelector('#profileToastMsg').textContent = msg;
    el.className = 'show ' + type;
    setTimeout(() => { el.className = ''; }, 3200);
}

/* ── Sidebar toggle ── */
function toggleSidebar() {
    const s = document.getElementById('sidebar');
    const o = document.getElementById('sidebarOverlay');
    const hidden = s.classList.contains('-translate-x-full');
    s.classList.toggle('-translate-x-full', !hidden);
    o.classList.toggle('hidden', !hidden);
}

/* ── Profile dropdown ── */
function toggleProfileDropdown() {
    document.getElementById('profileDropdown').classList.toggle('open');
}
document.addEventListener('click', function(e) {
    const wrap = document.getElementById('profileDropdownWrap');
    if (wrap && !wrap.contains(e.target)) {
        document.getElementById('profileDropdown').classList.remove('open');
    }
});

/* ── Section switching ── */
function switchSection(name, btn) {
    document.querySelectorAll('.section-view').forEach(s => s.classList.remove('active'));
    document.getElementById('section-' + name).classList.add('active');
    document.querySelectorAll('.profile-nav-item').forEach(b => b.classList.remove('active'));
    if (btn) btn.classList.add('active');

    const headings = {
        info:    ['Information', '🪪'],
        classes: ['My Classes',  '🏫'],
    };
    const [title, emoji] = headings[name] || ['Profile', '👤'];
    document.getElementById('sectionHeading').textContent = title;
    document.getElementById('sectionEmoji').textContent   = emoji;

    if (name === 'classes') loadClasses();
}

/* ── Load teacher's classes ── */
let classesLoaded = false;
async function loadClasses() {
    if (classesLoaded) return;
    try {
        const res  = await fetch('/teacher/api/class-roster-list');
        const data = await res.json();
        classesLoaded = true;

        const container = document.getElementById('classesContainer');
        if (!data.classes || data.classes.length === 0) {
            container.innerHTML = `
                <div style="text-align:center;padding:48px;color:#94a3b8;">
                    <i class="fas fa-chalkboard" style="font-size:28px;margin-bottom:10px;display:block;"></i>
                    <p style="font-size:13px;font-weight:700;">No classes assigned yet.</p>
                </div>`;
            return;
        }

        const colors = ['#eff6ff', '#f0fdf4', '#fdf4ff', '#fff7ed', '#f0f9ff'];
        const icons  = ['📘', '🧪', '⚗️', '🔬', '📗'];
        container.innerHTML = data.classes.map((c, i) => `
            <a href="/teacher/class/${c.class_id}" class="class-card">
                <div class="class-icon" style="background:${colors[i % colors.length]};">
                    ${icons[i % icons.length]}
                </div>
                <div style="flex:1;min-width:0;">
                    <p style="font-size:14px;font-weight:800;color:#0f172a;margin-bottom:2px;">${c.class_name}</p>
                    <p style="font-size:12px;color:#64748b;font-weight:600;">${c.subject_name || '—'}</p>
                </div>
                <div style="text-align:right;flex-shrink:0;">
                    <p style="font-size:11px;font-weight:700;color:#94a3b8;">${c.student_count ?? 0} students</p>
                    <p style="font-size:10px;color:#cbd5e1;margin-top:2px;">${c.sy_range || ''}</p>
                </div>
                <i class="fas fa-chevron-right" style="color:#cbd5e1;font-size:11px;flex-shrink:0;"></i>
            </a>
        `).join('');

    } catch (err) {
        document.getElementById('classesContainer').innerHTML = `
            <div style="text-align:center;padding:32px;color:#ef4444;font-size:13px;font-weight:600;">
                <i class="fas fa-triangle-exclamation" style="margin-right:6px;"></i> Failed to load classes.
            </div>`;
    }
}

/* ── Edit drawer ── */
function toggleEditDrawer() {
    const drawer   = document.getElementById('editDrawer');
    const backdrop = document.getElementById('editDrawerBackdrop');
    const isOpen   = drawer.style.transform === 'translateX(0%)';
    if (isOpen) {
        closeEditDrawer();
    } else {
        drawer.style.display   = 'flex';
        backdrop.style.display = 'block';
        requestAnimationFrame(() => requestAnimationFrame(() => {
            drawer.style.transform = 'translateX(0%)';
        }));
        document.body.style.overflow = 'hidden';
    }
}
function closeEditDrawer() {
    const drawer   = document.getElementById('editDrawer');
    const backdrop = document.getElementById('editDrawerBackdrop');
    drawer.style.transform = 'translateX(100%)';
    setTimeout(() => {
        drawer.style.display   = 'none';
        backdrop.style.display = 'none';
    }, 300);
    document.body.style.overflow = '';
}

function previewEditPhoto(input) {
    const file = input.files[0];
    if (!file) return;
    if (file.size > 5 * 1024 * 1024) {
        showDrawerMsg('Image must be under 5MB.', 'error');
        input.value = '';
        return;
    }
    const reader = new FileReader();
    reader.onload = e => { document.getElementById('editPhotoPreview').src = e.target.result; };
    reader.readAsDataURL(file);
}

function showDrawerMsg(msg, type) {
    const el = document.getElementById('editDrawerMsg');
    el.style.display    = 'block';
    el.textContent      = msg;
    el.style.background = type === 'error' ? '#fee2e2' : '#dcfce7';
    el.style.color      = type === 'error' ? '#b91c1c' : '#15803d';
}

async function saveProfile() {
    const btn = document.getElementById('editSaveBtn');
    btn.disabled  = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin text-xs"></i> Saving…';
    document.getElementById('editDrawerMsg').style.display = 'none';

    try {
        const fd = new FormData();
        fd.append('first_name',       document.getElementById('edit_first_name').value.trim());
        fd.append('last_name',        document.getElementById('edit_last_name').value.trim());
        fd.append('middle_name',      document.getElementById('edit_middle_name').value.trim());
        fd.append('suffix',           document.getElementById('edit_suffix').value.trim());
        fd.append('mobile_number',    document.getElementById('edit_mobile_number').value.trim());
        fd.append('city_town',        document.getElementById('edit_city_town').value.trim());
        fd.append('home_address',     document.getElementById('edit_home_address').value.trim());
        fd.append('self_description', document.getElementById('edit_self_description').value.trim());

        const photoInput = document.getElementById('editPhotoInput');
        if (photoInput.files[0]) fd.append('profile_pic', photoInput.files[0]);

        const res = await fetch('/teacher/profile/update', {
            method: 'POST',
            headers: {
                'X-Requested-With': 'XMLHttpRequest',
                'Accept': 'application/json'
            },
            body: fd
        });

        if (!res.ok) throw new Error('Update failed. Please try again.');

        showDrawerMsg('Profile updated successfully!', 'success');
        showToast('Profile updated!', 'success');
        closeEditDrawer();

        // Seamlessly refresh profile DOM in background without full page reload
        const pageRes = await fetch('/teacher/profile?updated=1', {
            headers: { 'X-Requested-With': 'XMLHttpRequest' },
            cache: 'no-store'
        });
        if (pageRes.ok) {
            const html = await pageRes.text();
            const parser = new DOMParser();
            const newDoc = parser.parseFromString(html, 'text/html');

            ['section-info', 'userMenuBtn', 'userDropdown'].forEach(id => {
                const curEl = document.getElementById(id);
                const newEl = newDoc.getElementById(id);
                if (curEl && newEl) {
                    curEl.innerHTML = newEl.innerHTML;
                }
            });

            const curLeft = document.querySelector('.profile-left');
            const newLeft = newDoc.querySelector('.profile-left');
            if (curLeft && newLeft) {
                curLeft.innerHTML = newLeft.innerHTML;
            }
        }

    } catch (err) {
        showDrawerMsg(err.message, 'error');
        showToast(err.message, 'error');
    } finally {
        btn.disabled  = false;
        btn.innerHTML = '<i class="fas fa-save text-xs"></i> Save Changes';
    }
}

</script>
</body>
</html>
