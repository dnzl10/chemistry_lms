async function confirmUnmaskReply() {
    const replyId = document.getElementById('unmaskReplyId').value;
    const justification = document.getElementById('unmaskJustification').value.trim();
    const errEl = document.getElementById('unmaskError');
    const btn = document.getElementById('btnConfirmUnmask');

    if (justification.length < 5) {
        errEl.textContent = 'Please enter a justification of at least 5 characters.';
        errEl.classList.remove('hidden');
        return;
    }

    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Revealing…';

    try {
        const res = await fetch(`/teacher/api/forum/reply/${replyId}/reveal`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ justification })
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to reveal identity');

        closeModal('modalUnmask');
        toast(`Identity revealed: ${data.real_name}`, 'success');
        await refreshThread();
    } catch(err) {
        errEl.textContent = err.message;
        errEl.classList.remove('hidden');
    } finally {
        btn.disabled = false;
        btn.innerHTML = '<i class="fas fa-eye"></i> Confirm & Reveal';
    }
}

