            tmRenderModal(data2);
        } else {
            await refreshThread();
        }
    } catch(e) { toast(e.message, 'error'); }
}

/* ════════════════════════════════════════════
   FILE PREVIEW & DOWNLOAD SYSTEM
   Baby, ito ang mag-handle ng clicking ng files
════════════════════════════════════════════ */
function viewFile(filePath, fileName, fileType) {
    if (!filePath) return;

    // Path must match your app.use('/forum_uploads', express.static(...)) in app.js
    const fileUrl = `/forum_uploads/${filePath}`;

    // 1. IMAGE PREVIEW MODAL
    if (fileType && fileType.startsWith('image/')) {
        const modalId = 'f-preview-modal-' + Date.now();
        const previewModal = `
            <div id="${modalId}" class="fixed inset-0 z-[10000] flex items-center justify-center bg-black/90 p-4"
                 onclick="if(event.target===this)this.remove()">
                <div class="relative max-w-5xl w-full flex flex-col items-center" onclick="event.stopPropagation()">
                    <button onclick="document.getElementById('${modalId}').remove()"
                            class="absolute -top-10 right-0 text-white text-2xl font-bold hover:text-red-400 transition flex items-center gap-2">
                        <i class="fas fa-times"></i> Close
                    </button>
                    <img src="${fileUrl}"
                         class="max-h-[80vh] rounded-lg shadow-2xl object-contain"
                         onerror="document.getElementById('${modalId}').remove();alert('File not found: ${fileUrl}')">
                    <div class="mt-4 flex gap-3">
                        <a href="${fileUrl}" download="${fileName}"
                           class="bg-indigo-600 text-white px-6 py-2 rounded-full font-bold hover:bg-indigo-700 transition flex items-center gap-2">
                            <i class="fas fa-download"></i> Download Image
                        </a>
                    </div>
                </div>
            </div>`;
        document.body.insertAdjacentHTML('beforeend', previewModal);
        // Close on Escape key
        const escHandler = (e) => { if (e.key === 'Escape') { document.getElementById(modalId)?.remove(); document.removeEventListener('keydown', escHandler); } };
        document.addEventListener('keydown', escHandler);
    }
    // 2. PDF / Text / Video — open in new tab
    else if (fileType === 'application/pdf' || fileType === 'text/plain' || (fileType && fileType.startsWith('video/'))) {
        window.open(fileUrl, '_blank');
    }
    // 3. Everything else — direct download
    else {
        const link = document.createElement('a');
        link.href = fileUrl;
        link.download = fileName || 'download';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
}
</script>

<!-- =============================================
     NOTIFICATION PANEL
============================================= -->
<div id="notifPanel" class="fixed top-0 right-0 h-full w-full max-w-sm z-[200] translate-x-full transition-transform duration-300 ease-in-out flex flex-col"
     style="background: linear-gradient(180deg, #0d1a2e 0%, #0f1f38 100%); box-shadow: -8px 0 40px rgba(6,182,212,0.15);">

    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-white/10 flex-shrink-0">
        <div>
            <h3 class="text-white font-black text-base tracking-tight uppercase italic flex items-center gap-2">
                <i class="fas fa-bell text-cyan-400 text-sm"></i> Notifications
            </h3>
            <p class="text-indigo-400 text-[10px] font-bold uppercase tracking-widest mt-0.5">
                <%= notifications ? notifications.length : 0 %> updates
            </p>
        </div>
        <button onclick="toggleNotifPanel()" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 hover:bg-rose-500/20 text-indigo-300 hover:text-rose-400 transition">
            <i class="fas fa-times text-sm"></i>
        </button>
    </div>

    <!-- Scrollable List -->
    <div class="flex-1 overflow-y-auto no-scrollbar px-4 py-4 space-y-2">
        <% if (notifications && notifications.length > 0) { %>
            <% notifications.forEach(notif => { %>
                <%
                    let href = '#';
                    let iconClass = 'fas fa-bell text-cyan-400';
                    let badgeClass = 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30';
                    let badgeLabel = 'Update';

                    if (notif.notif_type === 'forum_reply') {
                        href = '/teacher/forums#forum-' + notif.link_id;
                        iconClass = 'fas fa-comments text-amber-400';
                        badgeClass = 'bg-amber-500/20 text-amber-300 border-amber-500/30';
                        badgeLabel = 'Forum Reply';
                    } else if (notif.notif_type === 'private_message') {
                        href = '/teacher/messages/' + notif.link_id;
                        iconClass = 'fas fa-envelope text-indigo-400';
                        badgeClass = 'bg-indigo-500/20 text-indigo-300 border-indigo-500/30';
                        badgeLabel = 'Message';
                    } else if (notif.notif_type === 'struggling_student') {
                        href = '/teacher/class/' + notif.link_id + '#students';
                        iconClass = 'fas fa-triangle-exclamation text-rose-400';
                        badgeClass = 'bg-rose-500/20 text-rose-300 border-rose-500/30';
                        badgeLabel = 'Needs Help';
                    } else if (notif.notif_type === 'pending_question') {
                        href = '/teacher/question-bank?q=' + notif.link_id;
                        iconClass = 'fas fa-database text-fuchsia-400';
                        badgeClass = 'bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-500/30';
                        badgeLabel = 'Review Question';
                    } else if (notif.notif_type === 'upcoming_deadline') {
                        href = '/teacher/class/' + notif.link_id;
                        iconClass = 'fas fa-hourglass-half text-emerald-400';
                        badgeClass = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
                        badgeLabel = 'Deadline Soon';
                    }
                %>
                <a href="<%= href %>"
                   class="flex items-start gap-3 p-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 hover:border-cyan-500/30 transition group cursor-pointer">

                    <div class="flex-shrink-0 mt-0.5">
                        <% if (notif.actor_pic && notif.notif_type !== 'upcoming_deadline') { %>
                            <img src="/profile_uploads/<%= notif.actor_pic %>" class="w-9 h-9 rounded-xl object-cover ring-1 ring-white/10 group-hover:ring-cyan-400/40 transition">
                        <% } else { %>
                            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center">
                                <i class="<%= iconClass %> text-sm"></i>
                            </div>
                        <% } %>
                    </div>

                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1 flex-wrap">
                            <span class="text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-lg border <%= badgeClass %>"><%= badgeLabel %></span>
                        </div>
                        <p class="text-white text-[11px] font-bold leading-snug group-hover:text-cyan-300 transition line-clamp-2">
                            <% if (notif.notif_type !== 'upcoming_deadline') { %>
                                <span class="text-cyan-400"><%= notif.actor_name %></span>
                            <% } %>
                            <%= notif.message %>
                        </p>
                        <p class="text-indigo-500 text-[9px] font-bold mt-1 uppercase tracking-widest">
                            <% if (notif.notif_time) { %>
                                <%= new Date(notif.notif_time).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            <% } else { %>
                                —
                            <% } %>
                        </p>
                    </div>

                    <div class="flex-shrink-0 self-center text-indigo-600 group-hover:text-cyan-400 transition">
                        <i class="fas fa-chevron-right text-[10px]"></i>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <div class="flex flex-col items-center justify-center h-full py-20 text-center">
                <div class="w-16 h-16 rounded-3xl bg-white/5 flex items-center justify-center mb-4">
                    <i class="fas fa-bell-slash text-indigo-500 text-2xl"></i>
                </div>
                <p class="text-indigo-400 text-xs font-black uppercase tracking-widest">You're all caught up!</p>
                <p class="text-indigo-600 text-[10px] font-bold mt-1">No new notifications</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Backdrop -->
<div id="notifBackdrop" class="fixed inset-0 bg-indigo-950/50 backdrop-blur-sm z-[199] hidden" onclick="toggleNotifPanel()"></div>

<script>
    function toggleNotifPanel() {
        const panel    = document.getElementById('notifPanel');
        const backdrop = document.getElementById('notifBackdrop');
        const isOpen   = !panel.classList.contains('translate-x-full');
        if (isOpen) {
            panel.classList.add('translate-x-full');
            backdrop.classList.add('hidden');
        } else {
            panel.classList.remove('translate-x-full');
            backdrop.classList.remove('hidden');
        }
    }

    // ── Profile dropdown ──────────────────────────────────
        function toggleProfileDropdown() {
            document.getElementById('profileDropdown').classList.toggle('open');
        }
        // Close when clicking outside
        document.addEventListener('click', function(e) {
            const wrap = document.getElementById('profileDropdownWrap');
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById('profileDropdown').classList.remove('open');
            }
        });
</script>
</body>
</html>
