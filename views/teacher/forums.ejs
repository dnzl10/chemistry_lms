function tmRenderModal(data) {
    const f        = data.forum;
    const replies  = data.replies  || [];
    const done     = data.done_students    || [];
    const students = data.enrolled_students || [];

    /* ── Header ── */
    document.getElementById('tmTitle').textContent       = f.title;
    if (document.getElementById('tmStatusSelect')) {
        document.getElementById('tmStatusSelect').value = f.status || 'unresolved';
    }
    document.getElementById('tmHeaderTitle').textContent = f.title;
    document.getElementById('tmContent').textContent     = f.forum_content || '';
    document.getElementById('tmDate').textContent        = formatDate(f.created_at);
    document.getElementById('tmReplyCount').textContent  = f.reply_count || 0;
    document.getElementById('tmReplyBadge').textContent  = f.reply_count || 0;
    document.getElementById('tmTeacherName').textContent = f.teacher_name || 'Teacher';
    document.getElementById('tmPostedAgo').textContent   = 'Posted ' + timeAgo(f.created_at);
    document.getElementById('tmTeacherPic').src          = `/profile_uploads/${f.teacher_pic || 'default_avatar.png'}`;

    const pinBadge = document.getElementById('tmPinBadge');
    pinBadge.classList.toggle('hidden', !f.is_pinned);
    document.getElementById('tmPinLabel').textContent = f.is_pinned ? 'Unpin' : 'Pin';

    const subject = ALL_SUBJECTS.find(s => s.subject_id === f.subject_id) || {};
    const topic   = ALL_TOPICS.find(t => t.topic_id === f.topic_id) || null;
    document.getElementById('tmSubjectBadge').textContent = subject.subject_name || '';
    const topicBadge = document.getElementById('tmTopicBadge');
    if (topic) { topicBadge.textContent = `Q${topic.quarter_number} · ${topic.topic_name}`; topicBadge.style.display = ''; }
    else topicBadge.style.display = 'none';

    /* ── Students left panel ── */
    const doneIds = new Set(done.map(d => d.student_id));
    const enrolled = students.length;
    const pct = enrolled ? Math.round((done.length / enrolled) * 100) : 0;
    document.getElementById('tmCompFill').style.width  = pct + '%';
    document.getElementById('tmCompLabel').textContent = pct + '%';

    if (!enrolled) {
        document.getElementById('tmStudentList').innerHTML = '<p class="text-xs text-slate-400 text-center py-3">No students enrolled.</p>';
    } else {
        document.getElementById('tmStudentList').innerHTML = students.map(s => {
            const isDone = doneIds.has(s.student_id);
            return `<div class="tm-student-row">
                <img src="/profile_uploads/${s.profile_pic || 'default_avatar.png'}"
                     class="avatar w-7 h-7 flex-shrink-0"
                     onerror="this.src='/profile_uploads/default_avatar.png'">
                <span class="text-xs font-semibold text-slate-700 flex-1 min-w-0 truncate">${escHtml(s.first_name)} ${escHtml(s.last_name)}</span>
                ${isDone
                    ? `<span class="badge badge-emerald" style="font-size:9px"><i class="fas fa-check"></i> Done</span>`
                    : `<span class="badge badge-slate" style="font-size:9px">Not yet</span>`}
            </div>`;
        }).join('');
    }

    /* ── Files left panel ── */
    tmAllFiles = [];
    replies.forEach(r => {
        if (r.file_path && r.file_name) tmAllFiles.push({ kind: 'file', reply: r });
        if (r.external_link)            tmAllFiles.push({ kind: 'link', reply: r });
    });
    tmRenderFilesPanel();

    /* ── Replies ── */
    tmReplies = replies;
    tmRenderReplies(replies, '');
}

/* ════════════════════════════════════════════
   FILES LEFT PANEL
════════════════════════════════════════════ */
function tmRenderFilesPanel() {
    const container = document.getElementById('tmFileList');
    if (!tmAllFiles.length) {
        container.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">No files or links shared yet.</p>';
        return;
    }
    container.innerHTML = tmAllFiles.map(item => {
        const r = item.reply;
        if (item.kind === 'file') {
            const isImg = r.file_type && r.file_type.startsWith('image/');
            const thumbHtml = isImg
                ? `<img src="/forum_uploads/${r.file_path}" class="file-thumb" onerror="this.style.display='none'">`
                : `<div class="file-thumb-placeholder"><i class="${fileIcon(r.file_type)} text-2xl text-indigo-300"></i></div>`;
            return `<div class="file-tab-item">
                ${thumbHtml}
                <div style="padding:8px 10px;">
                    <p class="text-xs font-bold text-slate-700 truncate">${escHtml(r.file_name)}</p>
                    <p class="text-[10px] text-slate-400 mt-0.5">by ${escHtml(r.author_name || 'Unknown')} · ${timeAgo(r.created_at)}</p>
                    <div class="flex gap-2 mt-2">
                        <button onclick="viewFile('${r.file_path}','${escHtml(r.file_name)}','${r.file_type}')"
                                class="btn btn-outline btn-xs flex-1 justify-center">
                            <i class="fas fa-eye text-[10px]"></i> View
                        </button>
                        <a href="/forum_uploads/${r.file_path}" download="${r.file_name}"
                           class="btn btn-outline btn-xs flex-1 justify-center">
                            <i class="fas fa-download text-[10px]"></i> Save
                        </a>
                    </div>
                </div>
            </div>`;
        } else {
            // External link — show favicon + OG preview via Google's S2
            const url = r.external_link;
            let hostname = url;
            try { hostname = new URL(url).hostname; } catch(_) {}
            const faviconUrl = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(hostname)}&sz=32`;
            return `<div class="link-card">
                <div class="link-card-body flex items-start gap-2">
                    <img src="${faviconUrl}" style="width:20px;height:20px;border-radius:4px;flex-shrink:0;margin-top:2px;"
                         onerror="this.style.display='none'">
                    <div class="min-w-0 flex-1">
                        <p class="text-xs font-bold text-slate-700 truncate">${escHtml(hostname)}</p>
                        <p class="text-[10px] text-slate-400 truncate">${escHtml(url.length > 55 ? url.slice(0,55)+'…' : url)}</p>
                        <p class="text-[10px] text-slate-400 mt-0.5">by ${escHtml(r.author_name || 'Unknown')} · ${timeAgo(r.created_at)}</p>
                        <a href="${escHtml(url)}" target="_blank" rel="noopener"
                           class="inline-flex items-center gap-1 text-[10px] text-indigo-600 font-bold mt-1 hover:underline">
                            <i class="fas fa-external-link-alt"></i> Open
                        </a>
                    </div>
                </div>
            </div>`;
        }
    }).join('');
}

