            <div class="space-y-3">
                <div>
                    <label class="form-label">Discussion Title <span class="text-rose-500">*</span></label>
                    <input id="createTitle" type="text" class="form-input" placeholder="e.g., Investigating Endothermic vs Exothermic Reactions in Solutions" maxlength="255">
                </div>
                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="form-label mb-0">Discussion Prompt & Instructions <span class="text-rose-500">*</span></label>
                        <div class="flex items-center gap-1">
                            <button type="button" onclick="insertFormulaHelper('createContent', 'H₂O')" class="px-2 py-0.5 rounded-md bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-[10px] font-bold text-slate-600 transition">H₂O</button>
                            <button type="button" onclick="insertFormulaHelper('createContent', 'CO₂')" class="px-2 py-0.5 rounded-md bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-[10px] font-bold text-slate-600 transition">CO₂</button>
                            <button type="button" onclick="insertFormulaHelper('createContent', 'ΔH < 0')" class="px-2 py-0.5 rounded-md bg-slate-100 hover:bg-indigo-50 hover:text-indigo-600 text-[10px] font-bold text-slate-600 transition">ΔH</button>
                        </div>
                    </div>
                    <textarea id="createContent" class="form-textarea" placeholder="Provide problem scenario, guiding questions, or lab hypothesis..." rows="4"></textarea>
                </div>
                <div>
                    <label class="form-label">Reference Material / Worksheet (Optional)</label>
                    <div class="flex items-center gap-2">
                        <input id="createAttachment" type="file" class="form-input text-xs" accept=".pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.png,.jpg,.jpeg,.mp3,.wav,.zip">
                    </div>
                    <span class="text-[10px] text-slate-400 mt-0.5 block">Supported: PDF, Word, PowerPoint, Audio, Images (Up to 25MB)</span>
                </div>
            </div>

            <!-- SECTION 3: GAMIFICATION & PEDAGOGICAL RULES -->
            <div class="p-3.5 rounded-2xl bg-amber-50/50 border border-amber-100/80 space-y-3">
                <div class="flex items-center justify-between">
                    <span class="text-[11px] font-black uppercase tracking-wider text-amber-700 flex items-center gap-1.5">
                        <i class="fas fa-award text-amber-500"></i> Gamification & Pedagogical Rules
                    </span>
                    <span class="text-[10px] font-bold px-2 py-0.5 rounded-md bg-amber-100/70 text-amber-800">Dynamic EXP Decay</span>
                </div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-3 items-center">
                    <div>
                        <label class="form-label">Max Base EXP Reward</label>
                        <select id="createBaseExp" class="form-select">
                            <option value="50">50 EXP (Micro Activity)</option>
                            <option value="100" selected>100 EXP (Recommended Standard)</option>
                            <option value="150">150 EXP (Extended Discussion)</option>
                            <option value="200">200 EXP (Major Synthesis Board)</option>
                        </select>
                    </div>
                    <div class="text-[11px] text-slate-500 leading-snug">
                        Early submissions earn <strong class="text-indigo-600">100%</strong> base EXP, decaying to <strong class="text-amber-600">85%</strong>, <strong class="text-slate-600">70%</strong>, or <strong class="text-rose-500">40%</strong> for late submissions.
                    </div>
                </div>
                <div class="pt-2 border-t border-amber-100 flex flex-col gap-2">
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" id="createPostBeforeViewing" class="rounded text-indigo-600 focus:ring-indigo-500">
                        <span class="text-xs font-semibold text-slate-700">
                            🔒 <strong>Post-First Requirement (Anti-Copy):</strong> Students must post their own answer before viewing classmate discussions
                        </span>
                    </label>
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" id="createAllowAnonymous" class="rounded text-indigo-600 focus:ring-indigo-500" checked>
                        <span class="text-xs font-semibold text-slate-700">
                            🎭 <strong>Allow Anonymous Student Questions:</strong> Students can mask their name to ask shy questions safely
                        </span>
                    </label>
                    <label class="flex items-center gap-2.5 cursor-pointer">
                        <input type="checkbox" id="createPinned" class="rounded text-indigo-600 focus:ring-indigo-500">
                        <span class="text-xs font-semibold text-slate-700">
                            📌 <strong>Pin this forum thread to the top</strong>
                        </span>
                    </label>
                </div>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('modalCreate')">Cancel</button>
            <button class="btn btn-primary" id="btnSubmitCreateForum" onclick="submitCreateForum()"><i class="fas fa-paper-plane"></i> Publish Forum</button>
        </div>
    </div>
</div>

<!-- EDIT FORUM MODAL -->
<div id="modalEdit" class="modal-backdrop">
    <div class="modal-card" style="max-width: 760px;">
        <div class="modal-header">
            <div class="flex items-center gap-2.5">
                <div class="w-9 h-9 rounded-xl bg-amber-50 border border-amber-100 flex items-center justify-center text-amber-600 shadow-xs">
                    <i class="fas fa-pen text-sm"></i>
