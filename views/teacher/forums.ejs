// ════════════════════════════════════════════════════════════════════════
// FORUM BANNER STUDIO CONTROLLER (Presets + Custom Upload + Live Preview)
// ════════════════════════════════════════════════════════════════════════
const bannerStudioState = {
    create: { choice: 'preset', preset: 'preset-molecules.svg', title: 'Molecular Geometry', file: null },
    edit:   { choice: 'preset', preset: 'preset-molecules.svg', title: 'Molecular Geometry', file: null }
};

function capitalizeWord(s) {
    return s ? s.charAt(0).toUpperCase() + s.slice(1) : '';
}

function setBannerStudioTab(scope, tab) {
    if (!bannerStudioState[scope]) return;
    bannerStudioState[scope].choice = tab;

    const tabs = ['preset', 'upload', 'default'];
    tabs.forEach(t => {
        const btn = document.getElementById(`btnTab${capitalizeWord(t)}_${scope}`);
        const panel = document.getElementById(`panel${capitalizeWord(t)}_${scope}`);
        if (!btn || !panel) return;
        if (t === tab) {
            btn.className = 'px-2.5 py-1 rounded-lg bg-white text-indigo-600 shadow-2xs transition font-bold cursor-pointer';
            panel.classList.remove('hidden');
        } else {
            btn.className = 'px-2.5 py-1 rounded-lg text-slate-600 hover:text-slate-900 transition font-bold cursor-pointer';
            panel.classList.add('hidden');
        }
    });

    updateBannerStudioPreview(scope);
}

function selectBannerPreset(scope, presetFilename, presetTitle) {
    if (!bannerStudioState[scope]) return;
    bannerStudioState[scope].choice = 'preset';
    bannerStudioState[scope].preset = presetFilename;
    bannerStudioState[scope].title = presetTitle;
    bannerStudioState[scope].file = null;

    document.querySelectorAll(`.preset-card-${scope}`).forEach(card => {
        const isMatch = card.getAttribute('data-preset') === presetFilename;
        card.classList.toggle('border-indigo-600', isMatch);
        card.classList.toggle('bg-indigo-50/50', isMatch);
        card.classList.toggle('ring-2', isMatch);
        card.classList.toggle('ring-indigo-500/20', isMatch);
        card.classList.toggle('border-slate-200', !isMatch);
        card.classList.toggle('bg-white', !isMatch);
        const check = card.querySelector('.preset-check');
        if (check) check.classList.toggle('hidden', !isMatch);
    });

    updateBannerStudioPreview(scope);
}

function handleBannerFileSelect(scope, input) {
    if (!input || !input.files || !input.files[0]) return;
    const file = input.files[0];
    bannerStudioState[scope].choice = 'upload';
    bannerStudioState[scope].file = file;

    const fileInfo = document.getElementById(`bannerUploadFileInfo_${scope}`);
    const fileName = document.getElementById(`bannerUploadFileName_${scope}`);
    if (fileInfo && fileName) {
        fileName.innerHTML = `<i class="fas fa-image"></i> ${file.name}`;
        fileInfo.classList.remove('hidden');
    }

    updateBannerStudioPreview(scope);
}

function clearBannerUpload(scope) {
    if (!bannerStudioState[scope]) return;
    bannerStudioState[scope].file = null;
    const input = document.getElementById(`bannerFileInput_${scope}`);
    if (input) input.value = '';
    const fileInfo = document.getElementById(`bannerUploadFileInfo_${scope}`);
    if (fileInfo) fileInfo.classList.add('hidden');
    setBannerStudioTab(scope, 'preset');
}

function updateBannerStudioPreview(scope) {
    const previewImg = document.getElementById(`bannerPreviewImg_${scope}`);
    const badge = document.getElementById(`bannerPreviewBadge_${scope}`);
    if (!previewImg) return;

    const state = bannerStudioState[scope];
    if (state.choice === 'upload' && state.file) {
        previewImg.src = URL.createObjectURL(state.file);
        if (badge) badge.textContent = 'Custom Upload';
    } else if (state.choice === 'default') {
        previewImg.src = '/profile_uploads/try_subject.png';
        if (badge) badge.textContent = 'Subject Default';
    } else {
        const preset = state.preset || 'preset-molecules.svg';
        const url = preset.startsWith('/') ? preset : `/forum_banners/presets/${preset}`;
        previewImg.src = url;
        if (badge) badge.textContent = state.title || 'Curated Preset';
    }
}

function initBannerStudioModal(scope, initialBanner, initialTitle) {
    if (!bannerStudioState[scope]) return;
    const titleEl = document.getElementById(`bannerPreviewTitle_${scope}`);
    if (titleEl) titleEl.textContent = initialTitle || (scope === 'create' ? 'Discussion Title' : 'Current Forum Title');

    if (!initialBanner) {
        if (scope === 'create') {
            setBannerStudioTab(scope, 'preset');
            selectBannerPreset(scope, 'preset-molecules.svg', 'Molecular Geometry');
        } else {
            setBannerStudioTab(scope, 'default');
        }
    } else if (initialBanner.includes('preset-')) {
        const filename = initialBanner.split('/').pop();
        setBannerStudioTab(scope, 'preset');
        selectBannerPreset(scope, filename, 'Curated Preset');
    } else {
        // Active custom uploaded banner or explicit path
        bannerStudioState[scope].choice = 'preset';
        bannerStudioState[scope].preset = initialBanner;
        bannerStudioState[scope].file = null;
        setBannerStudioTab(scope, 'preset');
        const previewImg = document.getElementById(`bannerPreviewImg_${scope}`);
        const badge = document.getElementById(`bannerPreviewBadge_${scope}`);
        if (previewImg) previewImg.src = initialBanner;
        if (badge) badge.textContent = 'Active Custom Banner';
    }
}

