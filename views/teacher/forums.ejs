<!-- =====================================================================
     EJS DATA BRIDGE + JAVASCRIPT
===================================================================== -->
<script>
/* ── RAW DATA FROM SERVER ── */
const ALL_FORUMS   = <%- JSON.stringify(forums) %>;
const ALL_SUBJECTS = <%- JSON.stringify(subjects) %>;
const ALL_TOPICS   = <%- JSON.stringify(topics) %>;
const ALL_CLASSES  = <%- JSON.stringify(typeof classes !== "undefined" ? classes : []) %>;
const ALL_STUDENTS = <%- JSON.stringify(enrolledStudents) %>;
const TEACHER_ID   = <%= user.user_id %>;
const TEACHER_NAME = "<%= user.first_name %> <%= user.last_name %>";
const TEACHER_PIC  = "<%= user.profile_pic || 'default_avatar.png' %>";

/* ── STATE ── */
let activeSubject  = 'all';
let activeTopic    = 'all';
let filterPin      = false;
let currentForum   = null;   // full forum object being viewed
let replyParentId  = null;   // null = top-level reply
let deletingReplyId = null;

/* ════════════════════════════════════════════
   SIDEBAR
════════════════════════════════════════════ */
function toggleSidebar() {
    const s = document.getElementById('sidebar');
    const o = document.getElementById('sidebarOverlay');
    const hidden = s.classList.contains('-translate-x-full');
    s.classList.toggle('-translate-x-full', !hidden);
    o.classList.toggle('hidden', !hidden);
}

/* ════════════════════════════════════════════
   TOAST
════════════════════════════════════════════ */
function toast(msg, type = 'success') {
    const el = document.getElementById('forum-toast');
    const msgEl = document.getElementById('forum-toast-msg');
    el.className = 'show ' + type;
    msgEl.textContent = msg;
    setTimeout(() => { el.className = ''; }, 3200);
}

/* ════════════════════════════════════════════
   MODAL HELPERS
════════════════════════════════════════════ */
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-backdrop').forEach(m => {
    m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); });
});

/* ════════════════════════════════════════════
   TOPIC SELECT POPULATION
════════════════════════════════════════════ */

function insertFormulaHelper(textareaId, text) {
    const el = document.getElementById(textareaId);
    if (!el) return;
    const start = el.selectionStart || el.value.length;
    const end = el.selectionEnd || el.value.length;
    el.value = el.value.substring(0, start) + text + el.value.substring(end);
    el.focus();
    el.setSelectionRange(start + text.length, start + text.length);
}

function onSubjectChange(prefix) {
    populateTopicSelect(prefix + 'TopicId', prefix + 'SubjectId');
    populateClassSelect(prefix + 'ClassId', prefix + 'SubjectId');
}

function populateClassSelect(targetId, subjectSelId) {
    const subjectId = document.getElementById(subjectSelId)?.value;
    const sel = document.getElementById(targetId);
    if (!sel) return;
    sel.innerHTML = '<option value="">All Enrolled Sections</option>';
    (ALL_CLASSES || []).filter(c => !subjectId || String(c.subject_id) === String(subjectId)).forEach(c => {
        const opt = document.createElement('option');
        opt.value = c.class_id;
        opt.textContent = c.class_name;
        sel.appendChild(opt);
    });
}

function populateTopicSelect(targetId, subjectSelId) {
    const subjectId = document.getElementById(subjectSelId).value;
    const sel = document.getElementById(targetId);
    sel.innerHTML = '<option value="">— No specific topic —</option>';
    ALL_TOPICS.filter(t => String(t.subject_id) === String(subjectId)).forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.topic_id;
        opt.textContent = `Q${t.quarter_number} · ${t.topic_name}`;
        sel.appendChild(opt);
    });
}

/* ════════════════════════════════════════════
   FILTERING & SORTING
════════════════════════════════════════════ */
function filterSubject(sid, btn) {
    activeSubject = String(sid);
    document.querySelectorAll('.subject-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    // show/hide topic pills
    document.querySelectorAll('#topicFilterRow .filter-pill').forEach(p => {
        const ps = p.dataset.subject;
        if (!ps || activeSubject === 'all' || ps === activeSubject) {
            p.style.display = '';
        } else {
            p.style.display = 'none';
        }
    });
    activeTopic = 'all';
    document.querySelector('#topicFilterRow [data-topic="all"]').classList.add('active');
    document.querySelectorAll('#topicFilterRow [data-topic]:not([data-topic="all"])').forEach(p => p.classList.remove('active'));
    applyFilters();
}

function filterTopic(tid, btn) {
    activeTopic = String(tid);
    document.querySelectorAll('#topicFilterRow .filter-pill').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    applyFilters();
}

function togglePill(type, btn) {
    if (type === 'pin') { filterPin = !filterPin; btn.classList.toggle('active', filterPin); }
    applyFilters();
}

function applyFilters() {
    let list = [...ALL_FORUMS];
    const search = document.getElementById('searchInput').value.trim().toLowerCase();
    const sort   = document.getElementById('sortSelect').value;

    if (activeSubject !== 'all') list = list.filter(f => String(f.subject_id) === activeSubject);
    if (activeTopic   !== 'all') list = list.filter(f => String(f.topic_id)   === activeTopic);
    if (filterPin)                list = list.filter(f => f.is_pinned);
    if (search)                   list = list.filter(f => f.title.toLowerCase().includes(search));

    if (sort === 'newest')       list.sort((a,b) => new Date(b.created_at) - new Date(a.created_at));
    else if (sort === 'oldest')  list.sort((a,b) => new Date(a.created_at) - new Date(b.created_at));
    else if (sort === 'most_replies') list.sort((a,b) => (b.reply_count||0) - (a.reply_count||0));
    else if (sort === 'pinned')  list.sort((a,b) => b.is_pinned - a.is_pinned);

    renderForumList(list);
}

/* ════════════════════════════════════════════
   RENDER FORUM LIST
════════════════════════════════════════════ */
function renderForumList(list) {
    const container = document.getElementById('forumListInner');
    const empty     = document.getElementById('emptyState');

    if (!list.length) {
        container.innerHTML = '';
        empty.classList.remove('hidden');
        return;
    }
    empty.classList.add('hidden');

    container.innerHTML = list.map(f => {
        const subject  = ALL_SUBJECTS.find(s => s.subject_id === f.subject_id) || {};
        const topic    = ALL_TOPICS.find(t => t.topic_id === f.topic_id) || null;
        const lastAct  = f.last_reply_at ? timeAgo(f.last_reply_at) : timeAgo(f.created_at);
        const doneRate = f.enrolled_count ? Math.round((f.done_count / f.enrolled_count) * 100) : 0;
        const statusBadge = f.status === 'solved'
            ? '<span class="inline-flex items-center gap-1 bg-emerald-100 text-emerald-800 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider"><i class="fas fa-check-circle text-emerald-600"></i> Solved</span>'
            : (f.status === 'instructor_verified'
                ? '<span class="inline-flex items-center gap-1 bg-blue-100 text-blue-800 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider"><i class="fas fa-certificate text-blue-600"></i> Verified</span>'
                : '<span class="inline-flex items-center gap-1 bg-amber-100 text-amber-800 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider"><i class="fas fa-question-circle text-amber-600"></i> Unresolved</span>');

        return `
        <div class="forum-card bg-white rounded-2xl border border-slate-200/90 shadow-xs hover:shadow-lg hover:-translate-y-0.5 transition-all duration-200 overflow-hidden cursor-pointer group"
             onclick="window.location.href='/teacher/forums/view/${f.forum_id}'"
             data-forum-id="${f.forum_id}">

            ${f.is_pinned 
                ? '<div class="h-1 bg-gradient-to-r from-amber-400 to-orange-400"></div>' 
                : (f.status === 'solved' || f.status === 'instructor_verified'
                    ? '<div class="h-1 bg-gradient-to-r from-emerald-400 to-teal-400"></div>'
                    : '<div class="h-1 bg-gradient-to-r from-cyan-500 to-indigo-500"></div>')}

            <div class="p-5">
                <div class="flex flex-col sm:flex-row gap-4 items-start">
                    
                    <!-- Subject Icon Badge / Banner Thumbnail -->
                    <div class="flex-shrink-0">
                        ${f.banner_image 
                            ? `<div class="w-14 h-12 rounded-xl overflow-hidden border border-slate-200/90 shadow-2xs bg-slate-900">
                                 <img src="${f.banner_image.startsWith('/') ? f.banner_image : ('/forum_banners/uploads/' + f.banner_image)}" 
                                      class="w-full h-full object-cover group-hover:scale-110 transition duration-300"
                                      onerror="this.parentElement.innerHTML='<div class=\\'w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-50 to-blue-100 border border-indigo-200 flex items-center justify-center text-indigo-600 font-black shadow-xs\\'><i class=\\'fas fa-comments text-lg\\'></i></div>';">
                               </div>`
                            : `<div class="w-12 h-12 rounded-2xl bg-gradient-to-br from-indigo-50 to-blue-100 border border-indigo-200 flex items-center justify-center text-indigo-600 font-black shadow-xs">
                                 <i class="fas fa-comments text-lg"></i>
                               </div>`
                        }
                    </div>

                    <!-- Main Meta & Content -->
                    <div class="flex-1 min-w-0">
                        <div class="flex flex-wrap items-center gap-1.5 mb-2">
                            ${f.is_pinned ? '<span class="inline-flex items-center gap-1 bg-amber-100 text-amber-800 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider"><i class="fas fa-thumbtack text-amber-600"></i> Pinned</span>' : ''}
                            ${statusBadge}
                            <span class="bg-indigo-50 text-indigo-700 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider border border-indigo-100">
                                ${escHtml(subject.subject_name || 'General Chemistry')}
                            </span>
                            ${topic ? `<span class="bg-cyan-50 text-cyan-700 text-[10px] font-black px-2.5 py-0.5 rounded-full uppercase tracking-wider border border-cyan-100">Q${topic.quarter_number} · ${escHtml(topic.topic_name)}</span>` : ''}
                        </div>

                        <h3 class="font-extrabold text-slate-800 text-base leading-snug group-hover:text-indigo-600 transition truncate mb-1">
                            ${escHtml(f.title)}
                        </h3>

                        <p class="text-xs text-slate-500 line-clamp-2 mb-3">
                            ${escHtml((f.forum_content || '').replace(/<[^>]*>?/gm, '').trim()) || 'No prompt description provided.'}
                        </p>

                        <!-- Cohort Completion Bar & Metrics + Manage Discussion CTA -->
                        <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pt-3 border-t border-slate-100">
                            <div class="flex flex-wrap items-center gap-4 text-xs text-slate-400">
                                <span class="font-semibold text-slate-600 flex items-center gap-1">
                                    <i class="far fa-calendar-alt text-[10px] text-slate-400"></i>
                                    ${formatDate(f.created_at)}
                                </span>
                                <span>&bull;</span>
                                <span class="font-semibold text-slate-600 flex items-center gap-1">
                                    <i class="far fa-comments text-[10px] text-indigo-500"></i>
                                    ${f.reply_count || 0} ${f.reply_count === 1 ? 'reply' : 'replies'}
                                </span>
                                <span>&bull;</span>
                                <span class="font-semibold text-slate-600 flex items-center gap-1">
                                    <i class="fas fa-bolt text-[10px] text-amber-500"></i>
                                    Active ${lastAct}
                                </span>
                                <span>&bull;</span>
                                
                                <!-- Cohort Completion Progress Pill -->
                                <div class="flex items-center gap-2">
                                    <span class="font-bold text-slate-700 flex items-center gap-1">
                                        <i class="fas fa-user-check text-[10px] text-emerald-500"></i>
                                        ${f.done_count || 0}/${f.enrolled_count || 0} Done (${doneRate}%)
                                    </span>
                                    <div class="w-20 h-2 bg-slate-100 rounded-full overflow-hidden border border-slate-200 flex-shrink-0">
                                        <div class="h-full bg-gradient-to-r from-emerald-500 to-teal-400 rounded-full transition-all duration-500" style="width: ${doneRate}%"></div>
                                    </div>
                                </div>
                            </div>

                            <div class="flex-shrink-0" onclick="event.stopPropagation();">
                                <a href="/teacher/forums/view/${f.forum_id}"
                                   class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-slate-900 hover:bg-indigo-600 text-white font-extrabold text-xs shadow-xs hover:shadow-indigo-200 transition-all whitespace-nowrap">
                                    <i class="fas fa-comments text-[11px]"></i>
                                    <span>Manage Discussion</span>
                                </a>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>`;
    }).join('');
}

/* ════════════════════════════════════════════
   DIRECT CARD HELPERS (PIN, EDIT, DELETE)
════════════════════════════════════════════ */
async function togglePinForumDirect(forumId, isPinned) {
    try {
        const res = await fetch(`/teacher/api/forum/${forumId}/pin`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_pinned: isPinned })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to update pin status');
        
        const idx = ALL_FORUMS.findIndex(f => f.forum_id === forumId);
        if (idx > -1) {
            ALL_FORUMS[idx].is_pinned = isPinned ? 1 : 0;
        }
        applyFilters();
        updateStats();
        toast(isPinned ? 'Discussion pinned to top 📌' : 'Discussion unpinned', 'success');
    } catch(err) {
        toast(err.message, 'error');
    }
}


function populateEditModalFields(f) {
    document.getElementById('editTitle').value = f.title || '';
    document.getElementById('editContent').value = f.forum_content || '';
    document.getElementById('editTopicId').value = f.topic_id || '';
    document.getElementById('editClassId').value = f.class_id || '';
    document.getElementById('editBaseExp').value = f.base_exp || 100;
    document.getElementById('editPostBeforeViewing').checked = Boolean(f.post_before_viewing);
    document.getElementById('editAllowAnonymous').checked = f.allow_anonymous !== 0;
    document.getElementById('editPinned').checked = Boolean(f.is_pinned);

    if (f.due_date) {
        const d = new Date(f.due_date);
        if (!isNaN(d.getTime())) {
            const pad = n => String(n).padStart(2, '0');
            const localStr = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
            document.getElementById('editDueDate').value = localStr;
        } else {
            document.getElementById('editDueDate').value = '';
        }
    } else {
        document.getElementById('editDueDate').value = '';
    }

    const attZone = document.getElementById('editCurrentAttachmentZone');
    const attName = document.getElementById('editCurrentAttachmentName');
    const removeCheck = document.getElementById('editRemoveAttachment');
    if (removeCheck) removeCheck.checked = false;
    if (f.attachment_name) {
        attZone.classList.remove('hidden');
        attName.textContent = f.attachment_name;
    } else {
        attZone.classList.add('hidden');
        attName.textContent = '';
    }
    if (typeof initBannerStudioModal === 'function') {
        initBannerStudioModal('edit', f.banner_image, f.title);
    }
}

function openEditModalDirect(forumId) {
