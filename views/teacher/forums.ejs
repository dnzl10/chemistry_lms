function tmRenderReplies(replies, searchTerm) {
    const container = document.getElementById('tmRepliesContainer');
    if (!replies.length) {
        container.innerHTML = `<div class="empty-state" style="padding:24px">
            <i class="fas fa-comment-slash text-slate-300 text-2xl"></i>
            <p class="text-xs text-slate-400">No replies yet. Start the discussion!</p>
        </div>`;
        return;
    }

    const roots    = replies.filter(r => !r.parent_reply_id);
    const children = {};
    replies.filter(r => r.parent_reply_id).forEach(r => {
        (children[r.parent_reply_id] = children[r.parent_reply_id] || []).push(r);
    });

    function highlight(text, term) {
        if (!term) return escHtml(text);
        const safe = escHtml(text);
        const safeTerm = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return safe.replace(new RegExp(safeTerm.replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>'), 'gi'),
            m => `<mark class="reply-highlight">${m}</mark>`);
    }

    function renderOne(r, depth) {
        const isTeacher  = r.user_id === TEACHER_ID;
        const isEndorsed = r.is_endorsed == 1;
        const isAnon     = r.is_anonymous == 1;
        const isTopContributor = r.top_contributor == 1 && (!r.is_anonymous || r.unmasked);
        const voteCount  = r.vote_count || 0;
        const userVoted  = r.user_voted ? true : false;
        const hasFile    = r.file_path && r.file_name;
        const hasLink    = r.external_link;
        const cls = `reply-card fade-in ${depth > 0 ? 'nested' : ''} ${isTeacher ? 'teacher-reply' : ''} ${isEndorsed ? 'border-2 border-emerald-500 bg-emerald-50/20' : ''}`;

        let attachHtml = '';
        if (hasFile) {
            attachHtml += `<button type="button"
                onclick="viewFile('${r.file_path}','${escHtml(r.file_name)}','${r.file_type}')"
                class="file-preview-box inline-flex mt-2 hover:border-indigo-300 transition text-left w-full items-center bg-slate-50 p-2 rounded">
                <i class="${fileIcon(r.file_type)} text-indigo-400 text-lg mr-2"></i>
                <div class="flex-1 min-w-0">
                    <p class="font-bold text-slate-700 truncate text-xs">${escHtml(r.file_name)}</p>
                    <p class="text-[10px] text-slate-400">Click to view</p>
                </div>
                <i class="fas fa-eye text-slate-400 text-xs ml-2"></i>
            </button>`;
        }
        if (hasLink) {
            attachHtml += `<a href="${escHtml(r.external_link)}" target="_blank" rel="noopener"
                class="mt-2 flex items-center gap-2 text-xs text-indigo-600 font-semibold hover:underline">
                <i class="fas fa-external-link-alt"></i>
                ${escHtml(r.external_link.length > 65 ? r.external_link.slice(0,65)+'…' : r.external_link)}
            </a>`;
        }

        const childReplies  = children[r.reply_id] || [];
        const childrenHtml  = childReplies.map(c => renderOne(c, depth + 1)).join('');

        return `<div>
            <div class="${cls}" id="tmreply-${r.reply_id}">
                <div class="flex items-start gap-2">
                    <img src="/profile_uploads/${r.profile_pic || 'default_avatar.png'}"
                         class="avatar w-7 h-7" onerror="this.src='/profile_uploads/default_avatar.png'">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap mb-1">
                            <span class="text-xs font-black text-slate-800">${escHtml(r.author_name || 'Unknown')}</span>
                            ${isTeacher ? '<span class="badge badge-indigo">Instructor</span>' : '<span class="badge badge-slate">Student</span>'}
                            ${isTopContributor ? '<span class="badge badge-amber"><i class="fas fa-medal mr-1"></i>Top Contributor</span>' : ''}
                            ${isEndorsed ? '<span class="badge badge-emerald"><i class="fas fa-check-circle mr-1"></i>Endorsed</span>' : ''}
                            ${isAnon ? '<span class="badge badge-amber"><i class="fas fa-user-secret mr-1"></i>Anonymous</span>' : ''}
                            <span class="text-[10px] text-slate-400">${timeAgo(r.created_at)}</span>
                        </div>
                        ${r.reply_title ? `<h5 class="text-xs font-bold text-slate-900 mb-1 flex items-center gap-1.5"><i class="fas fa-heading text-indigo-500 text-[10px]"></i>${escHtml(r.reply_title)}</h5>` : ''}
                        <p class="text-xs text-slate-700 leading-relaxed whitespace-pre-line">${highlight(r.reply_content, searchTerm)}</p>
                        ${attachHtml}
                    </div>
                    <div class="flex gap-1 flex-shrink-0 items-center">
                        <button class="btn btn-xs ${userVoted ? 'btn-primary' : 'btn-outline'}"
                            onclick="tmToggleVote(${r.reply_id})"
                            title="${userVoted ? 'Remove Teacher Upvote' : 'Teacher Upvote (+1)'}">
                            <i class="fas fa-arrow-up"></i> ${voteCount} ${userVoted ? '⭐' : ''}
                        </button>
                        <button class="btn btn-xs ${isEndorsed ? 'btn-success' : 'btn-outline-success'}"
                            onclick="tmToggleEndorse(${r.reply_id})"
                            title="${isEndorsed ? 'Remove Endorsement' : 'Endorse as Instructor Answer'}">
                            <i class="fas fa-check-circle"></i> ${isEndorsed ? 'Endorsed' : 'Endorse'}
                        </button>
                        ${(isAnon && !r.unmasked) ? `
                        <button class="btn btn-warning btn-xs" title="Reveal Identity" onclick="openUnmaskModal(${r.reply_id})">
                            <i class="fas fa-eye"></i>
                        </button>` : ''}
                        <button class="btn btn-outline btn-xs"
                            onclick="tmSetReplyingTo(${r.reply_id},'${escHtml(r.author_name || '')}')"
                            title="Reply">
                            <i class="fas fa-reply"></i>
                        </button>
                        <button class="btn btn-danger btn-xs" onclick="openDeleteReplyModal(${r.reply_id})" title="Delete">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
            ${childrenHtml ? `<div class="mt-2 flex flex-col gap-2">${childrenHtml}</div>` : ''}
        </div>`;
    }

    container.innerHTML = `<div class="flex flex-col gap-3">${roots.map(r => renderOne(r, 0)).join('')}</div>`;
}

/* ── Reply Search ── */
function tmFilterReplies() {
    const term = (document.getElementById('tmReplySearch').value || '').trim().toLowerCase();
    if (!term) {
        tmRenderReplies(tmReplies, '');
        return;
    }
    // Filter: keep replies whose title, content, author, or attachment names match
    const matched = tmReplies.filter(r =>
        (r.reply_title   || '').toLowerCase().includes(term) ||
        (r.reply_content || '').toLowerCase().includes(term) ||
        (r.author_name   || '').toLowerCase().includes(term) ||
        (r.file_name     || '').toLowerCase().includes(term) ||
        (r.external_link || '').toLowerCase().includes(term)
    );
    tmRenderReplies(matched, term);
}

/* ════════════════════════════════════════════
   COMPOSER HELPERS
════════════════════════════════════════════ */
function tmSetReplyingTo(replyId, authorName) {
    tmReplyParentId = replyId;
    document.getElementById('tmReplyingToName').textContent = authorName || 'reply';
    document.getElementById('tmReplyingToBox').classList.remove('hidden');
    document.getElementById('tmReplyContent').focus();
}
function tmClearReplyingTo() {
    tmReplyParentId = null;
    document.getElementById('tmReplyingToBox').classList.add('hidden');
}
function tmPreviewFile(input) {
    const file = input.files[0];
    if (!file) return;
    document.getElementById('tmFilePreviewName').textContent = file.name;
    document.getElementById('tmFilePreviewType').textContent = file.type || 'Unknown type';
    document.getElementById('tmFilePreview').classList.remove('hidden');
}
function tmClearFile() {
    const inp = document.getElementById('tmReplyFile');
    if (inp) inp.value = '';
    document.getElementById('tmFilePreview').classList.add('hidden');
}
function tmToggleLinkInput() {
    tmLinkInputShown = !tmLinkInputShown;
    document.getElementById('tmLinkInputWrap').classList.toggle('hidden', !tmLinkInputShown);
    if (tmLinkInputShown) document.getElementById('tmReplyLink').focus();
}

/* ════════════════════════════════════════════
   SUBMIT REPLY FROM MODAL
════════════════════════════════════════════ */
async function tmSubmitReply() {
    const content   = (document.getElementById('tmReplyContent').value || '').trim();
    const link      = tmLinkInputShown ? (document.getElementById('tmReplyLink').value || '').trim() : '';
    const fileInput = document.getElementById('tmReplyFile');
    if (!content) { toast('Reply content is required.', 'error'); return; }
    if (!tmCurrentForum) return;

    const fd = new FormData();
    fd.append('forum_id',      tmCurrentForum.forum_id);
    fd.append('reply_content', content);
    fd.append('external_link', link);
    if (tmReplyParentId) fd.append('parent_reply_id', tmReplyParentId);
    if (fileInput.files[0]) fd.append('reply_file', fileInput.files[0]);

    try {
        const res  = await fetch('/teacher/api/forum/reply', { method: 'POST', body: fd });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');

        // Reset composer
        document.getElementById('tmReplyContent').value = '';
        if (tmLinkInputShown) { document.getElementById('tmReplyLink').value = ''; tmToggleLinkInput(); }
        tmClearFile();
        tmClearReplyingTo();
        toast('Reply posted!', 'success');

        // Refresh
        const res2  = await fetch(`/teacher/api/forum/${tmCurrentForum.forum_id}`);
        const data2 = await res2.json();
        if (!res2.ok) throw new Error(data2.error || 'Failed');
        tmCurrentForum = data2.forum;
        tmReplies      = data2.replies || [];
        tmRenderModal(data2);

        // Also sync the list card
        const idx = ALL_FORUMS.findIndex(f => f.forum_id === tmCurrentForum.forum_id);
        if (idx > -1) { ALL_FORUMS[idx].reply_count = data2.forum.reply_count || 0; }
        updateStats(); applyFilters();
    } catch(e) { toast(e.message, 'error'); }
}

/* ════════════════════════════════════════════
   PIN / EDIT from modal header
════════════════════════════════════════════ */

/* ════════════════════════════════════════════
   THREAD STATUS UPDATE (PHASE 2)
════════════════════════════════════════════ */
async function tmUpdateStatus(status) {
    if (!tmCurrentForum) return;
    try {
        const res = await fetch(`/teacher/api/forum/${tmCurrentForum.forum_id}/status`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ status })
        });
        const data = await res.json();
        if (!res.ok || !data.success) throw new Error(data.error || 'Failed to update status');

        tmCurrentForum.status = status;
        tmCurrentForum.resolved_by = data.resolved_by;

        // Update list cache
        const idx = ALL_FORUMS.findIndex(f => f.forum_id === tmCurrentForum.forum_id);
        if (idx > -1) {
            ALL_FORUMS[idx].status = status;
            ALL_FORUMS[idx].resolved_by = data.resolved_by;
        }
        renderForumList(ALL_FORUMS);
        toast(`Thread marked as ${status.replace('_', ' ')}!`, 'success');
    } catch(e) {
        toast(e.message, 'error');
    }
}

async function tmTogglePin() {
    if (!tmCurrentForum) return;
    const newPin = tmCurrentForum.is_pinned ? 0 : 1;
    try {
        const res = await fetch(`/teacher/api/forum/${tmCurrentForum.forum_id}/pin`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_pinned: newPin })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        tmCurrentForum.is_pinned = newPin;
        const idx = ALL_FORUMS.findIndex(f => f.forum_id === tmCurrentForum.forum_id);
        if (idx > -1) ALL_FORUMS[idx].is_pinned = newPin;
        document.getElementById('tmPinBadge').classList.toggle('hidden', !newPin);
        document.getElementById('tmPinLabel').textContent = newPin ? 'Unpin' : 'Pin';
        updateStats(); applyFilters();
        toast(newPin ? 'Forum pinned!' : 'Forum unpinned.', 'success');
    } catch(e) { toast(e.message, 'error'); }
}

function tmOpenEdit() {
    if (!tmCurrentForum) return;
    // Sync the currentForum so the existing edit modal works
    currentForum = tmCurrentForum;
    openEditModal();
}

/* ── Also hook openDeleteForumModal to use tmCurrentForum when the detail modal is open ── */
const _origOpenDeleteForumModal = openDeleteForumModal;
function openDeleteForumModal() {
    if (!currentForum && tmCurrentForum) currentForum = tmCurrentForum;
    _origOpenDeleteForumModal();
}

/* ── After forum deleted, also close the thread detail modal ── */
const _origConfirmDeleteForum = confirmDeleteForum;
async function confirmDeleteForum() {
    await _origConfirmDeleteForum();
    closeModal('modalThreadDetail');
}

/* ── After delete reply, also refresh the modal if it's open ── */
const _origConfirmDeleteReply = confirmDeleteReply;
async function confirmDeleteReply() {
    try {
        const res  = await fetch(`/teacher/api/forum/reply/${deletingReplyId}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        closeModal('modalDeleteReply');
        toast('Reply deleted.', 'success');
        // If thread detail modal is open, refresh it
        const modal = document.getElementById('modalThreadDetail');
        if (modal.classList.contains('open') && tmCurrentForum) {
            const res2  = await fetch(`/teacher/api/forum/${tmCurrentForum.forum_id}`);
            const data2 = await res2.json();
            if (!res2.ok) throw new Error(data2.error || 'Failed');
            tmCurrentForum = data2.forum;
            tmReplies      = data2.replies || [];
            tmRenderModal(data2);
        } else {
            await refreshThread();
        }
    } catch(e) { toast(e.message, 'error'); }
}

/* ════════════════════════════════════════════
   FILE PREVIEW & DOWNLOAD SYSTEM
   Baby, ito ang mag-handle ng clicking ng files
════════════════════════════════════════════ */
function viewFile(filePath, fileName, fileType) {
    if (!filePath) return;

    // Path must match your app.use('/forum_uploads', express.static(...)) in app.js
    const fileUrl = `/forum_uploads/${filePath}`;

    // 1. IMAGE PREVIEW MODAL
    if (fileType && fileType.startsWith('image/')) {
        const modalId = 'f-preview-modal-' + Date.now();
        const previewModal = `
            <div id="${modalId}" class="fixed inset-0 z-[10000] flex items-center justify-center bg-black/90 p-4"
                 onclick="if(event.target===this)this.remove()">
                <div class="relative max-w-5xl w-full flex flex-col items-center" onclick="event.stopPropagation()">
                    <button onclick="document.getElementById('${modalId}').remove()"
                            class="absolute -top-10 right-0 text-white text-2xl font-bold hover:text-red-400 transition flex items-center gap-2">
                        <i class="fas fa-times"></i> Close
                    </button>
                    <img src="${fileUrl}"
                         class="max-h-[80vh] rounded-lg shadow-2xl object-contain"
                         onerror="document.getElementById('${modalId}').remove();alert('File not found: ${fileUrl}')">
                    <div class="mt-4 flex gap-3">
                        <a href="${fileUrl}" download="${fileName}"
                           class="bg-indigo-600 text-white px-6 py-2 rounded-full font-bold hover:bg-indigo-700 transition flex items-center gap-2">
                            <i class="fas fa-download"></i> Download Image
                        </a>
                    </div>
                </div>
            </div>`;
        document.body.insertAdjacentHTML('beforeend', previewModal);
        // Close on Escape key
        const escHandler = (e) => { if (e.key === 'Escape') { document.getElementById(modalId)?.remove(); document.removeEventListener('keydown', escHandler); } };
        document.addEventListener('keydown', escHandler);
    }
    // 2. PDF / Text / Video — open in new tab
    else if (fileType === 'application/pdf' || fileType === 'text/plain' || (fileType && fileType.startsWith('video/'))) {
        window.open(fileUrl, '_blank');
    }
    // 3. Everything else — direct download
    else {
        const link = document.createElement('a');
        link.href = fileUrl;
        link.download = fileName || 'download';
        document.body.appendChild(link);
        link.click();
        document.body.removeChild(link);
    }
}
</script>

