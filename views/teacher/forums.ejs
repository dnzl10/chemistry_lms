<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forums | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f0fdfa; background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px); background-size: 24px 24px; }
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        #mainScroll { overflow-y: auto; }
        #mainScroll::-webkit-scrollbar { width: 5px; }
        #mainScroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }

        .section-card { background: white; border-radius: 1.25rem; border: 1px solid #e2e8f0; overflow: hidden; }

        .forum-card { background: white; border: 1px solid #e2e8f0; border-radius: 1rem; padding: 16px 18px; transition: box-shadow .2s, border-color .2s, transform .15s; cursor: pointer; position: relative; }
        .forum-card:hover { box-shadow: 0 6px 20px rgba(99,102,241,.12); border-color: #c7d2fe; transform: translateY(-1px); }
        .forum-card.pinned { border-left: 3px solid #f59e0b; }
        .forum-card.pinned::before { content: '📌'; position: absolute; top: -8px; right: 12px; font-size: 14px; background: white; padding: 0 4px; border-radius: 4px; }

        .reply-card { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: .75rem; padding: 12px 14px; position: relative; }
        .reply-card.nested { margin-left: 28px; border-left: 3px solid #c7d2fe; background: #faf5ff; }
        .reply-card.teacher-reply { border-left: 3px solid #6366f1; background: #f5f3ff; }

        .form-input, .form-select, .form-textarea { width: 100%; padding: 8px 11px; border: 1px solid #e2e8f0; border-radius: 9px; font-size: 13px; font-family: 'Plus Jakarta Sans', sans-serif; color: #1e293b; outline: none; transition: border-color .2s, box-shadow .2s; background: white; }
        .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.1); }
        .form-textarea { resize: vertical; min-height: 80px; }
        .form-label { font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; display: block; }

        .btn { display: inline-flex; align-items: center; gap: 5px; padding: 7px 14px; border-radius: 9px; font-size: 12px; font-weight: 700; cursor: pointer; transition: all .15s; border: 1px solid transparent; font-family: 'Plus Jakarta Sans', sans-serif; }
        .btn-primary  { background: #6366f1; color: white; border-color: #4f46e5; }
        .btn-primary:hover { background: #4f46e5; }
        .btn-outline  { background: white; color: #475569; border-color: #e2e8f0; }
        .btn-outline:hover { border-color: #6366f1; color: #6366f1; background: #faf5ff; }
        .btn-danger   { background: white; color: #dc2626; border-color: #fca5a5; }
        .btn-danger:hover { background: #fff1f2; }
        .btn-warning  { background: white; color: #d97706; border-color: #fcd34d; }
        .btn-warning:hover { background: #fffbeb; }
        .btn-sm { padding: 5px 10px; font-size: 11px; }
        .btn-xs { padding: 3px 8px; font-size: 10px; border-radius: 6px; }

        .modal-backdrop { display: none; position: fixed; inset: 0; z-index: 200; background: rgba(15,23,42,.55); align-items: center; justify-content: center; padding: 16px; }
        .modal-backdrop.open { display: flex; }
        .modal-card { background: white; border-radius: 1.25rem; width: 100%; max-width: 640px; max-height: 92vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(15,23,42,.2); animation: mIn .2s ease; }
        .modal-card.lg { max-width: 820px; }
        .modal-card::-webkit-scrollbar { width: 4px; }
        .modal-card::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 9999px; }
        @keyframes mIn { from { opacity:0; transform:scale(.96) translateY(8px); } to { opacity:1; transform:scale(1) translateY(0); } }
        .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid #f1f5f9; position: sticky; top: 0; background: white; z-index: 5; }
        .modal-body   { padding: 18px 20px; display: flex; flex-direction: column; gap: 13px; }
        .modal-footer { padding: 14px 20px; border-top: 1px solid #f1f5f9; display: flex; justify-content: flex-end; gap: 8px; }

        .filter-pill { padding: 5px 12px; border-radius: 9999px; font-size: 11px; font-weight: 700; border: 1px solid #e2e8f0; background: white; color: #64748b; cursor: pointer; transition: all .15s; font-family: 'Plus Jakarta Sans', sans-serif; }
        .filter-pill:hover, .filter-pill.active { background: #ede9fe; border-color: #a5b4fc; color: #4f46e5; }

        #forum-toast { position: fixed; bottom: 24px; right: 24px; z-index: 999; background: #1e293b; color: white; padding: 10px 18px; border-radius: 10px; font-size: 13px; font-weight: 600; box-shadow: 0 8px 24px rgba(15,23,42,.2); transform: translateY(80px); opacity: 0; transition: all .3s ease; pointer-events: none; display: flex; align-items: center; gap: 8px; max-width: 320px; }
        #forum-toast.show { transform: translateY(0); opacity: 1; }
        #forum-toast.success { background: #064e3b; }
        #forum-toast.error   { background: #7f1d1d; }

        .badge { display: inline-flex; align-items: center; gap: 3px; padding: 2px 8px; border-radius: 9999px; font-size: 10px; font-weight: 700; }
        .badge-indigo  { background: #ede9fe; color: #5b21b6; }
        .badge-amber   { background: #fef3c7; color: #a16207; }
        .badge-emerald { background: #dcfce7; color: #15803d; }
        .badge-rose    { background: #fee2e2; color: #b91c1c; }
        .badge-cyan    { background: #cffafe; color: #0e7490; }
        .badge-slate   { background: #f1f5f9; color: #475569; }

        .search-input { border: 1px solid #e2e8f0; border-radius: 10px; padding: 8px 14px 8px 34px; font-size: 13px; font-family: 'Plus Jakarta Sans', sans-serif; outline: none; transition: border-color .2s, box-shadow .2s; background: white; width: 220px; }
        .search-input:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.1); }

        .file-attach-btn { display: inline-flex; align-items: center; gap: 5px; padding: 6px 12px; border-radius: 8px; font-size: 11px; font-weight: 700; border: 1.5px dashed #c7d2fe; background: #faf5ff; color: #6366f1; cursor: pointer; transition: all .15s; }
        .file-attach-btn:hover { background: #ede9fe; border-color: #a5b4fc; }
        .file-preview-box { border: 1px solid #e2e8f0; border-radius: 9px; padding: 10px 12px; background: #f8fafc; display: flex; align-items: center; gap: 10px; font-size: 12px; }

        .link-preview { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; background: white; }
        .link-preview-img { width: 80px; height: 60px; object-fit: cover; flex-shrink: 0; }
        .link-preview-body { padding: 8px 12px; flex: 1; }

        .thread-header { background: linear-gradient(135deg, #4f46e5 0%, #7c3aed 100%); border-radius: 1rem; padding: 20px 24px; color: white; position: relative; overflow: hidden; }
        .thread-header::before { content: ''; position: absolute; top: -30px; right: -30px; width: 120px; height: 120px; border-radius: 50%; background: rgba(255,255,255,.07); }
        .thread-header::after  { content: ''; position: absolute; bottom: -20px; right: 60px; width: 70px; height: 70px; border-radius: 50%; background: rgba(255,255,255,.05); }

        .avatar { border-radius: 10px; object-fit: cover; flex-shrink: 0; }

        @keyframes fadeUp { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
        .fade-in { animation: fadeUp .2s ease forwards; }

        .empty-state { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48px 24px; gap: 12px; text-align: center; }

        .divider-label { display: flex; align-items: center; gap: 8px; font-size: 11px; font-weight: 700; color: #94a3b8; text-transform: uppercase; letter-spacing: .06em; }
        .divider-label::before, .divider-label::after { content: ''; flex: 1; height: 1px; background: #e2e8f0; }

        .completion-bar { height: 6px; border-radius: 9999px; background: #e2e8f0; overflow: hidden; }
        .completion-fill { height: 100%; border-radius: 9999px; background: linear-gradient(90deg, #6366f1, #06b6d4); transition: width .4s ease; }

        .subject-tab { padding: 8px 14px; border-radius: 10px; font-size: 12px; font-weight: 700; color: #64748b; cursor: pointer; border: 1px solid transparent; transition: all .15s; white-space: nowrap; }
        .subject-tab:hover { background: #f1f5f9; color: #334155; }
        .subject-tab.active { background: #6366f1; color: white; border-color: #4f46e5; box-shadow: 0 2px 8px rgba(99,102,241,.3); }

        .view { display: none; }
        .view.active { display: block; }

        /* ── Thread Detail Modal ── */
        .thread-modal-card {
            background: white;
            border-radius: 1.25rem;
            width: 100%;
            max-width: 1100px;
            height: 90vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 20px 60px rgba(15,23,42,.25);
            animation: mIn .2s ease;
            overflow: hidden;
        }
        .thread-modal-body {
            display: flex;
            flex: 1;
            min-height: 0;
            overflow: hidden;
        }
        /* Left panel */
        .tm-left {
            width: 280px;
            flex-shrink: 0;
            border-right: 1px solid #f1f5f9;
            display: flex;
            flex-direction: column;
            background: #f8fafc;
            overflow: hidden;
        }
        .tm-left-tabs {
            display: flex;
            gap: 0;
            border-bottom: 1px solid #e2e8f0;
            background: white;
        }
        .tm-ltab {
            flex: 1;
            padding: 10px 8px;
            font-size: 11px;
            font-weight: 700;
            color: #64748b;
            cursor: pointer;
            border: none;
            background: transparent;
            border-bottom: 2px solid transparent;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: all .15s;
            text-align: center;
        }
        .tm-ltab:hover { color: #334155; }
        .tm-ltab.active { color: #6366f1; border-bottom-color: #6366f1; background: #faf5ff; }
        .tm-left-body { flex: 1; overflow-y: auto; padding: 10px; }
        .tm-left-body::-webkit-scrollbar { width: 4px; }
        .tm-left-body::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        /* Right panel */
        .tm-right {
            flex: 1;
            display: flex;
            flex-direction: column;
            min-width: 0;
            overflow: hidden;
        }
        .tm-right-scroll {
            flex: 1;
            overflow-y: auto;
            padding: 20px;
        }
        .tm-right-scroll::-webkit-scrollbar { width: 5px; }
        .tm-right-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }
        /* Reply composer at bottom of right panel */
        .tm-composer {
            border-top: 1px solid #f1f5f9;
            padding: 14px 20px;
            background: white;
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        /* File tab items */
        .file-tab-item {
            background: white;
            border: 1px solid #e2e8f0;
            border-radius: 10px;
            overflow: hidden;
            margin-bottom: 8px;
            transition: border-color .15s, box-shadow .15s;
        }
        .file-tab-item:hover { border-color: #c7d2fe; box-shadow: 0 2px 8px rgba(99,102,241,.08); }
        .file-thumb { width: 100%; height: 90px; object-fit: cover; display: block; background: #f1f5f9; }
        .file-thumb-placeholder { width: 100%; height: 64px; display: flex; align-items: center; justify-content: center; background: #f8fafc; }
        /* Link preview card inside file tab */
        .link-card { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; background: white; margin-bottom: 8px; transition: border-color .15s; }
        .link-card:hover { border-color: #c7d2fe; }
        .link-card-thumb { width: 100%; height: 80px; object-fit: cover; background: #f1f5f9; }
        .link-card-body { padding: 8px 10px; }
        /* Student row in left panel */
        .tm-student-row { display: flex; align-items: center; gap: 8px; padding: 7px 6px; border-radius: 8px; transition: background .12s; }
        .tm-student-row:hover { background: #f1f5f9; }
        /* Reply search bar */
        .reply-search { border: 1px solid #e2e8f0; border-radius: 9px; padding: 7px 12px 7px 32px; font-size: 12px; font-family: 'Plus Jakarta Sans', sans-serif; outline: none; width: 100%; transition: border-color .2s; background: white; }
        .reply-search:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.08); }
        /* Highlighted search match */
        .reply-highlight { background: #fef9c3; border-radius: 3px; padding: 0 1px; }

        .delete-confirm-zone { background: #fff1f2; border: 1.5px solid #fca5a5; border-radius: 10px; padding: 14px 16px; }

        /* Completion tracker panel */
        .student-done-row { display: flex; align-items: center; gap: 10px; padding: 8px 0; border-bottom: 1px solid #f1f5f9; }
        .student-done-row:last-child { border-bottom: none; }

        /* Nav active state */
        .nav-active {
            background: linear-gradient(135deg, #06b6d4 0%, #6366f1 100%) !important;
            color: white !important;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(6,182,212,0.3), 0 2px 8px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }

        /* Profile dropdown */
        .profile-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 210px;
            background: white;
            border-radius: 1rem;
            box-shadow: 0 8px 32px rgba(6,182,212,0.13), 0 2px 8px rgba(99,102,241,0.10);
            border: 1px solid #e0f2fe;
            z-index: 999;
            opacity: 0;
            transform: translateY(-6px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.18s ease, transform 0.18s ease;
        }
        .profile-dropdown.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all;
        }
        .profile-dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 700;
            color: #1e293b;
            cursor: pointer;
            transition: background 0.13s;
            border-radius: 0.75rem;
            text-decoration: none;
        }
        .profile-dropdown-item:hover { background: #f0f9ff; color: #0369a1; }
        .profile-dropdown-item.danger:hover { background: #fff1f2; color: #be123c; }
    </style>
</head>
<body class="text-slate-900">

<div id="forum-toast"><i class="fas fa-circle-check"></i> <span id="forum-toast-msg"></span></div>

<div class="flex min-h-screen relative overflow-x-hidden">

    <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-cyan-900/50 z-40 hidden md:hidden"></div>

        <aside id="sidebar" class="text-white w-64 flex-shrink-0 flex flex-col z-50 fixed inset-y-0 left-0 -translate-x-full md:translate-x-0 h-screen border-r border-indigo-900/60" style="background: linear-gradient(180deg, #0d1a2e 0%, #0b1523 100%);">
            <div class="pt-8 pb-4 px-4 flex flex-col items-center text-center relative">
                <!-- Mobile close button -->
                <button onclick="toggleSidebar()" class="md:hidden text-indigo-300 hover:text-white absolute top-4 right-4">
                    <i class="fas fa-times text-xl"></i>
                </button>

                <!-- Logo -->
                <img src="/assets/logo.png" alt="ChemArcade Logo" class="w-16 h-16 object-contain mb-3">

                <!-- Brand name -->
                <h1 class="text-xl font-black tracking-tighter text-cyan-400 uppercase italic leading-none">
                    Elem<span class="text-white">enta</span>
                </h1>
                <p class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest mt-1">Teacher Portal</p>

                <!-- Divider -->
                <!-- <div class="w-full mt-5 border-t border-indigo-800/60"></div> -->
            </div>

            <nav class="flex-1 px-4 mt-4 space-y-6 overflow-y-auto no-scrollbar pb-6">

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Main Interface</p>


                    <div class="space-y-1">
                        <a href="/teacher/dashboard" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-chart-pie w-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Dashboard</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Academic Management</p>
                    <div class="space-y-1">
                        <a href="/teacher/classes" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-chalkboard-user w-5 text-emerald-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">My Classes</span>
                        </a>
                    </div>

                    <div class="space-y-1">
                        <a href="/teacher/question-bank" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-database w-5 text-rose-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Question Bank</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Engagement and Communication</p>
                    <div class="space-y-1">
                        <a href="/teacher/forums" class="nav-active flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-comments w-5 text-amber-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Forums</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Reports and Analytics</p>
                    <div class="space-y-1">
                        <a href="/teacher/reports" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-file-export w-5 text-fuchsia-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Reports</span>
                        </a>
                    </div>
                </div>
            </nav>

            <div class="p-4 border-t" style="border-color: rgba(99,102,241,0.25);">
                <a href="/logout"
                class="flex items-center gap-3 p-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition group font-bold">
                    <i class="fas fa-right-from-bracket w-5"></i> Log Out
                </a>
            </div>
        </aside>

    <!-- ===== MAIN ===== -->
    <main class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- Header -->
        <header class="h-20 bg-white/90 backdrop-blur-md border-b border-cyan-100 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-cyan-50 text-cyan-600 md:hidden">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <div class="hidden sm:block">
                    <h2 class="text-lg font-black text-indigo-900 uppercase tracking-tight">Forums</h2>
                    <p class="text-xs text-slate-400">Manage discussions per subject</p>
                </div>
            </div>
            <div class="flex items-center gap-3 md:gap-6">
                <div class="relative cursor-pointer p-2 hover:bg-cyan-50 rounded-full transition" onclick="toggleNotifPanel()">
                    <i class="far fa-bell text-xl text-cyan-600"></i>
                    <% if (notifications && notifications.length > 0) { %>
                    <span class="absolute top-2 right-2 flex h-2.5 w-2.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                    </span>
                    <% } %>
                </div>
                <div class="flex items-center gap-3 pl-4 border-l border-cyan-100">
                        <div class="text-right hidden lg:block">
                            <p class="text-sm font-bold text-indigo-900"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-[10px] uppercase font-black text-cyan-500 tracking-widest">Teacher</p>
                        </div>
                        <!-- Profile dropdown trigger -->
                        <div class="relative" id="profileDropdownWrap">
                            <button onclick="toggleProfileDropdown()"
                                    class="block rounded-xl ring-2 ring-cyan-400 shadow-sm shadow-cyan-200 hover:ring-indigo-400 transition focus:outline-none">
                                <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                                     class="w-10 h-10 rounded-xl object-cover">
                            </button>
                            <div class="profile-dropdown" id="profileDropdown">
                                <!-- User info mini card -->
                                <div class="px-4 pt-4 pb-3 border-b border-slate-100">
                                    <div class="flex items-center gap-3">
                                        <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                                             class="w-9 h-9 rounded-xl object-cover ring-2 ring-cyan-300">
                                        <div class="min-w-0">
                                            <p class="text-xs font-black text-indigo-900 truncate"><%= user.first_name %> <%= user.last_name %></p>
                                            <p class="text-[10px] text-cyan-500 font-bold uppercase tracking-widest">Teacher</p>
                                        </div>
                                    </div>
                                </div>
                                <!-- Options -->
                                <div class="p-2">
                                    <a href="/teacher/profile" class="profile-dropdown-item">
                                        <i class="fas fa-user-circle text-cyan-500 w-4 text-center"></i>
                                        View Profile
                                    </a>
                                    <a href="/logout" class="profile-dropdown-item danger">
                                        <i class="fas fa-right-from-bracket text-rose-400 w-4 text-center"></i>
                                        Logout
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
            </div>
        </header>

        <!-- ===== SCROLL AREA ===== -->
        <div id="mainScroll" class="flex-1 overflow-y-auto pt-20">
            <div class="p-4 md:p-8 flex flex-col gap-6 min-h-full">

                <!-- ── STAT CARDS ── -->
                <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                    <div class="section-card p-4 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-comments text-indigo-500"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wide">Total Forums</p>
                            <p class="text-2xl font-black text-indigo-700" id="stat-total"><%= allForumsData.length %></p>
                        </div>
                    </div>
                    <div class="section-card p-4 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-thumbtack text-amber-500"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wide">Pinned</p>
                            <p class="text-2xl font-black text-amber-600" id="stat-pinned"><%= forums.filter(f=>f.is_pinned).length %></p>
                        </div>
                    </div>
                    <div class="section-card p-4 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-reply-all text-emerald-500"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wide">Total Replies</p>
                            <p class="text-2xl font-black text-emerald-600" id="stat-replies">
                                <%= forums.reduce((a,f) => a + (f.reply_count||0), 0) %>
                            </p>
                        </div>
                    </div>
                    <div class="section-card p-4 flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-cyan-100 flex items-center justify-center flex-shrink-0">
                            <i class="fas fa-check-double text-cyan-500"></i>
                        </div>
                        <div>
                            <p class="text-xs font-bold text-slate-400 uppercase tracking-wide">Completions</p>
                            <p class="text-2xl font-black text-cyan-600" id="stat-done">
                                <%= forums.reduce((a,f) => a + (f.done_count||0), 0) %>
                            </p>
                        </div>
                    </div>
                </div>

                <!-- ── TOOLBAR ── -->
                <div class="section-card">
                    <div class="p-4 flex flex-col md:flex-row gap-3 items-start md:items-center justify-between">
                        <!-- Subject tabs -->
                        <div class="flex gap-2 overflow-x-auto no-scrollbar pb-1 flex-wrap">
                            <button class="subject-tab active" data-subject="all" onclick="filterSubject('all',this)">
                                <i class="fas fa-globe-asia mr-1"></i> All Subjects
                            </button>
                            <% subjects.forEach(s => { %>
                            <button class="subject-tab" data-subject="<%= s.subject_id %>" onclick="filterSubject('<%= s.subject_id %>',this)">
                                <%= s.subject_name %>
                            </button>
                            <% }) %>
                        </div>

                        <!-- Right controls -->
                        <div class="flex items-center gap-2 flex-shrink-0">
                            <!-- Search -->
                            <div class="relative">
                                <i class="fas fa-search absolute left-3 top-1/2 -translate-y-1/2 text-slate-400 text-xs pointer-events-none"></i>
                                <input type="text" id="searchInput" class="search-input" placeholder="Search forums…" oninput="applyFilters()">
                            </div>
                            <!-- Sort -->
                            <select id="sortSelect" class="form-select" style="width:auto;padding:8px 10px;" onchange="applyFilters()">
                                <option value="newest">Newest First</option>
                                <option value="oldest">Oldest First</option>
                                <option value="most_replies">Most Replies</option>
                                <option value="pinned">Pinned First</option>
                            </select>
                            <!-- Filter: pin -->
                            <button class="filter-pill" id="pillPin" onclick="togglePill('pin',this)">
                                <i class="fas fa-thumbtack mr-1"></i>Pinned
                            </button>
                            <!-- New forum -->
                            <button class="btn btn-primary" onclick="openCreateModal()">
                                <i class="fas fa-plus"></i> New Forum
                            </button>
                        </div>
                    </div>

                    <!-- Topic filter row (per subject) -->
                    <div id="topicFilterRow" class="px-4 pb-3 flex gap-2 flex-wrap">
                        <button class="filter-pill active" data-topic="all" onclick="filterTopic('all',this)">All Topics</button>
                        <% topics.forEach(t => { %>
                        <button class="filter-pill" data-topic="<%= t.topic_id %>" data-subject="<%= t.subject_id %>" onclick="filterTopic('<%= t.topic_id %>',this)">
                            Q<%= t.quarter_number %> · <%= t.topic_name %>
                        </button>
                        <% }) %>
                    </div>
                </div>

                <!-- ── FORUM LIST VIEW ── -->
                <div id="forumListView" class="view active flex flex-col gap-3">
                    <div id="forumListInner" class="flex flex-col gap-3">
                        <!-- rendered by JS -->
                    </div>
                    <div id="emptyState" class="section-card empty-state hidden">
                        <div class="w-16 h-16 rounded-2xl bg-indigo-50 flex items-center justify-center">
                            <i class="fas fa-comments text-indigo-300 text-3xl"></i>
                        </div>
                        <p class="font-black text-slate-500 text-base">No forums found</p>
                        <p class="text-xs text-slate-400 max-w-xs">Create a new forum thread or adjust your filters.</p>
                        <button class="btn btn-primary mt-2" onclick="openCreateModal()"><i class="fas fa-plus"></i> Create Forum</button>
                    </div>
                </div>

                <!-- Thread detail is now inside modalThreadDetail — placeholder kept for layout -->
                <div id="threadView" class="view flex flex-col gap-4" style="display:none!important"></div>

                <!-- Footer -->
                <footer class="bg-white border-t border-cyan-100 py-6 px-8 w-full rounded-2xl">
                    <div class="flex flex-col md:flex-row justify-between items-center gap-2">
                        <p class="text-[11px] text-indigo-400 font-black uppercase tracking-tight">
                            &copy; 2026 <span class="text-cyan-600">Chemistry Arcade</span> - Mabini College v2.5.0
                        </p>
                        <div class="flex gap-4">
                            <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest">Support Lab</a>
                            <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest border-l pl-4 border-indigo-100">Atomic Logs</a>
                        </div>
                    </div>
                </footer>

            </div>
        </div><!-- /mainScroll -->
    </main>
</div>

<!-- =====================================================================
     MODALS
===================================================================== -->

<!-- CREATE FORUM MODAL -->
<div id="modalCreate" class="modal-backdrop">
    <div class="modal-card">
        <div class="modal-header">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center">
                    <i class="fas fa-plus text-indigo-500 text-sm"></i>
                </div>
                <span class="font-black text-slate-800">New Forum Thread</span>
            </div>
            <button onclick="closeModal('modalCreate')" class="text-slate-400 hover:text-slate-700 text-xl leading-none">&times;</button>
        </div>
        <div class="modal-body">
            <div>
                <label class="form-label">Subject *</label>
                <select id="createSubjectId" class="form-select" onchange="populateTopicSelect('createTopicId','createSubjectId')">
                    <% subjects.forEach(s => { %>
                    <option value="<%= s.subject_id %>"><%= s.subject_name %></option>
                    <% }) %>
                </select>
            </div>
            <div>
                <label class="form-label">Curriculum Topic (optional)</label>
                <select id="createTopicId" class="form-select">
                    <option value="">— No specific topic —</option>
                </select>
            </div>
            <div>
                <label class="form-label">Title *</label>
                <input id="createTitle" type="text" class="form-input" placeholder="Enter forum title…" maxlength="255">
            </div>
            <div>
                <label class="form-label">Content</label>
                <textarea id="createContent" class="form-textarea" placeholder="Describe the discussion topic…" rows="5"></textarea>
            </div>
            <div class="flex items-center gap-2">
                <input type="checkbox" id="createPinned" class="rounded">
                <label for="createPinned" class="text-sm font-semibold text-slate-600 cursor-pointer">📌 Pin this forum thread</label>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('modalCreate')">Cancel</button>
            <button class="btn btn-primary" onclick="submitCreateForum()"><i class="fas fa-paper-plane"></i> Post Forum</button>
        </div>
    </div>
</div>

<!-- EDIT FORUM MODAL -->
<div id="modalEdit" class="modal-backdrop">
    <div class="modal-card">
        <div class="modal-header">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-amber-100 flex items-center justify-center">
                    <i class="fas fa-pen text-amber-500 text-sm"></i>
                </div>
                <span class="font-black text-slate-800">Edit Forum Thread</span>
            </div>
            <button onclick="closeModal('modalEdit')" class="text-slate-400 hover:text-slate-700 text-xl leading-none">&times;</button>
        </div>
        <div class="modal-body">
            <div>
                <label class="form-label">Title *</label>
                <input id="editTitle" type="text" class="form-input" maxlength="255">
            </div>
            <div>
                <label class="form-label">Content</label>
                <textarea id="editContent" class="form-textarea" rows="5"></textarea>
            </div>
            <div>
                <label class="form-label">Curriculum Topic</label>
                <select id="editTopicId" class="form-select">
                    <option value="">— No specific topic —</option>
                    <% topics.forEach(t => { %>
                    <option value="<%= t.topic_id %>">Q<%= t.quarter_number %> · <%= t.topic_name %></option>
                    <% }) %>
                </select>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('modalEdit')">Cancel</button>
            <button class="btn btn-primary" onclick="submitEditForum()"><i class="fas fa-save"></i> Save Changes</button>
        </div>
    </div>
</div>

<!-- DELETE FORUM MODAL -->
<div id="modalDeleteForum" class="modal-backdrop">
    <div class="modal-card" style="max-width:420px;">
        <div class="modal-header">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-rose-100 flex items-center justify-center">
                    <i class="fas fa-trash text-rose-500 text-sm"></i>
                </div>
                <span class="font-black text-slate-800">Delete Forum</span>
            </div>
            <button onclick="closeModal('modalDeleteForum')" class="text-slate-400 hover:text-slate-700 text-xl">&times;</button>
        </div>
        <div class="modal-body">
            <div class="delete-confirm-zone">
                <p class="text-sm font-bold text-rose-700 mb-1"><i class="fas fa-triangle-exclamation mr-2"></i>This action is permanent!</p>
                <p class="text-xs text-rose-600">Deleting this forum will also remove all replies and nested threads. This cannot be undone.</p>
            </div>
            <p class="text-sm text-slate-600">Are you sure you want to delete <strong id="deletingForumTitle" class="text-slate-800"></strong>?</p>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('modalDeleteForum')">Cancel</button>
            <button class="btn btn-danger" onclick="confirmDeleteForum()"><i class="fas fa-trash"></i> Yes, Delete</button>
        </div>
    </div>
</div>

<!-- REPLY MODAL -->
<div id="modalReply" class="modal-backdrop">
    <div class="modal-card">
        <div class="modal-header">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-emerald-100 flex items-center justify-center">
                    <i class="fas fa-reply text-emerald-500 text-sm"></i>
                </div>
                <span class="font-black text-slate-800" id="replyModalTitle">Post a Reply</span>
            </div>
            <button onclick="closeModal('modalReply')" class="text-slate-400 hover:text-slate-700 text-xl leading-none">&times;</button>
        </div>
        <div class="modal-body">
            <div id="replyingToBox" class="hidden">
                <div class="file-preview-box text-xs text-slate-500">
                    <i class="fas fa-reply text-indigo-400"></i>
                    <span>Replying to: <strong id="replyingToName" class="text-slate-700"></strong></span>
                </div>
            </div>
            <div>
                <label class="form-label">Your Reply *</label>
                <textarea id="replyContent" class="form-textarea" placeholder="Write your reply…" rows="4"></textarea>
            </div>
            <!-- File attachment -->
            <div>
                <label class="form-label">Attachment (optional)</label>
                <label class="file-attach-btn" for="replyFile">
                    <i class="fas fa-paperclip"></i> Attach File
                </label>
                <input type="file" id="replyFile" class="hidden" onchange="previewFile(this)">
                <div id="filePreview" class="hidden mt-2 file-preview-box">
                    <i class="fas fa-file text-indigo-400 text-lg"></i>
                    <div class="flex-1 min-w-0">
                        <p class="font-bold text-slate-700 truncate" id="filePreviewName"></p>
                        <p class="text-[10px] text-slate-400" id="filePreviewType"></p>
                    </div>
                    <button onclick="clearFile()" class="text-rose-400 hover:text-rose-600 text-xs font-bold"><i class="fas fa-times"></i></button>
                </div>
            </div>
            <!-- External link -->
            <div>
                <label class="form-label">External Link (optional)</label>
                <input type="url" id="replyLink" class="form-input" placeholder="https://…">
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('modalReply')">Cancel</button>
            <button class="btn btn-primary" onclick="submitReply()"><i class="fas fa-paper-plane"></i> Post Reply</button>
        </div>
    </div>
</div>

<!-- DELETE REPLY MODAL -->
<div id="modalDeleteReply" class="modal-backdrop">
    <div class="modal-card" style="max-width:420px;">
        <div class="modal-header">
            <div class="flex items-center gap-2">
                <div class="w-8 h-8 rounded-lg bg-rose-100 flex items-center justify-center">
                    <i class="fas fa-trash text-rose-500 text-sm"></i>
                </div>
                <span class="font-black text-slate-800">Delete Reply</span>
            </div>
            <button onclick="closeModal('modalDeleteReply')" class="text-slate-400 hover:text-slate-700 text-xl">&times;</button>
        </div>
        <div class="modal-body">
            <div class="delete-confirm-zone">
                <p class="text-sm font-bold text-rose-700"><i class="fas fa-triangle-exclamation mr-2"></i>Deleting a reply will also remove all nested replies.</p>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('modalDeleteReply')">Cancel</button>
            <button class="btn btn-danger" onclick="confirmDeleteReply()"><i class="fas fa-trash"></i> Delete Reply</button>
        </div>
    </div>
</div>

<!-- =====================================================================
     THREAD DETAIL MODAL
===================================================================== -->
<div id="modalThreadDetail" class="modal-backdrop" style="align-items:center;padding:12px;">
    <div class="thread-modal-card">

        <!-- ── Modal Header (thread title + actions) ── -->
        <div class="modal-header" style="padding:14px 20px;flex-shrink:0;">
            <div class="flex items-center gap-3 min-w-0 flex-1">
                <div class="w-8 h-8 rounded-lg bg-indigo-100 flex items-center justify-center flex-shrink-0">
                    <i class="fas fa-comments text-indigo-500 text-sm"></i>
                </div>
                <div class="min-w-0">
                    <p class="font-black text-slate-800 text-sm truncate" id="tmTitle">Loading…</p>
                    <div class="flex items-center gap-2 mt-0.5 flex-wrap">
                        <span id="tmPinBadge" class="hidden badge badge-amber"><i class="fas fa-thumbtack"></i> Pinned</span>
                        <span id="tmTopicBadge" class="badge badge-cyan" style="display:none"></span>
                        <span id="tmSubjectBadge" class="badge badge-indigo"></span>
                        <span class="text-[10px] text-slate-400"><i class="far fa-clock mr-1"></i><span id="tmDate"></span></span>
                        <span class="text-[10px] text-slate-400"><i class="fas fa-reply mr-1"></i><span id="tmReplyCount">0</span> replies</span>
                    </div>
                </div>
            </div>
            <div class="flex items-center gap-2 flex-shrink-0">
                <button class="btn btn-sm btn-outline" id="tmBtnPin" onclick="tmTogglePin()">
                    <i class="fas fa-thumbtack text-xs"></i> <span id="tmPinLabel">Pin</span>
                </button>
                <button class="btn btn-sm btn-outline" onclick="tmOpenEdit()">
                    <i class="fas fa-pen text-xs"></i> Edit
                </button>
                <button class="btn btn-sm btn-danger" onclick="openDeleteForumModal()">
                    <i class="fas fa-trash text-xs"></i>
                </button>
                <button onclick="closeModal('modalThreadDetail')" class="w-8 h-8 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 ml-1">
                    <i class="fas fa-times"></i>
                </button>
            </div>
        </div>

        <!-- ── Modal Body: Left panel + Right panel ── -->
        <div class="thread-modal-body">

            <!-- ════ LEFT PANEL ════ -->
            <div class="tm-left">
                <div class="tm-left-tabs">
                    <button class="tm-ltab active" id="ltab-students" onclick="switchLTab('students')">
                        <i class="fas fa-users mr-1"></i> Students
                    </button>
                    <button class="tm-ltab" id="ltab-files" onclick="switchLTab('files')">
                        <i class="fas fa-paperclip mr-1"></i> Files
                    </button>
                </div>

                <!-- Students tab -->
                <div id="lpanel-students" class="tm-left-body">
                    <!-- Completion bar -->
                    <div style="padding:8px 4px 10px;">
                        <div class="flex items-center justify-between mb-1">
                            <span class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Completion</span>
                            <span class="text-xs font-black text-indigo-600" id="tmCompLabel">0%</span>
                        </div>
                        <div class="completion-bar">
                            <div class="completion-fill" id="tmCompFill" style="width:0%"></div>
                        </div>
                    </div>
                    <div id="tmStudentList">
                        <p class="text-xs text-slate-400 text-center py-4">No students enrolled.</p>
                    </div>
                </div>

                <!-- Files tab -->
                <div id="lpanel-files" class="tm-left-body" style="display:none">
                    <div id="tmFileList">
                        <p class="text-xs text-slate-400 text-center py-4">No files shared yet.</p>
                    </div>
                </div>
            </div>

            <!-- ════ RIGHT PANEL ════ -->
            <div class="tm-right">

                <!-- Thread content -->
                <div id="tmContentWrap" class="tm-right-scroll" style="max-height:none;flex:none;border-bottom:1px solid #f1f5f9;padding-bottom:16px;">
                    <!-- Gradient header -->
                    <div class="thread-header mb-4" id="tmHeader">
                        <div class="flex items-start gap-3 relative z-10">
                            <img id="tmTeacherPic" src="/profile_uploads/default_avatar.png"
                                 class="avatar w-9 h-9 flex-shrink-0"
                                 onerror="this.src='/profile_uploads/default_avatar.png'">
                            <div>
                                <p class="text-white font-black text-sm" id="tmTeacherName"></p>
                                <p class="text-white/60 text-xs" id="tmPostedAgo"></p>
                            </div>
                        </div>
                        <h2 id="tmHeaderTitle" class="text-lg font-black text-white mt-3 leading-tight break-words relative z-10"></h2>
                    </div>
                    <p id="tmContent" class="text-sm text-slate-700 leading-relaxed whitespace-pre-line px-1"></p>
                </div>

                <!-- Replies section -->
                <div class="tm-right-scroll" style="flex:1;">
                    <!-- Replies header + search -->
                    <div class="flex items-center justify-between gap-3 mb-4 flex-wrap">
                        <div class="flex items-center gap-2">
                            <i class="fas fa-comments text-indigo-400 text-sm"></i>
                            <span class="text-sm font-black text-slate-700">Replies</span>
                            <span class="badge badge-indigo" id="tmReplyBadge">0</span>
                        </div>
                        <div class="flex items-center gap-2">
                            <!-- Search replies -->
                            <div class="relative">
                                <i class="fas fa-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);font-size:11px;color:#94a3b8;pointer-events:none;"></i>
                                <input type="text" id="tmReplySearch" class="reply-search" placeholder="Search replies…" oninput="tmFilterReplies()" style="width:180px;">
                            </div>
                        </div>
                    </div>
                    <div id="tmRepliesContainer">
                        <div class="empty-state" style="padding:24px">
                            <i class="fas fa-spinner fa-spin text-indigo-400 text-2xl"></i>
                        </div>
                    </div>
                </div>

                <!-- ── Composer (always visible at bottom) ── -->
                <div class="tm-composer">
                    <div id="tmReplyingToBox" class="hidden">
                        <div class="file-preview-box text-xs text-slate-500" style="padding:6px 10px;">
                            <i class="fas fa-reply text-indigo-400 text-xs"></i>
                            <span>Replying to: <strong id="tmReplyingToName" class="text-slate-700"></strong></span>
                            <button onclick="tmClearReplyingTo()" class="ml-auto text-slate-400 hover:text-rose-500 text-xs"><i class="fas fa-times"></i></button>
                        </div>
                    </div>
                    <div class="flex gap-2 items-end">
                        <textarea id="tmReplyContent" class="form-textarea" placeholder="Write a reply…" rows="2"
                                  style="flex:1;min-height:60px;resize:none;font-size:13px;"
                                  onkeydown="if(event.ctrlKey&&event.key==='Enter')tmSubmitReply()"></textarea>
                        <div class="flex flex-col gap-1">
                            <label class="file-attach-btn" for="tmReplyFile" title="Attach file">
                                <i class="fas fa-paperclip"></i>
                            </label>
                            <input type="file" id="tmReplyFile" class="hidden" onchange="tmPreviewFile(this)">
                            <button class="btn btn-primary btn-sm" onclick="tmSubmitReply()" title="Post reply (Ctrl+Enter)">
                                <i class="fas fa-paper-plane text-xs"></i>
                            </button>
                        </div>
                    </div>
                    <!-- File preview row -->
                    <div id="tmFilePreview" class="hidden file-preview-box" style="padding:7px 10px;">
                        <i class="fas fa-file text-indigo-400"></i>
                        <div class="flex-1 min-w-0">
                            <p class="font-bold text-slate-700 truncate text-xs" id="tmFilePreviewName"></p>
                            <p class="text-[10px] text-slate-400" id="tmFilePreviewType"></p>
                        </div>
                        <button onclick="tmClearFile()" class="text-rose-400 hover:text-rose-600 text-xs font-bold ml-2"><i class="fas fa-times"></i></button>
                    </div>
                    <!-- Link input toggle -->
                    <div class="flex items-center gap-2">
                        <button onclick="tmToggleLinkInput()" class="text-[11px] text-indigo-500 font-bold hover:underline">
                            <i class="fas fa-link mr-1"></i> Add link
                        </button>
                        <span id="tmLinkInputWrap" class="hidden flex-1">
                            <input type="url" id="tmReplyLink" class="form-input" placeholder="https://…" style="font-size:12px;padding:5px 8px;">
                        </span>
                    </div>
                </div>

            </div><!-- /tm-right -->
        </div><!-- /thread-modal-body -->
    </div>
</div>

<!-- =====================================================================
     EJS DATA BRIDGE + JAVASCRIPT
===================================================================== -->
<script>
/* ── RAW DATA FROM SERVER ── */
const ALL_FORUMS   = <%- JSON.stringify(forums) %>;
const ALL_SUBJECTS = <%- JSON.stringify(subjects) %>;
const ALL_TOPICS   = <%- JSON.stringify(topics) %>;
const ALL_STUDENTS = <%- JSON.stringify(enrolledStudents) %>;
const TEACHER_ID   = <%= user.user_id %>;
const TEACHER_NAME = "<%= user.first_name %> <%= user.last_name %>";
const TEACHER_PIC  = "<%= user.profile_pic || 'default_avatar.png' %>";

/* ── STATE ── */
let activeSubject  = 'all';
let activeTopic    = 'all';
let filterPin      = false;
let currentForum   = null;   // full forum object being viewed
let replyParentId  = null;   // null = top-level reply
let deletingReplyId = null;

/* ════════════════════════════════════════════
   SIDEBAR
════════════════════════════════════════════ */
function toggleSidebar() {
    const s = document.getElementById('sidebar');
    const o = document.getElementById('sidebarOverlay');
    const hidden = s.classList.contains('-translate-x-full');
    s.classList.toggle('-translate-x-full', !hidden);
    o.classList.toggle('hidden', !hidden);
}

/* ════════════════════════════════════════════
   TOAST
════════════════════════════════════════════ */
function toast(msg, type = 'success') {
    const el = document.getElementById('forum-toast');
    const msgEl = document.getElementById('forum-toast-msg');
    el.className = 'show ' + type;
    msgEl.textContent = msg;
    setTimeout(() => { el.className = ''; }, 3200);
}

/* ════════════════════════════════════════════
   MODAL HELPERS
════════════════════════════════════════════ */
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-backdrop').forEach(m => {
    m.addEventListener('click', e => { if (e.target === m) m.classList.remove('open'); });
});

/* ════════════════════════════════════════════
   TOPIC SELECT POPULATION
════════════════════════════════════════════ */
function populateTopicSelect(targetId, subjectSelId) {
    const subjectId = document.getElementById(subjectSelId).value;
    const sel = document.getElementById(targetId);
    sel.innerHTML = '<option value="">— No specific topic —</option>';
    ALL_TOPICS.filter(t => String(t.subject_id) === String(subjectId)).forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.topic_id;
        opt.textContent = `Q${t.quarter_number} · ${t.topic_name}`;
        sel.appendChild(opt);
    });
}

/* ════════════════════════════════════════════
   FILTERING & SORTING
════════════════════════════════════════════ */
function filterSubject(sid, btn) {
    activeSubject = String(sid);
    document.querySelectorAll('.subject-tab').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');

    // show/hide topic pills
    document.querySelectorAll('#topicFilterRow .filter-pill').forEach(p => {
        const ps = p.dataset.subject;
        if (!ps || activeSubject === 'all' || ps === activeSubject) {
            p.style.display = '';
        } else {
            p.style.display = 'none';
        }
    });
    activeTopic = 'all';
    document.querySelector('#topicFilterRow [data-topic="all"]').classList.add('active');
    document.querySelectorAll('#topicFilterRow [data-topic]:not([data-topic="all"])').forEach(p => p.classList.remove('active'));
    applyFilters();
}

function filterTopic(tid, btn) {
    activeTopic = String(tid);
    document.querySelectorAll('#topicFilterRow .filter-pill').forEach(p => p.classList.remove('active'));
    btn.classList.add('active');
    applyFilters();
}

function togglePill(type, btn) {
    if (type === 'pin') { filterPin = !filterPin; btn.classList.toggle('active', filterPin); }
    applyFilters();
}

function applyFilters() {
    let list = [...ALL_FORUMS];
    const search = document.getElementById('searchInput').value.trim().toLowerCase();
    const sort   = document.getElementById('sortSelect').value;

    if (activeSubject !== 'all') list = list.filter(f => String(f.subject_id) === activeSubject);
    if (activeTopic   !== 'all') list = list.filter(f => String(f.topic_id)   === activeTopic);
    if (filterPin)                list = list.filter(f => f.is_pinned);
    if (search)                   list = list.filter(f => f.title.toLowerCase().includes(search));

    if (sort === 'newest')       list.sort((a,b) => new Date(b.created_at) - new Date(a.created_at));
    else if (sort === 'oldest')  list.sort((a,b) => new Date(a.created_at) - new Date(b.created_at));
    else if (sort === 'most_replies') list.sort((a,b) => (b.reply_count||0) - (a.reply_count||0));
    else if (sort === 'pinned')  list.sort((a,b) => b.is_pinned - a.is_pinned);

    renderForumList(list);
}

/* ════════════════════════════════════════════
   RENDER FORUM LIST
════════════════════════════════════════════ */
function renderForumList(list) {
    const container = document.getElementById('forumListInner');
    const empty     = document.getElementById('emptyState');

    if (!list.length) {
        container.innerHTML = '';
        empty.classList.remove('hidden');
        return;
    }
    empty.classList.add('hidden');

    // pinned first within the passed list (already sorted externally; just visually mark)
    container.innerHTML = list.map(f => {
        const subject  = ALL_SUBJECTS.find(s => s.subject_id === f.subject_id) || {};
        const topic    = ALL_TOPICS.find(t => t.topic_id === f.topic_id) || null;
        const lastAct  = f.last_reply_at ? timeAgo(f.last_reply_at) : timeAgo(f.created_at);
        const doneRate = f.enrolled_count ? Math.round((f.done_count / f.enrolled_count) * 100) : 0;

        return `<div class="forum-card fade-in ${f.is_pinned ? 'pinned' : ''}" onclick="openThreadModal(${f.forum_id})">
            <div class="flex items-start gap-3">
                <img src="/profile_uploads/${f.teacher_pic || 'default_avatar.png'}"
                     class="avatar w-9 h-9 mt-0.5"
                     onerror="this.src='/profile_uploads/default_avatar.png'">
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap mb-1">
                        ${f.is_pinned ? '<span class="badge badge-amber"><i class="fas fa-thumbtack"></i> Pinned</span>' : ''}
                        <span class="badge badge-indigo">${escHtml(subject.subject_name) || '—'}</span>
                        ${topic ? `<span class="badge badge-cyan">Q${topic.quarter_number} · ${escHtml(topic.topic_name)}</span>` : ''}
                    </div>
                    <h3 class="font-black text-slate-800 text-sm leading-tight mb-1 truncate">${escHtml(f.title)}</h3>
                    <p class="text-xs text-slate-500 truncate">${escHtml((f.forum_content || '').slice(0, 120))}</p>
                    <div class="flex items-center gap-4 mt-2 text-[10px] text-slate-400 flex-wrap">
                        <span><i class="far fa-clock mr-1"></i>${timeAgo(f.created_at)}</span>
                        <span><i class="fas fa-reply mr-1"></i>${f.reply_count || 0} replies</span>
                        <span><i class="fas fa-bolt mr-1 text-amber-400"></i>Active ${lastAct}</span>
                        <span class="flex items-center gap-1.5">
                            <i class="fas fa-check-double mr-0.5 text-emerald-400"></i>
                            ${f.done_count || 0}/${f.enrolled_count || 0} done
                            <span class="inline-block w-16 h-1.5 rounded-full bg-slate-200 overflow-hidden">
                                <span class="block h-full rounded-full bg-emerald-400" style="width:${doneRate}%"></span>
                            </span>
                        </span>
                    </div>
                </div>
                <div class="flex flex-col items-end gap-1 flex-shrink-0">
                    <span class="text-[10px] text-slate-400">${formatDate(f.created_at)}</span>
                    <button class="btn btn-primary btn-xs mt-2" onclick="event.stopPropagation();openThreadModal(${f.forum_id})">
                        <i class="fas fa-eye mr-1"></i> View
                    </button>
                </div>
            </div>
        </div>`;
    }).join('');
}

/* ════════════════════════════════════════════
   OPEN THREAD (fetch detail)
════════════════════════════════════════════ */
async function openThread(forumId) {
    try {
        // Show loading state
        document.getElementById('forumListView').classList.remove('active');
        document.getElementById('threadView').classList.add('active');
        document.getElementById('mainScroll').scrollTo(0, 0);
        document.getElementById('threadTitle').textContent = 'Loading…';
        document.getElementById('repliesContainer').innerHTML = `<div class="empty-state" style="padding:32px"><i class="fas fa-spinner fa-spin text-indigo-400 text-2xl"></i><p class="text-xs text-slate-400 mt-2">Loading thread…</p></div>`;

        const res  = await fetch(`/teacher/api/forum/${forumId}`);
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to load');

        currentForum = data.forum;
        renderThread(data);
    } catch (e) {
        toast(e.message, 'error');
        backToList();
    }
}

function renderThread(data) {
    const f       = data.forum;
    const replies = data.replies || [];
    const done    = data.done_students || [];
    const students = data.enrolled_students || [];

    // Header fields
    document.getElementById('threadTitle').textContent = f.title;
    document.getElementById('threadDate').textContent  = formatDate(f.created_at);
    document.getElementById('threadReplyCount').textContent = f.reply_count || 0;
    document.getElementById('threadDoneCount').textContent  = done.length;
    document.getElementById('threadContent').textContent    = f.forum_content || '';
    document.getElementById('replyCountBadge').textContent  = f.reply_count || 0;

    // Pin badge/button
    const pinBadge = document.getElementById('threadPinBadge');
    const pinLabel = document.getElementById('btnPinLabel');
    pinBadge.classList.toggle('hidden', !f.is_pinned);
    pinLabel.textContent = f.is_pinned ? 'Unpin' : 'Pin';

    // Topic & Subject badges
    const subject = ALL_SUBJECTS.find(s => s.subject_id === f.subject_id) || {};
    const topic   = ALL_TOPICS.find(t => t.topic_id === f.topic_id) || null;
    document.getElementById('threadSubjectBadge').textContent = subject.subject_name || '';
    document.getElementById('threadTopicBadge').textContent   = topic ? `Q${topic.quarter_number} · ${topic.topic_name}` : '';
    document.getElementById('threadTopicBadge').style.display = topic ? '' : 'none';

    // Author
    document.getElementById('threadAuthor').innerHTML = `
        <img src="/profile_uploads/${f.teacher_pic || 'default_avatar.png'}"
             class="avatar w-8 h-8" onerror="this.src='/profile_uploads/default_avatar.png'">
        <div>
            <p class="text-white font-bold text-sm">${escHtml(f.teacher_name || 'Teacher')}</p>
            <p class="text-white/60 text-xs">Posted ${timeAgo(f.created_at)}</p>
        </div>`;

    // Completion tracker
    const enrolled = students.length;
    const doneIds  = new Set(done.map(d => d.student_id));
    const pct      = enrolled ? Math.round((done.length / enrolled) * 100) : 0;
    document.getElementById('completionFill').style.width  = pct + '%';
    document.getElementById('completionLabel').textContent = pct + '%';

    const compList = document.getElementById('completionList');
    if (!enrolled) {
        compList.innerHTML = '<p class="text-xs text-slate-400 py-3 text-center">No students enrolled.</p>';
    } else {
        compList.innerHTML = students.map(s => {
            const isDone = doneIds.has(s.student_id);
            return `<div class="student-done-row">
                <img src="/profile_uploads/${s.profile_pic || 'default_avatar.png'}"
                     class="avatar w-7 h-7"
                     onerror="this.src='/profile_uploads/default_avatar.png'">
                <span class="text-xs font-semibold text-slate-700 flex-1">${escHtml(s.first_name)} ${escHtml(s.last_name)}</span>
                ${isDone
                    ? `<span class="badge badge-emerald"><i class="fas fa-check mr-1"></i> Done <span class="ml-1 opacity-60">${timeAgo(done.find(d=>d.student_id===s.student_id).done_at)}</span></span>`
                    : `<span class="badge badge-slate">Not yet</span>`}
            </div>`;
        }).join('');
    }

    // Replies
    renderReplies(replies);
}

/* ════════════════════════════════════════════
   RENDER REPLIES (nested)
════════════════════════════════════════════ */
function renderReplies(replies) {
    const container = document.getElementById('repliesContainer');
    if (!replies.length) {
        container.innerHTML = `<div class="empty-state" style="padding:24px">
            <i class="fas fa-comment-slash text-slate-300 text-2xl"></i>
            <p class="text-xs text-slate-400">No replies yet. Start the discussion!</p>
        </div>`;
        return;
    }

    // Build tree
    const roots   = replies.filter(r => !r.parent_reply_id);
    const children = {};
    replies.filter(r => r.parent_reply_id).forEach(r => {
        (children[r.parent_reply_id] = children[r.parent_reply_id] || []).push(r);
    });

    function renderReply(r, depth = 0) {
        const isTeacherReply = r.user_id === TEACHER_ID;
        const hasFile = r.file_path && r.file_name;
        const hasLink = r.external_link;
        const cls = `reply-card fade-in ${depth > 0 ? 'nested' : ''} ${isTeacherReply ? 'teacher-reply' : ''}`;

        let attachHtml = '';
        if (hasFile) {
            const icon = fileIcon(r.file_type);
            // Siguraduhin na ang pathing ay tama at ang onclick ay gumagana
            attachHtml += `<div class="flex flex-col gap-1">
                <button type="button" onclick="viewFile('${r.file_path}', '${escHtml(r.file_name)}', '${r.file_type}')" 
                    class="file-preview-box inline-flex mt-2 hover:border-indigo-300 transition text-left w-full items-center bg-slate-50 p-2 rounded">
                    <i class="${icon} text-indigo-400 text-lg mr-2"></i>
                    <div class="flex-1 min-w-0">
                        <p class="font-bold text-slate-700 truncate text-xs">${escHtml(r.file_name)}</p>
                        <p class="text-[10px] text-slate-400">Click to View</p>
                    </div>
                    <i class="fas fa-eye text-slate-400 text-xs ml-2"></i>
                </button>
                <a href="/forum_uploads/${r.file_path}" download="${r.file_name}" class="text-[10px] text-indigo-600 hover:underline ml-2">
                    <i class="fas fa-download"></i> Direct Download
                </a>
            </div>`;
        }

        if (hasLink) {
            attachHtml += `<a href="${escHtml(r.external_link)}" target="_blank" class="mt-2 flex items-center gap-2 text-xs text-indigo-600 font-semibold hover:underline">
                <i class="fas fa-external-link-alt"></i> ${escHtml(r.external_link.length > 60 ? r.external_link.slice(0,60)+'…' : r.external_link)}
            </a>`;
        }

        const childReplies = (children[r.reply_id] || []);
        const childrenHtml = childReplies.map(c => renderReply(c, depth + 1)).join('');

        return `<div>
            <div class="${cls}" id="reply-${r.reply_id}">
                <div class="flex items-start gap-2">
                    <img src="/profile_uploads/${r.profile_pic || 'default_avatar.png'}"
                         class="avatar w-7 h-7" onerror="this.src='/profile_uploads/default_avatar.png'">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap mb-1">
                            <span class="text-xs font-black text-slate-800">${escHtml(r.author_name || 'Unknown')}</span>
                            ${isTeacherReply ? '<span class="badge badge-indigo">Instructor</span>' : '<span class="badge badge-slate">Student</span>'}
                            <span class="text-[10px] text-slate-400">${timeAgo(r.created_at)}</span>
                        </div>
                        <p class="text-xs text-slate-700 leading-relaxed whitespace-pre-line">${escHtml(r.reply_content)}</p>
                        ${attachHtml}
                    </div>
                    <div class="flex gap-1 flex-shrink-0">
                        <button class="btn btn-outline btn-xs" 
                            data-reply-id="${r.reply_id}" 
                            data-author="${escHtml(r.author_name || '')}"
                            onclick="openReplyModal(Number(this.dataset.replyId), this.dataset.author)">
                            <i class="fas fa-reply"></i>
                        </button>
                        <button class="btn btn-danger btn-xs" onclick="openDeleteReplyModal(${r.reply_id})">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
            ${childrenHtml ? `<div class="mt-2 flex flex-col gap-2">${childrenHtml}</div>` : ''}
        </div>`;
    }

    container.innerHTML = `<div class="flex flex-col gap-3">${roots.map(r => renderReply(r)).join('')}</div>`;
}

function fileIcon(type) {
    if (!type) return 'fas fa-file';
    if (type.includes('pdf')) return 'fas fa-file-pdf';
    if (type.includes('word') || type.includes('doc')) return 'fas fa-file-word';
    if (type.includes('image') || type.includes('png') || type.includes('jpg')) return 'fas fa-file-image';
    if (type.includes('video')) return 'fas fa-file-video';
    if (type.includes('audio')) return 'fas fa-file-audio';
    if (type.includes('zip') || type.includes('rar')) return 'fas fa-file-archive';
    return 'fas fa-file';
}

/* ════════════════════════════════════════════
   BACK TO LIST
════════════════════════════════════════════ */
function backToList() {
    currentForum = null;
    document.getElementById('threadView').classList.remove('active');
    document.getElementById('forumListView').classList.add('active');
}

/* ════════════════════════════════════════════
   CREATE FORUM
════════════════════════════════════════════ */
function openCreateModal() {
    if (!ALL_SUBJECTS.length) { toast('No subjects found. Please set up a class first.', 'error'); return; }
    document.getElementById('createTitle').value   = '';
    document.getElementById('createContent').value = '';
    document.getElementById('createPinned').checked = false;
    populateTopicSelect('createTopicId', 'createSubjectId');
    openModal('modalCreate');
}

async function submitCreateForum() {
    const title      = document.getElementById('createTitle').value.trim();
    const content    = document.getElementById('createContent').value.trim();
    const subject_id = document.getElementById('createSubjectId').value;
    const topic_id   = document.getElementById('createTopicId').value || null;
    const is_pinned  = document.getElementById('createPinned').checked ? 1 : 0;

    if (!title) { toast('Title is required.', 'error'); return; }

    try {
        const res  = await fetch('/teacher/api/forum', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title, forum_content: content, subject_id, topic_id, is_pinned })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');

        // Guard: ensure the server returned a forum object
        if (!data.forum) throw new Error('Server did not return the created forum. Check server logs.');

        // Fill in any fields the server may not have set
        data.forum.reply_count    = data.forum.reply_count    ?? 0;
        data.forum.done_count     = data.forum.done_count     ?? 0;
        data.forum.enrolled_count = data.forum.enrolled_count ?? 0;
        data.forum.teacher_pic    = data.forum.teacher_pic    || TEACHER_PIC;
        data.forum.teacher_name   = data.forum.teacher_name   || TEACHER_NAME;
        data.forum.last_reply_at  = data.forum.last_reply_at  || null;
        ALL_FORUMS.unshift(data.forum);

        updateStats();
        applyFilters();
        closeModal('modalCreate');
        toast('Forum created!', 'success');
    } catch(e) { toast(e.message, 'error'); }
}

/* ════════════════════════════════════════════
   EDIT FORUM
════════════════════════════════════════════ */
function openEditModal() {
    if (!currentForum) return;
    document.getElementById('editTitle').value   = currentForum.title;
    document.getElementById('editContent').value = currentForum.forum_content || '';
    const topicSel = document.getElementById('editTopicId');
    topicSel.value = currentForum.topic_id || '';
    openModal('modalEdit');
}

async function submitEditForum() {
    const title    = document.getElementById('editTitle').value.trim();
    const content  = document.getElementById('editContent').value.trim();
    const topic_id = document.getElementById('editTopicId').value || null;
    if (!title) { toast('Title is required.', 'error'); return; }

    try {
        const res  = await fetch(`/teacher/api/forum/${currentForum.forum_id}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ title, forum_content: content, topic_id })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');

        // Update local
        const idx = ALL_FORUMS.findIndex(f => f.forum_id === currentForum.forum_id);
        if (idx > -1) { ALL_FORUMS[idx].title = title; ALL_FORUMS[idx].forum_content = content; ALL_FORUMS[idx].topic_id = topic_id ? Number(topic_id) : null; }
        currentForum.title        = title;
        currentForum.forum_content = content;
        currentForum.topic_id     = topic_id ? Number(topic_id) : null;

        // Re-render thread header elements
        document.getElementById('threadTitle').textContent = title;
        document.getElementById('threadContent').textContent = content;
        const topic = ALL_TOPICS.find(t => t.topic_id === currentForum.topic_id);
        document.getElementById('threadTopicBadge').textContent   = topic ? `Q${topic.quarter_number} · ${topic.topic_name}` : '';
        document.getElementById('threadTopicBadge').style.display = topic ? '' : 'none';

        closeModal('modalEdit');
        toast('Forum updated!', 'success');
    } catch(e) { toast(e.message, 'error'); }
}

/* ════════════════════════════════════════════
   DELETE FORUM
════════════════════════════════════════════ */
function openDeleteForumModal() {
    if (!currentForum) return;
    document.getElementById('deletingForumTitle').textContent = '"' + currentForum.title + '"';
    openModal('modalDeleteForum');
}

async function confirmDeleteForum() {
    try {
        const res  = await fetch(`/teacher/api/forum/${currentForum.forum_id}`, { method: 'DELETE' });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');

        const idx = ALL_FORUMS.findIndex(f => f.forum_id === currentForum.forum_id);
        if (idx > -1) ALL_FORUMS.splice(idx, 1);

        closeModal('modalDeleteForum');
        updateStats();
        applyFilters();
        backToList();
        toast('Forum deleted.', 'success');
    } catch(e) { toast(e.message, 'error'); }
}

/* ════════════════════════════════════════════
   PIN / UNPIN THREAD
════════════════════════════════════════════ */
async function togglePinThread() {
    if (!currentForum) return;
    const newPin = currentForum.is_pinned ? 0 : 1;
    try {
        const res  = await fetch(`/teacher/api/forum/${currentForum.forum_id}/pin`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_pinned: newPin })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');

        currentForum.is_pinned = newPin;
        const idx = ALL_FORUMS.findIndex(f => f.forum_id === currentForum.forum_id);
        if (idx > -1) ALL_FORUMS[idx].is_pinned = newPin;

        document.getElementById('threadPinBadge').classList.toggle('hidden', !newPin);
        document.getElementById('btnPinLabel').textContent = newPin ? 'Unpin' : 'Pin';
        updateStats();
        toast(newPin ? 'Forum pinned!' : 'Forum unpinned.', 'success');
    } catch(e) { toast(e.message, 'error'); }
}

/* ════════════════════════════════════════════
   REPLY MODAL
════════════════════════════════════════════ */
function openReplyModal(parentId, parentName) {
    replyParentId = parentId;
    document.getElementById('replyContent').value = '';
    document.getElementById('replyLink').value    = '';
    clearFile();

    const replyBox  = document.getElementById('replyingToBox');
    const titleEl   = document.getElementById('replyModalTitle');
    if (parentId) {
        replyBox.classList.remove('hidden');
        document.getElementById('replyingToName').textContent = parentName || 'reply';
