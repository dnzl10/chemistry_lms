                        <div class="completion-bar">
                            <div class="completion-fill" id="tmCompFill" style="width:0%"></div>
                        </div>
                    </div>
                    <div id="tmStudentList">
                        <p class="text-xs text-slate-400 text-center py-4">No students enrolled.</p>
                    </div>
                </div>

                <!-- Files tab -->
