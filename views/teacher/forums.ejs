════════════════════════════════════════════ */
async function tmTogglePin() {
    if (!tmCurrentForum) return;
    const newPin = tmCurrentForum.is_pinned ? 0 : 1;
    try {
        const res = await fetch(`/teacher/api/forum/${tmCurrentForum.forum_id}/pin`, {
            method: 'PATCH',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ is_pinned: newPin })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed');
        tmCurrentForum.is_pinned = newPin;
        const idx = ALL_FORUMS.findIndex(f => f.forum_id === tmCurrentForum.forum_id);
        if (idx > -1) ALL_FORUMS[idx].is_pinned = newPin;
        document.getElementById('tmPinBadge').classList.toggle('hidden', !newPin);
        document.getElementById('tmPinLabel').textContent = newPin ? 'Unpin' : 'Pin';
        updateStats(); applyFilters();
        toast(newPin ? 'Forum pinned!' : 'Forum unpinned.', 'success');
    } catch(e) { toast(e.message, 'error'); }
}

