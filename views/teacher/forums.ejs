});

async function submitCreateForum() {
    const title = document.getElementById('createTitle').value.trim();
    const content = document.getElementById('createContent').value.trim();
    const subject_id = document.getElementById('createSubjectId').value;
    const topic_id = document.getElementById('createTopicId').value || '';
    const class_id = document.getElementById('createClassId').value || '';
    const due_date = document.getElementById('createDueDate').value || '';
    const base_exp = document.getElementById('createBaseExp').value || '100';
    const post_before_viewing = document.getElementById('createPostBeforeViewing').checked ? 1 : 0;
    const allow_anonymous = document.getElementById('createAllowAnonymous').checked ? 1 : 0;
    const is_pinned = document.getElementById('createPinned').checked ? 1 : 0;
    const fileInput = document.getElementById('createAttachment');

    if (!title) { toast('Title is required.', 'error'); return; }
    if (!subject_id) { toast('Subject is required.', 'error'); return; }

    const btn = document.getElementById('btnSubmitCreateForum');
    const origHtml = btn.innerHTML;
    btn.disabled = true;
    btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Posting…';

    try {
        const fd = new FormData();
        fd.append('title', title);
        fd.append('forum_content', content);
        fd.append('subject_id', subject_id);
        if (topic_id) fd.append('topic_id', topic_id);
        if (class_id) fd.append('class_id', class_id);
        if (due_date) fd.append('due_date', due_date);
        fd.append('base_exp', base_exp);
        fd.append('post_before_viewing', post_before_viewing);
        fd.append('allow_anonymous', allow_anonymous);
        fd.append('is_pinned', is_pinned);
        if (fileInput && fileInput.files[0]) {
            fd.append('attachment', fileInput.files[0]);
        }
        // Banner Selection
        fd.append('banner_choice', bannerStudioState.create.choice);
        if (bannerStudioState.create.choice === 'preset') {
            fd.append('banner_preset', bannerStudioState.create.preset);
        } else if (bannerStudioState.create.choice === 'upload' && bannerStudioState.create.file) {
            fd.append('banner_image', bannerStudioState.create.file);
        }

        const res = await fetch('/teacher/api/forum', {
            method: 'POST',
            body: fd
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to create forum');

        data.forum.reply_count = data.forum.reply_count ?? 0;
        data.forum.done_count = data.forum.done_count ?? 0;
        data.forum.enrolled_count = data.forum.enrolled_count ?? 0;
        data.forum.teacher_pic = data.forum.teacher_pic || TEACHER_PIC;
        data.forum.teacher_name = data.forum.teacher_name || TEACHER_NAME;
        data.forum.last_reply_at = data.forum.last_reply_at || null;
        ALL_FORUMS.unshift(data.forum);

        updateStats();
        applyFilters();
        closeModal('modalCreate');
        toast('Forum created successfully!', 'success');
        document.getElementById('createTitle').value = '';
        document.getElementById('createContent').value = '';
        document.getElementById('createDueDate').value = '';
        if (fileInput) fileInput.value = '';
    } catch(e) {
        toast(e.message, 'error');
    } finally {
        btn.disabled = false;
        btn.innerHTML = origHtml;
    }
}

async function submitEditForum() {
    if (!currentForum) return;
    const title = document.getElementById('editTitle').value.trim();
    const content = document.getElementById('editContent').value.trim();
    const topic_id = document.getElementById('editTopicId').value || '';
    const class_id = document.getElementById('editClassId').value || '';
    const due_date = document.getElementById('editDueDate').value || '';
    const base_exp = document.getElementById('editBaseExp').value || '100';
    const post_before_viewing = document.getElementById('editPostBeforeViewing').checked ? 1 : 0;
    const allow_anonymous = document.getElementById('editAllowAnonymous').checked ? 1 : 0;
    const is_pinned = document.getElementById('editPinned').checked ? 1 : 0;
    const remove_attachment = document.getElementById('editRemoveAttachment')?.checked ? 1 : 0;
    const fileInput = document.getElementById('editAttachment');

    if (!title) { toast('Title is required.', 'error'); return; }

    const btn = document.getElementById('btnSubmitEditForum');
    const origHtml = btn ? btn.innerHTML : '';
    if (btn) {
        btn.disabled = true;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Saving…';
    }

    try {
        const fd = new FormData();
        fd.append('title', title);
        fd.append('forum_content', content);
        if (topic_id) fd.append('topic_id', topic_id);
        if (class_id) fd.append('class_id', class_id);
        if (due_date) fd.append('due_date', due_date);
        fd.append('base_exp', base_exp);
        fd.append('post_before_viewing', post_before_viewing);
        fd.append('allow_anonymous', allow_anonymous);
        fd.append('is_pinned', is_pinned);
        if (remove_attachment) fd.append('remove_attachment', '1');
        if (fileInput && fileInput.files[0]) {
            fd.append('attachment', fileInput.files[0]);
        }
        // Banner Selection
        fd.append('banner_choice', bannerStudioState.edit.choice);
        if (bannerStudioState.edit.choice === 'preset') {
            fd.append('banner_preset', bannerStudioState.edit.preset);
        } else if (bannerStudioState.edit.choice === 'upload' && bannerStudioState.edit.file) {
            fd.append('banner_image', bannerStudioState.edit.file);
        } else if (bannerStudioState.edit.choice === 'default') {
            fd.append('remove_banner', '1');
        }

        const res = await fetch(`/teacher/api/forum/${currentForum.forum_id}`, {
            method: 'PUT',
            body: fd
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.error || 'Failed to update forum');

        const updated = data.forum;
        const idx = ALL_FORUMS.findIndex(f => f.forum_id === currentForum.forum_id);
        if (idx > -1 && updated) {
            ALL_FORUMS[idx] = { ...ALL_FORUMS[idx], ...updated };
            currentForum = ALL_FORUMS[idx];
        }

        applyFilters();
        updateStats();

        const tTitle = document.getElementById('threadTitle');
        if (tTitle) tTitle.textContent = title;
        const tContent = document.getElementById('threadContent');
        if (tContent) tContent.textContent = content;

        closeModal('modalEdit');
        toast('Forum updated successfully!', 'success');
    } catch(e) {
        toast(e.message, 'error');
    } finally {
        if (btn) {
            btn.disabled = false;
            btn.innerHTML = origHtml;
        }
    }
}


