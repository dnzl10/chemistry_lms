                        <input type="file" id="bannerFileInput_create" accept="image/png,image/jpeg,image/webp" class="hidden" onchange="handleBannerFileSelect('create', this)">
                    </label>
                    <div id="bannerUploadFileInfo_create" class="mt-2 text-xs text-indigo-600 font-bold flex items-center justify-between p-2 rounded-lg bg-indigo-50 border border-indigo-100 hidden">
