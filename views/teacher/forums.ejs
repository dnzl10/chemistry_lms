/* ════════════════════════════════════════════
   RENDER REPLIES (with search highlight support)
════════════════════════════════════════════ */
function tmRenderReplies(replies, searchTerm) {
    const container = document.getElementById('tmRepliesContainer');
    if (!replies.length) {
        container.innerHTML = `<div class="empty-state" style="padding:24px">
            <i class="fas fa-comment-slash text-slate-300 text-2xl"></i>
            <p class="text-xs text-slate-400">No replies yet. Start the discussion!</p>
        </div>`;
        return;
    }

    const roots    = replies.filter(r => !r.parent_reply_id);
    const children = {};
    replies.filter(r => r.parent_reply_id).forEach(r => {
        (children[r.parent_reply_id] = children[r.parent_reply_id] || []).push(r);
    });

    function highlight(text, term) {
        if (!term) return escHtml(text);
        const safe = escHtml(text);
        const safeTerm = term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
        return safe.replace(new RegExp(safeTerm.replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>'), 'gi'),
            m => `<mark class="reply-highlight">${m}</mark>`);
    }

    function renderOne(r, depth) {
        const isTeacher = r.user_id === TEACHER_ID;
        const hasFile   = r.file_path && r.file_name;
        const hasLink   = r.external_link;
        const cls = `reply-card fade-in ${depth > 0 ? 'nested' : ''} ${isTeacher ? 'teacher-reply' : ''}`;

        let attachHtml = '';
        if (hasFile) {
            attachHtml += `<button type="button"
                onclick="viewFile('${r.file_path}','${escHtml(r.file_name)}','${r.file_type}')"
                class="file-preview-box inline-flex mt-2 hover:border-indigo-300 transition text-left w-full items-center bg-slate-50 p-2 rounded">
                <i class="${fileIcon(r.file_type)} text-indigo-400 text-lg mr-2"></i>
                <div class="flex-1 min-w-0">
                    <p class="font-bold text-slate-700 truncate text-xs">${escHtml(r.file_name)}</p>
                    <p class="text-[10px] text-slate-400">Click to view</p>
                </div>
                <i class="fas fa-eye text-slate-400 text-xs ml-2"></i>
            </button>`;
        }
        if (hasLink) {
            attachHtml += `<a href="${escHtml(r.external_link)}" target="_blank" rel="noopener"
                class="mt-2 flex items-center gap-2 text-xs text-indigo-600 font-semibold hover:underline">
                <i class="fas fa-external-link-alt"></i>
                ${escHtml(r.external_link.length > 65 ? r.external_link.slice(0,65)+'…' : r.external_link)}
            </a>`;
        }

        const childReplies  = children[r.reply_id] || [];
        const childrenHtml  = childReplies.map(c => renderOne(c, depth + 1)).join('');

        return `<div>
            <div class="${cls}" id="tmreply-${r.reply_id}">
                <div class="flex items-start gap-2">
                    <img src="/profile_uploads/${r.profile_pic || 'default_avatar.png'}"
                         class="avatar w-7 h-7" onerror="this.src='/profile_uploads/default_avatar.png'">
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 flex-wrap mb-1">
                            <span class="text-xs font-black text-slate-800">${escHtml(r.author_name || 'Unknown')}</span>
                            ${isTeacher ? '<span class="badge badge-indigo">Instructor</span>' : '<span class="badge badge-slate">Student</span>'}
                            <span class="text-[10px] text-slate-400">${timeAgo(r.created_at)}</span>
                        </div>
                        <p class="text-xs text-slate-700 leading-relaxed whitespace-pre-line">${highlight(r.reply_content, searchTerm)}</p>
                        ${attachHtml}
                    </div>
                    <div class="flex gap-1 flex-shrink-0">
                        <button class="btn btn-outline btn-xs"
                            onclick="tmSetReplyingTo(${r.reply_id},'${escHtml(r.author_name || '')}')"
                            title="Reply">
                            <i class="fas fa-reply"></i>
                        </button>
                        <button class="btn btn-danger btn-xs" onclick="openDeleteReplyModal(${r.reply_id})" title="Delete">
                            <i class="fas fa-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
            ${childrenHtml ? `<div class="mt-2 flex flex-col gap-2">${childrenHtml}</div>` : ''}
        </div>`;
    }

    container.innerHTML = `<div class="flex flex-col gap-3">${roots.map(r => renderOne(r, 0)).join('')}</div>`;
}

/* ── Reply Search ── */
function tmFilterReplies() {
    const term = (document.getElementById('tmReplySearch').value || '').trim().toLowerCase();
    if (!term) {
        tmRenderReplies(tmReplies, '');
        return;
    }
    // Filter: keep replies whose content, author, or attachment names match
    const matched = tmReplies.filter(r =>
        (r.reply_content || '').toLowerCase().includes(term) ||
        (r.author_name   || '').toLowerCase().includes(term) ||
        (r.file_name     || '').toLowerCase().includes(term) ||
        (r.external_link || '').toLowerCase().includes(term)
    );
    tmRenderReplies(matched, term);
}

