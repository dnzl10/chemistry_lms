                    <p class="font-medium text-xs text-slate-400 mt-1" id="emptyViewerSubtitle">
                        This student has not attached a deliverable yet. You may still award a direct grade (e.g., 0) or send private feedback below.
                    </p>
                </div>
            </div>
        </section>

        <!-- CENTER DRAGGABLE RESIZER DIVIDER -->
        <div id="dragDivider" class="resizer-divider" title="Drag to resize panels"></div>

        <!-- RIGHT PANEL: Scoring, Rubrics, Feedback & Voice Studio -->
