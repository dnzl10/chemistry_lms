<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>High-Speed Grading Workspace | <%= assessment.assessment_name %> | Elementa LMS</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">
    
    <!-- PDF.js & Mammoth.js for zero-download document rendering -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf_viewer.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
    <script>pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';</script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/mammoth/1.4.21/mammoth.browser.min.js"></script>

    <!-- Custom Client Scripts -->
    <script src="/js/text-expander.js"></script>
    <script src="/js/grading-hotkeys.js"></script>

    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #0f172a; margin: 0; padding: 0; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scrollbar-dark::-webkit-scrollbar { width: 5px; height: 5px; }
        .custom-scrollbar-dark::-webkit-scrollbar-track { background: transparent; }
        .custom-scrollbar-dark::-webkit-scrollbar-thumb { background: #334155; border-radius: 4px; }

        /* Resizable Divider */
        .resizer-divider {
            width: 6px;
            cursor: col-resize;
            background: #e2e8f0;
            transition: background 0.2s;
            position: relative;
            z-index: 25;
            flex-shrink: 0;
        }
        .resizer-divider:hover, .resizer-divider.dragging {
            background: #6366f1;
        }
        .resizer-divider::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 2px;
            height: 24px;
            background: #94a3b8;
            border-radius: 1px;
        }
        .resizer-divider:hover::after, .resizer-divider.dragging::after {
            background: #ffffff;
        }

        /* Canvas Annotation Layer */
        .annotation-canvas-layer {
            position: absolute;
            top: 0;
            left: 0;
            cursor: crosshair;
            touch-action: none;
        }

        /* Pulse animation for recording */
        @keyframes pulse-ring {
            0% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0.7); }
            70% { transform: scale(1); box-shadow: 0 0 0 10px rgba(239, 68, 68, 0); }
            100% { transform: scale(0.95); box-shadow: 0 0 0 0 rgba(239, 68, 68, 0); }
        }
        .recording-pulse {
            animation: pulse-ring 1.8s infinite;
        }
    </style>
</head>
<body class="text-slate-800 flex flex-col h-screen overflow-hidden select-none">
    
    <!-- Top Navigation Bar -->
    <header class="h-14 bg-slate-900 border-b border-slate-800 px-4 flex items-center justify-between flex-shrink-0 z-30">
        <div class="flex items-center gap-3">
            <a href="/teacher/dashboard" class="text-slate-400 hover:text-white transition flex items-center gap-2 text-xs font-bold px-2 py-1.5 rounded-lg hover:bg-slate-800">
                <i class="fas fa-arrow-left"></i>
                <span class="hidden sm:inline">Dashboard</span>
            </a>
            <div class="h-4 w-px bg-slate-700"></div>
            
            <!-- Assessment Title & Max Score -->
            <div class="flex items-center gap-2">
                <span class="px-2 py-0.5 rounded-full bg-indigo-500/20 text-indigo-400 font-extrabold text-[10px] uppercase tracking-wider hidden md:inline-block">SpeedGrader</span>
                <% if (typeof currentSY !== 'undefined' && currentSY && currentSY.sy_range) { %>
                    <span class="px-2 py-0.5 rounded-full bg-emerald-500/15 text-emerald-300 border border-emerald-500/30 font-extrabold text-[10px] uppercase tracking-wider hidden sm:inline-flex items-center gap-1" title="Active School Year">
                        <i class="fas fa-calendar-check text-[9px]"></i> S.Y. <%= currentSY.sy_range %>
                    </span>
                <% } %>
                <h1 class="text-xs sm:text-sm font-black text-white truncate max-w-[220px] lg:max-w-md" id="assessmentTitleHeader" title="<%= assessment.assessment_name %>">
                    <%= assessment.assessment_name %>
                </h1>
                <span class="px-2 py-0.5 rounded-md bg-slate-800 border border-slate-700 text-slate-300 font-mono text-[11px] font-bold">
                    Max: <span class="text-indigo-400 font-extrabold"><%= assessment.max_score || 100 %></span> pts
                </span>
                <% if (typeof gradingStatus !== 'undefined' && gradingStatus) { %>
                    <% if (gradingStatus.isAllowed) { %>
                        <span class="px-2.5 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px] font-bold flex items-center gap-1.5 hidden xl:flex" title="<%= gradingStatus.message %>">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                            Q<%= quarterNumber || 1 %> Grading Open (<%= gradingStatus.remainingDays ? gradingStatus.remainingDays + 'd left' : 'Open' %>)
                        </span>
                    <% } else { %>
                        <span class="px-2.5 py-0.5 rounded-full bg-rose-500/20 text-rose-300 border border-rose-500/40 text-[10px] font-bold flex items-center gap-1.5 hidden xl:flex" title="<%= gradingStatus.message %>">
                            <i class="fas fa-lock text-[9px] text-rose-400"></i>
                            Q<%= quarterNumber || 1 %> Grading Locked
                        </span>
                    <% } %>
                <% } %>
            </div>
        </div>

        <!-- Roster Drawer Trigger, Guidelines, Student Switcher & Hotkey Indicators -->
        <div class="flex items-center gap-2 sm:gap-3">
            <!-- Submissions Left Panel Trigger -->
            <button onclick="toggleLeftPanel()" id="rosterDrawerBtn" class="px-3 py-1.5 rounded-xl bg-slate-800 hover:bg-slate-700 text-slate-200 hover:text-white font-bold text-xs flex items-center gap-2 transition border border-slate-700 shadow-sm" title="Toggle Submissions Left Panel">
                <i class="fas fa-inbox text-indigo-400"></i>
                <span class="hidden sm:inline">Submissions</span>
                <span id="topRosterCountPill" class="px-1.5 py-0.2 rounded-full bg-indigo-500/30 text-indigo-300 font-mono text-[10px]">0</span>
            </button>

            <!-- Blueprint / Guidelines Drawer Trigger -->
            <button onclick="toggleGuidelinesDrawer()" class="px-3 py-1.5 rounded-xl bg-indigo-950/70 hover:bg-indigo-900 text-indigo-200 hover:text-white font-bold text-xs flex items-center gap-1.5 transition border border-indigo-700/50 shadow-sm">
                <i class="fas fa-compass text-cyan-400"></i>
                <span class="hidden md:inline">Guidelines</span>
            </button>

            <!-- Student Pager -->
            <div class="flex items-center bg-slate-800 rounded-xl p-1 border border-slate-700">
                <button onclick="prevStudent()" class="px-2.5 py-1 text-xs text-slate-300 hover:text-white font-bold flex items-center gap-1.5 transition rounded-lg hover:bg-slate-700" title="Previous Student (Hotkey: K)">
                    <kbd class="px-1.5 py-0.5 bg-slate-900 rounded text-[10px] text-slate-400 font-mono">K</kbd>
                    <span class="hidden sm:inline">Prev</span>
                </button>
                <span class="text-xs text-slate-300 font-black px-2.5 font-mono" id="studentCounterText">-- / --</span>
                <button onclick="nextStudent()" class="px-2.5 py-1 text-xs text-slate-300 hover:text-white font-bold flex items-center gap-1.5 transition rounded-lg hover:bg-slate-700" title="Next Student (Hotkey: J)">
                    <span class="hidden sm:inline">Next</span>
                    <kbd class="px-1.5 py-0.5 bg-slate-900 rounded text-[10px] text-slate-400 font-mono">J</kbd>
                </button>
            </div>

            <!-- Hotkey Cheat Sheet -->
            <button onclick="window.hotkeyManager ? window.hotkeyManager.toggleCheatSheet() : null" class="p-2 text-slate-400 hover:text-white bg-slate-800 rounded-xl border border-slate-700 transition" title="Keyboard Shortcuts Cheat Sheet (?)">
                <kbd class="font-black text-xs px-1">?</kbd>
            </button>

                    <!-- Messages Navigation Button (Entry point to teacher messages workspace) -->
                    <a href="/teacher/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                        <i class="far fa-comment-dots text-xl"></i>
                        
                        <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                            <span class="msg-badge-count">0</span>
                        </span>

                        <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                            Messages
                        </span>
                    </a>

            <!-- Notification Bell Button -->
            <button type="button" onclick="toggleNotifPanel()" aria-label="View notifications" class="relative group p-2 text-slate-400 hover:text-white bg-slate-800 rounded-xl border border-slate-700 transition">
                <i class="far fa-bell text-sm"></i>
                <% const _unreadNotifCount = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications.filter(n => !n.is_read).length : 0; %>
                <span class="absolute -top-1 -right-1 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-slate-900 shadow-sm flex items-center justify-center notif-badge <%= _unreadNotifCount > 0 ? '' : 'hidden' %>" aria-hidden="true">
                    <span class="notif-badge-count"><%= _unreadNotifCount > 99 ? '99+' : _unreadNotifCount %></span>
                </span>
            </button>
        </div>
    </header>

    <% if (typeof gradingStatus !== 'undefined' && gradingStatus && !gradingStatus.isAllowed) { %>
        <!-- Persistent Read-Only Lockout Banner -->
        <div class="bg-gradient-to-r from-rose-950 via-rose-900 to-slate-900 border-b border-rose-500/50 px-4 py-2.5 flex items-center justify-between text-xs text-rose-200 z-20 flex-shrink-0 shadow-md">
            <div class="flex items-center gap-3">
                <span class="w-7 h-7 rounded-lg bg-rose-500/20 border border-rose-500/40 flex items-center justify-center text-rose-300">
                    <i class="fas fa-lock text-xs"></i>
                </span>
                <div>
                    <span class="font-extrabold text-white text-xs">Quarter <%= quarterNumber || 1 %> Grading Deadline Expired:</span>
                    <span class="text-rose-200/90 ml-1.5"><%= gradingStatus.message %> Grades and feedback are in read-only mode.</span>
                </div>
            </div>
            <span class="px-2.5 py-1 rounded-md bg-rose-500/20 text-rose-300 border border-rose-500/40 text-[10px] font-black uppercase tracking-wider">
                Read-Only Mode
            </span>
        </div>
    <% } %>

    <!-- Slide-over Guidelines & Blueprint Drawer (Right) -->
    <div id="guidelinesDrawer" class="fixed inset-y-0 right-0 w-[420px] max-w-[90vw] bg-slate-900 text-white z-50 shadow-2xl border-l border-slate-800 flex flex-col transform translate-x-full transition-transform duration-300 ease-in-out">
        <div class="p-4 border-b border-slate-800 flex items-center justify-between bg-slate-950/60">
            <div class="flex items-center gap-2">
                <i class="fas fa-compass text-cyan-400"></i>
                <h3 class="font-extrabold text-sm text-white">Assignment Blueprint &amp; Guidelines</h3>
            </div>
            <button onclick="toggleGuidelinesDrawer()" class="w-8 h-8 rounded-lg hover:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white">
                <i class="fas fa-times"></i>
            </button>
        </div>
        <div class="flex-1 overflow-y-auto p-4 space-y-4 custom-scrollbar text-xs">
            <div>
                <span class="px-2 py-0.5 rounded-full text-[10px] font-extrabold bg-blue-500/20 text-blue-400 border border-blue-500/30 uppercase tracking-wider">
                    <%= assessment.category || 'Assignment' %>
                </span>
                <h4 class="font-bold text-slate-200 mt-1.5 text-sm"><%= assessment.assessment_name %></h4>
            </div>
            <% if (assessment.objectives) { %>
            <div class="p-3.5 rounded-xl bg-slate-800/60 border border-slate-700/60 space-y-1">
                <p class="text-[10px] font-black uppercase text-cyan-400 tracking-wider">Learning Objectives</p>
                <p class="text-slate-300 leading-relaxed whitespace-pre-wrap"><%= assessment.objectives %></p>
            </div>
            <% } %>
            <% if (assessment.description) { %>
            <div class="p-3.5 rounded-xl bg-slate-800/60 border border-slate-700/60 space-y-1">
                <p class="text-[10px] font-black uppercase text-indigo-400 tracking-wider">Overview / Prompt</p>
                <p class="text-slate-300 leading-relaxed whitespace-pre-wrap"><%= assessment.description %></p>
            </div>
            <% } %>
            <% if (assessment.guidelines) { %>
            <div class="p-3.5 rounded-xl bg-slate-800/60 border border-slate-700/60 space-y-1">
                <p class="text-[10px] font-black uppercase text-emerald-400 tracking-wider">Guidelines &amp; Instructions</p>
                <p class="text-slate-300 leading-relaxed whitespace-pre-wrap"><%= assessment.guidelines %></p>
            </div>
            <% } %>
            <div class="pt-2 border-t border-slate-800 space-y-2">
                <p class="text-[10px] font-black uppercase text-slate-400 tracking-wider">Teacher Resources &amp; Templates</p>
                <div class="flex flex-col gap-2">
                    <% if (assessment.format_file_path) { %>
                    <a href="<%= assessment.format_file_path %>" download class="p-2.5 rounded-xl bg-cyan-950/40 border border-cyan-800/60 hover:bg-cyan-900/40 text-cyan-300 flex items-center justify-between transition">
                        <span class="flex items-center gap-2 font-bold"><i class="fas fa-file-arrow-down"></i> Format Template</span>
                        <i class="fas fa-download text-[10px]"></i>
                    </a>
                    <% } %>
                    <% if (assessment.sample_output_path) { %>
                    <a href="<%= assessment.sample_output_path %>" download class="p-2.5 rounded-xl bg-pink-950/40 border border-pink-800/60 hover:bg-pink-900/40 text-pink-300 flex items-center justify-between transition">
                        <span class="flex items-center gap-2 font-bold"><i class="fas fa-file-circle-check"></i> Exemplar / Sample Output</span>
                        <i class="fas fa-download text-[10px]"></i>
                    </a>
                    <% } %>
                    <% if (!assessment.format_file_path && !assessment.sample_output_path) { %>
                    <p class="text-slate-500 italic text-[11px]">No template files uploaded for this assignment.</p>
                    <% } %>
                </div>
            </div>
        </div>
    </div>

    <!-- Backdrop for Drawers / Modals -->
    <div id="drawerBackdrop" onclick="closeAllDrawers()" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-40 hidden transition-opacity"></div>

    <!-- Main Workspace Split-Panel -->
    <main class="flex-1 flex overflow-hidden bg-slate-100 relative">
        
        <!-- LEFT PANEL: Submissions Queue (Only Actually Submitted Students) -->
        <aside id="submissionsLeftPanel" class="w-80 lg:w-84 flex-shrink-0 bg-slate-900 text-white border-r border-slate-800 flex flex-col z-20 transition-all duration-300">
            <!-- Left Panel Header -->
            <div class="h-11 px-3.5 border-b border-slate-800 flex items-center justify-between bg-slate-950/80 flex-shrink-0">
                <div class="flex items-center gap-2 min-w-0">
                    <i class="fas fa-inbox text-indigo-400 text-sm"></i>
                    <h3 class="font-extrabold text-xs text-white truncate">Submitted Work</h3>
                    <span id="rosterCountPill" class="px-1.5 py-0.2 rounded-full bg-indigo-500/30 text-indigo-300 font-mono text-[10px]">0</span>
                </div>
                <button onclick="toggleLeftPanel()" class="w-7 h-7 rounded-lg hover:bg-slate-800 flex items-center justify-center text-slate-400 hover:text-white transition" title="Collapse / Expand Left Panel">
                    <i class="fas fa-chevron-left text-xs" id="leftPanelCollapseIcon"></i>
                </button>
            </div>

            <!-- Filter & Search Controls -->
            <div class="p-2.5 bg-slate-900 border-b border-slate-800/80 space-y-2 flex-shrink-0">
                <div class="relative">
                    <i class="fas fa-search absolute left-2.5 top-1/2 -translate-y-1/2 text-slate-500 text-[11px]"></i>
                    <input type="text" id="rosterSearchInput" oninput="filterRoster()" placeholder="Search student, group..." class="w-full pl-7 pr-2.5 py-1.5 bg-slate-800/80 border border-slate-700 rounded-xl text-xs text-white placeholder-slate-500 focus:outline-none focus:border-indigo-500 transition">
                </div>
                <div class="flex items-center gap-1 text-[10px] font-bold">
                    <button type="button" onclick="setRosterFilter('all')" id="rf-all" class="px-2.5 py-1 rounded-lg bg-indigo-600 text-white whitespace-nowrap transition">
                        All <span id="cnt-all" class="font-mono text-[9px] opacity-80">(0)</span>
                    </button>
                    <button type="button" onclick="setRosterFilter('needs_grading')" id="rf-needs_grading" class="px-2.5 py-1 rounded-lg bg-slate-800 text-slate-400 hover:text-slate-200 whitespace-nowrap transition">
                        Ungraded <span id="cnt-needs_grading" class="font-mono text-[9px] opacity-80">(0)</span>
                    </button>
                    <button type="button" onclick="setRosterFilter('graded')" id="rf-graded" class="px-2.5 py-1 rounded-lg bg-slate-800 text-slate-400 hover:text-slate-200 whitespace-nowrap transition">
                        Graded <span id="cnt-graded" class="font-mono text-[9px] opacity-80">(0)</span>
                    </button>
                </div>
            </div>

            <!-- Submissions List Container -->
            <div class="flex-1 overflow-y-auto p-2 space-y-1 custom-scrollbar-dark" id="rosterListContainer">
                <div class="p-6 text-center text-slate-500 text-xs">Loading submissions...</div>
            </div>
        </aside>

        <!-- CENTER PANEL: Zero-Download Document Preview & Annotation Viewport -->
        <section id="leftDocumentPanel" class="flex-1 flex flex-col bg-slate-200/60 relative overflow-hidden min-w-[320px]">
            <!-- Document Toolbar -->
            <div class="h-11 bg-white border-b border-slate-200 px-3 flex items-center justify-between text-xs z-10 shadow-sm flex-shrink-0">
                <!-- File Info, Sanitized & SHA-256 Receipt -->
                <div class="flex items-center gap-2 min-w-0">
                    <i class="fas fa-file-alt text-indigo-600 text-sm"></i>
                    <span id="docFilename" class="font-extrabold text-slate-700 truncate max-w-[140px] sm:max-w-xs" title="No Document Selected">No Document Selected</span>
                    <span id="docSanitizedBadge" class="hidden text-[10px] font-black bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded-full border border-emerald-200">
                        <i class="fas fa-shield-alt mr-0.5 text-emerald-600"></i> Sanitized
                    </span>
                    
                    <!-- Cryptographic Receipt Trigger -->
                    <button id="receiptBtn" onclick="openReceiptModal()" class="hidden px-2 py-0.5 rounded-lg bg-emerald-50 hover:bg-emerald-100 text-emerald-700 font-bold text-[11px] items-center gap-1.5 transition border border-emerald-200" title="Inspect Cryptographic Submission Receipt (SHA-256)">
                        <i class="fas fa-shield-halved text-emerald-600"></i>
                        <span class="hidden sm:inline">Receipt</span>
                    </button>

                    <!-- Direct Download Link -->
                    <a id="toolbarDownloadLink" href="#" download class="hidden px-2.5 py-0.5 rounded-lg bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-[11px] items-center gap-1 transition">
                        <i class="fas fa-download"></i>
                        <span class="hidden sm:inline">Download</span>
                    </a>
                </div>

                <!-- Zoom, Rotation, Page & Annotation Controls -->
                <div class="flex items-center gap-1 sm:gap-2">
                    <!-- Annotation Tool Picker -->
                    <div class="flex items-center bg-slate-100 rounded-lg p-0.5 border border-slate-200 mr-1" id="annotationToolbar">
                        <button type="button" onclick="setAnnotationTool('select')" id="tool-select" class="p-1.5 rounded text-xs font-bold bg-white text-indigo-600 shadow-sm transition" title="Select / Pan">
                            <i class="fas fa-hand-pointer"></i>
                        </button>
                        <button type="button" onclick="setAnnotationTool('highlight')" id="tool-highlight" class="p-1.5 rounded text-xs font-bold text-slate-500 hover:text-slate-800 transition" title="Yellow Highlighter">
                            <i class="fas fa-highlighter text-amber-500"></i>
                        </button>
                        <button type="button" onclick="setAnnotationTool('pen')" id="tool-pen" class="p-1.5 rounded text-xs font-bold text-slate-500 hover:text-slate-800 transition" title="Red Marker">
                            <i class="fas fa-pen text-rose-500"></i>
                        </button>
                        <button type="button" onclick="undoAnnotation()" class="p-1.5 rounded text-xs font-bold text-slate-500 hover:text-slate-800 transition" title="Undo Last Annotation">
                            <i class="fas fa-undo"></i>
                        </button>
                        <button type="button" onclick="clearAnnotations()" class="p-1.5 rounded text-xs font-bold text-slate-500 hover:text-rose-600 transition" title="Clear All Annotations">
                            <i class="fas fa-trash-alt"></i>
                        </button>
                    </div>

                    <!-- PDF Page Navigation Controls -->
                    <div class="flex items-center gap-1 bg-slate-100 rounded-lg px-1.5 py-0.5 border border-slate-200" id="pdfControls" style="display: none;">
                        <button onclick="changePage(-1)" class="p-1 hover:bg-white rounded text-slate-600 font-bold transition"><i class="fas fa-chevron-left text-[10px]"></i></button>
                        <span class="font-mono font-bold text-slate-600 text-[11px] px-1"><span id="pageNum">1</span>/<span id="pageCount">1</span></span>
                        <button onclick="changePage(1)" class="p-1 hover:bg-white rounded text-slate-600 font-bold transition"><i class="fas fa-chevron-right text-[10px]"></i></button>
                    </div>

                    <!-- Zoom Controls -->
                    <div class="flex items-center gap-0.5 bg-slate-100 rounded-lg p-0.5 border border-slate-200">
                        <button onclick="zoomDoc(-0.2)" class="px-1.5 py-1 text-slate-600 hover:text-slate-900 rounded font-bold transition" title="Zoom Out (-)"><i class="fas fa-minus text-[10px]"></i></button>
                        <button onclick="resetDocZoom()" id="zoomLevelText" class="px-1.5 py-1 text-slate-700 font-mono text-[10px] font-extrabold hover:text-indigo-600 rounded transition" title="Reset Zoom">100%</button>
                        <button onclick="zoomDoc(0.2)" class="px-1.5 py-1 text-slate-600 hover:text-slate-900 rounded font-bold transition" title="Zoom In (+)"><i class="fas fa-plus text-[10px]"></i></button>
                        <button onclick="rotateDoc()" class="p-1 text-slate-600 hover:text-indigo-600 rounded font-bold transition" title="Rotate 90°"><i class="fas fa-rotate-right text-[11px]"></i></button>
                    </div>
                </div>
            </div>

            <!-- Viewer Canvas Container with Superimposed Annotation Canvas -->
            <div class="flex-1 overflow-auto flex items-center justify-center p-4 relative custom-scrollbar select-none" id="documentViewport">
                <!-- Wrapper for Zoom & Superimposed Annotation -->
                <div id="renderWrapper" class="relative transition-transform duration-150 origin-top flex items-center justify-center">
                    <canvas id="pdfCanvas" class="shadow-2xl rounded-lg max-w-full hidden"></canvas>
