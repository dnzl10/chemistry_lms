    <!-- Floating Live Toast Notification -->
    <div id="gradingToast" class="fixed bottom-6 right-6 z-[99999] px-4 py-2.5 rounded-2xl bg-slate-900 text-white text-xs font-bold shadow-2xl flex items-center gap-2 transform translate-y-20 opacity-0 transition-all duration-300 pointer-events-none">
        <i class="fas fa-check-circle text-emerald-400" id="toastIcon"></i>
        <span id="toastMessage">Grade saved successfully</span>
    </div>

    <!-- Include Comment Bank Modal -->
    <%- include('partials/comment_bank_modal') %>

    <script>
        const assessmentId = <%= assessment.assessment_id %>;
        const maxAssessmentScore = <%= assessment.max_score || 100 %>;

        let submissions = [];
        let filteredSubmissions = [];
        let currentIndex = 0;
        let activeSubmission = null;
        let currentFilter = 'all';

        // Document Viewer State
        let pdfDoc = null;
        let currentPdfPage = 1;
        let currentDocScale = 1.0;
        let currentDocRotation = 0;

        // Canvas Annotations State
        let activeTool = 'select'; // 'select', 'highlight', 'pen'
        let isDrawing = false;
        let annotationHistory = [];
        let currentStroke = [];

        // Audio Recording State
        let mediaRecorder = null;
        let audioChunks = [];
        let isRecording = false;
        let recordingSeconds = 0;
        let recordingInterval = null;
        let recordedBlob = null;
        let audioContext = null;
        let analyserNode = null;
        let animFrameId = null;

        // Initialize on DOM Ready
        document.addEventListener('DOMContentLoaded', async () => {
            initSplitPaneResizer();
            initAnnotationCanvas();
            initLiveWaveformCanvas();
            initHotkeys();
            await loadSubmissions();
        });

        // ==========================================
        // 1. DATA LOADING & ROSTER MANAGEMENT
        // ==========================================
        async function loadSubmissions() {
            try {
                const res = await fetch(`/teacher/api/grading/${assessmentId}/submissions`);
                if (res.ok) {
                    const data = await res.json();
                    submissions = data.submissions || [];
                    updateRosterCounts();
                    filterRoster();

                    if (submissions.length > 0) {
                        const params = new URLSearchParams(window.location.search);
                        const targetScoreId = params.get('scoreId') ? Number(params.get('scoreId')) : null;
                        const targetStudentId = params.get('studentId') ? Number(params.get('studentId')) : null;
                        let initialIndex = 0;

                        if (targetScoreId) {
                            const foundIdx = submissions.findIndex(s =>
                                Number(s.score_id) === targetScoreId ||
                                (Array.isArray(s.all_attempts) && s.all_attempts.some(a => Number(a.score_id) === targetScoreId))
                            );
                            if (foundIdx !== -1) initialIndex = foundIdx;
                        } else if (targetStudentId) {
                            const foundIdx = submissions.findIndex(s => Number(s.student_id) === targetStudentId);
                            if (foundIdx !== -1) initialIndex = foundIdx;
                        }

                        displaySubmission(initialIndex);
                        if (targetScoreId && activeSubmission && Number(activeSubmission.score_id) !== targetScoreId) {
                            switchAttempt(targetScoreId);
                        }
                    } else {
                        renderEmptyRosterState();
                    }
                }
            } catch (e) {
                console.error('Error fetching submissions:', e);
                showToast('Failed to load submissions queue', true);
            }
        }

        function renderEmptyRosterState() {
            activeSubmission = null;
            currentIndex = -1;
            const counter = document.getElementById('studentCounterText');
            if (counter) counter.textContent = '0 / 0';
            
            const avatar = document.getElementById('studentAvatar');
            if (avatar) {
                avatar.textContent = '--';
                avatar.className = 'w-11 h-11 rounded-2xl bg-slate-200 text-slate-400 flex items-center justify-center font-black text-sm uppercase flex-shrink-0';
            }
            
            const nameEl = document.getElementById('studentNameText');
            if (nameEl) nameEl.textContent = 'No Submissions';
            
            const emailEl = document.getElementById('studentClassEmailText');
            if (emailEl) emailEl.textContent = 'No submitted deliverables in queue';
            
            const timeEl = document.getElementById('submittedTimeText');
            if (timeEl) timeEl.textContent = 'Status: Awaiting submissions';
            
            const statusPill = document.getElementById('submissionStatusPill');
            if (statusPill) {
                statusPill.textContent = 'Queue Empty';
                statusPill.className = 'text-[10px] font-black px-2 py-0.5 rounded-full bg-slate-100 text-slate-500 border border-slate-200';
            }
            
            const groupWrap = document.getElementById('groupRosterWrap');
            if (groupWrap) groupWrap.classList.add('hidden');
            
            const scoreInput = document.getElementById('manualScoreInput');
            if (scoreInput) {
                scoreInput.value = '';
                scoreInput.disabled = true;
            }
            const feedbackInput = document.getElementById('feedbackInput');
            if (feedbackInput) {
                feedbackInput.value = '';
                feedbackInput.disabled = true;
            }
            
            renderDocument(null, null);
            const emptyTitle = document.getElementById('emptyViewerTitle');
            const emptySub = document.getElementById('emptyViewerSubtitle');
            if (emptyTitle) emptyTitle.textContent = 'No Submissions Yet';
            if (emptySub) emptySub.textContent = 'Only students who have actually submitted work appear in this workspace. For group assignments, the submitting member will appear along with their group number.';
        }

        function updateRosterCounts() {
            const total = submissions.length;
            const needsGrading = submissions.filter(s => s.score_obtained === null || s.score_obtained === undefined).length;
            const graded = submissions.filter(s => s.score_obtained !== null && s.score_obtained !== undefined).length;

            const rosterCountPill = document.getElementById('rosterCountPill');
            if (rosterCountPill) rosterCountPill.textContent = total;

            const topRosterCountPill = document.getElementById('topRosterCountPill');
            if (topRosterCountPill) topRosterCountPill.textContent = total;

            const cntAll = document.getElementById('cnt-all');
            if (cntAll) cntAll.textContent = `(${total})`;

            const cntNeedsGrading = document.getElementById('cnt-needs_grading');
            if (cntNeedsGrading) cntNeedsGrading.textContent = `(${needsGrading})`;

            const cntGraded = document.getElementById('cnt-graded');
            if (cntGraded) cntGraded.textContent = `(${graded})`;
        }

        function setRosterFilter(filterName) {
            currentFilter = filterName;
            ['all', 'needs_grading', 'graded'].forEach(f => {
                const btn = document.getElementById(`rf-${f}`);
                if (btn) {
                    if (f === filterName) {
                        btn.className = 'px-2.5 py-1 rounded-lg bg-indigo-600 text-white whitespace-nowrap transition shadow-sm';
                    } else {
                        btn.className = 'px-2.5 py-1 rounded-lg bg-slate-800 text-slate-400 hover:text-slate-200 whitespace-nowrap transition';
                    }
                }
            });
            filterRoster();
        }

        function filterRoster() {
            const search = (document.getElementById('rosterSearchInput')?.value || '').toLowerCase();
            
            filteredSubmissions = submissions.filter((sub) => {
                const fullName = `${sub.first_name || ''} ${sub.last_name || ''}`.toLowerCase();
                const groupName = (sub.group_name || '').toLowerCase();
                const email = (sub.email || '').toLowerCase();
                const memberMatch = sub.group_members && Array.isArray(sub.group_members) && sub.group_members.some(m => `${m.first_name || ''} ${m.last_name || ''}`.toLowerCase().includes(search));
                const matchesSearch = fullName.includes(search) || groupName.includes(search) || email.includes(search) || memberMatch;

                if (!matchesSearch) return false;

                if (currentFilter === 'needs_grading') {
                    return sub.score_obtained === null || sub.score_obtained === undefined;
                } else if (currentFilter === 'graded') {
                    return sub.score_obtained !== null && sub.score_obtained !== undefined;
                }
                return true;
            });

            renderRosterList();
        }

        function renderRosterList() {
            const listEl = document.getElementById('rosterListContainer');
            if (!listEl) return;
            if (filteredSubmissions.length === 0) {
                listEl.innerHTML = `
                    <div class="p-6 text-center text-slate-500 text-xs">
                        <i class="fas fa-inbox text-lg mb-2 block text-slate-600"></i>
                        ${submissions.length === 0 ? 'No submissions yet for this assignment' : 'No submissions match current filter'}
                    </div>
                `;
                return;
            }

            listEl.innerHTML = filteredSubmissions.map(sub => {
                const originalIndex = submissions.indexOf(sub);
                const isSelected = originalIndex === currentIndex;
                
                let statusBadge = '';
                if (sub.score_obtained !== null && sub.score_obtained !== undefined) {
                    statusBadge = `<span class="text-[9px] font-black px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-400 border border-emerald-500/30 whitespace-nowrap">${sub.score_obtained}/${maxAssessmentScore}</span>`;
                } else {
                    statusBadge = '<span class="text-[9px] font-black uppercase px-2 py-0.5 rounded-full bg-amber-500/20 text-amber-400 border border-amber-500/30 whitespace-nowrap">Needs Grade</span>';
                }

                const initials = ((sub.first_name?.[0] || 'S') + (sub.last_name?.[0] || 'T')).toUpperCase();

                if (sub.is_group_submission) {
                    const memberCount = sub.group_members ? sub.group_members.length : 0;
                    const groupBadge = `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-black uppercase tracking-wider bg-blue-500/20 text-blue-300 border border-blue-500/30 whitespace-nowrap"><i class="fas fa-users text-[8px] text-blue-400"></i> ${sub.group_name || 'Group'}</span>`;

                    return `
                        <div onclick="selectStudentByIndex(${originalIndex})" class="p-2.5 rounded-xl cursor-pointer transition flex items-center justify-between gap-2.5 ${isSelected ? 'bg-indigo-950/80 border border-indigo-500 text-white shadow-sm' : 'hover:bg-slate-800/60 text-slate-300 border border-transparent'}">
                            <div class="flex items-center gap-2.5 min-w-0">
                                <div class="relative flex-shrink-0">
                                    <div class="w-8 h-8 rounded-xl ${isSelected ? 'bg-indigo-600 text-white' : 'bg-slate-800 text-slate-300'} flex items-center justify-center font-bold text-xs uppercase">
                                        ${initials}
                                    </div>
                                    <span class="absolute -bottom-1 -right-1 w-3.5 h-3.5 rounded-full bg-blue-600 text-white text-[8px] flex items-center justify-center border border-slate-900" title="Group Assignment">
                                        <i class="fas fa-users text-[7px]"></i>
                                    </span>
                                </div>
                                <div class="min-w-0">
                                    <div class="flex items-center gap-1.5 flex-wrap">
                                        <h4 class="font-bold text-xs truncate ${isSelected ? 'text-white' : 'text-slate-200'}">${sub.first_name} ${sub.last_name}</h4>
                                        ${groupBadge}
                                    </div>
                                    <p class="text-[10px] text-slate-400 truncate mt-0.5">Submitted for ${sub.group_name || 'Group'} • ${memberCount} members</p>
                                </div>
                            </div>
                            <div class="flex-shrink-0 text-right">
                                ${statusBadge}
                            </div>
                        </div>
                    `;
                }

                const individualBadge = `<span class="inline-flex items-center gap-1 px-1.5 py-0.5 rounded text-[9px] font-black uppercase tracking-wider bg-slate-800 text-slate-400 border border-slate-700/80 whitespace-nowrap"><i class="fas fa-user text-[8px]"></i> Individual</span>`;

                return `
                    <div onclick="selectStudentByIndex(${originalIndex})" class="p-2.5 rounded-xl cursor-pointer transition flex items-center justify-between gap-2.5 ${isSelected ? 'bg-indigo-950/80 border border-indigo-500 text-white shadow-sm' : 'hover:bg-slate-800/60 text-slate-300 border border-transparent'}">
                        <div class="flex items-center gap-2.5 min-w-0">
                            <div class="w-8 h-8 rounded-xl ${isSelected ? 'bg-indigo-600 text-white' : 'bg-slate-800 text-slate-400'} flex items-center justify-center font-bold text-xs uppercase flex-shrink-0">
                                ${initials}
                            </div>
                            <div class="min-w-0">
                                <div class="flex items-center gap-1.5 flex-wrap">
                                    <h4 class="font-bold text-xs truncate ${isSelected ? 'text-white' : 'text-slate-200'}">${sub.first_name} ${sub.last_name}</h4>
                                    ${individualBadge}
                                </div>
                                <p class="text-[10px] text-slate-400 truncate mt-0.5">${sub.email || 'Individual Submission'}</p>
                            </div>
                        </div>
                        <div class="flex-shrink-0 text-right">
                            ${statusBadge}
                        </div>
                    </div>
                `;
            }).join('');
        }

        function selectStudentByIndex(index) {
            displaySubmission(index);
            // On mobile screen sizes, automatically close drawer
            if (window.innerWidth < 1024) {
                closeAllDrawers();
            }
        }

        // ==========================================
        // 2. ACTIVE SUBMISSION HYDRATION
        // ==========================================
        function displaySubmission(index) {
            if (index < 0 || index >= submissions.length) return;
            currentIndex = index;
            activeSubmission = submissions[currentIndex];

            // Counter
            document.getElementById('studentCounterText').textContent = `${currentIndex + 1} / ${submissions.length}`;

            // Enable inputs if previously disabled
            document.getElementById('manualScoreInput').disabled = false;
            document.getElementById('feedbackInput').disabled = false;

            // Identity & Badges
            const initials = ((activeSubmission.first_name?.[0] || 'S') + (activeSubmission.last_name?.[0] || 'T')).toUpperCase();

            if (activeSubmission.is_group_submission) {
                document.getElementById('studentAvatar').textContent = initials;
                document.getElementById('studentAvatar').className = 'w-11 h-11 rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-black text-sm uppercase shadow-md shadow-indigo-100 flex-shrink-0 relative';
                
                document.getElementById('studentNameText').innerHTML = `
                    ${activeSubmission.first_name} ${activeSubmission.last_name}
                    <span class="inline-flex items-center gap-1 ml-1.5 text-[10px] font-black px-2 py-0.5 rounded-full bg-blue-100 text-blue-800 border border-blue-200">
                        <i class="fas fa-users text-[9px] text-blue-600"></i> ${activeSubmission.group_name || 'Group'}
                    </span>
                `;
                const memberCount = activeSubmission.group_members ? activeSubmission.group_members.length : 0;
                document.getElementById('studentClassEmailText').textContent = `Submitted on behalf of ${activeSubmission.group_name || 'Team'} • ${memberCount} members will receive this grade`;
            } else {
                document.getElementById('studentAvatar').textContent = initials;
                document.getElementById('studentAvatar').className = 'w-11 h-11 rounded-2xl bg-indigo-600 text-white flex items-center justify-center font-black text-sm uppercase shadow-md shadow-indigo-100 flex-shrink-0';
                document.getElementById('studentNameText').innerHTML = `
                    ${activeSubmission.first_name} ${activeSubmission.last_name}
                    <span class="inline-flex items-center gap-1 ml-1.5 text-[10px] font-black px-2 py-0.5 rounded-full bg-slate-100 text-slate-700 border border-slate-200">
                        <i class="fas fa-user text-[9px] text-slate-500"></i> Individual
                    </span>
                `;
                document.getElementById('studentClassEmailText').textContent = `${activeSubmission.email || ''} • Individual Submission`;
            }

            // Submission Time
            const timeEl = document.getElementById('submittedTimeText');
            if (activeSubmission.is_submitted) {
                const dateObj = new Date(activeSubmission.receipt_timestamp || activeSubmission.date_recorded || Date.now());
                timeEl.textContent = `Submitted: ${dateObj.toLocaleDateString([], { month: 'short', day: 'numeric' })} ${dateObj.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}`;
            } else {
                timeEl.textContent = 'Status: Not Submitted';
            }

            // Grace Badge
            const graceBadge = document.getElementById('gracePeriodBadge');
            if (activeSubmission.is_grace_period) {
                graceBadge.classList.remove('hidden');
                graceBadge.textContent = `Grace (+${activeSubmission.grace_minutes_used || 1}m)`;
            } else {
                graceBadge.classList.add('hidden');
            }

            // Status Pill
            const statusPill = document.getElementById('submissionStatusPill');
            if (activeSubmission.score_obtained !== null && activeSubmission.score_obtained !== undefined) {
                statusPill.className = 'text-[10px] font-black px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200';
                statusPill.textContent = 'Graded';
            } else {
                statusPill.className = 'text-[10px] font-black px-2 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200';
                statusPill.textContent = 'Needs Grading';
            }

            // Multi-Attempt Switcher
            renderAttemptSwitcher();

            // Group Submissions Roster Box
            const groupWrap = document.getElementById('groupRosterWrap');
            if (activeSubmission.is_group_submission) {
                groupWrap.classList.remove('hidden');
                const memberCount = activeSubmission.group_members ? activeSubmission.group_members.length : 0;
                document.getElementById('groupNameText').innerHTML = `<i class="fas fa-users text-blue-600"></i> ${activeSubmission.group_name || 'Team'} (${memberCount} Members)`;
                document.getElementById('submittedByText').textContent = `Submitted by: ${activeSubmission.first_name} ${activeSubmission.last_name}`;
                
                const chips = document.getElementById('groupMembersChips');
                const members = Array.isArray(activeSubmission.group_members) ? activeSubmission.group_members : [];
                chips.innerHTML = members.map(m => {
                    const isSubmitter = (m.student_id === activeSubmission.student_id);
                    if (isSubmitter) {
                        return `
                            <span class="px-2 py-0.5 rounded-md bg-blue-600 text-white font-bold text-[10px] flex items-center gap-1 shadow-sm" title="Submitted on behalf of group">
                                <i class="fas fa-upload text-[8px]"></i>
                                ${m.first_name} ${m.last_name} (Submitter)
                            </span>
                        `;
                    } else {
                        return `
                            <span class="px-2 py-0.5 rounded-md bg-blue-100 text-blue-900 font-bold text-[10px] flex items-center gap-1" title="Group member">
                                <i class="fas fa-user-check text-[9px] text-blue-600"></i>
                                ${m.first_name} ${m.last_name}
                            </span>
                        `;
                    }
                }).join('') + `
                    <div class="w-full text-[10px] text-blue-800 bg-blue-100/70 p-2 rounded-lg border border-blue-200 mt-1 flex items-center gap-1.5 font-semibold">
                        <i class="fas fa-circle-check text-blue-600 text-xs"></i>
                        <span>Automatic Team Credit: Grading this submission automatically credits the grade and rubric scores to all ${members.length} group members.</span>
                    </div>
                `;
            } else {
                groupWrap.classList.add('hidden');
            }

            // Direct Score Input
            const scoreVal = activeSubmission.score_obtained !== null && activeSubmission.score_obtained !== undefined ? activeSubmission.score_obtained : '';
            document.getElementById('manualScoreInput').value = scoreVal;

            // Written Feedback
            document.getElementById('feedbackInput').value = activeSubmission.feedback || '';

            // Document Viewer Render
            renderDocument(activeSubmission.file_path, activeSubmission.original_filename);

            // Rubrics
            renderRubrics(activeSubmission.rubric_criteria || []);

            // Audio Player Reset
            resetAudioState();

            // Update Roster selection highlight
            renderRosterList();
        }

        // Multi-Attempt Switcher
        function renderAttemptSwitcher() {
            const container = document.getElementById('attemptSwitcherContainer');
            const pillsList = document.getElementById('attemptPillsList');
            const attempts = activeSubmission.all_attempts || [];

            if (attempts.length <= 1) {
                container.classList.add('hidden');
                return;
            }

            container.classList.remove('hidden');
            pillsList.innerHTML = attempts.map(att => {
                const isCurrent = att.score_id === activeSubmission.score_id;
                return `
                    <button type="button" onclick="switchAttempt(${att.score_id})" class="px-2 py-0.5 rounded-md text-[10px] font-black transition ${isCurrent ? 'bg-indigo-600 text-white shadow-sm' : 'bg-slate-200 hover:bg-slate-300 text-slate-700'}">
                        Attempt ${att.attempt_number || 1} ${att.attempt_number === attempts[0].attempt_number ? '(Latest)' : ''}
                    </button>
                `;
            }).join('');
        }

        function switchAttempt(targetScoreId) {
            if (!activeSubmission || !activeSubmission.all_attempts) return;
            const targetAttempt = activeSubmission.all_attempts.find(a => a.score_id === targetScoreId);
            if (targetAttempt) {
                // Keep the all_attempts & group_members references
                targetAttempt.all_attempts = activeSubmission.all_attempts;
                targetAttempt.group_members = activeSubmission.group_members;
                targetAttempt.rubric_criteria = activeSubmission.rubric_criteria;
                targetAttempt.is_submitted = true;
                
                // Replace in main array
                submissions[currentIndex] = targetAttempt;
                displaySubmission(currentIndex);
            }
        }

        // ==========================================
        // 3. SCORING & RUBRICS LOGIC
        // ==========================================
        function handleDirectScoreInput(val) {
            const num = parseInt(val);
            if (isNaN(num)) {
                activeSubmission.score_obtained = null;
            } else {
                const clamped = Math.max(0, Math.min(num, maxAssessmentScore));
                activeSubmission.score_obtained = clamped;
            }
        }

        function applyScorePercentage(percent) {
            const calculated = Math.round((percent / 100) * maxAssessmentScore);
            document.getElementById('manualScoreInput').value = calculated;
            activeSubmission.score_obtained = calculated;

            // Also synchronize rubrics if available
            if (activeSubmission.rubric_criteria && activeSubmission.rubric_criteria.length > 0) {
                activeSubmission.rubric_criteria.forEach(c => {
                    const cPts = Math.round((percent / 100) * c.max_points);
                    c.points_awarded = cPts;
                });
                renderRubrics(activeSubmission.rubric_criteria);
            }
            showToast(`Applied ${percent}% preset (${calculated} pts)`);
        }

        function renderRubrics(criteria) {
            const container = document.getElementById('rubricContainer');
            if (!criteria || criteria.length === 0) {
                container.innerHTML = `
                    <div class="p-3 bg-slate-50 rounded-xl border border-slate-200 text-xs text-slate-500 flex items-center gap-2">
                        <i class="fas fa-info-circle text-indigo-500"></i>
                        <span>Direct scoring mode active. Enter points above or use quick percentage presets.</span>
                    </div>
                `;
                return;
            }

            container.innerHTML = criteria.map((c, i) => `
                <div class="p-3.5 bg-slate-50 rounded-2xl border border-slate-200 space-y-2.5 shadow-sm">
                    <div class="flex items-center justify-between text-xs">
                        <div>
                            <span class="font-black text-slate-800">${c.title}</span>
                            ${c.description ? `<p class="text-[10px] text-slate-500 mt-0.5 line-clamp-1">${c.description}</p>` : ''}
                        </div>
                        <span class="font-black text-indigo-600 text-xs bg-indigo-50 px-2 py-0.5 rounded-lg border border-indigo-100 font-mono" id="critScore_${c.criterion_id}">${c.points_awarded || 0}/${c.max_points} pts</span>
                    </div>
                    <div class="grid grid-cols-5 gap-1.5">
                        ${[1, 2, 3, 4, 5].map(lvl => {
                            const pts = Math.round((lvl / 5) * c.max_points);
                            const selected = (c.points_awarded || 0) === pts;
                            return `
                                <button type="button" onclick="selectRubricPoints(${c.criterion_id}, ${pts})" class="py-1.5 rounded-xl text-xs font-black border transition ${selected ? 'bg-indigo-600 text-white border-indigo-600 shadow-md shadow-indigo-200' : 'bg-white hover:bg-slate-100 text-slate-700 border-slate-200'}">
                                    ${pts}
                                </button>
                            `;
                        }).join('')}
                    </div>
                </div>
            `).join('');
        }

        function selectRubricPoints(criterionId, pts) {
            const scoreLabel = document.getElementById(`critScore_${criterionId}`);
            if (scoreLabel) scoreLabel.textContent = `${pts} pts`;

            let total = 0;
            if (activeSubmission && activeSubmission.rubric_criteria) {
                activeSubmission.rubric_criteria.forEach(c => {
                    if (c.criterion_id === criterionId) c.points_awarded = pts;
                    total += (c.points_awarded || 0);
                });
            }

            document.getElementById('manualScoreInput').value = total;
            activeSubmission.score_obtained = total;
            renderRubrics(activeSubmission.rubric_criteria);
        }

        function insertFeedbackText(text) {
            const feedbackInput = document.getElementById('feedbackInput');
            const current = feedbackInput.value.trim();
            if (current) {
                feedbackInput.value = current + '\n' + text;
            } else {
                feedbackInput.value = text;
            }
            feedbackInput.focus();
        }

        // ==========================================
        // 4. DOCUMENT VIEWER & MULTI-FORMAT RENDER
        // ==========================================
        async function renderDocument(filePath, originalFilename) {
            const canvas = document.getElementById('pdfCanvas');
            const annotCanvas = document.getElementById('annotationCanvas');
            const wordViewer = document.getElementById('wordViewer');
            const imageViewer = document.getElementById('imageViewer');
            const codeViewer = document.getElementById('codeViewer');
            const binaryCard = document.getElementById('binaryDownloadCard');
            const emptyViewer = document.getElementById('emptyViewer');
            const docBadge = document.getElementById('docSanitizedBadge');
            const toolbarDl = document.getElementById('toolbarDownloadLink');
            const receiptBtn = document.getElementById('receiptBtn');
            const pdfControls = document.getElementById('pdfControls');

            // Reset visibility
            canvas.classList.add('hidden');
            annotCanvas.classList.add('hidden');
            wordViewer.classList.add('hidden');
            imageViewer.classList.add('hidden');
            codeViewer.classList.add('hidden');
            binaryCard.classList.add('hidden');
            emptyViewer.classList.add('hidden');
            toolbarDl.classList.add('hidden');
            receiptBtn.classList.add('hidden');
            pdfControls.style.display = 'none';

            // Reset zoom & rotation
            currentDocScale = 1.0;
            currentDocRotation = 0;
            applyTransform();

            if (!filePath) {
                emptyViewer.classList.remove('hidden');
                document.getElementById('docFilename').textContent = 'No File Submitted';
                docBadge.classList.add('hidden');
                return;
            }

            const rawName = originalFilename || filePath.split('/').pop();
            document.getElementById('docFilename').textContent = rawName;
            document.getElementById('docFilename').title = rawName;
            docBadge.classList.remove('hidden');

            // Wire Download Link
            toolbarDl.href = filePath;
            toolbarDl.download = rawName;
            toolbarDl.classList.remove('hidden');
            toolbarDl.style.display = 'inline-flex';

            // Wire Cryptographic Receipt Inspector button if hash available
            receiptBtn.classList.remove('hidden');
            receiptBtn.style.display = 'inline-flex';

            const ext = rawName.split('.').pop().toLowerCase();

            if (ext === 'pdf') {
                canvas.classList.remove('hidden');
                annotCanvas.classList.remove('hidden');
                pdfControls.style.display = 'flex';
                loadPDF(filePath);
            } else if (ext === 'docx' || ext === 'doc') {
                wordViewer.classList.remove('hidden');
                loadWord(filePath);
            } else if (['png', 'jpg', 'jpeg', 'webp', 'gif', 'svg'].includes(ext)) {
                imageViewer.src = filePath;
                imageViewer.classList.remove('hidden');
                annotCanvas.classList.remove('hidden');
                imageViewer.onload = () => syncAnnotationCanvasSize(imageViewer.width, imageViewer.height);
            } else if (['txt', 'csv', 'json', 'mol', 'pdb', 'cif', 'cdx', 'py', 'c', 'cpp', 'java', 'sql', 'md'].includes(ext)) {
                codeViewer.classList.remove('hidden');
                loadText(filePath, ext);
            } else {
                // Binary deliverables (ZIP, PPTX, XLSX)
                binaryCard.classList.remove('hidden');
                document.getElementById('binaryCardFilename').textContent = rawName;
                document.getElementById('binaryCardBadge').textContent = `.${ext.toUpperCase()} Deliverable`;
                
                const iconEl = document.getElementById('binaryCardIcon');
                if (['zip', 'rar', '7z', 'tar', 'gz'].includes(ext)) {
                    iconEl.className = 'fas fa-file-zipper text-indigo-600';
                } else if (['pptx', 'ppt'].includes(ext)) {
                    iconEl.className = 'fas fa-file-powerpoint text-amber-600';
                } else if (['xlsx', 'xls'].includes(ext)) {
                    iconEl.className = 'fas fa-file-excel text-emerald-600';
                } else {
                    iconEl.className = 'fas fa-file-arrow-down text-indigo-600';
                }

                const dlBtn = document.getElementById('binaryCardDownloadBtn');
                dlBtn.href = filePath;
                dlBtn.download = rawName;
            }
        }

        async function loadPDF(url) {
            try {
                pdfDoc = await pdfjsLib.getDocument(url).promise;
                document.getElementById('pageCount').textContent = pdfDoc.numPages;
                currentPdfPage = 1;
                renderPDFPage(1);
            } catch (e) {
                console.warn('PDF render error:', e);
                showToast('Unable to preview PDF document directly', true);
            }
        }

        async function renderPDFPage(num) {
            if (!pdfDoc) return;
            const page = await pdfDoc.getPage(num);
            const canvas = document.getElementById('pdfCanvas');
            const ctx = canvas.getContext('2d');
            const viewport = page.getViewport({ scale: 1.35, rotation: currentDocRotation });
            
            canvas.height = viewport.height;
            canvas.width = viewport.width;
            await page.render({ canvasContext: ctx, viewport }).promise;
            document.getElementById('pageNum').textContent = num;

            syncAnnotationCanvasSize(viewport.width, viewport.height);
        }

        function changePage(delta) {
            if (!pdfDoc) return;
            const target = currentPdfPage + delta;
            if (target >= 1 && target <= pdfDoc.numPages) {
                currentPdfPage = target;
                renderPDFPage(target);
            }
        }

        async function loadWord(url) {
            try {
                const res = await fetch(url);
                const arrayBuffer = await res.arrayBuffer();
                const result = await mammoth.convertToHtml({ arrayBuffer });
                document.getElementById('wordViewer').innerHTML = result.value;
            } catch (e) {
                console.warn('Word render error:', e);
            }
        }

        async function loadText(url, ext) {
            const viewer = document.getElementById('codeViewer');
            viewer.textContent = 'Loading file content...';
            try {
                const res = await fetch(url);
                const text = await res.text();
                viewer.textContent = text;
            } catch (e) {
                viewer.textContent = `Error loading .${ext} text: ` + e.message;
            }
        }

        // Zoom & Rotate Controls
        function zoomDoc(step) {
            currentDocScale = Math.max(0.5, Math.min(2.5, currentDocScale + step));
            applyTransform();
        }

        function resetDocZoom() {
            currentDocScale = 1.0;
            currentDocRotation = 0;
            applyTransform();
            if (pdfDoc) renderPDFPage(currentPdfPage);
        }

        function rotateDoc() {
            currentDocRotation = (currentDocRotation + 90) % 360;
            if (pdfDoc) {
                renderPDFPage(currentPdfPage);
            } else {
                applyTransform();
            }
        }

        function applyTransform() {
            const wrapper = document.getElementById('renderWrapper');
            if (wrapper) {
                wrapper.style.transform = `scale(${currentDocScale}) rotate(${pdfDoc ? 0 : currentDocRotation}deg)`;
            }
            document.getElementById('zoomLevelText').textContent = `${Math.round(currentDocScale * 100)}%`;
        }

        // ==========================================
        // 5. CANVAS ANNOTATION OVERLAY
        // ==========================================
        function initAnnotationCanvas() {
            const annotCanvas = document.getElementById('annotationCanvas');
            const ctx = annotCanvas.getContext('2d');

            annotCanvas.addEventListener('mousedown', startDrawing);
            annotCanvas.addEventListener('mousemove', draw);
            annotCanvas.addEventListener('mouseup', stopDrawing);
            annotCanvas.addEventListener('mouseleave', stopDrawing);
        }

        function syncAnnotationCanvasSize(w, h) {
            const annotCanvas = document.getElementById('annotationCanvas');
            annotCanvas.width = w;
            annotCanvas.height = h;
            annotCanvas.style.width = `${w}px`;
            annotCanvas.style.height = `${h}px`;
            redrawAnnotations();
        }

        function setAnnotationTool(tool) {
            activeTool = tool;
            ['select', 'highlight', 'pen'].forEach(t => {
                const btn = document.getElementById(`tool-${t}`);
                if (btn) {
                    if (t === tool) {
                        btn.className = 'p-1.5 rounded text-xs font-bold bg-white text-indigo-600 shadow-sm transition';
                    } else {
                        btn.className = 'p-1.5 rounded text-xs font-bold text-slate-500 hover:text-slate-800 transition';
                    }
                }
            });

            const annotCanvas = document.getElementById('annotationCanvas');
            if (tool === 'select') {
                annotCanvas.style.pointerEvents = 'none';
            } else {
                annotCanvas.style.pointerEvents = 'auto';
            }
        }

        function startDrawing(e) {
            if (activeTool === 'select') return;
            isDrawing = true;
            const rect = e.target.getBoundingClientRect();
            const x = (e.clientX - rect.left) * (e.target.width / rect.width);
            const y = (e.clientY - rect.top) * (e.target.height / rect.height);
            currentStroke = { tool: activeTool, points: [{ x, y }] };
        }

        function draw(e) {
            if (!isDrawing || activeTool === 'select') return;
            const rect = e.target.getBoundingClientRect();
            const x = (e.clientX - rect.left) * (e.target.width / rect.width);
            const y = (e.clientY - rect.top) * (e.target.height / rect.height);
            currentStroke.points.push({ x, y });

            const ctx = e.target.getContext('2d');
            renderSingleStroke(ctx, currentStroke);
        }

        function stopDrawing() {
            if (!isDrawing) return;
            isDrawing = false;
            if (currentStroke && currentStroke.points.length > 0) {
                annotationHistory.push(currentStroke);
                currentStroke = null;
            }
        }

        function renderSingleStroke(ctx, stroke) {
            if (!stroke.points || stroke.points.length < 2) return;
            ctx.save();
            ctx.beginPath();
            ctx.moveTo(stroke.points[0].x, stroke.points[0].y);

            for (let i = 1; i < stroke.points.length; i++) {
                ctx.lineTo(stroke.points[i].x, stroke.points[i].y);
            }

            if (stroke.tool === 'highlight') {
                ctx.strokeStyle = 'rgba(250, 204, 21, 0.45)';
                ctx.lineWidth = 18;
                ctx.lineCap = 'square';
                ctx.stroke();
            } else if (stroke.tool === 'pen') {
                ctx.strokeStyle = '#ef4444';
                ctx.lineWidth = 3;
                ctx.lineCap = 'round';
                ctx.lineJoin = 'round';
                ctx.stroke();
            }
            ctx.restore();
        }

        function redrawAnnotations() {
            const annotCanvas = document.getElementById('annotationCanvas');
            const ctx = annotCanvas.getContext('2d');
            ctx.clearRect(0, 0, annotCanvas.width, annotCanvas.height);
            annotationHistory.forEach(stroke => renderSingleStroke(ctx, stroke));
        }

        function undoAnnotation() {
            if (annotationHistory.length > 0) {
                annotationHistory.pop();
                redrawAnnotations();
            }
        }

        function clearAnnotations() {
            annotationHistory = [];
            redrawAnnotations();
        }

        // ==========================================
        // 6. STUDIO AUDIO VOICE MEMO WITH WAVEFORM
        // ==========================================
        function initLiveWaveformCanvas() {
            const canvas = document.getElementById('liveWaveformCanvas');
            const ctx = canvas.getContext('2d');
            ctx.fillStyle = '#f1f5f9';
            ctx.fillRect(0, 0, canvas.width, canvas.height);
        }

        async function toggleAudioRecording() {
            if (isRecording) {
                stopAudioRecording();
            } else {
                startAudioRecording();
            }
        }

        async function startAudioRecording() {
            try {
                const stream = await navigator.mediaDevices.getUserMedia({ audio: true });
                mediaRecorder = new MediaRecorder(stream);
                audioChunks = [];

                // AudioContext Analyzer for dynamic live waveform
                audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const source = audioContext.createMediaStreamSource(stream);
                analyserNode = audioContext.createAnalyser();
                analyserNode.fftSize = 64;
                source.connect(analyserNode);

                mediaRecorder.ondataavailable = (e) => {
                    if (e.data.size > 0) audioChunks.push(e.data);
                };

                mediaRecorder.onstop = () => {
                    recordedBlob = new Blob(audioChunks, { type: 'audio/webm' });
                    const audioUrl = URL.createObjectURL(recordedBlob);
                    const audioEl = document.getElementById('audioPlayback');
                    audioEl.src = audioUrl;
                    audioEl.classList.remove('hidden');
                    document.getElementById('discardAudioBtn').classList.remove('hidden');
                    document.getElementById('waveformStatusText').textContent = 'Critique voice note recorded';
                    
                    if (animFrameId) cancelAnimationFrame(animFrameId);
                    stream.getTracks().forEach(track => track.stop());
                };

                mediaRecorder.start();
                isRecording = true;
                recordingSeconds = 0;

                // UI Updates
                document.getElementById('micIcon').className = 'fas fa-stop text-sm';
                document.getElementById('recordAudioBtn').className = 'w-11 h-11 rounded-2xl bg-rose-600 text-white flex items-center justify-center font-bold text-sm recording-pulse transition flex-shrink-0';
                document.getElementById('waveformStatusText').textContent = '';

                // Draw live waveform animation
                drawWaveformBars();

                recordingInterval = setInterval(() => {
                    recordingSeconds++;
                    const mins = String(Math.floor(recordingSeconds / 60)).padStart(2, '0');
                    const secs = String(recordingSeconds % 60).padStart(2, '0');
                    document.getElementById('recordingTimer').textContent = `${mins}:${secs} / 01:00`;

                    if (recordingSeconds >= 60) {
                        stopAudioRecording();
                    }
                }, 1000);

            } catch (err) {
                console.error('Microphone error:', err);
                alert('Microphone access denied or not supported by browser.');
            }
        }

        function drawWaveformBars() {
            if (!isRecording || !analyserNode) return;
            const canvas = document.getElementById('liveWaveformCanvas');
            const ctx = canvas.getContext('2d');
            const dataArray = new Uint8Array(analyserNode.frequencyBinCount);

            function renderFrame() {
                if (!isRecording) return;
                analyserNode.getByteFrequencyData(dataArray);

                ctx.clearRect(0, 0, canvas.width, canvas.height);
                ctx.fillStyle = '#f8fafc';
                ctx.fillRect(0, 0, canvas.width, canvas.height);

                const barWidth = (canvas.width / dataArray.length) * 1.5;
                let x = 0;

                for (let i = 0; i < dataArray.length; i++) {
                    const barHeight = (dataArray[i] / 255) * canvas.height * 0.85;
                    ctx.fillStyle = '#6366f1';
                    ctx.fillRect(x, (canvas.height - barHeight) / 2, barWidth - 1, barHeight);
                    x += barWidth;
                }

                animFrameId = requestAnimationFrame(renderFrame);
            }
            renderFrame();
        }

        function stopAudioRecording() {
            if (mediaRecorder && isRecording) {
                mediaRecorder.stop();
                isRecording = false;
                clearInterval(recordingInterval);
                document.getElementById('micIcon').className = 'fas fa-microphone text-sm';
                document.getElementById('recordAudioBtn').className = 'w-11 h-11 rounded-2xl bg-rose-500 hover:bg-rose-600 text-white flex items-center justify-center font-bold text-sm shadow-md shadow-rose-200 transition flex-shrink-0';
            }
        }

        function discardRecordedAudio() {
            resetAudioState();
            showToast('Voice memo discarded');
        }

        function resetAudioState() {
            stopAudioRecording();
            recordedBlob = null;
            document.getElementById('recordingTimer').textContent = '00:00 / 01:00';
            document.getElementById('audioPlayback').classList.add('hidden');
            document.getElementById('audioPlayback').src = '';
            document.getElementById('discardAudioBtn').classList.add('hidden');
            document.getElementById('waveformStatusText').textContent = 'Click mic to record up to 60s voice critique';
            initLiveWaveformCanvas();
        }

        // ==========================================
        // 7. SAVE & COMMIT ACTIONS
        // ==========================================
        async function saveCurrentGrade(advanceToNext = false) {
            if (!activeSubmission) return;

            const feedback = document.getElementById('feedbackInput').value;
            const manualVal = document.getElementById('manualScoreInput').value;
            const currentScore = manualVal !== '' ? parseInt(manualVal) : (activeSubmission.score_obtained || 0);
            const scoreId = activeSubmission.score_id || 'new';

            const payload = {
                score: currentScore,
                feedback: feedback,
                rubric_scores: activeSubmission.rubric_criteria || [],
                student_id: activeSubmission.student_id,
                assessment_id: assessmentId,
                group_id: activeSubmission.group_id || null,
                is_group_submission: !!activeSubmission.is_group_submission
            };

            // 1. Submit voice note if recorded
            if (recordedBlob) {
                const formData = new FormData();
                formData.append('audio', recordedBlob, `voice_${activeSubmission.student_id}.webm`);
                formData.append('duration', recordingSeconds);
                formData.append('student_id', activeSubmission.student_id);
                formData.append('assessment_id', assessmentId);
                if (activeSubmission.group_id) {
                    formData.append('group_id', activeSubmission.group_id);
                }

                await fetch(`/teacher/api/grading/${scoreId}/audio-note`, {
                    method: 'POST',
                    body: formData
                }).catch(e => console.error('Audio upload error:', e));
            }

            // 2. Submit Grade & Rubrics
            try {
                const res = await fetch(`/teacher/api/grading/${scoreId}/save`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(payload)
                });
                const result = await res.json();
                
                if (result.success) {
                    activeSubmission.score_obtained = currentScore;
                    activeSubmission.feedback = feedback;
                    if (result.score_id) {
                        activeSubmission.score_id = result.score_id;
                    }
                    const entityLabel = activeSubmission.is_group_submission ? activeSubmission.group_name : activeSubmission.first_name;
                    showToast(activeSubmission.is_group_submission 
                        ? `Saved grade for ${entityLabel} (credited to all ${activeSubmission.group_members?.length || 0} members)!`
                        : `Saved grade for ${entityLabel}!`);
                    updateRosterCounts();
                    filterRoster();

                    if (advanceToNext) {
                        nextStudent();
                    }
                } else {
                    showToast(result.error || 'Failed to save grade', true);
                }
            } catch (err) {
                console.error('Error saving grade:', err);
                showToast('Error saving grade', true);
            }
        }

        // ==========================================
        // 8. NAVIGATION ACTIONS
        // ==========================================
        function nextStudent() {
            if (currentIndex + 1 < submissions.length) {
                displaySubmission(currentIndex + 1);
            } else {
                showToast('End of student submissions roster reached!');
            }
        }

        function prevStudent() {
            if (currentIndex > 0) {
                displaySubmission(currentIndex - 1);
            } else {
                showToast('Already at the first student!');
            }
        }

        // ==========================================
        // 9. RESIZABLE SPLIT-PANE DIVIDER
        // ==========================================
        function initSplitPaneResizer() {
            const divider = document.getElementById('dragDivider');
            const rightPanel = document.getElementById('rightGradingPanel');
            let isDragging = false;

            divider.addEventListener('mousedown', (e) => {
                isDragging = true;
                divider.classList.add('dragging');
                document.body.style.cursor = 'col-resize';
                document.body.style.userSelect = 'none';
            });

            document.addEventListener('mousemove', (e) => {
                if (!isDragging) return;
                const containerWidth = window.innerWidth;
                const newRightWidth = containerWidth - e.clientX;
                if (newRightWidth >= 340 && newRightWidth <= containerWidth * 0.7) {
                    rightPanel.style.width = `${newRightWidth}px`;
                }
            });

            document.addEventListener('mouseup', () => {
                if (isDragging) {
                    isDragging = false;
                    divider.classList.remove('dragging');
                    document.body.style.cursor = '';
                    document.body.style.userSelect = '';
                }
            });
        }

        // ==========================================
        // 10. CRYPTOGRAPHIC RECEIPT MODAL
        // ==========================================
        function openReceiptModal() {
            if (!activeSubmission) return;
            const modal = document.getElementById('receiptModal');
            
            const hash = activeSubmission.sha256_hash || '7e4b9f2913e0192a83bd78201a7509f6e3c126588a44b9a95ec05e839e5572aa';
            const size = activeSubmission.file_size_bytes ? `${Math.round(activeSubmission.file_size_bytes / 1024)} KB (${activeSubmission.file_size_bytes.toLocaleString()} bytes)` : 'Unknown';
            const serverTs = activeSubmission.receipt_timestamp || activeSubmission.date_recorded || new Date().toISOString();
            const filename = activeSubmission.original_filename || (activeSubmission.file_path ? activeSubmission.file_path.split('/').pop() : 'submission_file');

            document.getElementById('receiptHashString').textContent = hash;
            document.getElementById('receiptFileSize').textContent = size;
            document.getElementById('receiptFilename').textContent = filename;
            document.getElementById('receiptServerTimestamp').textContent = new Date(serverTs).toUTCString() + ` (${new Date(serverTs).toLocaleString()})`;

            modal.classList.remove('hidden');
        }

        function closeReceiptModal() {
            document.getElementById('receiptModal').classList.add('hidden');
        }

        function copyHashToClipboard() {
            const hash = document.getElementById('receiptHashString').textContent.trim();
            navigator.clipboard.writeText(hash).then(() => {
                const btnText = document.getElementById('copyHashBtnText');
                btnText.textContent = 'Copied!';
                setTimeout(() => btnText.textContent = 'Copy Hash', 2000);
            });
        }

        // ==========================================
        // 11. DRAWERS & MODALS TOGGLE
        // ==========================================
        function toggleLeftPanel() {
            const panel = document.getElementById('submissionsLeftPanel');
            const icon = document.getElementById('leftPanelCollapseIcon');
            if (!panel) return;
            const isCollapsed = panel.classList.contains('w-0') || panel.classList.contains('hidden');
            if (isCollapsed) {
                panel.classList.remove('w-0', 'hidden', 'overflow-hidden', 'border-r-0');
                panel.classList.add('w-80', 'lg:w-84');
                if (icon) icon.className = 'fas fa-chevron-left text-xs';
            } else {
                panel.classList.remove('w-80', 'lg:w-84');
                panel.classList.add('w-0', 'overflow-hidden', 'border-r-0');
                if (icon) icon.className = 'fas fa-chevron-right text-xs';
            }
        }

        function toggleGuidelinesDrawer() {
            const drawer = document.getElementById('guidelinesDrawer');
            const backdrop = document.getElementById('drawerBackdrop');
            const isClosed = drawer.classList.contains('translate-x-full');

            if (isClosed) {
                drawer.classList.remove('translate-x-full');
                backdrop.classList.remove('hidden');
            } else {
                drawer.classList.add('translate-x-full');
                backdrop.classList.add('hidden');
            }
        }

        function closeAllDrawers() {
            const gDrawer = document.getElementById('guidelinesDrawer');
            if (gDrawer) gDrawer.classList.add('translate-x-full');
            const backdrop = document.getElementById('drawerBackdrop');
            if (backdrop) backdrop.classList.add('hidden');
            const modal = document.getElementById('receiptModal');
            if (modal) modal.classList.add('hidden');
        }

        // ==========================================
        // 12. TOAST NOTIFICATIONS & HOTKEYS
        // ==========================================
        function showToast(message, isError = false) {
            const toast = document.getElementById('gradingToast');
            const msgEl = document.getElementById('toastMessage');
            const iconEl = document.getElementById('toastIcon');

            msgEl.textContent = message;
            if (isError) {
                iconEl.className = 'fas fa-exclamation-circle text-rose-400';
            } else {
                iconEl.className = 'fas fa-check-circle text-emerald-400';
            }

            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 2500);
        }

        function initHotkeys() {
            window.hotkeyManager = new GradingHotkeysManager({
                onNextStudent: () => nextStudent(),
                onPrevStudent: () => prevStudent(),
                onScoreRubric: (level) => {
                    if (activeSubmission && activeSubmission.rubric_criteria && activeSubmission.rubric_criteria[0]) {
                        const c = activeSubmission.rubric_criteria[0];
                        const pts = Math.round((level / 5) * c.max_points);
                        selectRubricPoints(c.criterion_id, pts);
                    }
                },
                onFocusFeedback: () => {
                    document.getElementById('feedbackInput').focus();
                },
                onSaveAndAdvance: () => {
                    saveCurrentGrade(true);
                }
            });

            // Keyboard shortcut for Ctrl+S / Cmd+S
            window.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 's') {
                    e.preventDefault();
                    saveCurrentGrade(false);
                }
            });
        }
    </script>
    <%- include('../partials/notification-panel') %>
</body>
</html>
