                        class="px-4 py-2.5 <%= isGradingLocked ? 'bg-slate-100 text-slate-400 cursor-not-allowed border-slate-200' : 'bg-white hover:bg-slate-100 text-slate-700 border-slate-200 shadow-sm' %> border rounded-xl text-xs font-black transition flex items-center gap-1.5" 
