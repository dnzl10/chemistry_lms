<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Analysis | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        #mainScroll { overflow-y: auto; }
        #mainScroll::-webkit-scrollbar { width: 5px; }
        #mainScroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }

        .section-card { background: white; border-radius: 1.25rem; border: 1px solid #e2e8f0; overflow: hidden; }
        .section-header { padding: 14px 18px; border-bottom: 1px solid #f1f5f9; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 10px; }

        /* ── Success bar ── */
        .success-bar-track { height: 8px; background: #f1f5f9; border-radius: 9999px; overflow: hidden; }
        .success-bar-fill  { height: 100%; border-radius: 9999px; transition: width 0.6s ease; }

        /* ── Difficulty badges ── */
        .diff-easy      { background: #dcfce7; color: #15803d; }
        .diff-average   { background: #fef9c3; color: #a16207; }
        .diff-difficult { background: #fee2e2; color: #b91c1c; }

        /* ── Input mode badges ── */
        .mode-badge { display: inline-flex; align-items: center; gap: 3px; padding: 2px 8px; border-radius: 9999px; font-size: 10px; font-weight: 700; background: #ede9fe; color: #5b21b6; }

        /* ── Option bar ── */
        .opt-bar { height: 6px; border-radius: 9999px; transition: width 0.5s; }

        /* ── Form ── */
        .form-input, .form-select, .form-textarea {
            width: 100%; padding: 8px 11px; border: 1px solid #e2e8f0; border-radius: 9px;
            font-size: 13px; font-family: 'Plus Jakarta Sans', sans-serif; color: #1e293b;
            outline: none; transition: border-color .2s, box-shadow .2s; background: white;
        }
        .form-input:focus, .form-select:focus, .form-textarea:focus { border-color: #6366f1; box-shadow: 0 0 0 3px rgba(99,102,241,.1); }
        .form-textarea { resize: vertical; min-height: 72px; }
        .form-label { font-size: 11px; font-weight: 700; color: #475569; text-transform: uppercase; letter-spacing: .05em; margin-bottom: 4px; display: block; }

        /* ── Buttons ── */
        .btn { display: inline-flex; align-items: center; gap: 5px; padding: 7px 14px; border-radius: 9px; font-size: 12px; font-weight: 700; cursor: pointer; transition: all .15s; border: 1px solid transparent; font-family: 'Plus Jakarta Sans', sans-serif; }
        .btn-primary  { background: #6366f1; color: white; border-color: #4f46e5; }
        .btn-primary:hover { background: #4f46e5; }
        .btn-outline  { background: white; color: #475569; border-color: #e2e8f0; }
        .btn-outline:hover { border-color: #6366f1; color: #6366f1; background: #faf5ff; }
        .btn-danger   { background: white; color: #dc2626; border-color: #fca5a5; }
        .btn-danger:hover { background: #fff1f2; }
        .btn-success  { background: #059669; color: white; border-color: #047857; }
        .btn-success:hover { background: #047857; }
        .btn-sm { padding: 5px 10px; font-size: 11px; }
        .btn-teal { background: #0d9488; color: white; border-color: #0f766e; }
        .btn-teal:hover { background: #0f766e; }

        /* ── Modal ── */
        .modal-backdrop { display: none; position: fixed; inset: 0; z-index: 200; background: rgba(15,23,42,.55); align-items: center; justify-content: center; padding: 16px; }
        .modal-backdrop.open { display: flex; }
        .modal-card { background: white; border-radius: 1.25rem; width: 100%; max-width: 640px; max-height: 92vh; overflow-y: auto; box-shadow: 0 20px 60px rgba(15,23,42,.2); animation: mIn .2s ease; }
        .modal-card.wide { max-width: 820px; }
        .modal-card::-webkit-scrollbar { width: 4px; }
        .modal-card::-webkit-scrollbar-thumb { background: #e2e8f0; border-radius: 9999px; }
        @keyframes mIn { from { opacity:0; transform:scale(.96) translateY(8px); } to { opacity:1; transform:scale(1) translateY(0); } }
        .modal-header { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-bottom: 1px solid #f1f5f9; position: sticky; top: 0; background: white; z-index: 5; }
        .modal-body   { padding: 18px 20px; display: flex; flex-direction: column; gap: 13px; }
        .modal-footer { padding: 14px 20px; border-top: 1px solid #f1f5f9; display: flex; justify-content: flex-end; gap: 8px; }

        /* ── Toast ── */
        #an-toast { position: fixed; bottom: 24px; right: 24px; z-index: 999; background: #1e293b; color: white; padding: 10px 18px; border-radius: 10px; font-size: 13px; font-weight: 600; box-shadow: 0 8px 24px rgba(15,23,42,.2); transform: translateY(80px); opacity: 0; transition: all .3s ease; pointer-events: none; display: flex; align-items: center; gap: 8px; max-width: 340px; }
        #an-toast.show { transform: translateY(0); opacity: 1; }
        #an-toast.success { background: #064e3b; }
        #an-toast.error   { background: #7f1d1d; }

        /* ── Q-Row ── */
        .q-row { border: 1px solid #e2e8f0; border-radius: 1rem; padding: 16px; transition: box-shadow .2s, border-color .2s; background: white; }
        .q-row:hover { box-shadow: 0 4px 16px rgba(99,102,241,.08); border-color: #c7d2fe; }
        .q-row.danger-row { border-left: 3px solid #ef4444; }

        /* ── Remediation status pill ── */
        .rem-pill { font-size: 10px; font-weight: 700; padding: 2px 8px; border-radius: 9999px; }
        .rem-none    { background: #fef3c7; color: #a16207; }
        .rem-partial { background: #e0f2fe; color: #0369a1; }
        .rem-done    { background: #dcfce7; color: #15803d; }

        /* ── Link preview card ── */
        .link-preview-card { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; display: flex; gap: 0; }
        .link-preview-thumb { width: 90px; min-height: 70px; background: #f1f5f9; flex-shrink: 0; object-fit: cover; }
        .link-preview-body { padding: 10px 12px; flex: 1; min-width: 0; }

        /* ── Drag-drop zone ── */
        .drop-zone { border: 2px dashed #c7d2fe; border-radius: 10px; padding: 20px; text-align: center; transition: all .2s; cursor: pointer; background: #faf5ff; }
        .drop-zone.dragover { border-color: #6366f1; background: #ede9fe; }

        /* ── Student drilldown row ── */
        .drill-row { display: flex; align-items: center; gap: 10px; padding: 10px 14px; border-radius: 10px; border: 1px solid #f1f5f9; background: #fafafa; }
        .drill-row.wrong { border-left: 3px solid #ef4444; background: #fff5f5; }
        .drill-row.right { border-left: 3px solid #10b981; background: #f0fdf4; }

        /* ── Insight card ── */
        .insight-card { border-radius: 12px; padding: 14px 16px; border: 1px solid; }
        .insight-warn  { background: #fff7ed; border-color: #fed7aa; }
        .insight-info  { background: #eff6ff; border-color: #bfdbfe; }
        .insight-ok    { background: #f0fdf4; border-color: #bbf7d0; }

        @keyframes fadeUp { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:translateY(0); } }
        .fade-in { animation: fadeUp .2s ease forwards; }

        /* ── Tab strip ── */
        .tab-btn { padding: 8px 18px; border-radius: 9px; font-size: 12px; font-weight: 700; color: #64748b; cursor: pointer; border: none; background: transparent; font-family: 'Plus Jakarta Sans', sans-serif; transition: all .15s; }
        .tab-btn:hover  { background: white; color: #334155; }
        .tab-btn.active { background: white; color: #6366f1; box-shadow: 0 1px 6px rgba(0,0,0,.1); }
        .tab-panel { display: none; }
        .tab-panel.active { display: block; }

        /* Nav active state */
        .nav-active {
            background: linear-gradient(135deg, #06b6d4 0%, #6366f1 100%) !important;
            color: white !important;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(6,182,212,0.3), 0 2px 8px rgba(99,102,241,0.4);
        }
        .nav-active i { color: white !important; }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    </style>
</head>
<body class="text-slate-900">

<div id="an-toast"></div>

<div class="flex min-h-screen relative overflow-x-hidden">

    <!-- Sidebar overlay -->
    <div id="sidebarOverlay" onclick="toggleSidebar()" class="fixed inset-0 bg-cyan-900/50 z-40 hidden md:hidden"></div>

        <aside id="sidebar" class="text-white w-64 flex-shrink-0 flex flex-col z-50 fixed inset-y-0 left-0 -translate-x-full md:translate-x-0 h-screen border-r border-indigo-900/60" style="background: linear-gradient(180deg, #0d1a2e 0%, #0b1523 100%);">
            <div class="pt-8 pb-4 px-4 flex flex-col items-center text-center relative">
                <!-- Mobile close button -->
                <button onclick="toggleSidebar()" class="md:hidden text-indigo-300 hover:text-white absolute top-4 right-4">
                    <i class="fas fa-times text-xl"></i>
                </button>

                <!-- Logo -->
                <img src="/assets/logo.png" alt="ChemArcade Logo" class="w-16 h-16 object-contain mb-3">

                <!-- Brand name -->
                <h1 class="text-xl font-black tracking-tighter text-cyan-400 uppercase italic leading-none">
                    Elem<span class="text-white">enta</span>
                </h1>
                <p class="text-[10px] text-indigo-400 font-bold uppercase tracking-widest mt-1">Teacher Portal</p>

                <!-- Divider -->
                <!-- <div class="w-full mt-5 border-t border-indigo-800/60"></div> -->
            </div>

            <nav class="flex-1 px-4 mt-4 space-y-6 overflow-y-auto no-scrollbar pb-6">

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Main Interface</p>
                    <div class="space-y-1">
                        <a href="/teacher/dashboard" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-chart-pie w-5 text-cyan-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Dashboard</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Academic Management</p>
                    <div class="space-y-1">
                        <a href="/teacher/classes" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-chalkboard-user w-5 text-emerald-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">My Classes</span>
                        </a>
                    </div>

                    <div class="space-y-1">
                        <a href="/teacher/question-bank" class="nav-active flex items-center gap-3 p-3 rounded-xl transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-database w-5 text-rose-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Question Bank</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Engagement and Communication</p>
                    <div class="space-y-1">
                        <a href="/teacher/forums" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-comments w-5 text-amber-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Forums</span>
                        </a>
                    </div>
                </div>

                <div>
                    <p class="text-[10px] font-black uppercase tracking-widest text-indigo-400 px-3 mb-2 opacity-90">Reports and Analytics</p>
                    <div class="space-y-1">
                        <a href="/teacher/reports" class="flex items-center gap-3 p-3 rounded-xl hover:bg-indigo-500/10 transition text-indigo-200 hover:text-white group">
                            <i class="fas fa-file-export w-5 text-fuchsia-400 group-hover:scale-110 transition-transform"></i>
                            <span class="font-bold tracking-tight text-base">Reports</span>
                        </a>
                    </div>
                </div>
            </nav>

            <div class="p-4 border-t" style="border-color: rgba(99,102,241,0.25);">
                <a href="/logout"
                class="flex items-center gap-3 p-3 rounded-xl text-rose-400 hover:bg-rose-500/10 transition group font-bold">
                    <i class="fas fa-right-from-bracket w-5"></i> Log Out
                </a>
            </div>
        </aside>

    <!-- ===== MAIN ===== -->
    <main class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- Header -->
        <header class="h-20 bg-white/90 backdrop-blur-md border-b border-cyan-100 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-50">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" class="p-2 rounded-lg hover:bg-cyan-50 text-cyan-600 md:hidden">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <div>
                    <div class="flex items-center gap-2">
                        <a href="/teacher/dashboard" class="text-xs font-bold text-indigo-300 hover:text-cyan-500 transition">Dashboard</a>
                        <span class="text-indigo-200 text-xs">/</span>
                        <span class="text-xs font-black text-indigo-900 uppercase tracking-tight">Attempt Analysis</span>
                    </div>
                    <p class="text-[10px] text-slate-400 mt-0.5">
                        <span class="font-black text-cyan-600"><%= attempt.first_name %> <%= attempt.last_name %></span>
                        &nbsp;•&nbsp;<%= attempt.assessment_name %>
                        &nbsp;•&nbsp;<%= attempt.topic_name %>
                    </p>
                </div>
            </div>
            <div class="flex items-center gap-3 md:gap-6">
                <div class="relative cursor-pointer p-2 hover:bg-cyan-50 rounded-full transition">
                    <i class="far fa-bell text-xl text-cyan-600"></i>
                    <span class="absolute top-2 right-2 flex h-2.5 w-2.5">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-rose-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-rose-500"></span>
                    </span>
                </div>
                <div class="flex items-center gap-3 pl-4 border-l border-cyan-100">
                    <div class="text-right hidden lg:block">
                        <p class="text-sm font-bold text-indigo-900"><%= user.first_name %> <%= user.last_name %></p>
                        <p class="text-[10px] uppercase font-black text-cyan-500 tracking-widest">Instructor</p>
                    </div>
                    <img src="/profile_uploads/<%= user.profile_pic || 'default_avatar.png' %>"
                         class="w-10 h-10 rounded-xl object-cover ring-2 ring-cyan-400 shadow-sm shadow-cyan-200"
                         onerror="this.src='/profile_uploads/default_avatar.png'">
                </div>
            </div>
        </header>

        <!-- ===== SCROLLABLE BODY ===== -->
        <div id="mainScroll" class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
            <div class="p-4 md:p-8 flex-1">

                <!-- ══════════════════════════════════════════════ -->
                <!-- HERO SUMMARY STRIP                             -->
                <!-- ══════════════════════════════════════════════ -->
                <div class="section-card p-0 overflow-hidden mb-6">
                    <div class="bg-gradient-to-r from-indigo-950 to-indigo-800 px-6 py-5 flex flex-wrap gap-6 items-center justify-between">
                        <div class="flex items-center gap-4">
                            <img src="/profile_uploads/<%= attempt.student_pic || 'default_avatar.png' %>"
                                 class="w-14 h-14 rounded-2xl object-cover ring-2 ring-cyan-400"
                                 onerror="this.src='/profile_uploads/default_avatar.png'">
                            <div>
                                <p class="text-white font-black text-lg"><%= attempt.first_name %> <%= attempt.last_name %></p>
                                <p class="text-cyan-300 text-xs font-bold uppercase tracking-wide"><%= attempt.assessment_name %> &nbsp;•&nbsp; <%= attempt.topic_name %></p>
                                <p class="text-indigo-300 text-[10px] font-bold mt-0.5"><%= attempt.subject_name %> &nbsp;•&nbsp; Q<%= attempt.quarter_number %></p>
                            </div>
                        </div>
                        <div class="flex gap-6 flex-wrap">
                            <div class="text-center">
                                <p class="text-indigo-300 text-[10px] font-black uppercase">Score</p>
                                <p class="text-white font-black text-2xl"><%= attempt.score_obtained %><span class="text-indigo-400 text-base font-bold"> / <%= attempt.total_items %></span></p>
                            </div>
                            <div class="text-center">
                                <p class="text-indigo-300 text-[10px] font-black uppercase">Accuracy</p>
                                <p class="text-white font-black text-2xl"><%= Math.round((attempt.score_obtained / attempt.total_items) * 100) %>%</p>
                            </div>
                            <div class="text-center">
                                <p class="text-indigo-300 text-[10px] font-black uppercase">EXP Gained</p>
                                <p class="text-emerald-400 font-black text-2xl">+<%= attempt.exp_gained %></p>
                            </div>
                            <div class="text-center">
                                <p class="text-indigo-300 text-[10px] font-black uppercase">Type</p>
                                <p class="text-white font-black text-sm mt-1"><%= attempt.assessment_type %></p>
                            </div>
                            <div class="text-center">
                                <p class="text-indigo-300 text-[10px] font-black uppercase">Date</p>
                                <p class="text-white font-black text-sm mt-1"><%= new Date(attempt.date_recorded).toLocaleDateString('en-PH', {month:'short', day:'numeric', year:'numeric'}) %></p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════ -->
                <!-- AUTOMATED FOCUS AREAS (Feature 5)             -->
                <!-- ══════════════════════════════════════════════ -->
                <% if (insights && insights.length > 0) { %>
                <div class="section-card mb-6">
                    <div class="section-header">
                        <div class="flex items-center gap-2">
                            <div class="w-7 h-7 rounded-lg bg-amber-100 flex items-center justify-center">
                                <i class="fas fa-robot text-amber-600 text-xs"></i>
                            </div>
                            <h2 class="text-sm font-black text-indigo-950 uppercase tracking-tight">Automated Focus Areas</h2>
                        </div>
                        <span class="text-[10px] font-black text-amber-600 uppercase bg-amber-50 border border-amber-200 px-3 py-1 rounded-full"><%= insights.length %> insight<%= insights.length > 1 ? 's' : '' %></span>
                    </div>
                    <div class="p-4 grid grid-cols-1 md:grid-cols-2 gap-3">
                        <% insights.forEach(ins => { %>
                        <div class="insight-card insight-<%= ins.type %>">
                            <div class="flex items-start gap-3">
                                <i class="fas fa-<%= ins.icon %> text-<%= ins.color %>-500 mt-0.5 text-sm"></i>
                                <div>
                                    <p class="text-xs font-black text-<%= ins.color %>-800"><%= ins.title %></p>
                                    <p class="text-[11px] text-<%= ins.color %>-700 mt-0.5 leading-relaxed"><%= ins.message %></p>
                                </div>
                            </div>
                        </div>
                        <% }) %>
                    </div>
                </div>
                <% } %>

                <!-- ══════════════════════════════════════════════ -->
                <!-- TAB STRIP                                      -->
                <!-- ══════════════════════════════════════════════ -->
                <div class="bg-white/80 backdrop-blur border border-cyan-100 rounded-2xl p-1.5 flex gap-1 flex-wrap mb-2">
                    <button class="tab-btn active" onclick="switchTab('item-perf')">
                        <i class="fas fa-list-check mr-1"></i> Item Performance
                    </button>
                    <button class="tab-btn" onclick="switchTab('student-drill')">
                        <i class="fas fa-user-magnifying-glass mr-1"></i> Student Drilldown
                    </button>
                    <button class="tab-btn" onclick="switchTab('remediation')">
                        <i class="fas fa-kit-medical mr-1"></i> Remediation Suite
                        <% const unremCount = questions.filter(q => !q.rem_material_id && !q.rem_advice).length; %>
                        <% if (unremCount > 0) { %>
                        <span class="ml-1 bg-rose-500 text-white text-[9px] font-black px-1.5 py-0.5 rounded-full"><%= unremCount %></span>
                        <% } %>
                    </button>
                </div>

                <!-- ══════════════════════════════════════════════ -->
                <!-- TAB 1: ITEM PERFORMANCE (Features 1 & 3)      -->
                <!-- ══════════════════════════════════════════════ -->
                <div id="tab-item-perf" class="tab-panel active space-y-4">

                    <!-- Bulk topic intervention bar -->
                    <div class="bg-indigo-50 border border-indigo-200 rounded-2xl px-5 py-3 flex flex-wrap items-center justify-between gap-3">
                        <div>
                            <p class="text-xs font-black text-indigo-800 uppercase">Bulk Topic Intervention</p>
                            <p class="text-[11px] text-indigo-500 mt-0.5">Apply one material or advice to ALL questions under <span class="font-bold"><%= attempt.topic_name %></span> at once.</p>
                        </div>
                        <button class="btn btn-primary btn-sm" onclick="openBulkModal()">
                            <i class="fas fa-wand-magic-sparkles"></i> Apply to Entire Topic
                        </button>
                    </div>

                    <!-- Question rows -->
                    <% questions.forEach((q, idx) => {
                        const successRate = q.total_responses > 0 ? Math.round((q.correct_count / q.total_responses) * 100) : 0;
                        const isDanger = successRate < 50;
                        const avgSec = q.avg_response_ms ? (q.avg_response_ms / 1000).toFixed(1) : '—';
                        const hasRem = q.rem_material_id || q.rem_advice || q.rem_link_url;
                    %>
                    <div class="q-row <%= isDanger ? 'danger-row' : '' %> fade-in">
                        <div class="flex flex-wrap gap-4 items-start justify-between mb-3">
                            <div class="flex items-start gap-3 flex-1 min-w-0">
                                <span class="flex-shrink-0 w-7 h-7 rounded-lg bg-indigo-100 text-indigo-700 text-xs font-black flex items-center justify-center mt-0.5">#<%= idx + 1 %></span>
                                <div class="min-w-0">
                                    <p class="text-sm font-bold text-slate-800 leading-snug"><%= q.question_text %></p>
                                    <div class="flex flex-wrap gap-1.5 mt-1.5">
                                        <span class="rem-pill diff-<%= q.difficulty.toLowerCase() %>"><%= q.difficulty %></span>
                                        <span class="mode-badge"><i class="fas fa-gamepad text-[9px]"></i> <%= q.input_mode %></span>
                                        <% if (hasRem) { %>
                                        <span class="rem-pill rem-done"><i class="fas fa-check text-[9px]"></i> Remediation Set</span>
                                        <% } else { %>
                                        <span class="rem-pill rem-none">No Remediation</span>
                                        <% } %>
                                        <% if (isDanger) { %>
                                        <span class="rem-pill" style="background:#fee2e2;color:#b91c1c;"><i class="fas fa-triangle-exclamation text-[9px]"></i> High Failure</span>
                                        <% } %>
                                    </div>
                                </div>
                            </div>
                            <!-- Stats cluster -->
                            <div class="flex gap-4 text-center flex-shrink-0">
                                <div>
                                    <p class="text-[10px] font-black text-slate-400 uppercase">Success</p>
                                    <p class="text-base font-black <%= isDanger ? 'text-red-600' : 'text-emerald-600' %>"><%= successRate %>%</p>
                                </div>
                                <div>
                                    <p class="text-[10px] font-black text-slate-400 uppercase">Avg Time</p>
                                    <p class="text-base font-black text-indigo-700"><%= avgSec %>s</p>
                                </div>
                                <div>
                                    <p class="text-[10px] font-black text-slate-400 uppercase">Responses</p>
                                    <p class="text-base font-black text-slate-600"><%= q.total_responses %></p>
                                </div>
                            </div>
                        </div>

                        <!-- Success rate bar -->
                        <div class="mb-3">
                            <div class="success-bar-track">
                                <div class="success-bar-fill" style="width:<%= successRate %>%; background:<%= isDanger ? '#ef4444' : successRate >= 75 ? '#10b981' : '#f59e0b' %>"></div>
                            </div>
                        </div>

                        <!-- Distractor analysis -->
                        <% if (q.option_a || q.option_b || q.option_c || q.option_d) { %>
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-2 mb-3">
                            <% const opts = [
                                {key:'A', text: q.option_a, count: q.pick_a || 0, color:'#0369a1'},
                                {key:'B', text: q.option_b, count: q.pick_b || 0, color:'#15803d'},
                                {key:'C', text: q.option_c, count: q.pick_c || 0, color:'#a16207'},
                                {key:'D', text: q.option_d, count: q.pick_d || 0, color:'#be123c'},
                            ].filter(o => o.text);
                            const maxPick = Math.max(...opts.map(o => o.count), 1);
                            %>
                            <% opts.forEach(opt => { %>
                            <div class="rounded-lg border border-slate-100 p-2 bg-slate-50 <%= q.correct_answer === opt.key ? 'border-emerald-300 bg-emerald-50' : '' %>">
                                <div class="flex items-center justify-between mb-1">
                                    <span class="text-[10px] font-black text-slate-500">Option <%= opt.key %><%= q.correct_answer === opt.key ? ' ✓' : '' %></span>
                                    <span class="text-[10px] font-bold text-slate-500"><%= opt.count %> picked</span>
                                </div>
                                <p class="text-[11px] text-slate-700 truncate mb-1"><%= opt.text %></p>
                                <div class="success-bar-track">
                                    <div class="opt-bar" style="width:<%= Math.round((opt.count / maxPick) * 100) %>%; background:<%= q.correct_answer === opt.key ? '#10b981' : '#f87171' %>"></div>
                                </div>
                            </div>
                            <% }) %>
                        </div>
                        <% } %>

                        <!-- Remediation action -->
                        <div class="flex justify-end">
                            <button class="btn btn-outline btn-sm" onclick="openRemModal(<%= q.question_id %>, `<%= (q.question_text || '').replace(/`/g, "'").substring(0, 60) %>...`)">
                                <i class="fas fa-<%= hasRem ? 'pen-to-square' : 'plus-circle' %>"></i>
                                <%= hasRem ? 'Edit Intervention' : 'Add Intervention' %>
                            </button>
                        </div>
                    </div>
                    <% }) %>
                </div>

                <!-- ══════════════════════════════════════════════ -->
                <!-- TAB 2: STUDENT DRILLDOWN (Feature 4)          -->
                <!-- ══════════════════════════════════════════════ -->
                <div id="tab-student-drill" class="tab-panel space-y-4">
                    <div class="section-card">
                        <div class="section-header">
                            <div class="flex items-center gap-2">
                                <img src="/profile_uploads/<%= attempt.student_pic || 'default_avatar.png' %>"
                                     class="w-8 h-8 rounded-xl object-cover ring-2 ring-indigo-200"
                                     onerror="this.src='/profile_uploads/default_avatar.png'">
                                <div>
                                    <p class="text-sm font-black text-indigo-900"><%= attempt.first_name %> <%= attempt.last_name %></p>
                                    <p class="text-[10px] text-slate-400 font-bold">Correction Review — <%= attempt.assessment_name %></p>
                                </div>
                            </div>
                            <div class="flex gap-3">
                                <div class="text-center px-3 py-1 bg-emerald-50 border border-emerald-200 rounded-xl">
                                    <p class="text-[10px] font-black text-emerald-600 uppercase">Correct</p>
                                    <p class="text-sm font-black text-emerald-700"><%= attempt.score_obtained %></p>
                                </div>
                                <div class="text-center px-3 py-1 bg-red-50 border border-red-200 rounded-xl">
                                    <p class="text-[10px] font-black text-red-600 uppercase">Wrong</p>
                                    <p class="text-sm font-black text-red-700"><%= attempt.total_items - attempt.score_obtained %></p>
                                </div>
                            </div>
                        </div>
                        <div class="p-4 space-y-2">
                            <% responses.forEach((r, idx) => { %>
                            <div class="drill-row <%= r.is_correct ? 'right' : 'wrong' %>">
                                <span class="w-6 h-6 rounded-lg flex items-center justify-center text-xs font-black flex-shrink-0 <%= r.is_correct ? 'bg-emerald-100 text-emerald-700' : 'bg-red-100 text-red-700' %>">
                                    <%= r.is_correct ? '✓' : '✗' %>
                                </span>
                                <div class="flex-1 min-w-0">
                                    <p class="text-xs font-bold text-slate-700 truncate"><%= r.question_text %></p>
                                    <div class="flex flex-wrap gap-3 mt-1">
                                        <p class="text-[10px] text-slate-400">
                                            Student answered: <span class="font-black text-<%= r.is_correct ? 'emerald' : 'red' %>-600"><%= r.selected_option || '—' %></span>
                                        </p>
                                        <% if (!r.is_correct) { %>
                                        <p class="text-[10px] text-slate-400">
                                            Correct: <span class="font-black text-emerald-600"><%= r.correct_answer %></span>
                                        </p>
                                        <% } %>
                                        <p class="text-[10px] text-slate-400">
                                            <i class="fas fa-clock text-[9px]"></i> <%= r.response_time_ms ? (r.response_time_ms / 1000).toFixed(1) + 's' : '—' %>
                                        </p>
                                    </div>
                                </div>
                                <!-- Remediation status -->
                                <% if (!r.is_correct) { %>
                                <div class="flex-shrink-0 text-right">
                                    <% if (r.rem_material_id || r.rem_advice || r.rem_link_url) { %>
                                        <% const interacted = r.interaction_type; %>
                                        <% if (interacted === 'downloaded') { %>
                                        <span class="rem-pill rem-done"><i class="fas fa-arrow-down text-[9px]"></i> Downloaded</span>
                                        <% } else if (interacted === 'viewed') { %>
                                        <span class="rem-pill rem-partial"><i class="fas fa-eye text-[9px]"></i> Viewed</span>
                                        <% } else { %>
                                        <span class="rem-pill rem-none"><i class="fas fa-hourglass text-[9px]"></i> Not Opened</span>
                                        <% } %>
                                    <% } else { %>
                                    <span class="rem-pill" style="background:#f1f5f9;color:#94a3b8;">No Remediation</span>
                                    <% } %>
                                </div>
                                <% } %>
                            </div>
                            <% }) %>
                        </div>
                    </div>
                </div>

                <!-- ══════════════════════════════════════════════ -->
                <!-- TAB 3: REMEDIATION SUITE (Feature 2)          -->
                <!-- ══════════════════════════════════════════════ -->
                <div id="tab-remediation" class="tab-panel space-y-4">
                    <% questions.forEach((q, idx) => {
                        const hasRem = q.rem_material_id || q.rem_advice || q.rem_link_url;
                        const successRate = q.total_responses > 0 ? Math.round((q.correct_count / q.total_responses) * 100) : 0;
                    %>
                    <div class="q-row <%= successRate < 50 ? 'danger-row' : '' %>">
                        <div class="flex items-start justify-between gap-3 mb-3">
                            <div class="flex items-start gap-2 flex-1 min-w-0">
                                <span class="flex-shrink-0 w-6 h-6 rounded-lg bg-indigo-100 text-indigo-700 text-[10px] font-black flex items-center justify-center mt-0.5">#<%= idx+1 %></span>
                                <p class="text-sm font-bold text-slate-700 leading-snug"><%= q.question_text %></p>
                            </div>
                            <div class="flex items-center gap-2 flex-shrink-0">
                                <span class="text-[10px] font-black px-2 py-0.5 rounded-full <%= successRate < 50 ? 'bg-red-100 text-red-600' : 'bg-emerald-100 text-emerald-600' %>"><%= successRate %>% success</span>
                                <button class="btn btn-outline btn-sm" onclick="openRemModal(<%= q.question_id %>, `<%= (q.question_text || '').replace(/`/g, "'").substring(0, 60) %>...`)">
                                    <i class="fas fa-<%= hasRem ? 'pen-to-square' : 'plus' %>"></i> <%= hasRem ? 'Edit' : 'Add' %>
                                </button>
                            </div>
                        </div>

                        <% if (hasRem) { %>
                        <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3 space-y-2">
                            <% if (q.rem_material_title) { %>
                            <div class="flex items-center gap-2">
                                <i class="fas fa-file-lines text-indigo-400 text-xs"></i>
                                <p class="text-xs font-bold text-indigo-700">Linked Material: <span class="font-black"><%= q.rem_material_title %></span></p>
                            </div>
                            <% } %>
                            <% if (q.rem_link_url) { %>
                            <div class="link-preview-card">
                                <% const preview = q.rem_preview_json ? (typeof q.rem_preview_json === 'string' ? JSON.parse(q.rem_preview_json) : q.rem_preview_json) : null; %>
                                <% if (preview && preview.thumbnail) { %>
                                <img src="<%= preview.thumbnail %>" class="link-preview-thumb" onerror="this.style.display='none'">
                                <% } %>
                                <div class="link-preview-body">
                                    <p class="text-xs font-black text-indigo-900 truncate"><%= preview ? preview.title : q.rem_link_url %></p>
                                    <% if (preview && preview.description) { %>
                                    <p class="text-[11px] text-slate-500 mt-0.5 line-clamp-2"><%= preview.description %></p>
                                    <% } %>
                                    <a href="<%= q.rem_link_url %>" target="_blank" class="text-[10px] font-bold text-cyan-600 hover:underline mt-1 block truncate"><%= q.rem_link_url %></a>
                                </div>
                            </div>
                            <% } %>
                            <% if (q.rem_advice) { %>
                            <div class="flex items-start gap-2">
                                <i class="fas fa-lightbulb text-amber-400 text-xs mt-0.5"></i>
                                <p class="text-[11px] text-slate-600 italic leading-relaxed"><%= q.rem_advice %></p>
                            </div>
                            <% } %>
                        </div>
                        <% } else { %>
                        <div class="rounded-xl border border-dashed border-slate-200 bg-slate-50 p-3 text-center">
                            <p class="text-[11px] text-slate-400 font-bold">No remediation set for this item.</p>
                        </div>
                        <% } %>
                    </div>
                    <% }) %>
                </div>

            </div>

            <!-- Footer -->
            <footer class="bg-white border-t border-cyan-100 py-6 px-8 w-full mt-6">
                <div class="flex flex-col md:flex-row justify-between items-center gap-2 max-w-[1400px] mx-auto">
                    <p class="text-[11px] text-indigo-400 font-black uppercase tracking-tight">
                        &copy; 2026 <span class="text-cyan-600">Chemistry Arcade</span> - Mabini College v2.5.0
                    </p>
                    <div class="flex gap-4">
                        <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest">Support Lab</a>
                        <a href="#" class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest border-l pl-4 border-indigo-100">Atomic Logs</a>
                    </div>
                </div>
            </footer>
        </div>
    </main>
</div>


<!-- ══════════════════════════════════════════════════════════ -->
<!-- REMEDIATION MODAL (Feature 2 — per item)                  -->
<!-- ══════════════════════════════════════════════════════════ -->
<div id="remModal" class="modal-backdrop">
    <div class="modal-card wide">
        <div class="modal-header">
            <div>
                <h3 class="text-sm font-black text-indigo-900">Add / Edit Intervention</h3>
                <p id="remModal-qtitle" class="text-[11px] text-slate-400 mt-0.5 max-w-md truncate"></p>
            </div>
            <button onclick="closeModal('remModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-red-50 hover:text-red-500 flex items-center justify-center text-slate-500 transition">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
        <div class="modal-body">
            <input type="hidden" id="rem-question-id">

            <!-- Section A: Link existing material -->
            <div>
                <label class="form-label"><i class="fas fa-folder-open mr-1 text-indigo-400"></i> Link Existing Material</label>
                <select id="rem-material-select" class="form-select">
                    <option value="">— Select from library —</option>
                    <% materials.forEach(m => { %>
                    <option value="<%= m.material_id %>"><%= m.title %> (<%= m.material_type %>)</option>
                    <% }) %>
                </select>
            </div>

            <!-- Section B: Direct upload -->
            <div>
                <label class="form-label"><i class="fas fa-cloud-arrow-up mr-1 text-teal-500"></i> Upload New Material</label>
                <div class="drop-zone" id="dropZone" onclick="document.getElementById('remFileInput').click()">
                    <i class="fas fa-file-arrow-up text-indigo-300 text-2xl mb-2 block"></i>
                    <p class="text-xs font-bold text-indigo-400">Drag & drop or click to upload</p>
                    <p class="text-[10px] text-slate-400 mt-0.5">PDF, Word, PPTX, Image</p>
                    <p id="dropFileName" class="text-[11px] font-bold text-indigo-600 mt-2 hidden"></p>
                </div>
                <input type="file" id="remFileInput" class="hidden" accept=".pdf,.doc,.docx,.pptx,.png,.jpg,.jpeg">
            </div>

            <!-- Section C: URL Link -->
            <div>
                <label class="form-label"><i class="fas fa-link mr-1 text-cyan-500"></i> Educational Link / URL</label>
                <div class="flex gap-2">
                    <input type="url" id="rem-link-url" class="form-input" placeholder="https://...">
                    <button class="btn btn-outline btn-sm flex-shrink-0" onclick="fetchLinkPreview()">
                        <i class="fas fa-eye"></i> Preview
                    </button>
                </div>
                <!-- Link preview output -->
                <div id="link-preview-box" class="mt-2 hidden link-preview-card">
                    <img id="lp-thumb" src="" class="link-preview-thumb hidden" onerror="this.style.display='none'">
                    <div class="link-preview-body">
                        <p id="lp-title" class="text-xs font-black text-indigo-900"></p>
                        <p id="lp-desc"  class="text-[11px] text-slate-500 mt-0.5 line-clamp-2"></p>
                        <p id="lp-url"   class="text-[10px] font-bold text-cyan-600 mt-1 truncate"></p>
                    </div>
                </div>
            </div>

            <!-- Section D: Advice / Memory hack -->
            <div>
                <label class="form-label"><i class="fas fa-lightbulb mr-1 text-amber-500"></i> Memory Hack / Advice Text</label>
                <textarea id="rem-advice" class="form-textarea" placeholder="e.g. Tandaan: Ang Anion ay Negative dahil 'A-Negative-Ion'..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('remModal')">Cancel</button>
            <button class="btn btn-primary" onclick="saveRemediation()">
                <i class="fas fa-floppy-disk"></i> Save Intervention
            </button>
        </div>
    </div>
</div>


<!-- ══════════════════════════════════════════════════════════ -->
<!-- BULK TOPIC MODAL (Feature 3)                              -->
<!-- ══════════════════════════════════════════════════════════ -->
<div id="bulkModal" class="modal-backdrop">
    <div class="modal-card">
        <div class="modal-header">
            <div>
                <h3 class="text-sm font-black text-indigo-900">Bulk Topic Intervention</h3>
                <p class="text-[11px] text-slate-400 mt-0.5">Apply to all questions under: <strong><%= attempt.topic_name %></strong></p>
            </div>
            <button onclick="closeModal('bulkModal')" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-red-50 hover:text-red-500 flex items-center justify-center text-slate-500 transition">
                <i class="fas fa-times text-xs"></i>
            </button>
        </div>
        <div class="modal-body">
            <div class="bg-amber-50 border border-amber-200 rounded-xl p-3">
                <p class="text-[11px] text-amber-700 font-bold"><i class="fas fa-triangle-exclamation mr-1"></i> This will add the selected material and advice to ALL <%= questions.length %> questions in this topic. Existing entries will be preserved (not overwritten).</p>
            </div>

            <div>
                <label class="form-label"><i class="fas fa-folder-open mr-1 text-indigo-400"></i> Shared Material for All Items</label>
                <select id="bulk-material-select" class="form-select">
                    <option value="">— Select from library —</option>
                    <% materials.forEach(m => { %>
                    <option value="<%= m.material_id %>"><%= m.title %> (<%= m.material_type %>)</option>
                    <% }) %>
                </select>
            </div>

            <div>
                <label class="form-label"><i class="fas fa-link mr-1 text-cyan-500"></i> Shared Link (Optional)</label>
                <input type="url" id="bulk-link-url" class="form-input" placeholder="https://...">
            </div>

            <div>
                <label class="form-label"><i class="fas fa-lightbulb mr-1 text-amber-500"></i> Global Advice for This Topic</label>
                <textarea id="bulk-advice" class="form-textarea" placeholder="General tip or memory hack for this entire topic..."></textarea>
            </div>
        </div>
        <div class="modal-footer">
            <button class="btn btn-outline" onclick="closeModal('bulkModal')">Cancel</button>
            <button class="btn btn-primary" onclick="saveBulkRemediation()">
                <i class="fas fa-wand-magic-sparkles"></i> Apply to All Questions
            </button>
        </div>
    </div>
</div>


<!-- ════════════════════════════════════════════════════ -->
<!-- SCRIPTS                                             -->
<!-- ════════════════════════════════════════════════════ -->
<script>
const TOPIC_ID    = <%= attempt.topic_id %>;
const ATTEMPT_ID  = <%= attempt.score_id %>;

/* ── Sidebar ── */
function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    const open = !sb.classList.contains('-translate-x-full');
    sb.classList.toggle('-translate-x-full', open);
    ov.classList.toggle('hidden', open);
}

/* ── Toast ── */
function anToast(msg, type = 'success') {
    const el = document.getElementById('an-toast');
    el.textContent = (type === 'success' ? '✓  ' : '✕  ') + msg;
    el.className = 'show ' + type;
    clearTimeout(el._t);
    el._t = setTimeout(() => { el.className = ''; }, 3400);
}

/* ── Tab switching ── */
function switchTab(id) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.getElementById('tab-' + id).classList.add('active');
    event.currentTarget.classList.add('active');
}

/* ── Modal helpers ── */
function openModal(id)  { document.getElementById(id).classList.add('open'); }
function closeModal(id) { document.getElementById(id).classList.remove('open'); }

/* ── Remediation modal ── */
function openRemModal(questionId, questionTitle) {
    document.getElementById('rem-question-id').value = questionId;
    document.getElementById('remModal-qtitle').textContent = questionTitle;
    // Reset fields
    document.getElementById('rem-material-select').value = '';
    document.getElementById('rem-link-url').value = '';
    document.getElementById('rem-advice').value = '';
    document.getElementById('link-preview-box').classList.add('hidden');
    document.getElementById('dropFileName').classList.add('hidden');
    document.getElementById('remFileInput').value = '';
    openModal('remModal');
}

/* ── Bulk modal ── */
function openBulkModal() {
    document.getElementById('bulk-material-select').value = '';
    document.getElementById('bulk-link-url').value = '';
    document.getElementById('bulk-advice').value = '';
    openModal('bulkModal');
}

/* ── Drag and Drop ── */
const dropZone   = document.getElementById('dropZone');
const fileInput  = document.getElementById('remFileInput');
const dropNameEl = document.getElementById('dropFileName');

dropZone.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('dragover'); });
dropZone.addEventListener('dragleave', () => dropZone.classList.remove('dragover'));
dropZone.addEventListener('drop', e => {
    e.preventDefault();
    dropZone.classList.remove('dragover');
    const file = e.dataTransfer.files[0];
    if (file) { fileInput.files = e.dataTransfer.files; showDropName(file.name); }
});
fileInput.addEventListener('change', () => {
    if (fileInput.files[0]) showDropName(fileInput.files[0].name);
});
function showDropName(name) {
    dropNameEl.textContent = '📄 ' + name;
    dropNameEl.classList.remove('hidden');
}

/* ── Link preview ── */
async function fetchLinkPreview() {
    const url = document.getElementById('rem-link-url').value.trim();
    if (!url) return anToast('Please enter a URL first.', 'error');
    try {
        const res  = await fetch('/teacher/api/link-preview?url=' + encodeURIComponent(url));
        const data = await res.json();
        if (!data || data.error) return anToast('Could not fetch preview.', 'error');
        document.getElementById('lp-title').textContent = data.title || url;
        document.getElementById('lp-desc').textContent  = data.description || '';
        document.getElementById('lp-url').textContent   = url;
        if (data.thumbnail) {
            const img = document.getElementById('lp-thumb');
            img.src = data.thumbnail;
            img.classList.remove('hidden');
        }
        document.getElementById('link-preview-box').classList.remove('hidden');
    } catch(e) {
        anToast('Preview failed.', 'error');
    }
}

/* ── Save remediation (per item) ── */
async function saveRemediation() {
    const questionId = document.getElementById('rem-question-id').value;
    const materialId = document.getElementById('rem-material-select').value;
    const linkUrl    = document.getElementById('rem-link-url').value.trim();
    const advice     = document.getElementById('rem-advice').value.trim();
    const file       = document.getElementById('remFileInput').files[0];

    if (!materialId && !linkUrl && !advice && !file) {
        return anToast('Please fill at least one field.', 'error');
    }

    // If file upload needed, first upload material then get material_id
    let finalMaterialId = materialId || null;

    if (file) {
        const fd = new FormData();
        fd.append('file', file);
        fd.append('topic_id', TOPIC_ID);
        fd.append('title', file.name);
        try {
            const uploadRes  = await fetch('/teacher/api/analysis/upload-material', { method: 'POST', body: fd });
            const uploadData = await uploadRes.json();
            if (!uploadData.material_id) throw new Error('Upload failed');
            finalMaterialId = uploadData.material_id;
        } catch(e) {
            return anToast('File upload failed: ' + e.message, 'error');
        }
    }

    // Get preview JSON if link was provided and preview was loaded
    let previewJson = null;
    const lp_title = document.getElementById('lp-title').textContent;
    const lp_desc  = document.getElementById('lp-desc').textContent;
    const lp_thumb = document.getElementById('lp-thumb').src;
    if (linkUrl && lp_title) {
        previewJson = JSON.stringify({ title: lp_title, description: lp_desc, thumbnail: lp_thumb });
    }

    try {
        const res = await fetch('/teacher/api/analysis/remediation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                question_id: questionId,
                material_id: finalMaterialId || null,
                link_url:    linkUrl || null,
                preview_json: previewJson,
                advice_text: advice || null
            })
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error);
        anToast('Intervention saved!');
        closeModal('remModal');
        setTimeout(() => location.reload(), 800);
    } catch(e) {
        anToast('Error: ' + e.message, 'error');
    }
}

/* ── Save bulk remediation ── */
async function saveBulkRemediation() {
    const materialId = document.getElementById('bulk-material-select').value;
    const linkUrl    = document.getElementById('bulk-link-url').value.trim();
    const advice     = document.getElementById('bulk-advice').value.trim();

    if (!materialId && !linkUrl && !advice) {
        return anToast('Please fill at least one field.', 'error');
    }

    try {
        const res = await fetch('/teacher/api/analysis/bulk-remediation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ topic_id: TOPIC_ID, material_id: materialId || null, link_url: linkUrl || null, advice_text: advice || null })
        });
        const data = await res.json();
        if (!data.success) throw new Error(data.error);
        anToast(`Applied to ${data.count} question(s)!`);
        closeModal('bulkModal');
        setTimeout(() => location.reload(), 800);
    } catch(e) {
        anToast('Error: ' + e.message, 'error');
    }
}

/* ── Close modal on backdrop click ── */
document.querySelectorAll('.modal-backdrop').forEach(mb => {
    mb.addEventListener('click', e => { if (e.target === mb) mb.classList.remove('open'); });
});
</script>
</body>
</html>
