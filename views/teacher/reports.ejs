    <!-- MASTER GRADEBOOK WEIGHTING & GRADING FORMULA MODAL               -->
    <!-- ════════════════════════════════════════════════════════════════ -->
    <div id="gradebookWeightModal" class="modal-backdrop">
        <div class="modal-card" style="max-width:640px">
            <div class="modal-header">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-violet-100 flex items-center justify-center">
                        <i class="fas fa-scale-balanced text-violet-600 text-sm"></i>
                    </div>
                    <div>
                        <p id="gbWeightModalTitle" class="text-sm font-black text-indigo-900">Configure Gradebook
                            Weighting — PDF Export</p>
                        <p class="text-[10px] text-slate-400 font-bold">Assign percentage weights for LMS Avg
                            (Assessments, Assignments, Forums, Simulations, Syllabus) &amp; Final Grade (LMS Avg +
                            Attendance)</p>
                    </div>
                </div>
                <button onclick="closeModal('gradebookWeightModal')"
                    class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-rose-100 hover:text-rose-500 flex items-center justify-center transition text-slate-500">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>

            <input type="hidden" id="gbWeightExportFormat" value="pdf">

            <div class="modal-body space-y-4">
                <!-- Active Scope Summary Bar -->
                <div
                    class="bg-gradient-to-r from-violet-50 via-indigo-50/70 to-sky-50 border border-violet-200/80 rounded-xl p-3 flex items-center justify-between gap-3">
                    <div class="flex items-center gap-2.5">
                        <div
                            class="w-8 h-8 rounded-lg bg-violet-600 text-white flex items-center justify-center font-bold text-xs shadow-2xs flex-shrink-0">
                            <i class="fas fa-book-bookmark"></i>
                        </div>
                        <div>
                            <span class="text-[9px] font-black text-violet-700 uppercase tracking-wider block">Active
                                Export Scope</span>
                            <p id="gbWeightScopeSummary" class="text-xs font-black text-indigo-950">All My Classes • All
                                Quarters • All Standings</p>
                        </div>
                    </div>
                    <div class="flex flex-wrap gap-1 justify-end">
                        <button type="button" onclick="applyGradebookWeightPreset(30, 30, 10, 20, 10, 80, 20)"
                            class="text-[10px] font-bold px-2 py-1 rounded-lg bg-white hover:bg-violet-100 text-violet-700 border border-violet-200 transition cursor-pointer"
                            title="Reset to Default (30/30/10/20/10 LMS Avg &amp; 80% LMS + 20% Attendance Final)">
                            Default (80/20)
                        </button>
                        <button type="button" onclick="applyGradebookWeightPreset(40, 25, 10, 15, 10, 80, 20)"
                            class="text-[10px] font-bold px-2 py-1 rounded-lg bg-white hover:bg-indigo-100 text-indigo-700 border border-indigo-200 transition cursor-pointer"
                            title="40% Assessment Weight Preset (40/25/10/15/10 LMS Avg &amp; 80% LMS + 20% Attendance)">
                            40% Assessment
                        </button>
                    </div>
                </div>

                <!-- PART 1: LMS Coursework Average (LMS Avg) Component Weights -->
                <div class="bg-slate-50/80 border border-slate-200 rounded-xl p-3.5 space-y-3">
                    <div class="flex items-center justify-between">
