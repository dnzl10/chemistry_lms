            function updateRcQuarterFilterOptions(activeClassId) {
                const sel = document.getElementById('rcQuarterFilter');
                if (!sel) return;

                const previousVal = sel.value;
                sel.innerHTML = '';

                if (activeClassId === 'all' || !activeClassId) {
                    // Multi-Class Overview: Full Academic Year with all quarters
                    sel.appendChild(new Option('All Quarters (Full Academic Year — Q1 to Q4)', ''));
                    sel.appendChild(new Option('Quarter 1 (Chemistry 1)', '1'));
                    sel.appendChild(new Option('Quarter 2 (Chemistry 1)', '2'));
                    sel.appendChild(new Option('Quarter 3 (Chemistry 2)', '3'));
                    sel.appendChild(new Option('Quarter 4 (Chemistry 2)', '4'));
                } else {
                    const clsMeta = CLASS_METADATA_MAP[String(activeClassId)];
                    const quarters = clsMeta?.quarters || [1, 2];
                    const semText = clsMeta?.semester ? `Semester ${clsMeta.semester}` : '';
                    const quartersText = quarters.map(q => `Q${q}`).join(' & ');

                    const allLabel = `All Quarters (${quartersText}${semText ? ' — ' + semText : ''})`;
                    sel.appendChild(new Option(allLabel, ''));

                    quarters.forEach(q => {
                        sel.appendChild(new Option(`Quarter ${q}`, String(q)));
