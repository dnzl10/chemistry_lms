    <script type="application/json" id="reports-sync-data"><%- JSON.stringify({
    scoreDistribution: scoreDistribution || [],
    winLoss: winLoss || [],
    expGrowth: expGrowth || { labels: [], datasets: [] },
    selectedClassId: selectedClassId || "",
    classMetadataMap: (classes || []).reduce((acc, c) => {
        acc[String(c.class_id)] = {
            name: `${c.class_name} — ${c.subject_name}`,
            class_name: c.class_name,
            subject_name: c.subject_name,
            semester: c.semester,
            quarters: (c.quarters || '1,2').split(',').map(Number)
        };
        return acc;
    }, {})
}).replace(/<\//g, '<\\/') %></script>
    <script>
        /* ── Server-injected data for charts ── */
        const _initialReportsData = JSON.parse(document.getElementById('reports-sync-data').textContent || '{}');
        let SCORE_DIST = _initialReportsData.scoreDistribution || [];
        let WIN_LOSS = _initialReportsData.winLoss || [];
        let EXP_GROWTH = _initialReportsData.expGrowth || { labels: [], datasets: [] };
        let SELECTED_CLASS = _initialReportsData.selectedClassId || '';

        /* ── Sidebar ── */
        function toggleSidebar() {
            const sb = document.getElementById('sidebar');
            const ov = document.getElementById('sidebarOverlay');
            const open = !sb.classList.contains('-translate-x-full');
            sb.classList.toggle('-translate-x-full', open);
            ov.classList.toggle('hidden', open);
        }

        /* ── Toast ── */
        function rpToast(msg, type = 'success') {
            const el = document.getElementById('rp-toast');
            el.textContent = (type === 'success' ? '✓  ' : '✕  ') + msg;
            el.className = 'show ' + type;
            clearTimeout(el._t);
            el._t = setTimeout(() => { el.className = ''; }, 3400);
        }

        /* ── Tab switching ── */
        function switchTab(id, btn) {
            document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
            document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
            const panel = document.getElementById('tab-' + id);
            if (panel) panel.classList.add('active');
            if (btn) btn.classList.add('active');
            if (id === 'analytics') initCharts();

            // Persist active tab in URL history without reloading
            try {
                const url = new URL(window.location.href);
                url.searchParams.set('tab', id);
                window.history.replaceState({ tab: id }, '', url.toString());
            } catch (e) { }
        }

        /* ── Class filter (Zero-Reload Background Sync) ── */
        async function applyClassFilter() {
            const classId = document.getElementById('classFilter').value;
            const url = new URL(window.location.href);
            if (classId && classId !== 'all') {
                url.searchParams.set('class_id', classId);
            } else if (classId === 'all') {
                url.searchParams.set('class_id', 'all');
            } else {
                url.searchParams.delete('class_id');
            }

            // Preserve the active tab across filter update
            const activePanel = document.querySelector('.tab-panel.active');
            const currentTab = activePanel ? activePanel.id.replace('tab-', '') : 'export';
            url.searchParams.set('tab', currentTab);

            try {
                window.history.pushState({ tab: currentTab }, '', url.toString());
                if (typeof updateGradebookQuarterFilterOptions === 'function') updateGradebookQuarterFilterOptions(classId);
                if (typeof updateRcQuarterFilterOptions === 'function') updateRcQuarterFilterOptions(classId);

                const res = await fetch(url.toString(), {
                    headers: { 'X-Requested-With': 'XMLHttpRequest' },
                    cache: 'no-store'
                });
                if (!res.ok) throw new Error('Failed to load filtered reports');
                const html = await res.text();
                const parser = new DOMParser();
                const newDoc = parser.parseFromString(html, 'text/html');

                ['stat-students', 'stat-accuracy', 'stat-completion', 'stat-attempts', 'tab-export', 'tab-analytics', 'tab-deepdive', 'studentPickerModal'].forEach(id => {
                    const curEl = document.getElementById(id);
                    const newEl = newDoc.getElementById(id);
                    if (curEl && newEl) {
                        curEl.innerHTML = newEl.innerHTML;
                    }
                });

                const syncEl = newDoc.getElementById('reports-sync-data');
                if (syncEl) {
                    const syncData = JSON.parse(syncEl.textContent);
                    SCORE_DIST = syncData.scoreDistribution || [];
                    WIN_LOSS = syncData.winLoss || [];
                    EXP_GROWTH = syncData.expGrowth || { labels: [], datasets: [] };
                    SELECTED_CLASS = syncData.selectedClassId || '';
                }

                chartsInitialized = false;
                if (currentTab === 'analytics') {
                    initCharts();
                }
                rpToast('Class filter applied');
            } catch (err) {
                console.error('Error applying class filter:', err);
                rpToast('Failed to update class filter', 'error');
            }
        }

            // Auto-activate tab from URL query if present
            document.addEventListener('DOMContentLoaded', function () {
                try {
                    const urlParams = new URLSearchParams(window.location.search);
                    const tab = urlParams.get('tab');
                    if (tab && document.getElementById('tab-' + tab)) {
                        const btn = document.getElementById('tabBtn-' + tab) || document.querySelector(`button[onclick*="'${tab}'"]`);
                        if (btn) switchTab(tab, btn);
                    }
                } catch (e) {
                    console.warn('[Tab Auto-Activation Error]', e);
                }
            });

            /* ── Switch Tab inside Export Filter Modal (for Class List & Attendance) ── */
            function switchExportModalTab(tabId) {
                const btnClassList = document.getElementById('modalTabBtnClassList');
                const btnAttendance = document.getElementById('modalTabBtnAttendance');
                const panelClassList = document.getElementById('panelExportClassList');
                const panelAttendance = document.getElementById('panelExportAttendance');
                const activeTabInput = document.getElementById('exportClassListActiveTab');

                activeTabInput.value = tabId;

                if (tabId === 'classList') {
                    btnClassList.className = 'px-4 py-2 text-xs font-bold border-b-2 border-indigo-600 text-indigo-600 transition flex items-center gap-1.5';
                    btnAttendance.className = 'px-4 py-2 text-xs font-bold text-slate-400 hover:text-slate-600 border-b-2 border-transparent transition flex items-center gap-1.5';
                    panelClassList.style.display = 'block';
                    panelAttendance.style.display = 'none';
                } else {
                    btnClassList.className = 'px-4 py-2 text-xs font-bold text-slate-400 hover:text-slate-600 border-b-2 border-transparent transition flex items-center gap-1.5';
                    btnAttendance.className = 'px-4 py-2 text-xs font-bold border-b-2 border-indigo-600 text-indigo-600 transition flex items-center gap-1.5';
                    panelClassList.style.display = 'none';
                    panelAttendance.style.display = 'block';
                }
            }

            /* ── Export document — opens filter modal first ── */
            function exportDoc(type, format) {
                document.getElementById('exportModalType').value = type;
                document.getElementById('exportModalFormat').value = format;

                // Reset tab panels and legacy filter groups
                document.getElementById('exportModalTabBar').style.display = 'none';
                const baselineCard = document.getElementById('exportModalClassBaselineCard');
                if (baselineCard) baselineCard.style.display = 'none';
                document.getElementById('panelExportClassList').style.display = 'none';
                document.getElementById('panelExportAttendance').style.display = 'none';
                ['filterGroupQuarter', 'filterGroupType', 'filterGroupRisk']
                    .forEach(id => document.getElementById(id).style.display = 'none');

                // Reset all filter values
                document.getElementById('filterQuarter').value = '';
                document.getElementById('filterAssessType').value = '';
                document.getElementById('filterRisk').value = '';
                document.getElementById('filterSex').value = '';
                document.getElementById('filterMasteryBracket').value = '';
                document.getElementById('filterAsmtBracket').value = '';
                document.getElementById('filterAsgnBracket').value = '';
                document.getElementById('filterForumStatus').value = '';
                document.getElementById('filterExpBracket').value = '';
                document.getElementById('filterAttendanceSource').value = 'roll_call';

                if (type === 'class-list') {
                    // Renamed Title per user specification: "Export Class List and Attendance — PDF / EXCEL"
                    document.getElementById('exportModalTitle').textContent =
                        `Export Class List and Attendance — ${format.toUpperCase()}`;
                    document.getElementById('exportModalSubtitle').textContent =
                        'Filter by demographics, academic performance, or attendance session';

                    // 1. Resolve active baseline scope (Supports both Single-Class and All My Classes Multi-Class mode)
                    const classFilterEl = document.getElementById('classFilter');
                    const rawClassId = classFilterEl ? classFilterEl.value : '';
                    const isMultiClass = (rawClassId === 'all' || !rawClassId);
                    const effectiveClassId = isMultiClass ? 'all' : rawClassId;

                    // Store active class into dedicated modal hidden input
                    const modalClassIdEl = document.getElementById('exportModalClassId');
                    if (modalClassIdEl) modalClassIdEl.value = effectiveClassId;

                    // Display Active Baseline Card in modal
                    if (baselineCard) {
                        baselineCard.style.display = 'block';
                        const iconEl = document.getElementById('exportModalBaselineIcon');
                        const headerLabelEl = document.getElementById('exportModalBaselineHeaderLabel');
                        const badgeEl = document.getElementById('exportModalBaselineBadge');
                        const nameEl = document.getElementById('exportModalActiveClassName');
                        const scopeBadgeEl = document.getElementById('exportModalClassScopeBadge');
                        const noteEl = document.getElementById('exportModalBaselineNote');

                        if (isMultiClass) {
                            if (iconEl) iconEl.className = 'fas fa-layer-group';
                            if (headerLabelEl) headerLabelEl.textContent = 'ACTIVE BASELINE SCOPE';
                            if (badgeEl) badgeEl.innerHTML = '<i class="fas fa-layer-group text-[8px] mr-1"></i> Multi-Class Overview';
                            if (nameEl) nameEl.textContent = 'All My Classes (Multi-Class Export)';
                            if (scopeBadgeEl) scopeBadgeEl.innerHTML = '<i class="fas fa-file-invoice text-[10px]"></i> Separate Page per Class';
                            if (noteEl) noteEl.innerHTML = 'Export will format each class on its own dedicated separate page(s) (never blended). Refine sub-filters below.';
                        } else {
                            const activeOpt = classFilterEl ? classFilterEl.querySelector(`option[value="${effectiveClassId}"]`) : null;
                            const className = activeOpt ? activeOpt.textContent.trim() : 'Active Class';
                            if (iconEl) iconEl.className = 'fas fa-chalkboard-user';
                            if (headerLabelEl) headerLabelEl.textContent = 'ACTIVE CLASS BASELINE';
                            if (badgeEl) badgeEl.innerHTML = '<i class="fas fa-lock text-[8px] mr-1"></i> Inherited from Active Filter';
                            if (nameEl) nameEl.textContent = className;
                            if (scopeBadgeEl) scopeBadgeEl.innerHTML = '<i class="fas fa-check-circle text-[10px]"></i> Locked to Class';
                            if (noteEl) noteEl.innerHTML = `All filters configured below will narrow down records strictly within <strong>${className}</strong>.`;
                        }
                    }

                    // Show Modal Tab Bar and activate Class List tab by default
                    document.getElementById('exportModalTabBar').style.display = 'flex';
                    switchExportModalTab('classList');

                    const dateSelect = document.getElementById('filterAttendanceDate');
                    dateSelect.innerHTML = '<option value="">All Available Conducted Dates (Default — Page per Date)</option>';

                    const fetchUrl = isMultiClass
                        ? `/teacher/api/attendance/all/conducted-dates`
                        : `/teacher/api/attendance/${effectiveClassId}/conducted-dates`;

                    fetch(fetchUrl)
                        .then(res => res.json())
                        .then(data => {
                            if (data.success && data.dates && data.dates.length > 0) {
                                data.dates.forEach(d => {
                                    const opt = document.createElement('option');
                                    opt.value = d.date;
                                    opt.textContent = d.label;
                                    dateSelect.appendChild(opt);
                                });
                            } else {
                                const opt = document.createElement('option');
                                opt.value = "";
                                opt.disabled = true;
                                opt.textContent = "No conducted attendance sessions recorded yet";
                                dateSelect.appendChild(opt);
                            }
                        })
                        .catch(err => console.warn('[Fetch Conducted Dates Error]:', err));
                } else {
                    const labels = {
                        'remediation': 'Remediation List',
                        'report-card': 'Report Card',
                        'report-card-batch': 'Batch Class Report Cards',
                        'gradebook': 'Master Class Gradebook',
                    };
                    document.getElementById('exportModalTitle').textContent =
                        `Export ${labels[type] || 'Document'} — ${format.toUpperCase()}`;
                    document.getElementById('exportModalSubtitle').textContent = 'Apply filters before exporting';

                    if (type === 'report-card' || type === 'report-card-student' || type === 'report-card-batch') {
                        document.getElementById('filterGroupQuarter').style.display = 'flex';
                        document.getElementById('filterGroupType').style.display = 'flex';
                    } else if (type === 'gradebook') {
                        document.getElementById('filterGroupQuarter').style.display = 'flex';
                    } else if (type === 'remediation') {
                        document.getElementById('filterGroupQuarter').style.display = 'flex';
                        document.getElementById('filterGroupRisk').style.display = 'flex';
                    }
                }

                document.getElementById('exportFilterModal').classList.add('open');
            }

            function doExport() {
                const type = document.getElementById('exportModalType').value;
                const format = document.getElementById('exportModalFormat').value;

                // Strict priority: Inherited active class baseline from modal state (supports both specific ID and 'all')
                let classId = document.getElementById('exportModalClassId')?.value;
                if (!classId) {
                    const classFilterEl = document.getElementById('classFilter');
                    classId = classFilterEl ? classFilterEl.value : 'all';
                }

                const params = new URLSearchParams();
                if (classId) params.set('class_id', classId);

                if (type === 'class-list') {
                    const activeTab = document.getElementById('exportClassListActiveTab').value || 'classList';
                    params.set('export_tab', activeTab);

                    if (activeTab === 'classList') {
                        const sex = document.getElementById('filterSex').value;
                        const mastery = document.getElementById('filterMasteryBracket').value;
                        const asmt = document.getElementById('filterAsmtBracket').value;
                        const asgn = document.getElementById('filterAsgnBracket').value;
                        const forum = document.getElementById('filterForumStatus').value;
                        const exp = document.getElementById('filterExpBracket').value;

                        if (sex) params.set('sex', sex);
                        if (mastery) params.set('mastery_bracket', mastery);
                        if (asmt) params.set('asmt_bracket', asmt);
                        if (asgn) params.set('asgn_bracket', asgn);
                        if (forum) params.set('forum_status', forum);
                        if (exp) params.set('exp_bracket', exp);
                    } else {
                        // Attendance Tab
                        const source = document.getElementById('filterAttendanceSource').value;
                        const attDate = document.getElementById('filterAttendanceDate').value;

                        if (source) params.set('attendance_source', source);
                        if (attDate) params.set('attendance_date', attDate);
                    }
                } else {
                    // Legacy document filters
                    const quarter = document.getElementById('filterQuarter').value;
                    const atype = document.getElementById('filterAssessType').value;
                    const risk = document.getElementById('filterRisk').value;

                    if (quarter) params.set('quarter', quarter);
                    if (atype) params.set('type', atype);
                    if (risk) {
                        params.set('risk', risk);
                        if (type === 'gradebook') params.set('standing', 'at_risk');
                    }
                }

                let url;
                if (type === 'report-card-student' && _pendingReportStudentId) {
                    url = `/teacher/reports/export/report-card/${_pendingReportStudentId}?${params.toString()}`;
                    _pendingReportStudentId = null;
                } else {
                    url = `/teacher/reports/export/${type}/${format}?${params.toString()}`;
                }

