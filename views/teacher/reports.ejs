            <!-- Assessment Type — report-card only -->
            <div id="filterGroupType" style="display:none" class="flex flex-col gap-1.5">
                <label class="form-label"><i class="fas fa-tag text-cyan-500 mr-1"></i> Assessment Type</label>
                <select id="filterAssessType" class="form-select">
                    <option value="">All Types</option>
                    <option value="Pre-Test">Pre-Test</option>
                    <option value="Post-Test">Post-Test</option>
                    <option value="Quiz">Quiz</option>
