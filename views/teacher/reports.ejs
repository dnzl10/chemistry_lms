                if (chartsInitialized) return;
                chartsInitialized = true;

                const fontSettings = { family: "'Plus Jakarta Sans', sans-serif", size: 11 };
                Chart.defaults.font = fontSettings;

                /* Score Distribution Bar Chart */
                const sdCtx = document.getElementById('chartScoreDist');
