<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reports | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background-color: #f0fdfa;
            background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px);
            background-size: 24px 24px;
        }

        #sidebar {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        #mainScroll {
            overflow-y: auto;
        }

        #mainScroll::-webkit-scrollbar {
            width: 5px;
        }

        #mainScroll::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }

        .section-card {
            background: white;
            border-radius: 1.25rem;
            border: 1px solid #e2e8f0;
            overflow: hidden;
        }

        .section-header {
            padding: 14px 18px;
            border-bottom: 1px solid #f1f5f9;
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 10px;
        }

        /* Buttons */
        .btn {
            display: inline-flex;
            align-items: center;
            gap: 5px;
            padding: 7px 14px;
            border-radius: 9px;
            font-size: 12px;
            font-weight: 700;
            cursor: pointer;
            transition: all .15s;
            border: 1px solid transparent;
            font-family: 'Plus Jakarta Sans', sans-serif;
        }

        .btn-primary {
            background: #6366f1;
            color: white;
            border-color: #4f46e5;
        }

        .btn-primary:hover {
            background: #4f46e5;
        }

        .btn-outline {
            background: white;
            color: #475569;
            border-color: #e2e8f0;
        }

        .btn-outline:hover {
            border-color: #6366f1;
            color: #6366f1;
            background: #faf5ff;
        }

        .btn-emerald {
            background: #059669;
            color: white;
            border-color: #047857;
        }

        .btn-emerald:hover {
            background: #047857;
        }

        .btn-rose {
            background: #e11d48;
            color: white;
            border-color: #be123c;
        }

        .btn-rose:hover {
            background: #be123c;
        }

        .btn-amber {
            background: #d97706;
            color: white;
            border-color: #b45309;
        }

        .btn-amber:hover {
            background: #b45309;
        }

        .btn-sm {
            padding: 5px 10px;
            font-size: 11px;
        }

        /* Tab system */
        .tab-btn {
            padding: 9px 20px;
            border-radius: 10px;
            font-size: 12px;
            font-weight: 700;
            color: #64748b;
            cursor: pointer;
            border: none;
            background: transparent;
            font-family: 'Plus Jakarta Sans', sans-serif;
            transition: all .15s;
            white-space: nowrap;
        }

        .tab-btn:hover {
            background: white;
            color: #334155;
        }

        .tab-btn.active {
            background: white;
            color: #6366f1;
            box-shadow: 0 1px 6px rgba(0, 0, 0, .1);
        }

        .tab-panel {
            display: none;
        }

        .tab-panel.active {
            display: block;
        }

        /* Export card */
        .export-card {
            border: 1px solid #e2e8f0;
            border-radius: 1rem;
            padding: 18px;
            background: white;
            transition: box-shadow .2s, border-color .2s;
        }

        .export-card:hover {
            box-shadow: 0 4px 20px rgba(99, 102, 241, .1);
            border-color: #c7d2fe;
        }

        /* Heatmap cell */
        .heat-cell {
            border-radius: 6px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 10px;
            font-weight: 700;
            cursor: default;
            transition: transform .15s;
        }

        .heat-cell:hover {
            transform: scale(1.08);
        }

        /* Progress bar */
        .prog-track {
            height: 8px;
            background: #f1f5f9;
            border-radius: 9999px;
            overflow: hidden;
        }

        .prog-fill {
            height: 100%;
            border-radius: 9999px;
            transition: width .6s ease;
        }

        /* Rank badge */
        .rank-1 {
            background: linear-gradient(135deg, #f59e0b, #fbbf24);
            color: white;
        }

        .rank-2 {
            background: linear-gradient(135deg, #94a3b8, #cbd5e1);
            color: white;
        }

        .rank-3 {
            background: linear-gradient(135deg, #cd7c2b, #e5a35a);
            color: white;
        }

        .rank-n {
            background: #f1f5f9;
            color: #64748b;
        }

        /* Form */
        .form-select {
            width: 100%;
            padding: 8px 11px;
            border: 1px solid #e2e8f0;
            border-radius: 9px;
            font-size: 13px;
            font-family: 'Plus Jakarta Sans', sans-serif;
            color: #1e293b;
            outline: none;
            transition: border-color .2s;
            background: white;
        }

        .form-select:focus {
            border-color: #6366f1;
            box-shadow: 0 0 0 3px rgba(99, 102, 241, .1);
        }

        .form-label {
            font-size: 11px;
            font-weight: 700;
            color: #475569;
            text-transform: uppercase;
            letter-spacing: .05em;
            margin-bottom: 4px;
            display: block;
        }

        /* Toast */
        #rp-toast {
            position: fixed;
            bottom: 24px;
            right: 24px;
            z-index: 999;
            background: #1e293b;
            color: white;
            padding: 10px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 600;
            box-shadow: 0 8px 24px rgba(15, 23, 42, .2);
            transform: translateY(80px);
            opacity: 0;
            transition: all .3s ease;
            pointer-events: none;
            max-width: 320px;
        }

        #rp-toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        #rp-toast.success {
            background: #064e3b;
        }

        #rp-toast.error {
            background: #7f1d1d;
        }

        /* Loading spinner */
        .spin {
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }

        @keyframes fadeUp {
            from {
                opacity: 0;
                transform: translateY(8px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            animation: fadeUp .25s ease forwards;
        }

        /* Sequence error bar */
        .seq-bar {
            height: 10px;
            border-radius: 9999px;
            background: #fee2e2;
        }

        .seq-bar-fill {
            height: 100%;
            border-radius: 9999px;
            background: #ef4444;
            transition: width .5s;
        }

        /* Modal */
        .modal-backdrop {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 200;
            background: rgba(15, 23, 42, .55);
            align-items: center;
            justify-content: center;
            padding: 16px;
        }

        .modal-backdrop.open {
            display: flex;
        }

        .modal-card {
            background: white;
            border-radius: 1.25rem;
            width: 100%;
            max-width: 520px;
            max-height: 92vh;
            overflow-y: auto;
            box-shadow: 0 20px 60px rgba(15, 23, 42, .2);
            animation: mIn .2s ease;
        }

        @keyframes mIn {
            from {
                opacity: 0;
                transform: scale(.96) translateY(8px);
            }

            to {
                opacity: 1;
                transform: scale(1) translateY(0);
            }
        }

        .modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            border-bottom: 1px solid #f1f5f9;
            position: sticky;
            top: 0;
            background: white;
            z-index: 5;
        }

        .modal-body {
            padding: 18px 20px;
            display: flex;
            flex-direction: column;
            gap: 13px;
        }

        .modal-footer {
            padding: 14px 20px;
            border-top: 1px solid #f1f5f9;
            display: flex;
            justify-content: flex-end;
            gap: 8px;
        }

        /* Nav active state */
        .nav-active {
            background: linear-gradient(135deg, #06b6d4 0%, #6366f1 100%) !important;
            color: white !important;
            font-weight: 700;
            box-shadow: 0 4px 16px rgba(6, 182, 212, 0.3), 0 2px 8px rgba(99, 102, 241, 0.4);
        }

        .nav-active i {
            color: white !important;
        }

        .no-scrollbar::-webkit-scrollbar {
            display: none;
        }

        .no-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }

        /* Profile dropdown */
        .profile-dropdown {
            position: absolute;
            top: calc(100% + 10px);
            right: 0;
            width: 210px;
            background: white;
            border-radius: 1rem;
            box-shadow: 0 8px 32px rgba(6, 182, 212, 0.13), 0 2px 8px rgba(99, 102, 241, 0.10);
            border: 1px solid #e0f2fe;
            z-index: 999;
            opacity: 0;
            transform: translateY(-6px) scale(0.97);
            pointer-events: none;
            transition: opacity 0.18s ease, transform 0.18s ease;
        }

        .profile-dropdown.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all;
        }

        .profile-dropdown-item {
            display: flex;
            align-items: center;
            gap: 10px;
            padding: 10px 16px;
            font-size: 13px;
            font-weight: 700;
            color: #1e293b;
            cursor: pointer;
            transition: background 0.13s;
            border-radius: 0.75rem;
            text-decoration: none;
        }

        .profile-dropdown-item:hover {
            background: #f0f9ff;
            color: #0369a1;
        }

        .profile-dropdown-item.danger:hover {
            background: #fff1f2;
            color: #be123c;
        }
    </style>
    <%- include('../partials/teacher-nav-styles') %>
</head>

<body class="text-slate-900">

    <div id="rp-toast"></div>

    <div class="flex min-h-screen relative overflow-x-hidden">

        <%- include('../partials/teacher-sidebar', { activeNav: 'reports' }) %>

            <!-- MAIN -->
            <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

                <!-- Header -->
                <header
                    class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
                    <div class="flex items-center gap-4">
                        <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar"
                            class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                            <i class="fas fa-bars text-xl"></i>
                        </button>
                        <div class="hidden sm:block">
                            <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">Reports &
                                Analytics</h1>
                            <p class="text-xs text-slate-600 font-medium">
                                <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                                Export documents, view charts & deep-dive data
                            </p>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 md:gap-6">
                        <!-- Messages Navigation Button (Entry point to teacher messages workspace) -->
                        <a href="/teacher/messages" id="messagesBtn" aria-label="Open messages and conversations"
                            class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                            <i class="far fa-comment-dots text-xl"></i>

                            <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                                <span class="msg-badge-count">0</span>
                            </span>

                            <span
                                class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Messages
                            </span>
                        </a>

                        <!-- Notification Button with keyboard-accessible tooltip -->
                        <button type="button" onclick="toggleNotifPanel()" aria-label="View notifications"
                            class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                            <i class="far fa-bell text-xl text-slate-700"></i>
                            <% const _unreadNotifCount = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications.filter(n => !n.is_read).length : 0; %>
                            <span
                                class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center notif-badge <%= _unreadNotifCount > 0 ? '' : 'hidden' %>"
                                aria-hidden="true">
                                <span class="notif-badge-count"><%= _unreadNotifCount > 99 ? '99+' : _unreadNotifCount %></span>
                            </span>
                            <span
                                class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                                Notifications
                            </span>
                        </button>
                        <!-- User Profile Dropdown -->
                        <div class="relative">
                            <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false"
                                aria-label="Open user profile menu"
                                class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                                <div class="text-right hidden lg:block">
                                    <p class="text-sm font-bold text-slate-800 leading-none mb-1">
                                        <%= user.first_name %>
                                            <%= user.last_name %>
                                    </p>
                                    <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none">
                                        <%= user.role || 'Teacher' %>
                                    </p>
                                </div>
                                <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>"
                                    alt="<%= user.first_name %>'s avatar"
                                    class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100"
                                    onerror="this.src='/profile_uploads/default_avatar.png'">
                                <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                            </button>

                            <div id="userDropdown"
                                class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                                <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                                    <p class="text-sm font-bold text-slate-800">
                                        <%= user.first_name %>
                                            <%= user.last_name %>
                                    </p>
                                    <p class="text-xs text-slate-600 mt-1 uppercase font-bold">
                                        <%= user.role || 'Teacher' %>
                                    </p>
                                </div>
                                <a href="/teacher/profile"
                                    class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                                    <i class="far fa-user w-5 text-center"></i> View Profile
                                </a>
                                <hr class="my-2 border-slate-100">
                                <a href="/logout"
                                    class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                                    <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                                </a>
                            </div>
                        </div>
                    </div>
                </header>

                <!-- ===== SCROLLABLE BODY ===== -->
                <div id="mainScroll" class="flex-1 overflow-y-auto mt-20 no-scrollbar flex flex-col">
                    <div class="p-4 md:p-8 flex-1">

                        <!-- ACADEMIC YEAR & QUARTERLY GRADING DEADLINES BANNER -->
                        <% if (typeof activeSY !== 'undefined' && activeSY) { %>
                            <div class="section-card p-4 md:p-5 mb-6 bg-gradient-to-r from-slate-900 via-indigo-950 to-slate-900 text-white border-0 shadow-lg">
                                <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
                                    <div class="flex items-center gap-3">
                                        <div class="w-10 h-10 rounded-xl bg-indigo-500/30 border border-indigo-400/40 flex items-center justify-center font-black text-indigo-300">
                                            SY
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <h2 class="text-sm md:text-base font-extrabold text-white">Active Academic Year: <%= activeSY.sy_range %></h2>
                                                <span class="px-2 py-0.5 rounded-full bg-emerald-500/20 text-emerald-300 border border-emerald-500/40 text-[10px] font-bold uppercase"><%= activeSY.status || 'Active' %></span>
                                            </div>
                                            <p class="text-[11px] text-slate-300">DepEd 2-Semester &times; 2-Quarter Framework &bull; Instructor Quarterly Grade Encoding Deadlines</p>
                                        </div>
                                    </div>
                                    <div class="text-right hidden sm:block">
                                        <span class="text-[11px] font-bold text-slate-300">Passing Threshold:</span>
                                        <span class="ml-1 text-xs font-black text-emerald-400"><%= activeSY.passing_threshold || '75.00' %>%</span>
                                    </div>
                                </div>

                                <!-- 4 Quarterly Deadline Cards -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
                                    <% [1, 2, 3, 4].forEach(qNum => { 
                                        const qStatus = (typeof quarterStatuses !== 'undefined' && quarterStatuses[qNum]) 
                                            ? quarterStatuses[qNum] 
                                            : { isAllowed: true, status: 'open', message: 'Grading open' };
                                        const deadlineVal = activeSY['q' + qNum + '_grade_deadline'];
                                        const deadlineStr = deadlineVal ? new Date(deadlineVal).toLocaleDateString('en-PH', { month: 'short', day: 'numeric', year: 'numeric' }) : 'No deadline set';
                                        const semLabel = (qNum <= 2) ? '1st Sem (Chem 1)' : '2nd Sem (Chem 2)';
                                    %>
                                        <div class="rounded-xl p-3 bg-white/5 border <%= qStatus.isAllowed ? 'border-indigo-500/20' : 'border-rose-500/40 bg-rose-950/20' %> flex flex-col justify-between">
                                            <div class="flex items-center justify-between gap-2 mb-1.5">
                                                <span class="font-extrabold text-xs text-white">Quarter <%= qNum %></span>
                                                <% if (qStatus.isAllowed) { %>
                                                    <span class="px-1.5 py-0.5 rounded bg-emerald-500/20 text-emerald-300 text-[9px] font-bold flex items-center gap-1">
                                                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
                                                        Open
                                                    </span>
                                                <% } else { %>
                                                    <span class="px-1.5 py-0.5 rounded bg-rose-500/20 text-rose-300 text-[9px] font-bold flex items-center gap-1">
                                                        <i class="fas fa-lock text-[8px]"></i>
                                                        Locked
                                                    </span>
                                                <% } %>
                                            </div>
                                            <p class="text-[10px] text-slate-400 mb-2"><%= semLabel %></p>
                                            <div class="pt-2 border-t border-white/10 flex items-center justify-between text-[10px]">
                                                <span class="text-slate-400">Deadline:</span>
                                                <span class="font-mono font-bold <%= qStatus.isAllowed ? 'text-slate-200' : 'text-rose-300' %>"><%= deadlineStr %></span>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>
                            </div>
                        <% } %>

                        <!-- CLASS SELECTOR STRIP -->
                        <div class="section-card p-4 flex flex-wrap gap-4 items-center justify-between mb-6">
                            <div class="flex items-center gap-3">
                                <div class="w-9 h-9 rounded-xl bg-indigo-100 flex items-center justify-center">
                                    <i class="fas fa-filter text-indigo-600 text-sm"></i>
                                </div>
                                <div>
                                    <p class="text-xs font-black text-indigo-900 uppercase tracking-tight">Active Filter
                                    </p>
                                    <p class="text-[11px] text-slate-400 font-bold">All data below reflects the selected
                                        class</p>
                                </div>
                            </div>
                            <div class="flex gap-3 items-center flex-wrap">
                                <div>
                                    <label class="form-label">Class</label>
                                    <select id="classFilter" class="form-select" style="min-width:240px"
                                        onchange="applyClassFilter()">
                                        <% classes.forEach(c=> { %>
                                            <option value="<%= c.class_id %>" data-subject="<%= c.subject_id %>"
                                                <%=String(c.class_id)===String(selectedClassId) ? 'selected' : '' %>>
                                                <%= c.class_name %> — <%= c.subject_name %>
                                            </option>
                                            <% }) %>
                                                <option value="all" <%=selectedClassId==='all' ? 'selected' : '' %>>—
                                                    All my classes (Overview) —</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- SUMMARY STAT CARDS -->
                        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
                            <div class="section-card p-4 text-center">
                                <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Total Students</p>
                                <p class="text-3xl font-black text-indigo-900" id="stat-students">
                                    <%= stats.totalStudents %>
                                </p>
                            </div>
                            <div class="section-card p-4 text-center">
                                <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Avg Accuracy</p>
                                <p class="text-3xl font-black text-cyan-600" id="stat-accuracy">
                                    <%= Math.round(stats.avgAccuracy || 0) %>%
                                </p>
                            </div>
                            <div class="section-card p-4 text-center">
                                <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Avg Completion</p>
                                <p class="text-3xl font-black text-emerald-600" id="stat-completion">
                                    <%= Math.round(stats.avgCompletion || 0) %>%
                                </p>
                            </div>
                            <div class="section-card p-4 text-center">
                                <p class="text-[10px] font-black text-slate-400 uppercase mb-1">Total Attempts</p>
                                <p class="text-3xl font-black text-violet-600" id="stat-attempts">
                                    <%= stats.totalAttempts %>
                                </p>
                            </div>
                        </div>

                        <!-- TAB STRIP -->
                        <div
                            class="bg-white/80 backdrop-blur border border-cyan-100 rounded-2xl p-1.5 flex gap-1 overflow-x-auto no-scrollbar mb-2">
                            <button id="tabBtn-export" class="tab-btn active" onclick="switchTab('export', this)">
                                <i class="fas fa-file-arrow-down mr-1.5"></i>Export Hub
                            </button>
                            <button id="tabBtn-analytics" class="tab-btn" onclick="switchTab('analytics', this)">
                                <i class="fas fa-chart-column mr-1.5"></i>Visual Analytics
                            </button>
                            <button id="tabBtn-deepdive" class="tab-btn" onclick="switchTab('deepdive', this)">
                                <i class="fas fa-microscope mr-1.5"></i>Deep-Dive Reports
                            </button>
                        </div>

                        <!-- ══════════════════════════════════════════════ -->
                        <!-- TAB 1: EXPORT HUB                             -->
                        <!-- ══════════════════════════════════════════════ -->
                        <div id="tab-export" class="tab-panel active space-y-4">

                            <!-- A. Class List & Attendance Summary -->
                            <div class="export-card fade-in">
                                <div class="flex flex-wrap gap-4 items-start justify-between">
                                    <div class="flex items-start gap-3">
                                        <div
                                            class="w-10 h-10 rounded-xl bg-indigo-100 flex items-center justify-center flex-shrink-0">
                                            <i class="fas fa-users text-indigo-600"></i>
                                        </div>
                                        <div>
                                            <p class="text-sm font-black text-indigo-900">Class List & Attendance
                                                Summary</p>
                                            <p class="text-[11px] text-slate-400 mt-0.5 leading-relaxed max-w-lg">
                                                Master list with student demographics and cumulative attendance
                                                statistics (Present, Late, Absent, Excused, Attendance Rate).
                                            </p>
                                            <div class="flex flex-wrap gap-1.5 mt-2">
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">classes</span>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">class_students</span>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-600 border border-emerald-200">attendance_records</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex gap-2 flex-shrink-0 flex-wrap">
                                        <button class="btn btn-rose btn-sm" onclick="exportDoc('class-list','pdf')">
                                            <i class="fas fa-file-pdf"></i> PDF
                                        </button>
                                        <button class="btn btn-emerald btn-sm"
                                            onclick="exportDoc('class-list','excel')">
                                            <i class="fas fa-file-excel"></i> Excel
                                        </button>
                                    </div>
                                </div>
                            </div>

                            <!-- B. Student Progress Report Card -->
                            <div class="export-card fade-in mb-6">
                                <div class="flex flex-wrap gap-4 items-start justify-between ">
                                    <div class="flex items-start gap-3">
                                        <div
                                            class="w-10 h-10 rounded-xl bg-cyan-100 flex items-center justify-center flex-shrink-0">
                                            <i class="fas fa-id-card text-cyan-600"></i>
                                        </div>
                                        <div>
                                            <p class="text-sm font-black text-indigo-900">Student Progress Report Card
                                                <span class="text-[10px] font-bold text-cyan-600 ml-1">(Individual
                                                    PDF)</span></p>
                                            <p class="text-[11px] text-slate-400 mt-0.5 leading-relaxed max-w-lg">
                                                Per-topic grades, overall progress %, achieved levels, and total EXP.
                                                Generated per student for parents or students as proof of performance.
                                            </p>
                                            <div class="flex flex-wrap gap-1.5 mt-2">
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">student_scores</span>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">student_progress</span>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">users</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex gap-2 flex-shrink-0 flex-wrap">
                                        <button class="btn btn-rose btn-sm shadow-sm hover:shadow transition"
                                            onclick="openReportCardModal('batch')"
                                            title="Export filtered report cards for all enrolled students in this class">
                                            <i class="fas fa-file-pdf"></i> Batch Class PDF
                                        </button>
                                    </div>
                                </div>

                                <!-- Student list preview table -->
                                <div class="mt-4 rounded-xl border border-slate-100 overflow-hidden">
                                    <table class="w-full text-xs">
                                        <thead>
                                            <tr class="bg-slate-50 border-b border-slate-100">
                                                <th
                                                    class="text-left px-3 py-2 font-black text-slate-500 uppercase text-[10px]">
                                                    Student</th>
                                                <th
                                                    class="text-left px-3 py-2 font-black text-slate-500 uppercase text-[10px]">
                                                    Progress</th>
                                                <th
                                                    class="text-left px-3 py-2 font-black text-slate-500 uppercase text-[10px]">
                                                    Level</th>
                                                <th
                                                    class="text-left px-3 py-2 font-black text-slate-500 uppercase text-[10px]">
                                                    EXP</th>
                                                <th class="px-3 py-2"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% students.forEach(s=> { %>
                                                <tr class="border-b border-slate-50 hover:bg-indigo-50/40 transition">
                                                    <td class="px-3 py-2">
                                                        <div class="flex items-center gap-2">
                                                            <img src="/profile_uploads/<%= s.profile_pic || 'default_avatar.png' %>"
                                                                class="w-7 h-7 rounded-lg object-cover"
                                                                onerror="this.src='/profile_uploads/default_avatar.png'">
                                                            <div>
                                                                <span class="font-bold text-indigo-900">
                                                                    <%= s.last_name %>, <%= s.first_name %>
                                                                </span>
                                                                <% if (s.class_name) { %>
                                                                    <span
                                                                        class="text-[9px] font-black px-1.5 py-0.2 rounded bg-indigo-50 text-indigo-700 border border-indigo-200 ml-1">
                                                                        <%= s.class_name %> &middot; <%= s.subject_code
                                                                                || s.subject_name || 'Chemistry' %>
                                                                    </span>
                                                                    <% } %>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="px-3 py-2">
                                                        <div class="flex items-center gap-2">
                                                            <div class="prog-track w-20">
                                                                <div class="prog-fill"
                                                                    style="width:<%= s.progress_percent || 0 %>%;background:<%= (s.progress_percent||0) >= 75 ? '#10b981' : (s.progress_percent||0) >= 40 ? '#f59e0b' : '#ef4444' %>">
                                                                </div>
                                                            </div>
                                                            <span class="font-black text-slate-600">
                                                                <%= s.progress_percent || 0 %>%
                                                            </span>
                                                        </div>
                                                    </td>
                                                    <td class="px-3 py-2">
                                                        <span class="font-black text-violet-600"
                                                            title="<%= s.level_title || 'Cadet' %>">Lv.<%=
                                                                s.current_level || 1 %> / 12</span>
                                                        <span class="block text-[10px] text-slate-400 font-semibold">
                                                            <%= s.level_title || 'Cadet' %>
                                                        </span>
                                                    </td>
                                                    <td class="px-3 py-2"><span class="font-black text-emerald-600">
                                                            <%= (s.total_exp || 0).toLocaleString() %> EXP
                                                        </span></td>
                                                    <td class="px-3 py-2 text-right">
                                                        <button type="button" class="btn btn-rose btn-sm shadow-sm"
                                                            data-student-id="<%= s.user_id %>"
                                                            data-student-name="<%= s.first_name %> <%= s.last_name %>"
                                                            data-class-id="<%= s.class_id %>"
                                                            onclick="openReportCardModal('student', this.dataset.studentId, this.dataset.studentName, this.dataset.classId)"
                                                            title="Export progress report card for <%= s.first_name %> <%= s.last_name %>">
                                                            <i class="fas fa-file-pdf"></i> PDF
                                                        </button>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% if (!students.length) { %>
                                                        <tr>
                                                            <td colspan="5"
                                                                class="text-center py-6 text-slate-300 text-xs font-bold italic">
                                                                Select a class to see students</td>
                                                        </tr>
                                                        <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- C. Remediation List -->
                            <div class="export-card fade-in">
                                <div class="flex flex-wrap gap-4 items-start justify-between">
                                    <div class="flex items-start gap-3">
                                        <div
                                            class="w-10 h-10 rounded-xl bg-amber-100 flex items-center justify-center flex-shrink-0">
                                            <i class="fas fa-kit-medical text-amber-600"></i>
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <p class="text-sm font-black text-indigo-900">Remediation List &
                                                    Curriculum Risk Matrix</p>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-amber-50 text-amber-700 border border-amber-200">DepEd
                                                    75% Mastery</span>
                                            </div>
                                            <p class="text-[11px] text-slate-400 mt-0.5 leading-relaxed max-w-lg">
                                                Curriculum concept vulnerabilities for the active class. Evaluates
                                                combined mastery across assessments, assignments, and forums to isolate
                                                topics and students requiring academic intervention.
                                            </p>
                                            <div class="flex flex-wrap gap-1.5 mt-2">
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">topic_analytics</span>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-rose-50 text-rose-600 border border-rose-200">class_risk_index</span>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-600 border border-indigo-200">single_topic_pdf</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex gap-2 flex-shrink-0 flex-wrap">
                                        <button type="button"
                                            class="btn btn-rose btn-sm shadow-sm hover:shadow transition flex items-center gap-1.5"
                                            onclick="exportBatchClassRemediation()"
                                            title="Export Batch Class Remediation PDF with a single click">
                                            <i class="fas fa-file-pdf"></i> Batch Class PDF
                                        </button>
                                    </div>
                                </div>

                                <!-- Restructured Topic-Centric Preview table (Fully Responsive, Perfectly Fit, No-Scroll) -->
                                <div class="mt-4 rounded-xl border border-slate-100 overflow-hidden bg-white shadow-xs">
                                    <table class="w-full text-xs table-auto">
                                        <thead>
                                            <tr class="bg-slate-50/90 border-b border-slate-100 text-slate-500">
                                                <th
                                                    class="text-left px-3 py-2.5 font-black uppercase text-[10px] w-[26%]">
                                                    Topic
                                                </th>
                                                <th
                                                    class="text-center px-2 py-2.5 font-black uppercase text-[10px] w-[14%]">
                                                    <span class="block">Students at Risk</span>
                                                    <span
                                                        class="text-[9px] text-slate-400 font-semibold normal-case tracking-normal">Count
                                                        / Enrolled</span>
                                                </th>
                                                <th
                                                    class="text-center px-2 py-2.5 font-black uppercase text-[10px] w-[12%]">
                                                    <span class="block">Assessment</span>
                                                    <span
                                                        class="text-[9px] text-slate-400 font-semibold normal-case tracking-normal">Class
                                                        Avg.</span>
                                                </th>
                                                <th
                                                    class="text-center px-2 py-2.5 font-black uppercase text-[10px] w-[12%]">
                                                    <span class="block">Assignment</span>
                                                    <span
                                                        class="text-[9px] text-slate-400 font-semibold normal-case tracking-normal">Class
                                                        Avg.</span>
                                                </th>
                                                <th
                                                    class="text-center px-2 py-2.5 font-black uppercase text-[10px] w-[13%]">
                                                    <span class="block">Forum Completion</span>
                                                    <span
                                                        class="text-[9px] text-slate-400 font-semibold normal-case tracking-normal">Submissions
                                                        %</span>
                                                </th>
                                                <th
                                                    class="text-center px-2 py-2.5 font-black uppercase text-[10px] w-[13%]">
                                                    <span class="block">Overall Class Risk</span>
                                                    <span
                                                        class="text-[9px] text-slate-400 font-semibold normal-case tracking-normal">Intervention
                                                        Rate</span>
                                                </th>
                                                <th
                                                    class="text-right px-3 py-2.5 font-black uppercase text-[10px] w-[10%]">
                                                    Action
                                                </th>
                                            </tr>
                                        </thead>
                                        <tbody class="divide-y divide-slate-50">
                                            <% (remediationList || []).forEach(r=> { %>
                                                <tr class="hover:bg-amber-50/30 transition">
                                                    <td class="px-3 py-2.5">
                                                        <div class="flex items-center gap-1.5 flex-wrap">
                                                            <span
                                                                class="font-bold text-indigo-900 leading-tight text-xs">
                                                                <%= r.topic_name %>
                                                            </span>
                                                            <% if (r.quarter_number) { %>
                                                                <span
                                                                    class="text-[9px] font-black px-1.5 py-0.2 rounded bg-indigo-50 text-indigo-700 border border-indigo-200 flex-shrink-0">
                                                                    Q<%= r.quarter_number %>
                                                                </span>
                                                                <% } %>
                                                        </div>
                                                        <div class="text-[9.5px] text-slate-400 font-medium mt-0.5">
                                                            <%= r.asmt_count || 0 %> asmt &bull; <%= r.asgn_count || 0
                                                                    %> asgn &bull; <%= r.forum_count || 0 %> forums
                                                        </div>
                                                    </td>
                                                    <td class="px-2 py-2.5 text-center">
                                                        <% if (r.no_of_students_at_risk> 0) { %>
                                                            <span
                                                                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10.5px] font-black bg-rose-50 text-rose-600 border border-rose-200 whitespace-nowrap">
                                                                <i class="fas fa-triangle-exclamation text-[9px]"></i>
                                                                <%= r.no_of_students_at_risk %> / <%= r.total_enrolled
                                                                        %>
                                                            </span>
                                                            <% } else { %>
                                                                <span
                                                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10.5px] font-black bg-emerald-50 text-emerald-600 border border-emerald-200 whitespace-nowrap">
                                                                    <i class="fas fa-check text-[9px]"></i> 0 at risk
                                                                </span>
                                                                <% } %>
                                                    </td>
                                                    <td class="px-2 py-2.5 text-center">
                                                        <% if (r.class_asmt_avg !==null && r.class_asmt_avg
                                                            !==undefined) { %>
                                                            <span
                                                                class="font-black text-xs <%= r.class_asmt_avg >= 75 ? 'text-emerald-600' : 'text-rose-600' %>">
                                                                <%= r.class_asmt_avg %>%
                                                            </span>
                                                            <% } else { %>
                                                                <span class="text-slate-300 font-bold">—</span>
                                                                <% } %>
                                                    </td>
                                                    <td class="px-2 py-2.5 text-center">
                                                        <% if (r.class_asgn_avg !==null && r.class_asgn_avg
                                                            !==undefined) { %>
                                                            <span
                                                                class="font-black text-xs <%= r.class_asgn_avg >= 75 ? 'text-emerald-600' : 'text-rose-600' %>">
                                                                <%= r.class_asgn_avg %>%
                                                            </span>
                                                            <% } else { %>
                                                                <span class="text-slate-300 font-bold">—</span>
                                                                <% } %>
                                                    </td>
                                                    <td class="px-2 py-2.5 text-center">
                                                        <% if (r.class_forum_completion_pct !==null &&
                                                            r.class_forum_completion_pct !==undefined) { %>
                                                            <span
                                                                class="font-black text-xs <%= r.class_forum_completion_pct >= 75 ? 'text-indigo-600' : 'text-amber-600' %>">
                                                                <%= r.class_forum_completion_pct %>%
                                                            </span>
                                                            <% } else { %>
                                                                <span class="text-slate-300 font-bold">—</span>
                                                                <% } %>
                                                    </td>
                                                    <td class="px-2 py-2.5 text-center">
                                                        <% if (r.overall_class_risk_pct>= 50) { %>
                                                            <span
                                                                class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10.5px] font-black bg-rose-100 text-rose-700 border border-rose-300 whitespace-nowrap">
                                                                <%= r.overall_class_risk_pct %>% High
                                                            </span>
                                                            <% } else if (r.overall_class_risk_pct>= 25) { %>
                                                                <span
                                                                    class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10.5px] font-black bg-amber-100 text-amber-700 border border-amber-300 whitespace-nowrap">
                                                                    <%= r.overall_class_risk_pct %>% Mod
                                                                </span>
                                                                <% } else { %>
                                                                    <span
                                                                        class="inline-flex items-center gap-1 px-2 py-0.5 rounded-full text-[10.5px] font-black bg-emerald-100 text-emerald-700 border border-emerald-300 whitespace-nowrap">
                                                                        <%= r.overall_class_risk_pct %>% Low
                                                                    </span>
                                                                    <% } %>
                                                    </td>
                                                    <td class="px-3 py-2.5 text-right">
                                                        <button type="button"
                                                            class="btn btn-rose btn-xs shadow-sm hover:scale-105 transition flex items-center gap-1 ml-auto whitespace-nowrap font-bold"
                                                            data-topic-name="<%= r.topic_name || '' %>"
                                                            onclick="exportSingleTopicRemediation(<%= r.topic_id %>, this.dataset.topicName)"
                                                            title="Export Single-Topic Remediation PDF">
                                                            <i class="fas fa-file-pdf"></i> PDF
                                                        </button>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% if (!remediationList || !remediationList.length) { %>
                                                        <tr>
                                                            <td colspan="7"
                                                                class="text-center py-8 text-slate-300 text-xs font-bold italic">
                                                                <div
                                                                    class="flex flex-col items-center justify-center gap-2">
                                                                    <i
                                                                        class="fas fa-clipboard-check text-slate-300 text-2xl"></i>
                                                                    <span>No topic remediation records found for the
                                                                        selected active class filter.</span>
                                                                </div>
                                                            </td>
                                                        </tr>
                                                        <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>

                            <!-- D. Master Class Gradebook & Assessment Summary -->
                            <div class="export-card fade-in">
                                <div class="flex flex-wrap gap-4 items-start justify-between">
                                    <div class="flex items-start gap-3">
                                        <div
                                            class="w-10 h-10 rounded-xl bg-violet-100 flex items-center justify-center flex-shrink-0">
                                            <i class="fas fa-book-bookmark text-violet-600"></i>
                                        </div>
                                        <div>
                                            <div class="flex items-center gap-2">
                                                <p class="text-sm font-black text-indigo-900">Master Class Gradebook &
                                                    Assessment Summary</p>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-violet-50 text-violet-700 border border-violet-200">DepEd
                                                    Order No. 8</span>
                                            </div>
                                            <p class="text-[11px] text-slate-400 mt-0.5 leading-relaxed max-w-lg">
                                                Complete DepEd-aligned grade sheet: Coursework Averages (LMS Written
                                                Works & Performance Tasks), Simulation Masteries (Arcade & Lab Quizzes),
                                                Composite Final Grade %, Syllabus Progress, and Attendance Rate.
                                            </p>
                                            <div class="flex flex-wrap gap-1.5 mt-2">
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">student_scores</span>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-slate-100 text-slate-500">elementa_student_grades</span>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-indigo-50 text-indigo-700 border border-indigo-200">Landscape
                                                    A4 PDF</span>
                                                <span
                                                    class="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-200">Multi-Sheet
                                                    .xlsx</span>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="flex items-center gap-2 flex-shrink-0 flex-wrap">
                                        <!-- Inline Quick Filter Controls -->
                                        <div
                                            class="flex items-center gap-1.5 bg-slate-50 border border-slate-200 rounded-xl px-2.5 py-1.5 shadow-2xs">
                                            <i class="fas fa-filter text-[10px] text-slate-400"></i>
                                            <select id="gradebookQuarterFilter"
                                                class="bg-transparent text-xs font-bold text-slate-700 outline-none cursor-pointer pr-1"
                                                title="Filter Master Gradebook by Quarter">
                                                <option value="">All Quarters (Full SY)</option>
                                                <option value="1">Quarter 1</option>
                                                <option value="2">Quarter 2</option>
                                                <option value="3">Quarter 3</option>
                                                <option value="4">Quarter 4</option>
                                            </select>
                                            <div class="h-3.5 w-px bg-slate-200 mx-0.5"></div>
                                            <select id="gradebookStandingFilter"
                                                class="bg-transparent text-xs font-bold text-slate-700 outline-none cursor-pointer pr-1"
                                                title="Filter Master Gradebook by Academic Standing">
                                                <option value="">All Standings</option>
                                                <option value="passed">Passed (≥75%)</option>
                                                <option value="at_risk">At-Risk (&lt;75%)</option>
                                                <option value="incomplete">Incomplete (No Submissions)</option>
                                            </select>
                                        </div>

                                        <!-- Action Buttons: Open Gradebook Weighting & Export Modal -->
                                        <button type="button"
                                            class="btn btn-rose btn-sm shadow-sm hover:shadow transition flex items-center gap-1.5 font-bold"
                                            onclick="openGradebookWeightModal('pdf')"
                                            title="Configure gradebook weights &amp; export Landscape PDF Gradebook">
                                            <i class="fas fa-file-pdf"></i> PDF
                                        </button>
                                        <button type="button"
                                            class="btn btn-emerald btn-sm shadow-sm hover:shadow transition flex items-center gap-1.5 font-bold"
                                            onclick="openGradebookWeightModal('excel')"
                                            title="Configure gradebook weights &amp; export DepEd Excel Gradebook (.xlsx)">
                                            <i class="fas fa-file-excel"></i> Excel
                                        </button>
                                    </div>
                                </div>
                            </div>

                        </div><!-- /tab-export -->


                        <!-- ══════════════════════════════════════════════ -->
                        <!-- TAB 2: VISUAL ANALYTICS                       -->
                        <!-- ══════════════════════════════════════════════ -->
                        <div id="tab-analytics" class="tab-panel space-y-6">

                            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

                                <!-- A. Score Distribution Histogram -->
                                <div class="section-card">
                                    <div class="section-header">
                                        <div>
                                            <p class="text-sm font-black text-indigo-900 uppercase tracking-tight">Score
                                                Distribution</p>
                                            <p class="text-[10px] text-slate-400 font-bold mt-0.5">Assessment Results —
                                                Class score spread</p>
                                        </div>
                                        <span
                                            class="text-[10px] font-black text-indigo-500 bg-indigo-50 border border-indigo-100 px-2 py-1 rounded-full">Bar
                                            Chart</span>
                                    </div>
                                    <div class="p-4">
                                        <% if (scoreDistribution && scoreDistribution.some(b=> b.count > 0)) { %>
                                            <canvas id="chartScoreDist" height="200"></canvas>
                                            <% } else { %>
                                                <div
                                                    class="flex flex-col items-center justify-center h-40 text-slate-300">
                                                    <i class="fas fa-chart-bar text-3xl mb-2"></i>
                                                    <p class="text-xs font-bold italic">No assessment data yet</p>
                                                </div>
                                                <% } %>
                                    </div>
                                </div>

                                <!-- B. Versus Battle Victories -->
                                <div class="section-card">
                                    <div class="section-header">
                                        <div>
                                            <p class="text-sm font-black text-indigo-900 uppercase tracking-tight">PvP &
                                                Versus Victories</p>
                                            <p class="text-[10px] text-slate-400 font-bold mt-0.5">Competitive Duels —
                                                Wins recorded per top student</p>
                                        </div>
                                        <span
                                            class="text-[10px] font-black text-violet-500 bg-violet-50 border border-violet-100 px-2 py-1 rounded-full">Doughnut</span>
                                    </div>
                                    <div class="p-4 flex items-center justify-center">
                                        <% if (winLoss && winLoss.length> 0) { %>
                                            <div style="max-width: 260px; width: 100%;">
                                                <canvas id="chartWinLoss" height="200"></canvas>
                                            </div>
                                            <% } else { %>
                                                <div
                                                    class="flex flex-col items-center justify-center h-40 text-slate-300">
                                                    <i class="fas fa-trophy text-3xl mb-2"></i>
                                                    <p class="text-xs font-bold italic">No PvP versus matches recorded
                                                        yet</p>
                                                </div>
                                                <% } %>
                                    </div>
                                </div>

                            </div>

                            <!-- C. Student EXP Progression Trajectory -->
                            <div class="section-card">
                                <div class="section-header">
                                    <div>
                                        <p class="text-sm font-black text-indigo-900 uppercase tracking-tight">Student
                                            Experience (EXP) Progression</p>
                                        <p class="text-[10px] text-slate-400 font-bold mt-0.5">Historical EXP earned
                                            across gameplay sessions over time (Top active students)</p>
                                    </div>
                                    <span
                                        class="text-[10px] font-black text-emerald-500 bg-emerald-50 border border-emerald-100 px-2 py-1 rounded-full">Line
                                        Trend</span>
                                </div>
                                <div class="p-4">
                                    <% if (expGrowth && expGrowth.labels && expGrowth.labels.length> 0) { %>
                                        <canvas id="chartExpGrowth" height="95"></canvas>
                                        <% } else { %>
                                            <div class="flex flex-col items-center justify-center h-40 text-slate-300">
                                                <i class="fas fa-chart-line text-3xl mb-2"></i>
                                                <p class="text-xs font-bold italic">No EXP trajectory recorded yet</p>
                                            </div>
                                            <% } %>
                                </div>
                            </div>

                            <!-- D. Topic Mastery Heatmap -->
                            <div class="section-card">
                                <div class="section-header">
                                    <div>
                                        <p class="text-sm font-black text-indigo-900 uppercase tracking-tight">Topic
                                            Mastery Heatmap</p>
                                        <p class="text-[10px] text-slate-400 font-bold mt-0.5">Competency Analysis —
                                            Green = mastered, Red = needs attention</p>
                                    </div>
                                    <span
                                        class="text-[10px] font-black text-rose-500 bg-rose-50 border border-rose-100 px-2 py-1 rounded-full">Heatmap</span>
                                </div>
                                <div class="p-4 overflow-x-auto">
                                    <% if (heatmap && heatmap.topics && heatmap.topics.length> 0) { %>
                                        <div style="min-width: 600px;">
                                            <!-- Topic header row -->
                                            <div class="flex gap-2 mb-2 pl-28">
                                                <% heatmap.topics.forEach(t=> { %>
                                                    <div class="flex-1 text-center text-[9px] font-black text-slate-400 uppercase truncate"
                                                        style="min-width:70px" title="<%= t %>">
                                                        <%= t.substring(0,12) %>
                                                    </div>
                                                    <% }) %>
                                            </div>
                                            <!-- Student rows -->
                                            <% heatmap.rows.forEach(row=> { %>
                                                <div class="flex gap-2 mb-1.5 items-center">
                                                    <div
                                                        class="w-28 text-[10px] font-bold text-slate-600 truncate flex-shrink-0">
                                                        <%= row.name %>
                                                    </div>
                                                    <% row.scores.forEach(score=> {
                                                        const pct = score === null ? null : score;
                                                        const bg = pct === null ? '#f1f5f9' : pct >= 80 ? '#bbf7d0' :
                                                        pct >= 60 ? '#fef08a' : pct >= 40 ? '#fed7aa' : '#fecaca';
                                                        const txt = pct === null ? '#cbd5e1' : pct >= 80 ? '#15803d' :
                                                        pct >= 60 ? '#a16207' : pct >= 40 ? '#c2410c' : '#b91c1c';
                                                        %>
                                                        <div class="heat-cell flex-1"
                                                            style="min-width:70px;background:<%= bg %>;color:<%= txt %>"
                                                            title="<%= pct !== null ? pct + '%' : 'No data' %>">
                                                            <%= pct !==null ? pct + '%' : '—' %>
                                                        </div>
                                                        <% }) %>
                                                </div>
                                                <% }) %>
                                                    <!-- Legend -->
                                                    <div
                                                        class="flex items-center gap-3 mt-4 pt-3 border-t border-slate-100">
                                                        <span
                                                            class="text-[10px] font-black text-slate-400 uppercase">Legend:</span>
                                                        <div class="flex items-center gap-1">
                                                            <div class="w-4 h-4 rounded" style="background:#bbf7d0">
                                                            </div><span
                                                                class="text-[10px] font-bold text-slate-500">≥80%</span>
                                                        </div>
                                                        <div class="flex items-center gap-1">
                                                            <div class="w-4 h-4 rounded" style="background:#fef08a">
                                                            </div><span
                                                                class="text-[10px] font-bold text-slate-500">60–79%</span>
                                                        </div>
                                                        <div class="flex items-center gap-1">
                                                            <div class="w-4 h-4 rounded" style="background:#fed7aa">
                                                            </div><span
                                                                class="text-[10px] font-bold text-slate-500">40–59%</span>
                                                        </div>
                                                        <div class="flex items-center gap-1">
                                                            <div class="w-4 h-4 rounded" style="background:#fecaca">
                                                            </div><span
                                                                class="text-[10px] font-bold text-slate-500">&lt;40%</span>
                                                        </div>
                                                        <div class="flex items-center gap-1">
                                                            <div class="w-4 h-4 rounded" style="background:#f1f5f9">
                                                            </div><span class="text-[10px] font-bold text-slate-500">No
                                                                data</span>
                                                        </div>
                                                    </div>
                                        </div>
                                        <% } else { %>
                                            <div class="flex flex-col items-center justify-center h-32 text-slate-300">
                                                <i class="fas fa-table-cells text-3xl mb-2"></i>
                                                <p class="text-xs font-bold italic">No topic + response data to display
                                                </p>
                                            </div>
                                            <% } %>
                                </div>
                            </div>

                        </div><!-- /tab-analytics -->


                        <!-- ══════════════════════════════════════════════ -->
                        <!-- TAB 3: DEEP-DIVE REPORTS                      -->
                        <!-- ══════════════════════════════════════════════ -->
                        <div id="tab-deepdive" class="tab-panel space-y-6">

                            <!-- 1. Subject-Level Completion Rate -->
                            <div class="section-card">
                                <div class="section-header">
                                    <div>
                                        <p class="text-sm font-black text-indigo-900 uppercase tracking-tight">
                                            Subject-Level Completion</p>
                                        <p class="text-[10px] text-slate-400 font-bold mt-0.5">Average progress percent
                                            per class across the syllabus</p>
                                    </div>
                                </div>
                                <div class="p-4 space-y-3">
                                    <% completionRates.forEach(cr=> { %>
                                        <div>
                                            <div class="flex justify-between mb-1">
                                                <span class="text-xs font-black text-indigo-800">
                                                    <%= cr.class_name %> — <span class="text-cyan-600">
                                                            <%= cr.subject_name %>
                                                        </span>
                                                </span>
                                                <span
                                                    class="text-xs font-black <%= cr.avg_progress >= 75 ? 'text-emerald-600' : cr.avg_progress >= 40 ? 'text-amber-600' : 'text-rose-600' %>">
                                                    <%= Math.round(cr.avg_progress) %>% complete
                                                </span>
                                            </div>
                                            <div class="prog-track">
                                                <div class="prog-fill"
                                                    style="width:<%= Math.round(cr.avg_progress) %>%;background:<%= cr.avg_progress >= 75 ? '#10b981' : cr.avg_progress >= 40 ? '#f59e0b' : '#ef4444' %>">
                                                </div>
                                            </div>
                                            <p class="text-[10px] text-slate-400 mt-0.5 font-bold">
                                                <%= cr.student_count %> students &nbsp;•&nbsp; SY <%= cr.sy_range %>
                                            </p>
                                        </div>
                                        <% }) %>
                                            <% if (!completionRates.length) { %>
                                                <p class="text-center py-6 text-slate-300 text-xs font-bold italic">No
                                                    progress data found.</p>
                                                <% } %>
                                </div>
                            </div>

                            <!-- 2. Item Analysis Report -->
                            <div class="section-card">
                                <div class="section-header">
                                    <div>
                                        <p class="text-sm font-black text-indigo-900 uppercase tracking-tight">Item
                                            Analysis — Problematic Question Finder</p>
                                        <p class="text-[10px] text-slate-400 font-bold mt-0.5">Questions ranked by
                                            failure rate — highest failure first</p>
                                    </div>
                                    <span
                                        class="text-[10px] font-black text-rose-500 bg-rose-50 border border-rose-100 px-2 py-1 rounded-full">
                                        <%= itemAnalysis.length %> questions tracked
                                    </span>
                                </div>
                                <div class="overflow-x-auto">
                                    <table class="w-full text-xs">
                                        <thead>
                                            <tr class="bg-slate-50 border-b border-slate-100">
                                                <th
                                                    class="text-left px-4 py-2.5 font-black text-slate-500 uppercase text-[10px]">
                                                    Rank</th>
                                                <th
                                                    class="text-left px-4 py-2.5 font-black text-slate-500 uppercase text-[10px]">
                                                    Question</th>
                                                <th
                                                    class="text-left px-4 py-2.5 font-black text-slate-500 uppercase text-[10px]">
                                                    Topic</th>
                                                <th
                                                    class="text-left px-4 py-2.5 font-black text-slate-500 uppercase text-[10px]">
                                                    Difficulty</th>
                                                <th
                                                    class="text-left px-4 py-2.5 font-black text-slate-500 uppercase text-[10px]">
                                                    Failure Rate</th>
                                                <th
                                                    class="text-left px-4 py-2.5 font-black text-slate-500 uppercase text-[10px]">
                                                    Responses</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% itemAnalysis.forEach((item, idx)=> {
                                                const failRate = item.total > 0 ? Math.round((item.wrong / item.total) *
                                                100) : 0;
                                                const barColor = failRate >= 70 ? '#ef4444' : failRate >= 50 ? '#f97316'
                                                : '#f59e0b';
                                                %>
                                                <tr class="border-b border-slate-50 hover:bg-rose-50/30 transition">
                                                    <td class="px-4 py-3">
                                                        <span
                                                            class="w-6 h-6 rounded-lg flex items-center justify-center text-[10px] font-black <%= idx===0?'rank-1':idx===1?'rank-2':idx===2?'rank-3':'rank-n' %>">
                                                            <%= idx+1 %>
                                                        </span>
                                                    </td>
                                                    <td class="px-4 py-3 max-w-xs">
                                                        <p class="font-bold text-slate-700 truncate"
                                                            title="<%= item.question_text %>">
                                                            <%= item.question_text.substring(0,70) %>
                                                                <%= item.question_text.length> 70 ? '…' : '' %>
                                                        </p>
                                                    </td>
                                                    <td class="px-4 py-3 font-bold text-cyan-700">
                                                        <%= item.topic_name %>
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        <span
                                                            class="px-2 py-0.5 rounded-full text-[10px] font-black
                                            <%= item.difficulty === 'Easy' ? 'bg-emerald-100 text-emerald-700' : item.difficulty === 'Average' ? 'bg-amber-100 text-amber-700' : 'bg-rose-100 text-rose-700' %>">
                                                            <%= item.difficulty %>
                                                        </span>
                                                    </td>
                                                    <td class="px-4 py-3">
                                                        <div class="flex items-center gap-2">
                                                            <div class="w-20 seq-bar">
                                                                <div class="seq-bar-fill"
                                                                    style="width:<%= failRate %>%;background:<%= barColor %>">
                                                                </div>
                                                            </div>
                                                            <span class="font-black" style="color:<%= barColor %>">
                                                                <%= failRate %>%
                                                            </span>
                                                        </div>
                                                    </td>
                                                    <td class="px-4 py-3 font-bold text-slate-500">
                                                        <%= item.total %>
                                                    </td>
                                                </tr>
                                                <% }) %>
                                                    <% if (!itemAnalysis.length) { %>
                                                        <tr>
                                                            <td colspan="6"
                                                                class="text-center py-8 text-slate-300 text-xs font-bold italic">
                                                                No response data available</td>
                                                        </tr>
                                                        <% } %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>



                            <!-- 4. Arcade Machine & Laboratory Station Error Analysis -->
                            <div class="section-card">
                                <div class="section-header">
                                    <div>
                                        <p class="text-sm font-black text-indigo-900 uppercase tracking-tight">Arcade
                                            Machine & Laboratory Station Error Analysis</p>
                                        <p class="text-[10px] text-slate-400 font-bold mt-0.5">Station breakdown —
                                            specific laboratory machines and kiosks where students encounter the highest
                                            failure rates during gameplay</p>
                                    </div>
                                    <span
                                        class="text-[10px] font-black text-amber-500 bg-amber-50 border border-amber-100 px-2 py-1 rounded-full">Machine
                                        Telemetry</span>
                                </div>
                                <div class="p-4 space-y-4">
                                    <% if (seqErrors && seqErrors.length> 0) { %>
                                        <% seqErrors.forEach(se=> { %>
                                            <div class="rounded-xl border border-slate-100 p-3 bg-slate-50">
                                                <div class="flex flex-wrap gap-3 items-start justify-between mb-2">
                                                    <div>
                                                        <p class="text-xs font-black text-indigo-800">
                                                            <%= se.question_text.substring(0,80) %>
                                                                <%= se.question_text.length> 80 ? '…' : '' %>
                                                        </p>
                                                        <p class="text-[10px] text-cyan-600 font-bold mt-0.5">Topic: <%=
                                                                se.topic_name %>
                                                        </p>
                                                    </div>
                                                    <span
                                                        class="text-[10px] font-black px-2 py-0.5 rounded-full bg-rose-100 text-rose-600">
                                                        <%= se.total_wrong %> wrong attempts
                                                    </span>
                                                </div>
                                                <!-- Per-machine error breakdown -->
                                                <div class="space-y-1.5">
                                                    <% se.elements.forEach(el=> { %>
                                                        <div class="flex items-center gap-3">
                                                            <div class="flex-shrink-0 w-44 text-left">
                                                                <span
                                                                    class="text-xs font-black text-indigo-700 bg-indigo-100 px-2.5 py-1 rounded-lg inline-flex items-center gap-1.5">
                                                                    <i
                                                                        class="fas fa-microchip text-[10px] text-indigo-500"></i>
                                                                    <%= el.element_symbol || 'Standard Station' %>
                                                                </span>
                                                            </div>
                                                            <div class="flex-1">
                                                                <div class="seq-bar">
                                                                    <div class="seq-bar-fill"
                                                                        style="width:<%= el.error_pct %>%"></div>
                                                                </div>
                                                            </div>
                                                            <div class="flex-shrink-0 text-right w-28">
                                                                <span class="text-[10px] font-black text-rose-600">
                                                                    <%= el.error_pct %>% error
                                                                </span>
                                                                <span class="text-[10px] text-slate-400 ml-1">(<%=
                                                                        el.wrong_count %>/<%= el.total_count %>)</span>
                                                            </div>
                                                        </div>
                                                        <p class="text-[10px] text-slate-400 pl-48 italic">
                                                            <% if (el.error_pct>= 70) { %>
                                                                <i
                                                                    class="fas fa-triangle-exclamation text-rose-400 mr-1"></i>Critical
                                                                Error Rate — high student struggle at this laboratory
                                                                machine station
                                                                <% } else if (el.error_pct>= 40) { %>
                                                                    <i
                                                                        class="fas fa-circle-exclamation text-amber-400 mr-1"></i>Moderate
                                                                    Error Rate — students may need guided orientation on
                                                                    this apparatus
                                                                    <% } else { %>
                                                                        <i
                                                                            class="fas fa-circle-check text-emerald-400 mr-1"></i>Optimal
                                                                        Performance — normal exploratory interaction
                                                                        <% } %>
                                                        </p>
                                                        <% }) %>
                                                </div>
                                            </div>
                                            <% }) %>
                                                <% } else { %>
                                                    <div
                                                        class="flex flex-col items-center justify-center h-32 text-slate-300">
                                                        <i class="fas fa-microchip text-3xl mb-2"></i>
                                                        <p class="text-xs font-bold italic">No machine station errors
                                                            recorded yet</p>
                                                    </div>
                                                    <% } %>
                                </div>
                            </div>

                        </div><!-- /tab-deepdive -->

                        <div class="h-4"></div>
                    </div>

                    <!-- Footer -->
                    <footer class="bg-white border-t border-cyan-100 py-6 px-8 w-full">
                        <div
                            class="flex flex-col md:flex-row justify-between items-center gap-2 max-w-[1600px] mx-auto">
                            <p class="text-[11px] text-indigo-400 font-black uppercase tracking-tight">
                                &copy; 2026 <span class="text-cyan-600">Chemistry Arcade</span> - Mabini College v2.5.0
                            </p>
                            <div class="flex gap-4">
                                <a href="#"
                                    class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest">Support
                                    Lab</a>
                                <a href="#"
                                    class="text-[11px] font-black text-indigo-300 hover:text-cyan-600 transition uppercase tracking-widest border-l pl-4 border-indigo-100">Atomic
                                    Logs</a>
                            </div>
                        </div>
                    </footer>
                </div>
            </main>
    </div>


    <!-- ══ STUDENT PICKER MODAL ══ -->
    <div id="studentPickerModal" class="modal-backdrop">
        <div class="modal-card">
            <div class="modal-header">
                <h3 class="text-sm font-black text-indigo-900">Select Student</h3>
                <button onclick="closeModal('studentPickerModal')"
                    class="w-8 h-8 rounded-full bg-slate-100 hover:bg-red-50 hover:text-red-500 flex items-center justify-center text-slate-500 transition">
                    <i class="fas fa-times text-xs"></i>
                </button>
            </div>
            <div class="modal-body">
                <input type="text" placeholder="Search student..." id="studentSearchInput"
                    oninput="filterStudentPicker()"
                    class="w-full px-3 py-2 border border-slate-200 rounded-lg text-sm outline-none focus:border-indigo-400">
                <div id="studentPickerList" class="space-y-1.5 max-h-64 overflow-y-auto">
                    <% students.forEach(s=> { %>
                        <div class="student-pick-row flex items-center justify-between p-2.5 rounded-xl hover:bg-indigo-50 cursor-pointer border border-transparent hover:border-indigo-200 transition"
                            data-name="<%= s.first_name %> <%= s.last_name %>"
                            onclick="exportStudentReportCard(<%= s.user_id %>)">
                            <div class="flex items-center gap-2">
                                <img src="/profile_uploads/<%= s.profile_pic || 'default_avatar.png' %>"
                                    class="w-8 h-8 rounded-lg object-cover"
                                    onerror="this.src='/profile_uploads/default_avatar.png'">
                                <span class="text-sm font-bold text-indigo-900">
                                    <%= s.last_name %>, <%= s.first_name %>
                                </span>
                            </div>
                            <i class="fas fa-file-pdf text-rose-400 text-xs"></i>
                        </div>
                        <% }) %>
                            <% if (!students.length) { %>
                                <p class="text-center py-4 text-slate-300 text-xs italic font-bold">No students. Select
                                    a class first.</p>
                                <% } %>
                </div>
            </div>
        </div>
    </div>



    <!-- ═══════════════════════════════════════════════ -->
    <!-- EXPORT REPORT CARDS MODAL (BATCH & INDIVIDUAL)          -->
    <!-- ═══════════════════════════════════════════════════════ -->
    <div id="reportCardExportModal" class="modal-backdrop">
        <div class="modal-card" style="max-width: 640px;">
            <div class="modal-header">
                <div class="flex items-center gap-3">
                    <div
                        class="w-9 h-9 rounded-xl bg-rose-100 flex items-center justify-center text-rose-600 font-bold">
                        <i class="fas fa-id-card"></i>
                    </div>
                    <div>
                        <h3 id="rcModalTitle" class="text-sm font-black text-indigo-900">Export Batch Class Report Cards
                            — PDF</h3>
                        <p id="rcModalSubtitle" class="text-[10px] text-slate-400 font-bold">Configure curriculum
                            components and filters before generating</p>
                    </div>
                </div>
                <button onclick="closeModal('reportCardExportModal')"
                    class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-rose-100 hover:text-rose-500 flex items-center justify-center transition text-slate-500">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>

            <!-- Hidden State Trackers -->
            <input type="hidden" id="rcExportMode" value="batch">
            <input type="hidden" id="rcTargetStudentId" value="">
            <input type="hidden" id="rcClassId" value="<%= selectedClassId || '' %>">

            <div class="modal-body space-y-4">
                <!-- Active Class Baseline Indicator -->
                <div
                    class="bg-indigo-50/70 border border-indigo-200/80 rounded-xl p-3 flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                        <div
                            class="w-7 h-7 rounded-lg bg-indigo-600 text-white flex items-center justify-center text-xs">
                            <i class="fas fa-chalkboard-user"></i>
                        </div>
                        <div>
                            <span class="text-[9px] font-black text-indigo-600 uppercase tracking-wider block">Target
                                Class Scope</span>
                            <p id="rcModalClassName" class="text-xs font-black text-indigo-950">
                                <% const selCls=classes.find(c=> String(c.class_id) === String(selectedClassId)); %>
                                    <%= selCls ? `${selCls.class_name} — ${selCls.subject_name}` : 'No Class Selected'
                                        %>
                            </p>
                        </div>
                    </div>
                    <span id="rcModalStudentBadge" style="display:none;"
                        class="text-[10px] font-black px-2 py-0.5 rounded-full bg-rose-100 text-rose-700 border border-rose-200">
                        Single Student
                    </span>
                </div>

                <!-- Quarter Selection -->
                <div class="flex flex-col gap-1.5">
                    <label class="form-label text-xs font-bold text-slate-700">
                        <i class="fas fa-layer-group text-indigo-500 mr-1"></i> Quarter Filter
                    </label>
                    <select id="rcQuarterFilter" class="form-select text-xs font-semibold"
                        onchange="onRcQuarterChange()">
                        <option value="">All Quarters (Full Academic Year)</option>
                        <option value="1">Quarter 1</option>
                        <option value="2">Quarter 2</option>
                        <option value="3">Quarter 3</option>
                        <option value="4">Quarter 4</option>
                    </select>
                </div>

                <!-- Component Checkboxes Header -->
                <div class="pt-2 border-t border-slate-100">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[11px] font-black uppercase text-indigo-900 tracking-wider">
                            Curriculum Components to Include
                        </span>
                        <span class="text-[10px] text-slate-400">Select components to reveal sub-filters</span>
                    </div>

                    <div class="space-y-3">
                        <!-- 1. ASSESSMENT COMPONENT -->
                        <div class="border border-slate-200 rounded-xl p-3 bg-white transition hover:border-indigo-300">
                            <label
                                class="flex items-center gap-2 cursor-pointer font-bold text-xs text-indigo-950 select-none">
                                <input type="checkbox" id="rcCompAssessment"
                                    class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500"
                                    onchange="toggleRcSubFilter('rcSubAssessment', this.checked)" checked>
                                <span class="flex items-center gap-1.5">
                                    <i class="fas fa-clipboard-check text-cyan-600"></i> Assessments
                                </span>
                                <span class="text-[10px] font-normal text-slate-400 ml-auto">Quizzes, Pre/Post Tests,
                                    Competitive</span>
                            </label>
                            <!-- Assessment Sub-filters -->
                            <div id="rcSubAssessment" class="mt-3 pt-3 border-t border-slate-100 space-y-2.5">
                                <div class="grid grid-cols-1 sm:grid-cols-3 gap-2">
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 block mb-1">Topic</label>
                                        <select id="rcAsmtTopic" class="form-select text-xs">
                                            <option value="">All Topics</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 block mb-1">Assessment
                                            Type</label>
                                        <select id="rcAsmtType" class="form-select text-xs">
                                            <option value="">All Types</option>
                                            <option value="Pre-Test">Pre-Test</option>
                                            <option value="Post-Test">Post-Test</option>
                                            <option value="Quiz">Quiz</option>
                                            <option value="Competitive">Competitive</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 block mb-1">Status</label>
                                        <select id="rcAsmtStatus" class="form-select text-xs">
                                            <option value="both">Both (Passed &amp; Failed)</option>
                                            <option value="passed">Passed Only</option>
                                            <option value="failed">Failed Only</option>
                                            <option value="not_taken">Not Yet Taken</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 2. ASSIGNMENT COMPONENT -->
                        <div class="border border-slate-200 rounded-xl p-3 bg-white transition hover:border-indigo-300">
                            <label
                                class="flex items-center gap-2 cursor-pointer font-bold text-xs text-indigo-950 select-none">
                                <input type="checkbox" id="rcCompAssignment"
                                    class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500"
                                    onchange="toggleRcSubFilter('rcSubAssignment', this.checked)" checked>
                                <span class="flex items-center gap-1.5">
                                    <i class="fas fa-file-pen text-emerald-600"></i> Assignments
                                </span>
                                <span class="text-[10px] font-normal text-slate-400 ml-auto">Laboratory Tasks, Homework,
                                    Problem Sets</span>
                            </label>
                            <!-- Assignment Sub-filters -->
                            <div id="rcSubAssignment" class="mt-3 pt-3 border-t border-slate-100 space-y-2.5">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 block mb-1">Topic</label>
                                        <select id="rcAsgnTopic" class="form-select text-xs">
                                            <option value="">All Topics</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 block mb-1">Assignment
                                            Mode</label>
                                        <select id="rcAsgnMode" class="form-select text-xs">
                                            <option value="">All Modes</option>
                                            <option value="individual">Individual Only</option>
                                            <option value="group">Group Only</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 3. FORUMS COMPONENT -->
                        <div class="border border-slate-200 rounded-xl p-3 bg-white transition hover:border-indigo-300">
                            <label
                                class="flex items-center gap-2 cursor-pointer font-bold text-xs text-indigo-950 select-none">
                                <input type="checkbox" id="rcCompForums"
                                    class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500"
                                    onchange="toggleRcSubFilter('rcSubForums', this.checked)" checked>
                                <span class="flex items-center gap-1.5">
                                    <i class="fas fa-comments text-purple-600"></i> Forums
                                </span>
                                <span class="text-[10px] font-normal text-slate-400 ml-auto">Discussion Prompts &amp;
                                    Submissions</span>
                            </label>
                            <!-- Forums Sub-filters -->
                            <div id="rcSubForums" class="mt-3 pt-3 border-t border-slate-100 space-y-2.5">
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 block mb-1">Topic</label>
                                        <select id="rcForumTopic" class="form-select text-xs">
                                            <option value="">All Topics</option>
                                        </select>
                                    </div>
                                    <div>
                                        <label class="text-[10px] font-bold text-slate-500 block mb-1">Forum
                                            Completion</label>
                                        <select id="rcForumDone" class="form-select text-xs">
                                            <option value="">All (Done &amp; Not Done)</option>
                                            <option value="done">Done (Completed)</option>
                                            <option value="not_done">Not Done (Pending)</option>
                                        </select>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- 4. SIMULATION QUIZ COMPONENT -->
                        <div class="border border-slate-200 rounded-xl p-3 bg-white transition hover:border-indigo-300">
                            <label
                                class="flex items-center gap-2 cursor-pointer font-bold text-xs text-indigo-950 select-none">
                                <input type="checkbox" id="rcCompSimQuiz"
                                    class="w-4 h-4 rounded text-indigo-600 focus:ring-indigo-500"
                                    onchange="toggleRcSubFilter('rcSubSimQuiz', this.checked)" checked>
                                <span class="flex items-center gap-1.5">
                                    <i class="fas fa-flask-vial text-amber-500"></i> Simulation Quiz
                                </span>
                                <span class="text-[10px] font-normal text-slate-400 ml-auto">Elementa In-Simulation
                                    Quizzes (20 Sims)</span>
                            </label>
                            <!-- Simulation Quiz Sub-filters -->
                            <div id="rcSubSimQuiz" class="mt-3 pt-3 border-t border-slate-100 space-y-2.5">
                                <div class="flex items-center justify-between">
                                    <div class="flex items-center gap-2">
                                        <input type="checkbox" id="rcSimSelectAll"
                                            class="w-3.5 h-3.5 rounded text-amber-600 focus:ring-amber-500"
                                            onchange="toggleAllSimulationCheckboxes(this.checked)" checked>
                                        <label for="rcSimSelectAll"
                                            class="text-xs font-bold text-slate-700 cursor-pointer">Select All (20
                                            Simulations)</label>
                                    </div>
                                    <div class="flex items-center gap-1.5">
                                        <label class="text-[10px] font-bold text-slate-500">Status:</label>
                                        <select id="rcSimStatus" class="form-select text-xs py-1">
                                            <option value="">All</option>
                                            <option value="passed">Passed</option>
                                            <option value="failed">Failed</option>
                                        </select>
                                    </div>
                                </div>

                                <!-- 20 Simulations Grid -->
                                <div class="grid grid-cols-1 sm:grid-cols-2 gap-1.5 max-h-40 overflow-y-auto p-2 rounded-lg bg-slate-50 border border-slate-200 text-xs"
                                    id="rcSimulationsList">
                                    <!-- Populated dynamically by initSimulationCheckboxes() -->
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="modal-footer">
                <button onclick="closeModal('reportCardExportModal')" class="btn btn-outline">Cancel</button>
                <button onclick="executeReportCardExport()" class="btn btn-rose font-bold">
                    <i class="fas fa-file-pdf"></i> Generate PDF
                </button>
            </div>
        </div>
    </div>

