            function applyGradebookWeightPreset(asmt, asgn, forum, sim, syllabus, lms, att) {
                document.getElementById('gbWeightAsmt').value = asmt;
                document.getElementById('gbWeightAsgn').value = asgn;
                document.getElementById('gbWeightForum').value = forum;
                document.getElementById('gbWeightSim').value = sim;
                document.getElementById('gbWeightSyllabus').value = syllabus;
                document.getElementById('gbWeightLms').value = lms;
                document.getElementById('gbWeightAtt').value = att;
                updateGradebookWeightTotals();
            }

            function updateGradebookWeightTotals() {
                const wAsmt = Math.max(0, Number(document.getElementById('gbWeightAsmt')?.value || 0));
                const wAsgn = Math.max(0, Number(document.getElementById('gbWeightAsgn')?.value || 0));
                const wForum = Math.max(0, Number(document.getElementById('gbWeightForum')?.value || 0));
                const wSim = Math.max(0, Number(document.getElementById('gbWeightSim')?.value || 0));
                const wSyllabus = Math.max(0, Number(document.getElementById('gbWeightSyllabus')?.value || 0));
                const lmsTotal = Math.round((wAsmt + wAsgn + wForum + wSim + wSyllabus) * 100) / 100;

                const wLms = Math.max(0, Number(document.getElementById('gbWeightLms')?.value || 0));
                const wAtt = Math.max(0, Number(document.getElementById('gbWeightAtt')?.value || 0));
                const finalTotal = Math.round((wLms + wAtt) * 100) / 100;

                const lmsBadge = document.getElementById('gbLmsWeightTotalBadge');
                if (lmsBadge) {
                    lmsBadge.textContent = `Total: ${lmsTotal}%`;
                    lmsBadge.className = lmsTotal === 100
                        ? 'text-[11px] font-black px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-200 flex-shrink-0'
                        : 'text-[11px] font-black px-2.5 py-1 rounded-full bg-rose-100 text-rose-700 border border-rose-200 flex-shrink-0';
                }

                const finalBadge = document.getElementById('gbFinalWeightTotalBadge');
                if (finalBadge) {
                    finalBadge.textContent = `Total: ${finalTotal}%`;
                    finalBadge.className = finalTotal === 100
                        ? 'text-[11px] font-black px-2.5 py-1 rounded-full bg-emerald-100 text-emerald-700 border border-emerald-200 flex-shrink-0'
                        : 'text-[11px] font-black px-2.5 py-1 rounded-full bg-rose-100 text-rose-700 border border-rose-200 flex-shrink-0';
                }

                const previewLms = document.getElementById('gbFormulaPreviewLms');
                if (previewLms) {
                    const lmsParts = [];
                    if (wAsmt > 0) lmsParts.push(`(${wAsmt}% × Assessments)`);
                    if (wAsgn > 0) lmsParts.push(`(${wAsgn}% × Assignments)`);
                    if (wForum > 0) lmsParts.push(`(${wForum}% × Forums)`);
                    if (wSim > 0) lmsParts.push(`(${wSim}% × Simulations)`);
                    if (wSyllabus > 0) lmsParts.push(`(${wSyllabus}% × Syllabus)`);
                    previewLms.textContent = `LMS Avg = ${lmsParts.length > 0 ? lmsParts.join(' + ') : '0%'}`;
                }

                const previewFinal = document.getElementById('gbFormulaPreviewFinal');
                if (previewFinal) {
                    const finalParts = [];
                    if (wLms > 0) finalParts.push(`(${wLms}% × LMS Avg)`);
                    if (wAtt > 0) finalParts.push(`(${wAtt}% × Attendance)`);
                    previewFinal.textContent = `Final Grade = ${finalParts.length > 0 ? finalParts.join(' + ') : '0%'}`;
                }

                const errBox = document.getElementById('gbWeightValidationError');
                const errText = document.getElementById('gbWeightValidationErrorText');
                if (lmsTotal !== 100 || finalTotal !== 100) {
                    if (errBox) errBox.style.display = 'flex';
                    if (errText) {
                        errText.textContent = `Part 1 (LMS Avg) total is ${lmsTotal}% and Part 2 (Final Grade) total is ${finalTotal}%. Both sections must add up to 100%.`;
                    }
                    return false;
                } else {
                    if (errBox) errBox.style.display = 'none';
                    return true;
                }
            }

