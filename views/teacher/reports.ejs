            <div id="filterGroupGrade" style="display:none" class="flex flex-col gap-1.5">
                <label class="form-label"><i class="fas fa-school text-rose-500 mr-1"></i> Grade Level</label>
                <select id="filterGrade" class="form-select">
                    <option value="">All Grade Levels</option>
                    <option value="Grade 11">Grade 11</option>
                    <option value="Grade 12">Grade 12</option>
                </select>
                <p class="text-[10px] text-slate-400 font-bold">Filters by <code>users.grade_level</code></p>
            </div>

            <!-- Section — class-list only (free text, matches users.section) -->
            <div id="filterGroupSection" style="display:none" class="flex flex-col gap-1.5">
                <label class="form-label"><i class="fas fa-users text-violet-500 mr-1"></i> Section</label>
                <input id="filterSection" type="text" class="form-select" placeholder="e.g. STEM-A, Block 1 (leave blank for all)">
