            async function loadRcTopics(classId, quarter) {
                if (!classId) return;
                try {
                    const res = await fetch(`/teacher/api/reports/topics-filter-data?class_id=${encodeURIComponent(classId)}&quarter=${encodeURIComponent(quarter || '')}`);
                    if (!res.ok) return;
                    const data = await res.json();
                    if (data.success) {
                        populateTopicDropdown('rcAsmtTopic', data.assessmentTopics);
                        populateTopicDropdown('rcAsgnTopic', data.assignmentTopics);
                        populateTopicDropdown('rcForumTopic', data.forumTopics);
                    }
                } catch (err) {
                    console.warn('[loadRcTopics] Failed to load topic options:', err);
                }
            }

            function populateTopicDropdown(selectId, topics) {
                const sel = document.getElementById(selectId);
                if (!sel) return;
                const currentVal = sel.value;
                sel.innerHTML = '<option value="">All Topics</option>' +
                    (topics || []).map(t => `<option value="${t.topic_id}">${t.topic_name}</option>`).join('');
                if (currentVal && Array.from(sel.options).some(o => o.value === currentVal)) {
                    sel.value = currentVal;
                }
            }

