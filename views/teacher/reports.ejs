<div id="exportFilterModal" class="modal-backdrop">
    <div class="modal-card" style="max-width:480px">
        <div class="modal-header">
            <div class="flex items-center gap-3">
                <div class="w-9 h-9 rounded-xl bg-indigo-100 flex items-center justify-center">
                    <i class="fas fa-sliders text-indigo-600 text-sm"></i>
                </div>
                <div>
                    <p id="exportModalTitle" class="text-sm font-black text-indigo-900">Export Document</p>
                    <p class="text-[10px] text-slate-400 font-bold">Apply filters before exporting</p>
                </div>
            </div>
            <button onclick="closeModal('exportFilterModal')" class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-rose-100 hover:text-rose-500 flex items-center justify-center transition text-slate-500">
                <i class="fas fa-times text-sm"></i>
            </button>
        </div>

        <input type="hidden" id="exportModalType">
