    <!-- EXPORT FILTER MODAL                            -->
    <!-- ══════════════════════════════════════════════ -->
    <div id="exportFilterModal" class="modal-backdrop">
        <div class="modal-card" style="max-width:560px">
            <div class="modal-header">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-indigo-100 flex items-center justify-center">
                        <i class="fas fa-sliders text-indigo-600 text-sm"></i>
                    </div>
                    <div>
                        <p id="exportModalTitle" class="text-sm font-black text-indigo-900">Export Document</p>
                        <p id="exportModalSubtitle" class="text-[10px] text-slate-400 font-bold">Apply filters before
                            exporting</p>
                    </div>
                </div>
                <button onclick="closeModal('exportFilterModal')"
                    class="w-8 h-8 rounded-xl bg-slate-100 hover:bg-rose-100 hover:text-rose-500 flex items-center justify-center transition text-slate-500">
                    <i class="fas fa-times text-sm"></i>
                </button>
            </div>

            <input type="hidden" id="exportModalType">
            <input type="hidden" id="exportModalFormat">
            <input type="hidden" id="exportClassListActiveTab" value="classList">
            <input type="hidden" id="exportModalClassId" value="<%= selectedClassId || 'all' %>">

            <div class="modal-body space-y-4">

                <!-- Active Baseline Indicator (Visible for Class List & Attendance exports) -->
                <div id="exportModalClassBaselineCard" style="display:none;"
                    class="bg-gradient-to-r from-indigo-50/90 via-sky-50/70 to-indigo-50/90 border border-indigo-200/80 rounded-xl p-3.5 shadow-sm space-y-2">
                    <div class="flex items-center justify-between gap-3">
                        <div class="flex items-center gap-2.5">
                            <div
                                class="w-8 h-8 rounded-lg bg-indigo-600 text-white flex items-center justify-center font-bold text-xs shadow-sm flex-shrink-0">
                                <i id="exportModalBaselineIcon" class="fas fa-layer-group"></i>
                            </div>
                            <div>
                                <div class="flex items-center gap-1.5">
                                    <span id="exportModalBaselineHeaderLabel"
                                        class="text-[10px] font-black text-indigo-700 uppercase tracking-wider">Active
                                        Baseline Scope</span>
                                    <span id="exportModalBaselineBadge"
                                        class="text-[9px] font-extrabold bg-indigo-100 text-indigo-700 px-1.5 py-0.5 rounded-full border border-indigo-200 flex items-center gap-1">
                                        <i class="fas fa-lock text-[8px]"></i> Inherited from Active Filter
                                    </span>
                                </div>
                                <p id="exportModalActiveClassName" class="text-xs font-black text-indigo-950 mt-0.5">
                                    <% const activeClassObj=classes.find(c=> String(c.class_id) ===
                                        String(selectedClassId));
                                        %>
                                        <%= activeClassObj ? `${activeClassObj.class_name} —
                                            ${activeClassObj.subject_name}` : 'All My Classes (Multi-Class Export)' %>
                                </p>
                            </div>
                        </div>
                        <div class="text-right flex-shrink-0">
                            <span class="text-[9px] font-bold text-slate-400 uppercase tracking-tight block">Scope
                                Status</span>
                            <span id="exportModalClassScopeBadge"
                                class="text-[11px] font-black text-emerald-600 flex items-center justify-end gap-1">
                                <i class="fas fa-check-circle text-[10px]"></i> Locked to Class
                            </span>
                        </div>
                    </div>
                    <!-- Explanatory note inside baseline card -->
                    <p id="exportModalBaselineNote"
                        class="text-[11px] text-indigo-800 font-medium leading-relaxed pt-2 border-t border-indigo-100">
                        All filters configured below will narrow down records strictly within this scope.
                    </p>
                </div>

                <!-- Modal Tab Bar (visible ONLY for class-list exports) -->
                <div id="exportModalTabBar" style="display:none;" class="flex border-b border-slate-200">
                    <button type="button" id="modalTabBtnClassList" onclick="switchExportModalTab('classList')"
                        class="px-4 py-2 text-xs font-bold border-b-2 border-indigo-600 text-indigo-600 transition flex items-center gap-1.5">
                        <i class="fas fa-list-ol"></i> Class List &amp; Metrics
                    </button>
                    <button type="button" id="modalTabBtnAttendance" onclick="switchExportModalTab('attendance')"
                        class="px-4 py-2 text-xs font-bold text-slate-400 hover:text-slate-600 border-b-2 border-transparent transition flex items-center gap-1.5">
                        <i class="fas fa-calendar-check"></i> Attendance Records
                    </button>
                </div>

                <!-- ============================================== -->
                <!-- TAB PANEL 1: CLASS LIST & PERFORMANCE FILTERS  -->
                <!-- ============================================== -->
                <div id="panelExportClassList" style="display:none;" class="space-y-3">
                    <!-- Demographics Filter: Sex (Male, Female, All) -->
                    <div class="flex flex-col gap-1">
                        <label class="form-label text-xs"><i class="fas fa-venus-mars text-pink-500 mr-1"></i> Student
                            Sex</label>
                        <select id="filterSex" class="form-select text-xs">
                            <option value="">All Students (Male &amp; Female)</option>
                            <option value="Male">Male Only</option>
                            <option value="Female">Female Only</option>
                        </select>
                    </div>

                    <!-- Academic Performance Metric Filters (Grid) -->
                    <div class="pt-2 border-t border-slate-100">
                        <p
                            class="text-[11px] font-black uppercase text-indigo-900 tracking-wider mb-2 flex items-center gap-1.5">
                            <i class="fas fa-chart-line text-cyan-600"></i> Performance Metric Filters
                        </p>

                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                            <!-- Overall Mastery -->
                            <div class="flex flex-col gap-1">
                                <label class="form-label text-[11px]">Overall Mastery</label>
                                <select id="filterMasteryBracket" class="form-select text-xs">
                                    <option value="">All Mastery Levels</option>
                                    <option value="mastery">Mastery (&ge;90%)</option>
                                    <option value="proficient">Proficient (80%–89%)</option>
                                    <option value="approaching">Approaching (75%–79%)</option>
                                    <option value="intervention">Developing / Needs Intervention (&lt;75%)</option>
                                </select>
                            </div>

                            <!-- Assessment Average (Quizzes & Tests) -->
                            <div class="flex flex-col gap-1">
                                <label class="form-label text-[11px] text-cyan-700">Assessment Average</label>
                                <select id="filterAsmtBracket" class="form-select text-xs">
                                    <option value="">All Assessment Scores</option>
                                    <option value="intervention">⚠️ Needs Academic Intervention (&lt;75%)</option>
                                    <option value="passing">Passing &amp; Above (&ge;75%)</option>
                                    <option value="mastery">High Performing / Mastery (&ge;90%)</option>
                                </select>
                            </div>

                            <!-- Assignment Average (Tasks & Labs) -->
                            <div class="flex flex-col gap-1">
                                <label class="form-label text-[11px] text-emerald-700">Assignment Average</label>
                                <select id="filterAsgnBracket" class="form-select text-xs">
                                    <option value="">All Assignment Scores</option>
                                    <option value="intervention">⚠️ Needs Intervention (&lt;75%)</option>
                                    <option value="passing">Passing &amp; Above (&ge;75%)</option>
                                    <option value="mastery">High Performing / Mastery (&ge;90%)</option>
                                </select>
                            </div>

                            <!-- Forums Completed -->
                            <div class="flex flex-col gap-1">
                                <label class="form-label text-[11px] text-purple-700">Forums Completed</label>
                                <select id="filterForumStatus" class="form-select text-xs">
                                    <option value="">All Forum Statuses</option>
                                    <option value="none">Zero Completed (0%)</option>
                                    <option value="partial">Partially Completed (&gt;0% and &lt;100%)</option>
                                    <option value="completed">Fully Accomplished (100%)</option>
                                </select>
                            </div>
                        </div>

                        <!-- Subject EXP -->
                        <div class="flex flex-col gap-1 mt-3">
                            <label class="form-label text-[11px] text-amber-700">Subject EXP Level</label>
                            <select id="filterExpBracket" class="form-select text-xs">
                                <option value="">All EXP Amounts</option>
                                <option value="under_500">Under 500 EXP</option>
                                <option value="500_to_999">500 to 999 EXP</option>
                                <option value="1000_plus">1,000+ EXP</option>
                            </select>
                        </div>
                    </div>
                </div>

                <!-- ============================================== -->
                <!-- TAB PANEL 2: ATTENDANCE CONFIGURATION FILTERS  -->
                <!-- ============================================== -->
                <div id="panelExportAttendance" style="display:none;" class="space-y-3">
                    <!-- Attendance Source Selector -->
                    <div class="flex flex-col gap-1">
                        <label class="form-label text-xs"><i class="fas fa-clipboard-user text-cyan-600 mr-1"></i>
                            Attendance Source</label>
                        <select id="filterAttendanceSource" class="form-select text-xs">
                            <option value="roll_call">Only Roll Call Attendance (Instructor Recorded)</option>
                            <option value="lms">Only LMS Login Data (Platform Activity)</option>
                            <option value="both">Both (Formatted on Separate Pages)</option>
                        </select>
                        <p class="text-[10px] text-slate-400">Selecting 'Both' generates Roll Call pages followed by
                            separate LMS Login activity pages.</p>
                    </div>

                    <!-- Conducted Dates Dropdown -->
                    <div class="flex flex-col gap-1">
                        <label class="form-label text-xs"><i class="far fa-calendar text-indigo-500 mr-1"></i>
                            Attendance Session Date</label>
                        <select id="filterAttendanceDate" class="form-select text-xs">
                            <option value="">All Available Conducted Dates (Default — Page per Date)</option>
                        </select>
                        <p class="text-[10px] text-slate-400">Optional: Leave blank to export all recorded dates. Each
                            date will be displayed on a separate page.</p>
                    </div>

                    <!-- Active Dates Strictness Notice -->
                    <div class="flex items-start gap-2.5 bg-amber-50 border border-amber-200 rounded-xl px-3.5 py-2.5">
                        <i class="fas fa-calendar-check text-amber-600 mt-0.5 text-xs flex-shrink-0"></i>
                        <p class="text-[11px] text-amber-800 leading-relaxed font-semibold">
                            Strict Class Day Integrity: Only dates when attendance was actually recorded by the
                            instructor will be retrieved. Non-class days and dates with no recorded attendance are
                            excluded.
                        </p>
                    </div>
                </div>

                <!-- Legacy / Other document filter groups (preserved for report-card, remediation, etc.) -->
                <!-- Quarter — shown for report-card and remediation -->
                <div id="filterGroupQuarter" style="display:none" class="flex flex-col gap-1.5">
                    <label class="form-label"><i class="fas fa-layer-group text-indigo-400 mr-1"></i> Quarter</label>
                    <select id="filterQuarter" class="form-select">
                        <option value="">All Quarters</option>
                        <option value="1">Quarter 1</option>
                        <option value="2">Quarter 2</option>
                        <option value="3">Quarter 3</option>
                        <option value="4">Quarter 4</option>
                    </select>
                </div>

                <!-- Assessment Type — report-card only -->
                <div id="filterGroupType" style="display:none" class="flex flex-col gap-1.5">
                    <label class="form-label"><i class="fas fa-tag text-cyan-500 mr-1"></i> Assessment Type</label>
                    <select id="filterAssessType" class="form-select">
                        <option value="">All Types</option>
                        <option value="Pre-Test">Pre-Test</option>
                        <option value="Post-Test">Post-Test</option>
                        <option value="Quiz">Quiz</option>
                        <option value="Competitive">Competitive</option>
                    </select>
                </div>

                <!-- Risk Level — remediation only -->
                <div id="filterGroupRisk" style="display:none" class="flex flex-col gap-1.5">
                    <label class="form-label"><i class="fas fa-triangle-exclamation text-amber-500 mr-1"></i> Class Risk
                        Level</label>
                    <select id="filterRisk" class="form-select">
                        <option value="">All Class Risk Levels</option>
                        <option value="high">High Class Risk (≥ 50% At Risk)</option>
                        <option value="moderate">Moderate Class Risk (25% – 49% At Risk)</option>
                        <option value="low">Low Class Risk (< 25% At Risk)</option>
                        <option value="at_risk_only">Topics with Students At Risk (> 0)</option>
                    </select>
                </div>

            </div>

            <div class="modal-footer">
                <button onclick="closeModal('exportFilterModal')" class="btn btn-outline">Cancel</button>
                <button onclick="doExport()" class="btn btn-primary">
                    <i class="fas fa-file-export"></i> Generate Export
                </button>
            </div>
        </div>
    </div>

