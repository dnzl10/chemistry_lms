                <select id="filterRisk" class="form-select">
                    <option value="">All Risk Levels</option>
                    <option value="high">High Risk (5+ wrong answers)</option>
                    <option value="moderate">Moderate (3–4 wrong answers)</option>
                    <option value="low">Low (1–2 wrong answers)</option>
