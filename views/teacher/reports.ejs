            </button>
        </div>
    </div>
</div>


<!-- ════════════════════════════════════ SCRIPTS ════════════════════════════════════ -->
<script>
/* ── Server-injected data for charts ── */
const SCORE_DIST  = <%- JSON.stringify(scoreDistribution || []) %>;
const WIN_LOSS    = <%- JSON.stringify(winLoss || []) %>;
const EXP_GROWTH  = <%- JSON.stringify(expGrowth || {labels:[], datasets:[]}) %>;
const SELECTED_CLASS = '<%= selectedClassId || "" %>';

/* ── Sidebar ── */
function toggleSidebar() {
    const sb = document.getElementById('sidebar');
    const ov = document.getElementById('sidebarOverlay');
    const open = !sb.classList.contains('-translate-x-full');
    sb.classList.toggle('-translate-x-full', open);
    ov.classList.toggle('hidden', open);
}

/* ── Toast ── */
function rpToast(msg, type = 'success') {
    const el = document.getElementById('rp-toast');
    el.textContent = (type === 'success' ? '✓  ' : '✕  ') + msg;
    el.className = 'show ' + type;
    clearTimeout(el._t);
    el._t = setTimeout(() => { el.className = ''; }, 3400);
}

/* ── Tab switching ── */
function switchTab(id, btn) {
    document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
    document.getElementById('tab-' + id).classList.add('active');
    btn.classList.add('active');
    if (id === 'analytics') initCharts();
}

/* ── Class filter ── */
function applyClassFilter() {
    const classId = document.getElementById('classFilter').value;
    const url = new URL(window.location.href);
    if (classId) url.searchParams.set('class_id', classId);
    else url.searchParams.delete('class_id');
    window.location.href = url.toString();
}

/* ── Export document — opens filter modal first ── */
function exportDoc(type, format) {
    document.getElementById('exportModalType').value   = type;
    document.getElementById('exportModalFormat').value = format;

    // Reset all filter groups
    ['filterGroupQuarter','filterGroupType','filterGroupRisk',
     'filterGroupSex','filterGroupGrade','filterGroupSection']
        .forEach(id => document.getElementById(id).style.display = 'none');

    // Reset all filter values
    document.getElementById('filterQuarter').value    = '';
    document.getElementById('filterAssessType').value = '';
    document.getElementById('filterRisk').value       = '';
    document.getElementById('filterSex').value        = '';
    document.getElementById('filterGrade').value      = '';
    document.getElementById('filterSection').value    = '';

    // Show relevant filters per export type
    if (type === 'class-list') {
        // class-list: filter by users.sex, users.grade_level, users.section
        document.getElementById('filterGroupSex').style.display     = 'flex';
        document.getElementById('filterGroupGrade').style.display   = 'flex';
        document.getElementById('filterGroupSection').style.display = 'flex';
    } else if (type === 'report-card' || type === 'report-card-student') {
        // report-card: filter by quarters.quarter_number, assessments.assessment_type
        document.getElementById('filterGroupQuarter').style.display = 'flex';
        document.getElementById('filterGroupType').style.display    = 'flex';
    } else if (type === 'remediation') {
        // remediation: filter by quarters.quarter_number, risk level (aggregated wrong count)
        document.getElementById('filterGroupQuarter').style.display = 'flex';
        document.getElementById('filterGroupRisk').style.display    = 'flex';
    }

    const labels = {
        'class-list'  : 'Class List',
        'remediation' : 'Remediation List',
        'report-card' : 'Report Card',
    };
    document.getElementById('exportModalTitle').textContent =
        `Export ${labels[type] || 'Document'} — ${format.toUpperCase()}`;

    document.getElementById('exportFilterModal').classList.add('open');
}

function doExport() {
    const type    = document.getElementById('exportModalType').value;
    const format  = document.getElementById('exportModalFormat').value;
    const classId = document.getElementById('classFilter').value;

    const params = new URLSearchParams();
    if (classId)                                            params.set('class_id', classId);

    // Only append params that are visible and have a value
    const quarter = document.getElementById('filterQuarter').value;
    const atype   = document.getElementById('filterAssessType').value;
    const risk    = document.getElementById('filterRisk').value;
    const sex     = document.getElementById('filterSex').value;
    const grade   = document.getElementById('filterGrade').value;
    const section = document.getElementById('filterSection').value.trim();

    if (quarter) params.set('quarter',     quarter);
    if (atype)   params.set('type',        atype);
    if (risk)    params.set('risk',        risk);
    if (sex)     params.set('sex',         sex);
    if (grade)   params.set('grade_level', grade);
    if (section) params.set('section',     section);

    let url;
    if (type === 'report-card-student' && _pendingReportStudentId) {
        url = `/teacher/reports/export/report-card/${_pendingReportStudentId}?${params.toString()}`;
        _pendingReportStudentId = null;
    } else {
        url = `/teacher/reports/export/${type}/${format}?${params.toString()}`;
    }

    closeModal('exportFilterModal');
    rpToast('Generating ' + format.toUpperCase() + '…');
    window.open(url, '_blank');
}

function doExport() {
    const type    = document.getElementById('exportModalType').value;
    const format  = document.getElementById('exportModalFormat').value;
    const classId = document.getElementById('classFilter').value;

    const params = new URLSearchParams();
    if (classId)                                               params.set('class_id',    classId);
    if (document.getElementById('filterQuarter').value)        params.set('quarter',      document.getElementById('filterQuarter').value);
    if (document.getElementById('filterAssessType').value)     params.set('type',         document.getElementById('filterAssessType').value);
    if (document.getElementById('filterRisk').value)           params.set('risk',         document.getElementById('filterRisk').value);
    if (document.getElementById('filterStrand').value)         params.set('strand',       document.getElementById('filterStrand').value);
    if (document.getElementById('filterSection').value)        params.set('section',      document.getElementById('filterSection').value);
    if (document.getElementById('filterGrade').value)          params.set('grade_level',  document.getElementById('filterGrade').value);

    const url = `/teacher/reports/export/${type}/${format}?${params.toString()}`;
    closeModal('exportFilterModal');
    rpToast('Generating ' + format.toUpperCase() + '…');
    window.open(url, '_blank');
}

/* ── Student report card export — opens filter modal first ── */
let _pendingReportStudentId = null;
function exportStudentReportCard(studentId) {
    _pendingReportStudentId = studentId;
    closeModal('studentPickerModal');

    document.getElementById('exportModalType').value   = 'report-card-student';
    document.getElementById('exportModalFormat').value = 'pdf';
    document.getElementById('exportModalTitle').textContent = 'Export Report Card — PDF';

    document.getElementById('filterGroupQuarter').style.display = 'flex';
    document.getElementById('filterGroupType').style.display    = 'flex';
    document.getElementById('filterGroupRisk').style.display    = 'none';
    document.getElementById('filterGroupStrand').style.display  = 'none';
    document.getElementById('filterGroupSection').style.display = 'none';
    document.getElementById('filterGroupGrade').style.display   = 'none';

    document.getElementById('exportFilterModal').classList.add('open');
}

function doExport() {
    const type    = document.getElementById('exportModalType').value;
    const format  = document.getElementById('exportModalFormat').value;
    const classId = document.getElementById('classFilter').value;

    const params = new URLSearchParams();
    if (classId)                                               params.set('class_id',    classId);
    if (document.getElementById('filterQuarter').value)        params.set('quarter',      document.getElementById('filterQuarter').value);
    if (document.getElementById('filterAssessType').value)     params.set('type',         document.getElementById('filterAssessType').value);
    if (document.getElementById('filterRisk').value)           params.set('risk',         document.getElementById('filterRisk').value);
    if (document.getElementById('filterStrand').value)         params.set('strand',       document.getElementById('filterStrand').value);
    if (document.getElementById('filterSection').value)        params.set('section',      document.getElementById('filterSection').value);
    if (document.getElementById('filterGrade').value)          params.set('grade_level',  document.getElementById('filterGrade').value);

    let url;
    if (type === 'report-card-student' && _pendingReportStudentId) {
        url = `/teacher/reports/export/report-card/${_pendingReportStudentId}?${params.toString()}`;
        _pendingReportStudentId = null;
    } else {
        url = `/teacher/reports/export/${type}/${format}?${params.toString()}`;
    }

    closeModal('exportFilterModal');
    rpToast('Generating ' + format.toUpperCase() + '…');
    window.open(url, '_blank');
}

/* ── Modal ── */
function openStudentPickerModal() { document.getElementById('studentPickerModal').classList.add('open'); }
function closeModal(id)           { document.getElementById(id).classList.remove('open'); }
document.querySelectorAll('.modal-backdrop').forEach(mb => {
    mb.addEventListener('click', e => { if (e.target === mb) mb.classList.remove('open'); });
});

/* ── Student picker search ── */
function filterStudentPicker() {
    const q = document.getElementById('studentSearchInput').value.toLowerCase();
    document.querySelectorAll('.student-pick-row').forEach(row => {
        row.style.display = row.dataset.name.toLowerCase().includes(q) ? '' : 'none';
    });
}

/* ── Charts (lazy init on tab switch) ── */
let chartsInitialized = false;
function initCharts() {
    if (chartsInitialized) return;
    chartsInitialized = true;

    const fontSettings = { family: "'Plus Jakarta Sans', sans-serif", size: 11 };
    Chart.defaults.font = fontSettings;

    /* Score Distribution Bar Chart */
    const sdCtx = document.getElementById('chartScoreDist');
    if (sdCtx && SCORE_DIST.length) {
        new Chart(sdCtx, {
            type: 'bar',
            data: {
                labels: SCORE_DIST.map(b => b.label),
                datasets: [{
                    label: 'Students',
                    data: SCORE_DIST.map(b => b.count),
                    backgroundColor: SCORE_DIST.map(b => {
                        const mid = parseInt(b.label);
                        return mid >= 90 ? '#6ee7b7' : mid >= 75 ? '#a5b4fc' : mid >= 60 ? '#fde68a' : '#fca5a5';
                    }),
                    borderRadius: 6, borderSkipped: false
                }]
            },
            options: {
                responsive: true, plugins: { legend: { display: false } },
                scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
            }
        });
    }

    /* Win/Loss Pie Chart */
    const wlCtx = document.getElementById('chartWinLoss');
    if (wlCtx && WIN_LOSS.length) {
        const colors = ['#6366f1','#06b6d4','#10b981','#f59e0b','#ef4444','#8b5cf6','#ec4899'];
        new Chart(wlCtx, {
            type: 'doughnut',
            data: {
                labels: WIN_LOSS.map(w => w.first_name + ' ' + w.last_name),
                datasets: [{
                    data: WIN_LOSS.map(w => w.wins),
                    backgroundColor: WIN_LOSS.map((_, i) => colors[i % colors.length]),
                    borderWidth: 2, borderColor: '#fff'
                }]
            },
            options: {
                responsive: true, cutout: '60%',
                plugins: { legend: { display: false } }
            }
        });
    }

    /* EXP Growth Line Chart */
    const egCtx = document.getElementById('chartExpGrowth');
    if (egCtx && EXP_GROWTH.labels && EXP_GROWTH.labels.length) {
        const colors = ['#6366f1','#06b6d4','#10b981','#f59e0b','#ef4444','#8b5cf6'];
        new Chart(egCtx, {
            type: 'line',
            data: {
                labels: EXP_GROWTH.labels,
                datasets: EXP_GROWTH.datasets.map((ds, i) => ({
                    ...ds,
                    borderColor: colors[i % colors.length],
                    backgroundColor: colors[i % colors.length] + '15',
                    borderWidth: 2, tension: 0.4, pointRadius: 3, fill: true
                }))
            },
            options: {
                responsive: true,
                plugins: { legend: { position: 'bottom', labels: { boxWidth: 10, padding: 12 } } },
                scales: { y: { beginAtZero: true } }
            }
        });
    }
}
</script>

<!-- =============================================
     NOTIFICATION PANEL
============================================= -->
<div id="notifPanel" class="fixed top-0 right-0 h-full w-full max-w-sm z-[200] translate-x-full transition-transform duration-300 ease-in-out flex flex-col"
     style="background: linear-gradient(180deg, #0d1a2e 0%, #0f1f38 100%); box-shadow: -8px 0 40px rgba(6,182,212,0.15);">

    <!-- Header -->
    <div class="flex items-center justify-between px-6 py-5 border-b border-white/10 flex-shrink-0">
        <div>
            <h3 class="text-white font-black text-base tracking-tight uppercase italic flex items-center gap-2">
                <i class="fas fa-bell text-cyan-400 text-sm"></i> Notifications
            </h3>
            <p class="text-indigo-400 text-[10px] font-bold uppercase tracking-widest mt-0.5">
                <%= notifications ? notifications.length : 0 %> updates
            </p>
        </div>
        <button onclick="toggleNotifPanel()" class="w-9 h-9 flex items-center justify-center rounded-xl bg-white/5 hover:bg-rose-500/20 text-indigo-300 hover:text-rose-400 transition">
            <i class="fas fa-times text-sm"></i>
        </button>
    </div>

    <!-- Scrollable List -->
    <div class="flex-1 overflow-y-auto no-scrollbar px-4 py-4 space-y-2">
        <% if (notifications && notifications.length > 0) { %>
            <% notifications.forEach(notif => { %>
                <%
                    let href = '#';
                    let iconClass = 'fas fa-bell text-cyan-400';
                    let badgeClass = 'bg-cyan-500/20 text-cyan-300 border-cyan-500/30';
                    let badgeLabel = 'Update';

                    if (notif.notif_type === 'forum_reply') {
                        href = '/teacher/forums#forum-' + notif.link_id;
                        iconClass = 'fas fa-comments text-amber-400';
                        badgeClass = 'bg-amber-500/20 text-amber-300 border-amber-500/30';
                        badgeLabel = 'Forum Reply';
                    } else if (notif.notif_type === 'private_message') {
                        href = '/teacher/messages/' + notif.link_id;
                        iconClass = 'fas fa-envelope text-indigo-400';
                        badgeClass = 'bg-indigo-500/20 text-indigo-300 border-indigo-500/30';
                        badgeLabel = 'Message';
                    } else if (notif.notif_type === 'struggling_student') {
                        href = '/teacher/class/' + notif.link_id + '#students';
                        iconClass = 'fas fa-triangle-exclamation text-rose-400';
                        badgeClass = 'bg-rose-500/20 text-rose-300 border-rose-500/30';
                        badgeLabel = 'Needs Help';
                    } else if (notif.notif_type === 'pending_question') {
                        href = '/teacher/question-bank?q=' + notif.link_id;
                        iconClass = 'fas fa-database text-fuchsia-400';
                        badgeClass = 'bg-fuchsia-500/20 text-fuchsia-300 border-fuchsia-500/30';
                        badgeLabel = 'Review Question';
                    } else if (notif.notif_type === 'upcoming_deadline') {
                        href = '/teacher/class/' + notif.link_id;
                        iconClass = 'fas fa-hourglass-half text-emerald-400';
                        badgeClass = 'bg-emerald-500/20 text-emerald-300 border-emerald-500/30';
                        badgeLabel = 'Deadline Soon';
                    }
                %>
                <a href="<%= href %>"
                   class="flex items-start gap-3 p-3.5 rounded-2xl bg-white/5 hover:bg-white/10 border border-white/5 hover:border-cyan-500/30 transition group cursor-pointer">

                    <div class="flex-shrink-0 mt-0.5">
                        <% if (notif.actor_pic && notif.notif_type !== 'upcoming_deadline') { %>
                            <img src="/profile_uploads/<%= notif.actor_pic %>" class="w-9 h-9 rounded-xl object-cover ring-1 ring-white/10 group-hover:ring-cyan-400/40 transition">
                        <% } else { %>
                            <div class="w-9 h-9 rounded-xl bg-white/10 flex items-center justify-center">
                                <i class="<%= iconClass %> text-sm"></i>
                            </div>
                        <% } %>
                    </div>

                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1 flex-wrap">
                            <span class="text-[9px] font-black uppercase tracking-widest px-2 py-0.5 rounded-lg border <%= badgeClass %>"><%= badgeLabel %></span>
                        </div>
                        <p class="text-white text-[11px] font-bold leading-snug group-hover:text-cyan-300 transition line-clamp-2">
                            <% if (notif.notif_type !== 'upcoming_deadline') { %>
                                <span class="text-cyan-400"><%= notif.actor_name %></span>
                            <% } %>
                            <%= notif.message %>
                        </p>
                        <p class="text-indigo-500 text-[9px] font-bold mt-1 uppercase tracking-widest">
                            <% if (notif.notif_time) { %>
                                <%= new Date(notif.notif_time).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                            <% } else { %>
                                —
                            <% } %>
                        </p>
                    </div>

                    <div class="flex-shrink-0 self-center text-indigo-600 group-hover:text-cyan-400 transition">
                        <i class="fas fa-chevron-right text-[10px]"></i>
                    </div>
                </a>
            <% }) %>
        <% } else { %>
            <div class="flex flex-col items-center justify-center h-full py-20 text-center">
                <div class="w-16 h-16 rounded-3xl bg-white/5 flex items-center justify-center mb-4">
                    <i class="fas fa-bell-slash text-indigo-500 text-2xl"></i>
                </div>
                <p class="text-indigo-400 text-xs font-black uppercase tracking-widest">You're all caught up!</p>
                <p class="text-indigo-600 text-[10px] font-bold mt-1">No new notifications</p>
            </div>
        <% } %>
    </div>
</div>

<!-- Backdrop -->
<div id="notifBackdrop" class="fixed inset-0 bg-indigo-950/50 backdrop-blur-sm z-[199] hidden" onclick="toggleNotifPanel()"></div>

<script>
    function toggleNotifPanel() {
        const panel    = document.getElementById('notifPanel');
        const backdrop = document.getElementById('notifBackdrop');
        const isOpen   = !panel.classList.contains('translate-x-full');
        if (isOpen) {
            panel.classList.add('translate-x-full');
            backdrop.classList.add('hidden');
        } else {
            panel.classList.remove('translate-x-full');
            backdrop.classList.remove('hidden');
        }
    }

    // ── Profile dropdown ──────────────────────────────────
        function toggleProfileDropdown() {
            document.getElementById('profileDropdown').classList.toggle('open');
        }
        // Close when clicking outside
        document.addEventListener('click', function(e) {
            const wrap = document.getElementById('profileDropdownWrap');
            if (wrap && !wrap.contains(e.target)) {
                document.getElementById('profileDropdown').classList.remove('open');
            }
        });
</script>
</body>
</html>
