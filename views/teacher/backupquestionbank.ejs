let _perfCurrentQid = null;

async function loadPerformanceData() {
    try {
        const res = await fetch('/teacher/api/questions/performance-gaps');
        if (!res.ok) throw new Error('Server ' + res.status);
        const data = await res.json();
        renderErrorRankList(data.questions || []);
    } catch(err) {
