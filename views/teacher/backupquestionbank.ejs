function toggleClassGroup(header) {
    const body = header.nextElementSibling;
    const icon = header.querySelector('.fa-chevron-down');
    body.classList.toggle('open');
    if (icon) icon.style.transform = body.classList.contains('open') ? 'rotate(180deg)' : '';
}

/* ─── Remediation ─── */
async function loadRemediations(qid) {
    const container = document.getElementById('remList');
    container.innerHTML = '<p class="text-xs text-slate-400">Loading…</p>';
    try {
        const res = await fetch('/teacher/api/question/' + qid + '/remediations');
        if (!res.ok) throw new Error('Server ' + res.status);
        const data = await res.json();
        const rems = data.remediations || [];
        if (!rems.length) { container.innerHTML = '<p class="text-xs text-slate-400 italic">No interventions added yet.</p>'; return; }
        container.innerHTML = rems.map(r => `
            <div class="rem-card">
                <div class="flex items-start justify-between gap-2">
                    <div class="flex-1">
                        ${r.advice_text ? `<p class="text-sm text-slate-700 font-medium mb-1">${escHtml(r.advice_text)}</p>` : ''}
                        ${r.material_title ? `<p class="text-xs text-indigo-600 mt-1"><i class="fas fa-file mr-1"></i>${escHtml(r.material_title)}</p>` : ''}
                        ${r.link_url ? `<a href="${escHtml(r.link_url)}" target="_blank" class="text-xs text-cyan-600 mt-1 block break-all"><i class="fas fa-link mr-1"></i>${escHtml(r.link_url)}</a>` : ''}
                        <p class="text-[10px] text-slate-400 mt-2"><i class="fas fa-calendar mr-1"></i>Added ${new Date(r.created_at).toLocaleDateString('en-PH', {year:'numeric',month:'short',day:'numeric'})}</p>
                    </div>
                    <button onclick="deleteRemediation(${r.rem_id})" class="btn btn-danger btn-sm flex-shrink-0" style="padding:3px 7px"><i class="fas fa-trash text-xs"></i></button>
                </div>
                ${r.preview_json ? renderPreviewJson(r.preview_json) : ''}
            </div>`).join('');
    } catch(err) { container.innerHTML = `<p class="text-xs text-rose-400">Error: ${escHtml(err.message)}</p>`; }
}

function renderPreviewJson(jsonStr) {
    try {
        const p = typeof jsonStr === 'string' ? JSON.parse(jsonStr) : jsonStr;
        if (!p || !p.title) return '';
        return `<div class="flex items-center gap-3 mt-2 p-2 bg-white rounded-lg border border-slate-100">
            ${p.image ? `<img src="${escHtml(p.image)}" style="width:56px;height:40px;object-fit:cover;border-radius:5px;flex-shrink:0" onerror="this.style.display='none'">` : ''}
            <div><p class="text-xs font-semibold text-slate-700 truncate">${escHtml(p.title)}</p><p class="text-[10px] text-slate-400 truncate">${escHtml(p.url || '')}</p></div>
        </div>`;
    } catch(e) { return ''; }
}

async function saveRemediation() {
    if (!_perfCurrentQid) return;
    const advice      = document.getElementById('remAdvice').value.trim();
    const materialId  = document.getElementById('remMaterial').value   || null;
    const linkUrl     = document.getElementById('remLinkUrl').value.trim() || null;

    if (!advice && !materialId && !linkUrl) { qbToast('Please enter advice, a material, or a link.', 'error'); return; }

    let previewJson = null;
    if (linkUrl) {
        previewJson = JSON.stringify({ url: linkUrl, title: linkUrl, image: `https://www.google.com/s2/favicons?domain=${encodeURIComponent(linkUrl)}&sz=64` });
    }

    try {
        const res = await fetch('/teacher/api/question/' + _perfCurrentQid + '/remediation', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ advice_text: advice || null, material_id: materialId, link_url: linkUrl, preview_json: previewJson })
        });
        if (!res.ok) throw new Error('Server ' + res.status);
        qbToast('Intervention saved.', 'success');
        document.getElementById('remAdvice').value   = '';
        document.getElementById('remMaterial').value = '';
        document.getElementById('remLinkUrl').value  = '';
        document.getElementById('remLinkPreview').style.display = 'none';
        loadRemediations(_perfCurrentQid);
    } catch(err) { qbToast('Save failed: ' + err.message, 'error'); }
}

async function deleteRemediation(remId) {
    if (!confirm('Remove this intervention?')) return;
    try {
        const res = await fetch('/teacher/api/remediation/' + remId, { method: 'DELETE' });
        if (!res.ok) throw new Error('Server ' + res.status);
        qbToast('Intervention removed.', 'success');
        loadRemediations(_perfCurrentQid);
    } catch(err) { qbToast('Delete failed: ' + err.message, 'error'); }
}

let _remLinkDebounce = null;
function previewRemLink(url) {
    clearTimeout(_remLinkDebounce);
    if (!url) { document.getElementById('remLinkPreview').style.display = 'none'; return; }
    _remLinkDebounce = setTimeout(() => {
        const preview = document.getElementById('remLinkPreview');
        const thumb   = document.getElementById('remLinkThumb');
        const title   = document.getElementById('remLinkTitle');
        const urlEl   = document.getElementById('remLinkUrl2');
        preview.style.display = '';
        try {
            const hostname = new URL(url).hostname;
            thumb.src  = `https://www.google.com/s2/favicons?domain=${encodeURIComponent(hostname)}&sz=64`;
            title.textContent = hostname;
            urlEl.textContent = url;
        } catch(e) { title.textContent = url; urlEl.textContent = ''; }
    }, 600);
}

// Material preview on select change
document.getElementById('remMaterial').addEventListener('change', function() {
    const val = this.value;
    const box = document.getElementById('remMatPreview');
    const txt = document.getElementById('remMatPreviewText');
    if (!val) { box.style.display = 'none'; return; }
    const opt = this.options[this.selectedIndex];
    box.style.display = '';
    txt.textContent   = opt.text;
});


/* ─── Init ─── */
applyFilters();
</script>
