                            </td>
                            <td>
                                <p class="font-medium text-slate-600">${escHtml(r.assessment_name || '—')}</p>
                                <span style="background:#ede9fe;color:#5b21b6;padding:1px 6px;border-radius:9999px;font-size:10px;font-weight:700">${escHtml(r.assessment_type || '')}</span>
                            </td>
                            <td>
                                <span class="font-bold ${r.is_correct ? 'text-emerald-600' : 'text-rose-600'}" style="background:${r.is_correct ? '#dcfce7' : '#fee2e2'};padding:2px 8px;border-radius:6px;font-size:12px">
