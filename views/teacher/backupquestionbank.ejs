<!-- ================================================================
     SCRIPTS
================================================================ -->
<script>

/* ─── Sidebar ─── */
function toggleSidebar() {
    const sb  = document.getElementById('sidebar');
    const ov  = document.getElementById('sidebarOverlay');
    const open = !sb.classList.contains('-translate-x-full');
    sb.classList.toggle('-translate-x-full', open);
    ov.classList.toggle('hidden', open);
}

/* ─── Toast ─── */
function qbToast(msg, type = 'success') {
    const el = document.getElementById('qb-toast');
    el.textContent = (type === 'success' ? '✓  ' : '✕  ') + msg;
    el.className = 'show ' + type;
    clearTimeout(el._t);
    el._t = setTimeout(() => { el.className = ''; }, 3200);
}

/* ─── escHtml ─── */
function escHtml(str) {
    return String(str || '').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

/* ─── AI Panel toggle ─── */
function toggleAiPanel() {
    const p = document.getElementById('aiPanel');
    const c = document.getElementById('aiChevron');
    const open = p.style.display !== 'none';
    p.style.display = open ? 'none' : 'block';
    c.className = open ? 'fas fa-chevron-down text-xs' : 'fas fa-chevron-up text-xs';
}

/* ─── AI Generate ─── */
async function runAiGenerate() {
    const materialId = document.getElementById('aiSourceMaterial').value;
    const topicId    = document.getElementById('aiTopicId').value;
    const count      = parseInt(document.getElementById('aiCount').value) || 5;
    const difficulty = document.getElementById('aiDifficulty').value;
    const mechanic   = document.getElementById('aiMechanic').value;
    const inputMode  = document.getElementById('aiInputMode').value;
    const baseExp    = parseInt(document.getElementById('aiBaseExp').value) || 100;
    const timeLimit  = parseInt(document.getElementById('aiTimeLimit').value) || 30;

    if (!topicId) { qbToast('Please select a topic first.', 'error'); return; }
    if (count < 1 || count > 20) { qbToast('Count must be between 1 and 20.', 'error'); return; }

    /* Show loader */
    document.getElementById('aiLoader').classList.add('active');
    document.getElementById('aiActionRow').style.display = 'none';

    try {
        const res = await fetch('/teacher/api/generate-questions', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                topic_id:     topicId,      // ← WAS: tid (undefined)
                material_id:  materialId,   // ← WAS: mid (undefined)
                count:        count,        // ← WAS: num_questions (wrong field name)
                difficulty:   difficulty,
                mechanic_type: mechanic,
                input_mode:   inputMode,
                base_exp:     baseExp,
                time_limit:   timeLimit
            })
        });
        if (!res.ok) throw new Error('Server ' + res.status);
        const data = await res.json();
        qbToast(data.inserted + ' questions generated and saved!', 'success');
        setTimeout(() => location.reload(), 1500);
    } catch(err) {
        qbToast('Generation failed: ' + err.message, 'error');
    } finally {
        document.getElementById('aiLoader').classList.remove('active');
        document.getElementById('aiActionRow').style.display = 'flex';
    }
}

/* ─── Filter state ─── */
let activeDiff   = '';
let activeAiFlag = '';

function setDiffFilter(btn) {
    document.querySelectorAll('[data-diff]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeDiff = btn.dataset.diff;
    applyFilters();
}

function setAiFilter(btn) {
    document.querySelectorAll('[data-ai]').forEach(b => b.classList.remove('active'));
    btn.classList.add('active');
    activeAiFlag = btn.dataset.ai !== undefined ? btn.dataset.ai : '';
    applyFilters();
}

function clearFilters() {
    document.getElementById('qSearch').value        = '';
    document.getElementById('filterTopic').value    = '';
    document.getElementById('filterMechanic').value = '';
    activeDiff   = '';
    activeAiFlag = '';
    document.querySelectorAll('[data-diff]').forEach(b => { b.classList.toggle('active', b.dataset.diff === ''); });
    document.querySelectorAll('[data-ai]').forEach(b  => { b.classList.toggle('active',  b.dataset.ai  === undefined || b.dataset.ai === ''); });
    applyFilters();
}

function applyFilters() {
    const query    = document.getElementById('qSearch').value.toLowerCase().trim();
    const topic    = document.getElementById('filterTopic').value;
    const mechanic = document.getElementById('filterMechanic').value;
    const cards    = document.querySelectorAll('#questionList .q-card');
    let visible    = 0;

    cards.forEach(card => {
        const matchQ = !query    || card.dataset.text.includes(query);
        const matchT = !topic    || card.dataset.topic    === topic;
        const matchD = !activeDiff  || card.dataset.diff  === activeDiff;
        const matchM = !mechanic || card.dataset.mechanic === mechanic;
        const matchA = activeAiFlag === '' || card.dataset.ai === activeAiFlag;
        const show   = matchQ && matchT && matchD && matchM && matchA;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
    });

    document.getElementById('filterCount').textContent = `Showing ${visible} question${visible !== 1 ? 's' : ''}`;
}

/* ─── Bulk actions ─── */
function updateBulkBar() {
    const checked = document.querySelectorAll('.q-checkbox:checked');
    const bar = document.getElementById('bulkBar');
    if (checked.length > 0) {
        bar.style.display = 'flex';
        document.getElementById('bulkCount').textContent = checked.length + ' selected';
    } else {
        bar.style.display = 'none';
    }
}

function clearSelection() {
    document.querySelectorAll('.q-checkbox').forEach(cb => cb.checked = false);
    updateBulkBar();
}

async function bulkDelete() {
    const ids = [...document.querySelectorAll('.q-checkbox:checked')].map(cb => cb.dataset.qid);
    if (!ids.length) return;
    if (!confirm('Delete ' + ids.length + ' question(s)?')) return;
    try {
        const res = await fetch('/teacher/api/questions/bulk-delete', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids })
        });
        if (!res.ok) throw new Error('Server ' + res.status);
        qbToast(ids.length + ' questions deleted.', 'success');
        setTimeout(() => location.reload(), 1200);
    } catch(err) { qbToast('Bulk delete failed: ' + err.message, 'error'); }
}

async function bulkApprove() {
    /* "Approve" in this system means setting is_ai_generated = 0 (teacher-reviewed) */
    const ids = [...document.querySelectorAll('.q-checkbox:checked')].map(cb => cb.dataset.qid);
    if (!ids.length) return;
    try {
        const res = await fetch('/teacher/api/questions/bulk-approve', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ ids })
        });
        if (!res.ok) throw new Error('Server ' + res.status);
        qbToast(ids.length + ' questions approved.', 'success');
        setTimeout(() => location.reload(), 1200);
    } catch(err) { qbToast('Bulk approve failed: ' + err.message, 'error'); }
}

/* ─── Question Modal ─── */
 
// Called when input_mode select changes — shows the right answer section
function updateAnswerSection() {
    const mode = document.getElementById('qInputMode').value;
    document.getElementById('answerSection_mcq').style.display               = (mode === 'Standard' || mode === '') ? '' : 'none';
    document.getElementById('answerSection_periodic_single').style.display   = mode === 'Periodic_Single'   ? '' : 'none';
    document.getElementById('answerSection_periodic_sequence').style.display = mode === 'Periodic_Sequence' ? '' : 'none';
    document.getElementById('answerSection_numeric').style.display           = mode === 'Numeric' ? '' : 'none';
    document.getElementById('numericToleranceRow').style.display             = mode === 'Numeric' ? '' : 'none';
}
 
// Wire up the input_mode select to trigger the section switch
document.getElementById('qInputMode').addEventListener('change', updateAnswerSection);
 
/* ── Sequence builder (Periodic_Sequence mode) ── */
let seqRowCount = 0;
 
function addSeqRow(symbol = '', subscript = 1) {
    seqRowCount++;
    const id  = 'seq_' + seqRowCount;
    const row = document.createElement('div');
    row.className = 'seq-row';
    row.id = id;
    row.innerHTML = `
        <span style="width:20px;text-align:right;font-size:11px;font-weight:700;color:#94a3b8">${seqRowCount}.</span>
        <input type="text" class="form-input seq-element-input seq-sym" placeholder="e.g. Na" maxlength="3"
               value="${escHtml(symbol)}"
               oninput="updateSeqPreview()" style="font-weight:800;text-align:center;">
        <span style="font-size:11px;color:#94a3b8">sub</span>
        <input type="number" class="form-input seq-subscript-input seq-sub" placeholder="1" min="1" max="99"
               value="${subscript}"
               oninput="updateSeqPreview()">
        <button type="button" onclick="document.getElementById('${id}').remove(); updateSeqPreview();"
                class="btn btn-danger btn-sm" style="padding:4px 8px;flex-shrink:0">
            <i class="fas fa-times text-xs"></i>
        </button>
    `;
    document.getElementById('seqRows').appendChild(row);
    updateSeqPreview();
}
 
function clearSeqRows() {
    document.getElementById('seqRows').innerHTML = '';
    seqRowCount = 0;
    updateSeqPreview();
}
 
function getSeqData() {
    const rows = document.querySelectorAll('#seqRows .seq-row');
    return Array.from(rows).map((row, i) => ({
        element_symbol: row.querySelector('.seq-sym').value.trim(),
        subscript:      parseInt(row.querySelector('.seq-sub').value) || 1,
        sort_order:     i + 1
    })).filter(r => r.element_symbol);
}
 
function updateSeqPreview() {
    const seq = getSeqData();
    const preview = document.getElementById('seqPreview');
    if (!seq.length) { preview.textContent = 'Formula preview will appear here'; return; }
    preview.innerHTML = 'Formula: ' + seq.map(s => {
        const sub = s.subscript > 1 ? `<sub>${s.subscript}</sub>` : '';
        return `<strong>${escHtml(s.element_symbol)}</strong>${sub}`;
    }).join('');
}
 
function openQModal(qid, text, diff, mechanic, inputMode, optA, optB, optC, optD, correct, instruct, baseExp, timeLimit, topicId, multiAnswer) {
    const isEdit = qid !== null && qid !== '';
    document.getElementById('qModalTitle').textContent = isEdit ? 'Edit Question' : 'Add Question';
    document.getElementById('qId').value = qid || '';
 
    // Reset everything
    document.getElementById('qForm').reset();
    document.querySelectorAll('.correct-radio').forEach(r => r.checked = false);
    clearSeqRows();
    document.getElementById('elementPreview').textContent = '?';
    document.getElementById('qCorrectSymbol').value  = '';
    document.getElementById('qCorrectNumeric').value = '';
 
    if (isEdit) {
        document.getElementById('qTopicId').value    = topicId   || '';
        document.getElementById('qText').value       = text      || '';
        document.getElementById('qInstruct').value   = instruct  || '';
        document.getElementById('qDifficulty').value = diff      || 'Easy';
        document.getElementById('qMechanic').value   = mechanic  || 'standard_mcq';
        document.getElementById('qInputMode').value  = inputMode || 'Standard';
        document.getElementById('qOptA').value       = optA      || '';
        document.getElementById('qOptB').value       = optB      || '';
        document.getElementById('qOptC').value       = optC      || '';
        document.getElementById('qOptD').value       = optD      || '';
        document.getElementById('qBaseExp').value    = baseExp   || 100;
        document.getElementById('qTimeLimit').value  = timeLimit || 30;
        document.getElementById('qPoints').value     = arguments[15] || 1;
        document.getElementById('qNumericTolerance').value = arguments[16] || 0;
        document.getElementById('qMultiAnswer').checked = multiAnswer == 1;
        // Load media if present
        const mPath = arguments[17] || '';
        const mType = arguments[18] || '';
        document.getElementById('qMediaPath').value = mPath;
        document.getElementById('qMediaType').value = mType;
        document.getElementById('qMediaUrl').value  = mPath;
        showMediaPreview(mPath, mType);
 
        // Set correct answer per input mode
        if (inputMode === 'Periodic_Single') {
            document.getElementById('qCorrectSymbol').value = correct || '';
            document.getElementById('elementPreview').textContent = correct || '?';
        } else if (inputMode === 'Numeric') {
            document.getElementById('qCorrectNumeric').value = correct || '';
        } else {
            // Standard or empty — set radio
            const radioEl = document.getElementById('correctRadio' + (correct || ''));
            if (radioEl) radioEl.checked = true;
        }
 
        // If Periodic_Sequence, load existing sequence from server
        if (inputMode === 'Periodic_Sequence' && qid) {
            fetch('/teacher/api/question/' + qid + '/answer-sequence')
                .then(r => r.json())
                .then(data => {
                    clearSeqRows();
                    (data.sequences || []).forEach(s => addSeqRow(s.element_symbol, s.subscript));
                })
                .catch(() => {/* no sequences yet — that's fine */});
        }
    } else {
        document.getElementById('qBaseExp').value   = 100;
        document.getElementById('qTimeLimit').value = 30;
    }
 
    // Show the right answer section for this input mode
    updateAnswerSection();
    document.getElementById('qModal').classList.add('open');
}
 
function closeQModal() {
    document.getElementById('qModal').classList.remove('open');
}
document.getElementById('qModal').addEventListener('click', function(e) {
    if (e.target === this) closeQModal();
});
 
async function submitQForm(e) {
    e.preventDefault();
    const fd    = new FormData(e.target);
    const qid   = fd.get('question_id');
    const url    = qid ? '/teacher/api/question/' + qid : '/teacher/api/question';
    const method = qid ? 'PUT' : 'POST';
 
    const inputMode = fd.get('input_mode');
 
    // Determine correct_answer based on input mode
    let correctAnswer = null;
    if (inputMode === 'Periodic_Single') {
        correctAnswer = document.getElementById('qCorrectSymbol').value.trim() || null;
    } else if (inputMode === 'Numeric') {
        correctAnswer = document.getElementById('qCorrectNumeric').value.trim() || null;
    } else {
        // Standard MCQ — use the radio
        correctAnswer = fd.get('correct_answer') || null;
    }
 
    const body = {
        topic_id:             fd.get('topic_id'),
        question_text:        fd.get('question_text'),
        instruction_override: fd.get('instruction_override') || null,
        difficulty:           fd.get('difficulty'),
        mechanic_type:        fd.get('mechanic_type'),
        input_mode:           inputMode,
        option_a:             fd.get('option_a')  || null,
        option_b:             fd.get('option_b')  || null,
        option_c:             fd.get('option_c')  || null,
        option_d:             fd.get('option_d')  || null,
        correct_answer:       correctAnswer,
        is_multiple_answer:   fd.get('is_multiple_answer') ? 1 : 0,
        base_exp:             parseInt(fd.get('base_exp'))   || 100,
        time_limit:           parseInt(fd.get('time_limit')) || 30,
        points:               parseInt(fd.get('points'))     || 1,
        numeric_tolerance:    parseFloat(fd.get('numeric_tolerance')) || 0,
        media_path:           fd.get('media_path') || null,
        media_type:           fd.get('media_type') || null,
    };
 
    // For Periodic_Sequence, attach the sequence data
    if (inputMode === 'Periodic_Sequence') {
        body.answer_sequences = getSeqData();
        if (!body.answer_sequences.length) {
            qbToast('Add at least one element to the sequence.', 'error');
            return;
        }
    }
 
    try {
        const res = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error('Server ' + res.status);
        closeQModal();
        qbToast('Question saved.', 'success');
        setTimeout(() => location.reload(), 1200);
    } catch(err) { qbToast('Save failed: ' + err.message, 'error'); }
}

/* ─── Delete ─── */
function deleteQuestion(qid) {
    document.getElementById('deleteMsg').textContent = 'Delete question #' + qid + '? This cannot be undone.';
