/* ─── Media attachment helpers ─── */
function handleMediaUrlInput(url) {
    if (!url) { clearMediaAttachment(); return; }
    const imgExts = /\.(jpg|jpeg|png|webp|gif|svg)(\?.*)?$/i;
    const vidExts = /\.(mp4|webm|ogg|mov)(\?.*)?$/i;
    let mType = '';
    if (imgExts.test(url)) mType = 'image';
    else if (vidExts.test(url)) mType = 'video';
    else mType = 'image'; // default guess
    document.getElementById('qMediaPath').value = url;
    document.getElementById('qMediaType').value = mType;
    showMediaPreview(url, mType);
}

function showMediaPreview(url, mType) {
    const row = document.getElementById('mediaPreviewRow');
    const img = document.getElementById('mediaPreviewImg');
    const vid = document.getElementById('mediaPreviewVid');
    if (!url) { row.style.display = 'none'; img.style.display = 'none'; vid.style.display = 'none'; return; }
    row.style.display = 'flex';
    if (mType === 'video') {
        vid.src = url; vid.style.display = ''; img.style.display = 'none';
    } else {
        img.src = url; img.style.display = ''; vid.style.display = 'none';
    }
}

function clearMediaAttachment() {
    document.getElementById('qMediaPath').value = '';
    document.getElementById('qMediaType').value = '';
    document.getElementById('qMediaUrl').value  = '';
    document.getElementById('mediaPreviewRow').style.display = 'none';
    document.getElementById('mediaPreviewImg').style.display = 'none';
    document.getElementById('mediaPreviewVid').style.display = 'none';
}


