/* ─── Revise Modal ─── */
let reviseSeqCount = 0;
let _currentReviseQid = null;

function openReviseModal(qid, text, diff, mechanic, inputMode, optA, optB, optC, optD, correct, instruct, baseExp, timeLimit, topicId, multiAnswer) {
    _currentReviseQid = qid;
    document.getElementById('reviseQid').value          = qid;
    document.getElementById('reviseQidLabel').textContent = '#' + qid;
    document.getElementById('reviseTopicId').value      = topicId   || '';
    document.getElementById('reviseText').value         = text      || '';
    document.getElementById('reviseInstruct').value     = instruct  || '';
    document.getElementById('reviseDifficulty').value   = diff      || 'Easy';
    document.getElementById('reviseMechanic').value     = mechanic  || 'standard_mcq';
    document.getElementById('reviseInputMode').value    = inputMode || 'Standard';
    document.getElementById('reviseOptA').value         = optA || '';
    document.getElementById('reviseOptB').value         = optB || '';
    document.getElementById('reviseOptC').value         = optC || '';
    document.getElementById('reviseOptD').value         = optD || '';
    document.getElementById('reviseBaseExp').value      = baseExp   || 100;
    document.getElementById('reviseTimeLimit').value    = timeLimit || 30;

    // Find & show rejection reason
    const rejBox  = document.getElementById('reviseRejectionBox');
    const rejText = document.getElementById('reviseRejectionText');
    // Grab from the rejected card's rejection reason box if it exists
    const card = document.querySelector('[id^="vcard-"] .text-rose-700');
    if (card) { rejBox.style.display = ''; rejText.textContent = card.textContent; }
    else { rejBox.style.display = 'none'; }

    // Set correct answer for Standard MCQ
    if (inputMode === 'Standard') {
        const radioEl = document.getElementById('reviseCorrectRadio' + (correct || ''));
        if (radioEl) radioEl.checked = true;
    } else if (inputMode === 'Periodic_Single') {
        document.getElementById('reviseCorrectSymbol').value = correct || '';
    } else if (inputMode === 'Numeric') {
        document.getElementById('reviseCorrectNumeric').value = correct || '';
    }

    // Load sequence for Periodic_Sequence
    document.getElementById('reviseSeqRows').innerHTML = '';
    reviseSeqCount = 0;
    if (inputMode === 'Periodic_Sequence' && qid) {
        fetch('/teacher/api/question/' + qid + '/answer-sequence')
            .then(r => r.json())
            .then(data => { (data.sequences || []).forEach(s => addReviseSeqRow(s.element_symbol, s.subscript)); })
            .catch(() => {});
    }

    updateReviseAnswerSection();
    document.getElementById('reviseModal').classList.add('open');
}

function closeReviseModal() { document.getElementById('reviseModal').classList.remove('open'); }
document.getElementById('reviseModal').addEventListener('click', function(e) { if (e.target === this) closeReviseModal(); });

function updateReviseAnswerSection() {
    const mode = document.getElementById('reviseInputMode').value;
    document.getElementById('reviseAnswerSection_mcq').style.display               = (mode === 'Standard' || mode === '') ? '' : 'none';
    document.getElementById('reviseAnswerSection_periodic_single').style.display   = mode === 'Periodic_Single'   ? '' : 'none';
    document.getElementById('reviseAnswerSection_periodic_sequence').style.display = mode === 'Periodic_Sequence' ? '' : 'none';
    document.getElementById('reviseAnswerSection_numeric').style.display           = mode === 'Numeric' ? '' : 'none';
}

function addReviseSeqRow(symbol = '', subscript = 1) {
    reviseSeqCount++;
    const id  = 'rseq_' + reviseSeqCount;
    const row = document.createElement('div');
    row.className = 'seq-row'; row.id = id;
    row.innerHTML = `
        <span style="width:20px;text-align:right;font-size:11px;font-weight:700;color:#94a3b8">${reviseSeqCount}.</span>
        <input type="text" class="form-input seq-element-input rseq-sym" placeholder="Na" maxlength="3" value="${escHtml(symbol)}" oninput="updateReviseSeqPreview()" style="font-weight:800;text-align:center;">
        <span style="font-size:11px;color:#94a3b8">sub</span>
        <input type="number" class="form-input seq-subscript-input rseq-sub" placeholder="1" min="1" max="99" value="${subscript}" oninput="updateReviseSeqPreview()">
        <button type="button" onclick="document.getElementById('${id}').remove(); updateReviseSeqPreview();" class="btn btn-danger btn-sm" style="padding:4px 8px;flex-shrink:0"><i class="fas fa-times text-xs"></i></button>
    `;
    document.getElementById('reviseSeqRows').appendChild(row);
    updateReviseSeqPreview();
}

function updateReviseSeqPreview() {
    const rows = document.querySelectorAll('#reviseSeqRows .seq-row');
    const seq  = Array.from(rows).map((r,i) => ({ element_symbol: r.querySelector('.rseq-sym').value.trim(), subscript: parseInt(r.querySelector('.rseq-sub').value)||1, sort_order: i+1 })).filter(r => r.element_symbol);
    const preview = document.getElementById('reviseSeqPreview');
    if (!seq.length) { preview.textContent = 'Formula preview will appear here'; return; }
    preview.innerHTML = 'Formula: ' + seq.map(s => { const sub = s.subscript > 1 ? `<sub>${s.subscript}</sub>` : ''; return `<strong>${escHtml(s.element_symbol)}</strong>${sub}`; }).join('');
}

async function submitRevision(e) {
    e.preventDefault();
    const fd = new FormData(e.target);
    const qid = fd.get('question_id');
    const inputMode = document.getElementById('reviseInputMode').value;
    let correctAnswer = null;
    if      (inputMode === 'Periodic_Single') correctAnswer = document.getElementById('reviseCorrectSymbol').value.trim()  || null;
    else if (inputMode === 'Numeric')         correctAnswer = document.getElementById('reviseCorrectNumeric').value.trim() || null;
    else {
        const checked = document.querySelector('input[name="revise_correct_answer"]:checked');
        correctAnswer = checked ? checked.value : null;
    }
    const rows = document.querySelectorAll('#reviseSeqRows .seq-row');
    const seqs = Array.from(rows).map((r,i) => ({ element_symbol: r.querySelector('.rseq-sym').value.trim(), subscript: parseInt(r.querySelector('.rseq-sub').value)||1, sort_order: i+1 })).filter(r => r.element_symbol);
    const body = {
        topic_id:             fd.get('topic_id'),
        question_text:        fd.get('question_text'),
        instruction_override: fd.get('instruction_override') || null,
        difficulty:           fd.get('difficulty'),
        mechanic_type:        fd.get('mechanic_type'),
        input_mode:           inputMode,
        option_a:             fd.get('option_a')  || null,
        option_b:             fd.get('option_b')  || null,
        option_c:             fd.get('option_c')  || null,
        option_d:             fd.get('option_d')  || null,
        correct_answer:       correctAnswer,
        base_exp:             parseInt(fd.get('base_exp'))   || 100,
        time_limit:           parseInt(fd.get('time_limit')) || 30,
        answer_sequences:     inputMode === 'Periodic_Sequence' ? seqs : undefined,
    };
    try {
        const res = await fetch('/teacher/api/question/' + qid + '/revise', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(body)
        });
        if (!res.ok) throw new Error('Server ' + res.status);
        closeReviseModal();
        qbToast('Revision submitted — question is now pending review.', 'success');
        setTimeout(() => location.reload(), 1400);
    } catch(err) { qbToast('Submit failed: ' + err.message, 'error'); }
}

