function renderErrorRankList(qs) {
    const container = document.getElementById('errorRankList');
    if (!qs.length) { container.innerHTML = '<p class="text-xs text-slate-400 text-center py-4">No response data yet.</p>'; return; }
    container.innerHTML = qs.map((q, i) => {
        const pct = Math.round(q.error_rate * 100);
        return `
        <div class="cursor-pointer rounded-xl p-3 hover:bg-indigo-50 border border-transparent hover:border-indigo-100 transition"
             onclick="loadQuestionPerformance(${q.question_id}, '${escHtml(q.question_text.slice(0,80))}')">
            <div class="flex items-center justify-between mb-1">
                <span class="text-xs font-bold text-slate-700 truncate" style="max-width:160px" title="${escHtml(q.question_text)}">${i+1}. ${escHtml(q.question_text.slice(0,55))}${q.question_text.length > 55 ? '…' : ''}</span>
                <span class="text-xs font-black ${pct >= 70 ? 'text-rose-600' : pct >= 40 ? 'text-amber-600' : 'text-emerald-600'}">${pct}%</span>
            </div>
            <div class="error-bar-wrap"><div class="error-bar-fill" style="width:${pct}%;background:${pct >= 70 ? '#f43f5e' : pct >= 40 ? '#f59e0b' : '#10b981'}"></div></div>
            <p class="text-[10px] text-slate-400 mt-1">${q.total_attempts} attempts · ${q.topic_name || '—'}</p>
