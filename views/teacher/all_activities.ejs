<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Submissions & Activity Feed | Chemistry Arcade</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap');
        body { font-family: 'Plus Jakarta Sans', sans-serif; background-color: #f0fdfa; background-image: radial-gradient(#2dd4bf 0.5px, transparent 0.5px); background-size: 24px 24px; }
        #sidebar { transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1); }
        .no-scrollbar::-webkit-scrollbar { display: none; }
        .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
        #mainScroll { overflow-y: auto; }
        #mainScroll::-webkit-scrollbar { width: 5px; }
        #mainScroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 9999px; }

        .glass-card {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(226, 232, 240, 0.9);
            box-shadow: 0 4px 20px -2px rgba(0, 0, 0, 0.03);
        }
        .profile-dropdown {
            opacity: 0;
            transform: translateY(-8px) scale(0.96);
            pointer-events: none;
            transition: opacity 0.15s ease, transform 0.15s ease;
        }
        .profile-dropdown.open {
            opacity: 1;
            transform: translateY(0) scale(1);
            pointer-events: all;
        }
    </style>
    <%- include('../partials/teacher-nav-styles') %>
</head>
<body class="text-slate-900">

<div class="flex min-h-screen relative overflow-x-hidden">

    <%- include('../partials/teacher-sidebar', { activeNav: 'dashboard' }) %>

    <!-- MAIN -->
    <main id="mainContent" class="flex-1 flex flex-col min-w-0 md:ml-64 h-screen overflow-hidden">

        <!-- Header -->
        <header class="h-20 bg-white/95 backdrop-blur-md border-b border-slate-200/80 flex items-center justify-between px-4 md:px-8 fixed top-0 left-0 right-0 md:left-64 z-40">
            <div class="flex items-center gap-4">
                <button onclick="toggleSidebar()" aria-label="Toggle navigation sidebar" class="p-2 rounded-lg hover:bg-slate-100 text-slate-700 focus-visible:ring-2 focus-visible:ring-indigo-500 transition">
                    <i class="fas fa-bars text-xl"></i>
                </button>
                <div class="hidden sm:block">
                    <div class="flex items-center gap-2.5 flex-wrap">
                        <h1 class="text-lg md:text-xl font-bold text-indigo-950 uppercase tracking-tight">Activity Archive</h1>
                        <% if (typeof currentSY !== 'undefined' && currentSY) { %>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-700 text-[11px] font-black uppercase tracking-wide">
                            <span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>
                            S.Y. <%= currentSY.sy_range %> &middot; Active
                        </span>
                        <% } else { %>
                        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full bg-amber-50 border border-amber-200 text-amber-700 text-[11px] font-black uppercase tracking-wide">
                            <i class="fas fa-exclamation-triangle text-[10px]"></i>
                            No Active School Year
                        </span>
                        <% } %>
                    </div>
                    <p class="text-xs text-slate-600 font-medium">
                        <i class="fas fa-circle text-emerald-500 text-[9px] mr-1"></i>
                        Recent Submissions, Diagnostic Gameplay &amp; Current School Year History
                    </p>
                </div>
            </div>

            <div class="flex items-center gap-3 md:gap-6">
                <!-- Back to Dashboard Shortcut Button -->
                <a href="/teacher/dashboard" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl text-xs font-bold transition flex items-center gap-1.5">
                    <i class="fas fa-arrow-left text-xs"></i>
                    <span>Back to Dashboard</span>
                </a>

                <!-- Messages Navigation Button -->
                <a href="/teacher/messages" id="messagesBtn" aria-label="Open messages and conversations" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500 text-slate-700 hover:text-indigo-600 flex items-center justify-center">
                    <i class="far fa-comment-dots text-xl"></i>
                    <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center msg-badge hidden" aria-hidden="true">
                        <span class="msg-badge-count">0</span>
                    </span>
                    <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                        Messages
                    </span>
                </a>

                <!-- Notification Button with keyboard-accessible tooltip -->
                <button type="button" onclick="toggleNotifPanel()" aria-label="View notifications" class="relative group p-2 hover:bg-slate-100 rounded-full transition focus-visible:ring-2 focus-visible:ring-indigo-500">
                    <i class="far fa-bell text-xl text-slate-700"></i>
                    <% const _unreadNotifCount = (typeof notifications !== 'undefined' && Array.isArray(notifications)) ? notifications.filter(n => !n.is_read).length : 0; %>
                    <span class="absolute -top-0.5 -right-0.5 min-w-[18px] h-[18px] px-1 bg-rose-500 text-white text-[10px] font-black leading-none rounded-full border-2 border-white shadow-sm flex items-center justify-center notif-badge <%= _unreadNotifCount > 0 ? '' : 'hidden' %>" aria-hidden="true">
                        <span class="notif-badge-count"><%= _unreadNotifCount > 99 ? '99+' : _unreadNotifCount %></span>
                    </span>
                    <span class="absolute top-12 left-1/2 -translate-x-1/2 scale-0 group-hover:scale-100 group-focus-visible:scale-100 transition-all bg-slate-800 text-white text-xs px-2.5 py-1 rounded shadow-lg pointer-events-none whitespace-nowrap z-50">
                        Notifications
                    </span>
                </button>

                <!-- User Profile Dropdown -->
                <div class="relative">
                    <button type="button" onclick="toggleUserMenu(event)" id="userMenuBtn" aria-expanded="false" aria-label="Open user profile menu" class="flex items-center gap-3 pl-4 border-l border-slate-200 hover:opacity-85 transition focus-visible:ring-2 focus-visible:ring-indigo-500 rounded-lg">
                        <div class="text-right hidden lg:block">
                            <p class="text-sm font-bold text-slate-800 leading-none mb-1"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-xs uppercase font-bold text-slate-600 tracking-wider leading-none"><%= user.role || 'Teacher' %></p>
                        </div>
                        <img src="<%= user.profile_pic ? '/profile_uploads/' + user.profile_pic : '/profile_uploads/default_avatar.png' %>" alt="<%= user.first_name %>'s avatar" class="w-10 h-10 rounded-xl object-cover ring-2 ring-blue-100" onerror="this.src='/profile_uploads/default_avatar.png'">
                        <i class="fas fa-chevron-down text-xs text-slate-600 ml-1"></i>
                    </button>

                    <div id="userDropdown" class="hidden absolute right-0 mt-3 w-56 bg-white rounded-2xl shadow-xl border border-slate-100 py-2 z-50">
                        <div class="px-4 py-3 border-b border-slate-100 lg:hidden">
                            <p class="text-sm font-bold text-slate-800"><%= user.first_name %> <%= user.last_name %></p>
                            <p class="text-xs text-slate-600 mt-1 uppercase font-bold"><%= user.role || 'Teacher' %></p>
                        </div>
                        <a href="/teacher/profile" class="flex items-center gap-3 px-4 py-2 text-sm text-slate-700 hover:bg-blue-50 hover:text-blue-600 transition">
                            <i class="far fa-user w-5 text-center"></i> View Profile
                        </a>
                        <hr class="my-2 border-slate-100">
                        <a href="/logout" class="flex items-center gap-3 px-4 py-2 text-sm text-red-600 hover:bg-red-50 transition font-bold">
                            <i class="fas fa-sign-out-alt w-5 text-center"></i> Log Out
                        </a>
                    </div>
                </div>
            </div>
        </header>

        <!-- Main Body -->
        <div id="mainScroll" class="flex-1 mt-20 p-4 md:p-8 space-y-6">

            <% if (typeof syBlocked !== 'undefined' && syBlocked) { %>
            <div class="flex items-center justify-between gap-3 px-4 py-3 rounded-2xl bg-amber-50 border border-amber-200 text-amber-900 text-xs font-semibold shadow-xs">
                <div class="flex items-center gap-2.5">
                    <i class="fas fa-shield-alt text-amber-600 text-sm"></i>
                    <span>Action blocked: Only records belonging to the currently active School Year are accessible.</span>
                </div>
                <a href="/teacher/all-activities" class="text-amber-700 hover:text-amber-900 font-bold whitespace-nowrap">Dismiss</a>
            </div>
            <% } %>

            <% if (typeof currentSY === 'undefined' || !currentSY) { %>
            <div class="flex flex-wrap items-center justify-between gap-3 p-4 rounded-2xl bg-amber-50/90 border border-amber-200 shadow-xs">
                <div class="flex items-center gap-3">
                    <div class="w-9 h-9 rounded-xl bg-amber-100 text-amber-700 flex items-center justify-center flex-shrink-0">
                        <i class="fas fa-calendar-times"></i>
                    </div>
                    <div>
                        <p class="text-xs font-black uppercase tracking-wider text-amber-800">No Active School Year Open</p>
                        <p class="text-xs font-semibold text-amber-900/80 mt-0.5">Activity logs and submissions are strictly scoped to the active School Year. Activate a School Year to inspect current records.</p>
                    </div>
                </div>
            </div>
            <% } %>

            <!-- Summary Stat Cards -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                <div class="glass-card rounded-2xl p-4 border border-slate-200">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Total Activities</span>
                        <div class="w-8 h-8 rounded-xl bg-indigo-50 text-indigo-600 flex items-center justify-center text-xs">
                            <i class="fas fa-list-check"></i>
                        </div>
                    </div>
                    <p class="text-2xl font-black text-indigo-950"><%= activities.length %></p>
                    <p class="text-[10px] text-slate-400 font-semibold mt-1">Recorded submissions & plays</p>
                </div>

                <div class="glass-card rounded-2xl p-4 border border-slate-200">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Arcade Plays</span>
                        <div class="w-8 h-8 rounded-xl bg-cyan-50 text-cyan-600 flex items-center justify-center text-xs">
                            <i class="fas fa-gamepad"></i>
                        </div>
                    </div>
                    <% const versusCount = activities.filter(a => a.is_versus).length; %>
                    <% const arcadeCount = activities.filter(a => a.submission_type === 'arcade').length; %>
                    <p class="text-2xl font-black text-cyan-900"><%= arcadeCount %></p>
                    <p class="text-[10px] text-slate-400 font-semibold mt-1"><%= arcadeCount - versusCount %> solo · <%= versusCount %> dual matches</p>
                </div>

                <div class="glass-card rounded-2xl p-4 border border-slate-200">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Deliverables</span>
                        <div class="w-8 h-8 rounded-xl bg-violet-50 text-violet-600 flex items-center justify-center text-xs">
                            <i class="fas fa-file-arrow-up"></i>
                        </div>
                    </div>
                    <% const deliverableCount = activities.filter(a => a.submission_type === 'assignment').length; %>
                    <p class="text-2xl font-black text-violet-900"><%= deliverableCount %></p>
                    <p class="text-[10px] text-slate-400 font-semibold mt-1">Homework & file uploads</p>
                </div>

                <div class="glass-card rounded-2xl p-4 border border-slate-200">
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[11px] font-bold text-slate-400 uppercase tracking-widest">Grace Period Buffer</span>
                        <div class="w-8 h-8 rounded-xl bg-amber-50 text-amber-600 flex items-center justify-center text-xs">
                            <i class="fas fa-clock"></i>
                        </div>
                    </div>
                    <% const graceCount = activities.filter(a => a.is_grace_period).length; %>
                    <p class="text-2xl font-black text-amber-900"><%= graceCount %></p>
                    <p class="text-[10px] text-slate-400 font-semibold mt-1">Grace buffer transparent logs</p>
                </div>
            </div>

            <!-- Filter Controls -->
            <div class="glass-card rounded-2xl p-4 border border-slate-200 flex flex-wrap items-center justify-between gap-3">
                <div class="flex items-center gap-3 flex-1 min-w-[280px]">
                    <div class="relative flex-1">
                        <i class="fas fa-search absolute left-3.5 top-3 text-slate-400 text-xs"></i>
                        <input type="text" id="filterSearch" placeholder="Search student name, assessment, topic..." 
                               class="w-full pl-9 pr-3 py-2 text-xs font-semibold bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500 focus:bg-white transition">
                    </div>
                    <select id="filterSubject" class="px-3 py-2 text-xs font-bold text-slate-700 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500">
                        <option value="">All Subjects</option>
                        <% const uniqueSubjects = [...new Set(activities.map(a => a.subject_name))]; %>
                        <% uniqueSubjects.forEach(s => { %>
                            <option value="<%= s %>"><%= s %></option>
                        <% }) %>
                    </select>
                    <select id="filterType" class="px-3 py-2 text-xs font-bold text-slate-700 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-indigo-500">
                        <option value="">All Activity Types</option>
                        <option value="arcade">Solo Arcade Sessions</option>
                        <option value="versus">2-Player Dual Matches</option>
                        <option value="assignment">Homework Deliverables</option>
                    </select>
                </div>

                <div class="text-xs font-bold text-slate-400">
                    Showing <span id="visibleCount" class="text-indigo-900 font-black"><%= activities.length %></span> entries
                </div>
            </div>

            <!-- Submissions Feed List -->
            <div class="glass-card rounded-2xl border border-slate-200 overflow-hidden">
                <div class="p-4 bg-slate-50/80 border-b border-slate-200/80 flex items-center justify-between">
                    <h2 class="text-xs font-black uppercase tracking-wider text-slate-600 flex items-center gap-2">
                        <i class="fas fa-layer-group text-slate-400"></i>
                        <span>Activity Feed Record Log</span>
                    </h2>
                    <span class="text-[10px] font-black uppercase text-indigo-600 tracking-widest bg-indigo-50 px-2 py-0.5 rounded-md">Real-Time Sync</span>
                </div>

                <div class="divide-y divide-slate-100" id="activityList">
                    <% if (activities && activities.length > 0) { %>
                        <% activities.forEach(item => { %>
                        <div class="activity-row p-4 hover:bg-slate-50/80 transition flex flex-col md:flex-row md:items-center justify-between gap-4"
                             data-name="<%= item.is_versus ? (item.first_name + ' ' + item.last_name + ' ' + item.p2_first_name + ' ' + item.p2_last_name).toLowerCase() : (item.first_name + ' ' + item.last_name).toLowerCase() %>"
                             data-assessment="<%= (item.assessment_name || '').toLowerCase() %>"
                             data-topic="<%= (item.topic_name || '').toLowerCase() %>"
                             data-subject="<%= item.subject_name %>"
                             data-type="<%= item.is_versus ? 'versus' : item.submission_type %>">
                            
                            <!-- Student & Assessment Info -->
                            <div class="flex items-center gap-3.5 min-w-0">
                                <% if (item.is_versus) { %>
                                    <div class="relative flex items-center flex-shrink-0 -space-x-2">
                                        <img src="/profile_uploads/<%= item.student_pic || 'default_avatar.png' %>" class="w-10 h-10 rounded-xl object-cover ring-2 ring-white z-10" title="<%= item.first_name %> <%= item.last_name %>">
                                        <img src="/profile_uploads/<%= item.p2_pic || 'default_avatar.png' %>" class="w-10 h-10 rounded-xl object-cover ring-2 ring-white z-0" title="<%= item.p2_first_name %> <%= item.p2_last_name %>">
                                        <div class="absolute -bottom-1 left-4 z-20 px-1.5 py-0.2 bg-slate-900 text-[8px] font-black text-white rounded shadow-xs border border-white">VS</div>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <p class="text-sm font-bold text-indigo-950">
                                                <%= item.first_name %> <%= item.last_name %> <span class="text-rose-500 font-extrabold text-xs mx-0.5">vs</span> <%= item.p2_first_name %> <%= item.p2_last_name %>
                                            </p>
                                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-black bg-rose-50 text-rose-700 border border-rose-200">
                                                <i class="fas fa-bolt text-[8px]"></i> 2-Player Dual
                                            </span>
                                            <% if (item.winner === 'Tie' || item.winner === 'TIE') { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-black bg-slate-100 text-slate-700 border border-slate-200">
                                                    <i class="fas fa-handshake text-[8px] text-slate-500"></i> DRAW
                                                </span>
                                            <% } else if (item.winner === 'P1') { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-black bg-emerald-50 text-emerald-700 border border-emerald-200">
                                                    <i class="fas fa-trophy text-[8px] text-amber-500"></i> <%= item.first_name %> WON
                                                </span>
                                            <% } else if (item.winner === 'P2') { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-black bg-purple-50 text-purple-700 border border-purple-200">
                                                    <i class="fas fa-trophy text-[8px] text-amber-500"></i> <%= item.p2_first_name %> WON
                                                </span>
                                            <% } %>
                                        </div>
                                        <p class="text-xs text-slate-500 font-semibold mt-0.5 flex items-center gap-1.5 flex-wrap">
                                            <span class="text-indigo-600 font-black"><%= item.subject_name %></span>
                                            <span class="text-slate-300">•</span>
                                            <span><%= item.assessment_name %></span>
                                            <span class="text-slate-300">•</span>
                                            <span class="text-[10px] text-slate-400 uppercase font-bold"><%= item.topic_name %></span>
                                        </p>
                                    </div>
                                <% } else { %>
                                    <div class="relative flex-shrink-0">
                                        <img src="/profile_uploads/<%= item.student_pic || 'default_avatar.png' %>" class="w-10 h-10 rounded-xl object-cover ring-2 ring-slate-100">
                                        <div class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 border-2 border-white rounded-full"></div>
                                    </div>
                                    <div class="min-w-0">
                                        <div class="flex items-center gap-2 flex-wrap">
                                            <p class="text-sm font-bold text-indigo-950"><%= item.first_name %> <%= item.last_name %></p>
                                            <span class="px-2 py-0.5 rounded-md text-[9px] font-black bg-slate-100 text-slate-600 border border-slate-200">
                                                <%= item.class_name || 'Chemistry Class' %>
                                            </span>
                                            <% if (item.submission_type === 'arcade') { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-black bg-cyan-50 text-cyan-700 border border-cyan-200">
                                                    <i class="fas fa-gamepad text-[8px]"></i> Arcade
                                                </span>
                                            <% } else { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-black bg-violet-50 text-violet-700 border border-violet-200">
                                                    <i class="fas fa-file-lines text-[8px]"></i> Deliverable
                                                </span>
                                            <% } %>
                                            <% if (item.is_grace_period) { %>
                                                <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-md text-[9px] font-black bg-amber-100 text-amber-800 border border-amber-300">
                                                    <i class="fas fa-clock text-[8px]"></i> Grace (+<%= item.grace_minutes_used || 1 %>m)
                                                </span>
                                            <% } %>
                                        </div>
                                        <p class="text-xs text-slate-500 font-semibold mt-0.5 flex items-center gap-1.5 flex-wrap">
                                            <span class="text-indigo-600 font-black"><%= item.subject_name %></span>
                                            <span class="text-slate-300">•</span>
                                            <span><%= item.assessment_name %></span>
                                            <% if (item.file_path) { %>
                                                <a href="<%= item.file_path %>" target="_blank" class="inline-flex items-center gap-1 text-[10px] text-cyan-600 hover:underline font-bold bg-cyan-50 px-1.5 py-0.5 rounded">
                                                    <i class="fas fa-paperclip text-[8px]"></i>
                                                    <%= item.original_filename || 'Attachment' %>
                                                </a>
                                            <% } %>
                                            <span class="text-slate-300">•</span>
                                            <span class="text-[10px] text-slate-400 uppercase font-bold"><%= item.topic_name %></span>
                                        </p>
                                    </div>
                                <% } %>
                            </div>

                            <!-- Score, EXP & Action -->
                            <div class="flex items-center justify-between md:justify-end gap-5 flex-shrink-0 pt-2 md:pt-0 border-t md:border-t-0 border-slate-100">
                                <div class="text-left md:text-right">
                                    <p class="text-sm font-black text-indigo-950">
                                        <% if (item.is_versus) { %>
                                            <%= item.score_obtained %> - <%= item.p2_score %> 
                                        <% } else { %>
                                            <%= item.score_obtained !== null ? item.score_obtained : 'Pending' %> 
                                        <% } %>
                                        <span class="text-slate-300">/ <%= item.total_items %></span>
                                    </p>
                                    <p class="text-[10px] text-slate-400 font-bold">
                                        <%= item.submitted_at ? new Date(item.submitted_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric', hour: '2-digit', minute: '2-digit' }) : 'Recently' %>
                                    </p>
                                </div>

                                <div class="px-2.5 py-1 bg-emerald-50 text-emerald-700 rounded-xl text-center border border-emerald-200 min-w-[55px]">
                                    <p class="text-xs font-black">+<%= item.exp_gained || 0 %></p>
                                    <p class="text-[8px] font-black uppercase"><%= item.is_versus ? 'EXP EACH' : 'EXP' %></p>
                                </div>

                                <a href="<%= item.target_url %>" class="px-3.5 py-2 rounded-xl bg-indigo-600 hover:bg-indigo-700 text-white font-bold text-xs shadow-xs transition flex items-center gap-1.5">
                                    <% if (item.submission_type === 'arcade' || item.is_versus) { %>
                                        <i class="fas fa-chart-line text-[10px]"></i>
                                        <span>Telemetry</span>
                                    <% } else { %>
                                        <i class="fas fa-keyboard text-[10px]"></i>
                                        <span>Grade SPA</span>
                                    <% } %>
                                    <i class="fas fa-arrow-right text-[9px] opacity-70"></i>
                                </a>
                            </div>

                        </div>
                        <% }) %>
                    <% } else { %>
                        <div class="py-16 text-center text-slate-400">
                            <i class="fas fa-inbox text-4xl opacity-20 mb-3"></i>
                            <p class="text-sm font-bold">No submissions or activity records found.</p>
                        </div>
                    <% } %>
                </div>
            </div>

        </div>

    </main>

</div>

<%- include('../partials/notification-panel') %>
<%- include('../partials/teacher-nav-scripts') %>

<script>
    // Live Client Filtering
    const searchInput = document.getElementById('filterSearch');
    const subjectFilter = document.getElementById('filterSubject');
    const typeFilter = document.getElementById('filterType');
    const visibleCount = document.getElementById('visibleCount');
    const rows = document.querySelectorAll('.activity-row');

    function applyFilters() {
        const query = (searchInput.value || '').toLowerCase().trim();
        const selectedSub = subjectFilter.value;
        const selectedType = typeFilter.value;
        let count = 0;

        rows.forEach(row => {
            const name = row.getAttribute('data-name');
            const asmt = row.getAttribute('data-assessment');
            const topic = row.getAttribute('data-topic');
            const sub = row.getAttribute('data-subject');
            const type = row.getAttribute('data-type');

            const matchesSearch = !query || name.includes(query) || asmt.includes(query) || topic.includes(query);
            const matchesSub = !selectedSub || sub === selectedSub;
            const matchesType = !selectedType || type === selectedType;

            if (matchesSearch && matchesSub && matchesType) {
                row.style.display = 'flex';
                count++;
            } else {
                row.style.display = 'none';
            }
        });

        if (visibleCount) visibleCount.textContent = count;
    }

    if (searchInput) searchInput.addEventListener('input', applyFilters);
    if (subjectFilter) subjectFilter.addEventListener('change', applyFilters);
    if (typeFilter) typeFilter.addEventListener('change', applyFilters);
</script>

</body>
</html>

